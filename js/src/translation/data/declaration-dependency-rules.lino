%20return%20true%3B%0A%7D%0A%0A%2F%2A%2A%20A%20signature%20describes%20a%20binding%20only%20after%20the%20actual%20module%20surface%20is%0A%20%2A%20certified%20and%20that%20original%20name%20has%20exactly%20one%20actual%20declaration%2Fimport%0A%20%2A%20owner.%20An%20isolated%20checked%20body%20alone%20cannot%20supply%20module%20ownership.%0A%20%2A%20%40param%20%7Bboolean%7D%20scopeKnown%20%40param%20%7Bnumber%7D%20ownerCount%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptDeclarationSignatureBinding%28scopeKnown%2C%20ownerCount%29%20%7B%0A%20%20return%20scopeKnown%20%26%26%20ownerCount%20%3D%3D%3D%201%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
