(163519: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Bounded%20UTF16%20expansion.%20Negative%20plans%20distinguish%20language%20errors%20from%0A%2F%2F%20resource%20refusal%3B%20constructors%20consume%20the%20complete%20already%20admitted%20length.%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20length%20%40param%20%7Bnumber%7D%20count%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readUtf16TextRepetitionLength%28length%2Ccount%29%7B%0A%20const%20integer%3DNumber.isNaN%28count%29%3F0%3AMath.trunc%28count%29%3B%0A%20if%28integer%3C0%7C%7Cinteger%3D%3D%3DInfinity%29return%20-1%3B%0A%20if%28%21Number.isSafeInteger%28length%29%7C%7Clength%3C0%7C%7Clength%3E1048576%29return%20-2%3B%0A%20if%28length%3D%3D%3D0%7C%7Cinteger%3D%3D%3D0%29return%200%3B%0A%20if%28integer%3EMath.floor%281048576%2Flength%29%29return%20-2%3B%0A%20return%20length%2Ainteger%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20length%20%40param%20%7Bnumber%7D%20maximum%20%40param%20%7Bnumber%7D%20fillerLength%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readUtf16TextPaddingLength%28length%2Cmaximum%2CfillerLength%29%7B%0A%20if%28%21Number.isSafeInteger%28length%29%7C%7Clength%3C0%7C%7Clength%3E1048576%7C%7C%21Number.isSafeInteger%28fillerLength%29%7C%7CfillerLength%3C0%7C%7CfillerLength%3E1048576%29return%20-2%3B%0A%20const%20integer%3DNumber.isNaN%28maximum%29%3F0%3AMath.trunc%28maximum%29%3B%0A%20const%20target%3DMath.min%289007199254740991%2CMath.max%280%2Cinteger%29%29%3B%0A%20if%28target%3C%3Dlength%7C%7CfillerLength%3D%3D%3D0%29return%20length%3B%0A%20return%20target%3E1048576%3F-2%3Atarget%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20text%20%40param%20%7Bnumber%7D%20length%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20constructUtf16TextRepetition%28text%2Clength%29%7B%0A%20if%28%21Number.isSafeInteger%28length%29%7C%7Clength%3C0%7C%7Clength%3E1048576%7C%7Clength%3E0%26%26%28text.length%3D%3D%3D0%7C%7Clength%25text.length%21%3D%3D0%29%29throw%20new%20Error%28%27text%20repetition%20requires%20its%20complete%20admitted%20length%27%29%3B%0A%20let%20result%3D%5B%5D%3B%0A%20%2F%2F%20Registered%20semantic%20text%20is%20a%20complete%20dense%20unit%20vector.%20The%20admitted%0A%20%2F%2F%20nonzero%20length%20proves%20each%20remainder%20is%20inside%20that%20vector.%0A%20for%28let%20index%3D0%3Bindex%3Clength%3Bindex%2B%3D1%29result.push%28text%5Bindex%25text.length%5D%3F%3F0%29%3B%0A%20return%20result%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20text%20%40param%20%7Bnumber%5B%5D%7D%20filler%20%40param%20%7Bnumber%7D%20length%20%40param%20%7Bboolean%7D%20start%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20constructUtf16TextPadding%28text%2Cfiller%2Clength%2Cstart%29%7B%0A%20if%28%21Number.isSafeInteger%28length%29%7C%7Clength%3Ctext.length%7C%7Clength%3E1048576%7C%7Clength%3Etext.length%26%26filler.length%3D%3D%3D0%29throw%20new%20Error%28%27text%20padding%20requires%20its%20complete%20admitted%20length%27%29%3B%0A%20const%20added%3Dlength-text.length%3B%0A%20let%20result%3D%5B%5D%3B%0A%20for%28let%20index%3D0%3Bindex%3Clength%3Bindex%2B%3D1%29%7B%0A%20%20const%20original%3Dstart%3Findex%3E%3Dadded%3Aindex%3Ctext.length%3B%0A%20%20const%20position%3Doriginal%3F%28start%3Findex-added%3Aindex%29%3A%28start%3Findex%3Aindex-text.length%29%3B%0A%20%20%2F%2F%20Dense%20registered%20units%20and%20the%20admitted%20added%20length%20bound%20both%20indices.%0A%20%20result.push%28%28original%3Ftext%5Bposition%5D%3Afiller%5Bposition%25filler.length%5D%29%3F%3F0%29%3B%0A%20%7D%0A%20return%20result%3B%0A%7D%0A) (lang: meta-language%20typed%20program)))
