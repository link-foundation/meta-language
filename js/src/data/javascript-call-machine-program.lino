27boolean%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27boolean%27%29%20return%20false%3B%0A%20%20%20%20%20%20return%20left.value%20%3D%3D%3D%20right.value%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27number%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27number%27%29%20return%20false%3B%0A%20%20%20%20%20%20if%20%28left.value%20%3D%3D%3D%20right.value%29%20return%20left.value%20%21%3D%3D%200%20%7C%7C%201%20%2F%20left.value%20%3D%3D%3D%201%20%2F%20right.value%3B%0A%20%20%20%20%20%20return%20Number.isNaN%28left.value%29%20%26%26%20Number.isNaN%28right.value%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27integer%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27integer%27%29%20return%20false%3B%0A%20%20%20%20%20%20return%20left.value%20%3D%3D%3D%20right.value%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27text%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27text%27%29%20return%20false%3B%0A%20%20%20%20%20%20const%20leftUnits%20%3D%20left.units%3B%0A%20%20%20%20%20%20const%20rightUnits%20%3D%20right.units%3B%0A%20%20%20%20%20%20if%20%28leftUnits.length%20%21%3D%3D%20rightUnits.length%29%20return%20false%3B%0A%20%20%20%20%20%20for%20%28let%20at%20%3D%200%3B%20at%20%3C%20leftUnits.length%3B%20at%20%2B%3D%201%29%0A%20%20%20%20%20%20%20%20if%20%28%28leftUnits%5Bat%5D%20%3F%3F%20-1%29%20%21%3D%3D%20%28rightUnits%5Bat%5D%20%3F%3F%20-1%29%29%20return%20false%3B%0A%20%20%20%20%20%20return%20true%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27symbol%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27symbol%27%29%20return%20false%3B%0A%20%20%20%20%20%20return%20left.identity%20%3D%3D%3D%20right.identity%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27object%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27object%27%29%20return%20false%3B%0A%20%20%20%20%20%20return%20left.identity%20%3D%3D%3D%20right.identity%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7B