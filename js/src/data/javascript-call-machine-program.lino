(154167: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BbeginJavaScriptPrimitiveConversion%2CstepJavaScriptPrimitiveConversion%2CresumeJavaScriptPrimitiveConversion%7D%20from%20%27.%2Fjavascript-primitive-conversion.js%27%3B%0A%0A%2F%2A%2A%20%40typedef%20%7B%7B%24%3A%27propertyKeyContinuation%27%2Cstate%3AJavaScriptPrimitiveConversionState%7D%20%7C%0A%20%2A%20%7B%24%3A%27propertyKeyCall%27%2Cstate%3AJavaScriptPrimitiveConversionState%2Ccallee%3AJavaScriptSemanticValue%2C%0A%20%2A%20receiver%3AJavaScriptSemanticValue%2Carguments%3AJavaScriptSemanticValue%5B%5D%7D%20%7C%0A%20%2A%20%7B%24%3A%27propertyKeyCompleted%27%2Ckey%3AJavaScriptSemanticValue%7D%20%7C%0A%20%2A%20%7B%24%3A%27propertyKeyThrow%27%2Cvalue%3AJavaScriptSemanticValue%7D%20%7C%0A%20%2A%20%7B%24%3A%27propertyKeyIntrinsicError%27%2CerrorClass%3Astring%2Creason%3Astring%7D%20%7C%0A%20%2A%20%7B%24%3A%27propertyKeyInvalid%27%2Creason%3Astring%7D%7D%20JavaScriptPropertyKeyConversionTransition%0A%20%2A%2F%0A%0A%2F%2A%2A%20Only%20primitive%20domains%20that%20need%20textual%20conversion%20arrive%20here.%20Actual%0A%20%2A%20Number%2FBigInt%20formatting%20uses%20the%20source%20String%20operation%20and%20its%20existing%0A%20%2A%20translated%20runtime%2C%20never%20a%20hand-transcribed%20native%20formatter.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptPrimitivePropertyKeySpelling%28value%29%7B%0A%20%20switch%28value.%24%29%7B%0A%20%20%20%20case%20%27undefined%27%3Areturn%20%27undefined%27%3B%0A%20%20%20%20case%20%27null%27%3Areturn%20%27null%27%3B%0A%20%20%20%20case%20%27boolean%27%3Areturn%20value.value%3F%27true%27%3A%27false%27%3B%0A%20%20%20%20case%20%27number%27%3Areturn%20String%28value.value%29%3B%0A%20%20%20%20case%20%27integer%27%3Areturn%20String%28value.value%29%3B%0A%20%20%20%20case%20%27text%27%3Athrow%20new%20TypeError%28%27semantic%20text%20keys%20retain%20their%20exact%20units%27%29%3B%0A%20%20%20%20case%20%27symbol%27%3Athrow%20new%20TypeError%28%27semantic%20Symbol%20keys%20retain%20their%20exact%20identity%27%29%3B%0A%20%20%20%20case%20%27object%27%3Athrow%20new%20TypeError%28%27a%20property%20key%20needs%20its%20completed%20actual%20primitive%20conversion%27%29%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20Complete%20ToPropertyKey%20after%20the%20actual%20ToPrimitive%28string%29%20operation.%0A%20%2A%20Symbols%20retain%20identity%3B%20text%20retains%20its%20original%20units%20and%20every%20other%0A%20%2A%20primitive%20uses%20the%20normative%20source%20String%20operation.%20Continuations%20keep%0A%20%2A%20their%20actual%20state%2Fcallee%2Freceiver%2Farguments%20and%20exact%20abrupt%20values.%0A%20%2A%20%40param%20%7BJavaScriptPrimitiveConversionTransition%7D%20transition%0A%20%2A%20%40returns%20%7BJavaScriptPropertyKeyConversionTransition%7D%20%2A%2F%0Aexport%20function%20finishJavaScriptPropertyKeyConversion%28transition%29%7B%0A%20%20switch%28transition.%24%29%7B%0A%20%20%20%20case%20%27primitiveContinuation%27%3Areturn%20%7B%24%3A%27propertyKeyContinuation%27%2Cstate%3Atransition.state%7D%3B%0A%20%20%20%20case%20%27primitiveCall%27%3Areturn%20%7B%24%3A%27propertyKeyCall%27%2Cstate%3Atransition.state%2Ccallee%3Atransition.callee%2Creceiver%3Atransition.receiver%2Carguments%3Atransition.arguments%7D%3B%0A%20%20%20%20case%20%27primitiveThrow%27%3Areturn%20%7B%24%3A%27propertyKeyThrow%27%2Cvalue%3Atransition.value%7D%3B%0A%20%20%20%20case%20%27primitiveIntrinsicError%27%3Areturn%20%7B%24%3A%27propertyKeyIntrinsicError%27%2CerrorClass%3Atransition.errorClass%2Creason%3Atransition.reason%7D%3B%0A%20%20%20%20case%20%27primitiveInvalid%27%3Areturn%20%7B%24%3A%27propertyKeyInvalid%27%2Creason%3Atransition.reason%7D%3B%0A%20%20%20%20case%20%27primitiveCompleted%27%3A%7B%0A%20%20%20%20%20%20const%20value%3Dtransition.value%3B%0A%20%20%20%20%20%20if%28value.%24%3D%3D%3D%27text%27%7C%7Cvalue.%24%3D%3D%3D%27symbol%27%29return%20%7B%24%3A%27propertyKeyCompleted%27%2Ckey%3Avalue%7D%3B%0A%20%20%20%20%20%20if%28value.%24%3D%3D%3D%27object%27%29return%20%7B%24%3A%27propertyKeyInvalid%27%2Creason%3A%27a%20completed%20primitive%20conversion%20cannot%20contain%20an%20Object%27%7D%3B%0A%20%20%20%20%20%20const%20spelling%3DreadJavaScriptPrimitivePropertyKeySpelling%28value%29%3B%0A%20%20%20%20%20%20if%28spelling.length%3E1048576%29return%20%7B%24%3A%27propertyKeyInvalid%27%2Creason%3A%27property%20key%20text%20exceeds%20the%20explicit%20UTF16%20unit%20budget%27%7D%3B%0A%20%20%20%20%20%20const%20units%3D%5B%5D%3B%0A%20%20%20%20%20%20for%28let%20index%3D0%3Bindex%3Cspelling.length%3Bindex%2B%3D1%29units.push%28spelling.charCodeAt%28index%29%29%3B%0A%20%20%20%20%20%20return%20%7B%24%3A%27propertyKeyCompleted%27%2Ckey%3A%7B%24%3A%27text%27%2Cunits%7D%7D%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptSemanticValue%7D%20input%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20exoticKey%20%40returns%20%7BJavaScriptPropertyKeyConversionTransition%7D%20%2A%2F%0Aexport%20function%20beginJavaScriptPropertyKeyConversion%28heap%2Cinput%2CexoticKey%29%7B%0A%20%20return%20finishJavaScriptPropertyKeyConversion%28beginJavaScriptPrimitiveConversion%28heap%2Cinput%2CexoticKey%2C%27string%27%29%29%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptPrimitiveConversionState%7D%20state%0A%20%2A%20%40returns%20%7BJavaScriptPropertyKeyConversionTransition%7D%20%2A%2F%0Aexport%20function%20stepJavaScriptPropertyKeyConversion%28heap%2Cstate%29%7B%0A%20%20if%28state.hint%21%3D%3D%27string%27%29return%20%7B%24%3A%27propertyKeyInvalid%27%2Creason%3A%27a%20property%20key%20continuation%20retains%20its%20actual%20string%20hint%27%7D%3B%0A%20%20return%20finishJavaScriptPropertyKeyConversion%28stepJavaScriptPrimitiveConversion%28heap%2Cstate%29%29%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptPrimi