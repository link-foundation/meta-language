rPresent%29%0A%20%20%20%20return%20createJavaScriptPropertyTransition%28%27keep%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20const%20original%20%3D%20readJavaScriptPropertyDescriptorKind%28current%29%3B%0A%20%20if%20%28%21current.configurable%29%20%7B%0A%20%20%20%20if%20%28proposed.configurablePresent%20%26%26%20proposed.configurable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28proposed.enumerablePresent%20%26%26%20proposed.enumerable%20%21%3D%3D%20current.enumerable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28kind%20%21%3D%3D%20%27generic%27%20%26%26%20kind%20%21%3D%3D%20original%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28original%20%3D%3D%3D%20%27accessor%27%29%20%7B%0A%20%20%20%20%20%20if%20%28proposed.getterPresent%20%26%26%20%21testJavaScriptSemanticSameValue%28proposed.getter%2C%20current.getter%29%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%20%20if%20%28proposed.setterPresent%20%26%26%20%21testJavaScriptSemanticSameValue%28proposed.setter%2C%20current.setter%29%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%7D%20else%20if%20%28%21current.writable%29%20%7B%0A%20%20%20%20%20%20if%20%28proposed.writablePresent%20%26%26%20proposed.writable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%20%20if%20%28proposed.valuePresent%29%20return%20createJavaScriptPropertyTransition%28testJavaScriptSemanticSameValue%28proposed.value%2C%20current.value%29%20%3F%20%27keep%27%20%3A%20%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20base%20%3D%20k