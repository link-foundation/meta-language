(130004: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20integer%20and%20Number%20bit%20operations%20reuse%20their%20normative%20definitions.%0Aimport%20%7BapplyBigIntegerBitwiseOperation%7D%20from%20%27.%2Fbig-integer-bitwise-rules.js%27%3B%0Aimport%20%7BapplyJavaScriptNumberBitwiseOperation%7D%20from%20%27.%2Fnumber-bitwise-rules.js%27%3B%0Aimport%20%7BdivideJavaScriptBigInteger%2CpowerJavaScriptBigInteger%7D%20from%20%27.%2Fbig-integer-conversion-rules.js%27%3B%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operation%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readJavaScriptCallIntegerArity%28operation%29%7B%0A%20if%28operation%3D%3D%3D%27negate%20integer%27%7C%7Coperation%3D%3D%3D%27complement%20integer%20bits%27%7C%7Coperation%3D%3D%3D%27complement%20number%20bits%27%29return%201%3B%0A%20return%20%5B%27add%20integers%27%2C%27subtract%20integers%27%2C%27multiply%20integers%27%2C%27divide%20integers%27%2C%27read%20integer%20remainder%27%2C%27raise%20integer%20power%27%2C%27compare%20integers%27%2C%0A%20%27conjoin%20integer%20bits%27%2C%27disjoin%20integer%20bits%27%2C%27exclude%20equal%20integer%20bits%27%2C%27shift%20integer%20bits%20left%27%2C%27shift%20integer%20bits%20right%27%2C%0A%20%27conjoin%20number%20bits%27%2C%27disjoin%20number%20bits%27%2C%27exclude%20equal%20number%20bits%27%2C%27shift%20number%20bits%20left%27%2C%27shift%20number%20bits%20right%27%2C%27shift%20number%20bits%20right%20unsigned%27%5D.includes%28operation%29%3F2%3A0%3B%0A%7D%0A%2F%2A%2A%20The%20selected%20resource%20profile%20bounds%20intermediate%20work%20separately%20from%0A%20%2A%20arbitrary-integer%20language%20semantics.%20-1%20denotes%20an%20oversized%20input.%0A%20%2A%20%40param%20%7Bbigint%7D%20value%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readJavaScriptCallIntegerWidth%28value%29%7B%0A%20let%20rest%3Dvalue%3C0n%3F-value%3Avalue%2Cwidth%3D0%3B%0A%20while%28rest%3E0n%29%7Bif%28width%3E%3D4096%29return%20-1%3Brest%2F%3D2n%3Bwidth%2B%3D1%3B%7D%0A%20return%20width%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operation%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readJavaScriptCallIntegerBitCode%28operation%29%7B%0A%20if%28operation%3D%3D%3D%27conjoin%20integer%20bits%27%7C%7Coperation%3D%3D%3D%27conjoin%20number%20bits%27%29return%200%3B%0A%20if%28operation%3D%3D%3D%27disjoin%20integer%20bits%27%7C%7Coperation%3D%3D%3D%27disjoin%20number%20bits%27%29return%201%3B%0A%20if%28operation%3D%3D%3D%27exclude%20equal%20integer%20bits%27%7C%7Coperation%3D%3D%3D%27exclude%20equal%20number%20bits%27%29return%202%3B%0A%20if%28operation%3D%3D%3D%27shift%20integer%20bits%20left%27%7C%7Coperation%3D%3D%3D%27shift%20number%20bits%20left%27%29return%203%3B%0A%20if%28operation%3D%3D%3D%27shift%20integer%20bits%20right%27%7C%7Coperation%3D%3D%3D%27shift%20number%20bits%20right%27%29return%204%3B%0A%20if%28operation%3D%3D%3D%27shift%20number%20bits%20right%20unsigned%27%29return%205%3B%0A%20if%28operation%3D%3D%3D%27complement%20integer%20bits%27%7C%7Coperation%3D%3D%3D%27complement%20number%20bits%27%29return%206%3B%0A%20return%20-1%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operation%20%40param%20%7BJavaScriptSemanticValue%5B%5D%7D%20values%20%40returns%20%7BJavaScriptCallPrimitiveResult%7D%20%2A%2F%0Aexport%20function%20executeJavaScriptCallNumberBits%28operation%2Cvalues%29%7B%0A%20const%20left%3Dvalues%5B0%5D%3F%3F%7B%24%3A%27undefined%27%7D%2Cright%3Dvalues%5B1%5D%3F%3F%7B%24%3A%27number%27%2Cvalue%3A0%7D%3B%0A%20if%28left.%24%21%3D%3D%27number%27%29return%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27Number%20bit%20operations%20require%20actual%20converted%20Number%20operands%27%7D%3B%0A%20if%28right.%24%21%3D%3D%27number%27%29return%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27Number%20bit%20operations%20require%20actual%20converted%20Number%20operands%27%7D%3B%0A%20const%20code%3DreadJavaScriptCallIntegerBitCode%28operation%29%3B%0A%20if%28code%3C0%29return%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27Number%20bit%20operations%20require%20their%20actual%20registered%20operation%27%7D%3B%0A%20return%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3AapplyJavaScriptNumberBitwiseOperation%28code%2Cleft.value%2Cright.value%29%7D%7D%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operation%20%40param%20%7BJavaScriptSemanticValue%5B%5D%7D%20values%20%40returns%20%7BJavaScriptCallPrimitiveResult%7D%20%2A%2F%0Aexport%20function%20executeJavaScriptCallIntegerPrimitive%28operation%2Cvalues%29%7B%0A%20if%28operation.includes%28%27number%20bits%27%29%29return%20executeJavaScriptCallNumberBits%28operation%2Cvalues%29%3B%0A%20const%20first%3Dvalues%5B0%5D%3F%3F%7B%24%3A%27undefined%27%7D%2Csecond%3Dvalues%5B1%5D%3F%3F%7B%24%3A%27integer%27%2Cvalue%3A0n%7D%3B%0A%20if%28first.%24%21%3D%3D%27integer%27%29return%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27integer%20operations%20require%20actual%20converted%20BigInt%20operands%27%7D%3B%0A%20if%28second.%24%21%3D%3D%27integer%27%29return%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27integer%20operations%20require%20actual%20converted%20BigInt%20operands%27%7D%3B%0A%20const%20left%3Dfirst.value%2Cright%3Dsecond.value%3B%0A%20if%28%28operation%3D%3D%3D%27divide%20integers%27%7C%7Coperation%3D%3D%3D%27read%20integer%20remainder%27%29%26%26right%3D%3D%3D0n%29return%20%7B%24%3A%27primitiveError%27%2CerrorClass%3A%27RangeError%27%2Creason%3A%27Division%20by%20zero%27%7D%3B%0A%20if%28operation%3D%3D%3D%27raise%20integer%20power%27%26%26right%3C0n%29return%20%7B%24%3A%27primitiveError%27%2CerrorClass%3A%27RangeError%27%2Creason%3A%27Exponent%20must%20be%20positive%27%7D%3B%0A%20const%20leftWidth%3DreadJavaScriptCallIntegerWidth%28left%29%2CrightWidth%3DreadJavaScriptCallIntegerWidth%28right%29%3B%0A%20if%28leftWidth%3C0%7C%7CrightWidth%3C0%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27integer%20input%20exceeds%20the%20selected%204096-bit%20work%20profile%27%7D%3B%0A%20if%28operation%3D%3D%3D%27compare%20integers%27%29return%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3Aleft%3Cright%3F-1%3Aleft%3Eright%3F1%3A0%7D%7D%3B%0A%20if%28operation%3D%3D%3D%27multiply%20integers%27%26%26leftWidth%2BrightWidth%3E4096%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27integer%20multiplication%20estimate%20exceeds%20the%20selected%20output%20work%20profile%27%7D%3B%0A%20if%28operation%3D%3D%3D%27raise%20integer%20power%27%26%26left%21%3D%3D0n%26%26left%21%3D%3D1n%26%26left%21%3D%3D-1n%26%26right%2ABigInt%28leftWidth%29%3E4096n%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27integer%20exponentiation%20estimate%20exceeds%20the%20selected%20output%20work%20profile%27%7D%3B%0A%20if%28operation%3D%3D%3D%27shift%20integer%20bits%20left%27%7C%7Coperation%3D%3D%3D%27shift%20integer%20bits%20right%27%29%7B%0A%20%20const%20growing%3Doperation%3D%3D%3D%27shift%20integer%20bits%20left%27%3Fright%3E%3D0n%3Aright%3C0n%2Ccount%3Dright%3C0n%3F-right%3Aright%3B%0A%20%20if%28left%21%3D%3D0n%26%26growing%26%26count%3EBigInt%284096-leftWidth%29%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27integer%20shift%20estimate%20exceeds%20the%20selected%20output%20work%20profile%27%7D%3B%0A%20%7D%0A%20const%20code%3DreadJavaScriptCallIntegerBitCode%28operation%29%3B%0A%20let%20result%3D0n%3B%0A%20if%28operation%3D%3D%3D%27add%20integers%27%29result%3Dleft%2Bright%3B%0A%20else%20if%28operation%3D%3D%3D%27subtract%20integers%27%29result%3Dleft-right%3B%0A%20else%20if%28operation%3D%3D%3D%27multiply%20integers%27%29result%3Dleft%2Aright%3B%0A%20else%20if%28operation%3D%3D%3D%27divide%20integers%27%7C%7Coperation%3D%3D%3D%27read%20integer%20remainder%27%29result%3DdivideJavaScriptBigInteger%28left%2Cright%29%5Boperation%3D%3D%3D%27divide%20integers%27%3F0%3A1%5D%3F%3F0n%3B%0A%20else%20if%28operation%3D%3D%3D%27raise%20integer%20power%27%29result%3DpowerJavaScriptBigInteger%28left%2Cright%29%5B0%5D%3F%3F0n%3B%0A%20else%20if%28operation%3D%3D%3D%27negate%20integer%27%29result%3D-left%3B%0A%20else%20if%28code%3E%3D0%29result%3DapplyBigIntegerBitwiseOperation%28code%2Cleft%2Cright%29%3B%0A%20else%20return%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27integer%20primitives%20require%20their%20actual%20registered%20operation%27%7D%3B%0A%20if%28readJavaScriptCallIntegerWidth%28result%29%3C0%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27integer%20output%20exceeds%20the%20selected%204096-bit%20work%20profile%27%7D%3B%0A%20return%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27integer%27%2Cvalue%3Aresult%7D%7D%3B%0A%7D%0A) (lang: meta-language%20typed%20program)))
