2A%20%40param%20%7Bboolean%7D%20value%20%40returns%20%7Bbigint%7D%20%2A%2F%0Aexport%20function%20convertJavaScriptBooleanBigInteger%28value%29%20%7B%0A%20%20return%20value%3F1n%3A0n%3B%0A%7D%0A%2F%2A%2A%20Exact%20Number%2FBigInt%20order%3B%20two%20denotes%20the%20unordered%20NaN%20case.%0A%20%2A%20%40param%20%7Bnumber%7D%20value%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptNumberBigInteger%28value%2Cinteger%29%7B%0A%20if%28Number.isNaN%28value%29%29return%202%3B%0A%20if%28value%3D%3D%3DInfinity%29return%201%3B%0A%20if%28value%3D%3D%3D-Infinity%29return%20-1%3B%0A%20const%20floor%3DMath.floor%28value%29%2Clower%3DconvertJavaScriptNumberBigInteger%28floor%29%5B0%5D%3F%3F0n%3B%0A%20if%28lower%3Cinteger%29return%20-1%3B%0A%20if%28lower%3Einteger%29return%201%3B%0A%20return%20value%3D%3D%3Dfloor%3F0%3A1%3B%0A%7D%0A%2F%2A%2A%20String%2FBigInt%20uses%20StringIntegerLiteral%20rather%20than%20StringNumericLiteral.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptStringBigIntegerUnits%28units%2Cinteger%29%7B%0A%20const%20result%3DconvertJavaScriptStringBigIntegerUnits%28units%29%3B%0A%20if%28result.length%21%3D%3D1%29return%202%3B%0A%20const%20value%3Dresult%5B0%5D%3F%3F0n%3B%0A%20return%20value%3Cinteger%3F-1%3Avalue%3Einteger%3F1%3A0%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20bytes%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptUtf8BigInteger%28bytes%2Cinteger%29%7Breturn%20compareJavaScriptStringBigIntegerUnits%28readJavaScriptUtf8StringUnits%28bytes%29%2Cinteger%29%3B%7D%0A%0A%2F%2A%2A%20Truncating%20signed%20division%20and%20dividend-signed%20remainder.%20Empty%20means%20a%0A%20%2A%20zero%20divisor.%20Only%20division%20by%20the%20literal%20two%20is%20a%20primitive%20here%2C%20so%20the%0A%20%2A%20full%20definition%20self-translates%20without%20recursively%20calling%20itself.%0A%20%2A%20%40param%20%7Bbigint%7D%20left%20%40param%20%7Bbigint%7D%20right%20%40returns%20%7Bbigint%5B%5D%7D%20%2A%2F%0Aexport%20function%20divideJavaScriptBigInteger%28left%2Cright%29%20%7B%0A%20%20if%28right%3D%3D%3D0n%29return%20%5B%5D%3B%0A%20%20let%20remaining%3Dleft%3C0n%3F-left%3Aleft%3B%0A%20%20const%20divisor%3Dright%3C0n%3F-right%3Aright%3B%0A%20%20let%20shifted%3Ddivisor%2Cweight%3D1n%2Cquotient%3D0n%3B%0A%20%20while%28shifted%3C%3Dremaining%29%7Bshifted%2A%3D2n%3Bweight%2A%3D2n%3B%7D%0A%20%20while%28weight%3E1n%29%7B%0A%20%20%20%20shifted%2F%3D2n%3Bweight%2F%3D2n%3B%0A%20%20%20%20if%28shifted%3C%3Dremaining%29%7Bremaining-%3Dshifted%3Bquotient%2B%3Dweight%3B%7D%0A%20%20%7D%0A%20%20return%20%5B%28left%3C0n%29%21%3D%3D%28right%3C0n%29%3F-quotient%3Aquotient%2Cleft%3C0n%3F-remaining%3Aremaining%5D%3B%0A%7D%0A%2F%2A%2A%20Repeated%20squaring%20over%20exact%20integers.%20Empty%20is%20a%20negative%20exponent.%0A%20%2A%20%40param%20%7Bbigint%7D%20base%20%40param%20%7Bbigint%7D%20exponent%20%40returns%20%7Bbigint%5B%5D%7D%20%2A%2F%0Aexport%20function%20powerJavaScriptBigInteger%28base%2Cexponent%29%7B%0A%20if%28exponent%3C0n%29return%20%5B%5D%3B%0A%20let%20result%3D1n%2Cweight%3Dbase%2Cremaining%3Dexponent%3B%0A%20while%28remaining%3E0n%29%7B%0A%20%20if%28remaining%252n%3D%3D%3D1n%29result%2A%3Dweight%3B%0A%20%20remaining%2F%3D2n%3B%0A%20%20if%28remaining%3E0n%29weight%2A%3Dweight%3B%0A%20%7D%0A%20return%20%5Bresult%5D%3B%0A%7D%0A%0A%2F%2A%2A%20Directed%20fixed-point%20bounds%20use%20independent%20normalized%20exponents.%20This%0A%20%2A%20keeps%20every%20significand%20bounded%20by%20precision%20even%20for%20enormous%20powers.%0A%20%2A%20%40param%20%7Bbigint%7D%20value%20%40param%20%7Bbigint%7D%20exponent%20%40param%20%7Bbigint%7D%20scale%20%40param%20%7Bboolean%7D%20upward%20%40returns%20%7Bbigint%5B%5D%7D%20%2A%2F%0Afunction%20normalizeNumberPowerBound%28value%2Cexponent%2Cscale%2Cupward%29%7B%0A%20if%28va