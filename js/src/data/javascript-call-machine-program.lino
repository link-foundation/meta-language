9%3D%3D%3D48%26%26end-start%3E%3D2%29%7B%0A%20%20%20%20const%20marker%3Dunits%5Bstart%2B1%5D%3F%3F%20-1%3B%0A%20%20%20%20const%20selected%3Dmarker%3D%3D%3D120%7C%7Cmarker%3D%3D%3D88%3F16%3Amarker%3D%3D%3D98%7C%7Cmarker%3D%3D%3D66%3F2%3Amarker%3D%3D%3D111%7C%7Cmarker%3D%3D%3D79%3F8%3A0%3B%0A%20%20%20%20if%28selected%21%3D%3D0%29%7Bradix%3Dselected%3Bbase%3Dselected%3D%3D%3D16%3F16n%3Aselected%3D%3D%3D8%3F8n%3A2n%3Bstart%2B%3D2%3B%7D%0A%20%20%7D%0A%20%20if%28start%3D%3D%3Dend%29return%20%5B%5D%3B%0A%20%20const%20digits%3D%5B0n%2C1n%2C2n%2C3n%2C4n%2C5n%2C6n%2C7n%2C8n%2C9n%2C10n%2C11n%2C12n%2C13n%2C14n%2C15n%5D%3B%0A%20%20let%20value%3D0n%3B%0A%20%20for%28let%20index%3Dstart%3Bindex%3Cend%3Bindex%2B%3D1%29%7B%0A%20%20%20%20const%20digit%3DreadJavaScriptNumericDigitUnit%28units%5Bindex%5D%3F%3F%20-1%29%3B%0A%20%20%20%20if%28digit%3C0%7C%7Cdigit%3E%3Dradix%29return%20%5B%5D%3B%0A%20%20%20%20value%3Dvalue%2Abase%2B%28digits%5Bdigit%5D%3F%3F0n%29%3B%0A%20%20%7D%0A%20%20return%20%5Bnegative%3F-value%3Avalue%5D%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20bytes%20%40returns%20%7Bbigint%5B%5D%7D%20%2A%2F%0Aexport%20function%20convertJavaScriptUtf8BigInteger%28bytes%29%20%7B%0A%20%20return%20convertJavaScriptStringBigIntegerUnits%28readJavaScriptUtf8StringUnits%28bytes%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Every%20finite%20integral%20binary64%20value%20becomes%20its%20exact%20integer.%0A%20%2A%20%40param%20%7Bnumber%7D%20value%20%40returns%20%7Bbigint%5B%5D%7D%20%2A%2F%0Aexport%20function%20convertJavaScriptNumberBigInteger%28value%29%20%7B%0A%20%20if%28%21Number.isInteger%28value%29%29return%20%5B%5D%3B%0A%20%20const%20negative%3Dvalue%3C0%3B%0A%20%20value%3DMath.abs%28value%29%3B%0A%20%20let%20integer%3D0n%2Cweight%3D1n%3B%0A%20%20while%28value%3E%3D1%29%7B%0A%20%20%20%20if%28value%252%3D%3D%3D1%29integer%2B%3Dweight%3B%0A%20%20%20%20value%3DMath.floor%28value%2F2%29%3Bweight%2A%3D2n%3B%0A%20%20%7D%0A%20%20return%20%5Bnegative%3F-integer%3Ainteger%5D%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bboolean%7D%20value%20%40returns%20%7Bbigint%7D%20%2A%2F%0Aexport%20function%20convertJavaScriptBooleanBigInteger%28value%29%20%7B%0A%20%20return%20value%3F1n%3A0n%3B%0A%7D%0A%2F%2A%2A%20Exact%20Number%2FBigInt%20order%3B%20two%20denotes%20the%20unordered%20NaN%20case.%0A%20%2A%20%40param%20%7Bnumber%7D%20value%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptNumberBigInteger%28value%2Cinteger%29%7B%0A%20if%28Number.isNaN%28value%29%29return%202%3B%0A%20if%28value%3D%3D%3DInfinity%29return%201%3B%0A%20if%28value%3D%3D%3D-Infinity%29return%20-1%3B%0A%20const%20floor%3DMath.floor%28value%29%2Clower%3DconvertJavaScriptNumberBigInteger%28floor%29%5B0%5D%3F%3F0n%3B%0A%20if%28lower%3Cinteger%29return%20-1%3B%0A%20if%28lower%3Einteger%29return%201%3B%0A%20return%20value%3D%3D%3Dfloor%3F0%3A1%3B%0A%7D%0A%2F%2A%2A%20String%2FBigInt%20uses%20StringIntegerLiteral%20rather%20than%20StringNumericLiteral.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptStringBigIntegerUnits%28units%2Cinteger%29%7B%0A%20const%20result%3DconvertJavaScriptStringBigIntegerUnits%28units%29%3B%0A%20if%28result.length%21%3D%3D1%29return%202%3B%0A%20const%20value%3Dresult%5B0%5D%3F%3F0n%3B%0A%20return%20value%3Cinteger%3F-1%3Avalue%3Einteger%3F1%3A0%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20bytes%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptUtf8BigInteger%28bytes%2Cinteger%29%7Breturn%20compareJavaScriptStringBigIntegerUnits%28readJavaScriptUtf8StringUnits%28bytes%29%2Cinteger%29%3B%7D%0A%0A%2F%2A%2A%20Truncating%20signed%20division%20and%20dividend-signed%20remainder.%20Empty%20means%20a%0A%20%2A%20zero%20divisor.%20Only%20division%20by%20the%20literal%20two%20is%20a%20primitive%20here%2C%20so%20the%0A%20%2A%20full%20definition%20self