g%20NaN%20payloads%20absent%20from%20a%20generic%20proposal.%0A%20%2A%20This%20kernel%20neither%20executes%20descriptor%20getters%20nor%20claims%20a%20full%20heap%20model.%0A%20%2A%20%40param%20%7Bboolean%7D%20exists%20%40param%20%7Bboolean%7D%20extensible%0A%20%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20current%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20proposed%0A%20%2A%20%40returns%20%7B%7Bdisposition%3Astring%2Cerror%3Astring%2Cdescriptor%3AJavaScriptPropertyDescriptor%2Cwrites%3Astring%5B%5D%7D%7D%20%2A%2F%0Aexport%20function%20planJavaScriptPropertyDefinition%28exists%2C%20extensible%2C%20current%2C%20proposed%29%20%7B%0A%20%20const%20error%20%3D%20readJavaScriptPropertyDescriptorError%28proposed%29%3B%0A%20%20if%20%28error%20%21%3D%3D%20%27%27%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20error%2C%20current%2C%20%5B%5D%29%3B%0A%20%20if%20%28exists%20%26%26%20%21testCompleteJavaScriptPropertyDescriptor%28current%29%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27InvalidCurrentDescriptor%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20const%20kind%20%3D%20readJavaScriptPropertyDescriptorKind%28proposed%29%3B%0A%20%20if%20%28%21exists%29%20%7B%0A%20%20%20%20if%20%28%21extensible%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20const%20base%20%3D%20createJavaScriptPropertyDescriptor%28kind%2C%20false%2C%20false%29%3B%0A%20%20%20%20const%20descriptor%20%3D%20applyJavaScriptPropertyDescriptorFields%28base%2C%20proposed%29%3B%0A%20%20%20%20return%20createJavaScriptPropertyTransition%28%27create%27%2C%20%27%27%2C%20descriptor%2C%20readJavaScriptPropertyDescriptorWrites%28descriptor%29%29%3B%0A%20%20%7D%0A%20%20if%20%28%21proposed.configurablePresent%20%26%26%20%21proposed.enumerablePresent%20%26%26%20%21proposed.valuePresent%0A%20%20%20%20%26%26%20%21proposed.writablePresent%20%26%26%20%21proposed.getterPresent%20%26%26%20%21proposed.setterPresent%29%0A%20%20%20%20return%20createJavaScriptPropertyTransition%28%27keep%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20const%20original%20%3D%20readJavaScriptPropertyDescriptorKind%28current%29%3B%0A%20%20if%20%28%21current.configurable%29%20%7B%0A%20%20%20%20if%20%28proposed.configurablePresent%20%26%26%20proposed.configurable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28proposed.enumerablePresent%20%26%26%20proposed.enumerable%20%21%3D%3D%20current.enumerable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28kind%20%21%3D%3D%20%27generic%27%20%26%26%20kind%20%21%3D%3D%20original%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28original%20%3D%3D%3D%20%27accessor%27%29%20%7B%0A%20%20%20%20%20%20if%20%28proposed.getterPresent%20%26%26%20%21testJavaScriptSemanticSameValue%28proposed.getter%2C%20current.getter%29%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%20%20if%20%28proposed.setterPresent%20%26%26%20%21testJavaScriptSemanticSameValue%28proposed.setter%2C%20current.setter%29%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%7D%20else%20if%20%28%21current.writable%29%20%7B%0A%20%20%20%20%20%20if%20%28proposed.writablePresent%20%26%26%20proposed.writable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%20%20if%20%28proposed.valuePresent%29%20return%20createJavaScriptPropertyTransition%28testJavaScriptSemanticSameValue%28proposed.value%2C%20current.value%29%20%3F%20%27keep%27%20%3A%20%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20base%20%3D%20k