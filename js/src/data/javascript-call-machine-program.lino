2B%3D%201%29%20%7B%0A%20%20%20%20%20%20%20%20const%20unit%20%3D%20units%5Bat%5D%20%3F%3F%20-1%3B%0A%20%20%20%20%20%20%20%20if%20%28%21Number.isInteger%28unit%29%20%7C%7C%20unit%20%3C%200%20%7C%7C%20unit%20%3E%2065535%29%20return%20%27semantic%20text%20requires%20complete%20ordered%20UTF16%20code%20units%27%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20return%20%27%27%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27symbol%27%3A%20return%20value.identity%20%3E%200n%20%26%26%20value.identity%20%3C%3D%2018446744073709551615n%20%3F%20%27%27%20%3A%20%27a%20symbol%20requires%20a%20positive%20unsigned64%20global%20link%20identity%27%3B%0A%20%20%20%20case%20%27object%27%3A%20return%20value.identity%20%3E%200n%20%26%26%20value.identity%20%3C%3D%2018446744073709551615n%20%3F%20%27%27%20%3A%20%27an%20object%20requires%20a%20positive%20unsigned64%20global%20link%20identity%27%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20Semantic%20SameValue%2C%20including%20NaN%2C%20signed%20zero%2C%20exact%20integers%2C%20text%20units%2C%0A%20%2A%20symbol%20identity%20and%20object%20identity.%20It%20does%20not%20equate%20independently%20named%0A%20%2A%20concepts%20or%20establish%20correspondence%20between%20different%20global%20link%20spaces.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20left%20%40param%20%7BJavaScriptSemanticValue%7D%20right%0A%20%2A%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptSemanticSameValue%28left%2C%20right%29%20%7B%0A%20%20if%20%28readJavaScriptSemanticValueError%28left%29%20%21%3D%3D%20%27%27%20%7C%7C%20readJavaScriptSemanticValueError%28right%29%20%21%3D%3D%20%27%27%29%0A%20%20%20%20throw%20new%20TypeError%28%27SameValue%20requires%20two%20complete%20values%20in%20the%20declared%20semantic%20model%27%29%3B%0A%20%20switch%20%28left.%24%29%20%7B%0A%20%20%20%20case%20%27undefined%27%3A%20return%20right.%24%20%3D%3D%3D%20%27undefined%27%3B%0A%20%20%20%20case%20%27null%27%3A%20return%20right.%24%20%3D%3D%3D%20%27null%27%3B%0A%20%20%20%20case%20%27boolean%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27boolean%27%29%20return%20false%3B%0A%20%20%20%20%20%20return%20left.value%20%3D%3D%3D%20right.value%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27number%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27number%27%29%20return%20false%3B%0A%20%20%20%20%20%20if%20%28left.value%20%3D%3D%3D%20right.value%29%20return%20left.value%20%21%3D%3D%200%20%7C%7C%201%20%2F%20left.value%20%3D%3D%3D%201%20%2F%20right.value%3B%0A%20%20%20%20%20%20return%20Number.isNaN%28left.value%29%20%26%26%20Number.isNaN%28right.value%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27integer%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27integer%27%29%20return%20false%3B%0A%20%20%20%20%20%20return%20left.value%20%3D%3D%3D%20right.value%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27text%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27text%27%29%20return%20false%3B%0A%20%20%20%20%20%20const%20leftUnits%20%3D%20left.units%3B%0A%20%20%20%20%20%20const%20rightUnits%20%3D%20right.units%3B%0A%20%20%20%20%20%20if%20%28leftUnits.length%20%21%3D%3D%20rightUnits.length%29%20return%20false%3B%0A%20%20%20%20%20%20for%20%28let%20at%20%3D%200%3B%20at%20%3C%20leftUnits.length%3B%20at%20%2B%3D%201%29%0A%20%20%20%20%20%20%20%20if%20%28%28leftUnits%5Bat%5D%20%3F%3F%20-1%29%20%21%3D%3D%20%28rightUnits%5Bat%5D%20%3F%3F%20-1%29%29%20return%20false%3B%0A%20%20%20%20%20%20return%20true%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27symbol%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27symbol%27%29%20return%20false%3B%0A%20%20%20%20%20%20return%20left.identity%20%3D%3D%3D%20right.identity%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27object%27%3A%20%7B%0A%20%20%20%20%20%20if%20%28right.%24%20%21%3D%3D%20%27object%27%29%20return%20false%3B%0A%20%20%20%20%20%20return%20left.identity%20%3D%3D%3D%20right.identity%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7B