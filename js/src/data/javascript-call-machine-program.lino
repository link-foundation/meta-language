r%20conversion%20exceeds%20the%20selected%20integer%20work%20profile%27%7D%3B%0A%20%20%20return%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3AconvertJavaScriptBigIntegerNumber%28value.value%29%7D%7D%3B%0A%20%20%7D%0A%20%20case%20%27text%27%3A%7B%0A%20%20%20if%28value.units.length%3E4096%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27Number%20text%20conversion%20exceeds%20the%20selected%204096-unit%20work%20profile%27%7D%3B%0A%20%20%20return%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3AconvertJavaScriptStringNumberUnits%28value.units%29%7D%7D%3B%0A%20%20%7D%0A%20%20case%20%27symbol%27%3Areturn%20%7B%24%3A%27primitiveError%27%2CerrorClass%3A%27TypeError%27%2Creason%3A%27Cannot%20convert%20a%20Symbol%20value%20to%20a%20number%27%7D%3B%0A%20%20case%20%27object%27%3Areturn%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27object%20Number%20conversion%20requires%20the%20actual%20suspended%20ToPrimitive%20protocol%27%7D%3B%0A%20%7D%0A%7D%0A) (lang: meta-language%20typed%20program)))
