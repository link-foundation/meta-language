(155586: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Primitive%20Number%20conversion%20shares%20the%20exact%20StringNumericLiteral%20and%0A%2F%2F%20integer%20rounding%20definitions.%20Object%20conversion%20belongs%20to%20its%20resumable%0A%2F%2F%20ToPrimitive%20protocol%2C%20never%20an%20invented%20host%20conversion%20or%20property%20read.%0Aimport%20%7BconvertJavaScriptStringNumberUnits%2CconvertJavaScriptBigIntegerNumber%7D%20from%20%27.%2Fstring-number-rules.js%27%3B%0Aimport%20%7BreadJavaScriptCallIntegerWidth%7D%20from%20%27.%2Fjavascript-call-integers.js%27%3B%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operation%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7BJavaScriptCallPrimitiveResult%7D%20%2A%2F%0Aexport%20function%20executeJavaScriptCallNumberConversion%28operation%2Cvalue%29%7B%0A%20if%28operation%21%3D%3D%27convert%20explicit%20number%27%26%26operation%21%3D%3D%27coerce%20primitive%20number%27%29return%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27number%20conversion%20needs%20its%20actual%20registered%20operation%27%7D%3B%0A%20switch%28value.%24%29%7B%0A%20%20case%20%27undefined%27%3Areturn%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3ANaN%7D%7D%3B%0A%20%20case%20%27null%27%3Areturn%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3A0%7D%7D%3B%0A%20%20case%20%27boolean%27%3Areturn%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3Avalue.value%3F1%3A0%7D%7D%3B%0A%20%20case%20%27number%27%3Areturn%20%7B%24%3A%27primitiveValue%27%2Cvalue%7D%3B%0A%20%20case%20%27integer%27%3A%7B%0A%20%20%20if%28operation%3D%3D%3D%27coerce%20primitive%20number%27%29return%20%7B%24%3A%27primitiveError%27%2CerrorClass%3A%27TypeError%27%2Creason%3A%27Cannot%20convert%20a%20BigInt%20value%20to%20a%20number%27%7D%3B%0A%20%20%20if%28readJavaScriptCallIntegerWidth%28value.value%29%3C0%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27explicit%20Number%20conversion%20exceeds%20the%20selected%20integer%20work%20profile%27%7D%3B%0A%20%20%20return%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3AconvertJavaScriptBigIntegerNumber%28value.value%29%7D%7D%3B%0A%20%20%7D%0A%20%20case%20%27text%27%3A%7B%0A%20%20%20if%28value.units.length%3E4096%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27Number%20text%20conversion%20exceeds%20the%20selected%204096-unit%20work%20profile%27%7D%3B%0A%20%20%20return%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27number%27%2Cvalue%3AconvertJavaScriptStringNumberUnits%28value.units%29%7D%7D%3B%0A%20%20%7D%0A%20%20case%20%27symbol%27%3Areturn%20%7B%24%3A%27primitiveError%27%2CerrorClass%3A%27TypeError%27%2Creason%3A%27Cannot%20convert%20a%20Symbol%20value%20to%20a%20number%27%7D%3B%0A%20%20case%20%27object%27%3Areturn%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27object%20Number%20conversion%20requires%20the%20actual%20suspended%20ToPrimitive%20protocol%27%7D%3B%0A%20%7D%0A%7D%0A) (lang: meta-language%20typed%20program)))
