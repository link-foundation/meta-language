r%28left%2Cright%2Corigin%29%7B%0A%20const%20first%3DreadRustStandardCollectionStateError%28left%29%3Bif%28first%21%3D%3D%27%27%29return%20first%3Bconst%20second%3DreadRustStandardCollectionStateError%28right%29%3Bif%28second%21%3D%3D%27%27%29return%20second%3B%0A%20if%28origin%3F.%24%21%3D%3D%27rustStandardCollectionEqualityOrigin%27%7C%7C%21origin.proven%7C%7C%21origin.leftAvailable%7C%7C%21origin.rightAvailable%7C%7Corigin.customImplementation%21%3D%3Dfalse%7C%7C%21%5B%27core%3A%3Acmp%3A%3APartialEq%27%2C%27std%3A%3Acmp%3A%3APartialEq%27%5D.includes%28origin.owner%29%7C%7C%21%5B%27equal%27%2C%27not%20equal%27%5D.includes%28origin.operation%29%29return%20%27collection%20equality%20retains%20actual%20available%20closed%20standard%20PartialEq%20operands%20and%20operation%27%3B%0A%20const%20version%3DreadRustStandardCollectionSourceVersionError%28origin.sourceVersionMinor%29%3Bif%28version%21%3D%3D%27%27%29return%20version%3B%0A%20const%20firstOwner%3DresolveRustStandardCollectionOwner%28left.origin.resolvedOwner%2Ctrue%2Cfalse%29%2CsecondOwner%3DresolveRustStandardCollectionOwner%28right.origin.resolvedOwner%2Ctrue%2Cfalse%29%3B%0A%20if%28firstOwner%21%3D%3DsecondOwner%7C%7Cleft.keyDomain%21%3D%3Dright.keyDomain%7C%7Cleft.valueDomain%21%3D%3Dright.valueDomain%7C%7Cleft.pointerWidth%21%3D%3Dright.pointerWidth%7C%7Cleft.origin.typeIdentity%21%3D%3Dright.origin.typeIdentity%7C%7Corigin.typeIdentity%21%3D%3Dleft.origin.typeIdentity%29return%20%27collection%20equality%20preserves%20the%20exact%20standard%20owner%20concrete%20domains%20and%20pointer%20width%20within%20its%20supported%20source%20versions%27%3B%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7BRustStandardCollectionEqualityState%7D%20state%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardCollectionEqualityStateError%28state%29%7B%0A%20if%28state%3F.%24%21%3D%3D%27rustCollectionEqualityState%27%29return%20%27collection%20equality%20retains%20its%20actual%20source%20state%27%