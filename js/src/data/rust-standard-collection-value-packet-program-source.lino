RustStandardCollectionScalars%28firstValue%2CsecondValue%29%21%3D%3D0%29return%20invalid%3B%0A%20%20%20work%2B%3DorderingWork%28firstValue%2CsecondValue%29%3B%0A%20%20%7D%0A%20%7D%0A%20if%28state.phase%3D%3D%3D%27value%27%29%7Bconst%20first%3Dstate.left.entries%5Bstate.index%5D%2Csecond%3Dstate.right.entries%5Bstate.index%5D%3Bif%28compareRustStandardCollectionScalars%28first.key%2Csecond.key%29%21%3D%3D0%29return%20%27ordering%20value%20phase%20retains%20actual%20equal%20selected%20keys%27%3Bwork%2B%3DorderingWork%28first.key%2Csecond.key%29%3B%7D%0A%20return%20work%3D%3D%3Dstate.work%3F%27%27%3A%27ordering%20charged%20work%20retains%20its%20actual%20complete%20equal%20prefix%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7BRustStandardCollectionState%7D%20left%20%40param%20%7BRustStandardCollectionState%7D%20right%20%40param%20%7BRustStandardCollectionOrderingOrigin%7D%20origin%20%40returns%20%7BRustStandardCollectionOrderingTransition%7D%20%2A%2F%0Aexport%20function%20beginRustStandardCollectionOrdering%28left%2Cright%2Corigin%29%7Bconst%20state%3D%7B%24%3A%27rustCollectionOrderingState%27%2Cleft%2Cright%2Corigin%2Cindex%3A0%2Cphase%3A%27key%27%2Cwork%3A0%7D%2Cerror%3DreadRustStandardCollectionOrderingStateError%28state%29%3Breturn%20error%3D%3D%3D%27%27%3F%7B%24%3A%27rustCollectionOrderingContinue%27%2Cstate%7D%3A%7B%24%3A%27rustCollectionOrderingInvalid%27%2Creason%3Aerror%7D%3B%7D%0A%2F%2A%2A%20%40param%20%7BRustStandardCollectionOrderingState%7D%20state%20%40returns%20%7Bnumber%7D%20%2A%2F%0Afunction%20readRustStandardCollectionOrderingWork%28state%29%7B%0A%20if%28state.index%3D%3D%3DMath.min%28state.left.entries.length%2Cstate.right.entries.length%29%29return%200%3B%0A%20const%20first%3Dstate.left.entries%5Bstate.index%5D%2Csecond%3Dstate.right.entries%5Bstate.index%5D%3B%0A%20if%28state.phase%3D%3D%3D%27value%27%29%7B%0A%20%20const%20firstValue%3Dfirst.value%2CsecondValue%3Dsecond.value%3B%0A%20%20if%28firstValue%21%3D%3Dundefined%29%7B%0A%20%20%20if%28secondValue%2