(rule binding_identifier normal (alias %27bid (choice unordered (literal _) (ref identifier))) (concept grammar.binding-identifier) (source-names (tree-sitter bid)))
(rule identifier_list silent (repeat1 (ref identifier)) (concept grammar.identifier-list) (source-names (tree-sitter _ids)))
(rule field_name_identifier silent (alias field_name (ref identifier)) (concept grammar.field-name-identifier) (source-names (tree-sitter _field_name)))
(rule field_name_list silent (repeat1 (ref field_name_identifier)) (concept grammar.field-name-list) (source-names (tree-sitter _field_names)))
