(rule application_statement silent (seq (optional (ref atom_list)) (ref application_expression_statement)) (concept grammar.application-statement) (source-names (tree-sitter _application_stmt)))
(rule application_expression_without_let silent (choice unordered (ref lambda) (alias lambda (ref lambda_extended_or_absurd)) (ref universal_quantification) (ref do) (precedence -1 none (ref atom)) (seq (token (seq (literal quoteGoal) (not (ref word_characters)))) (ref identifier) (literal in) (ref expression)) (seq (token (seq (literal tactic) (not (ref word_characters)))) (ref atom_list)) (seq (token (seq (literal tactic) (not (ref word_characters)))) (ref atom_list) (literal %7C) (ref with_expression_list_body))) (concept grammar.application-expression-without-let) (source-names (tree-sitter _expr2_without_let)))
