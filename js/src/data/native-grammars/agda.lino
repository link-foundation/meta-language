(rule binding_ids_and_absurds silent (precedence -1 none (choice unordered (ref application_body) (seq (ref qualified_identifier_body) (literal %3D) (ref qualified_identifier_body)) (seq (ref qualified_identifier_body) (literal %3D) (literal _)) (seq (literal -) (literal %3D) (ref qualified_identifier_body)) (seq (literal -) (literal %3D) (literal _)))) (concept grammar.binding-ids-and-absurds) (source-names (tree-sitter _binding_ids_and_absurds)))
(rule attribute normal (seq (literal %40) (ref expression_or_attribute)) (concept program.attributes))
(rule attribute_list normal (repeat1 (ref attribute)) (concept grammar.attribute-list) (source-names (tree-sitter attributes)))
(rule expression normal (choice unordered (seq (ref typed_binding_list) (ref arrow) (ref expression)) (seq (optional (ref attribute_list)) (ref atom_list) (ref arrow) (ref expression)) (seq (ref with_expression_list_body) (literal %3D) (ref expression)) (precedence -1 none (ref with_expression_list_body))) (concept grammar.expression) (source-names (tree-sitter expr)))
