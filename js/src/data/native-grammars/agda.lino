(grammar (start source_file) (matching longest) (settling tokens precedence dynamic ambiguity))
(extra (ref comment))
(extra (ref pragma))
(extra (choice unordered (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)) (literal %5Cn)))
(scanner agda_layout (tokens newline indent dedent) (operations (if (equal (depth agda_indents) (integer 0)) (then (push agda_indents (integer 0)))) (if (equal (depth agda_layout_tokens) (integer 0)) (then (if (all (valid dedent) (greater (variable agda_pending_dedents) (integer 0))) (then (set agda_pending_dedents (subtract (variable agda_pending_dedents) (integer 1))) (push agda_layout_tokens (integer 0)) (push agda_layout_tokens (integer 2))) (else (set agda_skipped_newline (integer 0)) (while (next (class plain (char %20) (char %09) (char %0D) (char %0A))) (do (if (next (literal %0A)) (then (set agda_skipped_newline (integer 1)))) (skip (class plain (char %20) (char %09) (char %0D) (char %0A))))) (set agda_width column) (while (greater (variable agda_width) (integer 65535)) (do (set agda_width (subtract (variable agda_width) (integer 65536))))) (if atEnd (then (if (all (valid dedent) (greater (depth agda_indents) (integer 1))) (then (pop agda_indents) (push agda_layout_tokens (integer 0)) (push agda_layout_tokens (integer 2))) (else (if (valid newline) (then (push agda_layout_tokens (integer 0))))))) (else (if (equal (variable agda_skipped_newline) (integer 1)) (then (if (greater (variable agda_width) (top agda_indents)) (then (if (valid indent) (then (push agda_indents (variable agda_width)) (push agda_layout_tokens (integer 1))))) (else (if (valid newline) (then (push agda_layout_tokens (integer 0))))))) (else (if (greater (variable agda_width) (top agda_indents)) (then (if (valid indent) (then (push agda_indents (variable agda_width)) (push agda_layout_tokens (integer 1))))) (else (if (less (variable agda_width) (top agda_indents)) (then (pop agda_indents) (while (all (greater (depth agda_indents) (integer 1)) (less (variable agda_width) (top agda_indents))) (do (pop agda_indents) (set agda_pending_dedents (add (variable agda_pending_dedents) (integer 1))))) (if (valid dedent) (then (push agda_layout_tokens (integer 0)) (push agda_layout_tokens (integer 2))) (else (set agda_pending_dedents (add (variable agda_pending_dedents) (integer 1))))))))))))))))) (if (equal (depth agda_layout_tokens) (integer 0)) (then fail)) (if (equal (top agda_layout_tokens) (integer 0)) (then (pop agda_layout_tokens) (emit newline))) (if (equal (top agda_layout_tokens) (integer 1)) (then (pop agda_layout_tokens) (emit indent))) (if (equal (top agda_layout_tokens) (integer 2)) (then (pop agda_layout_tokens) (emit dedent))) fail))
(kind left_hand_side (source-names (tree-sitter lhs)))
(kind right_hand_side (source-names (tree-sitter rhs)))
(kind qualified_identifier (source-names (tree-sitter qid)))
(kind newline (source-names (tree-sitter _newline)))
(kind indent (source-names (tree-sitter _indent)))
(kind dedent (source-names (tree-sitter _dedent)))
(rule source_file normal (repeat0 (seq (ref declaration) (alias unnamed_token (immediateToken (ref newline))))) (concept grammar.source-file))
(rule universal_quantifier_keyword silent (choice unordered (token (seq (literal forall) (not (ref word_characters)))) (literal %E2%88%80)) (concept grammar.universal-quantifier-keyword) (source-names (tree-sitter _FORALL)))
(rule arrow silent (choice unordered (literal -%3E) (literal %E2%86%92)) (concept grammar.arrow) (source-names (tree-sitter _ARROW)))
(rule lambda_keyword silent (choice unordered (literal %5C) (literal %CE%BB)) (concept grammar.lambda-keyword) (source-names (tree-sitter _LAMBDA)))
(rule ellipsis silent (choice unordered (literal ...) (literal %E2%80%A6)) (concept grammar.ellipsis) (source-names (tree-sitter _ELLIPSIS)))
(rule declaration_block silent (seq (alias unnamed_token (immediateToken (ref indent))) (repeat1 (seq (ref declaration) (alias unnamed_token (immediateToken (ref newline))))) (alias unnamed_token (immediateToken (ref dedent)))) (concept grammar.declaration-block) (source-names (tree-sitter _declaration_block)))
(rule declaration silent (choice unordered (ref field_list) (ref function_definition) (ref data) (ref data_signature) (ref record) (ref record_signature) (ref infix_declaration) (ref generalization_declaration) (ref mutual_definition_block) (ref abstract) (ref private) (ref instance_declaration) (ref macro) (ref postulate) (ref primitive) (ref open) (ref import) (ref module_macro) (ref module) (ref pragma) (ref syntax) (ref pattern) (ref unquote_declaration)) (concept grammar.declaration) (source-names (tree-sitter _declaration)))
(rule field_list normal (seq (token (seq (literal field) (not (ref word_characters)))) (ref signature_block)) (concept grammar.field-list) (source-names (tree-sitter fields)))
(rule signature_block silent (seq (alias unnamed_token (immediateToken (ref indent))) (repeat1 (seq (ref signature) (alias unnamed_token (immediateToken (ref newline))))) (alias unnamed_token (immediateToken (ref dedent)))) (concept grammar.signature-block) (source-names (tree-sitter _signature_block)))
(rule signature normal (choice unordered (seq (optional (token (seq (literal overlap) (not (ref word_characters))))) (ref modal_argument_ids) (literal %3A) (ref expression)) (seq (token (seq (literal instance) (not (ref word_characters)))) (ref signature_block))) (concept grammar.signature))
(rule modal_argument_ids silent (seq (repeat0 (ref attribute)) (ref argument_identifier_list)) (concept grammar.modal-argument-ids) (source-names (tree-sitter _modal_arg_ids)))
(rule function_definition normal (choice unordered (seq (optional (ref attribute_list)) (alias left_hand_side (ref left_hand_side_declaration)) (optional (alias right_hand_side (ref right_hand_side_declaration))) (optional (ref where_clause))) (seq (optional (ref attribute_list)) (alias left_hand_side (ref left_hand_side_definition)) (optional (alias right_hand_side (ref right_hand_side_definition))) (optional (ref where_clause)))) (concept grammar.function-definition) (source-names (tree-sitter function)))
(rule left_hand_side_declaration normal (seq (alias function_name (ref with_expression_list_body)) (optional (ref rewrite_equations)) (optional (ref with_expression_list))) (concept grammar.left-hand-side-declaration) (source-names (tree-sitter lhs_decl)))
(rule left_hand_side_definition normal (precedence 1 none (seq (ref with_expression_list_body) (optional (ref rewrite_equations)) (optional (ref with_expression_list)))) (concept grammar.left-hand-side-definition) (source-names (tree-sitter lhs_defn)))
(rule right_hand_side_declaration normal (seq (literal %3A) (ref expression)) (concept grammar.right-hand-side-declaration) (source-names (tree-sitter rhs_decl)))
(rule right_hand_side_definition normal (seq (literal %3D) (ref expression)) (concept grammar.right-hand-side-definition) (source-names (tree-sitter rhs_defn)))
(rule with_expression_list normal (seq (literal with) (ref expression)) (concept grammar.with-expression-list) (source-names (tree-sitter with_expressions)))
(rule rewrite_equations normal (seq (literal rewrite) (ref with_expression_list_body)) (concept grammar.rewrite-equations))
(rule where_clause normal (seq (optional (seq (literal module) (ref binding_identifier))) (literal where) (optional (ref declaration_block))) (concept grammar.where-clause) (source-names (tree-sitter where)))
(rule data_name normal (alias %27data_name (ref identifier)) (concept grammar.data-name))
(rule data normal (seq (choice unordered (token (seq (literal data) (not (ref word_characters)))) (token (seq (literal codata) (not (ref word_characters))))) (ref data_name) (optional (ref optional_type_binding_list)) (optional (seq (literal %3A) (ref expression))) (literal where) (optional (ref declaration_block))) (concept grammar.data))
(rule data_signature normal (seq (token (seq (literal data) (not (ref word_characters)))) (ref data_name) (optional (ref optional_type_binding_list)) (literal %3A) (ref expression)) (concept grammar.data-signature))
(rule record normal (seq (token (seq (literal record) (not (ref word_characters)))) (alias record_name (ref unbraced_atom)) (optional (ref optional_type_binding_list)) (optional (seq (literal %3A) (ref expression))) (ref record_declarations_block)) (concept grammar.record))
(rule record_declarations_block normal (seq (literal where) (seq (alias unnamed_token (immediateToken (ref indent))) (repeat0 (seq (ref record_directive) (alias unnamed_token (immediateToken (ref newline))))) (repeat0 (seq (ref declaration) (alias unnamed_token (immediateToken (ref newline))))) (alias unnamed_token (immediateToken (ref dedent))))) (concept grammar.record-declarations-block))
(rule record_directive silent (choice unordered (ref record_constructor) (ref record_constructor_instance) (ref record_induction) (ref record_eta)) (concept grammar.record-directive) (source-names (tree-sitter _record_directive)))
(rule record_constructor normal (seq (literal constructor) (ref identifier)) (concept grammar.record-constructor))
(rule record_constructor_instance normal (seq (token (seq (literal instance) (not (ref word_characters)))) (seq (alias unnamed_token (immediateToken (ref indent))) (repeat1 (seq (ref record_constructor) (alias unnamed_token (immediateToken (ref newline))))) (alias unnamed_token (immediateToken (ref dedent))))) (concept grammar.record-constructor-instance))
(rule record_induction normal (choice unordered (token (seq (literal inductive) (not (ref word_characters)))) (token (seq (literal coinductive) (not (ref word_characters))))) (concept grammar.record-induction))
(rule record_eta normal (choice unordered (token (seq (literal eta-equality) (not (ref word_characters)))) (token (seq (literal no-eta-equality) (not (ref word_characters))))) (concept grammar.record-eta))
(rule record_signature normal (seq (token (seq (literal record) (not (ref word_characters)))) (alias record_name (ref unbraced_atom)) (optional (ref optional_type_binding_list)) (literal %3A) (ref expression)) (concept grammar.record-signature))
(rule infix_declaration normal (seq (choice unordered (token (seq (literal infix) (not (ref word_characters)))) (token (seq (literal infixl) (not (ref word_characters)))) (token (seq (literal infixr) (not (ref word_characters))))) (ref integer_literal) (repeat1 (ref binding_identifier))) (concept grammar.infix-declaration) (source-names (tree-sitter infix)))
(rule generalization_declaration normal (seq (token (seq (literal variable) (not (ref word_characters)))) (optional (ref signature_block))) (concept grammar.generalization-declaration) (source-names (tree-sitter generalize)))
(rule mutual_definition_block normal (seq (token (seq (literal mutual) (not (ref word_characters)))) (optional (ref declaration_block))) (concept grammar.mutual-definition-block) (source-names (tree-sitter mutual)))
(rule abstract normal (seq (token (seq (literal abstract) (not (ref word_characters)))) (optional (ref declaration_block))) (concept grammar.abstract))
(rule private normal (seq (token (seq (literal private) (not (ref word_characters)))) (optional (ref declaration_block))) (concept grammar.private))
(rule instance_declaration normal (seq (token (seq (literal instance) (not (ref word_characters)))) (optional (ref declaration_block))) (concept grammar.instance-declaration) (source-names (tree-sitter instance)))
(rule macro normal (seq (token (seq (literal macro) (not (ref word_characters)))) (optional (ref declaration_block))) (concept grammar.macro))
(rule postulate normal (seq (token (seq (literal postulate) (not (ref word_characters)))) (optional (ref declaration_block))) (concept grammar.postulate))
(rule primitive normal (seq (token (seq (literal primitive) (not (ref word_characters)))) (optional (ref type_signature_block))) (concept grammar.primitive))
(rule type_signature_block silent (seq (alias unnamed_token (immediateToken (ref indent))) (repeat1 (seq (ref type_signature) (alias unnamed_token (immediateToken (ref newline))))) (alias unnamed_token (immediateToken (ref dedent)))) (concept grammar.type-signature-block) (source-names (tree-sitter _type_signature_block)))
(rule type_signature normal (seq (ref field_name_list) (literal %3A) (ref expression)) (concept grammar.type-signature))
(rule open normal (seq (literal open) (choice unordered (ref import) (ref module_name)) (optional (ref atom_list)) (optional (ref import_directive_list))) (concept grammar.open))
(rule import normal (seq (token (seq (literal import) (not (ref word_characters)))) (ref module_name)) (concept grammar.import))
(rule module_name normal (ref qualified_identifier_body) (concept grammar.module-name))
(rule import_directive_list silent (repeat1 (ref import_directive)) (concept grammar.import-directive-list) (source-names (tree-sitter _import_directives)))
(rule import_directive normal (choice unordered (literal public) (seq (literal using) (literal %28) (ref comma_import_names) (literal %29)) (seq (literal hiding) (literal %28) (ref comma_import_names) (literal %29)) (seq (literal renaming) (literal %28) (seq (ref renaming_clause) (repeat0 (seq (literal %3B) (ref renaming_clause)))) (literal %29)) (seq (literal using) (literal %28) (literal %29)) (seq (literal hiding) (literal %28) (literal %29)) (seq (literal renaming) (literal %28) (literal %29))) (concept grammar.import-directive))
(rule comma_import_names silent (seq (ref import_name) (repeat0 (seq (literal %3B) (ref import_name)))) (concept grammar.comma-import-names) (source-names (tree-sitter _comma_import_names)))
(rule renaming_clause normal (seq (optional (literal module)) (ref identifier) (literal to) (ref identifier)) (concept grammar.renaming-clause) (source-names (tree-sitter renaming)))
(rule import_name silent (seq (optional (literal module)) (ref identifier)) (concept grammar.import-name) (source-names (tree-sitter _import_name)))
(rule module_macro normal (seq (choice unordered (seq (literal module) (alias module_name (ref qualified_identifier_body))) (seq (literal open) (literal module) (alias module_name (ref qualified_identifier_body)))) (optional (ref optional_type_binding_list)) (literal %3D) (ref module_application) (repeat0 (ref import_directive))) (concept grammar.module-macro))
(rule module_application normal (seq (ref module_name) (choice unordered (precedence 1 none (choice unordered (seq (literal %7B%7B) (ref ellipsis) (literal %7D%7D)) (seq (literal %E2%A6%83) (ref ellipsis) (literal %E2%A6%84)))) (optional (ref atom_list)))) (concept grammar.module-application))
(rule module normal (seq (literal module) (choice unordered (alias module_name (ref qualified_identifier_body)) (alias module_name (literal _))) (optional (ref optional_type_binding_list)) (literal where) (optional (ref declaration_block))) (concept grammar.module))
(rule pragma token (seq (literal %7B-%23) (repeat0 (choice unordered (class negated (char %23)) (seq (literal %23) (class negated (char -))) (seq (literal %23-) (class negated (char %7D))))) (literal %23-%7D)) (concept grammar.pragma))
(rule catchall_pragma normal (seq (literal %7B-%23) (literal CATCHALL) (literal %23-%7D)) (concept grammar.catchall-pragma))
(rule syntax normal (seq (token (seq (literal syntax) (not (ref word_characters)))) (ref identifier) (ref hole_name_list) (literal %3D) (repeat1 (ref identifier))) (concept grammar.syntax))
(rule hole_name_list normal (repeat1 (ref hole_name)) (concept grammar.hole-name-list) (source-names (tree-sitter hole_names)))
(rule hole_name normal (choice unordered (ref simple_top_hole) (seq (literal %7B) (ref simple_hole) (literal %7D)) (choice unordered (seq (literal %7B%7B) (ref simple_hole) (literal %7D%7D)) (seq (literal %E2%A6%83) (ref simple_hole) (literal %E2%A6%84))) (seq (literal %7B) (seq (ref identifier) (literal %3D) (ref simple_hole)) (literal %7D)) (choice unordered (seq (literal %7B%7B) (seq (ref identifier) (literal %3D) (ref simple_hole)) (literal %7D%7D)) (seq (literal %E2%A6%83) (seq (ref identifier) (literal %3D) (ref simple_hole)) (literal %E2%A6%84)))) (concept grammar.hole-name))
(rule simple_top_hole silent (choice unordered (ref identifier) (seq (literal %28) (seq (ref lambda_keyword) (ref binding_identifier) (ref arrow) (ref identifier)) (literal %29))) (concept grammar.simple-top-hole) (source-names (tree-sitter _simple_top_hole)))
(rule simple_hole silent (choice unordered (ref identifier) (seq (ref lambda_keyword) (ref binding_identifier) (ref arrow) (ref identifier))) (concept grammar.simple-hole) (source-names (tree-sitter _simple_hole)))
(rule pattern normal (seq (token (seq (literal pattern) (not (ref word_characters)))) (ref identifier) (optional (ref lambda_bindings)) (literal %3D) (ref expression)) (concept grammar.pattern))
(rule unquote_declaration normal (choice unordered (seq (token (seq (literal unquoteDecl) (not (ref word_characters)))) (literal %3D) (ref expression)) (seq (token (seq (literal unquoteDecl) (not (ref word_characters)))) (ref identifier_list) (literal %3D) (ref expression)) (seq (token (seq (literal unquoteDef) (not (ref word_characters)))) (ref identifier_list) (literal %3D) (ref expression))) (concept grammar.unquote-declaration) (source-names (tree-sitter unquote_decl)))
