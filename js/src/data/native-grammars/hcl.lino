(grammar (start configuration_file) (matching longest) (settling tokens precedence dynamic ambiguity))
(extra (ref comment))
(extra (ref whitespace))
(scanner templates (tokens quoted_template_start quoted_template_end template_literal_chunk template_interpolation_start template_interpolation_end template_directive_start template_directive_end here_document_identifier) (operations (set templates_newline (integer 0)) (while (next (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))) (do (if (next (literal %0A)) (then (set templates_newline (integer 1)))) (skip (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))))) (if (some atEnd (next (literal %00))) (then fail)) (if (all (valid quoted_template_start) (not (equal (top templates_contexts) (text quoted)))) (then (consume (literal %22)) (push templates_contexts (text quoted)) (emit quoted_template_start))) (if (all (valid quoted_template_end) (equal (top templates_contexts) (text quoted))) (then (consume (literal %22)) (pop templates_contexts) (emit quoted_template_end))) (if (all (valid template_interpolation_start) (not (equal (top templates_contexts) (text interpolation)))) (then (consume (literal %24%7B)) (push templates_contexts (text interpolation)) (emit template_interpolation_start))) (if (all (valid template_interpolation_end) (equal (top templates_contexts) (text interpolation))) (then (consume (literal %7D)) (pop templates_contexts) (emit template_interpolation_end))) (if (all (valid template_literal_chunk) (next (literal %24))) (then advance (if (next (literal %7B)) (then fail)) (if (next (literal %24)) (then advance (if (next (literal %7B)) (then advance)))) (emit template_literal_chunk))) (if (all (valid template_directive_start) (not (equal (top templates_contexts) (text directive)))) (then (consume (literal %25%7B)) (push templates_contexts (text directive)) (emit template_directive_start))) (if (all (valid template_directive_end) (equal (top templates_contexts) (text directive))) (then (consume (literal %7D)) (pop templates_contexts) (emit template_directive_end))) (if (all (valid template_literal_chunk) (next (literal %25))) (then advance (if (next (literal %7B)) (then fail)) (if (next (literal %25)) (then advance (if (next (literal %7B)) (then advance)))) (emit template_literal_chunk))) (if (all (valid here_document_identifier) (not (equal (top templates_contexts) (text heredoc)))) (then (consume (repeat1 (class plain (range a z) (range A Z) (range 0 9) (char _) (char -)))) (push templates_labels matched) (push templates_contexts (text heredoc)) (emit here_document_identifier))) (if (all (valid here_document_identifier) (equal (top templates_contexts) (text heredoc)) (equal (variable templates_newline) (integer 1))) (then (consume (repeat1 (class plain (range a z) (range A Z) (range 0 9) (char _) (char -)))) (if (not (equal matched (top templates_labels))) (then fail)) mark (while (all (next (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))) (not (next (literal %0A)))) (do advance)) (if (not (next (literal %0A))) (then fail)) (pop templates_labels) (pop templates_contexts) (emit here_document_identifier))) (if (all (valid template_literal_chunk) (equal (top templates_contexts) (text quoted)) (next (literal %22))) (then fail)) (if (all (valid template_literal_chunk) (equal (top templates_contexts) (text quoted)) (next (literal %5C))) (then advance (if (next (literal u)) (then (consume (literal u)) (consume (repeat 4 4 (class plain (range 0 9) (range a f) (range A F)))) (emit template_literal_chunk))) (if (next (literal U)) (then (consume (literal U)) (consume (repeat 8 8 (class plain (range 0 9) (range a f) (range A F)))) (emit template_literal_chunk))) (if (not (some (next (literal %22)) (next (literal n)) (next (literal r)) (next (literal t)) (next (literal %5C)))) (then fail)) advance (emit template_literal_chunk))) (if (all (valid template_literal_chunk) (some (equal (top templates_contexts) (text quoted)) (equal (top templates_contexts) (text heredoc)))) (then advance (emit template_literal_chunk))) fail))
(kind template_literal_chunk (source-names (tree-sitter _template_literal_chunk)))
(kind here_document_identifier (source-names (tree-sitter heredoc_identifier)))
(rule configuration_file normal (optional (choice unordered (ref body) (ref object))) (concept grammar.configuration-file) (source-names (tree-sitter config_file)))
(rule body normal (repeat1 (choice unordered (ref configuration_attribute) (ref block))) (concept grammar.body))
(rule configuration_attribute normal (seq (ref identifier) (literal %3D) (ref expression)) (concept grammar.configuration-attribute) (source-names (tree-sitter attribute)))
(rule block normal (seq (ref identifier) (repeat0 (choice unordered (ref string_literal) (ref identifier))) (ref block_start) (optional (ref body)) (ref block_end)) (concept grammar.block))
(rule block_start normal (literal %7B) (concept grammar.block-start))
(rule block_end normal (literal %7D) (concept grammar.block-end))
(rule identifier token (seq (choice unordered (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl)) (literal _)) (repeat0 (choice unordered (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (category Mn) (category Mc) (category Nd) (category Pc)) (literal -) (literal %3A%3A)))) (concept grammar.identifier))
(rule expression normal (precedence 0 right (choice unordered (ref expression_term) (ref conditional_expression))) (concept grammar.expression))
(rule expression_term silent (choice unordered (ref literal_value) (ref template_expression) (ref collection_value) (ref variable_expression) (ref function_call) (ref for_expression) (ref operation) (seq (ref expression_term) (ref index)) (seq (ref expression_term) (ref get_attribute)) (seq (ref expression_term) (ref path_expansion)) (seq (literal %28) (ref expression) (literal %29))) (concept grammar.expression-term) (source-names (tree-sitter _expr_term)))
(rule literal_value normal (choice unordered (ref numeric_literal) (ref boolean_literal) (ref null_literal) (ref string_literal)) (concept grammar.literal-value))
(rule numeric_literal normal (choice unordered (alias unnamed_token (token (seq (repeat1 (class plain (range 0 9))) (optional (seq (literal .) (repeat1 (class plain (range 0 9))) (optional (seq (class plain (char e) (char E)) (optional (class plain (char -) (char %2B))) (repeat1 (class plain (range 0 9)))))))))) (alias unnamed_token (token (seq (literal 0x) (repeat1 (class plain (range 0 9) (range a z) (range A Z))))))) (concept grammar.numeric-literal) (source-names (tree-sitter numeric_lit)))
(rule boolean_literal normal (choice unordered (literal true) (literal false)) (concept grammar.boolean-literal) (source-names (tree-sitter bool_lit)))
(rule null_literal token (literal null) (concept grammar.null-literal) (source-names (tree-sitter null_lit)))
(rule string_literal normal (precedence 2 none (seq (alias quoted_template_start (immediateToken (ref quoted_template_start))) (optional (ref template_literal)) (alias quoted_template_end (immediateToken (ref quoted_template_end))))) (concept grammar.string-literal) (source-names (tree-sitter string_lit)))
(rule collection_value normal (choice unordered (ref tuple) (ref object)) (concept grammar.collection-value))
(rule comma silent (literal %2C) (concept grammar.comma) (source-names (tree-sitter _comma)))
(rule tuple normal (seq (ref tuple_start) (optional (ref tuple_element_list)) (ref tuple_end)) (concept grammar.tuple))
(rule tuple_start normal (literal %5B) (concept grammar.tuple-start))
(rule tuple_end normal (literal %5D) (concept grammar.tuple-end))
(rule tuple_element_list silent (seq (ref expression) (repeat0 (seq (ref comma) (ref expression))) (optional (ref comma))) (concept grammar.tuple-element-list) (source-names (tree-sitter _tuple_elems)))
(rule object normal (seq (ref object_start) (optional (ref object_element_list)) (ref object_end)) (concept grammar.object))
(rule object_start normal (literal %7B) (concept grammar.object-start))
(rule object_end normal (literal %7D) (concept grammar.object-end))
(rule object_element_list silent (seq (ref object_element) (repeat0 (seq (optional (ref comma)) (ref object_element))) (optional (ref comma))) (concept grammar.object-element-list) (source-names (tree-sitter _object_elems)))
(rule object_element normal (seq (capture labeled key (ref expression)) (choice unordered (literal %3D) (literal %3A)) (capture labeled val (ref expression))) (concept grammar.object-element) (source-names (tree-sitter object_elem)))
(rule index normal (choice unordered (ref new_index) (ref legacy_index)) (concept grammar.index))
(rule new_index normal (seq (literal %5B) (ref expression) (literal %5D)) (concept grammar.new-index))
(rule legacy_index normal (seq (literal .) (alias unnamed_token (token (repeat1 (class plain (range 0 9)))))) (concept grammar.legacy-index))
(rule get_attribute normal (seq (literal .) (ref identifier)) (concept grammar.get-attribute) (source-names (tree-sitter get_attr)))
(rule path_expansion normal (choice unordered (ref attribute_expansion) (ref complete_expansion)) (concept grammar.path-expansion) (source-names (tree-sitter splat)))
(rule attribute_expansion normal (precedence 0 right (seq (literal .%2A) (repeat0 (choice unordered (ref get_attribute) (ref index))))) (concept grammar.attribute-expansion) (source-names (tree-sitter attr_splat)))
(rule complete_expansion normal (precedence 0 right (seq (literal %5B%2A%5D) (repeat0 (choice unordered (ref get_attribute) (ref index))))) (concept grammar.complete-expansion) (source-names (tree-sitter full_splat)))
(rule for_expression normal (choice unordered (ref for_tuple_expression) (ref for_object_expression)) (concept grammar.for-expression) (source-names (tree-sitter for_expr)))
(rule for_tuple_expression normal (seq (ref tuple_start) (ref for_intro) (ref expression) (optional (ref iteration_condition)) (ref tuple_end)) (concept grammar.for-tuple-expression) (source-names (tree-sitter for_tuple_expr)))
(rule for_object_expression normal (seq (ref object_start) (ref for_intro) (ref expression) (literal %3D%3E) (ref expression) (optional (ref ellipsis)) (optional (ref iteration_condition)) (ref object_end)) (concept grammar.for-object-expression) (source-names (tree-sitter for_object_expr)))
(rule for_intro normal (seq (literal for) (ref identifier) (optional (seq (literal %2C) (ref identifier))) (literal in) (ref expression) (literal %3A)) (concept grammar.for-intro))
(rule iteration_condition normal (seq (literal if) (ref expression)) (concept grammar.iteration-condition) (source-names (tree-sitter for_cond)))
(rule variable_expression normal (precedence 0 right (ref identifier)) (concept grammar.variable-expression) (source-names (tree-sitter variable_expr)))
(rule function_call normal (seq (ref identifier) (ref function_call_start) (optional (ref function_argument_list)) (ref function_call_end)) (concept grammar.function-call))
(rule function_call_start silent (literal %28) (concept grammar.function-call-start) (source-names (tree-sitter _function_call_start)))
(rule function_call_end silent (literal %29) (concept grammar.function-call-end) (source-names (tree-sitter _function_call_end)))
(rule function_argument_list normal (precedence 0 right (seq (ref expression) (repeat0 (seq (ref comma) (ref expression))) (optional (choice unordered (ref comma) (ref ellipsis))))) (concept grammar.function-argument-list) (source-names (tree-sitter function_arguments)))
(rule ellipsis token (literal ...) (concept grammar.ellipsis))
(rule conditional_expression normal (precedence 0 left (seq (ref expression) (literal %3F) (ref expression) (literal %3A) (ref expression))) (concept grammar.conditional-expression) (source-names (tree-sitter conditional)))
(rule operation normal (choice unordered (ref unary_operation) (ref binary_operation)) (concept grammar.operation))
(rule unary_operation normal (precedence 7 left (seq (choice unordered (literal -) (literal %21)) (ref expression_term))) (concept grammar.unary-operation))
(rule binary_operation normal (choice unordered (precedence 6 left (seq (ref expression_term) (choice unordered (literal %2A) (literal %2F) (literal %25)) (ref expression_term))) (precedence 5 left (seq (ref expression_term) (choice unordered (literal %2B) (literal -)) (ref expression_term))) (precedence 4 left (seq (ref expression_term) (choice unordered (literal %3E) (literal %3E%3D) (literal %3C) (literal %3C%3D)) (ref expression_term))) (precedence 3 left (seq (ref expression_term) (choice unordered (literal %3D%3D) (literal %21%3D)) (ref expression_term))) (precedence 2 left (seq (ref expression_term) (literal %26%26) (ref expression_term))) (precedence 1 left (seq (ref expression_term) (literal %7C%7C) (ref expression_term)))) (concept grammar.binary-operation))
(rule template_expression normal (choice unordered (ref quoted_template) (ref here_document_template)) (concept grammar.template-expression) (source-names (tree-sitter template_expr)))
(rule quoted_template normal (precedence 1 none (seq (alias quoted_template_start (immediateToken (ref quoted_template_start))) (optional (ref template)) (alias quoted_template_end (immediateToken (ref quoted_template_end))))) (concept grammar.quoted-template))
(rule here_document_template normal (seq (ref here_document_start) (alias here_document_identifier (immediateToken (ref here_document_identifier))) (optional (ref template)) (alias here_document_identifier (immediateToken (ref here_document_identifier)))) (concept grammar.here-document-template) (source-names (tree-sitter heredoc_template)))
(rule here_document_start normal (choice unordered (literal %3C%3C) (literal %3C%3C-)) (concept grammar.here-document-start) (source-names (tree-sitter heredoc_start)))
(rule strip_marker token (literal %7E) (concept grammar.strip-marker))
(rule template silent (repeat1 (choice unordered (ref template_interpolation) (ref template_directive) (ref template_literal))) (concept grammar.template) (source-names (tree-sitter _template)))
(rule template_literal normal (precedence 0 right (repeat1 (alias unnamed_token (immediateToken (ref template_literal_chunk))))) (concept grammar.template-literal))
(rule template_interpolation normal (seq (alias template_interpolation_start (immediateToken (ref template_interpolation_start))) (optional (ref strip_marker)) (optional (ref expression)) (optional (ref strip_marker)) (alias template_interpolation_end (immediateToken (ref template_interpolation_end)))) (concept grammar.template-interpolation))
(rule template_directive normal (choice unordered (ref iteration_template) (ref conditional_template)) (concept grammar.template-directive))
(rule iteration_template normal (seq (ref template_for_start) (optional (ref template)) (ref template_for_end)) (concept grammar.iteration-template) (source-names (tree-sitter template_for)))
(rule template_for_start normal (seq (alias template_directive_start (immediateToken (ref template_directive_start))) (optional (ref strip_marker)) (literal for) (ref identifier) (optional (seq (literal %2C) (ref identifier))) (literal in) (ref expression) (optional (ref strip_marker)) (alias template_directive_end (immediateToken (ref template_directive_end)))) (concept grammar.template-for-start))
(rule template_for_end normal (seq (alias template_directive_start (immediateToken (ref template_directive_start))) (optional (ref strip_marker)) (literal endfor) (optional (ref strip_marker)) (alias template_directive_end (immediateToken (ref template_directive_end)))) (concept grammar.template-for-end))
(rule conditional_template normal (seq (ref template_if_intro) (optional (ref template)) (optional (seq (ref template_else_intro) (optional (ref template)))) (ref template_if_end)) (concept grammar.conditional-template) (source-names (tree-sitter template_if)))
(rule template_if_intro normal (seq (alias template_directive_start (immediateToken (ref template_directive_start))) (optional (ref strip_marker)) (literal if) (ref expression) (optional (ref strip_marker)) (alias template_directive_end (immediateToken (ref template_directive_end)))) (concept grammar.template-if-intro))
(rule template_else_intro normal (seq (alias template_directive_start (immediateToken (ref template_directive_start))) (optional (ref strip_marker)) (literal else) (optional (ref strip_marker)) (alias template_directive_end (immediateToken (ref template_directive_end)))) (concept grammar.template-else-intro))
(rule template_if_end normal (seq (alias template_directive_start (immediateToken (ref template_directive_start))) (optional (ref strip_marker)) (literal endif) (optional (ref strip_marker)) (alias template_directive_end (immediateToken (ref template_directive_end)))) (concept grammar.template-if-end))
(rule comment token (choice unordered (seq (literal %23) (repeat0 (class negated (char %0A)))) (seq (literal %2F%2F) (repeat0 (class negated (char %0A)))) (seq (literal %2F%2A) (seq (repeat0 (class negated (char %2A))) (repeat1 (literal %2A)) (repeat0 (seq (class negated (char %2F) (char %2A)) (repeat0 (class negated (char %2A))) (repeat1 (literal %2A))))) (literal %2F))) (concept grammar.comment))
(rule whitespace token (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)) (concept grammar.whitespace) (source-names (tree-sitter _whitespace)))
