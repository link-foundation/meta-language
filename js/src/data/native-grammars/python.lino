(rule module normal (repeat0 (ref statement)) (concept grammar.module))
(rule statement silent (choice unordered (ref simple_statement_sequence) (ref compound_statement)) (concept grammar.statement) (source-names (tree-sitter _statement)))
(rule simple_statement_sequence silent (seq (seq (ref simple_statement) (repeat0 (seq (literal %3B) (ref simple_statement)))) (optional (literal %3B)) (alias unnamed_token (immediateToken (ref newline)))) (concept grammar.simple-statement-sequence) (source-names (tree-sitter _simple_statements)))
(rule simple_statement silent (choice unordered (ref future_import_statement) (ref import_statement) (ref import_from_statement) (ref print_statement) (ref assert_statement) (ref expression_statement) (ref return_statement) (ref delete_statement) (ref raise_statement) (ref pass_keyword_statement) (ref break_statement) (ref continue_statement) (ref global_statement) (ref non_local_statement) (ref exec_statement) (ref type_alias_statement)) (concept grammar.simple-statement) (source-names (tree-sitter _simple_statement)))
(rule import_statement normal (seq (token (seq (literal import) (not (ref word_characters)))) (ref import_list)) (concept grammar.import-statement))
(rule import_prefix normal (repeat1 (literal .)) (concept grammar.import-prefix))
(rule relative_import normal (seq (ref import_prefix) (optional (ref dotted_name))) (concept grammar.relative-import))
(rule future_import_statement normal (seq (token (seq (literal from) (not (ref word_characters)))) (token (seq (literal __future__) (not (ref word_characters)))) (token (seq (literal import) (not (ref word_characters)))) (choice unordered (ref import_list) (seq (literal %28) (ref import_list) (literal %29)))) (concept grammar.future-import-statement))
(rule import_from_statement normal (seq (token (seq (literal from) (not (ref word_characters)))) (capture labeled module_name (choice unordered (ref relative_import) (ref dotted_name))) (token (seq (literal import) (not (ref word_characters)))) (choice unordered (ref wildcard_import) (ref import_list) (seq (literal %28) (ref import_list) (literal %29)))) (concept grammar.import-from-statement))
(rule import_list silent (seq (seq (capture labeled name (choice unordered (ref dotted_name) (ref import_with_alias))) (repeat0 (seq (literal %2C) (capture labeled name (choice unordered (ref dotted_name) (ref import_with_alias)))))) (optional (literal %2C))) (concept grammar.import-list) (source-names (tree-sitter _import_list)))
(rule import_with_alias normal (seq (capture labeled name (ref dotted_name)) (token (seq (literal as) (not (ref word_characters)))) (capture labeled alias (ref identifier))) (concept grammar.import-with-alias) (source-names (tree-sitter aliased_import)))
(rule wildcard_import normal (literal %2A) (concept grammar.wildcard-import))
(rule print_statement normal (seq (not (token (seq (literal print) (repeat0 (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))) (literal %28)))) (choice unordered (precedence 1 none (seq (token (seq (literal print) (not (ref word_characters)))) (ref chevron) (repeat0 (seq (literal %2C) (capture labeled argument (ref expression)))) (optional (literal %2C)))) (precedence -3 none (dynamicPrecedence -1 (seq (token (seq (literal print) (not (ref word_characters)))) (seq (capture labeled argument (ref expression)) (repeat0 (seq (literal %2C) (capture labeled argument (ref expression))))) (optional (literal %2C))))))) (concept grammar.print-statement))
(rule chevron normal (seq (literal %3E%3E) (ref expression)) (concept grammar.chevron))
(rule assert_statement normal (seq (token (seq (literal assert) (not (ref word_characters)))) (seq (ref expression) (repeat0 (seq (literal %2C) (ref expression))))) (concept grammar.assert-statement))
(rule expression_statement normal (choice unordered (ref expression) (seq (seq (ref expression) (repeat0 (seq (literal %2C) (ref expression)))) (optional (literal %2C))) (ref value_assignment) (ref augmented_assignment) (ref yield_expression)) (concept grammar.expression-statement))
(rule named_expression normal (seq (capture labeled name (ref named_expression_left_hand_side)) (literal %3A%3D) (capture labeled value (ref expression))) (concept grammar.named-expression))
(rule named_expression_left_hand_side silent (choice unordered (ref identifier) (ref keyword_identifier)) (concept grammar.named-expression-left-hand-side) (source-names (tree-sitter _named_expression_lhs)))
(rule return_statement normal (seq (token (seq (literal return) (not (ref word_characters)))) (optional (ref expression_sequence))) (concept grammar.return-statement))
(rule delete_statement normal (seq (token (seq (literal del) (not (ref word_characters)))) (ref expression_sequence)) (concept grammar.delete-statement))
(rule expression_sequence silent (choice unordered (ref expression) (ref expression_list)) (concept grammar.expression-sequence) (source-names (tree-sitter _expressions)))
(rule raise_statement normal (seq (token (seq (literal raise) (not (ref word_characters)))) (optional (ref expression_sequence)) (optional (seq (token (seq (literal from) (not (ref word_characters)))) (capture labeled cause (ref expression))))) (concept grammar.raise-statement))
(rule pass_keyword_statement normal (precedence 0 left (token (seq (literal pass) (not (ref word_characters))))) (concept grammar.pass-keyword-statement) (source-names (tree-sitter pass_statement)))
(rule break_statement normal (precedence 0 left (token (seq (literal break) (not (ref word_characters))))) (concept grammar.break-statement))
(rule continue_statement normal (precedence 0 left (token (seq (literal continue) (not (ref word_characters))))) (concept grammar.continue-statement))
(rule compound_statement silent (choice unordered (ref if_statement) (ref for_statement) (ref while_statement) (ref try_statement) (ref with_statement) (ref function_definition) (ref class_definition) (ref decorated_definition) (ref match_statement)) (concept grammar.compound-statement) (source-names (tree-sitter _compound_statement)))
(rule if_statement normal (seq (token (seq (literal if) (not (ref word_characters)))) (capture labeled condition (ref expression)) (literal %3A) (capture labeled consequence (ref suite)) (repeat0 (capture labeled alternative (ref else_if_clause))) (optional (capture labeled alternative (ref else_clause)))) (concept grammar.if-statement))
(rule else_if_clause normal (seq (token (seq (literal elif) (not (ref word_characters)))) (capture labeled condition (ref expression)) (literal %3A) (capture labeled consequence (ref suite))) (concept grammar.else-if-clause) (source-names (tree-sitter elif_clause)))
(rule else_clause normal (seq (token (seq (literal else) (not (ref word_characters)))) (literal %3A) (capture labeled body (ref suite))) (concept grammar.else-clause))
(rule match_statement normal (seq (token (seq (literal match) (not (ref word_characters)))) (seq (capture labeled subject (ref expression)) (repeat0 (seq (literal %2C) (capture labeled subject (ref expression))))) (optional (literal %2C)) (literal %3A) (capture labeled body (alias block (ref match_block)))) (concept grammar.match-statement))
(rule match_block silent (choice unordered (seq (alias unnamed_token (immediateToken (ref indent))) (repeat0 (capture labeled alternative (ref case_clause))) (alias unnamed_token (immediateToken (ref dedent)))) (alias unnamed_token (immediateToken (ref newline)))) (concept grammar.match-block) (source-names (tree-sitter _match_block)))
(rule case_clause normal (seq (token (seq (literal case) (not (ref word_characters)))) (seq (ref match_case_pattern) (repeat0 (seq (literal %2C) (ref match_case_pattern)))) (optional (literal %2C)) (optional (capture labeled guard (ref if_clause))) (literal %3A) (capture labeled consequence (ref suite))) (concept grammar.case-clause))
(rule for_statement normal (seq (optional (token (seq (literal async) (not (ref word_characters))))) (token (seq (literal for) (not (ref word_characters)))) (capture labeled left (ref left_hand_side)) (token (seq (literal in) (not (ref word_characters)))) (capture labeled right (ref expression_sequence)) (literal %3A) (capture labeled body (ref suite)) (capture labeled alternative (optional (ref else_clause)))) (concept grammar.for-statement))
(rule while_statement normal (seq (token (seq (literal while) (not (ref word_characters)))) (capture labeled condition (ref expression)) (literal %3A) (capture labeled body (ref suite)) (optional (capture labeled alternative (ref else_clause)))) (concept grammar.while-statement))
(rule try_statement normal (seq (token (seq (literal try) (not (ref word_characters)))) (literal %3A) (capture labeled body (ref suite)) (repeat0 (ref except_clause)) (optional (ref else_clause)) (optional (ref finally_clause))) (concept grammar.try-statement))
(rule except_clause normal (seq (token (seq (literal except) (not (ref word_characters)))) (optional (dynamicPrecedence 2 (token (lexicalPrecedence 1 (literal %2A))))) (optional (choice unordered (seq (capture labeled value (ref exception_expression)) (optional (seq (token (seq (literal as) (not (ref word_characters)))) (capture labeled alias (ref exception_expression))))) (seq (capture labeled value (ref exception_expression)) (repeat0 (seq (literal %2C) (capture labeled value (ref exception_expression))))))) (literal %3A) (ref suite)) (concept grammar.except-clause))
(rule finally_clause normal (seq (token (seq (literal finally) (not (ref word_characters)))) (literal %3A) (ref suite)) (concept grammar.finally-clause))
(rule with_statement normal (seq (optional (token (seq (literal async) (not (ref word_characters))))) (token (seq (literal with) (not (ref word_characters)))) (ref with_clause) (literal %3A) (capture labeled body (ref suite))) (concept grammar.with-statement))
(rule with_clause normal (choice unordered (seq (seq (ref with_item) (repeat0 (seq (literal %2C) (ref with_item)))) (optional (literal %2C))) (seq (literal %28) (seq (ref with_item) (repeat0 (seq (literal %2C) (ref with_item)))) (optional (literal %2C)) (literal %29))) (concept grammar.with-clause))
(rule with_item normal (dynamicPrecedence 1 (capture labeled value (ref expression))) (concept grammar.with-item))
(rule function_definition normal (seq (optional (token (seq (literal async) (not (ref word_characters))))) (token (seq (literal def) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled type_parameters (optional (ref type_parameter))) (capture labeled parameters (ref parameter_list)) (optional (seq (literal -%3E) (capture labeled return_type (ref type)))) (literal %3A) (capture labeled body (ref suite))) (concept grammar.function-definition))
(rule parameter_list normal (seq (literal %28) (optional (ref parameter_sequence)) (literal %29)) (concept grammar.parameter-list) (source-names (tree-sitter parameters)))
(rule lambda_parameter_list normal (ref parameter_sequence) (concept grammar.lambda-parameter-list) (source-names (tree-sitter lambda_parameters)))
(rule list_splat normal (seq (literal %2A) (ref expression)) (concept grammar.list-splat))
(rule dictionary_splat normal (seq (literal %2A%2A) (ref expression)) (concept grammar.dictionary-splat))
(rule global_statement normal (seq (token (seq (literal global) (not (ref word_characters)))) (seq (ref identifier) (repeat0 (seq (literal %2C) (ref identifier))))) (concept grammar.global-statement))
(rule non_local_statement normal (seq (token (seq (literal nonlocal) (not (ref word_characters)))) (seq (ref identifier) (repeat0 (seq (literal %2C) (ref identifier))))) (concept grammar.non-local-statement) (source-names (tree-sitter nonlocal_statement)))
(rule exec_statement normal (seq (token (seq (literal exec) (not (ref word_characters)))) (capture labeled code (choice unordered (ref string) (ref identifier))) (optional (seq (token (seq (literal in) (not (ref word_characters)))) (seq (ref expression) (repeat0 (seq (literal %2C) (ref expression))))))) (concept grammar.exec-statement))
(rule type_alias_statement normal (dynamicPrecedence 1 (seq (token (seq (literal type) (not (ref word_characters)))) (capture labeled left (ref type)) (literal %3D) (capture labeled right (ref type)))) (concept grammar.type-alias-statement))
(rule class_definition normal (seq (token (seq (literal class) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled type_parameters (optional (ref type_parameter))) (capture labeled superclasses (optional (ref argument_list))) (literal %3A) (capture labeled body (ref suite))) (concept grammar.class-definition))
(rule type_parameter normal (seq (literal %5B) (seq (ref type) (repeat0 (seq (literal %2C) (ref type)))) (optional (literal %2C)) (literal %5D)) (concept grammar.type-parameter))
(rule parenthesized_list_splat normal (precedence 1 none (seq (literal %28) (choice unordered (alias parenthesized_expression (ref parenthesized_list_splat)) (ref list_splat)) (literal %29))) (concept grammar.parenthesized-list-splat))
(rule argument_list normal (seq (literal %28) (optional (seq (choice unordered (ref expression) (ref list_splat) (ref dictionary_splat) (alias parenthesized_expression (ref parenthesized_list_splat)) (ref keyword_argument)) (repeat0 (seq (literal %2C) (choice unordered (ref expression) (ref list_splat) (ref dictionary_splat) (alias parenthesized_expression (ref parenthesized_list_splat)) (ref keyword_argument)))))) (optional (literal %2C)) (literal %29)) (concept grammar.argument-list))
(rule decorated_definition normal (seq (repeat1 (ref decorator)) (capture labeled definition (choice unordered (ref class_definition) (ref function_definition)))) (concept grammar.decorated-definition))
(rule decorator normal (seq (literal %40) (ref expression) (alias unnamed_token (immediateToken (ref newline)))) (concept grammar.decorator))
(rule suite silent (choice ordered (seq (alias unnamed_token (immediateToken (ref indent))) (ref block)) (choice unordered (alias block (ref simple_statement_sequence)) (seq (alias unnamed_token (immediateToken (ref indent))) (ref block)) (alias block (immediateToken (ref newline))))) (concept grammar.suite) (source-names (tree-sitter _suite)))
(rule block normal (seq (repeat0 (ref statement)) (alias unnamed_token (immediateToken (ref dedent)))) (concept grammar.block))
(rule expression_list normal (precedence 0 right (seq (ref expression) (choice unordered (literal %2C) (seq (repeat1 (seq (literal %2C) (ref expression))) (optional (literal %2C)))))) (concept grammar.expression-list))
(rule dotted_name normal (precedence 1 none (seq (ref identifier) (repeat0 (seq (literal .) (ref identifier))))) (concept grammar.dotted-name))
(rule match_case_pattern normal (precedence 1 none (choice unordered (alias as_pattern (ref as_pattern_content)) (ref keyword_pattern) (ref simple_pattern))) (concept grammar.match-case-pattern) (source-names (tree-sitter case_pattern)))
(rule simple_pattern silent (precedence 1 none (choice unordered (ref class_pattern) (ref splat_pattern) (ref union_pattern) (alias list_pattern (ref list_pattern_content)) (alias tuple_pattern (ref tuple_pattern_content)) (ref dictionary_pattern) (ref string) (ref concatenated_string) (ref true) (ref false_literal) (ref none) (seq (optional (literal -)) (choice unordered (ref integer_literal) (ref float))) (ref complex_pattern) (ref dotted_name) (token (seq (literal _) (not (ref word_characters)))))) (concept grammar.simple-pattern) (source-names (tree-sitter _simple_pattern)))
(rule as_pattern_content silent (seq (ref match_case_pattern) (token (seq (literal as) (not (ref word_characters)))) (ref identifier)) (concept grammar.as-pattern-content) (source-names (tree-sitter _as_pattern)))
(rule union_pattern normal (precedence 0 right (seq (ref simple_pattern) (repeat1 (precedence 0 left (seq (literal %7C) (ref simple_pattern)))))) (concept grammar.union-pattern))
(rule list_pattern_content silent (seq (literal %5B) (optional (seq (seq (ref match_case_pattern) (repeat0 (seq (literal %2C) (ref match_case_pattern)))) (optional (literal %2C)))) (literal %5D)) (concept grammar.list-pattern-content) (source-names (tree-sitter _list_pattern)))
(rule tuple_pattern_content silent (seq (literal %28) (optional (seq (seq (ref match_case_pattern) (repeat0 (seq (literal %2C) (ref match_case_pattern)))) (optional (literal %2C)))) (literal %29)) (concept grammar.tuple-pattern-content) (source-names (tree-sitter _tuple_pattern)))
(rule dictionary_pattern normal (seq (literal %7B) (optional (seq (seq (choice unordered (ref key_value_pattern) (ref splat_pattern)) (repeat0 (seq (literal %2C) (choice unordered (ref key_value_pattern) (ref splat_pattern))))) (optional (literal %2C)))) (literal %7D)) (concept grammar.dictionary-pattern) (source-names (tree-sitter dict_pattern)))
(rule key_value_pattern silent (seq (capture labeled key (ref simple_pattern)) (literal %3A) (capture labeled value (ref match_case_pattern))) (concept grammar.key-value-pattern) (source-names (tree-sitter _key_value_pattern)))
(rule keyword_pattern normal (seq (ref identifier) (literal %3D) (ref simple_pattern)) (concept grammar.keyword-pattern))
(rule splat_pattern normal (precedence 1 none (seq (choice unordered (literal %2A) (literal %2A%2A)) (choice unordered (ref identifier) (token (seq (literal _) (not (ref word_characters))))))) (concept grammar.splat-pattern))
(rule class_pattern normal (seq (ref dotted_name) (literal %28) (optional (seq (seq (ref match_case_pattern) (repeat0 (seq (literal %2C) (ref match_case_pattern)))) (optional (literal %2C)))) (literal %29)) (concept grammar.class-pattern))
(rule complex_pattern normal (precedence 1 none (seq (optional (literal -)) (choice unordered (ref integer_literal) (ref float)) (choice unordered (literal %2B) (literal -)) (choice unordered (ref integer_literal) (ref float)))) (concept grammar.complex-pattern))
(rule parameter_sequence silent (seq (seq (ref parameter_declaration) (repeat0 (seq (literal %2C) (ref parameter_declaration)))) (optional (literal %2C))) (concept grammar.parameter-sequence) (source-names (tree-sitter _parameters)))
(rule pattern_sequence silent (seq (seq (ref pattern) (repeat0 (seq (literal %2C) (ref pattern)))) (optional (literal %2C))) (concept grammar.pattern-sequence) (source-names (tree-sitter _patterns)))
