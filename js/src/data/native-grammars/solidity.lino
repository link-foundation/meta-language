(rule string_immediate_elt_inside_double_quote silent (alias unnamed_token (immediateToken (lexicalPrecedence 2 (choice unordered (repeat1 (class negated (char %22) (char %5C) (char %0A))) (seq (literal %5C) (optional (literal %0D)) (literal %0A)))))) (concept grammar.string-immediate-elt-inside-double-quote) (source-names (tree-sitter _string_immediate_elt_inside_double_quote)))
(rule string_immediate_elt_inside_quote silent (alias unnamed_token (immediateToken (lexicalPrecedence 2 (choice unordered (repeat1 (class negated (char %27) (char %5C) (char %0A))) (seq (literal %5C) (optional (literal %0D)) (literal %0A)))))) (concept grammar.string-immediate-elt-inside-quote) (source-names (tree-sitter _string_immediate_elt_inside_quote)))
(rule comment token (lexicalPrecedence 1 (choice unordered (seq (literal %2F%2F) (repeat0 (class negated (char %0D) (char %0A)))) (seq (literal %2F%2A) (seq (repeat0 (class negated (char %2A))) (repeat1 (literal %2A)) (repeat0 (seq (class negated (char %2F) (char %2A)) (repeat0 (class negated (char %2A))) (repeat1 (literal %2A))))) (literal %2F)))) (concept grammar.comment))
(rule word_characters token (seq (class plain (range a z) (range A Z) (char %24) (char _)) (repeat0 (class plain (range a z) (range A Z) (range 0 9) (char %24) (char _)))) (concept grammar.word-characters))
