(grammar (start source_file) (matching longest) (settling tokens precedence dynamic ambiguity))
(extra (ref comment))
(extra (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B) (char %EF%BB%BF) (char %E2%81%A0) (char %E2%80%8B) (char %C2%A0)))
(conflict primary_expression type_name)
(conflict primary_expression identifier_path)
(conflict primary_expression member_expression identifier_path)
(conflict member_expression identifier_path)
(conflict layout_specifier structure_expression)
(conflict nameless_parameter parameter)
(conflict primary_expression type_cast_expression)
(conflict variable_declaration_tuple tuple_expression)
(conflict yul_expression yul_assignment)
(conflict yul_label yul_identifier)
(conflict fallback_receive_definition function_type)
(kind enumeration_value (source-names (tree-sitter enum_value)))
(rule source_file normal (repeat0 (ref source_unit)) (concept grammar.source-file))
(rule source_unit silent (choice unordered (ref directive) (ref declaration)) (concept grammar.source-unit) (source-names (tree-sitter _source_unit)))
(rule directive silent (choice unordered (ref pragma_directive) (ref import_directive)) (concept grammar.directive) (source-names (tree-sitter _directive)))
(rule pragma_directive normal (seq (token (seq (literal pragma) (not (ref word_characters)))) (choice unordered (ref solidity_pragma_token) (ref any_pragma_token)) (ref semicolon)) (concept grammar.pragma-directive))
(rule solidity_pragma_token normal (precedence 10 none (seq (ref solidity) (repeat0 (seq (capture labeled version_constraint (ref pragma_version_constraint)) (optional (choice unordered (literal %7C%7C) (literal -))))))) (concept grammar.solidity-pragma-token))
(rule any_pragma_token normal (seq (ref identifier) (ref pragma_value)) (concept grammar.any-pragma-token))
(rule solidity silent (precedence 1 none (token (seq (literal solidity) (not (ref word_characters))))) (concept grammar.solidity) (source-names (tree-sitter _solidity)))
(rule pragma_value normal (precedence 0 none (alias unnamed_token (token (repeat1 (class negated (char %3B)))))) (concept grammar.pragma-value))
(rule pragma_version_constraint silent (seq (optional (ref solidity_version_comparison_operator)) (ref solidity_version)) (concept grammar.pragma-version-constraint) (source-names (tree-sitter _pragma_version_constraint)))
(rule solidity_version token (seq (optional (literal %22)) (optional (literal .)) (optional (literal %20)) (repeat1 (choice unordered (class plain (range 0 9)) (literal %2A))) (optional (seq (literal .) (optional (literal %20)) (repeat1 (choice unordered (class plain (range 0 9)) (literal %2A))) (optional (literal %20)) (optional (seq (literal .) (repeat1 (choice unordered (class plain (range 0 9)) (literal %2A))))))) (optional (literal %22))) (concept grammar.solidity-version))
(rule solidity_version_comparison_operator normal (choice unordered (literal %3C%3D) (literal %3C) (literal %5E) (literal %3E) (literal %3E%3D) (literal %7E) (literal %3D)) (concept grammar.solidity-version-comparison-operator))
(rule import_directive normal (seq (token (seq (literal import) (not (ref word_characters)))) (choice unordered (ref source_import) (seq (ref import_clause) (ref from_clause))) (ref semicolon)) (concept grammar.import-directive))
(rule source_import silent (seq (capture labeled source (ref string)) (optional (ref import_alias))) (concept grammar.source-import) (source-names (tree-sitter _source_import)))
(rule import_clause silent (choice unordered (ref single_import) (ref multiple_import)) (concept grammar.import-clause) (source-names (tree-sitter _import_clause)))
(rule from_clause silent (seq (token (seq (literal from) (not (ref word_characters)))) (capture labeled source (ref string))) (concept grammar.from-clause) (source-names (tree-sitter _from_clause)))
(rule single_import silent (seq (choice unordered (literal %2A) (capture labeled import_name (ref identifier))) (optional (ref import_alias))) (concept grammar.single-import) (source-names (tree-sitter _single_import)))
(rule multiple_import silent (seq (literal %7B) (optional (seq (ref import_declaration) (repeat0 (seq (literal %2C) (ref import_declaration))) (optional (literal %2C)))) (literal %7D)) (concept grammar.multiple-import) (source-names (tree-sitter _multiple_import)))
(rule import_declaration silent (seq (capture labeled import_name (ref identifier)) (optional (ref import_alias))) (concept grammar.import-declaration) (source-names (tree-sitter _import_declaration)))
(rule import_alias silent (seq (token (seq (literal as) (not (ref word_characters)))) (capture labeled alias (ref identifier))) (concept grammar.import-alias) (source-names (tree-sitter _import_alias)))
(rule declaration silent (choice unordered (ref contract_declaration) (ref interface_declaration) (ref error_declaration) (ref library_declaration) (ref structure_declaration) (ref enumeration_declaration) (ref function_definition) (ref constant_variable_declaration) (ref user_defined_type_definition) (ref event_definition) (ref using_directive)) (concept grammar.declaration) (source-names (tree-sitter _declaration)))
(rule user_defined_type_definition normal (seq (token (seq (literal type) (not (ref word_characters)))) (capture labeled name (ref identifier)) (token (seq (literal is) (not (ref word_characters)))) (ref primitive_type) (ref semicolon)) (concept grammar.user-defined-type-definition))
(rule constant_variable_declaration normal (seq (capture labeled type (ref type_name)) (token (seq (literal constant) (not (ref word_characters)))) (capture labeled name (ref identifier)) (literal %3D) (capture labeled value (ref expression)) (ref semicolon)) (concept grammar.constant-variable-declaration))
(rule contract_declaration normal (seq (optional (token (seq (literal abstract) (not (ref word_characters))))) (token (seq (literal contract) (not (ref word_characters)))) (capture labeled name (ref identifier)) (repeat0 (choice unordered (ref class_heritage) (ref layout_specifier))) (capture labeled body (ref contract_body))) (concept grammar.contract-declaration))
(rule error_declaration normal (seq (token (seq (literal error) (not (ref word_characters)))) (capture labeled name (ref identifier)) (literal %28) (optional (seq (ref error_parameter) (repeat0 (seq (literal %2C) (ref error_parameter))) (optional (literal %2C)))) (literal %29) (ref semicolon)) (concept grammar.error-declaration))
(rule error_parameter normal (seq (capture labeled type (ref type_name)) (capture labeled name (optional (ref identifier)))) (concept grammar.error-parameter))
(rule interface_declaration normal (seq (token (seq (literal interface) (not (ref word_characters)))) (capture labeled name (ref identifier)) (optional (ref class_heritage)) (capture labeled body (ref contract_body))) (concept grammar.interface-declaration))
(rule library_declaration normal (seq (token (seq (literal library) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled body (ref contract_body))) (concept grammar.library-declaration))
(rule class_heritage silent (seq (token (seq (literal is) (not (ref word_characters)))) (seq (ref inheritance_specifier) (repeat0 (seq (literal %2C) (ref inheritance_specifier))) (optional (literal %2C)))) (concept grammar.class-heritage) (source-names (tree-sitter _class_heritage)))
(rule layout_specifier normal (seq (token (seq (literal layout) (not (ref word_characters)))) (token (seq (literal at) (not (ref word_characters)))) (ref expression)) (concept grammar.layout-specifier))
(rule inheritance_specifier normal (seq (capture labeled ancestor (ref user_defined_type)) (optional (capture labeled ancestor_arguments (ref call_arguments)))) (concept grammar.inheritance-specifier))
(rule contract_body normal (seq (literal %7B) (repeat0 (ref contract_member)) (literal %7D)) (concept grammar.contract-body))
(rule contract_member silent (choice unordered (ref function_definition) (ref modifier_definition) (ref error_declaration) (ref state_variable_declaration) (ref structure_declaration) (ref enumeration_declaration) (ref event_definition) (ref using_directive) (ref constructor_definition) (ref fallback_receive_definition) (ref user_defined_type_definition)) (concept grammar.contract-member) (source-names (tree-sitter _contract_member)))
(rule structure_declaration normal (seq (token (seq (literal struct) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled body (ref structure_body))) (concept grammar.structure-declaration) (source-names (tree-sitter struct_declaration)))
(rule structure_member normal (seq (capture labeled type (ref type_name)) (capture labeled name (ref identifier)) (ref semicolon)) (concept grammar.structure-member) (source-names (tree-sitter struct_member)))
(rule structure_body normal (seq (literal %7B) (repeat1 (ref structure_member)) (literal %7D)) (concept grammar.structure-body) (source-names (tree-sitter struct_body)))
(rule enumeration_declaration normal (seq (token (seq (literal enum) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled body (ref enumeration_body))) (concept grammar.enumeration-declaration) (source-names (tree-sitter enum_declaration)))
(rule enumeration_body normal (seq (literal %7B) (optional (seq (alias enumeration_value (ref identifier)) (repeat0 (seq (literal %2C) (alias enumeration_value (ref identifier)))) (optional (literal %2C)))) (literal %7D)) (concept grammar.enumeration-body) (source-names (tree-sitter enum_body)))
(rule event_definition normal (seq (token (seq (literal event) (not (ref word_characters)))) (capture labeled name (ref identifier)) (ref event_parameter_list) (optional (token (seq (literal anonymous) (not (ref word_characters))))) (ref semicolon)) (concept grammar.event-definition))
(rule event_parameter_list silent (seq (literal %28) (optional (seq (ref event_parameter) (repeat0 (seq (literal %2C) (ref event_parameter))) (optional (literal %2C)))) (literal %29)) (concept grammar.event-parameter-list) (source-names (tree-sitter _event_parameter_list)))
(rule event_parameter normal (seq (capture labeled type (ref type_name)) (optional (token (seq (literal indexed) (not (ref word_characters))))) (optional (capture labeled name (ref identifier)))) (concept grammar.event-parameter))
(rule user_definable_operator normal (choice unordered (literal %26) (literal %7E) (literal %7C) (literal %5E) (literal %2B) (literal -) (literal %2F) (literal %25) (literal %2A) (literal -) (literal %3D%3D) (literal %3E) (literal %3E%3D) (literal %3C) (literal %3C%3D) (literal %21%3D)) (concept grammar.user-definable-operator))
(rule using_directive normal (seq (token (seq (literal using) (not (ref word_characters)))) (choice unordered (alias type_alias (ref user_defined_type)) (seq (literal %7B) (seq (ref using_alias) (repeat0 (seq (literal %2C) (ref using_alias))) (optional (literal %2C))) (literal %7D))) (token (seq (literal for) (not (ref word_characters)))) (capture labeled source (choice unordered (ref any_source_type) (ref type_name))) (optional (token (seq (literal global) (not (ref word_characters))))) (ref semicolon)) (concept grammar.using-directive))
(rule using_alias normal (seq (ref user_defined_type) (optional (seq (token (seq (literal as) (not (ref word_characters)))) (ref user_definable_operator)))) (concept grammar.using-alias))
(rule any_source_type normal (literal %2A) (concept grammar.any-source-type))
(rule statement normal (choice unordered (ref block_statement) (ref expression_statement) (ref variable_declaration_statement) (ref if_statement) (ref for_statement) (ref while_statement) (ref do_while_statement) (ref continue_statement) (ref break_statement) (ref try_statement) (ref return_statement) (ref emit_statement) (ref assembly_statement) (ref revert_statement)) (concept grammar.statement))
(rule assembly_statement normal (seq (token (seq (literal assembly) (not (ref word_characters)))) (optional (literal %22evmasm%22)) (optional (ref assembly_flags)) (literal %7B) (repeat0 (ref yul_statement)) (literal %7D)) (concept grammar.assembly-statement))
(rule assembly_flags normal (seq (literal %28) (optional (seq (ref string) (repeat0 (seq (literal %2C) (ref string))) (optional (literal %2C)))) (literal %29)) (concept grammar.assembly-flags))
(rule yul_statement silent (choice unordered (ref yul_block) (ref yul_variable_declaration) (ref yul_assignment) (ref yul_function_call) (ref yul_if_statement) (ref yul_for_statement) (ref yul_switch_statement) (ref yul_leave) (ref yul_break) (ref yul_continue) (ref yul_function_definition) (ref yul_label) (ref yul_literal)) (concept grammar.yul-statement) (source-names (tree-sitter _yul_statement)))
(rule yul_label normal (seq (ref identifier) (literal %3A)) (concept grammar.yul-label))
(rule yul_leave token (seq (literal leave) (not (ref word_characters))) (concept grammar.yul-leave))
(rule yul_break normal (token (seq (literal break) (not (ref word_characters)))) (concept grammar.yul-break))
(rule yul_continue normal (token (seq (literal continue) (not (ref word_characters)))) (concept grammar.yul-continue))
(rule yul_identifier normal (ref identifier) (concept grammar.yul-identifier))
(rule yul_expression silent (choice unordered (ref yul_path) (ref yul_function_call) (ref yul_literal)) (concept grammar.yul-expression) (source-names (tree-sitter _yul_expression)))
(rule yul_path normal (precedence 0 left (seq (ref yul_identifier) (repeat0 (seq (literal .) (ref yul_identifier))))) (concept grammar.yul-path))
(rule yul_literal silent (choice unordered (ref yul_decimal_number) (ref yul_string_literal) (ref yul_hex_number) (ref yul_boolean) (ref yul_hex_string_literal)) (concept grammar.yul-literal) (source-names (tree-sitter _yul_literal)))
(rule yul_decimal_number token (choice unordered (literal 0) (seq (class plain (range 1 9)) (repeat0 (class plain (range 0 9))))) (concept grammar.yul-decimal-number))
(rule yul_string_literal normal (ref string) (concept grammar.yul-string-literal))
(rule yul_hex_number token (seq (literal 0x) (repeat0 (class plain (range 0 9) (range A F) (range a f)))) (concept grammar.yul-hex-number))
(rule yul_boolean normal (choice unordered (token (seq (literal true) (not (ref word_characters)))) (token (seq (literal false) (not (ref word_characters))))) (concept grammar.yul-boolean))
(rule yul_hex_string_literal normal (seq (token (seq (literal hex) (not (ref word_characters)))) (choice unordered (seq (literal %22) (optional (seq (ref hex_digit) (repeat0 (seq (optional (token (seq (literal _) (not (ref word_characters))))) (ref hex_digit))))) (literal %22)) (seq (literal %27) (optional (seq (ref hex_digit) (repeat0 (seq (optional (token (seq (literal _) (not (ref word_characters))))) (ref hex_digit))))) (literal %27)))) (concept grammar.yul-hex-string-literal))
(rule yul_block normal (seq (literal %7B) (repeat0 (ref yul_statement)) (literal %7D)) (concept grammar.yul-block))
(rule yul_variable_declaration normal (precedence 1 left (choice unordered (seq (token (seq (literal let) (not (ref word_characters)))) (capture labeled left (ref yul_identifier)) (optional (seq (literal %3A%3D) (capture labeled right (ref yul_expression))))) (seq (token (seq (literal let) (not (ref word_characters)))) (capture labeled left (choice unordered (seq (ref yul_identifier) (repeat0 (seq (literal %2C) (ref yul_identifier))) (optional (literal %2C))) (seq (literal %28) (seq (ref yul_identifier) (repeat0 (seq (literal %2C) (ref yul_identifier))) (optional (literal %2C))) (literal %29)))) (optional (seq (literal %3A%3D) (capture labeled right (ref yul_function_call))))))) (concept grammar.yul-variable-declaration))
(rule yul_assignment_operator silent (choice unordered (literal %3A%3D) (seq (literal %3A) (literal %3D))) (concept grammar.yul-assignment-operator) (source-names (tree-sitter _yul_assignment_operator)))
(rule yul_assignment normal (precedence 0 left (choice unordered (seq (ref yul_path) (ref yul_assignment_operator) (ref yul_expression)) (seq (seq (ref yul_path) (repeat0 (seq (literal %2C) (ref yul_path))) (optional (literal %2C))) (optional (seq (ref yul_assignment_operator) (ref yul_function_call)))))) (concept grammar.yul-assignment))
(rule yul_function_call normal (choice unordered (seq (capture labeled function (choice unordered (ref yul_identifier) (ref yul_evm_builtin))) (literal %28) (optional (seq (ref yul_expression) (repeat0 (seq (literal %2C) (ref yul_expression))) (optional (literal %2C)))) (literal %29)) (capture labeled function (ref yul_evm_builtin))) (concept grammar.yul-function-call))
(rule yul_if_statement normal (seq (token (seq (literal if) (not (ref word_characters)))) (ref yul_expression) (ref yul_block)) (concept grammar.yul-if-statement))
(rule yul_for_statement normal (seq (token (seq (literal for) (not (ref word_characters)))) (ref yul_block) (ref yul_expression) (ref yul_block) (ref yul_block)) (concept grammar.yul-for-statement))
(rule yul_switch_statement normal (seq (token (seq (literal switch) (not (ref word_characters)))) (ref yul_expression) (choice unordered (seq (token (seq (literal default) (not (ref word_characters)))) (ref yul_block)) (seq (repeat1 (seq (token (seq (literal case) (not (ref word_characters)))) (ref yul_literal) (ref yul_block))) (optional (seq (token (seq (literal default) (not (ref word_characters)))) (ref yul_block)))))) (concept grammar.yul-switch-statement))
(rule yul_function_definition normal (seq (token (seq (literal function) (not (ref word_characters)))) (ref yul_identifier) (literal %28) (optional (seq (ref yul_identifier) (repeat0 (seq (literal %2C) (ref yul_identifier))) (optional (literal %2C)))) (literal %29) (optional (seq (literal -%3E) (seq (ref yul_identifier) (repeat0 (seq (literal %2C) (ref yul_identifier))) (optional (literal %2C))))) (ref yul_block)) (concept grammar.yul-function-definition))
(rule yul_evm_builtin normal (precedence 1 none (choice unordered (token (seq (literal stop) (not (ref word_characters)))) (token (seq (literal add) (not (ref word_characters)))) (token (seq (literal sub) (not (ref word_characters)))) (token (seq (literal mul) (not (ref word_characters)))) (token (seq (literal div) (not (ref word_characters)))) (token (seq (literal sdiv) (not (ref word_characters)))) (token (seq (literal mod) (not (ref word_characters)))) (token (seq (literal smod) (not (ref word_characters)))) (token (seq (literal exp) (not (ref word_characters)))) (token (seq (literal not) (not (ref word_characters)))) (token (seq (literal lt) (not (ref word_characters)))) (token (seq (literal gt) (not (ref word_characters)))) (token (seq (literal slt) (not (ref word_characters)))) (token (seq (literal sgt) (not (ref word_characters)))) (token (seq (literal eq) (not (ref word_characters)))) (token (seq (literal iszero) (not (ref word_characters)))) (token (seq (literal and) (not (ref word_characters)))) (token (seq (literal or) (not (ref word_characters)))) (token (seq (literal xor) (not (ref word_characters)))) (token (seq (literal byte) (not (ref word_characters)))) (token (seq (literal shl) (not (ref word_characters)))) (token (seq (literal shr) (not (ref word_characters)))) (token (seq (literal sar) (not (ref word_characters)))) (token (seq (literal addmod) (not (ref word_characters)))) (token (seq (literal mulmod) (not (ref word_characters)))) (token (seq (literal signextend) (not (ref word_characters)))) (token (seq (literal keccak256) (not (ref word_characters)))) (token (seq (literal pop) (not (ref word_characters)))) (token (seq (literal mload) (not (ref word_characters)))) (token (seq (literal mcopy) (not (ref word_characters)))) (token (seq (literal tload) (not (ref word_characters)))) (token (seq (literal tstore) (not (ref word_characters)))) (token (seq (literal mstore) (not (ref word_characters)))) (token (seq (literal mstore8) (not (ref word_characters)))) (token (seq (literal sload) (not (ref word_characters)))) (token (seq (literal sstore) (not (ref word_characters)))) (token (seq (literal msize) (not (ref word_characters)))) (token (seq (literal gas) (not (ref word_characters)))) (token (seq (literal address) (not (ref word_characters)))) (token (seq (literal balance) (not (ref word_characters)))) (token (seq (literal selfbalance) (not (ref word_characters)))) (token (seq (literal caller) (not (ref word_characters)))) (token (seq (literal callvalue) (not (ref word_characters)))) (token (seq (literal calldataload) (not (ref word_characters)))) (token (seq (literal calldatasize) (not (ref word_characters)))) (token (seq (literal calldatacopy) (not (ref word_characters)))) (token (seq (literal extcodesize) (not (ref word_characters)))) (token (seq (literal extcodecopy) (not (ref word_characters)))) (token (seq (literal returndatasize) (not (ref word_characters)))) (token (seq (literal returndatacopy) (not (ref word_characters)))) (token (seq (literal extcodehash) (not (ref word_characters)))) (token (seq (literal create) (not (ref word_characters)))) (token (seq (literal create2) (not (ref word_characters)))) (token (seq (literal call) (not (ref word_characters)))) (token (seq (literal callcode) (not (ref word_characters)))) (token (seq (literal delegatecall) (not (ref word_characters)))) (token (seq (literal staticcall) (not (ref word_characters)))) (token (seq (literal return) (not (ref word_characters)))) (token (seq (literal revert) (not (ref word_characters)))) (token (seq (literal selfdestruct) (not (ref word_characters)))) (token (seq (literal invalid) (not (ref word_characters)))) (token (seq (literal log0) (not (ref word_characters)))) (token (seq (literal log1) (not (ref word_characters)))) (token (seq (literal log2) (not (ref word_characters)))) (token (seq (literal log3) (not (ref word_characters)))) (token (seq (literal log4) (not (ref word_characters)))) (token (seq (literal chainid) (not (ref word_characters)))) (token (seq (literal origin) (not (ref word_characters)))) (token (seq (literal gasprice) (not (ref word_characters)))) (token (seq (literal blockhash) (not (ref word_characters)))) (token (seq (literal blobhash) (not (ref word_characters)))) (token (seq (literal basefee) (not (ref word_characters)))) (token (seq (literal blobfee) (not (ref word_characters)))) (token (seq (literal coinbase) (not (ref word_characters)))) (token (seq (literal timestamp) (not (ref word_characters)))) (token (seq (literal number) (not (ref word_characters)))) (token (seq (literal difficulty) (not (ref word_characters)))) (token (seq (literal gaslimit) (not (ref word_characters)))) (token (seq (literal prevrandao) (not (ref word_characters)))) (token (seq (literal blobbasefee) (not (ref word_characters)))) (token (seq (literal blobfee) (not (ref word_characters)))))) (concept grammar.yul-evm-builtin))
(rule unchecked token (seq (literal unchecked) (not (ref word_characters))) (concept grammar.unchecked))
(rule block_statement normal (seq (optional (ref unchecked)) (literal %7B) (repeat0 (ref statement)) (literal %7D)) (concept grammar.block-statement))
(rule variable_declaration_statement normal (precedence 1 none (seq (choice unordered (seq (ref variable_declaration) (optional (seq (literal %3D) (capture labeled value (ref expression))))) (seq (ref variable_declaration_tuple) (literal %3D) (capture labeled value (ref expression)))) (ref semicolon))) (concept grammar.variable-declaration-statement))
(rule variable_declaration normal (seq (capture labeled type (ref type_name)) (capture labeled location (optional (choice unordered (token (seq (literal memory) (not (ref word_characters)))) (token (seq (literal storage) (not (ref word_characters)))) (token (seq (literal calldata) (not (ref word_characters))))))) (capture labeled name (ref identifier))) (concept grammar.variable-declaration))
(rule variable_declaration_tuple normal (precedence 3 none (choice unordered (seq (literal %28) (optional (seq (optional (ref variable_declaration)) (repeat0 (seq (literal %2C) (optional (ref variable_declaration)))) (optional (literal %2C)))) (literal %29)) (seq (token (seq (literal var) (not (ref word_characters)))) (literal %28) (optional (seq (optional (ref identifier)) (repeat0 (seq (literal %2C) (optional (ref identifier)))) (optional (literal %2C)))) (literal %29)))) (concept grammar.variable-declaration-tuple))
(rule expression_statement normal (seq (ref expression) (ref semicolon)) (concept grammar.expression-statement))
(rule if_statement normal (precedence 0 right (seq (token (seq (literal if) (not (ref word_characters)))) (literal %28) (capture labeled condition (ref expression)) (literal %29) (capture labeled body (ref statement)) (capture labeled else (optional (seq (token (seq (literal else) (not (ref word_characters)))) (capture labeled body (ref statement))))))) (concept grammar.if-statement))
(rule for_statement normal (seq (token (seq (literal for) (not (ref word_characters)))) (literal %28) (capture labeled initial (choice unordered (ref variable_declaration_statement) (ref expression_statement) (ref semicolon))) (capture labeled condition (choice unordered (ref expression_statement) (ref semicolon))) (capture labeled update (optional (ref expression))) (literal %29) (capture labeled body (ref statement))) (concept grammar.for-statement))
(rule while_statement normal (seq (token (seq (literal while) (not (ref word_characters)))) (literal %28) (capture labeled condition (ref expression)) (literal %29) (capture labeled body (ref statement))) (concept grammar.while-statement))
(rule do_while_statement normal (seq (token (seq (literal do) (not (ref word_characters)))) (capture labeled body (ref statement)) (token (seq (literal while) (not (ref word_characters)))) (literal %28) (capture labeled condition (ref expression)) (literal %29) (ref semicolon)) (concept grammar.do-while-statement))
(rule continue_statement normal (seq (token (seq (literal continue) (not (ref word_characters)))) (ref semicolon)) (concept grammar.continue-statement))
(rule break_statement normal (seq (token (seq (literal break) (not (ref word_characters)))) (ref semicolon)) (concept grammar.break-statement))
(rule revert_statement normal (precedence 13 none (seq (token (seq (literal revert) (not (ref word_characters)))) (optional (capture labeled error (ref expression))) (optional (alias revert_arguments (ref call_arguments))) (ref semicolon))) (concept grammar.revert-statement))
(rule try_statement normal (seq (token (seq (literal try) (not (ref word_characters)))) (capture labeled attempt (ref expression)) (optional (seq (token (seq (literal returns) (not (ref word_characters)))) (ref parameter_list))) (capture labeled body (ref block_statement)) (repeat1 (ref catch_clause))) (concept grammar.try-statement))
(rule catch_clause normal (seq (token (seq (literal catch) (not (ref word_characters)))) (optional (seq (optional (ref identifier)) (ref parameter_list))) (capture labeled body (ref block_statement))) (concept grammar.catch-clause))
(rule return_statement normal (seq (token (seq (literal return) (not (ref word_characters)))) (optional (ref expression)) (ref semicolon)) (concept grammar.return-statement))
