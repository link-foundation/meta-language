(conflict zero_level_term zero_level_pattern)
(precedences (name scope) (name application) (name negation) (name list_ops) (name multiplicative) (name additive) (name comparison) (name conjunction) (name disjunction) (name equivalence) (name custom) (name arrow_term) (name quantifier_term) (name binder) (name type))
(precedences (name tactic_match) (name tactic_application) (name tactic_or) (name tactic_sequence) (name tactic_let))
(rule source_file normal (repeat0 (ref sentence)) (concept grammar.source-file))
(rule sentence normal (choice unordered (seq (optional (ref fail_prefix)) (optional (ref attributes)) (optional (ref selector)) (choice unordered (ref vernacular_command) (ref ltac_definition) (ref ltac_expression)) (choice unordered (literal .) (literal ...))) (ref proof_block) (ref bullet)) (concept grammar.sentence))
(rule fail_prefix token (seq (literal Fail) (not (ref word_characters))) (concept grammar.fail-prefix) (source-names (tree-sitter fail)))
(rule attributes normal (choice unordered (seq (repeat1 (ref modern_attribute_block)) (repeat0 (ref legacy_attribute))) (repeat1 (ref legacy_attribute))) (concept grammar.attribute-list))
(rule modern_attribute_block silent (seq (literal %23) (literal %5B) (optional (seq (ref attribute) (repeat0 (seq (literal %2C) (ref attribute))))) (literal %5D)) (concept grammar.modern-attribute-block) (source-names (tree-sitter _modern_attribute_block)))
(rule attribute normal (seq (ref identifier) (optional (ref attribute_value))) (concept program.attributes))
(rule attribute_value normal (choice unordered (seq (literal %3D) (ref string)) (seq (literal %3D) (ref qualified_identifier)) (seq (literal %28) (ref attribute) (repeat0 (seq (literal %2C) (ref attribute))) (literal %29))) (concept grammar.attribute-value) (source-names (tree-sitter attr_value)))
(rule legacy_attribute normal (choice unordered (choice unordered (token (seq (literal Local) (not (ref word_characters)))) (token (seq (literal Global) (not (ref word_characters))))) (choice unordered (token (seq (literal Polymorphic) (not (ref word_characters)))) (token (seq (literal Monomorphic) (not (ref word_characters))))) (choice unordered (token (seq (literal Cumulative) (not (ref word_characters)))) (token (seq (literal NonCumulative) (not (ref word_characters))))) (token (seq (literal Private) (not (ref word_characters)))) (token (seq (literal Program) (not (ref word_characters))))) (concept grammar.legacy-attribute) (source-names (tree-sitter legacy_attr)))
(rule selector normal (seq (choice unordered (ref goal_selector) (token (seq (literal all) (not (ref word_characters)))) (literal %21) (token (seq (literal par) (not (ref word_characters))))) (literal %3A)) (concept grammar.selector))
(rule goal_selector normal (seq (ref range_selector) (repeat0 (seq (literal %2C) (ref range_selector)))) (concept grammar.goal-selector))
(rule range_selector normal (choice unordered (ref natural) (seq (literal %5B) (ref qualified_identifier) (literal %5D)) (seq (capture labeled start (ref natural)) (literal -) (capture labeled end (ref natural)))) (concept grammar.range-selector))
(rule vernacular_command silent (choice unordered (ref require_command) (ref import_command) (ref export_command) (ref create_hint_database_command) (ref create_rewrite_hint_database_command) (ref hint_command) (ref evaluation_command) (ref extraction_command) (ref extract_command) (ref set_command) (ref unset_command) (ref add_command) (ref remove_command) (ref test_command) (ref show_proof_command) (ref coercion_command) (ref declare_command) (ref open_scope_command) (ref close_scope_command) (ref theorem_command) (ref definition_command) (ref fixpoint_command) (ref function_command) (ref inductive_command) (ref assumption_command) (ref arguments_command) (ref section_command) (ref module_command) (ref end_command) (ref reserved_notation_command) (ref notation_command) (ref infix_command) (ref abbreviation_command) (ref include_command) (ref register_command) (ref instance_command) (ref existing_command) (ref record_command) (ref scheme_command) (ref combined_scheme_command) (ref delimit_scope_command) (ref bind_scope_command) (ref context_command) (ref obligation_tactic_command) (ref obligation_command) (ref implicit_types_command) (ref type_classes_command) (ref generalizable_command) (ref proof_command) (ref qed_command) (ref save_command) (ref defined_command) (ref admitted_command) (ref abort_command)) (concept grammar.vernacular-command) (source-names (tree-sitter _vernacular_command)))
(rule require_command normal (seq (optional (seq (token (seq (literal From) (not (ref word_characters)))) (capture labeled dirpath (ref qualified_identifier)))) (token (seq (literal Require) (not (ref word_characters)))) (optional (seq (choice unordered (token (seq (literal Import) (not (ref word_characters)))) (token (seq (literal Export) (not (ref word_characters))))) (optional (ref import_categories)))) (repeat1 (ref filtered_import))) (concept grammar.require-command))
