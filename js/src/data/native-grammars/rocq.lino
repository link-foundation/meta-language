(extra (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)))
(extra (ref comment))
(conflict generic_tactic_body)
(conflict match_pattern list_literal)
(conflict binder)
(conflict fixpoint_annotation qualified_identifier)
(conflict assert_tactic qualified_identifier)
(conflict hundred_level_term term_cast)
