(rule decimal_natural_number token (seq (class plain (range 0 9)) (repeat0 (class plain (range 0 9) (char _)))) (concept grammar.decimal-natural-number) (source-names (tree-sitter decnat)))
(rule digit token (class plain (range 0 9)) (concept grammar.digit))
(rule hexadecimal_natural_number token (seq (literal 0) (class plain (char x) (char X)) (class plain (range 0 9) (range a f) (range A F)) (repeat0 (class plain (range 0 9) (range a f) (range A F) (char _)))) (concept grammar.hexadecimal-natural-number) (source-names (tree-sitter hexnat)))
(rule hexadecimal_digit token (class plain (range 0 9) (range a f) (range A F)) (concept grammar.hexadecimal-digit) (source-names (tree-sitter hexdigit)))
(rule dotted_qualified_identifier token (seq (seq (class plain (category L) (char _)) (repeat0 (class plain (category L) (char _) (category N) (char %27)))) (repeat0 (seq (literal .) (seq (class plain (category L) (char _)) (repeat0 (class plain (category L) (char _) (category N) (char %27))))))) (concept grammar.dotted-qualified-identifier) (source-names (tree-sitter dotted_qualid)))
(rule annotated_qualified_identifier silent (ref qualified_identifier) (concept grammar.annotated-qualified-identifier) (source-names (tree-sitter _qualid_annotated)))
(rule global_reference normal (choice unordered (ref qualified_identifier) (seq (ref string) (optional (seq (literal %25) (ref identifier))))) (concept grammar.global-reference) (source-names (tree-sitter reference)))
(rule string normal (seq (literal %22) (repeat0 (choice unordered (alias unnamed_token (token (class negated (char %22)))) (literal %22%22))) (literal %22)) (concept grammar.string))
(rule wildcard normal (token (seq (literal _) (not (ref word_characters)))) (concept grammar.wildcard))
(rule custom_notation_block normal (choice unordered (seq (literal %3C%7B) (repeat0 (ref dsl_token)) (literal %7D%3E)) (seq (literal %5B%7C) (repeat0 (ref dsl_token)) (literal %7C%5D)) (seq (literal %7B%7C) (repeat0 (ref dsl_token)) (literal %7C%7D))) (concept grammar.custom-notation-block))
(rule dsl_token silent (choice unordered (ref identifier) (ref number) (ref string) (alias unnamed_token (token (repeat1 (class plain (char %2B) (char -) (char %2A) (char %2F) (char %26) (char %3D) (char %3C) (char %3E) (char %21) (char %7E) (char %7C) (char %25) (char %5E) (char %3A) (char %3B))))) (seq (literal %28) (repeat0 (ref dsl_token)) (literal %29)) (seq (literal %5B) (repeat0 (ref dsl_token)) (literal %5D)) (seq (literal %7B) (repeat0 (ref dsl_token)) (literal %7D))) (concept grammar.dsl-token) (source-names (tree-sitter _dsl_token)))
(rule imp_evaluation_operation normal (namedPrecedence custom left (seq (capture labeled initial_state (ref term)) (literal %3D%5B) (ref imp_program) (literal %5D%3D%3E) (capture labeled final_state (ref term)))) (concept grammar.imp-evaluation-operation))
(rule imp_program normal (repeat1 (ref imp_token)) (concept grammar.imp-program))
(rule imp_token silent (choice unordered (ref identifier) (ref number) (literal %3A%3D) (alias unnamed_token (token (repeat1 (class plain (char %2B) (char -) (char %2A) (char %2F) (char %26) (char %3D) (char %3C) (char %3E) (char %21) (char %7E) (char %7C) (char %25) (char %3B))))) (seq (literal %28) (repeat0 (ref imp_token)) (literal %29)) (seq (literal %5B) (repeat0 (ref imp_token)) (literal %5D)) (seq (literal %7B) (repeat0 (ref imp_token)) (literal %7D))) (concept grammar.imp-token) (source-names (tree-sitter _imp_token)))
(rule word_characters token (seq (class plain (category L) (char _)) (repeat0 (class plain (category L) (char _) (category N) (char %27)))) (concept grammar.word-characters))
