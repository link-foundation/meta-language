(rule post_decrement_expression normal (precedence 2 none (seq (ref primary_expression) (literal --))) (concept grammar.post-decrement-expression))
(rule member_access normal (precedence 0 left (choice unordered (seq (ref primary_expression) (immediateToken (literal .)) (ref member_name)) (seq (ref primary_expression) (literal %3A%3A) (ref member_name)))) (concept grammar.member-access))
(rule member_name normal (choice unordered (ref simple_name) (ref string_literal) (ref expression_with_unary_operator) (ref value)) (concept grammar.member-name))
(rule element_access normal (precedence 4 none (seq (ref primary_expression) (literal %5B) (ref expression) (literal %5D))) (concept grammar.element-access))
(rule invocation_expression normal (choice unordered (seq (ref primary_expression) (immediateToken (literal .)) (ref member_name) (ref argument_list)) (seq (ref primary_expression) (literal %3A%3A) (ref member_name) (ref argument_list)) (ref invocation_for_each_expression)) (concept grammar.invocation-expression) (source-names (tree-sitter invokation_expression)))
(rule invocation_for_each_expression normal (seq (ref primary_expression) (alias unnamed_token (immediateToken (alias %27.foreach (lexicalPrecedence 1 (seq (class plain (char .) (char .)) (class plain (char f) (char F)) (class plain (char o) (char O)) (class plain (char r) (char R)) (class plain (char e) (char E)) (class plain (char a) (char A)) (class plain (char c) (char C)) (class plain (char h) (char H))))))) (ref script_block_expression)) (concept grammar.invocation-for-each-expression) (source-names (tree-sitter invokation_foreach_expression)))
(rule argument_list normal (seq (literal %28) (capture labeled argument_expression_list (optional (ref argument_expression_list))) (literal %29)) (concept grammar.argument-list))
(rule argument_expression_list normal (precedence 0 left (seq (ref argument_expression) (repeat0 (seq (literal %2C) (ref argument_expression))))) (concept grammar.argument-expression-list))
(rule argument_expression normal (ref logical_argument_expression) (concept grammar.argument-expression))
(rule logical_argument_expression normal (precedence 0 left (choice unordered (ref bit_level_argument_expression) (seq (ref logical_argument_expression) (choice unordered (alias %27-and (precedence 1 none (token (seq (class plain (char -) (char -)) (class plain (char a) (char A)) (class plain (char n) (char N)) (class plain (char d) (char D)))))) (alias %27-or (precedence 1 none (token (seq (class plain (char -) (char -)) (class plain (char o) (char O)) (class plain (char r) (char R)))))) (alias %27-xor (precedence 1 none (token (seq (class plain (char -) (char -)) (class plain (char x) (char X)) (class plain (char o) (char O)) (class plain (char r) (char R))))))) (ref bit_level_argument_expression)))) (concept grammar.logical-argument-expression))
(rule bit_level_argument_expression normal (precedence 0 left (choice unordered (ref comparison_argument_expression) (seq (ref bit_level_argument_expression) (choice unordered (alias %27-and (precedence 1 none (token (seq (class plain (char -) (char -)) (class plain (char a) (char A)) (class plain (char n) (char N)) (class plain (char d) (char D)))))) (alias %27-or (precedence 1 none (token (seq (class plain (char -) (char -)) (class plain (char o) (char O)) (class plain (char r) (char R)))))) (alias %27-xor (precedence 1 none (token (seq (class plain (char -) (char -)) (class plain (char x) (char X)) (class plain (char o) (char O)) (class plain (char r) (char R))))))) (ref comparison_argument_expression)))) (concept grammar.bit-level-argument-expression) (source-names (tree-sitter bitwise_argument_expression)))
(rule comparison_argument_expression normal (precedence 0 left (choice unordered (ref additive_argument_expression) (seq (ref comparison_argument_expression) (ref comparison_operator) (ref additive_argument_expression)))) (concept grammar.comparison-argument-expression))
(rule additive_argument_expression normal (precedence 0 left (choice unordered (ref multiplicative_argument_expression) (seq (ref additive_argument_expression) (choice unordered (literal %2B) (literal -)) (ref multiplicative_argument_expression)))) (concept grammar.additive-argument-expression))
(rule multiplicative_argument_expression normal (precedence 0 left (choice unordered (ref format_argument_expression) (seq (ref multiplicative_argument_expression) (choice unordered (literal %2F) (literal %5C) (literal %25) (literal %2A)) (ref format_argument_expression)))) (concept grammar.multiplicative-argument-expression))
(rule format_argument_expression normal (precedence 0 left (choice unordered (ref range_argument_expression) (seq (ref format_argument_expression) (ref format_operator) (ref range_argument_expression)))) (concept grammar.format-argument-expression))
(rule range_argument_expression normal (precedence 0 left (choice unordered (ref unary_expression) (seq (ref range_argument_expression) (literal ..) (ref unary_expression)))) (concept grammar.range-argument-expression))
(rule type_reference_literal normal (seq (literal %5B) (ref type_specification) (literal %5D)) (concept grammar.type-reference-literal) (source-names (tree-sitter type_literal)))
(rule type_specification normal (choice unordered (seq (ref array_type_name) (optional (ref array_dimension_specifier)) (literal %5D)) (seq (ref generic_type_name) (ref generic_type_arguments) (literal %5D)) (ref type_name)) (concept grammar.type-specification) (source-names (tree-sitter type_spec)))
(rule array_dimension_specifier normal (repeat1 (literal %2C)) (concept grammar.array-dimension-specifier) (source-names (tree-sitter dimension)))
(rule generic_type_arguments normal (seq (ref type_specification) (repeat0 (seq (literal %2C) (ref type_specification)))) (concept grammar.generic-type-arguments))
(rule metadata_attribute_list normal (repeat1 (ref metadata_attribute)) (concept grammar.metadata-attribute-list) (source-names (tree-sitter attribute_list)))
(rule metadata_attribute normal (choice unordered (seq (literal %5B) (ref metadata_attribute_name) (literal %28) (optional (ref metadata_attribute_argument_list)) (literal %29) (literal %5D)) (ref type_reference_literal)) (concept grammar.metadata-attribute) (source-names (tree-sitter attribute)))
(rule metadata_attribute_name normal (ref type_specification) (concept grammar.metadata-attribute-name) (source-names (tree-sitter attribute_name)))
(rule metadata_attribute_argument_list normal (seq (ref metadata_attribute_argument) (repeat0 (seq (literal %2C) (ref metadata_attribute_argument)))) (concept grammar.metadata-attribute-argument-list) (source-names (tree-sitter attribute_arguments)))
(rule metadata_attribute_argument normal (choice unordered (ref expression) (seq (ref simple_name) (optional (seq (literal %3D) (ref expression))))) (concept grammar.metadata-attribute-argument) (source-names (tree-sitter attribute_argument)))
(rule argument_attachment_command_argument silent (precedence 6 right (choice unordered (seq (ref command_argument_sep) (ref generic_token)) (seq (ref command_argument_sep) (ref array_literal_expression)) (ref parenthesized_expression) (ref script_block_expression))) (concept grammar.argument-attachment-command-argument) (source-names (tree-sitter _argument_attachment_command_argument)))
