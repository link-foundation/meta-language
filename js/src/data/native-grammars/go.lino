(rule expression silent (choice unordered (ref unary_expression) (ref binary_expression) (ref selector_expression) (ref index_expression) (ref slice_expression) (ref call_expression) (ref type_assertion_expression) (ref type_conversion_expression) (ref type_instantiation_expression) (ref identifier) (alias identifier (choice unordered (token (seq (literal new) (not (ref word_characters)))) (token (seq (literal make) (not (ref word_characters)))))) (ref composite_literal) (ref function_literal) (ref string_literal) (ref integer_literal) (ref float_literal) (ref imaginary_literal) (ref rune_literal) (ref nil) (ref true) (ref false) (ref iota) (ref parenthesized_expression)) (concept grammar.expression) (source-names (tree-sitter _expression)))
