(rule slice_expression normal (precedence 7 none (seq (capture labeled operand (ref expression)) (literal %5B) (choice unordered (seq (capture labeled start (optional (ref expression))) (literal %3A) (capture labeled end (optional (ref expression)))) (seq (capture labeled start (optional (ref expression))) (literal %3A) (capture labeled end (ref expression)) (literal %3A) (capture labeled capacity (ref expression)))) (literal %5D))) (concept grammar.slice-expression))
