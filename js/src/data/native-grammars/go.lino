(rule variadic_parameter_declaration normal (seq (capture labeled name (optional (ref identifier))) (literal ...) (capture labeled type (ref type))) (concept grammar.variadic-parameter-declaration))
(rule type_alias normal (seq (capture labeled name (ref type_identifier_alias)) (capture labeled type_parameters (optional (ref type_parameter_list))) (literal %3D) (capture labeled type (ref type))) (concept grammar.type-alias))
(rule type_declaration normal (seq (token (seq (literal type) (not (ref word_characters)))) (choice unordered (ref type_specification) (ref type_alias) (seq (literal %28) (optional (seq (choice unordered (ref type_specification) (ref type_alias)) (repeat0 (seq (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00)) (choice unordered (ref type_specification) (ref type_alias)))) (optional (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00))))) (literal %29)))) (concept grammar.type-declaration))
(rule type_specification normal (seq (capture labeled name (ref type_identifier_alias)) (capture labeled type_parameters (optional (ref type_parameter_list))) (capture labeled type (ref type))) (concept grammar.type-specification) (source-names (tree-sitter type_spec)))
(rule field_name_list normal (seq (ref field_identifier_alias) (repeat0 (seq (literal %2C) (ref field_identifier_alias)))) (concept grammar.field-name-list))
(rule expression_list normal (seq (ref expression) (repeat0 (seq (literal %2C) (ref expression)))) (concept grammar.expression-list))
(rule type silent (choice unordered (ref simple_type) (ref parenthesized_type)) (concept grammar.type) (source-names (tree-sitter _type)))
(rule parenthesized_type normal (seq (literal %28) (ref type) (literal %29)) (concept grammar.parenthesized-type))
(rule simple_type silent (choice unordered (dynamicPrecedence -1 (ref type_identifier_alias)) (ref generic_type) (ref qualified_type) (ref pointer_type) (ref structure_type) (ref interface_type) (ref array_type) (ref slice_type) (dynamicPrecedence 3 (ref map_type)) (ref channel_type) (ref function_type) (ref negated_type)) (concept grammar.simple-type) (source-names (tree-sitter _simple_type)))
(rule generic_type normal (dynamicPrecedence 1 (seq (capture labeled type (choice unordered (ref type_identifier_alias) (ref qualified_type) (ref negated_type))) (capture labeled type_arguments (ref type_arguments)))) (concept grammar.generic-type))
(rule type_arguments normal (dynamicPrecedence 2 (seq (literal %5B) (seq (ref type_element) (repeat0 (seq (literal %2C) (ref type_element)))) (optional (literal %2C)) (literal %5D))) (concept grammar.type-argument-list))
(rule pointer_type normal (precedence 6 none (seq (literal %2A) (ref type))) (concept grammar.pointer-type))
(rule array_type normal (precedence 0 right (seq (literal %5B) (capture labeled length (ref expression)) (literal %5D) (capture labeled element (ref type)))) (concept grammar.array-type))
(rule implicit_length_array_type normal (seq (literal %5B) (literal ...) (literal %5D) (capture labeled element (ref type))) (concept grammar.implicit-length-array-type))
(rule slice_type normal (precedence 0 right (seq (literal %5B) (literal %5D) (capture labeled element (ref type)))) (concept grammar.slice-type))
(rule structure_type normal (seq (token (seq (literal struct) (not (ref word_characters)))) (ref field_declaration_list)) (concept grammar.structure-type) (source-names (tree-sitter struct_type)))
(rule negated_type normal (precedence 0 left (seq (literal %7E) (ref type))) (concept grammar.negated-type))
(rule field_declaration_list normal (seq (literal %7B) (optional (seq (ref field_declaration) (repeat0 (seq (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00)) (ref field_declaration))) (optional (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00))))) (literal %7D)) (concept grammar.field-declaration-list))
(rule field_declaration normal (seq (choice unordered (seq (seq (capture labeled name (ref field_identifier_alias)) (repeat0 (seq (literal %2C) (capture labeled name (ref field_identifier_alias))))) (capture labeled type (ref type))) (seq (optional (literal %2A)) (capture labeled type (choice unordered (ref type_identifier_alias) (ref qualified_type) (ref generic_type))))) (capture labeled tag (optional (ref string_literal)))) (concept grammar.field-declaration))
(rule interface_type normal (seq (token (seq (literal interface) (not (ref word_characters)))) (literal %7B) (optional (seq (ref interface_element) (repeat0 (seq (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00)) (ref interface_element))) (optional (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00))))) (literal %7D)) (concept grammar.interface-type))
(rule interface_element silent (choice unordered (ref method_element) (ref type_element)) (concept grammar.interface-element) (source-names (tree-sitter _interface_elem)))
(rule method_element normal (seq (capture labeled name (ref field_identifier_alias)) (capture labeled parameters (ref parameter_list)) (capture labeled result (optional (choice unordered (ref parameter_list) (ref simple_type))))) (concept grammar.method-element) (source-names (tree-sitter method_elem)))
(rule type_element normal (seq (ref type) (repeat0 (seq (literal %7C) (ref type)))) (concept grammar.type-element) (source-names (tree-sitter type_elem)))
(rule map_type normal (precedence 0 right (seq (token (seq (literal map) (not (ref word_characters)))) (literal %5B) (capture labeled key (ref type)) (literal %5D) (capture labeled value (ref type)))) (concept grammar.map-type))
(rule channel_type normal (precedence 0 left (choice unordered (seq (token (seq (literal chan) (not (ref word_characters)))) (capture labeled value (ref type))) (seq (token (seq (literal chan) (not (ref word_characters)))) (literal %3C-) (capture labeled value (ref type))) (precedence 6 none (seq (literal %3C-) (token (seq (literal chan) (not (ref word_characters)))) (capture labeled value (ref type)))))) (concept grammar.channel-type))
(rule function_type normal (precedence 0 right (seq (token (seq (literal func) (not (ref word_characters)))) (capture labeled parameters (ref parameter_list)) (capture labeled result (optional (choice unordered (ref parameter_list) (ref simple_type)))))) (concept grammar.function-type))
(rule block normal (seq (literal %7B) (optional (ref statement_list)) (literal %7D)) (concept grammar.block))
(rule statement_list normal (choice unordered (seq (ref statement) (repeat0 (seq (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00)) (ref statement))) (optional (seq (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00)) (optional (alias labeled_statement (ref empty_labeled_statement)))))) (alias labeled_statement (ref empty_labeled_statement))) (concept grammar.statement-list))
(rule statement silent (choice unordered (ref declaration) (ref simple_statement) (ref return_statement) (ref go_statement) (ref defer_statement) (ref if_statement) (ref for_statement) (ref expression_switch_statement) (ref type_switch_statement) (ref select_statement) (ref labeled_statement) (ref fall_through_statement) (ref break_statement) (ref continue_statement) (ref go_to_statement) (ref block) (ref empty_statement)) (concept grammar.statement) (source-names (tree-sitter _statement)))
(rule empty_statement normal (literal %3B) (concept grammar.empty-statement))
(rule simple_statement silent (choice unordered (ref expression_statement) (ref send_statement) (ref inc_statement) (ref dec_statement) (ref assignment_statement) (ref short_variable_declaration)) (concept grammar.simple-statement) (source-names (tree-sitter _simple_statement)))
(rule expression_statement normal (ref expression) (concept grammar.expression-statement))
(rule send_statement normal (seq (capture labeled channel (ref expression)) (literal %3C-) (capture labeled value (ref expression))) (concept grammar.send-statement))
(rule receive_statement normal (seq (optional (seq (capture labeled left (ref expression_list)) (choice unordered (literal %3D) (literal %3A%3D)))) (capture labeled right (ref expression))) (concept grammar.receive-statement))
(rule inc_statement normal (seq (ref expression) (literal %2B%2B)) (concept grammar.inc-statement))
(rule dec_statement normal (seq (ref expression) (literal --)) (concept grammar.dec-statement))
(rule assignment_statement normal (seq (capture labeled left (ref expression_list)) (capture labeled operator (choice unordered (literal %2A%3D) (literal %2F%3D) (literal %25%3D) (literal %3C%3C%3D) (literal %3E%3E%3D) (literal %26%3D) (literal %26%5E%3D) (literal %2B%3D) (literal -%3D) (literal %7C%3D) (literal %5E%3D) (literal %3D))) (capture labeled right (ref expression_list))) (concept grammar.assignment-statement))
(rule short_variable_declaration normal (seq (capture labeled left (ref expression_list)) (literal %3A%3D) (capture labeled right (ref expression_list))) (concept grammar.short-variable-declaration) (source-names (tree-sitter short_var_declaration)))
(rule labeled_statement normal (seq (capture labeled label (alias label_name (ref identifier))) (literal %3A) (ref statement)) (concept grammar.labeled-statement))
(rule empty_labeled_statement normal (seq (capture labeled label (alias label_name (ref identifier))) (literal %3A)) (concept grammar.empty-labeled-statement))
(rule fall_through_statement normal (precedence 0 left (token (seq (literal fallthrough) (not (ref word_characters))))) (concept grammar.fall-through-statement) (source-names (tree-sitter fallthrough_statement)))
(rule break_statement normal (seq (token (seq (literal break) (not (ref word_characters)))) (optional (alias label_name (ref identifier)))) (concept grammar.break-statement))
(rule continue_statement normal (seq (token (seq (literal continue) (not (ref word_characters)))) (optional (alias label_name (ref identifier)))) (concept grammar.continue-statement))
