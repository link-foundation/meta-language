(grammar (start source_file) (matching longest) (settling tokens precedence dynamic ambiguity))
(extra (ref comment))
(extra (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)))
(conflict simple_type expression)
(conflict simple_type generic_type expression)
(conflict qualified_type expression)
(conflict generic_type simple_type)
(conflict parameter_declaration simple_type)
(conflict type_parameter_declaration simple_type expression)
(conflict type_parameter_declaration expression)
(conflict type_parameter_declaration simple_type generic_type expression)
(rule source_file normal (seq (repeat0 (choice unordered (seq (ref statement) (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00))) (seq (ref top_level_declaration) (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00))))) (optional (ref top_level_declaration))) (concept grammar.source-file))
(rule top_level_declaration silent (choice unordered (ref package_clause) (ref function_declaration) (ref method_declaration) (ref import_declaration)) (concept grammar.top-level-declaration) (source-names (tree-sitter _top_level_declaration)))
(rule package_clause normal (seq (token (seq (literal package) (not (ref word_characters)))) (ref package_identifier_alias)) (concept grammar.package-clause))
(rule import_declaration normal (seq (token (seq (literal import) (not (ref word_characters)))) (choice unordered (ref import_specification) (ref import_specification_list))) (concept grammar.import-declaration))
(rule import_specification normal (seq (optional (capture labeled name (choice unordered (ref dot) (ref blank_identifier) (ref package_identifier_alias)))) (capture labeled path (ref string_literal))) (concept grammar.import-specification) (source-names (tree-sitter import_spec)))
(rule dot normal (literal .) (concept grammar.dot))
(rule blank_identifier token (seq (literal _) (not (ref word_characters))) (concept grammar.blank-identifier))
(rule import_specification_list normal (seq (literal %28) (optional (seq (ref import_specification) (repeat0 (seq (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00)) (ref import_specification))) (optional (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00))))) (literal %29)) (concept grammar.import-specification-list) (source-names (tree-sitter import_spec_list)))
(rule declaration silent (choice unordered (ref constant_declaration) (ref type_declaration) (ref variable_declaration)) (concept grammar.declaration) (source-names (tree-sitter _declaration)))
(rule constant_declaration normal (seq (token (seq (literal const) (not (ref word_characters)))) (choice unordered (ref constant_specification) (seq (literal %28) (repeat0 (seq (ref constant_specification) (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00)))) (literal %29)))) (concept grammar.constant-declaration) (source-names (tree-sitter const_declaration)))
(rule constant_specification normal (precedence 0 left (seq (capture labeled name (seq (ref identifier) (repeat0 (seq (literal %2C) (ref identifier))))) (optional (seq (optional (capture labeled type (ref type))) (literal %3D) (capture labeled value (ref expression_list)))))) (concept grammar.constant-specification) (source-names (tree-sitter const_spec)))
(rule variable_declaration normal (seq (token (seq (literal var) (not (ref word_characters)))) (choice unordered (ref variable_specification) (ref variable_specification_list))) (concept grammar.variable-declaration) (source-names (tree-sitter var_declaration)))
(rule variable_specification normal (seq (seq (capture labeled name (ref identifier)) (repeat0 (seq (literal %2C) (capture labeled name (ref identifier))))) (choice unordered (seq (capture labeled type (ref type)) (optional (seq (literal %3D) (capture labeled value (ref expression_list))))) (seq (literal %3D) (capture labeled value (ref expression_list))))) (concept grammar.variable-specification) (source-names (tree-sitter var_spec)))
(rule variable_specification_list normal (seq (literal %28) (repeat0 (seq (ref variable_specification) (choice unordered (alias unnamed_token (token (literal %0A))) (literal %3B) (literal %00)))) (literal %29)) (concept grammar.variable-specification-list) (source-names (tree-sitter var_spec_list)))
(rule function_declaration normal (precedence 1 right (seq (token (seq (literal func) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled type_parameters (optional (ref type_parameter_list))) (capture labeled parameters (ref parameter_list)) (capture labeled result (optional (choice unordered (ref parameter_list) (ref simple_type)))) (capture labeled body (optional (ref block))))) (concept grammar.function-declaration))
(rule method_declaration normal (precedence 1 right (seq (token (seq (literal func) (not (ref word_characters)))) (capture labeled receiver (ref parameter_list)) (capture labeled name (ref field_identifier_alias)) (capture labeled parameters (ref parameter_list)) (capture labeled result (optional (choice unordered (ref parameter_list) (ref simple_type)))) (capture labeled body (optional (ref block))))) (concept grammar.method-declaration))
(rule type_parameter_list normal (seq (literal %5B) (seq (ref type_parameter_declaration) (repeat0 (seq (literal %2C) (ref type_parameter_declaration)))) (optional (literal %2C)) (literal %5D)) (concept grammar.type-parameter-list))
(rule type_parameter_declaration normal (seq (seq (capture labeled name (ref identifier)) (repeat0 (seq (literal %2C) (capture labeled name (ref identifier))))) (capture labeled type (alias type_constraint (ref type_element)))) (concept grammar.type-parameter-declaration))
(rule parameter_list normal (seq (literal %28) (optional (seq (optional (seq (choice unordered (ref parameter_declaration) (ref variadic_parameter_declaration)) (repeat0 (seq (literal %2C) (choice unordered (ref parameter_declaration) (ref variadic_parameter_declaration)))))) (optional (literal %2C)))) (literal %29)) (concept grammar.parameter-list))
