(rule identifier token (seq (class plain (char _) (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl)) (repeat0 (class plain (char _) (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (category Mn) (category Mc) (category Nd) (category Pc)))) (concept grammar.identifier))
