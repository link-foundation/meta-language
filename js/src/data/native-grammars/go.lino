(rule expression_switch_statement normal (seq (token (seq (literal switch) (not (ref word_characters)))) (optional (seq (capture labeled initializer (ref simple_statement)) (literal %3B))) (capture labeled value (optional (ref expression))) (literal %7B) (repeat0 (choice unordered (ref expression_case) (ref default_case))) (literal %7D)) (concept grammar.expression-switch-statement))
