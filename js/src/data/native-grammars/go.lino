(rule return_statement normal (seq (token (seq (literal return) (not (ref word_characters)))) (optional (ref expression_list))) (concept grammar.return-statement))
(rule go_statement normal (seq (token (seq (literal go) (not (ref word_characters)))) (ref expression)) (concept grammar.go-statement))
(rule defer_statement normal (seq (token (seq (literal defer) (not (ref word_characters)))) (ref expression)) (concept grammar.defer-statement))
(rule if_statement normal (seq (token (seq (literal if) (not (ref word_characters)))) (optional (seq (capture labeled initializer (ref simple_statement)) (literal %3B))) (capture labeled condition (ref expression)) (capture labeled consequence (ref block)) (optional (seq (token (seq (literal else) (not (ref word_characters)))) (capture labeled alternative (choice unordered (ref block) (ref if_statement)))))) (concept grammar.if-statement))
(rule for_statement normal (seq (token (seq (literal for) (not (ref word_characters)))) (optional (choice unordered (ref expression) (ref for_clause) (ref range_clause))) (capture labeled body (ref block))) (concept grammar.for-statement))
(rule for_clause normal (seq (capture labeled initializer (optional (ref simple_statement))) (literal %3B) (capture labeled condition (optional (ref expression))) (literal %3B) (capture labeled update (optional (ref simple_statement)))) (concept grammar.for-clause))
