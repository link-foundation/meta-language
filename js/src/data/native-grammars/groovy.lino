(rule exports_module_directive normal (seq (token (seq (literal exports) (not (ref word_characters)))) (capture labeled package (ref name)) (optional (seq (token (seq (literal to) (not (ref word_characters)))) (capture labeled modules (ref name)) (repeat0 (seq (literal %2C) (capture labeled modules (ref name)))))) (literal %3B)) (concept grammar.exports-module-directive))
