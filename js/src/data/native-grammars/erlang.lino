(scanner rejection_guard (tokens error_sentinel) (operations fail))
(rule source_file normal (choice unordered (capture labeled forms_only (repeat0 (ref top_level_declaration))) (capture labeled exprs (repeat0 (seq (ref expression) (optional (literal .)))))) (concept grammar.source-file))
(rule top_level_declaration silent (choice unordered (ref module_attribute) (ref behaviour_attribute) (ref export_attribute) (ref import_attribute) (ref import_record_attribute) (ref export_type_attribute) (ref export_record_attribute) (ref optional_callbacks_attribute) (ref compile_options_attribute) (ref feature_attribute) (ref file_attribute) (ref deprecated_attribute) (ref record_declaration) (ref type_alias) (ref nominal) (ref opaque_type_declaration) (ref specification) (ref callback) (ref wild_attribute) (ref fun_declaration) (ref preprocessor_directive) (ref structural_search_rule_definition) (ref shebang)) (concept grammar.top-level-declaration) (source-names (tree-sitter _form)))
(rule structural_search_rule_definition normal (precedence 0 right (seq (token (seq (literal ssr) (not (ref word_characters)))) (literal %3A) (capture labeled lhs (ref expression)) (capture labeled rhs (optional (ref structural_search_rule_replacement))) (capture labeled where (optional (ref structural_search_condition_clause))) (literal .))) (concept grammar.structural-search-rule-definition) (source-names (tree-sitter ssr_definition)))
(rule structural_search_rule_replacement normal (seq (literal %3D%3D%3E%3E) (capture labeled expr (ref expression))) (concept grammar.structural-search-rule-replacement) (source-names (tree-sitter ssr_replacement)))
(rule structural_search_condition_clause normal (seq (token (seq (literal where) (not (ref word_characters)))) (capture labeled guard (ref guard))) (concept grammar.structural-search-condition-clause) (source-names (tree-sitter ssr_where)))
(rule preprocessor_directive silent (choice unordered (ref preprocessor_include_directive) (ref preprocessor_library_include_directive) (ref preprocessor_removal_directive) (ref preprocessor_defined_condition_directive) (ref preprocessor_undefined_condition_directive) (ref preprocessor_else_directive) (ref preprocessor_end_directive) (ref preprocessor_if_directive) (ref preprocessor_else_if_directive) (ref preprocessor_definition_directive)) (concept grammar.preprocessor-directive) (source-names (tree-sitter _preprocessor_directive)))
(rule preprocessor_include_directive normal (seq (literal -) (choice unordered (token (seq (literal include) (not (ref word_characters)))) (alias %27include (literal %27include%27))) (literal %28) (capture labeled file (repeat1 (ref include_detail))) (literal %29) (literal .)) (concept grammar.preprocessor-include-directive) (source-names (tree-sitter pp_include)))
(rule preprocessor_library_include_directive normal (seq (literal -) (choice unordered (token (seq (literal include_lib) (not (ref word_characters)))) (alias %27include_lib (literal %27include_lib%27))) (literal %28) (capture labeled file (repeat1 (ref include_detail))) (literal %29) (literal .)) (concept grammar.preprocessor-library-include-directive) (source-names (tree-sitter pp_include_lib)))
(rule preprocessor_removal_directive normal (seq (literal -) (choice unordered (token (seq (literal undef) (not (ref word_characters)))) (alias %27undef (literal %27undef%27))) (literal %28) (capture labeled name (ref macro_name)) (literal %29) (literal .)) (concept grammar.preprocessor-removal-directive) (source-names (tree-sitter pp_undef)))
(rule preprocessor_defined_condition_directive normal (seq (literal -) (choice unordered (token (seq (literal ifdef) (not (ref word_characters)))) (alias %27ifdef (literal %27ifdef%27))) (literal %28) (capture labeled name (ref macro_name)) (literal %29) (literal .)) (concept grammar.preprocessor-defined-condition-directive) (source-names (tree-sitter pp_ifdef)))
(rule preprocessor_undefined_condition_directive normal (seq (literal -) (choice unordered (token (seq (literal ifndef) (not (ref word_characters)))) (alias %27ifndef (literal %27ifndef%27))) (literal %28) (capture labeled name (ref macro_name)) (literal %29) (literal .)) (concept grammar.preprocessor-undefined-condition-directive) (source-names (tree-sitter pp_ifndef)))
(rule preprocessor_else_directive normal (seq (literal -) (choice unordered (token (seq (literal else) (not (ref word_characters)))) (alias %27else (literal %27else%27))) (literal .)) (concept grammar.preprocessor-else-directive) (source-names (tree-sitter pp_else)))
(rule preprocessor_end_directive normal (seq (literal -) (choice unordered (token (seq (literal endif) (not (ref word_characters)))) (alias %27endif (literal %27endif%27))) (literal .)) (concept grammar.preprocessor-end-directive) (source-names (tree-sitter pp_endif)))
(rule preprocessor_if_directive normal (precedence 20 none (seq (literal -) (choice unordered (token (seq (literal if) (not (ref word_characters)))) (alias %27if (literal %27if%27))) (capture labeled cond (ref expression)) (literal .))) (concept grammar.preprocessor-if-directive) (source-names (tree-sitter pp_if)))
(rule preprocessor_else_if_directive normal (seq (literal -) (choice unordered (token (seq (literal elif) (not (ref word_characters)))) (alias %27elif (literal %27elif%27))) (capture labeled cond (ref expression)) (literal .)) (concept grammar.preprocessor-else-if-directive) (source-names (tree-sitter pp_elif)))
(rule preprocessor_definition_directive normal (seq (literal -) (choice unordered (token (seq (literal define) (not (ref word_characters)))) (alias %27define (literal %27define%27))) (literal %28) (capture labeled lhs (ref macro_left_hand_side)) (literal %2C) (capture labeled replacement (optional (ref macro_definition_replacement))) (literal %29) (literal .)) (concept grammar.preprocessor-definition-directive) (source-names (tree-sitter pp_define)))
(rule include_detail silent (choice unordered (ref string) (ref macro_call_expression)) (concept grammar.include-detail) (source-names (tree-sitter _include_detail)))
(rule module_attribute normal (seq (literal -) (choice unordered (token (seq (literal module) (not (ref word_characters)))) (alias %27module (literal %27module%27))) (literal %28) (capture labeled name (ref name)) (literal %29) (literal .)) (concept grammar.module-attribute))
(rule behaviour_attribute normal (seq (literal -) (choice unordered (choice unordered (token (seq (literal behaviour) (not (ref word_characters)))) (alias %27behaviour (literal %27behaviour%27))) (choice unordered (token (seq (literal behavior) (not (ref word_characters)))) (alias %27behavior (literal %27behavior%27)))) (literal %28) (capture labeled name (ref name)) (literal %29) (literal .)) (concept grammar.behaviour-attribute))
(rule export_attribute normal (seq (literal -) (choice unordered (token (seq (literal export) (not (ref word_characters)))) (alias %27export (literal %27export%27))) (literal %28) (literal %5B) (optional (seq (capture labeled funs (ref fa)) (repeat0 (seq (optional (literal %2C)) (capture labeled funs (ref fa)))))) (literal %5D) (literal %29) (literal .)) (concept grammar.export-attribute))
(rule import_attribute normal (seq (literal -) (choice unordered (token (seq (literal import) (not (ref word_characters)))) (alias %27import (literal %27import%27))) (literal %28) (capture labeled module (ref name)) (literal %2C) (literal %5B) (optional (seq (capture labeled funs (ref fa)) (repeat0 (seq (optional (literal %2C)) (capture labeled funs (ref fa)))))) (literal %5D) (literal %29) (literal .)) (concept grammar.import-attribute))
(rule import_record_attribute normal (seq (literal -) (choice unordered (token (seq (literal import_record) (not (ref word_characters)))) (alias %27import_record (literal %27import_record%27))) (literal %28) (capture labeled module (ref name)) (literal %2C) (capture labeled records (ref import_record_names)) (literal %29) (literal .)) (concept grammar.import-record-attribute))
(rule import_record_names normal (seq (literal %5B) (optional (seq (capture labeled names (ref name)) (repeat0 (seq (optional (literal %2C)) (capture labeled names (ref name)))))) (literal %5D)) (concept grammar.import-record-names))
(rule optional_callbacks_attribute normal (seq (literal -) (choice unordered (token (seq (literal optional_callbacks) (not (ref word_characters)))) (alias %27optional_callbacks (literal %27optional_callbacks%27))) (literal %28) (literal %5B) (optional (seq (capture labeled callbacks (ref fa)) (repeat0 (seq (optional (literal %2C)) (capture labeled callbacks (ref fa)))))) (literal %5D) (literal %29) (literal .)) (concept grammar.optional-callbacks-attribute))
(rule fa normal (seq (capture labeled fun (ref name)) (capture labeled arity (ref arity))) (concept grammar.fa))
(rule export_type_attribute normal (seq (literal -) (choice unordered (token (seq (literal export_type) (not (ref word_characters)))) (alias %27export_type (literal %27export_type%27))) (literal %28) (literal %5B) (optional (seq (capture labeled types (ref fa)) (repeat0 (seq (optional (literal %2C)) (capture labeled types (ref fa)))))) (literal %5D) (literal %29) (literal .)) (concept grammar.export-type-attribute))
(rule export_record_attribute normal (seq (literal -) (choice unordered (token (seq (literal export_record) (not (ref word_characters)))) (alias %27export_record (literal %27export_record%27))) (literal %28) (literal %5B) (optional (seq (capture labeled records (ref atom)) (repeat0 (seq (optional (literal %2C)) (capture labeled records (ref atom)))))) (literal %5D) (literal %29) (literal .)) (concept grammar.export-record-attribute))
(rule compile_options_attribute normal (seq (literal -) (choice unordered (token (seq (literal compile) (not (ref word_characters)))) (alias %27compile (literal %27compile%27))) (literal %28) (capture labeled options (ref expression)) (literal %29) (literal .)) (concept grammar.compile-options-attribute))
(rule file_attribute normal (seq (literal -) (choice unordered (token (seq (literal file) (not (ref word_characters)))) (alias %27file (literal %27file%27))) (literal %28) (capture labeled original_file (ref string)) (literal %2C) (capture labeled original_line (ref integer_literal)) (literal %29) (literal .)) (concept grammar.file-attribute))
(rule deprecated_attribute normal (seq (literal -) (choice unordered (token (seq (literal deprecated) (not (ref word_characters)))) (alias %27deprecated (literal %27deprecated%27))) (literal %28) (capture labeled attr (ref deprecated_details)) (literal %29) (literal .)) (concept grammar.deprecated-attribute))
(rule feature_attribute normal (seq (literal -) (choice unordered (token (seq (literal feature) (not (ref word_characters)))) (alias %27feature (literal %27feature%27))) (literal %28) (capture labeled feature (ref expression)) (literal %2C) (capture labeled flag (ref expression)) (literal %29) (literal .)) (concept grammar.feature-attribute))
