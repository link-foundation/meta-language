(rule comment token (choice unordered (seq (literal %3B) (repeat0 (class negated (char %0D) (char %0A) (char %C2%85) (char %E2%80%A8) (char %E2%80%A9)))) (seq (choice unordered (literal %23%21%20) (literal %23%21%2F)) (repeat0 (seq (repeat0 (class negated (char %0D) (char %0A) (char %C2%85) (char %E2%80%A8) (char %E2%80%A9))) (literal %5C) (class plain (char %0D) (char %0A) (char %C2%85) (char %E2%80%A8) (char %E2%80%A9)))) (repeat0 (class negated (char %0D) (char %0A) (char %C2%85) (char %E2%80%A8) (char %E2%80%A9))))) (concept grammar.comment))
