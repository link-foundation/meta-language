(grammar (start program))
(rule program normal (choice ordered (seq (alias byte_order_mark (immediateToken (literal %EF%BB%BF))) (repeat0 (ref program_element))) (repeat0 (ref program_element))) (concept grammar.program))
(rule program_element silent (choice ordered (ref atmosphere) (ref extension) (ref datum)) (concept grammar.program-element) (source-names (tree-sitter _token)))
(rule atmosphere silent (choice ordered (alias whitespace (immediateToken (repeat1 (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D) (char %C2%85) (char %C2%A0) (char %E1%9A%80) (range %E2%80%80 %E2%80%8A) (char %E2%80%A8) (char %E2%80%A9) (char %E2%80%AF) (char %E2%81%9F) (char %E3%80%80) (char %EF%BB%BF))))) (ref comment) (ref datum_comment) (ref block_comment)) (concept grammar.atmosphere) (source-names (tree-sitter _skip)))
