RustStringContinuationWhitespace%28unit%29%20%7B%0A%20%20return%20unit%20%3D%3D%3D%209%20%7C%7C%20unit%20%3D%3D%3D%2010%20%7C%7C%20unit%20%3D%3D%3D%2013%20%7C%7C%20unit%20%3D%3D%3D%2032%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Read%20backslash%20plus%20LF%2C%20or%20the%20source-level%20CRLF%20spelling%20of%20LF%2C%20and%20only%0A%20%2A%20the%20four%20continuation%20whitespace%20units.%20A%20negative%20result%20rejects%20the%20prefix.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bnumber%7D%20start%20%40returns%20%7Bnumber%7D%0A%20%2A%2F%0Aexport%20function%20readRustStringContinuationEnd%28units%2C%20start%29%20%7B%0A%20%20if%20%28start%20%3C%200%20%7C%7C%20start%20%3E%3D%20units.length%20%7C%7C%20start%20%25%201%20%21%3D%3D%200%20%7C%7C%20units%5Bstart%5D%20%21%3D%3D%2092%29%20return%20-1%3B%0A%20%20let%20end%20%3D%20start%20%2B%201%3B%0A%20%20if%20%28units%5Bend%5D%20%3D%3D%3D%2013%20%26%26%20units%5Bend%20%2B%201%5D%20%3D%3D%3D%2010%29%20end%20%2B%3D%201%3B%0A%20%20if%20%28units%5Bend%5D%20%21%3D%3D%2010%29%20return%20-1%3B%0A%20%20end%20%2B%3D%201%3B%0A%20%20while%20%28end%20%3C%20units.length%20%26%26%20acceptRustStringContinuationWhitespace%28units%5Bend%5D%29%29%20end%20%2B%3D%201%3B%0A%20%20return%20end%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Rust%20normalizes%20source%20CRLF%20into%20LF%20before%20interpreting%20literal%20values.%0A%20%2A%20Return%20the%20original%20source%20end%2C%20or%20a%20negative%20result%20for%20another%20spelling.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bnumber%7D%20start%20%40returns%20%7Bnumber%7D%0A%20%2A%2F%0Aexport%20function%20readRustSourceLineBreakEnd%28units%2C%20start%29%20%7B%0A%20%20if%20%28start%20%3C%200%20%7C%7C%20start%20%3E%3D%20units.length%20%7C%7C%20start%20%25%201%20%21%3D%3D%200%29%20return%20-1%3B%0A%20%20return%20units%5Bstart%5D%20%3D%3D%3D%2013%20%26%26%20units%5Bstart%20%2B%201%5D%20%3D%3D%3D%2010%20%3F%20start%20%2B%202%20%3A%20-1%3B%0A%7D%0A%0A%0A%2F%2F%20Rust%20Reference%20lex.token.str-byte%20%2F%20lex.token.str-byte-raw.%20Offsets%20address%0A%2F%2F%20the%20original%20UTF-16%20source%3B%20byte%20values%20remain%20distinct%20from%20UTF-8%20text.%0A%0A%0A%0A%2F%2A%2A%20Packet%3A%20%5B0%5D%20absent%3B%20%5B1%2Cend%2C...bytes%5D%20literal%3B%20%5Bnegative%2Cat%2Cend%5D%20error.%0A%20%2A%20Literal%20identifier%20suffixes%20belong%20to%20the%20host%27s%20existing%20XID%20lexer.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bnumber%7D%20start%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20decodeRustByteStringLiteral%28units%2Cstart%29%7B%0A%20if%28%21Number.isInteger%28start%29%7C%7Cstart%3C0%7C%7Cstart%3E%3Dunits.length%7C%7Cunits%5Bstart%5D%21%3D%3D98%29return%20%5B0%5D%3B%0A%20const%20raw%3Dunits%5Bstart%2B1%5D%3D%3D%3D114%3B%0A%20let%20opening%3Dstart%2B%28raw%3F2%3A1%29%3B%0A%20if%28raw%29while%28opening%3Cunits.length%26%26units%5Bopening%5D%3D%3D%3D35%29opening%2B%3D1%3B%0A%20if%28units%5Bopening%5D%21%3D%3D34%29return%20%5B0%5D%3B%0A%20const%20hashes%3Draw%3Fopening-start-2%3A0%3B%0A%20if%28hashes%3E255%29return%20%5B-7%2Cstart%2Copening%2B1%5D%3B%0A%20let%20position%3Dopening%2B1%3Blet%20bytes%3D%5B%5D%3B%0A%20while%28position%3Cunits.length%29%7B%0A%20%20const%20unit%3Dunits%5Bposition%5D%3F%3F-1%3B%0A%20%20if%28unit%3D%3D%3D34%29%7B%0A%20%20%20let%20matches%3Dtrue%3B%0A%20%20%20for%28let%20count%3D0%3Bcount%3Chashes%3Bcount%2B%3D1%29if%28units%5Bposition%2B1%2Bcount%5D%21%3D%3D35%29matches%3Dfalse%3B%0A%20%20%20if%28matches%29return%20%5B1%2Cposition%2B1%2Bhashes%5D.concat%28bytes%29%3B%0A%20%20%7D%0A%20%20if%28%21raw%26%26unit%3D%3D%3D92%29%7B%0A%20%20%20const%20continuation%3DreadRustStringContinuationEnd%28units%2Cposition%29%3B%0A%20%20%20if%28continuation%3E%3D0%29%7Bposition%3Dcontinuation%3Bcontinue%3B%7D%0A%20%20%20const%20escaped%3Dunits%5Bposition%2B1%5D%3F%3F-1%3B%0A%20%20%20if%28escaped%3D%3D%3D117%29return%20%5B-5%2Cposition%2CMath.min%28position%2B2%2Cunits.length%29%5D%3B%0A%20%