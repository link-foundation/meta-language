(grammar (start amount))
(rule decimal_digit token (class plain (range 0 9) (range %D9%A0 %D9%A9) (range %DB%B0 %DB%B9) (range %DF%80 %DF%89) (range %E0%A5%A6 %E0%A5%AF) (range %E0%A7%A6 %E0%A7%AF) (range %E0%A9%A6 %E0%A9%AF) (range %E0%AB%A6 %E0%AB%AF) (range %E0%AD%A6 %E0%AD%AF) (range %E0%AF%A6 %E0%AF%AF) (range %E0%B1%A6 %E0%B1%AF) (range %E0%B3%A6 %E0%B3%AF) (range %E0%B5%A6 %E0%B5%AF) (range %E0%B7%A6 %E0%B7%AF) (range %E0%B9%90 %E0%B9%99) (range %E0%BB%90 %E0%BB%99) (range %E0%BC%A0 %E0%BC%A9) (range %E1%81%80 %E1%81%89) (range %E1%82%90 %E1%82%99) (range %E1%9F%A0 %E1%9F%A9) (range %E1%A0%90 %E1%A0%99) (range %E1%A5%86 %E1%A5%8F) (range %E1%A7%90 %E1%A7%99) (range %E1%AA%80 %E1%AA%89) (range %E1%AA%90 %E1%AA%99) (range %E1%AD%90 %E1%AD%99) (range %E1%AE%B0 %E1%AE%B9) (range %E1%B1%80 %E1%B1%89) (range %E1%B1%90 %E1%B1%99) (range %EA%98%A0 %EA%98%A9) (range %EA%A3%90 %EA%A3%99) (range %EA%A4%80 %EA%A4%89) (range %EA%A7%90 %EA%A7%99) (range %EA%A7%B0 %EA%A7%B9) (range %EA%A9%90 %EA%A9%99) (range %EA%AF%B0 %EA%AF%B9) (range %EF%BC%90 %EF%BC%99) (range %F0%90%92%A0 %F0%90%92%A9) (range %F0%90%B4%B0 %F0%90%B4%B9) (range %F0%90%B5%80 %F0%90%B5%89) (range %F0%91%81%A6 %F0%91%81%AF) (range %F0%91%83%B0 %F0%91%83%B9) (range %F0%91%84%B6 %F0%91%84%BF) (range %F0%91%87%90 %F0%91%87%99) (range %F0%91%8B%B0 %F0%91%8B%B9) (range %F0%91%91%90 %F0%91%91%99) (range %F0%91%93%90 %F0%91%93%99) (range %F0%91%99%90 %F0%91%99%99) (range %F0%91%9B%80 %F0%91%9B%89) (range %F0%91%9B%90 %F0%91%9B%99) (range %F0%91%9B%9A %F0%91%9B%A3) (range %F0%91%9C%B0 %F0%91%9C%B9) (range %F0%91%A3%A0 %F0%91%A3%A9) (range %F0%91%A5%90 %F0%91%A5%99) (range %F0%91%AF%B0 %F0%91%AF%B9) (range %F0%91%B1%90 %F0%91%B1%99) (range %F0%91%B5%90 %F0%91%B5%99) (range %F0%91%B6%A0 %F0%91%B6%A9) (range %F0%91%B7%A0 %F0%91%B7%A9) (range %F0%91%BD%90 %F0%91%BD%99) (range %F0%96%84%B0 %F0%96%84%B9) (range %F0%96%A9%A0 %F0%96%A9%A9) (range %F0%96%AB%80 %F0%96%AB%89) (range %F0%96%AD%90 %F0%96%AD%99) (range %F0%96%B5%B0 %F0%96%B5%B9) (range %F0%9C%B3%B0 %F0%9C%B3%B9) (range %F0%9D%9F%8E %F0%9D%9F%97) (range %F0%9D%9F%98 %F0%9D%9F%A1) (range %F0%9D%9F%A2 %F0%9D%9F%AB) (range %F0%9D%9F%AC %F0%9D%9F%B5) (range %F0%9D%9F%B6 %F0%9D%9F%BF) (range %F0%9E%85%80 %F0%9E%85%89) (range %F0%9E%8B%B0 %F0%9E%8B%B9) (range %F0%9E%93%B0 %F0%9E%93%B9) (range %F0%9E%97%B1 %F0%9E%97%BA) (range %F0%9E%A5%90 %F0%9E%A5%99) (range %F0%9F%AF%B0 %F0%9F%AF%B9)))
(rule numeral token (seq (optional (class plain (char %2B) (char -) (char %E2%88%92))) (choice unordered (seq (repeat 1 3 (ref decimal_digit)) (repeat 1 5 (seq (class plain (char %20) (char %C2%A0) (char %E2%80%AF)) (repeat 3 3 (ref decimal_digit)))) (optional (seq (class plain (char .) (char %2C) (char %D9%AB)) (repeat 1 8 (ref decimal_digit))))) (seq (repeat 1 3 (ref decimal_digit)) (repeat 1 5 (seq (literal %2C) (repeat 3 3 (ref decimal_digit)))) (optional (seq (literal .) (repeat 1 8 (ref decimal_digit))))) (seq (repeat 1 3 (ref decimal_digit)) (repeat 1 5 (seq (literal .) (repeat 3 3 (ref decimal_digit)))) (optional (seq (literal %2C) (repeat 1 8 (ref decimal_digit))))) (seq (repeat 1 3 (ref decimal_digit)) (repeat 1 5 (seq (literal %D9%AC) (repeat 3 3 (ref decimal_digit)))) (optional (seq (literal %D9%AB) (repeat 1 8 (ref decimal_digit))))) (seq (repeat 1 18 (ref decimal_digit)) (optional (seq (class plain (char .) (char %2C) (char %D9%AB)) (repeat 1 8 (ref decimal_digit))))))))
(rule scale token (choice unordered (literalInsensitive bn) (literalInsensitive k) (literalInsensitive m)))
(rule amount normal (seq (ref numeral) (optional (seq (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (ref scale)))))
(rule first_amount normal (ref amount))
(rule last_amount normal (ref amount))
(rule number_range normal (seq (ref first_amount) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (class plain (char -) (char %E2%80%93) (char %E2%80%94) (char %E2%88%92)) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (ref last_amount)))
(rule currency token (choice unordered (literalInsensitive US%24) (literalInsensitive CA%24) (literalInsensitive AU%24) (literalInsensitive NZ%24) (literalInsensitive HK%24) (literalInsensitive SG%24) (literalInsensitive JP%C2%A5) (literalInsensitive CN%C2%A5) (literalInsensitive C%24) (literalInsensitive A%24) (literalInsensitive S%24) (literalInsensitive R%24) (literalInsensitive %24) (literalInsensitive %E2%82%AC) (literalInsensitive %C2%A3) (literalInsensitive %E2%82%BD) (literalInsensitive %C2%A5) (literalInsensitive %E5%85%83) (literalInsensitive %E2%82%B9) (literalInsensitive %E2%82%A9) (literalInsensitive %E2%82%BA) (literalInsensitive %E2%82%B4) (literalInsensitive %E2%82%B8) (literalInsensitive %E2%82%BE) (literalInsensitive %D6%8F) (literalInsensitive %E0%B8%BF) (literalInsensitive %E2%82%AB) (literalInsensitive %E2%82%AA) (literalInsensitive %E2%82%B1) (literalInsensitive %E2%82%A6) (literalInsensitive %E2%82%A1) (literalInsensitive %E2%82%B2) (literalInsensitive %E2%82%B5) (literalInsensitive %E2%82%AD) (literalInsensitive %E2%82%AE) (literalInsensitive %E2%82%A8) (literalInsensitive %E0%A7%B3) (literalInsensitive %E1%9F%9B) (repeat 3 3 (range A Z))))
(rule money_amount normal (choice unordered (seq (ref currency) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (ref amount) (optional (seq (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (ref currency)))) (seq (ref amount) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (ref currency))))
(rule first_money normal (choice unordered (ref money_amount) (ref amount)))
(rule last_money normal (choice unordered (ref money_amount) (ref amount)))
(rule money_range normal (seq (ref first_money) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (class plain (char -) (char %E2%80%93) (char %E2%80%94) (char %E2%88%92)) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (ref last_money)))
(rule calendar_year token (repeat 4 4 (ref decimal_digit)))
(rule calendar_month token (repeat 1 2 (ref decimal_digit)))
(rule calendar_day token (repeat 1 2 (ref decimal_digit)))
(rule full_date normal (choice unordered (seq (ref calendar_year) (literal -) (ref calendar_month) (literal -) (ref calendar_day)) (seq (ref calendar_day) (literal .) (ref calendar_month) (literal .) (ref calendar_year))))
(rule month_date normal (choice unordered (seq (ref calendar_month) (literal .) (ref calendar_year)) (seq (ref calendar_year) (literal -) (ref calendar_month))))
(rule short_date normal (seq (ref calendar_day) (class plain (char -) (char %E2%80%93) (char %E2%80%94) (char %E2%88%92)) (ref calendar_month)))
(rule date_endpoint normal (choice unordered (ref full_date) (ref month_date) (ref calendar_year)))
(rule first_date normal (ref date_endpoint))
(rule last_date normal (choice unordered (ref date_endpoint) (ref open_date)))
(rule open_date token (choice unordered (literalInsensitive present) (literalInsensitive today) (literalInsensitive now)))
(rule date_range normal (seq (ref first_date) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (class plain (char -) (char %E2%80%93) (char %E2%80%94) (char %E2%88%92)) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (ref last_date)))
