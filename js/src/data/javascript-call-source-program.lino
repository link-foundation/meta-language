(18450: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Shared%20exact%20UTF-8%20transport%3A%20invalid%20input%20is%20the%20column%20%5B-1%5D%3B%20all%0A%2F%2F%20actual%20UTF-16%20units%20are%20nonnegative%2C%20so%20empty%20text%20remains%20unambiguous.%0A%2F%2A%2A%20UTF-8%20transport%20for%20targets%20whose%20string%20value%20is%20a%20byte%20sequence.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20bytes%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20readJavaScriptUtf8StringUnits%28bytes%29%20%7B%0A%20%20for%28let%20index%3D0%3Bindex%3Cbytes.length%3Bindex%2B%3D1%29%7B%0A%20%20%20%20const%20unit%3Dbytes%5Bindex%5D%3F%3F%20-1%3B%0A%20%20%20%20if%28%21Number.isSafeInteger%28unit%29%7C%7Cunit%3C0%7C%7Cunit%3E255%29return%20%5B-1%5D%3B%0A%20%20%7D%0A%20%20const%20units%3D%5B%5D%3B%0A%20%20let%20index%3D0%3B%0A%20%20while%28index%3Cbytes.length%29%7B%0A%20%20%20%20let%20scalar%3Dbytes%5Bindex%5D%3F%3F%20-1%3B%0A%20%20%20%20index%2B%3D1%3B%0A%20%20%20%20let%20remaining%3D0%2Cminimum%3D0%3B%0A%20%20%20%20if%28scalar%3E%3D194%26%26scalar%3C%3D223%29%7Bscalar-%3D192%3Bremaining%3D1%3Bminimum%3D128%3B%7D%0A%20%20%20%20else%20if%28scalar%3E%3D224%26%26scalar%3C%3D239%29%7Bscalar-%3D224%3Bremaining%3D2%3Bminimum%3D2048%3B%7D%0A%20%20%20%20else%20if%28scalar%3E%3D240%26%26scalar%3C%3D244%29%7Bscalar-%3D240%3Bremaining%3D3%3Bminimum%3D65536%3B%7D%0A%20%20%20%20else%20if%28scalar%3E%3D128%29return%20%5B-1%5D%3B%0A%20%20%20%20while%28remaining%3E0%29%7B%0A%20%20%20%20%20%20const%20next%3Dbytes%5Bindex%5D%3F%3F%20-1%3B%0A%20%20%20%20%20%20if%28next%3C128%7C%7Cnext%3E191%29return%20%5B-1%5D%3B%0A%20%20%20%20%20%20scalar%3Dscalar%2A64%2Bnext-128%3Bindex%2B%3D1%3Bremaining-%3D1%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%28scalar%3Cminimum%7C%7Cscalar%3E1114111%7C%7Cscalar%3E%3D55296%26%26scalar%3C%3D57343%29return%20%5B-1%5D%3B%0A%20%20%20%20if%28scalar%3C%3D65535%29units.push%28scalar%29%3B%0A%20%20%20%20else%20%7Bunits.push%2855296%2BMath.floor%28%28scalar