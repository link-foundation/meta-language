(26713: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Source%20exceptions%20are%20typed%20intrinsic%20operations%20in%20the%20existing%20operation%0A%2F%2F%20container.%20The%20historical%20serialized%20container%20tag%20remains%20%60math%60.%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20name%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptSourceExceptionOperation%28name%29%20%7B%0A%20%20if%28name%3D%3D%3D%27Error%27%29return%20%27raiseJavaScriptError%27%3B%0A%20%20if%28name%3D%3D%3D%27TypeError%27%29return%20%27raiseJavaScriptTypeError%27%3B%0A%20%20if%28name%3D%3D%3D%27RangeError%27%29return%20%27raiseJavaScriptRangeError%27%3B%0A%20%20if%28name%3D%3D%3D%27SyntaxError%27%29return%20%27raiseJavaScriptSyntaxError%27%3B%0A%20%20if%28name%3D%3D%3D%27ReferenceError%27%29return%20%27raiseJavaScriptReferenceError%27%3B%0A%20%20if%28name%3D%3D%3D%27URIError%27%29return%20%27raiseJavaScriptURIError%27%3B%0A%20%20return%20name%3D%3D%3D%27EvalError%27%3F%27raiseJavaScriptEvalError%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operation%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptSourceExceptionClass%28operation%29%20%7B%0A%20%20if%28operation%3D%3D%3D%27raiseJavaScriptError%27%29return%20%27Error%27%3B%0A%20%20if%28operation%3D%3D%3D%27raiseJavaScriptTypeError%27%29return%20%27TypeError%27%3B%0A%20%20if%28operation%3D%3D%3D%27raiseJavaScriptRangeError%27%29return%20%27RangeError%27%3B%0A%20%20if%28operation%3D%3D%3D%27raiseJavaScriptSyntaxError%27%29return%20%27SyntaxError%27%3B%0A%20%20if%28operation%3D%3D%3D%27raiseJavaScriptReferenceError%27%29return%20%27ReferenceError%27%3B%0A%20%20if%28operation%3D%3D%3D%27raiseJavaScriptURIError%27%29return%20%27URIError%27%3B%0A%20%20return%20operation%3D%3D%3D%27raiseJavaScriptEvalError%27%3F%27EvalError%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20The%20source%20constructor%20retains%20raw%20arguments%3B%20the%20checked%20raise%20owns%20a%0A%20%2A%20normalized%20message%20and%20its%20independent%20property-presence%20value.%0A%20%2A%20%40param%20%7Bstring%7D%20name%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptExceptionConstructorOperation%28name%29%20%7B%0A%20%20return%20readJavaScriptSourceExceptionOperation%28name%29%3D%3D%3D%27%27%3F%27%27%3A%27constructAndRaiseJavaScript%27%2Bname%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operation%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptExceptionConstructorClass%28operation%29%20%7B%0A%20%20if%28operation%3D%3D%3D%27constructAndRaiseJavaScriptError%27%29return%20%27Error%27%3B%0A%20%20if%28operation%3D%3D%3D%27constructAndRaiseJavaScriptTypeError%27%29return%20%27TypeError%27%3B%0A%20%20if%28operation%3D%3D%3D%27constructAndRaiseJavaScriptRangeError%27%29return%20%27RangeError%27%3B%0A%20%20if%28operation%3D%3D%3D%27constructAndRaiseJavaScriptSyntaxError%27%29return%20%27SyntaxError%27%3B%0A%20%20if%28operation%3D%3D%3D%27constructAndRaiseJavaScriptReferenceError%27%29return%20%27ReferenceError%27%3B%0A%20%20if%28operation%3D%3D%3D%27constructAndRaiseJavaScriptURIError%27%29return%20%27URIError%27%3B%0A%20%20return%20operation%3D%3D%3D%27constructAndRaiseJavaScriptEvalError%27%3F%27EvalError%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bstring%7D%20operation%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptLinkedJavaScriptSourceException%28kind%2Coperation%29%20%7B%0A%20%20return%20kind%3D%3D%3D%27math%27%26%26readJavaScriptSourceExceptionClass%28operation%29%21%3D%3D%27%27%3B%0A%7D%0A%2F%2A%2A%20Error%27s%20undefined%20message%20is%20absent%3B%20its%20null%20message%20is%20the%20text%20%22null%22.%0A%20%2A%20%40param%20%7Bstring%7D%20absence%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptSourceExceptionAbsentMessage%28absence%29%20%7B%0A%20%20return%20absence%3D%3D%3D%27null%27%3F%27null%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptSourceExceptionMessageForm%28kind%29%20%7B%0A%20%20if%28kind%3D%3D%3D%27string%27%29return%20%27identity%27%3B%0A%20%20if%28kind%3D%3D%3D%27unit%27%29return%20%27empty%27%3B%0A%20%20if%28kind%3D%3D%3D%27option%27%29return%20%27optional%27%3B%0A%20%20return%20kind%3D%3D%3D%27bool%27%7C%7Ckind%3D%3D%3D%27float%27%7C%7Ckind%3D%3D%3D%27int%27%7C%7Ckind%3D%3D%3D%27nat%27%3F%27text%27%3A%27unsupported%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20target%20%40param%20%7Bstring%7D%20operation%20%40param%20%7Bstring%7D%20message%20%40param%20%7Bstring%7D%20present%20%40param%20%7Bboolean%7D%20utf16%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20renderJavaScriptSourceExceptionExpression%28target%2Coperation%2Cmessage%2Cpresent%2Cutf16%29%20%7B%0A%20%20const%20name%3DreadJavaScriptSourceExceptionClass%28operation%29%3B%0A%20%20if%28name%3D%3D%3D%27%27%29return%20%27%27%3B%0A%20%20if%28target%3D%3D%3D%27JavaScript%27%29return%20%27%28%28ml_message%2Cml_present%29%3D%3E%7Bthrow%20new%20%27%2Bname%2B%27%28ml_present%3Fml_message%3Aundefined%29%3B%7D%29%28%27%2Bmessage%2B%27%2C%27%2Bpresent%2B%27%29%27%3B%0A%20%20if%28target%3D%3D%3D%27Rust%27%29return%20%27%28crate%3A%3Aml_source_exception%3A%3ASourceException%20%7B%20class_name%3A%20String%3A%3Afrom%28%22%27%2Bname%2B%27%22%29%2C%20message_units%3A%20%27%2B%28utf16%3F%27%28%27%2Bmessage%2B%27%29.0%27%3A%27%28%27%2Bmessage%2B%27%29.encode_utf16%28%29.collect%28%29%27%29%2B%27%2C%20message_present%3A%20%27%2Bpresent%2B%27%20%7D%29.raise%28%29%27%3B%0A%20%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20Legacy%20output%20pairs%20have%20two%20fields%3B%20source%20exceptions%20have%20four.%0A%20%2A%20%40param%20%7Bnumber%7D%20fields%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readSourceExceptionIgnoredPatternFields%28fields%29%7Breturn%20fields%3D%3D%3D4%3F%27%20_%20_%27%3A%27%27%3B%7D%0A%2F%2A%2A%20%40param%20%7Bboolean%7D%20output%20%40param%20%7Bstring%5B%5D%7D%20names%20%40param%20%7Bstring%5B%5D%7D%20kinds%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptSourceExceptionPayloadFields%28output%2Cnames%2Ckinds%29%7B%0A%20return%20output%26%26names.length%3D%3D%3D4%26%26kinds.length%3D%3D%3D4%26%26names%5B0%5D%3D%3D%3D%27output%27%26%26kinds%5B0%5D%3D%3D%3D%27output%27%0A%20%20%26%26names%5B1%5D%3D%3D%3D%27message%27%26%26kinds%5B1%5D%3D%3D%3D%27string%27%26%26names%5B2%5D%3D%3D%3D%27className%27%26%26kinds%5B2%5D%3D%3D%3D%27string%27%0A%20%20%26%26names%5B3%5D%3D%3D%3D%27messagePresent%27%26%26kinds%5B3%5D%3D%3D%3D%27bool%27%3B%0A%7D%0A%2F%2A%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readSourceExceptionObservationStatement%28%29%7B%0A%20return%20%27ml_source_exception_observation%20retains%20the%20source%20exception%20constructor%20class%2C%20exact%20UTF-16%20message%20and%20own-message%20property%20presence%3B%20main%20projects%20the%20display%20message%20at%20its%20ordinary%20process%20boundary%27%3B%0A%7D%0A%2F%2A%2A%20Generic%20output%20append%20preserves%20every%20exception%20component.%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readSourceExceptionRocqOutputPrelude%28%29%7B%0A%20return%20%27Definition%20ml_emit_source_exception%20%7BE%20%3A%20Type%7D%20%28lines%20%3A%20list%20string%29%20%28next%20%3A%20list%20string%20%2A%20option%20E%29%20%3A%20list%20string%20%2A%20option%20E%20%3A%3D%20%28List.app%20lines%20%28fst%20next%29%2C%20snd%20next%29.%27%3B%0A%7D%0A%0A%2F%2A%2A%20Operands%20already%20passed%20ToNumeric%3B%20this%20does%20not%20conflate%20String%20addition%0A%20%2A%20with%20numeric%20addition.%20A%20failing%20operation%20has%20no%20resulting%20value%20domain.%0A%20%2A%20%40param%20%7Bstring%7D%20operation%20%40param%20%7Bstring%7D%20left%20%40param%20%7Bstring%7D%20right%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptNumericOperationFailure%28operation%2Cleft%2Cright%29%7B%0A%20const%20first%3Dleft%3D%3D%3D%27int%27%7C%7Cleft%3D%3D%3D%27nat%27%2Csecond%3Dright%3D%3D%3D%27int%27%7C%7Cright%3D%3D%3D%27nat%27%3B%0A%20if%28first%26%26right%3D%3D%3D%27float%27%7C%7Cleft%3D%3D%3D%27float%27%26%26second%29return%20%27mixed%27%3B%0A%20return%20first%26%26second%26%26operation%3D%3D%3D%27shiftJavaScriptNumberBitsRightUnsigned%27%3F%27unsigned%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20V8%20messages%20use%20the%20fixture%27s%20explicit%20Node%20version%20profile.%0A%20%2A%20%40param%20%7Bstring%7D%20failure%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptNumericOperationMessage%28failure%29%7B%0A%20if%28failure%3D%3D%3D%27mixed%27%29return%20%27Cannot%20mix%20BigInt%20and%20other%20types%2C%20use%20explicit%20conversions%27%3B%0A%20return%20failure%3D%3D%3D%27unsigned%27%3F%27BigInts%20have%20no%20unsigned%20right%20shift%2C%20use%20%3E%3E%20instead%27%3A%27%27%3B%0A%7D%0A) (lang: meta-language%20typed%20program)))
