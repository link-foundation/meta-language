.floor%28%28low%20%2B%20high%29%20%2F%202%29%3B%0A%20%20%20%20const%20symbol%20%3D%20symbols%5Bmiddle%5D%3B%0A%20%20%20%20if%20%28symbol%20%3D%3D%3D%20undefined%29%20return%20false%3B%0A%20%20%20%20if%20%28symbol%20%3D%3D%3D%20identity%29%20return%20true%3B%0A%20%20%20%20if%20%28symbol%20%3C%20identity%29%20low%20%3D%20middle%20%2B%201%3B%0A%20%20%20%20else%20high%20%3D%20middle%3B%0A%20%20%7D%0A%20%20return%20false%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptHeapDirectoryValueError%28heap%2C%20value%29%20%7B%0A%20%20const%20error%20%3D%20readJavaScriptSemanticValueError%28value%29%3B%0A%20%20if%20%28error%20%21%3D%3D%20%27%27%29%20return%20error%3B%0A%20%20if%20%28value.%24%20%3D%3D%3D%20%27symbol%27%29%20return%20testJavaScriptHeapDirectorySymbol%28heap.symbols%2C%20value.identity%29%20%3F%20%27%27%20%3A%20%27a%20semantic%20Symbol%20must%20belong%20to%20the%20complete%20global%20identity%20directory%27%3B%0A%20%20if%20%28value.%24%20%21%3D%3D%20%27object%27%29%20return%20%27%27%3B%0A%20%20const%20at%20%3D%20findJavaScriptHeapDirectoryObject%28heap.objects%2C%20value.identity%29%3B%0A%20%20if%20%28at%20%3C%200%29%20return%20%27a%20semantic%20Object%20must%20belong%20to%20the%20complete%20global%20identity%20directory%27%3B%0A%20%20const%20object%20%3D%20heap.objects%5Bat%5D%3B%0A%20%20return%20object%20%21%3D%3D%20undefined%20%26%26%20object.callable%20%3D%3D%3D%20value.callable%20%3F%20%27%27%20%3A%20%27Object%20callability%20must%20agree%20with%20its%20intrinsic%20global%20identity%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptSemanticValue%7D%20key%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptHeapDirectoryKeyError%28heap%2C%20key%29%20%7B%0A%20%20if%20%28key.%24%20%21%3D%3D%20%27text%27%20%26%26%20key.%24%20%21%3D%3D%20%27sourceT