es%5Bindex%5D%20%3F%3F%20refuseRequiredTextFact%28%29%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bboolean%5B%5D%7D%20values%20%40param%20%7Bnumber%7D%20index%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20readRequiredBooleanFact%28values%2C%20index%29%20%7B%0A%20%20if%20%28index%20%3C%200%20%7C%7C%20index%20%25%201%20%21%3D%3D%200%20%7C%7C%20index%20%3E%3D%20values.length%29%20%7B%0A%20%20%20%20throw%20new%20RangeError%28%27invalid%20required%20Boolean%20fact%20column%20position%27%29%3B%0A%20%20%7D%0A%20%20return%20values%5Bindex%5D%20%3F%3F%20refuseRequiredBooleanFact%28%29%3B%0A%7D%0A%0A%0A%2F%2F%20Ordered%20conditional%20continuations.%20Failure%20contains%20no%20names%20from%20an%20inner%0A%2F%2F%20scope.%20A%20one-field%20product%20distinguishes%20success%20with%20any%20payload%20from%20absence.%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20role%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readConditionalChainOperation%28role%29%7B%0A%20if%28role%3D%3D%3D%27result%27%29return%20%27readConditionalChainResult%27%3B%0A%20if%28role%3D%3D%3D%27success%27%29return%20%27constructConditionalChainSuccess%27%3B%0A%20if%28role%3D%3D%3D%27failure%27%29return%20%27constructConditionalChainFailure%27%3B%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operation%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptConditionalChainOperation%28operation%29%7Breturn%20operation%3D%3D%3DreadConditionalChainOperation%28%27result%27%29%7C%7Coperation%3D%3D%3DreadConditionalChainOperation%28%27success%27%29%7C%7Coperation%3D%3D%3DreadConditionalChainOperation%28%27failure%27%29%3B%7D%0A%2F%2A%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readConditionalChainStageLimit%28%29%7Breturn%20256%3B%7D%0A%2F%2A%2A%20Return%20actual%20let-token%20position%2C%20or%20-1%20when%20the%20existing%20Boolean%20reader%20owns%0A%20%2A%20the%20condition.%20Opaque%20tokens%20and%20balanced%20operand%20groups%20are%20never%20inspected.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20kinds%20%40param%20%7Bstring%5B%5D%7D%20values%20%40param%20%7Bnumber%7D%20start%0A%20%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20findRustConditionalChainPattern%28kinds%2Cvalues%2Cstart%29%7B%0A%20if%28kinds.length%21%3D%3Dvalues.length%7C%7C%21Number.isSafeInteger%28start%29%7C%7Cstart%3C0%29return%20-1%3B%0A%20let%20closes%3D%5B%5D%3B%0A%20for%28let%20at%3Dstart%3Bat%3Ckinds.length%3Bat%2B%3D1%29%7B%0A%20%20const%20kind%3DreadRequiredTextFact%28kinds%2Cat%29%2Cvalue%3DreadRequiredTextFact%28values%2Cat%29%3B%0A%20%20if%28%21closes.length%26%26kind%3D%3D%3D%27identifier%27%26%26value%3D%3D%3D%27let%27%29return%20at%3B%0A%20%20if%28kind%21%3D%3D%27punct%27%29continue%3B%0A%20%20if%28%21closes.length%26%26value%3D%3D%3D%27%7B%27%29return%20-1%3B%0A%20%20if%28value%3D%3D%3D%27%28%27%7C%7Cvalue%3D%3D%3D%27%5B%27%7C%7Cvalue%3D%3D%3D%27%7B%27%29closes%3Dcloses.concat%28%5Bvalue%3D%3D%3D%27%28%27%3F%27%29%27%3Avalue%3D%3D%3D%27%5B%27%3F%27%5D%27%3A%27%7D%27%5D%29%3B%0A%20%20else%20if%28value%3D%3D%3D%27%29%27%7C%7Cvalue%3D%3D%3D%27%5D%27%7C%7Cvalue%3D%3D%3D%27%7D%27%29%7B%0A%20%20%20if%28%21closes.length%7C%7CreadRequiredTextFact%28closes%2Ccloses.length-1%29%21%3D%3Dvalue%29return%20-1%3B%0A%20%20%20closes%3Dcloses.slice%280%2Ccloses.length-1%29%3B%0A%20%20%7D%0A%20%7D%0A%20return%20-1%3B%0A%7D%0A%2F%2A%2A%20Postorder%20layers%20over%20the%20actual%20stages%3A%20zero%20Boolean%2C%20one%20pattern.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20forms%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20planConditionalChainLayers%28forms%29%7B%0A%20if%28forms.length%3C1%7C%7Cforms.length%3EreadConditionalChainStageLimit%28%29%29return%20%5B%5D%3B%0A%20let%20result%3D%5B%5D%2Cat%3Dforms.length%3B%0A%20while%28at%3E0%29%7Bat-%3D1%3Bconst%20form%3DreadRequiredNumberFact%28forms%2Cat%29%3Bif%28form%21%3D%3D0%26%26form%21%3D%3D1%29return%20%5B%5D%3Bresult%3Dresult.concat%28%5Bform%2Cat%5D%29%3B%7D%0A%20return%20result%3B%0A%7D%0A%2F%2A%2A%20Unguarded%20coverage%20arm%20indices%2C%20then%20all%20actual%20arms%20in%20reverse%20order.%0A%20%2A%20A%20guarded%20arm%20never%20discharges%20exhaustiveness%20by%20itself.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20guards%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20planConditionalMatchArms%28guards%29%7B%0A%20if%28guards.length%3C1%7C%7Cguards.length%3EreadConditionalChainStageLimit%28%29%29return%20%5B%5D%3B%0A%20let%20coverage%3D%5B%5D%2Clayers%3D%5B%5D%3B%0A%20for%28let%20at%3D0%3Bat%3Cguards.length%3Bat%2B%3D1%29%7Bconst%20guard%3DreadRequiredNumberFact%28guards%2Cat%29%3Bif%28guard%21%3D%3D0%26%26guard%21%3D%3D1%29return%20%5B%5D%3Bif%28guard%3D%3D%3D0%29coverage%3Dcoverage.concat%28%5Bat%5D%29%3B%7D%0A%20let%20at%3Dguards.length%3Bwhile%28at%3E0%29%7Bat-%3D1%3Blayers%3Dlayers.concat%28%5Bat%5D%29%3B%7D%0A%20return%20%5Bcoverage.length%5D.concat%28coverage%2Clayers%29%3B%0A%7D%0A%0A%0A%2F%2F%20Ordered%20source%20expression%20roles%20for%20ordinary%20Rust%20callable%20completions.%0A%2F%2F%20These%20decisions%20are%20shared%20source%2C%20awaiting%20automatic%20native%20generation.%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bstring%7D%20operation%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustExpressionCompletionForm%28kind%2Coperation%29%7B%0A%20if%28kind%3D%3D%3D%27rustStandardSumTry%27%29return%20%27propagate%27%3B%0A%20if%28kind%3D%3D%3D%27lambda%27%29return%20%27callable%20boundary%27%3B%0A%20if%28kind%3D%3D%3D%27if%27%29return%20%27conditional%27%3B%0A%20if%28kind%3D%3D%3D%27binary%27%26%26%28operation%3D%3D%3D%27and%27%7C%7Coperation%3D%3D%3D%27or%27%29%29return%20%27short%20circuit%27%3B%0A%20if%28kind%3D%3D%3D%27match%27%7C%7Ckind%3D%3D%3D%27match1%27%29return%20%27match%27%3B%0A%20if%28kind%3D%3D%3D%27let%27%29return%20%27binding%27%3B%0A%20if%28kind%3D%3D%3D%27print%27%29return%20%27print%27%3B%0A%20if%28kind%3D%3D%3D%27math%27%26%26operation%3D%3D%3D%27