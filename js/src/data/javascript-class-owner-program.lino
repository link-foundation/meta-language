or%20%3D%20readRecordFieldWriteOperator%28operation%29%3B%0A%20%20return%20operator%20%3D%3D%3D%20%27%27%20%3F%20%27%27%20%3A%20operation.slice%2817%20%2B%20operator.length%29%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operator%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRecordFieldWriteArgumentCount%28operator%29%20%7B%0A%20%20return%20operator%20%3D%3D%3D%20%27%2B%2B%27%20%7C%7C%20operator%20%3D%3D%3D%20%27--%27%20%3F%200%20%3A%201%3B%0A%7D%0A%2F%2A%2A%20Conservative%20text%20reservation%20also%20protects%20nested%20generated%20operands.%0A%20%2A%20%40param%20%7Bnumber%7D%20initial%20%40param%20%7Bstring%7D%20receiver%20%40param%20%7Bstring%5B%5D%7D%20arguments_%0A%20%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRecordFieldWriteSuffix%28initial%2C%20receiver%2C%20arguments_%29%20%7B%0A%20%20const%20text%20%3D%20receiver%20%2B%20%27%20%27%20%2B%20arguments_.join%28%27%20%27%29%3B%0A%20%20let%20suffix%20%3D%20initial%3B%0A%20%20while%20%28text.includes%28%27ml_field_owner%27%20%2B%20suffix%29%20%7C%7C%20text.includes%28%27ml_field_value%27%20%2B%20suffix%29%0A%20%20%20%20%7C%7C%20text.includes%28%27ml_field_previous%27%20%2B%20suffix%29%29%20suffix%20%2B%3D%201%3B%0A%20%20return%20suffix%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20expression%20%40param%20%7Bstring%7D%20operation%20%40param%20%7Bstring%7D%20kind%0A%20%2A%20%40param%20%7Bboolean%7D%20reference%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptLinkedRecordFieldWrite%28expression%2C%20operation%2C%20kind%2C%20reference%29%20%7B%0A%20%20return%20expression%20%3D%3D%3D%20%27method%27%20%26%26%20kind%20%3D%3D%3D%20%27record%27%20%26%26%20reference%20%26%26%20readRecordFieldWriteOperator%28operation%29%20%21%3D%3D%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operator%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20reference%0A%20%2A%20%40param%20%7Bboolean%7D%20open%20%40param%20%7Bboolean%7D%20field%20%40param%20%