0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryProperty%5B%5D%7D%20properties%20%40param%20%7BJavaScriptSemanticValue%7D%20key%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20findJavaScriptArrayProperty%28properties%2Ckey%29%7Breturn%20findJavaScriptHeapDirectoryProperty%28properties%2Ckey%29%3B%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryObject%7D%20object%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readJavaScriptArrayLength%28object%29%7B%0A%20const%20property%3Dobject.properties%5BfindJavaScriptArrayProperty%28object.properties%2CreadJavaScriptArrayLengthKey%28%29%29%5D%3B%0A%20return%20property%3D%3D%3Dundefined%3F-1%3AreadJavaScriptArrayLengthValue%28property.descriptor.value%29%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bnumber%7D%20%2A%2F%0Afunction%20readJavaScriptArrayLengthValue%28value%29%7B%0A%20switch%28value.%24%29%7B%0A%20%20case%20%27number%27%3Areturn%20value.value%3B%0A%20%20default%3Areturn%20-1%3B%0A%20%7D%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20length%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptArrayLength%28length%29%7Breturn%20Number.isInteger%28length%29%26%26length%3E%3D0%26%26length%3C%3D4294967295%26%26%21Object.is%28length%2C-0%29%3B%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryObject%7D%20object%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptArrayObjectError%28object%29%7B%0A%20if%28object.callable%29return%20%27an%20Array%20exotic%20object%20is%20not%20callable%27%3B%0A%20const%20property%3Dobject.properties%5BfindJavaScriptArrayProperty%28object.properties%2CreadJavaScriptArrayLengthKey%28%29%29%5D%3B%0A%20const%20invalid%3D%27an%20Array%20retains%20its%20actual%20nonenumerable%20nonconfigurable%20integral%20length%20data%20property%27%3B%0A%20if%28property%3D%3D%3Dundefined%7C%7C%21property.descriptor.valuePresent%7C%7Cproperty.descriptor.getterPresent%7C%7Cproperty.descriptor.setterPresent%7C%7