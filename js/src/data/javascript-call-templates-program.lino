0A%20%2A%20Functional%20snapshots%20are%20semantic%20states.%20A%20frontend%20must%20keep%20the%20selected%0A%20%2A%20state%20in%20one%20shared%20cell%20so%20all%20aliases%20observe%20the%20same%20transition.%0A%20%2A%20Nominal%20definitions%20keep%20recursive%20source%20types%20shared%20rather%20than%20repeatedly%0A%20%2A%20expanding%20structural%20records%20along%20every%20typed%20expression%20occurrence.%0A%20%2A%20%40typedef%20%7B%7B%24%3A%27ordinaryHeap%27%2Cobjects%3AJavaScriptOrdinaryObject%5B%5D%2Csymbols%3Abigint%5B%5D%2CsymbolRegistrationModel%3F%3Astring%2CsymbolRegistrations%3F%3AJavaScriptSymbolRegistrationFact%5B%5D%2CsymbolRegistryModel%3F%3Astring%2CsymbolRegistry%3F%3AJavaScriptSymbolRegistryEntry%5B%5D%7D%7D%20JavaScriptOrdinaryHeap%0A%20%2A%2F%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryObject%5B%5D%7D%20objects%20%40param%20%7Bbigint%7D%20identity%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20findJavaScriptHeapDirectoryObject%28objects%2C%20identity%29%20%7B%0A%20%20let%20low%20%3D%200%3B%0A%20%20let%20high%20%3D%20objects.length%3B%0A%20%20while%20%28low%20%3C%20high%29%20%7B%0A%20%20%20%20const%20middle%20%3D%20Math.floor%28%28low%20%2B%20high%29%20%2F%202%29%3B%0A%20%20%20%20const%20object%20%3D%20objects%5Bmiddle%5D%3B%0A%20%20%20%20if%20%28object%20%3D%3D%3D%20undefined%29%20return%20-1%3B%0A%20%20%20%20if%20%28object.identity%20%3D%3D%3D%20identity%29%20return%20middle%3B%0A%20%20%20%20if%20%28object.identity%20%3C%20identity%29%20low%20%3D%20middle%20%2B%201%3B%0A%20%20%20%20else%20high%20%3D%20middle%3B%0A%20%20%7D%0A%20%20return%20-1%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bbigint%5B%5D%7D%20symbols%20%40param%20%7Bbigint%7D%20identity%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptHeapDirectorySymbol%28symbols%2C%20identity%29%20%7B%0A%20%20let%20low%20%3D%200%3B%0A%20%20let%20high%20%3D%20symbols.length%3B%0A%20%20while%20%28low%20%3C%20high%29%20%7B%0A%20%20%20%20const%20middle%20%3D%20Math.