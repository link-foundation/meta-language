7Cproperty.descriptor.enumerable%7C%7Cproperty.descriptor.configurable%29return%20invalid%3B%0A%20const%20length%3DreadJavaScriptArrayLengthValue%28property.descriptor.value%29%3B%0A%20if%28%21testJavaScriptArrayLength%28length%29%29return%20invalid%3B%0A%20for%28const%20entry%20of%20object.properties%29%7Bconst%20index%3DreadJavaScriptArrayIndex%28entry.key%29%3Bif%28index%3E%3Dlength%29return%20%27an%20Array%20index%20must%20remain%20below%20its%20actual%20length%27%3B%7D%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bbigint%7D%20identity%20%40param%20%7BJavaScriptSemanticValue%7D%20prototype%20%40param%20%7Bnumber%7D%20length%20%40returns%20%7BJavaScriptOrdinaryObject%7D%20%2A%2F%0Aexport%20function%20constructJavaScriptArrayObject%28identity%2Cprototype%2Clength%29%7B%0A%20const%20descriptor%3DcreateJavaScriptPropertyDescriptor%28%27data%27%2Ctrue%2Cfalse%29%3Bdescriptor.configurable%3Dfalse%3Bdescriptor.writable%3Dtrue%3Bdescriptor.value%3D%7B%24%3A%27number%27%2Cvalue%3Alength%7D%3B%0A%20return%20%7B%24%3A%27arrayObject%27%2Cidentity%2Cprototype%2Cextensible%3Atrue%2Ccallable%3Afalse%2Cproperties%3A%5B%7B%24%3A%27ordinaryProperty%27%2Ckey%3AreadJavaScriptArrayLengthKey%28%29%2Cdescriptor%7D%5D%7D%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryObject%7D%20object%20%40param%20%7BJavaScriptSemanticValue%7D%20key%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20proposed%20%40returns%20%7BJavaScriptArrayPropertyPlan%7D%20%2A%2F%0Aexport%20function%20planJavaScriptArrayOrdinaryDefinition%28object%2Ckey%2Cproposed%29%7B%0A%20const%20at%3DfindJavaScriptArrayProperty%28object.properties%2Ckey%29%2Cproperty%3Dobject.properties%5Bat%5D%2Ccurrent%3Dproperty%3D%3D%3Dundefined%3FcreateJavaScriptPropertyDescriptor%28%27data%27%2Cfalse%2Cfalse%29%3Aproperty.descriptor%3B%0A%20const%20plan%3DplanJavaScriptPropertyDefinition%28property%21%3D%3Dundefined%2Cobject.extensible%2Ccurrent%2Cproposed%29%3B%0A%20if%28plan.disposition%3D%3D%3D%27reject%27%29return%20