0param%20%7Bnumber%7D%20bits%0A%20%2A%20%40param%20%7Bboolean%7D%20signed%20%40param%20%7Bboolean%7D%20sourceSigned%20%40returns%20%7Bstring%7D%0A%20%2A%2F%0Aexport%20function%20renderWrappingFixedIntegerCast%28target%2C%20argument%2C%20bits%2C%20signed%2C%20sourceSigned%29%20%7B%0A%20%20const%20modulus%20%3D%20readFixedIntegerCastModulus%28bits%29%2C%20limit%20%3D%20readFixedIntegerCastSignedLimit%28bits%29%3B%0A%20%20if%20%28modulus%20%3D%3D%3D%20%27%27%29%20return%20%27%27%3B%0A%20%20if%20%28target%20%3D%3D%3D%20%27Rust%27%29%20return%20%27%28%28%27%20%2B%20argument%20%2B%20%27%29%20as%20%27%20%2B%20%28signed%20%3F%20%27i%27%20%3A%20%27u%27%29%20%2B%20bits%20%2B%20%27%29%27%3B%0A%20%20if%20%28target%20%3D%3D%3D%20%27JavaScript%27%29%20return%20%27BigInt.%27%20%2B%20%28signed%20%3F%20%27asIntN%27%20%3A%20%27asUintN%27%29%20%2B%20%27%28%27%20%2B%20bits%20%2B%20%27%2C%20%27%20%2B%20argument%20%2B%20%27%29%27%3B%0A%20%20if%20%28target%20%3D%3D%3D%20%27Lean%27%29%20%7B%0A%20%20%20%20const%20value%20%3D%20sourceSigned%20%3F%20%27%28%27%20%2B%20argument%20%2B%20%27%29%27%20%3A%20%27%28Int.ofNat%20%28%27%20%2B%20argument%20%2B%20%27%29%29%27%3B%0A%20%20%20%20const%20residue%20%3D%20%27%28Int.emod%20%27%20%2B%20value%20%2B%20%27%20%28%27%20%2B%20modulus%20%2B%20%27%20%3A%20Int%29%29%27%3B%0A%20%20%20%20return%20signed%20%3F%20%27%28let%20ml_cast_value%20%3A%20Int%20%3A%3D%20%27%20%2B%20residue%20%2B%20%27%3B%20if%20ml_cast_value%20%3C%20%28%27%20%2B%20limit%0A%20%20%20%20%20%20%2B%20%27%20%3A%20Int%29%20then%20ml_cast_value%20else%20ml_cast_value%20-%20%28%27%20%2B%20modulus%20%2B%20%27%20%3A%20Int%29%29%27%20%3A%20%27%28Int.toNat%20%27%20%2B%20residue%20%2B%20%27%29%27%3B%0A%20%20%7D%0A%20%20if%20%28target%20%3D%3D%3D%20%27Rocq%27%29%20%7B%0A%20%20%20%20const%20value%20%3D%20sourceSigned%20%3F%20%27%28%27%20%2B%20argument%20%2B%20%27%29%27%20%3A%20%27%28Z.of_N%20%28%27%20%2B%20argument%20%2B%20%27%29%29%27%3B%0A%20%20%20%20const%20residue%20%3D%20%27%28Z.modulo%20%27%20%2B%20value%20%2B%20%27%20%28%27%20%2B%20modulus%20%2B%20%27%25Z%29%29%27%3B%0A%20%20%20%20return%20signed%20%3F%20%27%28let%20ml_cast_value%20%3A%20Z%20%3A%3D%20%27%20%2B%20residue%20%2B%20%27%20in%20if%20Z.ltb%20ml_cast_value%20%28%27%20%2B%20limit%0A%20%20%20%20%20%20%2B%20%27%25Z%29%20then%20ml_cast_value%20else%20Z.sub%20ml_cast_value%20%28%27%20%2B%20modulus%20%2B%20%27%25Z%29%29%27%20%3A%20%27%28Z.to_N%20%27%20%2B%20residue%20%2B%20%27%29%27%3B%0A%20%20%7D%0A%20%20return%20%27%27%3B%0A%7D%0A%0A%0A%0A%2F%2F%20JavaScript%20constant%20widths%20specialize%20the%20existing%20complete%20modular%20plan.%0A%2F%2F%20This%20does%20not%20admit%20new%20Rust%20primitive%20integer%20types.%0A%0A%0A%2F%2A%2A%20ToIndex%20on%20the%20represented%20constant%20Number%2C%20with%20a%20separate%20construction%0A%20%2A%20profile.%20Unsupported%20widths%20refuse%20rather%20than%20receiving%20a%20fake%20result.%0A%20%2A%20%40param%20%7Bnumber%7D%20bits%20%40param%20%7Bboolean%7D%20signed%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%0Aexport%20function%20planJavaScriptFixedIntegerCastExpression%28bits%2Csigned%29%7B%0A%20const%20width%3DNumber.isNaN%28bits%29%3F0%3AMath.trunc%28bits%29%3B%0A%20if%28%21Number.isFinite%28width%29%7C%7Cwidth%3C0%7C%7Cwidth%3E4096%29return%20%5B%5D%3B%0A%20let%20modulus%3D1n%3B%0A%20for%28let%20index%3D0%3Bindex%3Cwidth%3Bindex%2B%3D1%29modulus%2A%3D2n%3B%0A%20const%20modulusText%3DString%28modulus%29%2ClimitText%3DString%28modulus%2F2n%29%3B%0A%20const%20plan%3DplanFixedIntegerCastExpression%288%2Csigned%26%26width%21%3D%3D0%29%3B%0A%20return%20plan.map%28%28cell%2Cindex%29%3D%3Eindex%255%3D%3D%3D1%26%26plan%5Bindex-1%5D%3D%3D%3D%27integer%27%3F%28cell%3D%3D%3D%27256%27%3FmodulusText%3Acell%3D%3D%3D%27128%27%3FlimitText%3Acell%29%3Acell%29%3B%0A%7D%0A%0A%2F%2A%2A%20Capture%20the%20value%20and%20ignored%20operands%20before%20the%20modular%20operation.%0A%20%2A%20Width%20syntax%20is%20separately%20restricted%20to%20a%20pure%20Number%20constant.%0A%20%2A%20The%20preceding%20two-argument%20construction%20keeps%20its%20original%20surface%20shape.%0A%20%2A%20%40param%20%7Bnumber%7D%20count%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20planJavaScriptFixedIntegerArguments%28count%29%7B%0A%20if%28%21Number.isInteger%28count%29%7C%7Ccount%3C3%7C%7Ccount%3E4096%29return%20%5B%5D%3B%0A%20%2F%2A%2A%20%40type%20%7Bnumber%5B%5D%7D%20%2A%2F%20const%20coordinates%3D%5B%5D%3B%0A%20for%28let%20index%3D1%3Bindex%3Ccount%3Bindex%2B%3D1%29coordinates.push%28index%29%3B%0A%20return%20coordinates%3B%0A%7D%0A) (lang: meta-language%20typed%20program)))
