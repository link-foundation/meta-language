(grammar (start ASCII_DIGIT))
(rule ASCII_DIGIT silent (class plain (range 0 9)))
(rule ASCII_NONZERO_DIGIT silent (class plain (range 1 9)))
(rule ASCII_BIN_DIGIT silent (class plain (range 0 1)))
(rule ASCII_OCT_DIGIT silent (class plain (range 0 7)))
(rule ASCII_HEX_DIGIT silent (class plain (range 0 9) (range a f) (range A F)))
(rule ASCII_ALPHA_LOWER silent (class plain (range a z)))
(rule ASCII_ALPHA_UPPER silent (class plain (range A Z)))
(rule ASCII_ALPHA silent (class plain (range a z) (range A Z)))
(rule ASCII_ALPHANUMERIC silent (class plain (range 0 9) (range a z) (range A Z)))
(rule ASCII silent (class plain (range %00 %7F)))
(rule NEWLINE silent (choice ordered (literal %0A) (literal %0D%0A) (literal %0D)))
(rule SOI silent (predicate (empty) (atStart)))
(rule EOI silent (not (any)))
