{
  "name": "meta-language",
  "version": "0.58.2",
  "description": "JavaScript implementation of the meta-language links-network core",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check:parity": "node scripts/check-js-rust-parity.mjs",
    "check:parity:manifest": "node scripts/check-js-rust-parity.mjs --manifest-only",
    "check:issue-195": "node scripts/check-issue-195-acceptance.mjs",
    "check:issue-195:sources": "node scripts/check-issue-195-sources.mjs",
    "check:downstream-consumers": "node scripts/check-downstream-consumers.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "dependencies:refresh": "node scripts/check-dependencies.mjs --refresh",
    "check:documentation": "node scripts/check-documentation.mjs",
    "check:default-cst": "node scripts/generate-default-cst-expectations.mjs --check",
    "check:lino-grammar": "node scripts/generate-lino-grammar-cases.mjs --check",
    "check:pdf-grammar": "node scripts/generate-pdf-grammar-cases.mjs --check",
    "check:builtin-cst": "node scripts/generate-builtin-cst-expectations.mjs --check",
    "check:language-catalog": "node scripts/build-language-catalog.mjs --check",
    "check:concept-records": "node scripts/build-concept-records.mjs --check",
    "check:foundations": "node scripts/build-foundation-models.mjs --check",
    "check:issue-195:runtime-parity": "node scripts/check-issue-195-runtime-parity.mjs",
    "acceptance:issue-195": "node scripts/check-issue-195-acceptance.mjs --produce-gate-results issue-195-results/gate-faults.json --evaluate --checkpoint all",
    "acceptance:issue-195:refresh": "node scripts/check-issue-195-acceptance.mjs --refresh-manifest"
  },
  "keywords": [
    "links",
    "language",
    "cst",
    "ast",
    "lino"
  ],
  "license": "Unlicense",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/meta-language.git",
    "directory": "js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "links-notation": "0.22.0",
    "peggy": "5.1.0",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "franc-min": "6.2.0",
    "pdf-lib": "1.17.1",
    "wordnet-db": "3.1.14"
  }
}
