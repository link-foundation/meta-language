{
  "name": "meta-language",
  "version": "0.58.2",
  "description": "JavaScript implementation of the meta-language links-network core",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check:parity": "node scripts/check-js-rust-parity.mjs",
    "check:parity:manifest": "node scripts/check-js-rust-parity.mjs --manifest-only"
  },
  "keywords": [
    "links",
    "language",
    "cst",
    "ast",
    "lino"
  ],
  "license": "Unlicense",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/meta-language.git",
    "directory": "js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@kreuzberg/tree-sitter-language-pack": "1.10.9",
    "links-notation": "0.13.0",
    "peggy": "5.1.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-rocq": "https://github.com/aruzdh/tree-sitter-rocq/archive/300fe33fc299c30f736fd56d8ef8a28b08acd4e6.tar.gz"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-rocq@0.2.0": true
  }
}
