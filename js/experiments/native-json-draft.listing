start document
extra class(char(" "), char("\t"), char("\n"), char("\r"), char("\u000b"), char("\f"))
extra ref(comment)
rule document = normal seq(optional(alias(byte_order_mark, immediateToken(literal("\ufeff")))), repeat0(ref(_value)))
rule _value = silent choice(ref(object), ref(array), ref(number), ref(string), ref(true), ref(false), ref(null))
rule object = normal seq(literal("{"), optional(seq(ref(pair), repeat0(seq(literal(","), ref(pair))))), literal("}"))
rule pair = normal seq(capture("key", ref(string)), literal(":"), capture("value", ref(_value)))
rule array = normal seq(literal("["), optional(seq(ref(_value), repeat0(seq(literal(","), ref(_value))))), literal("]"))
rule string = normal seq(literal("\""), repeat0(choice(alias(string_content, immediateToken(repeat1(notClass(char("\\"), char("\""), char("\n"))))), alias(escape_sequence, immediateToken(seq(literal("\\"), class(char("\""), char("\\"), char("/"), char("b"), char("f"), char("n"), char("r"), char("t"), char("u"))))))), immediateToken(literal("\"")))
rule number = token seq(optional(literal("-")), choice(literal("0"), seq(range("1", "9"), repeat0(range("0", "9")))), optional(seq(literal("."), repeat0(range("0", "9")))), optional(seq(class(char("e"), char("E")), optional(class(char("+"), char("-"))), repeat1(range("0", "9")))))
rule true = token literal("true")
rule false = token literal("false")
rule null = token literal("null")
rule comment = token choice(seq(literal("//"), repeat0(notClass(char("\n")))), seq(literal("/*"), repeat0(choice(notClass(char("*")), seq(literal("*"), not(literal("/"))))), literal("*/")))
