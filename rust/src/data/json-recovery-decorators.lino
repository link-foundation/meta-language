(decorator close-missing-delimiter (level transformation) (order 0) (when (type missing)) (set kind closeOpenContainers) (set action insert))
(decorator discard-incomplete-element (level transformation) (order 0) (when (type error) (region incomplete_first_element)) (set kind closeOpenContainers) (set action remove))
(decorator discard-incomplete-member (level transformation) (order 0) (when (type error) (region incomplete_first_member)) (set kind closeOpenContainers) (set action remove))
(decorator discard-next-incomplete-element (level transformation) (order 0) (when (type error) (region incomplete_next_element)) (set kind closeOpenContainers) (set action remove))
(decorator discard-next-incomplete-member (level transformation) (order 0) (when (type error) (region incomplete_next_member)) (set kind closeOpenContainers) (set action remove))
(decorator drop-trailing-comma (level transformation) (order 0) (when (type error) (region trailing_comma)) (set kind dropTrailingCommas) (set action remove))
(decorator escape-control-character (level transformation) (order 0) (when (type error) (region unescaped_control)) (set kind repairEscapes) (set action escapeControl))
(decorator escape-invalid-backslash (level transformation) (order 0) (when (type error) (region malformed_escape)) (set kind repairEscapes) (set action escapeBackslash))
(decorator extract-fence-separator (level transformation) (order 0) (when (type error) (region fence_separator)) (set kind extractFirstValue) (set action remove))
(decorator extract-leading-fence-region (level transformation) (order 0) (when (type error) (region leading_fence_region)) (set kind extractFirstValue) (set action remove))
(decorator extract-leading-region (level transformation) (order 0) (when (type error) (region leading_region)) (set kind extractFirstValue) (set action remove))
(decorator extract-prose-separator (level transformation) (order 0) (when (type error) (region prose_separator)) (set kind extractFirstValue) (set action remove))
(decorator extract-trailing-region (level transformation) (order 0) (when (type error) (region following_value)) (set kind extractFirstValue) (set action remove))
(decorator strip-closing-fence (level transformation) (order 0) (when (type error) (region closing_fence)) (set kind stripCodeFence) (set action remove))
(decorator strip-opening-fence (level transformation) (order 0) (when (type error) (region opening_fence)) (set kind stripCodeFence) (set action remove))
(decorator strip-trailing-garbage (level transformation) (order 0) (when (type error) (region trailing_region)) (set kind stripTrailingGarbage) (set action remove))
