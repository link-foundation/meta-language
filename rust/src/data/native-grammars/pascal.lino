(rule root normal (optional (choice unordered (ref program) (ref library) (ref unit) (ref definition_list))) (concept grammar.root))
(rule program normal (seq (ref program_header_keyword) (ref module_name) (literal %3B) (optional (ref definition_list)) (alias block (ref trailing_block)) (ref end_dot_keyword)) (concept grammar.program))
(rule library normal (seq (ref library_keyword) (ref module_name) (literal %3B) (optional (ref definition_list)) (choice unordered (alias block (ref trailing_block)) (ref end_keyword)) (ref end_dot_keyword)) (concept grammar.library))
(rule unit normal (seq (ref unit_keyword) (ref module_name) (literal %3B) (repeat0 (choice unordered (ref interface) (ref implementation) (ref initialization) (ref finalization))) (ref end_keyword) (ref end_dot_keyword)) (concept grammar.unit))
(rule interface normal (seq (ref interface_keyword) (optional (ref declaration_list))) (concept grammar.interface))
(rule implementation normal (seq (ref implementation_keyword) (optional (ref definition_list))) (concept grammar.implementation))
(rule initialization normal (seq (ref initialization_keyword) (optional (ref trailing_statement_list_body))) (concept grammar.initialization))
(rule finalization normal (seq (ref finalization_keyword) (optional (ref trailing_statement_list_body))) (concept grammar.finalization))
