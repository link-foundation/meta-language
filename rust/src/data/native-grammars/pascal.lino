(rule while normal (seq (ref while_keyword) (capture labeled condition (ref expression)) (ref do_keyword) (capture labeled body (ref statement_body))) (concept grammar.while))
(rule repeat normal (precedence 2 none (seq (ref repeat_keyword) (capture labeled body (optional (alias statement_list (ref trailing_statement_list)))) (ref termination_condition_keyword) (capture labeled condition (ref expression)) (literal %3B))) (concept grammar.repeat))
(rule for_statement normal (seq (ref for_keyword) (capture labeled start (ref assignment_expression)) (choice unordered (ref to_keyword) (ref down_to_keyword)) (capture labeled end (ref expression)) (ref do_keyword) (capture labeled body (ref statement_body))) (concept grammar.for-statement) (source-names (tree-sitter for)))
