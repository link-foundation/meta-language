(rule trailing_try normal (precedence 2 none (seq (ref try_keyword) (capture labeled try (optional (alias statement_list (ref trailing_statement_list)))) (choice unordered (capture labeled except (seq (ref except_keyword) (optional (choice unordered (alias statement_list (ref trailing_statement_list)) (ref trailing_exception_handler_list))))) (capture labeled finally (seq (ref finally_keyword) (optional (alias statement_list (ref trailing_statement_list)))))) (ref end_keyword))) (concept grammar.trailing-try) (source-names (tree-sitter tryTr)))
