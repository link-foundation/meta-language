(rule exception_handler_list silent (seq (repeat0 (ref exception_handler)) (choice unordered (ref exception_handler) (alias exception_handler (ref trailing_exception_handler))) (optional (ref exception_else_clause))) (concept grammar.exception-handler-list) (source-names (tree-sitter _exceptionHandlers)))
