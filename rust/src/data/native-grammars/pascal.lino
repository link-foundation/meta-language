(rule case_arm normal (seq (capture labeled label (ref case_label)) (capture labeled body (ref statement_body))) (concept grammar.case-arm) (source-names (tree-sitter caseCase)))
(rule case_statement normal (precedence 2 none (seq (ref case_selection_keyword) (ref expression) (ref of_keyword) (repeat0 (ref case_arm)) (optional (alias case_arm (ref trailing_case_case))) (optional (seq (ref else_keyword) (optional (literal %3A)) (optional (ref trailing_statement_list_body)))) (ref end_keyword) (literal %3B))) (concept grammar.case-statement) (source-names (tree-sitter case)))
(rule block normal (seq (ref begin_keyword) (optional (ref trailing_statement_list_body)) (ref end_keyword) (literal %3B)) (concept grammar.block))
