(rule element_value_array_initializer normal (seq (literal %7B) (optional (seq (ref element_value) (repeat0 (seq (literal %2C) (ref element_value))))) (optional (literal %2C)) (literal %7D)) (concept grammar.element-value-array-initializer))
(rule declaration silent (precedence 2 none (choice unordered (ref module_declaration) (ref package_declaration) (ref import_declaration) (ref class_declaration) (ref record_declaration) (ref interface_declaration) (ref annotation_type_declaration) (ref enumeration_declaration))) (concept grammar.declaration))
(rule module_declaration normal (seq (repeat0 (ref annotation_choice)) (optional (token (seq (literal open) (not (ref word_characters))))) (token (seq (literal module) (not (ref word_characters)))) (capture labeled name (ref name)) (capture labeled body (ref module_body))) (concept grammar.module-declaration))
(rule module_body normal (seq (literal %7B) (repeat0 (ref module_directive)) (literal %7D)) (concept grammar.module-body))
(rule module_directive silent (choice unordered (ref requires_module_directive) (ref exports_module_directive) (ref opens_module_directive) (ref uses_module_directive) (ref provides_module_directive)) (concept grammar.module-directive))
(rule requires_module_directive normal (seq (token (seq (literal requires) (not (ref word_characters)))) (repeat0 (capture labeled modifiers (ref requires_modifier))) (capture labeled module (ref name)) (literal %3B)) (concept grammar.requires-module-directive))
(rule requires_modifier normal (choice unordered (token (seq (literal transitive) (not (ref word_characters)))) (token (seq (literal static) (not (ref word_characters))))) (concept grammar.requires-modifier))
(rule exports_module_directive normal (seq (token (seq (literal exports) (not (ref word_characters)))) (capture labeled package (ref name)) (optional (seq (token (seq (literal to) (not (ref word_characters)))) (capture labeled modules (ref name)) (repeat0 (seq (literal %2C) (capture labeled modules (ref name)))))) (literal %3B)) (concept grammar.exports-module-directive))
(rule opens_module_directive normal (seq (token (seq (literal opens) (not (ref word_characters)))) (capture labeled package (ref name)) (optional (seq (token (seq (literal to) (not (ref word_characters)))) (capture labeled modules (ref name)) (repeat0 (seq (literal %2C) (capture labeled modules (ref name)))))) (literal %3B)) (concept grammar.opens-module-directive))
(rule uses_module_directive normal (seq (token (seq (literal uses) (not (ref word_characters)))) (capture labeled type (ref name)) (literal %3B)) (concept grammar.uses-module-directive))
(rule provides_module_directive normal (seq (token (seq (literal provides) (not (ref word_characters)))) (capture labeled provided (ref name)) (token (seq (literal with) (not (ref word_characters)))) (ref name) (repeat0 (seq (literal %2C) (capture labeled provider (ref name)))) (literal %3B)) (concept grammar.provides-module-directive))
(rule package_declaration normal (seq (repeat0 (ref annotation_choice)) (token (seq (literal package) (not (ref word_characters)))) (ref name) (literal %3B)) (concept grammar.package-declaration))
(rule import_declaration normal (seq (token (seq (literal import) (not (ref word_characters)))) (optional (token (seq (literal static) (not (ref word_characters))))) (ref name) (optional (seq (literal .) (ref asterisk))) (literal %3B)) (concept grammar.import-declaration))
(rule asterisk normal (literal %2A) (concept grammar.asterisk))
(rule enumeration_declaration normal (seq (optional (ref modifiers)) (token (seq (literal enum) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled interfaces (optional (ref super_interfaces))) (capture labeled body (ref enumeration_body))) (concept grammar.enumeration-declaration) (source-names (tree-sitter enum_declaration)))
(rule enumeration_body normal (seq (literal %7B) (optional (seq (ref enumeration_constant) (repeat0 (seq (literal %2C) (ref enumeration_constant))))) (optional (literal %2C)) (optional (ref enumeration_body_declarations)) (literal %7D)) (concept grammar.enumeration-body) (source-names (tree-sitter enum_body)))
(rule enumeration_body_declarations normal (seq (literal %3B) (repeat0 (ref class_body_declaration))) (concept grammar.enumeration-body-declarations) (source-names (tree-sitter enum_body_declarations)))
(rule enumeration_constant normal (seq (optional (ref modifiers)) (capture labeled name (ref identifier)) (capture labeled arguments (optional (ref argument_list))) (capture labeled body (optional (ref class_body)))) (concept grammar.enumeration-constant) (source-names (tree-sitter enum_constant)))
(rule class_declaration normal (seq (optional (ref modifiers)) (token (seq (literal class) (not (ref word_characters)))) (capture labeled name (ref identifier)) (optional (capture labeled type_parameters (ref type_parameters))) (optional (capture labeled superclass (ref superclass))) (optional (capture labeled interfaces (ref super_interfaces))) (optional (capture labeled permits (ref permits))) (capture labeled body (ref class_body))) (concept grammar.class-declaration))
(rule modifiers normal (repeat1 (choice unordered (ref annotation_choice) (token (seq (literal public) (not (ref word_characters)))) (token (seq (literal protected) (not (ref word_characters)))) (token (seq (literal private) (not (ref word_characters)))) (token (seq (literal abstract) (not (ref word_characters)))) (token (seq (literal static) (not (ref word_characters)))) (token (seq (literal final) (not (ref word_characters)))) (token (seq (literal strictfp) (not (ref word_characters)))) (token (seq (literal default) (not (ref word_characters)))) (token (seq (literal synchronized) (not (ref word_characters)))) (token (seq (literal native) (not (ref word_characters)))) (token (seq (literal transient) (not (ref word_characters)))) (token (seq (literal volatile) (not (ref word_characters)))) (token (seq (literal sealed) (not (ref word_characters)))) (literal non-sealed))) (concept grammar.modifier-list))
(rule type_parameters normal (seq (literal %3C) (seq (ref type_parameter) (repeat0 (seq (literal %2C) (ref type_parameter)))) (literal %3E)) (concept grammar.type-parameter-list))
(rule type_parameter normal (seq (repeat0 (ref annotation_choice)) (alias type_identifier (ref identifier)) (optional (ref type_bound))) (concept grammar.type-parameter))
(rule type_bound normal (seq (token (seq (literal extends) (not (ref word_characters)))) (ref type) (repeat0 (seq (literal %26) (ref type)))) (concept grammar.type-bound))
(rule superclass normal (seq (token (seq (literal extends) (not (ref word_characters)))) (ref type)) (concept grammar.superclass))
(rule super_interfaces normal (seq (token (seq (literal implements) (not (ref word_characters)))) (ref type_list)) (concept grammar.super-interfaces))
(rule type_list normal (seq (ref type) (repeat0 (seq (literal %2C) (ref type)))) (concept grammar.type-list))
(rule permits normal (seq (token (seq (literal permits) (not (ref word_characters)))) (ref type_list)) (concept grammar.permits))
(rule class_body normal (seq (literal %7B) (repeat0 (ref class_body_declaration)) (literal %7D)) (concept grammar.class-body))
(rule class_body_declaration silent (choice unordered (ref field_declaration) (ref record_declaration) (ref method_declaration) (ref compact_constructor_declaration) (ref class_declaration) (ref interface_declaration) (ref annotation_type_declaration) (ref enumeration_declaration) (ref block) (ref static_initializer) (ref constructor_declaration) (literal %3B)) (concept grammar.class-body-declaration) (source-names (tree-sitter _class_body_declaration)))
(rule static_initializer normal (seq (token (seq (literal static) (not (ref word_characters)))) (ref block)) (concept grammar.static-initializer))
(rule constructor_declaration normal (seq (optional (ref modifiers)) (ref constructor_declarator) (optional (ref throws)) (capture labeled body (ref constructor_body))) (concept grammar.constructor-declaration))
(rule constructor_declarator silent (seq (capture labeled type_parameters (optional (ref type_parameters))) (capture labeled name (ref identifier)) (capture labeled parameters (ref formal_parameters))) (concept grammar.constructor-declarator) (source-names (tree-sitter _constructor_declarator)))
(rule constructor_body normal (seq (literal %7B) (optional (ref explicit_constructor_invocation)) (repeat0 (ref statement)) (literal %7D)) (concept grammar.constructor-body))
(rule explicit_constructor_invocation normal (seq (choice unordered (seq (capture labeled type_arguments (optional (ref type_arguments))) (capture labeled constructor (choice unordered (ref this) (ref super)))) (seq (capture labeled object (ref primary_expression)) (literal .) (capture labeled type_arguments (optional (ref type_arguments))) (capture labeled constructor (ref super)))) (capture labeled arguments (ref argument_list)) (literal %3B)) (concept grammar.explicit-constructor-invocation))
(rule name silent (choice unordered (ref identifier) (ref reserved_identifier) (ref scoped_identifier)) (concept grammar.name) (source-names (tree-sitter _name)))
(rule scoped_identifier normal (seq (capture labeled scope (ref name)) (literal .) (capture labeled name (ref identifier))) (concept grammar.scoped-identifier))
(rule field_declaration normal (seq (optional (ref modifiers)) (capture labeled type (ref unannotated_type)) (ref variable_declarator_list) (literal %3B)) (concept grammar.field-declaration))
(rule record_declaration normal (seq (optional (ref modifiers)) (token (seq (literal record) (not (ref word_characters)))) (capture labeled name (ref identifier)) (optional (capture labeled type_parameters (ref type_parameters))) (capture labeled parameters (ref formal_parameters)) (optional (capture labeled interfaces (ref super_interfaces))) (capture labeled body (ref class_body))) (concept grammar.record-declaration))
(rule annotation_type_declaration normal (seq (optional (ref modifiers)) (literal %40interface) (capture labeled name (ref identifier)) (capture labeled body (ref annotation_type_body))) (concept grammar.annotation-type-declaration))
(rule annotation_type_body normal (seq (literal %7B) (repeat0 (choice unordered (ref annotation_type_element_declaration) (ref constant_declaration) (ref class_declaration) (ref interface_declaration) (ref enumeration_declaration) (ref annotation_type_declaration) (literal %3B))) (literal %7D)) (concept grammar.annotation-type-body))
(rule annotation_type_element_declaration normal (seq (optional (ref modifiers)) (capture labeled type (ref unannotated_type)) (capture labeled name (choice unordered (ref identifier) (ref reserved_identifier))) (literal %28) (literal %29) (capture labeled dimensions (optional (ref dimensions))) (optional (ref default_value)) (literal %3B)) (concept grammar.annotation-type-element-declaration))
(rule default_value silent (seq (token (seq (literal default) (not (ref word_characters)))) (capture labeled value (ref element_value))) (concept grammar.default-value) (source-names (tree-sitter _default_value)))
(rule interface_declaration normal (seq (optional (ref modifiers)) (token (seq (literal interface) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled type_parameters (optional (ref type_parameters))) (optional (ref extends_interfaces)) (optional (capture labeled permits (ref permits))) (capture labeled body (ref interface_body))) (concept grammar.interface-declaration))
(rule extends_interfaces normal (seq (token (seq (literal extends) (not (ref word_characters)))) (ref type_list)) (concept grammar.extends-interfaces))
(rule interface_body normal (seq (literal %7B) (repeat0 (choice unordered (ref constant_declaration) (ref enumeration_declaration) (ref method_declaration) (ref class_declaration) (ref interface_declaration) (ref record_declaration) (ref annotation_type_declaration) (literal %3B))) (literal %7D)) (concept grammar.interface-body))
(rule constant_declaration normal (seq (optional (ref modifiers)) (capture labeled type (ref unannotated_type)) (ref variable_declarator_list) (literal %3B)) (concept grammar.constant-declaration))
(rule variable_declarator_list silent (seq (capture labeled declarator (ref variable_declarator)) (repeat0 (seq (literal %2C) (capture labeled declarator (ref variable_declarator))))) (concept grammar.variable-declarator-list) (source-names (tree-sitter _variable_declarator_list)))
(rule variable_declarator normal (seq (ref variable_declarator_identifier) (optional (seq (literal %3D) (capture labeled value (ref variable_initializer))))) (concept grammar.variable-declarator))
(rule variable_declarator_identifier silent (seq (capture labeled name (choice unordered (ref identifier) (ref reserved_identifier) (ref underscore_pattern))) (capture labeled dimensions (optional (ref dimensions)))) (concept grammar.variable-declarator-identifier) (source-names (tree-sitter _variable_declarator_id)))
(rule variable_initializer silent (choice unordered (ref expression) (ref array_initializer)) (concept grammar.variable-initializer) (source-names (tree-sitter _variable_initializer)))
(rule array_initializer normal (seq (literal %7B) (optional (seq (ref variable_initializer) (repeat0 (seq (literal %2C) (ref variable_initializer))))) (optional (literal %2C)) (literal %7D)) (concept grammar.array-initializer))
(rule type silent (choice unordered (ref unannotated_type) (ref annotated_type)) (concept grammar.type) (source-names (tree-sitter _type)))
(rule unannotated_type silent (choice unordered (ref simple_type) (ref array_type)) (concept grammar.unannotated-type) (source-names (tree-sitter _unannotated_type)))
(rule simple_type silent (choice unordered (ref void_type) (ref integral_type) (ref floating_point_type) (ref boolean_type) (alias type_identifier (ref identifier)) (ref scoped_type_identifier) (ref generic_type)) (concept grammar.simple-type) (source-names (tree-sitter _simple_type)))
(rule annotated_type normal (seq (repeat1 (ref annotation_choice)) (ref unannotated_type)) (concept grammar.annotated-type))
(rule scoped_type_identifier normal (seq (choice unordered (alias type_identifier (ref identifier)) (ref scoped_type_identifier) (ref generic_type)) (literal .) (repeat0 (ref annotation_choice)) (alias type_identifier (ref identifier))) (concept grammar.scoped-type-identifier))
(rule generic_type normal (dynamicPrecedence 10 (seq (choice unordered (alias type_identifier (ref identifier)) (ref scoped_type_identifier)) (ref type_arguments))) (concept grammar.generic-type))
(rule array_type normal (seq (capture labeled element (ref unannotated_type)) (capture labeled dimensions (ref dimensions))) (concept grammar.array-type))
(rule integral_type normal (choice unordered (token (seq (literal byte) (not (ref word_characters)))) (token (seq (literal short) (not (ref word_characters)))) (token (seq (literal int) (not (ref word_characters)))) (token (seq (literal long) (not (ref word_characters)))) (token (seq (literal char) (not (ref word_characters))))) (concept grammar.integral-type))
(rule floating_point_type normal (choice unordered (token (seq (literal float) (not (ref word_characters)))) (token (seq (literal double) (not (ref word_characters))))) (concept grammar.floating-point-type))
(rule boolean_type token (seq (literal boolean) (not (ref word_characters))) (concept grammar.boolean-type))
(rule void_type token (seq (literal void) (not (ref word_characters))) (concept grammar.void-type))
(rule method_header silent (seq (optional (seq (capture labeled type_parameters (ref type_parameters)) (repeat0 (ref annotation_choice)))) (capture labeled type (ref unannotated_type)) (ref method_declarator) (optional (ref throws))) (concept grammar.method-header) (source-names (tree-sitter _method_header)))
(rule method_declarator silent (seq (capture labeled name (choice unordered (ref identifier) (ref reserved_identifier))) (capture labeled parameters (ref formal_parameters)) (capture labeled dimensions (optional (ref dimensions)))) (concept grammar.method-declarator) (source-names (tree-sitter _method_declarator)))
(rule formal_parameters normal (seq (literal %28) (choice unordered (ref receiver_parameter) (seq (optional (seq (ref receiver_parameter) (literal %2C))) (optional (seq (choice unordered (ref formal_parameter) (ref spread_parameter)) (repeat0 (seq (literal %2C) (choice unordered (ref formal_parameter) (ref spread_parameter)))))))) (literal %29)) (concept grammar.formal-parameter-list))
(rule formal_parameter normal (seq (optional (ref modifiers)) (capture labeled type (ref unannotated_type)) (ref variable_declarator_identifier)) (concept grammar.formal-parameter))
(rule receiver_parameter normal (seq (repeat0 (ref annotation_choice)) (ref unannotated_type) (repeat0 (seq (ref identifier) (literal .))) (ref this)) (concept grammar.receiver-parameter))
(rule spread_parameter normal (seq (optional (ref modifiers)) (ref unannotated_type) (literal ...) (repeat0 (ref annotation_choice)) (ref variable_declarator)) (concept grammar.spread-parameter))
(rule throws normal (seq (token (seq (literal throws) (not (ref word_characters)))) (seq (ref type) (repeat0 (seq (literal %2C) (ref type))))) (concept grammar.throws))
(rule local_variable_declaration normal (seq (optional (ref modifiers)) (capture labeled type (ref unannotated_type)) (ref variable_declarator_list) (literal %3B)) (concept grammar.local-variable-declaration))
(rule method_declaration normal (seq (optional (ref modifiers)) (ref method_header) (choice unordered (capture labeled body (ref block)) (literal %3B))) (concept grammar.method-declaration))
(rule compact_constructor_declaration normal (seq (optional (ref modifiers)) (capture labeled name (ref identifier)) (capture labeled body (ref block))) (concept grammar.compact-constructor-declaration))
(rule reserved_identifier silent (choice unordered (precedence -3 none (alias identifier (choice unordered (token (seq (literal open) (not (ref word_characters)))) (token (seq (literal module) (not (ref word_characters)))) (token (seq (literal record) (not (ref word_characters)))) (token (seq (literal with) (not (ref word_characters)))) (token (seq (literal sealed) (not (ref word_characters))))))) (alias identifier (token (seq (literal yield) (not (ref word_characters)))))) (concept grammar.reserved-identifier) (source-names (tree-sitter _reserved_identifier)))
(rule this token (seq (literal this) (not (ref word_characters))) (concept grammar.this))
(rule super token (seq (literal super) (not (ref word_characters))) (concept grammar.super))
