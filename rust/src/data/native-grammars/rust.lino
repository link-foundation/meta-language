(scanner floats (tokens float_literal) (operations (while (next (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))) (do (skip (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))))) (if (not (next (class plain (range 0 9)))) (then fail)) advance (while (next (class plain (range 0 9) (char _))) (do advance)) (if (next (literal .)) (then advance (if (some (next (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo))) (next (literal .))) (then fail)) (while (next (class plain (range 0 9) (char _))) (do advance)) (push float (integer 1)))) mark (if (some (next (literal e)) (next (literal E))) (then advance (if (some (next (literal %2B)) (next (literal -))) (then advance)) (if (not (next (class plain (range 0 9) (char _)))) (then (while (greater (depth float) (integer 0)) (do (pop float))) (emit float_literal))) advance (while (next (class plain (range 0 9) (char _))) (do advance)) mark (push float (integer 1)))) (if (equal (depth float) (integer 0)) (then fail)) (while (greater (depth float) (integer 0)) (do (pop float))) (if (not (some (next (literal u)) (next (literal i)) (next (literal f)))) (then (emit float_literal))) advance (if (not (next (class plain (range 0 9)))) (then (emit float_literal))) (while (next (class plain (range 0 9))) (do advance)) mark (emit float_literal)))
(scanner block_comments (tokens outer_block_documentation_comment_marker inner_block_documentation_comment_marker block_comment_content) (operations (if (valid inner_block_documentation_comment_marker) (then (consume (literal %21)) (if (not (next (literal %2A%2F))) (then (push documentation (integer 1)))) (emit inner_block_documentation_comment_marker))) (if (valid outer_block_documentation_comment_marker) (then (consume (literal %2A)) (if (some (next (literal %2F)) (next (literal %2A))) (then fail)) (push documentation (integer 1)) (emit outer_block_documentation_comment_marker))) (if (valid block_comment_content) (then (if (greater (depth documentation) (integer 0)) (then (pop documentation)) (else (if (some (next (literal %21)) (all (next (literal %2A)) (not (next (literal %2A%2A))))) (then fail)))) (if (next (literal %2A%2F)) (then fail)) (push nesting (integer 1)) (while (greater (depth nesting) (integer 0)) (do (if atEnd (then (while (greater (depth nesting) (integer 0)) (do (pop nesting)))) (else (if (next (literal %2A%2F)) (then (pop nesting) (if (greater (depth nesting) (integer 0)) (then (consume (literal %2A%2F))))) (else (if (next (literal %2F%2A)) (then (consume (literal %2F%2A)) (push nesting (integer 1))) (else advance)))))))) (emit block_comment_content))) fail))
