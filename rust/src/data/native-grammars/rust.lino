(scanner strings (tokens string_content string_close) (operations (if (valid string_content) (then (if (some atEnd (next (literal %22)) (next (literal %5C))) (then fail)) (while (not (some atEnd (next (literal %22)) (next (literal %5C)))) (do advance)) (if atEnd (then fail)) (emit string_content))) (if (valid string_close) (then (consume (literal %22)) (emit string_close))) fail))
