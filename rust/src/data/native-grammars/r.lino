(rule identifier normal (seq (not (token (seq (class plain (char r) (char R)) (class plain (char %22) (char %27))))) (seq (not (token (seq (choice unordered (literal else) (literal if) (literal for) (literal while) (literal repeat) (literal function) (literal next) (literal break) (literal TRUE) (literal FALSE) (literal NULL) (literal Inf) (literal NaN) (literal NA_integer_) (literal NA_real_) (literal NA_complex_) (literal NA_character_) (literal NA)) (not (class plain (range A Z) (range a z) (range 0 9) (char _) (char .) (range %C2%80 %F4%8F%BF%BF)))))) (alias unnamed_token (token (choice unordered (seq (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (char _)) (repeat0 (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (category Mn) (category Mc) (category Nd) (category Pc) (char .)))) (seq (literal .) (optional (seq (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (char .) (char _)) (repeat0 (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (category Mn) (category Mc) (category Nd) (category Pc) (char .)))))) (seq (literal %60) (repeat0 (choice unordered (seq (literal %5C) (choice unordered (class negated (char %0A)) (literal %0A))) (class negated (char %60) (char %5C)))) (literal %60))))))) (concept grammar.identifier))
(rule identifier_form silent (choice unordered (ref variadic_argument) (ref indexed_dots) (ref identifier)) (concept grammar.identifier-form) (source-names (tree-sitter _identifier)))
(rule string_or_identifier silent (choice unordered (ref string) (ref identifier_form)) (concept grammar.string-or-identifier) (source-names (tree-sitter _string_or_identifier)))
(rule argument_name_string_or_identifier_or_null silent (precedence 1 none (choice unordered (ref string_or_identifier) (ref null))) (concept grammar.argument-name-string-or-identifier-or-null) (source-names (tree-sitter _argument_name_string_or_identifier_or_null)))
(rule continue_statement token (seq (literal next) (not (ref word_characters))) (concept grammar.continue-statement) (source-names (tree-sitter next)))
(rule break token (seq (literal break) (not (ref word_characters))) (concept grammar.break))
(rule true token (seq (literal TRUE) (not (ref word_characters))) (concept grammar.true))
(rule false_value token (seq (literal FALSE) (not (ref word_characters))) (concept grammar.false-value) (source-names (tree-sitter false)))
(rule null token (seq (literal NULL) (not (ref word_characters))) (concept grammar.null))
(rule infinity_literal token (seq (literal Inf) (not (ref word_characters))) (concept grammar.infinity-literal) (source-names (tree-sitter inf)))
(rule not_a_number_literal token (seq (literal NaN) (not (ref word_characters))) (concept grammar.not-a-number-literal) (source-names (tree-sitter nan)))
(rule missing_value_literal normal (choice unordered (token (seq (literal NA) (not (ref word_characters)))) (token (seq (literal NA_integer_) (not (ref word_characters)))) (token (seq (literal NA_real_) (not (ref word_characters)))) (token (seq (literal NA_complex_) (not (ref word_characters)))) (token (seq (literal NA_character_) (not (ref word_characters))))) (concept grammar.missing-value-literal) (source-names (tree-sitter na)))
(rule expression silent (choice unordered (ref function_definition) (ref if_statement) (ref for_statement) (ref while_statement) (ref repeat_statement) (ref braced_expression) (ref parenthesized_expression) (ref call) (ref subset) (ref element_subset) (ref unary_operator) (ref binary_operator) (ref extract_operator) (ref namespace_operator) (ref integer_literal) (ref complex) (ref float) (ref string) (ref identifier) (ref variadic_argument) (ref indexed_dots) (ref continue_statement) (ref break) (ref true) (ref false_value) (ref null) (ref infinity_literal) (ref not_a_number_literal) (ref missing_value_literal)) (concept grammar.expression) (source-names (tree-sitter _expression)))
(rule comment token (lexicalPrecedence -1 (seq (literal %23) (repeat0 (class negated (char %0D) (char %0A))))) (concept grammar.comment))
(rule comma token (literal %2C) (concept grammar.comma))
(rule else_keyword silent (alias %27else (immediateToken (ref external_else))) (concept grammar.else-keyword) (source-names (tree-sitter _else)))
(rule open_parenthesis silent (alias %27%28 (immediateToken (ref external_open_parenthesis))) (concept grammar.open-parenthesis) (source-names (tree-sitter _open_parenthesis)))
(rule close_parenthesis silent (alias %27%29 (immediateToken (ref external_close_parenthesis))) (concept grammar.close-parenthesis) (source-names (tree-sitter _close_parenthesis)))
(rule open_brace silent (alias %27%7B (immediateToken (ref external_open_brace))) (concept grammar.open-brace) (source-names (tree-sitter _open_brace)))
(rule close_brace silent (alias %27%7D (immediateToken (ref external_close_brace))) (concept grammar.close-brace) (source-names (tree-sitter _close_brace)))
(rule open_bracket silent (alias %27%5B (immediateToken (ref external_open_bracket))) (concept grammar.open-bracket) (source-names (tree-sitter _open_bracket)))
(rule close_bracket silent (alias %27%5D (immediateToken (ref external_close_bracket))) (concept grammar.close-bracket) (source-names (tree-sitter _close_bracket)))
(rule open_double_bracket silent (alias %27%5B%5B (immediateToken (ref external_open_double_bracket))) (concept grammar.open-double-bracket) (source-names (tree-sitter _open_bracket2)))
(rule close_double_bracket silent (alias %27%5D%5D (immediateToken (ref external_close_double_bracket))) (concept grammar.close-double-bracket) (source-names (tree-sitter _close_bracket2)))
(rule word_characters token (choice unordered (seq (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (char _)) (repeat0 (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (category Mn) (category Mc) (category Nd) (category Pc) (char .)))) (seq (literal .) (optional (seq (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (char .) (char _)) (repeat0 (class plain (category Lu) (category Ll) (category Lt) (category Lm) (category Lo) (category Nl) (category Mn) (category Mc) (category Nd) (category Pc) (char .)))))) (seq (literal %60) (repeat0 (choice unordered (seq (literal %5C) (choice unordered (class negated (char %0A)) (literal %0A))) (class negated (char %60) (char %5C)))) (literal %60))) (concept grammar.word-characters))
