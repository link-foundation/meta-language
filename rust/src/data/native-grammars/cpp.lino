(grammar (start translation_unit) (matching longest) (settling tokens precedence dynamic ambiguity))
(extra (choice unordered (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)) (seq (literal %5C) (optional (literal %0D)) (literal %0A))))
(extra (ref comment))
(conflict type_specifier declarator)
(conflict type_specifier expression)
(conflict sized_type_specifier)
(conflict attributed_statement)
(conflict declaration_modifiers attributed_statement)
(conflict top_level_item top_level_statement)
(conflict block_item statement)
(conflict type_qualifier extension_expression)
(conflict template_function template_type)
(conflict template_function template_type expression)
(conflict template_function template_type qualified_identifier)
(conflict template_type qualified_type_identifier)
(conflict qualified_type_identifier qualified_identifier)
(conflict comma_expression initializer_list)
(conflict expression declarator)
(conflict expression structured_binding_declarator)
(conflict expression declarator type_specifier)
(conflict expression identifier_parameter_pack_expansion)
(conflict expression lambda_capture_identifier)
(conflict expression lambda_capture)
(conflict expression structured_binding_declarator lambda_capture_identifier)
(conflict structured_binding_declarator lambda_capture_identifier)
(conflict parameter_list argument_list)
(conflict type_specifier call_expression)
(conflict declaration_specifiers constructor_specifiers)
(conflict binary_fold_operator fold_operator)
(conflict function_declarator_sequence)
(conflict type_specifier sized_type_specifier)
(conflict initializer_pair comma_expression)
(conflict expression_statement for_statement_body)
(conflict initialized_statement for_statement_body)
(conflict field_expression template_method template_type)
(conflict qualified_field_identifier template_method template_type)
(precedences (rule argument_list) (rule type_qualifier))
(precedences (rule expression_not_binary) (rule class_name))
