(94450: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Standard%20Ord%20on%20the%20admitted%20closed%20primitive%20domains.%20Rust%20str%20order%20is%0A%2F%2F%20unsigned%20UTF8%20byte%20order%2C%20which%20agrees%20with%20Unicode%20scalar%20order%20on%20valid%0A%2F%2F%20scalar%20text.%20Comparing%20UTF16%20code%20units%20would%20put%20astral%20values%20incorrectly.%0Aimport%20%7BreadRequiredNumberFact%7D%20from%20%27.%2Ffact-column-rules.js%27%3B%0A%2F%2A%2A%20Operands%20have%20already%20passed%20the%20same%20closed-domain%20scalar%20validator.%0A%20%2A%20%40param%20%7BRustStandardCollectionScalar%7D%20left%20%40param%20%7BRustStandardCollectionScalar%7D%20right%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareRustStandardCollectionScalars%28left%2Cright%29%7B%0A%20if%28left.%24%3D%3D%3D%27rustCollectionBoolean%27%29%7B%0A%20%20if%28right.%24%3D%3D%3D%27rustCollectionBoolean%27%29return%20left.value%3D%3D%3Dright.value%3F0%3Aleft.value%3F1%3A-1%3B%0A%20%20return%200%3B%0A%20%7D%0A%20if%28left.%24%3D%3D%3D%27rustCollectionInteger%27%29%7B%0A%20%20if%28right.%24%3D%3D%3D%27rustCollectionInteger%27%29return%20left.value%3D%3D%3Dright.value%3F0%3Aleft.value%3Cright.value%3F-1%3A1%3B%0A%20%20return%200%3B%0A%20%7D%0A%20if%28left.%24%21%3D%3D%27rustCollectionString%27%29return%200%3B%0A%20if%28right.%24%21%3D%3D%27rustCollectionString%27%29return%200%3B%0A%20return%20compareRustStandardCollectionTextUnits%28left.units%2Cright.units%29%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20left%20%40param%20%7Bnumber%5B%5D%7D%20right%20%40returns%20%7Bnumber%7D%20%2A%2F%0Afunction%20compareRustStandardCollectionTextUnits%28left%2Cright%29%7B%0A%20let%20first%3D0%2Csecond%3D0%3B%0A%20while%28first%3Cleft.length%26%26second%3Cright.length%29%7B%0A%20%20const%20firstUnit%3DreadRequiredNumberFact%28left%2Cfirst%29%2CsecondUnit%3DreadRequiredNumberFact%28right%2Csecond%29%3B%0A%20%20const%20firstPair%3DfirstUnit%3E%3D55296%26%26firstUnit%3C%3D