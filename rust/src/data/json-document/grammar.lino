(grammar (start document))
(extra (class plain (char %20) (char %09) (char %0A) (char %0D)))
(rule document normal (ref value))
(rule value silent (choice ordered (ref object) (ref array) (ref string) (ref number) (ref true) (ref false) (ref null)))
(rule object normal (seq (literal %7B) (optional (seq (ref pair) (repeat0 (seq (literal %2C) (ref pair))))) (literal %7D)))
(rule pair normal (seq (capture labeled key (ref string)) (literal %3A) (capture labeled value (ref value))))
(rule array normal (seq (literal %5B) (optional (seq (ref value) (repeat0 (seq (literal %2C) (ref value))))) (literal %5D)))
(rule string normal (seq (literal %22) (repeat0 (choice ordered (alias string_content (immediateToken (repeat1 (class negated (char %5C) (char %22) (range %00 %1F))))) (alias escape_sequence (immediateToken (seq (literal %5C) (choice ordered (class plain (char %22) (char %5C) (char %2F) (char b) (char f) (char n) (char r) (char t)) (seq (literal u) (repeat 4 4 (class plain (range 0 9) (range a f) (range A F)))))))))) (immediateToken (literal %22))))
(rule number token (seq (optional (literal -)) (choice ordered (literal 0) (seq (range 1 9) (repeat0 (range 0 9)))) (optional (seq (literal .) (repeat1 (range 0 9)))) (optional (seq (class plain (char e) (char E)) (optional (class plain (char %2B) (char -))) (repeat1 (range 0 9))))))
(rule true token (literal true))
(rule false token (literal false))
(rule null token (literal null))
