(85517: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Source%20draft%20consumed%20by%20the%20ordinary%20JavaScript%20alias%20frontend.%0A%2F%2F%20These%20decisions%20consume%20actual%20token%2Fbinding%20facts%3B%20they%20never%20substitute%0A%2F%2F%20source%20spellings%20or%20manufacture%20a%20source%20type%20owner.%0Aimport%20%7BreadRequiredTextFact%2CreadRequiredBooleanFact%7D%20from%20%27.%2Ffact-column-rules.js%27%3B%0Aimport%20%7BreadRustTypeAliasExpansionError%2CacceptRustTypeAliasEmptyVectorMember%7D%20from%20%27.%2Frust-type-alias-rules.js%27%3B%0Aimport%20%7BacceptRustSourceSignaturePrimitive%7D%20from%20%27.%2Frust-source-signature-rules.js%27%3B%0Aimport%20%7BreadRustStandardSumSourceArgumentCount%2CreadRustStandardSumSourceDepthLimit%2CreadRustStandardSumSourceConstructorArity%7D%20from%20%27.%2Frust-standard-sum-source-rules.js%27%3B%0Aimport%20%7BacceptRustSourceArrayOwner%2CacceptRustSourceArrayElement%7D%20from%20%27.%2Frust-array-rules.js%27%3B%0Aimport%20%7BreadRustTypeClosingTokenParts%7D%20from%20%27.%2Frust-type-token-rules.js%27%3B%0Aimport%20%7BreadRustFunctionPointerTypeError%2CreadRustFunctionPointerHeaderTypeError%2CreadRustFunctionPointerParameterLimit%2CreadRustFunctionPointerOwnedDomainError%2CacceptRustFunctionPointerSafeSource%7D%20from%20%27.%2Frust-function-pointer-rules.js%27%3B%0Aimport%20%7BacceptRustRetainedFunctionOwner%7D%20from%20%27.%2Frust-source-owner-retention-rules.js%27%3B%0A%0A%2F%2A%2A%20Restrict%20this%20first%20declaration%20profile%20to%20explicit%2C%20unconstrained%20type%0A%20%2A%20parameters.%20Raw%20spelling%20remains%20necessary%20to%20distinguish%20r%23gen%20from%20gen.%0A%20%2A%20This%20is%20a%20token-column%20policy%2C%20not%20a%20lexer%20or%20a%20Rust%20identifier%20validator.%0A%20%2A%20%40param%20%7Bstring%7D%20name%20%40param%20%7Bstring%7D%20raw%20%40returns%20%7Bboolean%7D%20%2A%2F%0Afunction%20acceptParameterName%28name%2Craw%29%7B%0A%20if%28name%3D%3D%3D%27%27%7C%7Cname%3D%3D%3D%27_%27%7C%7C%5B%27Self%27%2C%27self%27%2C%27super%27%2C%27crate%27%5D.includes%28name%29%29return%20false%3B%0A%20%2F%2F%20The%20actual%20Rust%20lexer%20has%20already%20validated%20the%20identifier%20and%20normalized%0A%20%2F%2F%20its%20value%20to%20NFC.%20Original%20raw%20bytes%20can%20therefore%20differ%20from%20that%20value.%0A%20%2F%2F%20Only%20the%20source%20raw-prefix%20distinction%20belongs%20to%20this%20parameter%20policy.%0A%20if%28raw.startsWith%28%27r%23%27%29%29return%20true%3B%0A%20if%28raw%3D%3D%3D%27%27%29return%20false%3B%0A%20return%20%21%5B%27as%27%2C%27async%27%2C%27await%27%2C%27break%27%2C%27const%27%2C%27continue%27%2C%27dyn%27%2C%27else%27%2C%27enum%27%2C%27extern%27%2C%27false%27%2C%27fn%27%2C%27for%27%2C%27if%27%2C%27impl%27%2C%27in%27%2C%27let%27%2C%27loop%27%2C%27match%27%2C%27mod%27%2C%27move%27%2C%27mut%27%2C%27pub%27%2C%27ref%27%2C%27return%27%2C%27static%27%2C%27struct%27%2C%27trait%27%2C%27true%27%2C%27type%27%2C%27unsafe%27%2C%27use%27%2C%27where%27%2C%27while%27%2C%27abstract%27%2C%27become%27%2C%27box%27%2C%27do%27%2C%27final%27%2C%27gen%27%2C%27macro%27%2C%27override%27%2C%27priv%27%2C%27try%27%2C%27typeof%27%2C%27unsized%27%2C%27virtual%27%2C%27yield%27%5D.includes%28name%29%3B%0A%7D%0A%0A%2F%2A%2A%20Read%20only%20the%20%3CT%2CU%3E%20portion%20of%20an%20already%20discovered%20actual%20alias%20item.%0A%20%2A%20Success%3A%20parameters%2C%20closing%20token%20index%2C%20unconsumed%20punctuation%2C%20names.%0A%20%2A%20The%20caller%20partitions%20the%20actual%20closing%20token%20with%20the%20existing%20token%20rule%3B%0A%20%2A%20%3E%3D%20therefore%20retains%20its%20%3D%20and%20original%20source%20offsets.%20No%20cursor%20mutates.%0A%20%2A%20Parameter%20limits%20are%20explicit%20proposed%20bounds%20for%20this%20source%20draft%20profile.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20kinds%20%40param%20%7Bstring%5B%5D%7D%20values%20%40param%20%7Bstring%5B%5D%7D%20raws%0A%20%2A%20%40param%20%7Bnumber%7D%20position%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%0Aexport%20function%20readRustGenericTypeAliasParameterPlan%28kinds%2Cvalues%2Craws%2Cposition%29%7B%0A%20if%28kinds.length%21%3D%3Dvalues.length%7C%7Craws.length%21%3D%3Dvalues.length%29return%20%5B%27error%27%2C%27unaligned%20generic%20alias%20token%20columns%27%5D%3B%0A%20if%28position%3C0%7C%7Cposition%251%21%3D%3D0%7C%7Cposition%3E%3Dvalues.length%29return%20%5B%27error%27%2C%27missing%20generic%20alias%20parameter%20list%27%5D%3B%0A%20if%28readRequiredTextFact%28kinds%2Cposition%29%21%3D%3D%27punct%27%7C%7CreadRequiredTextFact%28values%2Cposition%29%21%3D%3D%27%3C%27%29return%20%5B%27error%27%2C%27missing%20generic%20alias%20parameter%20list%27%5D%3B%0A%20const%20names%3D%5B%5D%3Blet%20at%3Dposition%2B1%3B%0A%20while%28at%3Cvalues.length%29%7B%0A%20%20const%20name%3DreadRequiredTextFact%28values%2Cat%29%3B%0A%20%20if%28readRequiredTextFact%28kinds%2Cat%29%21%3D%3D%27identifier%27%7C%7C%21acceptParameterName%28name%2CreadRequiredTextFact%28raws%2Cat%29%29%29return%20%5B%27error%27%2C%27generic%20alias%20needs%20explicit%20unconstrained%20type%20parameters%27%5D%3B%0A%20%20if%28names.includes%28name%29%29return%20%5B%27error%27%2C%27duplicate%20generic%20alias%20type%20parameter%27%5D%3B%0A%20%20if%28names.length%3E%3D64%29return%20%5B%27error%27%2C%27generic%20alias%20parameter%20limit%20exceeded%27%5D%3B%0A%20%20names.push%28name%29%3Bat%2B%3D1%3B%0A%20%20if%28at%3E%3Dvalues.length%29return%20%5B%27error%27%2C%27unclosed%20generic%20alias%20parameter%20list%27%5D%3B%0A%20%20let%20punctuation%3DreadRequiredTextFact%28values%2Cat%29%3B%0A%20%20if%28readRequiredTextFact%28kinds%2Cat%29%21%3D%3D%27punct%27%29return%20%5B%27error%27%2C%27generic%20alias%20parameter%20bounds%20and%20defaults%20need%20their%20complete%20interpretation%27%5D%3B%0A%20%20if%28punctuation%3D%3D%3D%27%2C%27%29%7B%0A%20%20%20at%2B%3D1%3B%0A%20%20%20if%28at%3E%3Dvalues.length%29return%20%5B%27error%27%2C%27unclosed%20generic%20alias%20parameter%20list%27%5D%3B%0A%20%20%20punct