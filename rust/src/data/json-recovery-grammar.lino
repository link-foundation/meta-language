(grammar (start document) (matching peg))
(rule document normal (seq (ref whitespace) (ref value) (ref whitespace) (optional (ref trailing_region)) (ref end_of_input)))
(rule prose_document normal (seq (ref whitespace) (ref leading_region) (optional (ref prose_separator)) (ref whitespace) (ref value) (ref whitespace) (optional (ref trailing_region)) (ref end_of_input)))
(rule fenced_document normal (seq (ref whitespace) (ref fenced_region) (ref end_of_input)))
(rule prose_fenced_document normal (seq (ref whitespace) (ref leading_fence_region) (ref fence_separator) (ref horizontal_space) (ref fenced_region) (ref end_of_input)))
(rule fenced_region normal (seq (ref opening_fence) (ref fenced_body) (optional (seq (ref closing_fence) (ref whitespace) (optional (ref trailing_region))))))
(rule leading_fence_region normal (recover (ref never) (seq (literal %0A) (ref horizontal_space) (ref fence_line))))
(rule fence_separator normal (seq (and (literal %0A)) (recover (ref never) empty)))
(rule fenced_body normal (optional (token (repeat1 (seq (not (ref fence_footer)) any)))))
(rule closing_fence normal (seq (and (ref fence_footer)) (optional (seq (and (literal %0D)) (recover (ref never) empty))) (recover (ref never) empty) (recover (ref never) (ref end_of_line)) (optional (seq (and (literal %0A)) (recover (ref never) empty)))))
(rule fence_footer silent (seq (optional (literal %0D)) (literal %0A) (ref horizontal_space) (ref fence_marker) (ref horizontal_space) (optional (literal %0D)) (ref end_of_line)))
(rule end_of_line silent (choice ordered (and (literal %0A)) (ref end_of_input)))
(rule leading_region normal (recover (ref never) (ref prose_boundary)))
(rule prose_boundary silent (choice ordered (seq (and (class plain (char %7B) (char %5B))) (ref value)) (ref scalar_boundary)))
(rule scalar_boundary silent (seq (class plain (char %3A) (char %0A)) (ref whitespace) (choice ordered (literal %22) (ref number) (ref true) (ref false) (ref null))))
(rule prose_separator normal (seq (and (ref scalar_boundary)) (recover (ref never) empty)))
(rule trailing_region normal (recover (ref never) (ref end_of_input)))
(rule opening_fence normal (seq (and (ref fence_line)) (recover (ref never) (literal %0A)) (recover (ref never) empty)))
(rule fence_line silent (seq (ref fence_marker) (ref horizontal_space) (optional (literalInsensitive json)) (ref horizontal_space) (optional (literal %0D)) (literal %0A)))
(rule fence_marker silent (choice ordered (seq (literal %60%60%60) (repeat0 (literal %60))) (seq (literal %7E%7E%7E) (repeat0 (literal %7E)))))
(rule value silent (choice ordered (ref object) (ref array) (ref string) (ref number) (ref true) (ref false) (ref null)))
(rule object normal (seq (literal %7B) (ref whitespace) (optional (choice ordered (seq (ref member) (ref whitespace) (repeat0 (seq (literal %2C) (ref whitespace) (ref member) (ref whitespace))) (optional (choice ordered (ref trailing_comma) (ref incomplete_next_member)))) (ref incomplete_first_member))) (choice ordered (literal %7D) (seq (ref end_of_input) (missing (literal %7D))))))
(rule member normal (seq (ref string) (ref whitespace) (literal %3A) (ref whitespace) (ref value)))
(rule array normal (seq (literal %5B) (ref whitespace) (optional (choice ordered (seq (ref value) (ref whitespace) (repeat0 (seq (literal %2C) (ref whitespace) (ref value) (ref whitespace))) (optional (choice ordered (ref trailing_comma) (ref incomplete_next_element)))) (ref incomplete_first_element))) (choice ordered (literal %5D) (seq (ref end_of_input) (missing (literal %5D))))))
(rule incomplete_first_member normal (seq (and (ref incomplete_member)) (recover (ref never) (ref end_of_input))))
(rule incomplete_next_member normal (seq (and (seq (literal %2C) (ref whitespace) (ref incomplete_member))) (recover (ref never) (ref end_of_input))))
(rule incomplete_member silent (seq (ref string) (ref whitespace) (optional (seq (literal %3A) (ref whitespace) (optional (ref incomplete_scalar)))) (ref end_of_input)))
(rule incomplete_first_element normal (seq (and (ref incomplete_scalar)) (recover (ref never) (ref end_of_input))))
(rule incomplete_next_element normal (seq (and (seq (literal %2C) (ref whitespace) (ref incomplete_scalar))) (recover (ref never) (ref end_of_input))))
(rule incomplete_scalar silent (seq (choice ordered (ref incomplete_number) (literal tru) (literal tr) (literal t) (literal fals) (literal fal) (literal fa) (literal f) (literal nul) (literal nu) (literal n)) (ref whitespace) (ref end_of_input)))
(rule incomplete_number silent (choice ordered (seq (ref number_base) (optional (ref fraction)) (class plain (char e) (char E)) (optional (class plain (char %2B) (char -)))) (seq (ref number_base) (literal .)) (literal -)))
(rule trailing_comma normal (seq (and (seq (literal %2C) (ref whitespace) (choice ordered (class plain (char %5D) (char %7D)) (ref end_of_input)))) (recover (ref never) empty) (ref whitespace)))
(rule string normal (seq (literal %22) (repeat0 (choice ordered (ref string_content) (ref escape_sequence) (ref malformed_escape) (ref unescaped_control))) (choice ordered (literal %22) (seq (ref end_of_input) (missing (literal %22))))))
(rule string_content token (repeat1 (class negated (char %22) (char %5C) (range %00 %1F))))
(rule escape_sequence token (seq (literal %5C) (choice ordered (class plain (char %22) (char %5C) (char %2F) (char b) (char f) (char n) (char r) (char t)) (seq (literal u) (repeat 4 4 (class plain (range 0 9) (range A F) (range a f)))))))
(rule malformed_escape normal (seq (and (literal %5C)) (recover (ref never) empty)))
(rule unescaped_control normal (seq (and (range %00 %1F)) (recover (ref never) empty)))
(rule number token (seq (ref number_base) (optional (ref fraction)) (optional (seq (class plain (char e) (char E)) (optional (class plain (char %2B) (char -))) (repeat1 (range 0 9)))) (not (class plain (range a z) (range A Z) (range 0 9) (char _) (char .) (char %2B) (char -)))))
(rule number_base silent (seq (optional (literal -)) (choice ordered (literal 0) (seq (range 1 9) (repeat0 (range 0 9))))))
(rule fraction silent (seq (literal .) (repeat1 (range 0 9))))
(rule true token (seq (literal true) (ref word_boundary)))
(rule false token (seq (literal false) (ref word_boundary)))
(rule null token (seq (literal null) (ref word_boundary)))
(rule word_boundary silent (not (class plain (range a z) (range A Z) (range 0 9) (char _))))
(rule whitespace silent (optional (token (repeat1 (class plain (char %20) (char %09) (char %0A) (char %0D))))))
(rule horizontal_space silent (repeat0 (class plain (char %20) (char %09))))
(rule end_of_input silent (not any))
(rule never silent (not empty))
