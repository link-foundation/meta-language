(23719: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadJavaScriptSourceTextProfileError%7D%20from%20%27.%2Fjavascript-source-text-rules.js%27%3B%0A%2F%2A%2A%20Explicit%20semantic%20operands%20for%20ordinary%20object%20operations.%20Reference%20IDs%0A%20%2A%20belong%20to%20the%20caller%27s%20checked%20global%20link%20space%3B%20callability%20is%20an%20intrinsic%0A%20%2A%20fact%20of%20that%20object%20model%2C%20not%20a%20host%20callback%20or%20an%20inferred%20property%20name.%0A%20%2A%20Text%20retains%20UTF-16%20units.%20Integer%20values%20and%20reference%20identities%20remain%0A%20%2A%20separate%20domains%2C%20even%20when%20their%20numerical%20encodings%20happen%20to%20agree.%0A%20%2A%20%40typedef%20%7B%7B%20%24%3A%27undefined%27%20%7D%20%7C%20%7B%20%24%3A%27null%27%20%7D%20%7C%20%7B%20%24%3A%27boolean%27%2C%20value%3Aboolean%20%7D%0A%20%2A%20%7C%20%7B%20%24%3A%27number%27%2C%20value%3Anumber%20%7D%20%7C%20%7B%20%24%3A%27integer%27%2C%20value%3Abigint%20%7D%0A%20%2A%20%7C%20%7B%20%24%3A%27text%27%2C%20units%3Anumber%5B%5D%20%7D%20%7C%20%7B%20%24%3A%27sourceText%27%2Cprofile%3Astring%2Ctext%3Astring%7D%0A%20%2A%20%7C%20%7B%20%24%3A%27symbol%27%2C%20identity%3Abigint%20%7D%0A%20%2A%20%7C%20%7B%20%24%3A%27object%27%2C%20identity%3Abigint%2C%20callable%3Aboolean%20%7D%7D%20JavaScriptSemanticValue%0A%20%2A%2F%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptSemanticValueError%28value%29%20%7B%0A%20%20switch%20%28value.%24%29%20%7B%0A%20%20%20%20case%20%27undefined%27%3A%20return%20%27%27%3B%0A%20%20%20%20case%20%27null%27%3A%20return%20%27%27%3B%0A%20%20%20%20case%20%27boolean%27%3A%20return%20%27%27%3B%0A%20%20%20%20case%20%27number%27%3A%20return%20%27%27%3B%0A%20%20%20%20case%20%27integer%27%3A%20return%20%27%27%3B%0A%20%20%20%20case%20%27sourceText%27%3Areturn%20typeof%20value.text%21%3D%3D%27string%27%3F%27source%20text%20requires%20its%20actual%20complete%20String%20value%27%3AreadJavaScriptSourceTextProfileError%28value.profile%2Cvalue.text.length%29%3B%0A%20%20%20%20case%20%27text%27%3A%20%7B%0A%20%20%20%20%20%20const%20units%20%3D%20value.units%3B%0A%20%20%20%20%20%20if%20%28units.length%20%3E%201048576%29%20return%20%27semantic%20text%20exceeds%20the%20explicit%20UTF16%20unit%20budget%27%3B%0A%20%20%20%20%20%20for%20%28let%20at%20%3D%200%3B%20at%20%3C%20units.length%3B%20at%20%2B%3D%201%29%20%7B%0A%20%20%20%20%20%20%20%20const%20unit%20%3D%20units%5Bat%5D%20%3F%3F%20-1%3B%0A%20%20%20%20%20%20%20%20if%20%28%21Number.isInteger%28unit%29%20%7C%7C%20unit%20%3C%200%20%7C%7C%20unit%20%3E%2065535%29%20return%20%27semantic%20text%20requires%20complete%20ordered%20UTF16%20code%20units%27%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20return%20%27%27%3B%0A%20%20%20%20%7D%0A%20%20%20%20case%20%27symbol%27%3A%20return%20value.identity%20%3E%200n%20%26%26%20value.identity%20%3C%3D%2018446744073709551615n%20%3F%20%27%27%20%3A%20%27a%20symbol%20requires%20a%20positive%20unsigned64%20global%20link%20identity%27%3B%0A%20%20%20%20case%20%27object%27%3A%20return%20value.identity%20%3E%200n%20%26%26%20value.identity%20%3C%3D%2018446744073709551615n%20%3F%20%27%27%20%3A%20%27an%20object%20requires%20a%20positive%20unsigned64%20global%20link%20identity%27%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20Semantic%20SameValue%2C%20including%20NaN%2C%20signed%20zero%2C%20exact%20integers%2C%20text%20units%2C%0A%20%2A%20symbol%20identity%20and%20object%20identity.%20It%20does%20not%20equate%20independently%20named%0A%20%2A%20concepts%20or%20establish%20correspondence%20between%20different%20global%20link%20spaces.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20left%20%40param%20%7BJavaScriptSemanticValue%7D%20right%0A%20%2A%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptSemanticSameValue%28left%2C%20right%29%20%7B%0A%20%20if%20%28readJavaScriptSemanticValueError%28left%29%20%21%3D%3D%20%27%27%20%7C%7C%20readJava