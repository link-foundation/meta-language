(23538: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20BigInt%20conversion%20algorithms.%20A%20zero%2Fone%20element%20column%20distinguishes%0A%2F%2F%20a%20failed%20conversion%20from%20every%20integer%2C%20including%20zero.%20Hosts%20select%20the%0A%2F%2F%20language%27s%20syntax%2Frange%2Ftype%20exception%20and%20retain%20its%20actual%20source%20message.%0Aimport%20%7BacceptJavaScriptWhitespaceUnit%7D%20from%20%27.%2Fjavascript-whitespace-rules.js%27%3B%0Aimport%20%7BreadJavaScriptNumericDigitUnit%7D%20from%20%27.%2Fnumeric-digit-rules.js%27%3B%0Aimport%20%7BreadJavaScriptUtf8StringUnits%7D%20from%20%27.%2Futf8-string-unit-rules.js%27%3B%0Aimport%20%7BconvertStringNumberRational%7D%20from%20%27.%2Fstring-number-rules.js%27%3B%0A%0A%2F%2A%2A%20Complete%20StringIntegerLiteral%2C%20without%20a%20Number%20intermediate%20or%20size%20cap.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40returns%20%7Bbigint%5B%5D%7D%20%2A%2F%0Aexport%20function%20convertJavaScriptStringBigIntegerUnits%28units%29%20%7B%0A%20%20for%28let%20index%3D0%3Bindex%3Cunits.length%3Bindex%2B%3D1%29%7B%0A%20%20%20%20const%20unit%3Dunits%5Bindex%5D%3F%3F%20-1%3B%0A%20%20%20%20if%28%21Number.isSafeInteger%28unit%29%7C%7Cunit%3C0%7C%7Cunit%3E65535%29return%20%5B%5D%3B%0A%20%20%7D%0A%20%20let%20start%3D0%2Cend%3Dunits.length%3B%0A%20%20while%28start%3Cend%26%26acceptJavaScriptWhitespaceUnit%28units%5Bstart%5D%3F%3F%20-1%29%29start%2B%3D1%3B%0A%20%20while%28end%3Estart%26%26acceptJavaScriptWhitespaceUnit%28units%5Bend-1%5D%3F%3F%20-1%29%29end-%3D1%3B%0A%20%20if%28start%3D%3D%3Dend%29return%20%5B0n%5D%3B%0A%20%20let%20negative%3Dfalse%2Csigned%3Dfalse%3B%0A%20%20const%20sign%3Dunits%5Bstart%5D%3F%3F%20-1%3B%0A%20%20if%28sign%3D%3D%3D43%7C%7Csign%3D%3D%3D45%29%7Bnegative%3Dsign%3D%3D%3D45%3Bsigned%3Dtrue%3Bstart%2B%3D1%3B%7D%0A%20%20if%28start%3D%3D%3Dend%29return%20%5B%5D%3B%0A%20%20let%20radix%3D10%2Cbase%3D10n%3B%0A%20%20if%28%21signed%26%26%28units%5Bstart%5D%3F%3F%20-1%29