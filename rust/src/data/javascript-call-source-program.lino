%3F%3F0n%3B%0A%20else%20if%28operation%3D%3D%3D%27negate%20integer%27%29result%3D-left%3B%0A%20else%20if%28code%3E%3D0%29result%3DapplyBigIntegerBitwiseOperation%28code%2Cleft%2Cright%29%3B%0A%20else%20return%20%7B%24%3A%27primitiveInvalid%27%2Creason%3A%27integer%20primitives%20require%20their%20actual%20registered%20operation%27%7D%3B%0A%20if%28readJavaScriptCallIntegerWidth%28result%29%3C0%29return%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3A%27integer%20output%20exceeds%20the%20selected%204096-bit%20work%20profile%27%7D%3B%0A%20return%20%7B%24%3A%27primitiveValue%27%2Cvalue%3A%7B%24%3A%27integer%27%2Cvalue%3Aresult%7D%7D%3B%0A%7D%0A) (lang: meta-language%20typed%20program)))
