(33801: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Shared%20source%20decisions%20for%20standard%20owned%20sums.%0A%2F%2F%20Callers%20establish%20resolved%20definition%20ownership%20and%20complete%20checked%20source%0A%2F%2F%20identities.%20Copy%2C%20owned%20and%20primitive%20residual%20conversion%20admissions%20remain%0A%2F%2F%20separate%20operations%3B%20none%20upgrades%20another%20profile%27s%20missing%20proof.%0A%2F%2F%20These%20scalar%20projections%20neither%20create%20nor%20replace%20any%20certificate.%0A%2F%2F%20Instantiate%20the%20existing%20named%20datatype%2Fconstructor%2Fmatch%20algebra.%20In%0A%2F%2F%20particular%2C%20types.option%20is%20unsuitable%3A%20it%20collapses%20nested%20optional%20values.%0Aimport%20%7BplanRustPrimitiveFrom%7D%20from%20%27.%2Frust-primitive-from-rules.js%27%3B%0A%0A%2F%2A%2A%20A%20resolved%20standard%20definition%2C%20never%20an%20unresolved%20caller%20spelling.%0A%20%2A%20%40param%20%7Bstring%7D%20path%20%40param%20%7Bboolean%7D%20standardDefinition%0A%20%2A%20%40param%20%7Bnumber%7D%20layers%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceOwner%28path%2CstandardDefinition%2Clayers%29%7B%0A%20if%28%21standardDefinition%7C%7Clayers%21%3D%3D0%29return%20%27%27%3B%0A%20return%20path%3D%3D%3D%27std%3A%3Aoption%3A%3AOption%27%7C%7Cpath%3D%3D%3D%27core%3A%3Aoption%3A%3AOption%27%3F%27std%3A%3Aoption%3A%3AOption%27%3Apath%3D%3D%3D%27std%3A%3Aresult%3A%3AResult%27%7C%7Cpath%3D%3D%3D%27core%3A%3Aresult%3A%3AResult%27%3F%27std%3A%3Aresult%3A%3AResult%27%3A%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20Standard%20prelude%2Ftype%2Fvariant%20spellings%20after%20actual%20import%20resolution.%20A%0A%20%2A%20catalog%20adapter%20must%20still%20reject%20local%20owners%20and%20namespace%20shadows.%0A%20%2A%20%40param%20%7Bstring%7D%20path%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourcePathOwner%28path%29%7B%0A%20if%28%5B%27Option%27%2C%27std%3A%3Aoption%3A%3AOption%27%2C%27core%3A%3Aoption%3A%3AOption%27%2C%27None%27%2C%27Some%27%2C%27Option%3A%3ANone%27%2C%27Option%3A%3ASome%27%2C%27std%3A%3Aoption%3A%3AOption%3A%3ANone%27%2C%27std%3A%3Aoption%3A%3AOption%3A%3ASome%27%2C%27core%3A%3Aoption%3A%3AOption%3A%3ANone%27%2C%27core%3A%3Aoption%3A%3AOption%3A%3ASome%27%5D.includes%28path%29%29return%20%27std%3A%3Aoption%3A%3AOption%27%3B%0A%20return%20%5B%27Result%27%2C%27std%3A%3Aresult%3A%3AResult%27%2C%27core%3A%3Aresult%3A%3AResult%27%2C%27Ok%27%2C%27Err%27%2C%27Result%3A%3AOk%27%2C%27Result%3A%3AErr%27%2C%27std%3A%3Aresult%3A%3AResult%3A%3AOk%27%2C%27std%3A%3Aresult%3A%3AResult%3A%3AErr%27%2C%27core%3A%3Aresult%3A%3AResult%3A%3AOk%27%2C%27core%3A%3Aresult%3A%3AResult%3A%3AErr%27%5D.includes%28path%29%3F%27std%3A%3Aresult%3A%3AResult%27%3A%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20path%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourcePathConstructor%28path%29%7B%0A%20if%28%5B%27None%27%2C%27Option%3A%3ANone%27%2C%27std%3A%3Aoption%3A%3AOption%3A%3ANone%27%2C%27core%3A%3Aoption%3A%3AOption%3A%3ANone%27%5D.includes%28path%29%29return%20%27None%27%3B%0A%20if%28%5B%27Some%27%2C%27Option%3A%3ASome%27%2C%27std%3A%3Aoption%3A%3AOption%3A%3ASome%27%2C%27core%3A%3Aoption%3A%3AOption%3A%3ASome%27%5D.includes%28path%29%29return%20%27Some%27%3B%0A%20if%28%5B%27Ok%27%2C%27Result%3A%3AOk%27%2C%27std%3A%3Aresult%3A%3AResult%3A%3AOk%27%2C%27core%3A%3Aresult%3A%3AResult%3A%3AOk%27%5D.includes%28path%29%29return%20%27Ok%27%3B%0A%20return%20%5B%27Err%27%2C%27Result%3A%3AErr%27%2C%27std%3A%3Aresult%3A%3AResult%3A%3AErr%27%2C%27core%3A%3Aresult%3A%3AResult%3A%3AErr%27%5D.includes%28path%29%3F%27Err%27%3A%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceInstantiationLimit%28%29%7Breturn%20256%3B%7D%0A%2F%2A%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceDepthLimit%28%29%7Breturn%2016%3B%7D%0A%0A%2F%2A%2A%20Concrete%20datatype%20names%20never%20consume%20expression%2Fcompletion%20temporaries.%0A%20%2A%20%40param%20%7Bnumber%7D%20ordinal%20%40param%20%7Bnumber%7D%20collision%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceSpecializationName%28ordinal%2Ccollision%29%7B%0A%20if%28%21Number.isInteger%28ordinal%29%7C%7Cordinal%3C0%7C%7Cordinal%3E%3D256%7C%7C%21Number.isInteger%28collision%29%7C%7Ccollision%3C0%7C%7Ccollision%3E%3D4096%29return%20%27%27%3B%0A%20return%20%27ml_standard_sum_value%27%2BString%28ordinal%29%2B%27_%27%2BString%28collision%29%3B%0A%7D%0A%0A%2F%2A%2A%20Header%20inventory%20is%20private%20syntax%20context%2C%20never%20admitted%20Copy%20evidence.%0A%20%2A%20%40param%20%7Bboolean%7D%20header%20%40param%20%7Bboolean%7D%20complete%20%40param%20%7Bboolean%7D%20copies%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourcePhase%28header%2Ccomplete%2Ccopies%29%7B%0A%20return%20header%3F%27provisional%27%3Acomplete%26%26copies%3F%27admitted%27%3A%27refuse%27%3B%0A%7D%0A%0A%2F%2A%2A%20Complete%20concrete%20child%20depths%20include%20saved%20aliases%20and%20callable%2Fproducts.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20children%20%40param%20%7Bboolean%7D%20sum%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceDepth%28children%2Csum%29%7B%0A%20let%20depth%3D0%3B%0A%20for%28const%20child%20of%20children%29%7Bif%28%21Number.isInteger%28child%29%7C%7Cchild%3C0%7C%7Cchild%3E16%29return%20-1%3Bif%28child%3Edepth%29depth%3Dchild%3B%7D%0A%20const%20result%3Ddepth%2B%28sum%3F1%3A0%29%3Breturn%20result%3C%3D16%3Fresult%3A-1%3B%0A%7D%0A%0A%2F%2A%2A%20Charge%20complete%20source%20metadata%20before%20copying%20it.%20Units%20are%20UTF16%20code%0A%20%2A%20units%2C%20not%20encoded%20bytes.%20These%20finite%20bounds%20are%20independent%20of%20type%20depth.%0A%20%2A%20%40param%20%7Bnumber%7D%20nodes%20%40param%20%7Bnumber%7D%20units%20%40param%20%7Bnumber%7D%20add