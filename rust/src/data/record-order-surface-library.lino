(60: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Portable%20record%20plans%20use%20original%20entry%20positions%20and%20UTF16%20code%20units.%0A%2F%2F%20Child%20checking%2C%20lexical%20identities%20and%20target%20syntax%20remain%20with%20their%20owners.%0Aimport%20%7B%20readRequiredNumberFact%2C%20readRequiredTextFact%20%7D%20from%20%27.%2Ffact-column-rules.js%27%3B%0A%0A%2F%2A%2A%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Afunction%20refuseRequiredRecordName%28%29%20%7B%0A%20%20throw%20new%20RangeError%28%27missing%20required%20record%20name%20row%27%29%3B%0A%7D%0A%0A%2F%2A%2A%20Read%20the%20actual%20selected%20row%2C%20without%20inventing%20a%20name%20for%20missing%20data.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%5B%5D%7D%20names%20%40param%20%7Bnumber%7D%20index%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Afunction%20readRequiredRecordName%28names%2C%20index%29%20%7B%0A%20%20if%20%28index%20%3C%200%20%7C%7C%20index%20%25%201%20%21%3D%3D%200%20%7C%7C%20index%20%3E%3D%20names.length%29%20%7B%0A%20%20%20%20throw%20new%20RangeError%28%27invalid%20required%20record%20name%20position%27%29%3B%0A%20%20%7D%0A%20%20return%20names%5Bindex%5D%20%3F%3F%20refuseRequiredRecordName%28%29%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20count%20%40param%20%7Bboolean%7D%20reverse%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20readRecordValueOrder%28count%2C%20reverse%29%20%7B%0A%20%20if%20%28%21Number.isSafeInteger%28count%29%20%7C%7C%20count%20%3C%200%29%20return%20%5B-1%5D%3B%0A%20%20const%20order%20%3D%20%5B%5D%3B%0A%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20count%3B%20index%20%2B%3D%201%29%20order.push%28reverse%20%3F%20count%20-%20index%20-%201%20%3A%20index%29%3B%0A%20%20return%20order%3B%0A%7D%0A%0A%2F%2A%2A%20The%20marker%20selects%20a%20checked%20projection%2C%20never%20a%20substitute%20for%20checking%0A%20%2A%20its%20actual%20ordered%20fields%20and%20their%20child%20expressions.%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRecordProjection%28%29%20%7B%0A%20%20return%20%27checked%20ordered%20record%20values%27%3B%0A%7D%0A%0A%2F%2A%2A%20Canonical%20checked%20fields%20are%20already%20evaluated%20in%20their%20retained%20binding%0A%20%2A%20scopes.%20They%20have%20no%20spreads%2C%20replacements%20or%20field-order%20normalization.%0A%20%2A%20%40param%20%7Bstring%7D%20projection%20%40param%20%7Bnumber%5B%5D%5B%5D%7D%20names%0A%20%2A%20%40param%20%7Bboolean%5B%5D%7D%20entries%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRecordProjectionError%28projection%2C%20names%2C%20entries%29%20%7B%0A%20%20if%20%28projection%20%21%3D%3D%20readRecordProjection%28%29%29%20return%20%27unknown%20checked%20record%20projection%27%3B%0A%20%20if%20%28names.length%20%21%3D%3D%20entries.length%29%20return%20%27checked%20record%20projection%20has%20inconsistent%20entry%20facts%27%3B%0A%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20names.length%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20if%20%28%21entries%5Bindex%5D%29%20return%20%27checked%20record%20projection%20has%20a%20malformed%20field%20entry%27%3B%0A%20%20%20%20if%20%28%21acceptRecordFieldName%28readRequiredRecordName%28names%2C%20index%29%29%29%20return%20%27checked%20record%20projection%20has%20an%20invalid%20UTF16%20field%20name%27%3B%0A%20%20%20%20if%20%28index%20%3E%200%20%26%26%20compareRecordFieldNames%28readRequiredRecordName%28names%2C%20index%20-%201%29%2C%20readRequiredRecordName%28names%2C%20index%29%29%20%3E%3D%200%29%20%7B%0A%20%20%20%20%20%20return%20%27checked%20record%20projection%20needs%20unique%20fields%20in%20UTF16%20order%27%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20return%20%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20name%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRecordFieldName%28name%29%20%7B%0A%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20name.length%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20const%20unit%20%3D%2