%20%20%20%20if%20%28digit%20%3C%200%29%20break%3B%0A%20%20%20%20%20%20low%20%3D%20low%20%2A%2016%20%2B%20digit%3B%0A%20%20%20%20%20%20offset%20%2B%3D%201%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28offset%20%3D%3D%3D%206%20%26%26%20low%20%3E%3D%2056320%20%26%26%20low%20%3C%3D%2057343%29%20%7B%0A%20%20%20%20%20%20code%20%3D%2065536%20%2B%20%28code%20-%2055296%29%20%2A%201024%20%2B%20low%20-%2056320%3B%0A%20%20%20%20%20%20index%20%2B%3D%206%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20if%20%28code%20%3E%201114111%20%7C%7C%20%28code%20%3E%3D%2055296%20%26%26%20code%20%3C%3D%2057343%29%29%20return%20%7B%20%24%3A%20%27unsupported%27%2C%20end%3A%20index%2C%20escapeLength%20%7D%3B%0A%20%20return%20%7B%20%24%3A%20%27scalar%27%2C%20code%2C%20end%3A%20index%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Whether%20every%20omitted%20argument%20has%20a%20trailing%20default.%0A%20%2A%20%40param%20%7Bboolean%5B%5D%7D%20defaults%0A%20%2A%20%40param%20%7Bnumber%7D%20count%0A%20%2A%20%40returns%20%7Bboolean%7D%0A%20%2A%2F%0Aexport%20function%20acceptArgumentCount%28defaults%2C%20count%29%20%7B%0A%20%20if%20%28count%20%3E%20defaults.length%29%20return%20false%3B%0A%20%20let%20index%20%3D%20count%3B%0A%20%20while%20%28index%20%3C%20defaults.length%29%20%7B%0A%20%20%20%20if%20%28%21defaults%5Bindex%5D%29%20return%20false%3B%0A%20%20%20%20index%20%2B%3D%201%3B%0A%20%20%7D%0A%20%20return%20true%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Find%20a%20reference%20to%20an%20earlier%20parameter%20in%20a%20default%20expression.%20Member%0A%20%2A%20names%20after%20a%20dot%20are%20not%20references%2C%20and%20nested%20delimiters%20keep%20commas%0A%20%2A%20and%20closing%20parentheses%20inside%20the%20expression.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20kinds%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20values%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20parameters%0A%20%2A%20%40returns%20%7Bnumber%7D%0A%20%2A%2F%0Aexport%20function%20findDefaultParameterReference%28kinds%2C%20values%2C%20parameters%29%20%7B%0A%20%20let%20at%20%3D%200%3B%0A%20%20let%20depth%20%3D%200%3B%0A%20%20while%20%28at%20%3C%20values.length%20%26%26%20kinds%5Bat%5D%20%21%3D%3D%20%27eof%27%20%26%26%20%28depth%20%3E%200%20%7C%7C%20%28values%5Bat%5D%20%21%3D%3D%20%27%2C%27%20%26%26%20values%5Bat%5D%20%21%3D%3D%20%27%29%27%29%29%29%20%7B%0A%20%20%20%20const%20value%20%3D%20values%5Bat%5D%3B%0A%20%20%20%20if%20%28value%20%3D%3D%3D%20%27%28%27%20%7C%7C%20value%20%3D%3D%3D%20%27%5B%27%20%7C%7C%20value%20%3D%3D%3D%20%27%7B%27%29%20depth%20%2B%3D%201%3B%0A%20%20%20%20if%20%28value%20%3D%3D%3D%20%27%29%27%20%7C%7C%20value%20%3D%3D%3D%20%27%5D%27%20%7C%7C%20value%20%3D%3D%3D%20%27%7D%27%29%20depth%20-%3D%201%3B%0A%20%20%20%20if%20%28kinds%5Bat%5D%20%3D%3D%3D%20%27identifier%27%20%26%26%20%21%28at%20%3E%200%20%26%26%20values%5Bat%20-%201%5D%20%3D%3D%3D%20%27.%27%29%29%20%7B%0A%20%20%20%20%20%20let%20parameterIndex%20%3D%200%3B%0A%20%20%20%20%20%20while%20%28parameterIndex%20%3C%20parameters.length%29%20%7B%0A%20%20%20%20%20%20%20%20if%20%28parameters%5BparameterIndex%5D%20%3D%3D%3D%20value%29%20return%20at%3B%0A%20%20%20%20%20%20%20%20parameterIndex%20%2B%3D%201%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%20%20%20%20at%20%2B%3D%201%3B%0A%20%20%7D%0A%20%20return%20-1%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Whether%20a%20slash%20follows%20a%20token%20that%20starts%20an%20expression%20rather%20than%20one%0A%20%2A%20that%20ends%20it.%20Comments%20are%20removed%20before%20this%20decision.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%0A%20%2A%20%40param%20%7Bstring%7D%20value%0A%20%2A%20%40returns%20%7Bboolean%7D%0A%20%2A%2F%0Aexport%20function%20startRegularExpression%28kind%2C%20value%29%20%7B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27%27%29%20return%20true%3B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27identifier%27%29%20%7B%0A%20%20%20%20return%20value%20%3D%3D%3D%20%27return%27%20%7C%7C%20value%20%3D%3D%3D%20%27throw%27%20%7C%7C%20value%20%3D%3D%3D%20%27case%27%0A%20%20%20%20%20%20%7C%7C%20value%20%3D%3D%3D%20%27delete%27%20%7C%7C%20va