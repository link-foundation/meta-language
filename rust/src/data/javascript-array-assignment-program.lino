2A%20%40param%20%7Bboolean%7D%20value%20%40returns%20%7Bbigint%7D%20%2A%2F%0Aexport%20function%20convertJavaScriptBooleanBigInteger%28value%29%20%7B%0A%20%20return%20value%3F1n%3A0n%3B%0A%7D%0A%2F%2A%2A%20Exact%20Number%2FBigInt%20order%3B%20two%20denotes%20the%20unordered%20NaN%20case.%0A%20%2A%20%40param%20%7Bnumber%7D%20value%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptNumberBigInteger%28value%2Cinteger%29%7B%0A%20if%28Number.isNaN%28value%29%29return%202%3B%0A%20if%28value%3D%3D%3DInfinity%29return%201%3B%0A%20if%28value%3D%3D%3D-Infinity%29return%20-1%3B%0A%20const%20floor%3DMath.floor%28value%29%2Clower%3DconvertJavaScriptNumberBigInteger%28floor%29%5B0%5D%3F%3F0n%3B%0A%20if%28lower%3Cinteger%29return%20-1%3B%0A%20if%28lower%3Einteger%29return%201%3B%0A%20return%20value%3D%3D%3Dfloor%3F0%3A1%3B%0A%7D%0A%2F%2A%2A%20String%2FBigInt%20uses%20StringIntegerLiteral%20rather%20than%20StringNumericLiteral.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptStringBigIntegerUnits%28units%2Cinteger%29%7B%0A%20const%20result%3DconvertJavaScriptStringBigIntegerUnits%28units%29%3B%0A%20if%28result.length%21%3D%3D1%29return%202%3B%0A%20const%20value%3Dresult%5B0%5D%3F%3F0n%3B%0A%20return%20value%3Cinteger%3F-1%3Avalue%3Einteger%3F1%3A0%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20bytes%20%40param%20%7Bbigint%7D%20integer%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptUtf8BigInteger%28bytes%2Cinteger%29%7Breturn%20compareJavaScriptStringBigIntegerUnits%28readJavaScriptUtf8StringUnits%28bytes%29%2Cinteger%29%3B%7D%0A%0A%2F%2A%2A%20Truncating%20signed%20division%20and%20dividend-signed%20remainder.%20Empty%20means%20a%0A%20%2A%20zero%20divisor.%20Only%20division%20by%20the%20literal%20two%20is%20a%20primitive%20here%2C%20so%20the%0A%20%2A%20full%20definition%20self