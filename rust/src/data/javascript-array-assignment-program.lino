itch%28value.%24%29%7B%0A%20%20case%20%27undefined%27%3Areturn%200%3B%0A%20%20case%20%27null%27%3Areturn%201%3B%0A%20%20case%20%27boolean%27%3Areturn%202%3B%0A%20%20case%20%27number%27%3Areturn%203%3B%0A%20%20case%20%27integer%27%3Areturn%204%3B%0A%20%20case%20%27text%27%3Acase%20%27sourceText%27%3Areturn%205%3B%0A%20%20case%20%27symbol%27%3Areturn%206%3B%0A%20%20case%20%27object%27%3Areturn%207%3B%0A%20%20default%3Areturn%20-1%3B%0A%20%7D%0A%7D%0A%2F%2A%2A%20Deterministic%20validation%20order%2C%20not%20observable%20Map%20iteration%20order.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20left%20%40param%20%7BJavaScriptSemanticValue%7D%20right%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptCollectionKeys%28left%2Cright%29%7B%0A%20const%20a%3DreadJavaScriptCollectionKeyRank%28left%29%2Cb%3DreadJavaScriptCollectionKeyRank%28right%29%3Bif%28a%21%3D%3Db%29return%20a%3Cb%3F-1%3A1%3B%0A%20switch%28left.%24%29%7B%0A%20%20case%20%27number%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27number%27%29return%200%3B%0A%20%20%20if%28testJavaScriptCollectionKey%28left%2Cright%29%29return%200%3B%0A%20%20%20if%28Number.isNaN%28left.value%29%29return%201%3B%0A%20%20%20if%28Number.isNaN%28right.value%29%29return%20-1%3B%0A%20%20%20return%20left.value%3Cright.value%3F-1%3A1%3B%0A%20%20case%20%27integer%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27integer%27%29return%200%3B%0A%20%20%20return%20left.value%3D%3D%3Dright.value%3F0%3Aleft.value%3Cright.value%3F-1%3A1%3B%0A%20%20case%20%27boolean%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27boolean%27%29return%200%3B%0A%20%20%20return%20left.value%3D%3D%3Dright.value%3F0%3Aleft.value%3F1%3A-1%3B%0A%20%20case%20%27object%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27object%27%29return%200%3B%0A%20%20%20return%20left.identity%3D%3D%3Dright.identity%3F0%3Aleft.identity%3Cright.identity%3F-1%3A1%3B%0A%20%20case%20%27symbol%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27symbol%27%29return%200%3B%0A%20%20%20return%20left.identit