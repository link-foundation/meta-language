(rule open_date token (choice unordered (seq (literalInsensitive %D0%BD%D0%B0%D1%81%D1%82%D0%BE%D1%8F%D1%89%D0%B5%D0%B5) (repeat 1 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (literalInsensitive %D0%B2%D1%80%D0%B5%D0%BC%D1%8F)) (seq (literalInsensitive %D0%BD.) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (literalInsensitive %D0%B2.)) (literalInsensitive %D1%81%D0%B5%D0%B9%D1%87%D0%B0%D1%81)))
(rule date_range normal (seq (optional (seq (choice unordered (literalInsensitive %D0%BE%D1%82) (literalInsensitive %D1%81%D0%BE) (literalInsensitive %D1%81)) (repeat 1 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))))) (ref first_date) (choice unordered (seq (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (class plain (char -) (char %E2%80%93) (char %E2%80%94) (char %E2%88%92)) (repeat 0 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09)))) (seq (repeat 1 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (literalInsensitive %D0%B4%D0%BE) (repeat 1 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09)))) (seq (repeat 1 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))) (literalInsensitive %D0%BF%D0%BE) (repeat 1 8 (class plain (char %20) (char %C2%A0) (char %E2%80%AF) (char %09))))) (ref last_date)))
