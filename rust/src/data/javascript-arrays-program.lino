tch%28value.%24%29%7B%0A%20%20case%20%27undefined%27%3Areturn%200%3B%0A%20%20case%20%27null%27%3Areturn%201%3B%0A%20%20case%20%27boolean%27%3Areturn%202%3B%0A%20%20case%20%27number%27%3Areturn%203%3B%0A%20%20case%20%27integer%27%3Areturn%204%3B%0A%20%20case%20%27text%27%3Acase%20%27sourceText%27%3Areturn%205%3B%0A%20%20case%20%27symbol%27%3Areturn%206%3B%0A%20%20case%20%27object%27%3Areturn%207%3B%0A%20%20default%3Areturn%20-1%3B%0A%20%7D%0A%7D%0A%2F%2A%2A%20Deterministic%20validation%20order%2C%20not%20observable%20Map%20iteration%20order.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20left%20%40param%20%7BJavaScriptSemanticValue%7D%20right%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareJavaScriptCollectionKeys%28left%2Cright%29%7B%0A%20const%20a%3DreadJavaScriptCollectionKeyRank%28left%29%2Cb%3DreadJavaScriptCollectionKeyRank%28right%29%3Bif%28a%21%3D%3Db%29return%20a%3Cb%3F-1%3A1%3B%0A%20switch%28left.%24%29%7B%0A%20%20case%20%27number%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27number%27%29return%200%3B%0A%20%20%20if%28testJavaScriptCollectionKey%28left%2Cright%29%29return%200%3B%0A%20%20%20if%28Number.isNaN%28left.value%29%29return%201%3B%0A%20%20%20if%28Number.isNaN%28right.value%29%29return%20-1%3B%0A%20%20%20return%20left.value%3Cright.value%3F-1%3A1%3B%0A%20%20case%20%27integer%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27integer%27%29return%200%3B%0A%20%20%20return%20left.value%3D%3D%3Dright.value%3F0%3Aleft.value%3Cright.value%3F-1%3A1%3B%0A%20%20case%20%27boolean%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27boolean%27%29return%200%3B%0A%20%20%20return%20left.value%3D%3D%3Dright.value%3F0%3Aleft.value%3F1%3A-1%3B%0A%20%20case%20%27object%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27object%27%29return%200%3B%0A%20%20%20return%20left.identity%3D%3D%3Dright.identity%3F0%3Aleft.identity%3Cright.identity%3F-1%3A1%3B%0A%20%20case%20%27symbol%27%3A%0A%20%20%20if%28right.%24%21%3D%3D%27symbol%27%29return%200%3B%0A%20%20%20return%20left.identity%3D%3D%3Dright.identity%3F0%3Aleft.identity%3Cright.identity%3F-1%3A1%3B%0A%20%20case%20%27sourceText%27%3A%0A%20%20%20if%28right.%24%3D%3D%3D%27sourceText%27%29return%20left.text%3D%3D%3Dright.text%3F0%3Aleft.text%3Cright.text%3F-1%3A1%3B%0A%20%20%20break%3B%0A%20%7D%0A%20if%28a%3D%3D%3D5%29%7B%0A%20%20const%20first%3DreadJavaScriptSemanticTextLength%28left%29%2Csecond%3DreadJavaScriptSemanticTextLength%28right%29%2Clength%3DMath.min%28first%2Csecond%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3Clength%3Bindex%2B%2B%29%7Bconst%20x%3DreadJavaScriptSemanticTextUnit%28left%2Cindex%29%2Cy%3DreadJavaScriptSemanticTextUnit%28right%2Cindex%29%3Bif%28x%21%3D%3Dy%29return%20x%3Cy%3F-1%3A1%3B%7D%0A%20%20return%20first%3D%3D%3Dsecond%3F0%3Afirst%3Csecond%3F-1%3A1%3B%0A%20%7D%0A%20return%200%3B%0A%7D%0A%2F%2A%2A%20Bottom-up%20merge%20ordering%20keeps%20validation%20bounded%20without%20host%20comparator%0A%20%2A%20callbacks%20or%20quadratic%20insertion%20scans.%20Input%20order%20remains%20untouched.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%5B%5D%7D%20values%20%40returns%20%7BJavaScriptSemanticValue%5B%5D%7D%20%2A%2F%0Aexport%20function%20orderJavaScriptCollectionKeys%28values%29%7B%0A%20let%20source%3Dvalues.slice%28%29%3B%0A%20for%28let%20width%3D1%3Bwidth%3Csource.length%3Bwidth%2A%3D2%29%7B%0A%20%20const%20target%3D%5B%5D%3B%0A%20%20for%28let%20start%3D0%3Bstart%3Csource.length%3Bstart%2B%3Dwidth%2A2%29%7B%0A%20%20%20const%20middle%3DMath.min%28start%2Bwidth%2Csource.length%29%2Cend%3DMath.min%28start%2Bwidth%2A2%2Csource.length%29%3B%0A%20%20%20let%20left%3Dstart%2Cright%3Dmiddle%3B%0A%20%20%20while%28left%3Cmiddle%7C%7Cright%3Cend%29%7B%0A%20%20%20%20const%20a%3Dsource%5Bleft%5D%2Cb%3Dsource%5Bright%5D%3B%0A%20%20%20%20let%20takeLeft%3Dright%3E%3Dend%3B%0A%20%20%20%20if%28%21takeLeft%26%26left%3Cmiddle%29%7B%0A%20%20%20%20%20if%28a%21%3D%3Dundefined%29%7B%0A%20%20%20%20%20%20if%28b%21%3D%3Dundefined%29takeLeft%3DcompareJavaScriptCollectionKeys%28a%2Cb%29%3C%3D0%3B%