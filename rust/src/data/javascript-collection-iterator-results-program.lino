%0A%20%2A%20Functional%20snapshots%20are%20semantic%20states.%20A%20frontend%20must%20keep%20the%20selected%0A%20%2A%20state%20in%20one%20shared%20cell%20so%20all%20aliases%20observe%20the%20same%20transition.%0A%20%2A%20Nominal%20definitions%20keep%20recursive%20source%20types%20shared%20rather%20than%20repeatedly%0A%20%2A%20expanding%20structural%20records%20along%20every%20typed%20expression%20occurrence.%0A%20%2A%20%40typedef%20%7B%7B%24%3A%27ordinaryHeap%27%2Cobjects%3AJavaScriptOrdinaryObject%5B%5D%2Csymbols%3Abigint%5B%5D%2CsymbolRegistrationModel%3F%3Astring%2CsymbolRegistrations%3F%3AJavaScriptSymbolRegistrationFact%5B%5D%2CsymbolRegistryModel%3F%3Astring%2CsymbolRegistry%3F%3AJavaScriptSymbolRegistryEntry%5B%5D%7D%7D%20JavaScriptOrdinaryHeap%0A%20%2A%2F%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryObject%5B%5D%7D%20objects%20%40param%20%7Bbigint%7D%20identity%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20findJavaScriptHeapDirectoryObject%28objects%2C%20identity%29%20%7B%0A%20%20let%20low%20%3D%200%3B%0A%20%20let%20high%20%3D%20objects.length%3B%0A%20%20while%20%28low%20%3C%20high%29%20%7B%0A%20%20%20%20const%20middle%20%3D%20Math.floor%28%28low%20%2B%20high%29%20%2F%202%29%3B%0A%20%20%20%20const%20object%20%3D%20objects%5Bmiddle%5D%3B%0A%20%20%20%20if%20%28object%20%3D%3D%3D%20undefined%29%20return%20-1%3B%0A%20%20%20%20if%20%28object.identity%20%3D%3D%3D%20identity%29%20return%20middle%3B%0A%20%20%20%20if%20%28object.identity%20%3C%20identity%29%20low%20%3D%20middle%20%2B%201%3B%0A%20%20%20%20else%20high%20%3D%20middle%3B%0A%20%20%7D%0A%20%20return%20-1%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bbigint%5B%5D%7D%20symbols%20%40param%20%7Bbigint%7D%20identity%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptHeapDirectorySymbol%28symbols%2C%20identity%29%20%7B%0A%20%20let%20low%20%3D%200%3B%0A%20%20let%20high%20%3D%20symbols.length%3B%0A%20%20while%20%28low%20%3C%20high%29%20%7B%0A%20%20%20%20const%20middle%20%3D%20Math.floor%28%28low%20%2B%20high%29%20%2F%202%29%3B%0A%20%20%20%20const%20symbol%20%3D%20symbols%5Bmiddle%5D%3B%0A%20%20%20%20if%20%28symbol%20%3D%3D%3D%20undefined%29%20return%20false%3B%0A%20%20%20%20if%20%28symbol%20%3D%3D%3D%20identity%29%20return%20true%3B%0A%20%20%20%20if%20%28symbol%20%3C%20identity%29%20low%20%3D%20middle%20%2B%201%3B%0A%20%20%20%20else%20high%20%3D%20middle%3B%0A%20%20%7D%0A%20%20return%20false%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptHeapDirectoryValueError%28heap%2C%20value%29%20%7B%0A%20%20const%20error%20%3D%20readJavaScriptSemanticValueError%28value%29%3B%0A%20%20if%20%28error%20%21%3D%3D%20%27%27%29%20return%20error%3B%0A%20%20if%20%28value.%24%20%3D%3D%3D%20%27symbol%27%29%20return%20testJavaScriptHeapDirectorySymbol%28heap.symbols%2C%20value.identity%29%20%3F%20%27%27%20%3A%20%27a%20semantic%20Symbol%20must%20belong%20to%20the%20complete%20global%20identity%20directory%27%3B%0A%20%20if%20%28value.%24%20%21%3D%3D%20%27object%27%29%20return%20%27%27%3B%0A%20%20const%20at%20%3D%20findJavaScriptHeapDirectoryObject%28heap.objects%2C%20value.identity%29%3B%0A%20%20if%20%28at%20%3C%200%29%20return%20%27a%20semantic%20Object%20must%20belong%20to%20the%20complete%20global%20identity%20directory%27%3B%0A%20%20const%20object%20%3D%20heap.objects%5Bat%5D%3B%0A%20%20return%20object%20%21%3D%3D%20undefined%20%26%26%20object.callable%20%3D%3D%3D%20value.callable%20%3F%20%27%27%20%3A%20%27Object%20callability%20must%20agree%20with%20its%20intrinsic%20global%20identity%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptSemanticValue%7D%20key%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptHeapDirectoryKeyError%28heap%2C%20key%29%20%7B%0A%20%20if%20%28key.%24%20%21%3D%3D%20%27text%27%20%26%26%20key.%24%20%21%3D%3D%20%27sourceText%27%20%26%26%20key.%24%20%21%3D%3D%20%27symbol%27%29%20return%20%27an%20ordinary%20property%20key%20must%20be%20text%20or%20Symbol%20without%20implicit%20coercion%27%3B%0A%20%20return%20readJavaScriptHeapDirectoryValueError%28heap%2C%20key%29%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryProperty%5B%5D%7D%20properties%20%40param%20%7BJavaScriptSemanticValue%7D%20key%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20findJavaScriptHeapDirectoryProperty%28properties%2C%20key%29%20%7B%0A%20%20return%20findJavaScriptPropertyDescriptorEntry%28properties%2C%20key%29%3B%0A%7D%0A) (lang: meta-language%20typed%20program)))
