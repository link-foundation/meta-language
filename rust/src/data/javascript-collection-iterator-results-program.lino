(112043: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Array%20exotic%20descriptor%20semantics.%20Numeric%20conversion%20is%20a%20separate%20resumable%0A%2F%2F%20operation%3A%20callers%20must%20run%20BOTH%20conversions%20before%20reading%20the%20current%20length.%0A%2F%2F%20https%3A%2F%2Ftc39.es%2Fecma262%2Fmultipage%2Fordinary-and-exotic-objects-behaviours.html%23sec-arraysetlength%0Aimport%20%7BcreateJavaScriptPropertyDescriptor%2CplanJavaScriptPropertyDefinition%7D%20from%20%27.%2Fjavascript-property-descriptors.js%27%3B%0Aimport%20%7BtestJavaScriptSemanticSameValue%2CreadJavaScriptSemanticTextLength%2CconstructJavaScriptSemanticTextUnits%7D%20from%20%27.%2Fjavascript-semantic-values.js%27%3B%0Aimport%20%7BreadJavaScriptLiteralPropertyIndex%7D%20from%20%27.%2Fjavascript-literal-property-rules.js%27%3B%0Aimport%20%7BfindJavaScriptHeapDirectoryProperty%7D%20from%20%27.%2Fjavascript-ordinary-heap-directory.js%27%3B%0A%2F%2A%2A%20%40typedef%20%7B%7B%24%3A%27arrayPropertyPlan%27%2Cobject%3AJavaScriptOrdinaryObject%2Csuccess%3Aboolean%2Cerror%3Astring%2CerrorClass%3Astring%2Cwrites%3Astring%5B%5D%7D%7D%20JavaScriptArrayPropertyPlan%20%2A%2F%0A%2F%2A%2A%20%40returns%20%7BJavaScriptSemanticValue%7D%20%2A%2F%0Aexport%20function%20readJavaScriptArrayLengthKey%28%29%7Breturn%20%7B%24%3A%27text%27%2Cunits%3A%5B108%2C101%2C110%2C103%2C116%2C104%5D%7D%3B%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20key%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptArrayLengthKey%28key%29%7Breturn%20testJavaScriptSemanticSameValue%28key%2CreadJavaScriptArrayLengthKey%28%29%29%3B%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20key%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readJavaScriptArrayIndex%28key%29%7Bconst%20length%3DreadJavaScriptSemanticTextLength%28key%29%3Breturn%20length%3C0%7C%7Clength%3E10%3F-1%3AreadJavaScriptLiteralPropertyIndex%28constructJavaScriptSemanticTextUnits%28key%2C10%29%29%3B%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryProperty%5B%5D%7D%20properties%20%40param%20%7BJavaScriptSemanticValue%7D%20key%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20findJavaScriptArrayProperty%28properties%2Ckey%29%7Breturn%20findJavaScriptHeapDirectoryProperty%28properties%2Ckey%29%3B%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryObject%7D%20object%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readJavaScriptArrayLength%28object%29%7B%0A%20const%20property%3Dobject.properties%5BfindJavaScriptArrayProperty%28object.properties%2CreadJavaScriptArrayLengthKey%28%29%29%5D%3B%0A%20return%20property%3D%3D%3Dundefined%3F-1%3AreadJavaScriptArrayLengthValue%28property.descriptor.value%29%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bnumber%7D%20%2A%2F%0Afunction%20readJavaScriptArrayLengthValue%28value%29%7B%0A%20switch%28value.%24%29%7B%0A%20%20case%20%27number%27%3Areturn%20value.value%3B%0A%20%20default%3Areturn%20-1%3B%0A%20%7D%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20length%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptArrayLength%28length%29%7Breturn%20Number.isInteger%28length%29%26%26length%3E%3D0%26%26length%3C%3D4294967295%26%26%21Object.is%28length%2C-0%29%3B%7D%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryObject%7D%20object%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptArrayObjectError%28object%29%7B%0A%20if%28object.callable%29return%20%27an%20Array%20exotic%20object%20is%20not%20callable%27%3B%0A%20const%20property%3Dobject.properties%5BfindJavaScriptArrayProperty%28object.properties%2CreadJavaScriptArrayLengthKey%28%29%29%5D%3B%0A%20const%20invalid%3D%27an%20Array%20retains%20its%20actual%20nonenumerable%20nonconfigurable%20integral%20length%20data%20property%27%3B%0A%20if%28property%3D%3D%3Dundefined%7C%7C%21property.descriptor.valuePresent%7C%7Cproperty.descriptor.getterPresent%7C%7Cproperty.descriptor.setterPresent%7C%