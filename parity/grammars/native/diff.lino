(grammar (start source))
(extra (class plain (char %20) (char %09) (char %0B) (char %0C)))
(rule source normal (seq (repeat0 (choice ordered (ref block) (seq (ref line) (alias newline (token (seq (optional (literal %0D)) (literal %0A))))) (alias newline (immediateToken (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (optional (literal %0D)) (literal %0A)))))) (choice ordered (ref line) empty)))
(rule line silent (choice ordered (ref file_change) (ref binary_change) (ref index) (ref similarity) (ref old_file) (ref new_file) (ref location) (ref addition) (ref deletion) (ref context) (ref comment)))
(rule header silent (choice ordered (ref file_change) (ref binary_change) (ref index) (ref similarity)))
(rule block normal (seq (ref command) (choice ordered (alias newline (token (seq (optional (literal %0D)) (literal %0A)))) (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (not (immediateToken any)))) (repeat0 (seq (ref header) (choice ordered (alias newline (token (seq (optional (literal %0D)) (literal %0A)))) (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (not (immediateToken any)))))) (not (seq (ref header) (choice ordered (alias newline (token (seq (optional (literal %0D)) (literal %0A)))) (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (not (immediateToken any)))))) (choice ordered (seq (ref old_file) (alias newline (token (seq (optional (literal %0D)) (literal %0A)))) (ref new_file) (alias newline (token (seq (optional (literal %0D)) (literal %0A)))) (ref hunks)) empty)))
(rule hunks normal (seq (repeat1 (ref hunk)) (not (seq (ref location) (choice ordered (alias newline (token (seq (optional (literal %0D)) (literal %0A)))) (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (not (immediateToken any))))))))
(rule hunk normal (seq (capture labeled location (ref location)) (choice ordered (alias newline (token (seq (optional (literal %0D)) (literal %0A)))) (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (not (immediateToken any)))) (choice ordered (capture labeled changes (ref changes)) empty)))
(rule changes normal (seq (repeat1 (seq (ref change) (choice ordered (seq (repeat1 (alias newline (token (seq (optional (literal %0D)) (literal %0A))))) (not (alias newline (token (seq (optional (literal %0D)) (literal %0A)))))) (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (not (immediateToken any)))))) (not (seq (ref change) (choice ordered (alias newline (token (seq (optional (literal %0D)) (literal %0A)))) (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (not (immediateToken any))))))))
(rule change silent (choice ordered (ref addition) (ref deletion) (ref context)))
(rule command normal (seq (immediateToken (literal diff)) (alias argument (token (repeat1 (class plain (range A Z) (range a z) (range 0 9) (char _) (char -))))) (ref filename)))
(rule file_change normal (choice ordered (seq (choice ordered (immediateToken (literal new)) (immediateToken (literal deleted))) (literal file) (literal mode) (ref mode)) (seq (choice ordered (immediateToken (literal new)) (immediateToken (literal old))) (literal mode) (ref mode)) (seq (immediateToken (literal rename)) (choice ordered (literal from) (literal to)) (ref filename))))
(rule binary_change normal (seq (immediateToken (literal Binary)) (literal files) (alias filename (repeat1 (seq (not (token (seq (literal and) (not (class negated (char %20) (char %09) (char %0B) (char %0C) (char %0D) (char %0A)))))) (alias word (token (repeat1 (class negated (char %20) (char %09) (char %0B) (char %0C) (char %0D) (char %0A)))))))) (literal and) (alias filename (repeat1 (seq (not (token (seq (literal differ) (not (class negated (char %20) (char %09) (char %0B) (char %0C) (char %0D) (char %0A)))))) (alias word (token (repeat1 (class negated (char %20) (char %09) (char %0B) (char %0C) (char %0D) (char %0A)))))))) (literal differ)))
(rule index normal (seq (immediateToken (literal index)) (ref commit) (literal ..) (ref commit) (choice ordered (ref mode) empty)))
(rule similarity normal (seq (immediateToken (literal similarity)) (literal index) (alias score (token (repeat1 (range 0 9)))) (literal %25)))
(rule old_file normal (seq (immediateToken (literal ---)) (not (immediateToken (literal -))) (ref filename)))
(rule new_file normal (seq (immediateToken (literal %2B%2B%2B)) (not (immediateToken (literal %2B))) (ref filename)))
(rule location normal (seq (immediateToken (literal %40%40)) (ref linerange) (ref linerange) (literal %40%40) (choice ordered (alias anything (immediateToken (repeat1 (class negated (char %0D) (char %0A))))) empty)))
(rule addition normal (choice ordered (seq (immediateToken (literal %2B%2B%2B%2B)) (choice ordered (alias anything (immediateToken (repeat1 (class negated (char %0D) (char %0A))))) empty)) (seq (immediateToken (literal %2B%2B%2B)) (alias anything (immediateToken (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (class negated (char %20) (char %09) (char %0B) (char %0C) (char %0D) (char %0A)) (repeat0 (class negated (char %0D) (char %0A))))))) (immediateToken (literal %2B%2B%2B)) (seq (immediateToken (literal %2B%2B)) (choice ordered (alias anything (immediateToken (repeat1 (class negated (char %0D) (char %0A))))) empty)) (seq (immediateToken (literal %2B)) (choice ordered (alias anything (immediateToken (repeat1 (class negated (char %0D) (char %0A))))) empty))))
(rule deletion normal (choice ordered (seq (immediateToken (literal ----)) (choice ordered (alias anything (immediateToken (repeat1 (class negated (char %0D) (char %0A))))) empty)) (seq (immediateToken (literal ---)) (alias anything (immediateToken (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (class negated (char %20) (char %09) (char %0B) (char %0C) (char %0D) (char %0A)) (repeat0 (class negated (char %0D) (char %0A))))))) (immediateToken (literal ---)) (seq (immediateToken (literal --)) (choice ordered (alias anything (immediateToken (repeat1 (class negated (char %0D) (char %0A))))) empty)) (seq (immediateToken (literal -)) (choice ordered (alias anything (immediateToken (repeat1 (class negated (char %0D) (char %0A))))) empty))))
(rule context silent (seq (not (immediateToken (choice ordered (literal diff) (literal Binary) (literal index) (literal similarity) (literal new) (literal deleted) (literal old) (literal rename) (literal %40%40) (literal %2B) (literal -) (literal %23)))) (not (immediateToken (seq (repeat0 (class plain (char %20) (char %09) (char %0B) (char %0C))) (choice ordered (literal %0A) (literal %0D%0A))))) (alias context (immediateToken (repeat1 (class negated (char %0D) (char %0A)))))))
(rule comment normal (seq (immediateToken (literal %23)) (choice ordered (alias anything (immediateToken (repeat1 (class negated (char %0D) (char %0A))))) empty)))
(rule filename normal (repeat1 (seq (alias word (token (repeat1 (class negated (char %20) (char %09) (char %0B) (char %0C) (char %0D) (char %0A))))))))
(rule commit silent (alias commit (token (repeat 4 40 (class plain (range 0 9) (range a f))))))
(rule mode silent (alias mode (token (repeat1 (range 0 9)))))
(rule linerange silent (alias linerange (token (seq (class plain (char %2B) (char -)) (repeat1 (range 0 9)) (optional (seq (literal %2C) (repeat1 (range 0 9))))))))
