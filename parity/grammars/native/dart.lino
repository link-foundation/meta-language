(rule import_name_filter normal (choice unordered (seq (token (seq (literal show) (not (ref word_characters)))) (seq (ref identifier) (repeat0 (seq (literal %2C) (ref identifier))))) (seq (token (seq (literal hide) (not (ref word_characters)))) (seq (ref identifier) (repeat0 (seq (literal %2C) (ref identifier)))))) (concept grammar.import-name-filter) (source-names (tree-sitter combinator)))
(rule dotted_identifier_list normal (seq (ref identifier) (repeat0 (seq (literal .) (ref identifier)))) (concept grammar.dotted-identifier-list))
(rule metadata silent (repeat1 (ref annotation_body)) (concept grammar.metadata) (source-names (tree-sitter _metadata)))
(rule annotation_body silent (choice unordered (alias annotation (ref annotation_with_arguments)) (alias annotation (ref annotation_no_arguments))) (concept grammar.annotation-body) (source-names (tree-sitter _annotation)))
