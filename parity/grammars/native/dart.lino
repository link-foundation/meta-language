(rule type_not_function silent (choice unordered (seq (alias type (ref ordinary_type_body)) (optional (alias type (literal %3F)))) (seq (alias type (ref ordinary_function_keyword_body)) (optional (alias type (literal %3F)))) (seq (alias type (ref ordinary_record_type_body)) (optional (alias type (literal %3F)))) (alias type (ref ordinary_void_type_body))) (concept grammar.type-not-function) (source-names (tree-sitter _type_not_function)))
