(rule source_file normal (seq (optional (ref script_tag)) (optional (ref library_name)) (repeat0 (ref import_or_export)) (repeat0 (ref part_directive)) (repeat0 (ref part_of_directive)) (repeat0 (ref top_level_definition))) (concept grammar.source-file))
(rule top_level_definition silent (choice unordered (ref declaration_body) (ref function_declaration) (ref property_reader_declaration) (ref setter_declaration) (ref external_function_declaration) (ref external_property_reader_declaration) (ref external_setter_declaration) (ref top_level_variable_declaration) (ref external_variable_declaration)) (concept grammar.top-level-definition) (source-names (tree-sitter _top_level_definition)))
