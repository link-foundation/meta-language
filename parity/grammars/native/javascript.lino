(rule rest_pattern normal (precedence 0 right (seq (literal ...) (ref left_hand_side_expression))) (concept grammar.rest-pattern))
(rule method_definition normal (seq (repeat0 (capture labeled decorator (ref decorator))) (optional (choice unordered (token (seq (literal static) (not (ref word_characters)))) (alias %27static%20get (token (seq (literal static) (repeat1 (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))) (literal get) (seq (repeat0 (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))) (literal %0A))))))) (optional (token (seq (literal async) (not (ref word_characters))))) (optional (choice unordered (token (seq (literal get) (not (ref word_characters)))) (token (seq (literal set) (not (ref word_characters)))) (literal %2A))) (capture labeled name (ref property_name)) (capture labeled parameters (ref formal_parameters)) (capture labeled body (ref statement_block))) (concept grammar.method-definition))
(rule pair normal (seq (capture labeled key (ref property_name)) (literal %3A) (capture labeled value (ref expression))) (concept grammar.pair))
(rule pair_pattern normal (seq (capture labeled key (ref property_name)) (literal %3A) (capture labeled value (choice unordered (ref pattern) (ref assignment_pattern)))) (concept grammar.pair-pattern))
(rule property_name silent (choice unordered (alias property_identifier (choice unordered (ref identifier) (ref reserved_identifier))) (ref private_property_identifier) (ref string) (ref number) (ref computed_property_name)) (concept grammar.property-name) (source-names (tree-sitter _property_name)))
(rule computed_property_name normal (seq (literal %5B) (ref expression) (literal %5D)) (concept grammar.computed-property-name))
(rule reserved_identifier silent (choice unordered (token (seq (literal get) (not (ref word_characters)))) (token (seq (literal set) (not (ref word_characters)))) (token (seq (literal async) (not (ref word_characters)))) (token (seq (literal await) (not (ref word_characters)))) (token (seq (literal static) (not (ref word_characters)))) (token (seq (literal export) (not (ref word_characters)))) (token (seq (literal let) (not (ref word_characters))))) (concept grammar.reserved-identifier) (source-names (tree-sitter _reserved_identifier)))
(rule semicolon silent (choice unordered (alias unnamed_token (immediateToken (ref automatic_semicolon))) (literal %3B)) (concept grammar.semicolon) (source-names (tree-sitter _semicolon)))
