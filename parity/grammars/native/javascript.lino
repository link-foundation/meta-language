(rule decorator_call_expression normal (namedPrecedence call none (seq (capture labeled function (choice unordered (ref identifier) (alias member_expression (ref decorator_member_expression)))) (capture labeled arguments (ref arguments)))) (concept grammar.decorator-call-expression))
