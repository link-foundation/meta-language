(kind optional_semicolon (source-names (tree-sitter _optional_semi)))
(rule compilation_unit normal (seq (optional (ref shebang_directive)) (repeat0 (ref top_level_item))) (concept grammar.compilation-unit))
(rule top_level_item silent (precedence 2 none (choice ordered (ref top_level_item_no_statement) (ref global_statement))) (concept grammar.top-level-item) (source-names (tree-sitter _top_level_item)))
(rule top_level_item_no_statement silent (choice unordered (ref extern_alias_directive) (ref using_directive) (ref global_attribute) (alias preprocessor_conditional_directive (ref preprocessor_if_in_top_level)) (ref namespace_member_declaration) (ref file_scoped_namespace_declaration)) (concept grammar.top-level-item-no-statement) (source-names (tree-sitter _top_level_item_no_statement)))
(rule global_statement normal (precedence 1 none (ref statement)) (concept grammar.global-statement))
(rule extern_alias_directive normal (seq (token (seq (literal extern) (not (ref word_characters)))) (token (seq (literal alias) (not (ref word_characters)))) (capture labeled name (ref identifier)) (literal %3B)) (concept grammar.extern-alias-directive))
(rule using_directive normal (seq (optional (token (seq (literal global) (not (ref word_characters))))) (token (seq (literal using) (not (ref word_characters)))) (choice unordered (seq (optional (token (seq (literal unsafe) (not (ref word_characters))))) (capture labeled name (ref identifier)) (literal %3D) (ref type)) (seq (repeat0 (choice unordered (token (seq (literal static) (not (ref word_characters)))) (token (seq (literal unsafe) (not (ref word_characters)))))) (ref name))) (literal %3B)) (concept grammar.using-directive))
(rule global_attribute normal (seq (literal %5B) (choice unordered (token (seq (literal assembly) (not (ref word_characters)))) (token (seq (literal module) (not (ref word_characters))))) (literal %3A) (seq (ref attribute) (repeat0 (seq (literal %2C) (ref attribute)))) (optional (literal %2C)) (literal %5D)) (concept grammar.global-attribute))
(rule attribute normal (seq (capture labeled name (ref name)) (optional (ref attribute_argument_list))) (concept program.attributes))
(rule attribute_argument_list normal (precedence -1 none (seq (literal %28) (optional (seq (ref attribute_argument) (repeat0 (seq (literal %2C) (ref attribute_argument))))) (literal %29))) (concept grammar.attribute-argument-list))
(rule attribute_argument normal (precedence -1 none (choice ordered (seq (precedence 1 none (seq (capture labeled name (ref identifier)) (choice unordered (literal %3A) (literal %3D)))) (ref expression)) (ref expression))) (concept grammar.attribute-argument))
(rule attribute_list normal (seq (literal %5B) (optional (ref attribute_target_specifier)) (seq (ref attribute) (repeat0 (seq (literal %2C) (ref attribute)))) (optional (literal %2C)) (literal %5D)) (concept grammar.attribute-list))
(rule attribute_list_body silent (choice unordered (ref attribute_list) (ref preprocessor_if_in_attribute_list)) (concept grammar.attribute-list-body) (source-names (tree-sitter _attribute_list)))
(rule attribute_target_specifier normal (seq (choice unordered (token (seq (literal field) (not (ref word_characters)))) (token (seq (literal event) (not (ref word_characters)))) (token (seq (literal method) (not (ref word_characters)))) (token (seq (literal param) (not (ref word_characters)))) (token (seq (literal property) (not (ref word_characters)))) (token (seq (literal return) (not (ref word_characters)))) (token (seq (literal type) (not (ref word_characters)))) (token (seq (literal typevar) (not (ref word_characters))))) (literal %3A)) (concept grammar.attribute-target-specifier))
(rule namespace_member_declaration silent (choice unordered (ref namespace_declaration) (ref type_declaration)) (concept grammar.namespace-member-declaration) (source-names (tree-sitter _namespace_member_declaration)))
(rule namespace_declaration normal (seq (token (seq (literal namespace) (not (ref word_characters)))) (capture labeled name (ref name)) (capture labeled body (ref declaration_list)) (alias unnamed_token (immediateToken (ref optional_semicolon)))) (concept grammar.namespace-declaration))
(rule file_scoped_namespace_declaration normal (seq (token (seq (literal namespace) (not (ref word_characters)))) (capture labeled name (ref name)) (literal %3B)) (concept grammar.file-scoped-namespace-declaration))
(rule type_declaration silent (choice unordered (ref class_declaration) (ref structure_declaration) (ref enumeration_declaration) (ref interface_declaration) (ref delegate_declaration) (ref record_declaration)) (concept grammar.type-declaration))
(rule class_declaration normal (seq (ref class_declaration_initializer) (ref declaration_list_body)) (concept grammar.class-declaration))
(rule class_declaration_initializer silent (seq (repeat0 (ref attribute_list_body)) (repeat0 (ref modifier)) (token (seq (literal class) (not (ref word_characters)))) (capture labeled name (ref identifier)) (repeat0 (choice unordered (dynamicPrecedence -1 (ref type_parameter_list)) (dynamicPrecedence -1 (ref parameter_list)) (ref base_list))) (repeat0 (ref type_parameter_constraints_clause))) (concept grammar.class-declaration-initializer) (source-names (tree-sitter _class_declaration_initializer)))
(rule structure_declaration normal (seq (ref structure_declaration_initializer) (ref declaration_list_body)) (concept grammar.structure-declaration) (source-names (tree-sitter struct_declaration)))
(rule structure_declaration_initializer silent (seq (repeat0 (ref attribute_list_body)) (repeat0 (ref modifier)) (optional (token (seq (literal ref) (not (ref word_characters))))) (token (seq (literal struct) (not (ref word_characters)))) (capture labeled name (ref identifier)) (repeat0 (choice unordered (ref type_parameter_list) (ref parameter_list) (ref base_list))) (repeat0 (ref type_parameter_constraints_clause))) (concept grammar.structure-declaration-initializer) (source-names (tree-sitter _struct_declaration_initializer)))
(rule enumeration_declaration normal (seq (ref enumeration_declaration_initializer) (choice unordered (seq (capture labeled body (ref enumeration_member_declaration_list)) (alias unnamed_token (immediateToken (ref optional_semicolon)))) (literal %3B))) (concept grammar.enumeration-declaration) (source-names (tree-sitter enum_declaration)))
(rule enumeration_declaration_initializer silent (seq (repeat0 (ref attribute_list_body)) (repeat0 (ref modifier)) (token (seq (literal enum) (not (ref word_characters)))) (capture labeled name (ref identifier)) (optional (ref base_list))) (concept grammar.enumeration-declaration-initializer) (source-names (tree-sitter _enum_declaration_initializer)))
(rule enumeration_member_declaration_list normal (seq (literal %7B) (optional (seq (choice unordered (ref enumeration_member_declaration) (alias preprocessor_conditional_directive (ref preprocessor_if_in_enumeration_member_declaration))) (repeat0 (seq (literal %2C) (choice unordered (ref enumeration_member_declaration) (alias preprocessor_conditional_directive (ref preprocessor_if_in_enumeration_member_declaration))))))) (optional (literal %2C)) (literal %7D)) (concept grammar.enumeration-member-declaration-list) (source-names (tree-sitter enum_member_declaration_list)))
(rule enumeration_member_declaration normal (seq (repeat0 (ref attribute_list_body)) (capture labeled name (ref identifier)) (optional (seq (literal %3D) (capture labeled value (ref expression))))) (concept grammar.enumeration-member-declaration) (source-names (tree-sitter enum_member_declaration)))
(rule interface_declaration normal (seq (ref interface_declaration_initializer) (ref declaration_list_body)) (concept grammar.interface-declaration))
(rule interface_declaration_initializer silent (seq (repeat0 (ref attribute_list_body)) (repeat0 (ref modifier)) (token (seq (literal interface) (not (ref word_characters)))) (capture labeled name (ref identifier)) (capture labeled type_parameters (optional (ref type_parameter_list))) (optional (ref base_list)) (repeat0 (ref type_parameter_constraints_clause))) (concept grammar.interface-declaration-initializer) (source-names (tree-sitter _interface_declaration_initializer)))
(rule delegate_declaration normal (seq (ref delegate_declaration_initializer) (repeat0 (ref type_parameter_constraints_clause)) (literal %3B)) (concept grammar.delegate-declaration))
(rule delegate_declaration_initializer silent (seq (repeat0 (ref attribute_list_body)) (repeat0 (ref modifier)) (token (seq (literal delegate) (not (ref word_characters)))) (capture labeled type (ref type)) (capture labeled name (ref identifier)) (capture labeled type_parameters (optional (ref type_parameter_list))) (capture labeled parameters (ref parameter_list))) (concept grammar.delegate-declaration-initializer) (source-names (tree-sitter _delegate_declaration_initializer)))
(rule record_declaration normal (seq (ref record_declaration_initializer) (ref declaration_list_body)) (concept grammar.record-declaration))
(rule record_declaration_initializer silent (seq (repeat0 (ref attribute_list_body)) (repeat0 (ref modifier)) (token (seq (literal record) (not (ref word_characters)))) (optional (choice unordered (token (seq (literal class) (not (ref word_characters)))) (token (seq (literal struct) (not (ref word_characters)))))) (capture labeled name (ref identifier)) (repeat0 (choice unordered (ref type_parameter_list) (ref parameter_list))) (optional (alias base_list (ref record_base))) (repeat0 (ref type_parameter_constraints_clause))) (concept grammar.record-declaration-initializer) (source-names (tree-sitter _record_declaration_initializer)))
(rule record_base normal (choice unordered (seq (literal %3A) (seq (ref name) (repeat0 (seq (literal %2C) (ref name))))) (seq (literal %3A) (ref primary_constructor_base_type) (optional (seq (literal %2C) (seq (ref name) (repeat0 (seq (literal %2C) (ref name)))))))) (concept grammar.record-base))
(rule declaration_list_body silent (choice unordered (seq (capture labeled body (ref declaration_list)) (alias unnamed_token (immediateToken (ref optional_semicolon)))) (literal %3B)) (concept grammar.declaration-list-body) (source-names (tree-sitter _declaration_list_body)))
(rule primary_constructor_base_type normal (seq (capture labeled type (ref name)) (ref argument_list)) (concept grammar.primary-constructor-base-type))
(rule modifier normal (precedence 0 right (choice unordered (token (seq (literal abstract) (not (ref word_characters)))) (token (seq (literal async) (not (ref word_characters)))) (token (seq (literal const) (not (ref word_characters)))) (token (seq (literal extern) (not (ref word_characters)))) (token (seq (literal file) (not (ref word_characters)))) (token (seq (literal fixed) (not (ref word_characters)))) (token (seq (literal internal) (not (ref word_characters)))) (token (seq (literal new) (not (ref word_characters)))) (token (seq (literal override) (not (ref word_characters)))) (token (seq (literal partial) (not (ref word_characters)))) (token (seq (literal private) (not (ref word_characters)))) (token (seq (literal protected) (not (ref word_characters)))) (token (seq (literal public) (not (ref word_characters)))) (token (seq (literal readonly) (not (ref word_characters)))) (token (seq (literal required) (not (ref word_characters)))) (token (seq (literal sealed) (not (ref word_characters)))) (token (seq (literal static) (not (ref word_characters)))) (token (seq (literal unsafe) (not (ref word_characters)))) (token (seq (literal virtual) (not (ref word_characters)))) (token (seq (literal volatile) (not (ref word_characters)))))) (concept grammar.modifier))
(rule type_parameter_list normal (seq (literal %3C) (seq (ref type_parameter) (repeat0 (seq (literal %2C) (ref type_parameter)))) (literal %3E)) (concept grammar.type-parameter-list))
