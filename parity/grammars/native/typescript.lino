(rule object_type normal (seq (choice unordered (literal %7B) (literal %7B%7C)) (optional (seq (optional (choice unordered (literal %2C) (literal %3B))) (seq (choice unordered (ref export_statement) (ref property_signature) (ref call_signature) (ref construct_signature) (ref index_signature) (ref method_signature)) (repeat0 (seq (choice unordered (literal %2C) (ref semicolon)) (choice unordered (ref export_statement) (ref property_signature) (ref call_signature) (ref construct_signature) (ref index_signature) (ref method_signature))))) (optional (choice unordered (literal %2C) (ref semicolon))))) (choice unordered (literal %7D) (literal %7C%7D))) (concept grammar.object-type))
