(grammar (start program))
(rule program normal (choice ordered (seq (alias byte_order_mark (immediateToken (literal %EF%BB%BF))) (repeat0 (ref _token))) (repeat0 (ref _token))))
(rule _token silent (choice ordered (ref _skip) (ref extension) (ref _datum)))
(rule _skip silent (choice ordered (alias whitespace (immediateToken (repeat1 (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D) (char %C2%85) (char %C2%A0) (char %E1%9A%80) (range %E2%80%80 %E2%80%8A) (char %E2%80%A8) (char %E2%80%A9) (char %E2%80%AF) (char %E2%81%9F) (char %E3%80%80) (char %EF%BB%BF))))) (ref comment) (ref sexp_comment) (ref block_comment)))
