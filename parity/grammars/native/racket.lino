(rule string normal (seq (literal %22) (repeat0 (choice ordered (ref escape_sequence) (alias string_text (immediateToken (repeat1 (class negated (char %22) (char %5C))))))) (literal %22)))
(rule byte_string normal (seq (literal %23) (seq (literal %22) (repeat0 (choice ordered (ref escape_sequence) (alias string_text (immediateToken (repeat1 (class negated (char %22) (char %5C))))))) (literal %22))))
(rule here_string normal (seq (literal %23%3C%3C) (ref here_terminator) (repeat0 (seq (ref here_newline) (ref here_line))) (ref here_newline) (ref here_end)))
(rule here_terminator token (repeat0 (class negated (char %0A))) (action (set here matched)))
(rule here_newline token (literal %0A))
(rule here_line token (repeat0 (class negated (char %0A))) (action (if (equal matched (variable here)) (then fail))))
(rule here_end token (repeat0 (class negated (char %0A))) (action (if (not (equal matched (variable here))) (then fail))))
