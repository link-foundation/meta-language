(rule comment token (choice unordered (seq (literal %3B) (repeat0 (class negated (char %0D) (char %0A) (char %C2%85) (char %E2%80%A8) (char %E2%80%A9)))) (seq (choice unordered (literal %23%21%20) (literal %23%21%2F)) (repeat0 (seq (repeat0 (class negated (char %0D) (char %0A) (char %C2%85) (char %E2%80%A8) (char %E2%80%A9))) (literal %5C) (class plain (char %0D) (char %0A) (char %C2%85) (char %E2%80%A8) (char %E2%80%A9)))) (repeat0 (class negated (char %0D) (char %0A) (char %C2%85) (char %E2%80%A8) (char %E2%80%A9))))))
(rule block_comment normal (seq (literal %23%7C) (repeat0 (choice ordered (ref block_comment) (alias comment_text (immediateToken (repeat1 (seq (not (literal %23%7C)) (not (literal %7C%23)) any)))))) (literal %7C%23)))
(rule sexp_comment normal (seq (literal %23%3B) (repeat0 (ref _skip)) (ref _datum)))
(rule _datum silent (choice ordered (ref boolean) (ref string) (ref here_string) (ref byte_string) (ref character) (longest (ref number) (ref symbol)) (ref keyword) (ref regex) (ref box) (ref graph) (ref structure) (ref hash) (ref quote) (ref quasiquote) (ref syntax) (ref quasisyntax) (ref unquote_splicing) (ref unquote) (ref unsyntax_splicing) (ref unsyntax) (ref list) (ref vector)))
