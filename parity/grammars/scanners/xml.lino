(scanner processing_instruction_content (tokens processing_instruction_content) (operations (if (valid processing_instruction_content) (then  (while (not (some atEnd (next (literal %3F%3E)) (next (literal %0A)) (next (literal %3F)))) (do advance)) (if atEnd (then fail)) (if (not (next (seq (literal %3F%3E) (repeat0 (literal %20)) (literal %0A)))) (then fail)) (emit processing_instruction_content))) fail))
(scanner comment (tokens comment) (operations (if (not (valid comment)) (then fail)) (consume (literal %3C%21--)) (push levels (integer 1)) (while (greater (depth levels) (integer 0)) (do (if atEnd (then fail)) (if (next (literal --)) (then (consume (literal --)) (pop levels)) (else advance)))) (consume (literal %3E)) (emit comment)))
(scanner character_data (tokens character_data) (operations (if (valid character_data) (then (if (some atEnd (next (literal %3C)) (next (literal %26))) (then fail)) (if (next (literal %5D%5D%3E)) (then (consume (literal %5D%5D%3E)))) (while (not (some atEnd (next (literal %3C)) (next (literal %26)))) (do (if (some (next (literal %5D%5D%3E))) (then fail)) advance)) (emit character_data))) fail))
(scanner character_data_section (tokens character_data_section) (operations (if (valid character_data_section) (then (if (some atEnd (next (literal %5D%5D%3E))) (then fail)) (while (not (some atEnd (next (literal %5D%5D%3E)))) (do advance)) (if atEnd (then fail)) (emit character_data_section))) fail))
(rule processing_instruction_target token (predicate (seq (class plain (category L) (char _) (char %3A)) (repeat0 (class plain (category L) (category N) (char _) (char %3A) (char .) (char %C2%B7) (char -)))) (not (some (equal (matched) (text xml)) (equal (matched) (text xmL)) (equal (matched) (text xMl)) (equal (matched) (text xML)) (equal (matched) (text Xml)) (equal (matched) (text XmL)) (equal (matched) (text XMl)) (equal (matched) (text XML))))))
(rule start_tag_name token (seq (class plain (category L) (char _) (char %3A)) (repeat0 (class plain (category L) (category N) (char _) (char %3A) (char .) (char %C2%B7) (char -)))) (action (push element_tag_names (matched))))
(rule end_tag_name token (predicate (seq (class plain (category L) (char _) (char %3A)) (repeat0 (class plain (category L) (category N) (char _) (char %3A) (char .) (char %C2%B7) (char -)))) (all (greater (depth element_tag_names) (integer 0)) (equal (matched) (top element_tag_names)))) (action (pop element_tag_names)))
(rule self_closing_tag_end token (predicate (literal %2F%3E) (greater (depth element_tag_names) (integer 0))) (action (pop element_tag_names)))
(rule erroneous_end_name token (seq (not (choice unordered (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)) (class negated (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)))) any))
