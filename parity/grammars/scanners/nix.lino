(scanner string_fragment (tokens string_fragment) (operations (if (not (valid string_fragment)) (then fail)) (if (some atEnd (next (literal %22)) (next (literal %5C)) (next (literal %24%7B))) (then fail)) (while (not (some atEnd (next (literal %22)) (next (literal %5C)) (next (literal %24%7B)))) (do (if (some (next (literal %00))) (then fail)) (if (next (literal %24)) (then (consume (literal %24)) (if (not (some atEnd (next (literal %22)) (next (literal %5C)) (next (literal %7B)))) (then advance))) (else advance)))) (if atEnd (then fail)) (emit string_fragment)))
(scanner indented_string_fragment (tokens indented_string_fragment) (operations (if (not (valid indented_string_fragment)) (then fail)) (if (some atEnd (next (literal %27%27)) (next (literal %24%7B))) (then fail)) (while (not (some atEnd (next (literal %27%27)) (next (literal %24%7B)))) (do (if (some (next (literal %00))) (then fail)) (if (next (literal %24)) (then (consume (literal %24)) (if (not (some atEnd (next (literal %27)) (next (literal %7B)))) (then advance))) (else advance)))) (if atEnd (then fail)) (emit indented_string_fragment)))
(rule path_initial_plain_fragment token (seq (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -))) (literal %2F) (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -))) (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char -)) (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -)))))
(rule path_initial_interpolation_fragment token (seq (seq (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -))) (literal %2F) (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -)))) (and (literal %24))))
(rule path_fragment token (repeat1 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -))))
