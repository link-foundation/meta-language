  "references": ["parity/grammars/plain-text.ebnf", "parity/grammars/natural-language.ebnf"],
  "whitespace": {"categories": ["Z"], "ranges": [[9, 13]], "characters": [133]},
  "word": {"categories": ["L", "N", "M"], "characters": [95, 39, 45]},
  "rejectedControl": {"ranges": [[0, 8], [14, 31], [127, 132], [134, 159]]},
  "sentenceTerminals": [".", "!", "?", "।", "。", "؟", "۔", "！", "？"],
  "sentenceClosings": {"categories": ["Pe", "Pf"], "characters": [34, 39]},
  "lineEnding": "\n",
  "parentheses": {"opening": "(", "closing": ")"},
  "starts": {"plain": "text_document", "natural": "natural_language_document", "lexical": "lexical_document", "balance": "balanced_parenthesis_sequence"},
  "validation": {"plain": ["balanced_parenthesis_sequence"], "natural": []},
  "projection": {
    "text_document": {"term": "text_document"},
    "natural_language_document": {"term": "natural_language_document"},
    "text_line": {"term": "line"},
    "natural_language_sentence": {"term": "sentence"},
    "lexical_word": {"term": "word"},
    "lexical_punctuation": {"term": "punctuation"},
    "rejected_control": {"term": "ERROR", "error": true},
    "whitespace": {"term": "whitespace", "named": false, "extra": true}
  },
  "concepts": {
    "text_document": "grammar.text-document",
    "text_line": "grammar.text-line",
    "natural_language_document": "grammar.natural-language-document",
    "natural_language_sentence": "grammar.natural-language-sentence",
    "lexical_document": "grammar.lexical-document",
    "lexical_word": "grammar.lexical-word",
    "lexical_punctuation": "grammar.lexical-punctuation",
    "rejected_control": "grammar.rejected-control",
    "whitespace": "grammar.whitespace",
    "balanced_parenthesis_sequence": "grammar.balanced-parenthesis-sequence"
  }
}
