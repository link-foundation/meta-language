(* The built-in natural-language grammar of meta-language, shared by English,
   Mandarin Chinese, Hindi, Spanish, Modern Standard Arabic, French, Bengali,
   Portuguese, Russian and Urdu, and implemented by js/src/text-grammar.js and
   rust/src/structured_text_parser.rs. Node names are the CST terms. *)

natural_language_document = { sentence } ;
(* A sentence is the shortest text ending after a run of terminal
   punctuation, any closing punctuation or quotes, and the whitespace that
   follows them; trailing text without terminal punctuation is a sentence. *)
sentence    = { lexical }, terminal, { terminal }, { closing }, { ? White_Space ? }
            | { lexical } ;
terminal    = "." | "!" | "?" | "।" | "。" | "؟" | "۔" | "！" | "？" ;
closing     = ? Pe ? | ? Pf ? | '"' | "'" ;

(* The shared lexical grammar: maximal runs, matched in this order. *)
lexical     = whitespace | word | ERROR | punctuation ;
whitespace  = { ? White_Space ? }- ;                       (* anonymous extra *)
word        = { ? L | N | M ? | "_" | "'" | "-" }- ;
ERROR       = { ? U+0000-U+0008 U+000E-U+001F U+007F-U+0084 U+0086-U+009F ? }- ;
punctuation = { ? any other character ? }- ;
