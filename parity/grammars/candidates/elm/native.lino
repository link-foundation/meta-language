(rule file normal (seq (optional (seq (capture labeled moduleDeclaration (ref module_declaration)) (alias unnamed_token (immediateToken (ref virtual_end_declaration))))) (optional (ref import_list)) (optional (ref top_declaration_list))))
(rule block_comment normal (precedence 1 none (seq (literal %7B-) (alias unnamed_token (immediateToken (ref block_comment_content))) (literal -%7D))))
(rule line_comment token (lexicalPrecedence 1 (seq (seq (literal -) (literal -)) (repeat0 (class negated (char %0A) (char %0D))))))
(rule module_declaration normal (precedence 0 left (choice unordered (seq (optional (ref port)) (ref module) (capture labeled name (ref upper_case_qid)) (capture labeled exposing (ref exposing_list))) (seq (ref effect) (ref module) (capture labeled name (ref upper_case_qid)) (ref where) (ref record_expression) (capture labeled exposing (ref exposing_list))))))
(rule import_list silent (repeat1 (seq (ref import_clause) (alias unnamed_token (immediateToken (ref virtual_end_declaration))))) (source-names (tree-sitter _import_list)))
(rule top_declaration_list silent (repeat1 (seq (choice unordered (ref value_declaration) (ref type_alias_declaration) (ref type_declaration) (ref type_annotation) (ref port_annotation) (ref infix_declaration)) (alias unnamed_token (immediateToken (ref virtual_end_declaration))))) (source-names (tree-sitter _top_decl_list)))
(rule exposing_list normal (seq (ref exposing) (literal %28) (choice unordered (capture labeled doubleDot (ref double_dot)) (seq (choice unordered (ref exposed_value) (ref exposed_type) (ref exposed_operator)) (repeat0 (seq (literal %2C) (choice unordered (ref exposed_value) (ref exposed_type) (ref exposed_operator)))))) (literal %29)))
(rule exposed_value normal (ref lower_case_identifier))
(rule exposed_type normal (seq (ref upper_case_identifier) (optional (ref exposed_union_constructors))))
(rule exposed_union_constructors normal (seq (literal %28) (ref double_dot) (literal %29)))
(rule exposed_union_constructor normal (ref upper_case_identifier))
(rule exposed_operator normal (ref operator_as_function_inner))
(rule upper_case_identifier_without_leading_whitespace silent (alias unnamed_token (immediateToken (seq (class plain (category Lu)) (repeat0 (class plain (char _) (range 0 9) (category L)))))) (source-names (tree-sitter _upper_case_identifier_without_leading_whitespace)))
(rule lower_case_identifier_without_leading_whitespace silent (alias unnamed_token (immediateToken (seq (class plain (category Ll)) (repeat0 (class plain (char _) (range 0 9) (category L)))))) (source-names (tree-sitter _lower_case_identifier_without_leading_whitespace)))
(rule dot_without_leading_whitespace silent (immediateToken (literal .)) (source-names (tree-sitter _dot_without_leading_whitespace)))
(rule upper_case_qid normal (precedence 0 right (seq (ref upper_case_identifier) (repeat0 (seq (alias dot (ref dot_without_leading_whitespace)) (alias upper_case_identifier (immediateToken (seq (class plain (category Lu)) (repeat0 (class plain (char _) (range 0 9) (category L)))))))))))
(rule value_qid normal (choice unordered (ref lower_case_identifier) (seq (ref upper_case_identifier) (alias dot (ref dot_without_leading_whitespace)) (repeat0 (seq (alias upper_case_identifier (immediateToken (seq (class plain (category Lu)) (repeat0 (class plain (char _) (range 0 9) (category L)))))) (alias dot (ref dot_without_leading_whitespace)))) (alias lower_case_identifier (immediateToken (seq (class plain (category Ll)) (repeat0 (class plain (char _) (range 0 9) (category L)))))))))
(rule field_access_method_function_expression normal (seq (ref dot) (alias lower_case_identifier (immediateToken (seq (class plain (category Ll)) (repeat0 (class plain (char _) (range 0 9) (category L))))))) (source-names (tree-sitter field_accessor_function_expr)))
(rule import_clause normal (seq (ref import) (capture labeled moduleName (ref upper_case_qid)) (capture labeled asClause (optional (ref as_clause))) (capture labeled exposing (optional (ref exposing_list)))))
(rule as_clause normal (seq (ref as) (capture labeled name (ref upper_case_identifier))))
(rule value_declaration normal (seq (choice unordered (capture labeled functionDeclarationLeft (ref function_declaration_left)) (capture labeled pattern (ref pattern))) (ref eq) (capture labeled body (ref expression))))
(rule function_declaration_left normal (precedence 1 none (seq (ref lower_case_identifier) (capture labeled pattern (repeat0 (choice unordered (ref anything_pattern) (ref lower_pattern) (ref tuple_pattern) (ref nullary_constructor_argument_pattern) (ref unit_expression) (ref list_pattern) (ref record_pattern) (ref literal_expression_group) (ref parenthesized_pattern)))))))
(rule type_declaration normal (precedence 0 left (seq (ref type) (capture labeled name (ref upper_case_identifier)) (capture labeled typeName (repeat0 (ref lower_type_name))) (ref eq) (capture labeled unionVariant (ref union_variant)) (repeat0 (ref more_union_variants)))))
(rule lower_type_name normal (ref lower_case_identifier))
(rule union_variant normal (precedence 0 left (seq (capture labeled name (ref upper_case_identifier)) (repeat0 (choice unordered (ref line_comment) (ref single_type_expression))))))
(rule more_union_variants silent (seq (literal %7C) (capture labeled unionVariant (ref union_variant))) (source-names (tree-sitter _more_union_variants)))
(rule type_alias_declaration normal (seq (ref type) (ref alias) (capture labeled name (ref upper_case_identifier)) (capture labeled typeVariable (repeat0 (ref lower_type_name))) (ref eq) (capture labeled typeExpression (ref type_expression))))
(rule type_expression normal (seq (ref type_expression_inner) (repeat0 (seq (ref arrow) (ref type_expression_inner)))))
(rule type_expression_inner silent (choice unordered (ref type_ref) (ref single_type_expression)) (source-names (tree-sitter _type_expression_inner)))
(rule type_ref normal (seq (ref upper_case_qid) (repeat1 (ref single_type_expression))))
(rule single_type_expression silent (choice unordered (capture labeled part (alias type_ref (ref type_ref_without_arguments))) (capture labeled part (ref type_variable)) (capture labeled part (ref record_type)) (capture labeled part (ref tuple_type)) (seq (literal %28) (capture labeled part (ref type_expression)) (literal %29))) (source-names (tree-sitter _single_type_expression)))
(rule type_ref_without_arguments normal (ref upper_case_qid) (source-names (tree-sitter type_ref_without_args)))
(rule type_variable normal (ref lower_case_identifier))
(rule record_type normal (seq (literal %7B) (optional (seq (optional (ref record_base)) (seq (capture labeled fieldType (ref field_type)) (repeat0 (seq (literal %2C) (capture labeled fieldType (ref field_type))))))) (literal %7D)))
(rule field_type normal (seq (capture labeled name (ref lower_case_identifier)) (ref colon) (capture labeled typeExpression (ref type_expression))))
(rule tuple_type normal (choice unordered (capture labeled unitExpr (ref unit_expression)) (seq (literal %28) (capture labeled typeExpression (ref type_expression)) (repeat1 (seq (literal %2C) (capture labeled typeExpression (ref type_expression)))) (literal %29))))
(rule type_annotation normal (seq (capture labeled name (ref lower_case_identifier)) (ref colon) (capture labeled typeExpression (ref type_expression))))
(rule port_annotation normal (seq (ref port) (capture labeled name (ref lower_case_identifier)) (ref colon) (capture labeled typeExpression (ref type_expression))))
(rule expression silent (choice unordered (ref bin_operator_expression) (ref call_or_atom)) (source-names (tree-sitter _expression)))
(rule bin_operator_expression normal (capture labeled part (precedence 1 none (seq (ref call_or_atom) (precedence 0 right (repeat1 (seq (ref operator) (ref call_or_atom))))))) (source-names (tree-sitter bin_op_expr)))
(rule operator normal (ref operator_identifier))
(rule operator_as_function_expression normal (ref operator_as_function_inner) (source-names (tree-sitter operator_as_function_expr)))
(rule operator_as_function_inner silent (seq (literal %28) (capture labeled operator (ref operator_identifier)) (literal %29)) (source-names (tree-sitter _operator_as_function_inner)))
(rule call_or_atom silent (choice unordered (ref function_call_expression) (ref atom)) (source-names (tree-sitter _call_or_atom)))
