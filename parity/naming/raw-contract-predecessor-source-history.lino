tes%3DBuffer.from%28source%29%2Cedit%3Dhistory.edit%3B%0A%20%20assert.equal%28edit.offsetUnit%2C%27UTF-8%20bytes%27%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%26%26Number.isSafeInteger%28edit.end%29%0A%20%20%20%20%26%26edit.start%3E%3D0%26%26edit.end%3E%3Dedit.start%26%26edit.end%3C%3Dbytes.length%29%3B%0A%20%20assert.equal%28bytes.subarray%28edit.start%2Cedit.end%29.toString%28%27utf8%27%29%2Cedit.inserted%29%3B%0A%20%20const%20previous%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20assert.equal%28previous.toString%28%27utf8%27%29%2Chistory.source%29%3B%0A%20%20verifyGitArtifactCertificate%28history.certificate%2Cprevious%2C%7Brevision%3Ahistory.revision%2Cpath%3Ahistory.path%7D%29%3B%0A%20%20return%20history.source%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
