%2C%0A%20%20%20%20current%3A%7Bbytes%3ABuffer.byteLength%28actual%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28actual%29.digest%28%27hex%27%29%7D%2C%0A%20%20%20%20edit%3A%7BoffsetUnit%3A%27UTF-8%20bytes%27%2Cstart%2Cend%3Astart%2BBuffer.byteLength%28after%29%2Cremoved%3Abefore%2Cinserted%3Aafter%7D%2C%0A%20%20%20%20boundary%3A%27Every%20grammar%20test%20runs%20exactly%20once%20in%20six%20required%20cells%2C%20with%20the%20original%20commands%2C%20assertions%2C%20fail-fast%20setting%20and%20fifteen-minute%20deadline.%20The%20preceding%20source%20and%20complete%20scheduling%20inverse%20are%20independently%20certified.%20Corrected%20CI%20timing%20and%20native%20behavior%20remain%20unverified.%27%7D%3B%0A%20%20const%20file%3Dnew%20URL%28%27parity%2Fself-translation%2Fgrammar-test-partition-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28file%2Cvalue%29%3Belse%20writeProjectData%28file%2Cvalue%29%3B%0A%20%20const%20reader%3Dnew%20URL%28%27.%2Fgrammar-test-partition-history.mjs%27%2Cimport.meta.url%29%2Ccurrent%3DreadFileSync%28reader%2C%27utf8%27%29%3B%0A%20%20const%20next%3Dcurrent.replace%28%2Fconst%20archiveHash%3D%27%28%3F%3Apending%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%2C%0A%20%20%20%20%22const%20archiveHash%3D%27%22%2BcreateHash%28%27sha256%27%29.update%28readFileSync%28file%29%29.digest%28%27hex%27%29%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28current%2Cnext%29%3Belse%20writeFileSync%28reader%2Cnext%29%3B%0A%20%20return%20value%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateGrammarTestPartitionHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
