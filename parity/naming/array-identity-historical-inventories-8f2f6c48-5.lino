(58621: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20The%20surface%20AST%20the%20four%20frontends%20produce%20and%20the%20checker%20consumes.%0A%2F%2F%21%0A%2F%2F%21%20Its%20JSON%20form%20is%20the%20JavaScript%20runtime%27s%20%28%60%7B%20%22k%22%3A%20%22binary%22%2C%20%22op%22%3A%20%22add%22%2C%20%E2%80%A6%20%7D%60%29%2C%0A%2F%2F%21%20so%20the%20frontends%20of%20both%20runtimes%20can%20be%20compared%20node%20for%20node.%0A%0Ause%20serde%3A%3A%7BDeserialize%2C%20Deserializer%2C%20Serialize%7D%3B%0A%0Ause%20super%3A%3Atypes%3A%3AType%3B%0Ause%20super%3A%3A%7BLanguage%2C%20Span%7D%3B%0A%0Amod%20externals%3B%0Apub%20use%20externals%3A%3A%7BExternal%2C%20ExternalParam%2C%20SImport%2C%20SImportName%7D%3B%0Amod%20array_item%3B%0Apub%20use%20array_item%3A%3ASArrayItem%3B%0Amod%20binding_type_annotation%3B%0Apub%20use%20binding_type_annotation%3A%3ASurfaceBindingTypeAnnotation%3B%0Amod%20raw_metadata%3B%0Apub%20use%20raw_metadata%3A%3ASurfaceRawMetadata%3B%0Amod%20nodes%3B%0Apub%20use%20nodes%3A%3ASNode%3B%0Apub%28crate%29%20mod%20array_bindings%3B%0Amod%20record_entry%3B%0Apub%20use%20record_entry%3A%3ASRecordEntry%3B%0Amod%20record_projection%3B%0A%0A%23%5Ballow%28clippy%3A%3Atrivially_copy_pass_by_ref%29%5D%20%2F%2F%20serde%20passes%20fields%20by%20reference%0Aconst%20fn%20is_false%28value%3A%20%26bool%29%20-%3E%20bool%20%7B%0A%20%20%20%20%21%2Avalue%0A%7D%0A%0A%2F%2F%2F%20Numeral%20text%3A%20the%20JavaScript%20frontends%20store%20some%20pattern%20numerals%20as%0A%2F%2F%2F%20numbers%20and%20others%20as%20decimal%20strings.%0Afn%20numeral%3C%27de%2C%20D%3A%20Deserializer%3C%27de%3E%3E%28deserializer%3A%20D%29%20-%3E%20Result%3CString%2C%20D%3A%3AError%3E%20%7B%0A%20%20%20%20%23%5Bderive%28Deserialize%29%5D%0A%20%20%20%20%23%5Bserde%28untagged%29%5D%0A%20%20%20%20enum%20Numeral%20%7B%0A%20%20%20%20%20%20%20%20Text%28String%29%2C%0A%20%20%20%20%20%20%20%20Number%28serde_json%3A%3ANumber%29%2C%0A%20%20%20%20%7D%0A%20%20%20%20Ok%28match%20Numeral%3A%3Ad