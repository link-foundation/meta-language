0optional%20type%20admits%20a%20particular%20absence%20case.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20fn%20accepts_absence%28%26self%2C%20actual%3A%20%26str%29%20-%3E%20bool%20%7B%0A%20%20%20%20%20%20%20%20match%20self%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20Self%3A%3AOption%20%7B%20absence%2C%20..%20%7D%20%3D%3E%20accept_optional_absence%28absence%2C%20actual%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20_%20%3D%3E%20false%2C%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20const%20fn%20is_numeric%28%26self%29%20-%3E%20bool%20%7B%0A%20%20%20%20%20%20%20%20matches%21%28self%2C%20Self%3A%3ANat%20%7C%20Self%3A%3AInt%20%7C%20Self%3A%3AFixed%20%7B%20..%20%7D%29%0A%20%20%20%20%7D%0A%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20const%20fn%20is_float%28%26self%29%20-%3E%20bool%20%7B%0A%20%20%20%20%20%20%20%20matches%21%28self%2C%20Self%3A%3AFloat%29%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20True%20for%20the%20types%20%60%3C%60%20orders%3A%20the%20integers%20and%20Numbers.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20const%20fn%20is_ordered%28%26self%29%20-%3E%20bool%20%7B%0A%20%20%20%20%20%20%20%20self.is_numeric%28%29%20%7C%7C%20self.is_float%28%29%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20True%20when%20every%20value%20of%20the%20type%20is%20a%20non-negative%20integer.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20const%20fn%20is_natural%28%26self%29%20-%3E%20bool%20%7B%0A%20%20%20%20%20%20%20%20matches%21%28self%2C%20Self%3A%3ANat%20%7C%20Self%3A%3AFixed%20%7B%20signed%3A%20false%2C%20..%20%7D%29%0A%20%20%20%20%7D%0A%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20const%20fn%20is_literal%28%26self%29%20-%3E%20bool%20%7B%0A%20%20%20%20%20%20%20%20matches%21%28self%2C%20Self%3A%3ALiteral%29%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20The%20element%20type%20of%20an%20array.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20fn%20element%28%26self%29%20-%3E%20Option%3C%26Self%3E%20%7B%0A%20%20%20%20%20%20%20%20match%20self%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20Self%3A%3AArray%20%7B%20element%2C%20..%20%7D%20%3D%3E%20Some%28element%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20_%20%3D%3E%20None%2C%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20The%20data%20type%27s%20qualified%20name.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20fn%20data_name%28%26self%29%20-%3E%20Option%3C%26str%3E%20%7B%0A%20%20%20%20%20%20%20%20match%20self%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20Self%3A%3AData%20%7B%20name%20%7D%20%3D%3E%20Some%28name%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20_%20%3D%3E%20None%2C%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%7D%0A%0A%2F%2F%2F%20Inclusive%20bounds%20of%20a%20machine-integer%20type.%0A%23%5Bmust_use%5D%0Apub%20fn%20fixed_bounds%28bits%3A%20u32%2C%20signed%3A%20bool%29%20-%3E%20%28i128%2C%20u128%29%20%7B%0A%20%20%20%20if%20signed%20%7B%0A%20%20%20%20%20%20%20%20let%20max%20%3D%20%281u128%20%3C%3C%20%28bits%20-%201%29%29%20-%201%3B%0A%20%20%20%20%20%20%20%20let%20min%20%3D%20-i128%3A%3Atry_from%28max%29.unwrap_or%28i128%3A%3AMAX%29%20-%201%3B%0A%20%20%20%20%20%20%20%20%28min%2C%20max%29%0A%20%20%20%20%7D%20else%20if%20bits%20%3E%3D%20128%20%7B%0A%20%20%20%20%20%20%20%20%280%2C%20u128%3A%3AMAX%29%0A%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20%20%20%280%2C%20%281u128%20%3C%3C%20bits%29%20-%201%29%0A%20%20%20%20%7D%0A%7D%0A%0A%2F%2F%2F%20%60u8%60%20%E2%80%A6%20%60i128%60%2C%20%60usize%60%2C%20%60isize%60%20%28the%20pointer-sized%20types%20are%2064%20bits%29.%0A%23%5Bmust_use%5D%0Apub%20fn%20rust_fixed_type%28name%3A%20%26str%29%20-%3E%20Option%3CType%3E%20%7B%0A%20%20%20%20let%20signed%20%3D%20match%20name.as_bytes%28%29.first%28%29%20%7B%0A%20%20%20%20%20%20%20%20Some%28b%27u%27%29%20%3D%3E%20false%2C%0A%20%20%20%20%20%20%20%20Some%28b%27i%27%29%20%3D%3E%20true%2C%0A%20%20%20%20%20%20%20%20_%20%3D%3E%20return%20None%2C%0A%20%20%20%20%7D%3B%0A%20%20%20%20let%20bi