(16824: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7B%20renderStringLengthExpression%2C%20readStringMapRefusal%2C%20renderStringTestExpression%2C%20readStringTestHelper%2C%20readStringTestSupport%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0Aimport%20%7BreadStringOrderRefusal%7D%20from%20%27.%2Fstring-order-rules.js%27%3B%0A%2F%2F%20Rocq%20emitter.%20Naturals%20become%20binary%20%60N%60%20and%20integers%20%60Z%60%2C%20so%20programs%0A%2F%2F%20run%20at%20their%20source%20sizes%20%28unary%20%60nat%60%20cannot%20hold%2020%21%29.%20Structural%0A%2F%2F%20recursion%20over%20data%20is%20a%20%60Fixpoint%60%3B%20recursion%20that%20decreases%20a%20natural%20is%0A%2F%2F%20a%20%60Function%60%20with%20the%20measure%20%60N.to_nat%60%2C%20whose%20obligations%20%60lia%60%0A%2F%2F%20discharges%20and%20whose%20equation%20lemma%20the%20reconstructed%20proofs%20rewrite%20with.%0A%2F%2F%20A%20JavaScript%20Number%20is%20a%20primitive%20%60float%60%2C%20which%20the%20kernel%20computes%20with%2C%0A%2F%2F%20so%20assertions%20about%20Numbers%20are%20still%20theorems%20closed%20by%20computation.%0A%0Aimport%20%7B%20typeError%2C%20unsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20readCollectionConstructionBinding%2C%20renderCollectionConstruction%2C%20renderCollectionConstructionType%20%7D%20from%20%27.%2Fcollection-construction-rules.js%27%3B%0Aimport%20%7B%20renderOptionalAbsentValue%2C%20renderOptionalCoalescing%2C%20renderOptionalConsoleText%2C%20renderOptionalFlattening%2C%20renderOptionalMatch%2C%20renderOptionalNumericPresent%2C%20renderOptionalPresentValue%2C%20renderOptionalPrimitiveTruth%2C%20renderOptionalProjection%2C%20renderOptionalStrictEquality%2C%20renderOptionalTypeQueryPresent%2C%20renderOptionalUnwrapping%2C%20requireOptionalNumericPredicate%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20renderCollectionIteration%2C%20renderOptionalArrayRead%20%7D%20from%20%27.%2Farray-value-rules.js%27%3B%0Aimport%20%7B%