(51824: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Portable-core%20types.%20Numeric%20types%20keep%20their%20source%20semantics%20apart%3A%0A%2F%2F%20%60nat%60%20and%20%60int%60%20are%20unbounded%2C%20%60fixed%60%20is%20a%20Rust%20machine%20integer%20whose%0A%2F%2F%20arithmetic%20aborts%20on%20overflow%2C%20%60float%60%20is%20a%20JavaScript%20Number%20%28an%20IEEE-754%0A%2F%2F%20binary64%29.%20Data%20types%20are%20named%20by%20their%20qualified%20path.%0Aimport%20%7B%20acceptTypeIdentity%2C%20mergeOptionalAbsence%2C%20renderPortableTypeIdentity%2C%20wrapPortableReferenceIdentity%20%7D%20from%20%27.%2Fstructured-type-rules.js%27%3B%0Aimport%20%7B%20acceptImmutableProductKind%20%7D%20from%20%27.%2Fprimitive-value-rules.js%27%3B%0A%0Aexport%20const%20NAT%20%3D%20Object.freeze%28%7B%20kind%3A%20%27nat%27%20%7D%29%3B%0Aexport%20const%20INT%20%3D%20Object.freeze%28%7B%20kind%3A%20%27int%27%20%7D%29%3B%0Aexport%20const%20BOOL%20%3D%20Object.freeze%28%7B%20kind%3A%20%27bool%27%20%7D%29%3B%0Aexport%20const%20STRING%20%3D%20Object.freeze%28%7B%20kind%3A%20%27string%27%20%7D%29%3B%0Aexport%20const%20UNIT%20%3D%20Object.freeze%28%7B%20kind%3A%20%27unit%27%20%7D%29%3B%0Aexport%20const%20FLOAT%20%3D%20Object.freeze%28%7B%20kind%3A%20%27float%27%20%7D%29%3B%0A%2F%2F%20The%20lines%20a%20program%20has%20printed%2C%20newest%20first%3A%20only%20the%20targets%20whose%0A%2F%2F%20programs%20are%20pure%20carry%20them%2C%20as%20a%20value%20%28see%20output.js%29.%0Aexport%20const%20OUTPUT%20%3D%20Object.freeze%28%7B%20kind%3A%20%27output%27%20%7D%29%3B%0A%0Aexport%20function%20fixed%28bits%2C%20signed%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27fixed%27%2C%20bits%2C%20signed%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20data%28name%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27data%27%2C%20name%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20A%20JavaScript%20array%20whose%20checked%20type%20can%20retain%20a%20shared%20reference%20identity.%20%2A%2F%0Aexport%20function%20array%28element%2C%20reference%20%3D%20false%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27array%27%2C%20element%2C%20...%28reference%20%26%26%20%7B%20reference%3A%20true%20%7D%29%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20A%20mutable%20binding%20keeps%20its%20identity%20separately%20from%20its%20current%20value.%20%2A%2F%0Aexport%20function%20cell%28element%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27cell%27%2C%20element%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20Absence%20keeps%20the%20distinction%20between%20JavaScript%20null%20and%20undefined.%20%2A%2F%0Aexport%20function%20option%28element%2C%20absence%20%3D%20%27both%27%29%20%7B%0A%20%20if%20%28element.kind%20%3D%3D%3D%20%27option%27%29%20%7B%0A%20%20%20%20return%20option%28element.element%2C%20mergeOptionalAbsence%28element.absence%20%3F%3F%20%27both%27%2C%20absence%29%29%3B%0A%20%20%7D%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27option%27%2C%20element%2C%20absence%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20tuple%28elements%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27tuple%27%2C%20elements%3A%20Object.freeze%28%5B...elements%5D%29%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20Whether%20a%20type%20belongs%20to%20the%20admitted%20immutable%20Copy%20product%20model.%20%2A%2F%0Aexport%20function%20immutableProductType%28type%29%20%7B%0A%20%20return%20Boolean%28type%20%26%26%20acceptImmutableProductKind%28type.kind%29%29%0A%20%20%20%20%26%26%20%28type.kind%20%21%3D%3D%20%27tuple%27%20%7C%7C%20type.elements.every%28immutableProductType%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Fields%20are%20named%3B%20their%20declaration%20order%20is%20not%20part%20of%20a%20record%27s%20shape.%20%2A%2F%0Aexport%20function%20record%28fields%2C%20open%20%3D%20false%2C%20reference%20%3D%20false%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27record%27%2C%20fields%3A%20Object.freeze%28fields.map%28%28field%29%20%3D%3E%20Object.freeze%28%7B%20...field%20%7D%29%29%29%2C%20...%28open%20%26%26%20%7B%20open%20%7D%29%2C%20...%28reference%20%26%26%20%7B%20reference%3A%20true%20%7D%29%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20map%28key%2C%20value%2C%20reference%20%3D%20false%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27map%27%2C%20key%2C%20value%2C%20...%28reference%20%26%26%20%7B%20reference%3A%20true%20%7D%29%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20set%28element%2C%20reference%20%3D%20false%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27set%27%2C%20element%2C%20...%28reference%20%26%26%20%7B%20reference%3A%20true%20%7D%29%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20callable%28params%2C%20ret%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27function%27%2C%20params%3A%20Object.freeze%28%5B...params%5D%29%2C%20ret%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20typeKey%28type%29%20%7B%0A%20%20return%20wrapPortableReferenceIdentity%28ordinaryTypeKey%28type%29%2C%20Boolean%28type.reference%29%20%26%26%20%5B%27array%27%2C%20%27record%27%2C%20%27map%27%2C%20%27set%27%5D.includes%28type.kind%29%29%3B%0A%7D%0A%0Afunction%20ordinaryTypeKey%28type%29%20%7B%0A%20%20switch%20%28type.kind%29%20%7B%0A%20%20%20%20case%20%27var%27%3A%0A%20%20%20%20%20%20return%20renderPortableTypeIdentity%28type.kind%2C%20String%28type.id%29%2C%20%5B%5D%29%3B%0A%20%20%20%20case%20%27fixed%27%3A%0A%20%20%20%20%20%20return%20renderPortableTypeIdentity%28type.kind%2C%20%60%24%7Btype.signed%20%3F%20%27i%27%20%3A%20%27u%27%7D%24%7Btype.bits%7D%60%2C%20%5B%5D%29%3B%0A%20%20%20%20case%20%27data%27%3A%0A%20%20%20%20%20%20return%20renderPortableTypeIdentity%28type.kind%2C%20type.name%2C%20%5B%5D%29%3B%0A%20%20%20%20case%20%27array%27%3A%0A%20%20%20%20case%20%27cell%27%3A%0A%20%20%20%20%20%20return%20renderPortableTypeIdentity%28type.kind%2C%20%27%27%2C%20%5BtypeKey%28type.element%29%5D%29%3B%0A%20%20%20%20case%20%27option%27%3A%20%7B%0A%20%20%20%20%20%20const%20normalized%20%3D%20option%28type.element%2C%20type.absence%20%3F%3F%20%27both%27%29%3B%0A%20%