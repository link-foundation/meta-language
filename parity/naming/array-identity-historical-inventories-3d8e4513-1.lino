0parseJavaScript%28SUM%29%3B%0A%20%20const%20loop%20%3D%20items.find%28%28item%29%20%3D%3E%20item.name%20%3D%3D%3D%20%27ml_sum_loop1%27%29%3B%0A%20%20assert.equal%28loop.k%2C%20%27fn%27%29%3B%0A%20%20assert.equal%28loop.generated%2C%20true%29%3B%0A%20%20assert.deepEqual%28loop.params.map%28%28param%29%20%3D%3E%20param.name%29%2C%20%5B%27n%27%2C%20%27total%27%2C%20%27i%27%5D%29%3B%0A%20%20%2F%2F%20The%20one%20variable%20the%20loop%20assigns%20and%20the%20statements%20after%20it%20read%20is%20its%20result%3A%20no%20result%20type%20is%20needed.%0A%20%20assert.equal%28items.some%28%28item%29%20%3D%3E%20item.k%20%3D%3D%3D%20%27data%27%29%2C%20false%29%3B%0A%7D%29%3B%0A%0Atest%28%27a%20loop%20that%20returns%2C%20or%20leaves%20live%20variables%20it%20assigns%2C%20returns%20a%20generated%20data%20type%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20%7B%20items%20%7D%20%3D%20parseJavaScript%28%60function%20divisor%28n%29%20%7B%0A%20%20for%20%28let%20d%20%3D%202n%3B%20d%20%2A%20d%20%3C%3D%20n%3B%20d%2B%2B%29%20%7B%0A%20%20%20%20if%20%28n%20%25%20d%20%3D%3D%3D%200n%29%20return%20d%3B%0A%20%20%7D%0A%20%20return%20n%3B%0A%7D%0Afunction%20gcd%28a%2C%20b%29%20%7B%0A%20%20while%20%28b%20%21%3D%3D%200n%29%20%7B%0A%20%20%20%20const%20r%20%3D%20a%20%25%20b%3B%0A%20%20%20%20a%20%3D%20b%3B%0A%20%20%20%20b%20%3D%20r%3B%0A%20%20%7D%0A%20%20return%20a%3B%0A%7D%0Aconsole.log%28divisor%2891n%29%20%2B%20gcd%281071n%2C%20462n%29%29%3B%0A%60%29%3B%0A%20%20const%20result%20%3D%20items.find%28%28item%29%20%3D%3E%20item.name%20%3D%3D%3D%20%27ml_divisor_loop1_result%27%29%3B%0A%20%20assert.deepEqual%28result.ctors.map%28%28ctor%29%20%3D%3E%20ctor.name%29%2C%20%5B%27ml_divisor_loop1_done%27%2C%20%27ml_divisor_loop1_return%27%5D%29%3B%0A%20%20%2F%2F%20gcd%27s%20loop%20assigns%20a%20and%20b%2C%20but%20only%20a%20is%20read%20after%20it.%0A%20%20assert.equal%28items.some%28%28item%29%20%3D%3E%20item.name%20%3D%3D%3D%20%27ml_gcd_loop2_result%27%29%2C%20false%29%3B%0A%7D%29%3B%0A%0Atest%28%27mutable%20bindi