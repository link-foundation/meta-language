nt%20%3A%3D%20digits.length%0A%20%20let%20text%20%3A%3D%20String.ofList%0A%20%20let%20zeros%20%28count%20%3A%20Int%29%20%3A%3D%20List.replicate%20count.toNat%20%270%27%0A%20%20if%20k%20%E2%89%A4%20n%20%E2%88%A7%20n%20%E2%89%A4%2021%20then%20text%20%28digits%20%2B%2B%20zeros%20%28n%20-%20k%29%29%0A%20%20else%20if%200%20%3C%20n%20%E2%88%A7%20n%20%E2%89%A4%2021%20then%20text%20%28digits.take%20n.toNat%20%2B%2B%20%27.%27%20%3A%3A%20digits.drop%20n.toNat%29%0A%20%20else%20if%20-6%20%3C%20n%20%E2%88%A7%20n%20%E2%89%A4%200%20then%20text%20%28%270%27%20%3A%3A%20%27.%27%20%3A%3A%20zeros%20%28-n%29%20%2B%2B%20digits%29%0A%20%20else%0A%20%20%20%20let%20e%20%3A%3D%20n%20-%201%0A%20%20%20%20let%20exp%20%3A%3D%20%28if%20e%20%3C%200%20then%20%22e-%22%20else%20%22e%2B%22%29%20%2B%2B%20toString%20e.natAbs%0A%20%20%20%20if%20k%20%3D%3D%201%20then%20text%20digits%20%2B%2B%20exp%0A%20%20%20%20else%20text%20%28digits.take%201%20%2B%2B%20%27.%27%20%3A%3A%20digits.drop%201%29%20%2B%2B%20exp%0A%0A%2F--%20%5C%60c%20%C2%B7%2010%5Eq%5C%60%20compared%20with%20%5C%60x%20%C2%B7%20s%20%2F%20d%5C%60.%20-%2F%0Adef%20ml_js_cmp%20%28c%20%3A%20Nat%29%20%28q%20%3A%20Int%29%20%28x%20s%20d%20%3A%20Nat%29%20%3A%20Ordering%20%3A%3D%0A%20%20if%200%20%E2%89%A4%20q%20then%20compare%20%28c%20%2A%2010%20%5E%20q.toNat%20%2A%20d%29%20%28x%20%2A%20s%29%0A%20%20else%20compare%20%28c%20%2A%20d%29%20%28x%20%2A%20s%20%2A%2010%20%5E%20%28-q%29.toNat%29%0A%0Adef%20ml_js_shortest%20%28m%20%3A%20Nat%29%20%28e%20%3A%20Int%29%20%28lowerCloser%20%3A%20Bool%29%20%3A%20String%20%3A%3D%0A%20%20--%20The%20value%20is%204m%20and%20the%20rounding%20interval%20%5Blo%2C%20hi%5D%2C%20in%20units%20of%202%5E%28e-2%29%20%3D%20s%20%2F%20d.%0A%20%20let%20s%20%3A%3D%202%20%5E%20%28e%20-%202%29.toNat%0A%20%20let%20d%20%3A%3D%202%20%5E%20%282%20-%20e%29.toNat%0A%20%20let%20v%20%3A%3D%204%20%2A%20m%0A%20%20let%20lo%20%3A%3D%20if%20lowerCloser%20then%20v%20-%201%20else%20v%20-%202%0A%20%20let%20hi%20%3A%3D%20v%20%2B%202%0A%20%20let%20inclusive%20%3A%3D%20m%20%25%202%20%3D%3D%200%0A%20%20let%20above%20%28c%20%3A%20Nat%29%20%28q%20%3A%20Int%29%20%3A%20Bool%20%3A%3D%0A%20%20%20%20match%20ml_js_cmp%20c%20q%20lo%20s%20d%20with%0A%20%20%20%20%7C%20.gt%20%3D%3E%20true%20%7C%20.eq%20%3D%3E%20inclusive%20%7C%20.lt%20%3D%3E%20false%0A%20%20let%20below%20%28c%20%3A%20Nat%29%20%28q%20%3A%20Int%29%20%3A%20Bool%20%3A%3D%0A%20%20%20%20match%20ml_js_cmp%20c%20q%20hi%20s%20d%20with%0A%20%20%20%20%7C%20.lt%20%3D%3E%20true%20%7C%20.eq%20%3D%3E%20inclusive%20%7C%20.gt%20%3D%3E%20false%0A%20%20--%20floor%20%28log10%20value%29%20from%20the%20bit%20length%2C%20then%20corrected%20exactly%0A%20%20let%20bits%20%3A%20Int%20%3A%3D%20%28Nat.log2%20m%20%3A%20Int%29%20%2B%201%20%2B%20e%0A%20%20let%20guess%20%3A%20Int%20%3A%3D%20Int.fdiv%20%28%28bits%20-%201%29%20%2A%2078913%29%20262144%0A%20%20let%20e10%20%3A%3D%0A%20%20%20%20if%20ml_js_cmp%201%20%28guess%20%2B%201%29%20v%20s%20d%20%21%3D%20.gt%20then%20guess%20%2B%201%0A%20%20%20%20else%20if%20ml_js_cmp%201%20guess%20v%20s%20d%20%3D%3D%20.gt%20then%20guess%20-%201%0A%20%20%20%20else%20guess%0A%20%20let%20rec%20search%20%28fuel%20%3A%20Nat%29%20%28p%20%3A%20Nat%29%20%3A%20String%20%3A%3D%0A%20%20%20%20match%20fuel%20with%0A%20%20%20%20%7C%200%20%3D%3E%20%22%22%0A%20%20%20%20%7C%20fuel%20%2B%201%20%3D%3E%0A%20%20%20%20%20%20let%20q%20%3A%20Int%20%3A%3D%20e10%20-%20p%20%2B%201%0A%20%20%20%20%20%20let%20c%20%3A%3D%0A%20%20%20%20%20%20%20%20if%200%20%E2%89%A4%20q%20then%20v%20%2A%20s%20%2F%20%28d%20%2A%2010%20%5E%20q.toNat%29%0A%20%20%20%20%20%20%20%20else%20v%20%2A%20s%20%2A%2010%20%5E%20%28-q%29.toNat%20%2F%20d%0A%20%20%20%20%20%20let%20lowOk%20%3A%3D%20above%20c%20q%20%E2%88%A7%20below%20c%20q%0A%20%20%20%20%20%20let%20highOk%20%3A%3D%20above%20%28c%20%2B%201%29%20q%20%E2%88%A7%20below%20%28c%20%2B%201%29%20q%0A%20%20%20%20%20%20if%20lowOk%20%E2%88%A8%20highOk%20then%0A%20%20%20%20%20%20%20%20let%20pick%20%3A%3D%0A%20%20%20%20%20%20%20%20%20%20if%20lowOk%20%E2%88%A7%20highOk%20then%0A%2