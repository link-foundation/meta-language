.includes%28%27crate%3A%3Aml_math%3A%3Amax%28crate%3A%3Aml_math%3A%3Amax%281f64%2C%202f64%29%2C%203f64%29%27%29%2C%20rust%29%3B%0A%20%20assert.ok%28rust.includes%28%27crate%3A%3Aml_math%3A%3Ais_integer%283.141592653589793f64%29%27%29%2C%20rust%29%3B%0A%20%20assert.ok%28rust.includes%28%27%28%28-1f64%29%29.abs%28%29%27%29%2C%20rust%29%3B%0A%20%20const%20lean%20%3D%20translateProgram%28MATH%2C%20%27JavaScript%27%2C%20%27Lean%27%29.code%3B%0A%20%20assert.ok%28lean.includes%28%27%28%28xs.foldl%20ml_max%20%28-1.0%20%2F%200.0%20%3A%20Float%29%29%20-%20%28xs.foldl%20ml_min%20%281.0%20%2F%200.0%20%3A%20Float%29%29%29%27%29%2C%20lean%29%3B%0A%20%20assert.ok%28lean.includes%28%27%28ml_round%20%28-0.5%20%3A%20Float%29%29%27%29%2C%20lean%29%3B%0A%20%20assert.ok%28lean.includes%28%27%28Float.abs%20%28-1%20%3A%20Float%29%29%27%29%2C%20lean%29%3B%0A%20%20const%20rocq%20%3D%20translateProgram%28MATH%2C%20%27JavaScript%27%2C%20%27Rocq%27%29.code%3B%0A%20%20assert.ok%28rocq.includes%28%27%28PrimFloat.sub%20%28List.fold_left%20ml_max%20xs%20PrimFloat.neg_infinity%29%20%28List.fold_left%20ml_min%20xs%20PrimFloat.infinity%29%29%27%29%2C%20rocq%29%3B%0A%20%20assert.ok%28rocq.includes%28%27Definition%20ml_trunc%20%28x%20%3A%20float%29%20%3A%20float%20%3A%3D%5Cn%20%20match%20Prim2SF%20x%20with%27%29%2C%20rocq%29%3B%0A%20%20assert.ok%28rocq.includes%28%27%28PrimFloat.abs%20%28PrimFloat.opp%201%25float%29%29%27%29%2C%20rocq%29%3B%0A%7D%29%3B%0A%0Atest%28%27inference%20makes%20a%20parameter%20a%20Math%20function%20reads%20a%20Number%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20source%20%3D%20%27function%20half%28n%29%20%7B%5Cn%20%20return%20Math.floor%28n%20%2F%202%29%3B%5Cn%7D%5Cnconsole.log%28half%287%29%29%3B%5Cn%27%3B%0A%20%20assert.ok%28translateProgram%28source%2C%20%27JavaScript%27%2C%20%27Rust%27%29.code.includes%28%27pub%20fn%20half%28n%3A%20f64%29%20-%3E%20f64%20%7B%27%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20Math%20and%20Number%20forms%20that%20are%20not%20kept%20are%20refused%20with%20a%20reason%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20assert.equal%28refusal%28%27console.log%28Math.floor%281n%29%29%3B%5Cn%27%29%2C%20%27Math.floor%20of%20int%3B%20it%20takes%20Numbers%2C%20and%20converts%20or%20rejects%20anything%20else%20at%2023..25%27%29%3B%0A%20%20assert.equal%28refusal%28%27console.log%28Math.sin%281%29%29%3B%5Cn%27%29%2C%20%27Math.sin%3A%20the%20JavaScript%20standard%20library%20is%20outside%20the%20portable%20core%20at%2012..23%27%29%3B%0A%20%20assert.equal%28refusal%28%27console.log%28Math.abs%281%2C%202%29%29%3B%5Cn%27%29%2C%20%27Math.abs%20with%202%20arguments%3A%20Math.abs%20takes%20one%20Number%20at%2012..26%27%29%3B%0A%20%20assert.equal%28refusal%28%27const%20xs%20%3D%20%5B1%2C%202%5D%3B%5Cnconsole.log%28Math.abs%28...xs%29%29%3B%5Cn%27%29%2C%20%27spread%20argument%3A%20pass%20Math.abs%20its%20argument%20at%2043..45%27%29%3B%0A%20%20assert.equal%28refusal%28%27const%20m%20%3D%20Math.max%3B%5Cn%27%29%2C%20%27function%20value%20Math.max%3A%20functions%20and%20namespaces%20are%20only%20portable%20when%20a%20function%20is%20called%20at%2010..18%27%29%3B%0A%20%20assert.equal%28refusal%28%27function%20isNaN%28x%29%20%7B%5Cn%20%20return%20x%3B%5Cn%7D%5Cn%27%29%2C%20%27declaration%20of%20isNaN%3A%20it%20shadows%20the%20JavaScript%20global%20isNaN%2C%20which%20the%20translation%20reads%20as%20the%20built-in%3B%20rename%20it%20at%209..14%27%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
