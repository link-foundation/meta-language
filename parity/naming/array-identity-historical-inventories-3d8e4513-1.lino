(36424: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Output%20and%20aborts%20as%20values%2C%20for%20the%20targets%20whose%20programs%20are%20pure.%20Rust%0A%2F%2F%20and%20JavaScript%20print%20where%20the%20source%20prints%20and%20abort%20where%20it%20aborts%3B%20in%0A%2F%2F%20Lean%20and%20Rocq%20a%20function%20that%20prints%20or%20may%20abort%2C%20directly%20or%20through%20a%0A%2F%2F%20function%20it%20calls%2C%20takes%20the%20lines%20printed%20before%20it%20and%20returns%20them%2C%20with%0A%2F%2F%20the%20lines%20it%20prints%20added%20in%20front%2C%20paired%20with%20its%20value%2C%20or%2C%20when%20it%0A%2F%2F%20aborts%2C%20with%20the%20source%27s%20abort%20message%20instead%20of%20a%20value%3B%20main%20prints%20the%0A%2F%2F%20lines%20each%20of%20its%20steps%20adds%20and%20stops%20with%20the%20message%20of%20the%20first%20abort.%0A%2F%2F%20The%20rewriting%20is%20target-independent%3A%20it%20yields%20a%20portable-core%20program%0A%2F%2F%20without%20%60print%60%20and%20%60abort%60%20nodes%2C%20machine-integer%20arithmetic%20or%20checked%0A%2F%2F%20conversions%2C%20whose%20pairs%20are%20generated%20data%20types.%0A%0Aimport%20%7B%20castMessage%2C%20overflowMessage%2C%20zeroDivisorMessage%20%7D%20from%20%27.%2Faborts.js%27%3B%0Aimport%20%7B%20readOptionalOutputAbsences%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20acceptCallableCreationEffectTraversal%2C%20readCallableOutputTargetRefusal%20%7D%20from%20%27.%2Fcallable-emission-rules.js%27%3B%0Aimport%20%7B%20readCallableOutputAnalysis%20%7D%20from%20%27.%2Fcallable-emission.js%27%3B%0Aimport%20%7B%20unsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20BOOL%2C%20INT%2C%20NAT%2C%20OUTPUT%2C%20STRING%2C%20data%2C%20fixedBounds%2C%20typeKey%20%7D%20from%20%27.%2Ftypes.js%27%3B%0Aimport%20%7B%20readProgramExpressionEntryOperandField%20%7D%20from%20%27..%2Ftyped-program-link-rules.js%27%3B%0A%0Aconst%20SKIP%20%3D%20new%20Set%28%5B%27type%27%2C%20%27domain%27%2C%20%2