s%20with%20one%20hypothesis%20or%20lemma.%0Aconst%20REWRITE_BOUND%20%3D%208%3B%0A%0Aconst%20HELPERS%20%3D%20%7B%0A%20%20digits%3A%20%60Fixpoint%20ml_digits%20%28fuel%20%3A%20nat%29%20%28n%20%3A%20N%29%20%28acc%20%3A%20string%29%20%3A%20string%20%3A%3D%0A%20%20match%20fuel%20with%0A%20%20%7C%20O%20%3D%3E%20acc%0A%20%20%7C%20S%20rest%20%3D%3E%0A%20%20%20%20%20%20let%20acc%27%20%3A%3D%20String%20%28ascii_of_N%20%2848%20%2B%20N.modulo%20n%2010%29%29%20acc%20in%0A%20%20%20%20%20%20if%20N.ltb%20n%2010%20then%20acc%27%20else%20ml_digits%20rest%20%28N.div%20n%2010%29%20acc%27%0A%20%20end.%0ADefinition%20ml_N_to_string%20%28n%20%3A%20N%29%20%3A%20string%20%3A%3D%20ml_digits%20%28S%20%28N.size_nat%20n%29%29%20n%20EmptyString.%60%2C%0A%20%20zToString%3A%20%60Definition%20ml_Z_to_string%20%28z%20%3A%20Z%29%20%3A%20string%20%3A%3D%0A%20%20if%20Z.ltb%20z%200%20then%20String.append%20%22-%22%20%28ml_N_to_string%20%28Z.to_N%20%28Z.opp%20z%29%29%29%20else%20ml_N_to_string%20%28Z.to_N%20z%29.%60%2C%0A%20%20boolToString%3A%20%60Definition%20ml_bool_to_string%20%28b%20%3A%20bool%29%20%3A%20string%20%3A%3D%20if%20b%20then%20%22true%22%20else%20%22false%22.%60%2C%0A%20%20euclid%3A%20%60%28%2A%20Euclidean%20division%2C%20the%20rounding%20of%20Lean%27s%20Int%20%2F%20and%20%25%3A%20the%20remainder%20is%20never%20negative.%20%2A%29%0ADefinition%20ml_Z_ediv%20%28a%20b%20%3A%20Z%29%20%3A%20Z%20%3A%3D%20Z.mul%20%28Z.sgn%20b%29%20%28Z.div%20a%20%28Z.abs%20b%29%29.%0ADefinition%20ml_Z_emod%20%28a%20b%20%3A%20Z%29%20%3A%20Z%20%3A%3D%20Z.modulo%20a%20%28Z.abs%20b%29.%60%2C%0A%20%20tactics%3A%20%60Ltac%20ml_N_norm%20%3A%3D%20repeat%20first%0A%20%20%5B%20rewrite%20N.pred_succ%0A%20%20%7C%20rewrite%20%28proj2%20%28N.eqb_neq%20%28N.succ%20_%29%200%29%20%28N.neq_succ_0%20_%29%29%0A%20%20%7C%20rewrite%20N.eqb_refl%20%5D.%0ALtac%20ml_obligation%20%3A%3D%20intros%3B%20repeat%20match%20goal%20with%20H%20%3A%20N.eqb%20_%20_%20%3D%20false%20%7C-%20_%20%3D%3E%20apply%20N.eqb_neq%20in%20H%20end%3B%20lia.%0ALtac