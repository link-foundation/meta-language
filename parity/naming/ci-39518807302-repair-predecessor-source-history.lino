(39721: (meta: (t: semantic) (n: 1) (term: string%20value) (def: test%28%27all%20permanent%20source%20changes%20are%20authored%20as%20exact%20inverse%20publication%20additions%27%2C%28%29%3D%3E%7B%0A%20%20const%20files%3D%5B%0A%20%20%20%20%5B%27wire%2Fgenerate.mjs%27%2CauthorWireSourceViewEdits%5D%2C%0A%20%20%20%20%5B%27bridge%2Fgenerate.mjs%27%2CauthorBridgeSourceViewEdits%5D%2C%0A%20%20%20%20%5B%27runner%2Fplan.mjs%27%2CauthorRunnerPlanSourceViewEdits%5D%2C%0A%20%20%20%20%5B%27runner%2Frun.mjs%27%2CauthorRunnerOverlaySourceViewEdits%5D%0A%20%20%5D%3B%0A%20%20for%28const%20%5Bpath%2Cauthor%5Dof%20files%29%20%7B%0A%20%20%20%20const%20original%3DreadFileSync%28join%28repository%2C%27experiments%2Fgrammar-outcome-network%2Fnative-transport%27%2Cpath%29%2C%27utf8%27%29%3B%0A%20%20%20%20const%20result%3Dauthor%28original%29%3Bassert.notEqual%28result.source%2Cresult.original%29%3B%0A%20%20%20%20let%20inverse%3Dresult.source%3B%0A%20%20%20%20for%28const%20%7Bfrom%2Cto%2Ccount%7Dof%20%5B...result.edits%5D.reverse%28%29%29%20%7B%0A%20%20%20%20%20%20assert.equal%28count%2C1%29%3Bassert.equal%28inverse.split%28to%29.length%2C2%29%3Binverse%3Dinverse.replace%28to%2Cfrom%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2Cresult.original%2C%27whole%20previous%20source%20is%20retained%20exactly%27%29%3B%0A%20%20%20%20%2F%2F%20Exercise%20the%20installed%20state%20before%20installation%20too.%20Reversing%20the%20exact%0A%20%20%20%20%2F%2F%20source%20recipe%20recovers%20the%20retained%20predecessor%2C%20so%20no%20current%20module%20is%0A%20%20%20%20%2F%2F%20accidentally%20passed%20through%20the%20addition%20a%20second%20time.%0A%20%20%20%20const%20installed%3Dauthor%28result.source%29%3B%0A%20%20%20%20assert.equal%28installed.alreadyApplied%2Ctrue%29%3B%0A%20%20%20%20assert.equal%28installed.source%2Cresult.source%29%3B%0A%20%20%20%20assert.equal%28installed.original%2Cresult.original%29%3B%0A%20%20%20%20assert.deepEqual%28installed.edits%2Cresult.edits%29%3B%0A%20%20%20%20const%20replay%3Dauthor%28installed.original%29%3B%0A%20%20%20%20assert.equal%28replay.alreadyApplied%2Cfalse%29%3B%0A%20%20%20%20assert.equal%28replay.source%2Cinstalled.source%29%3B%0A%20%20%20%20if%28path.startsWith%28%27wire%2F%27%29%7C%7Cpath.startsWith%28%27bridge%2F%27%29%29%20%7B%0A%20%20%20%20%20%20const%20archive%3DreadProjectData%28join%28repository%2C%27experiments%2Fgrammar-outcome-network%2Fnative-transport%2Fwire%2Foriginal-authoring.lino%27%29%29%3B%0A%20%20%20%20%20%20const%20record%3Darchive.records.find%28record%3D%3Erecord.path%3D%3D%3Dpath%29%3Bassert.ok%28record%2C%27actual%20retained%20normal%20Links%20source%20archive%27%29%3B%0A%20%20%20%20%20%20const%20appended%3DappendWirePublicationEdits%28record%2Cauthor%29%3B%0A%20%20%20%20%20%20assert.equal%28appended.source%2Cresult.source%29%3B%0A%20%20%20%20%20%20const%20repeated%3DappendWirePublicationEdits%28appended.record%2Cauthor%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28repeated%2Cappended%2C%27installed%20archive%20preserves%20one%20exact%20suffix%20and%20every%20historical%20edit%27%29%3B%0A%20%20%20%20%20%20let%20historical%3Dappended.source%3B%0A%20%20%20%20%20%20for%28const%20%7Bfrom%2Cto%2Ccount%7Dof%20%5B...appended.record.edits%5D.reverse%28%29%29%20%7B%0A%20%20%20%20%20%20%20%20assert.equal%28historical.split%28to%29.length-1%2Ccount%29%3Bhistorical%3Dhistorical.split%28to%29.join%28from%29%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20assert.equal%28historical%2Crecord.original%2C%27complete%20original%20author%20plus%20every%20old%2Fnew%20publication%20change%20has%20an%20exact%20inverse%27%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%29) (lang: meta-language%20structured%20data)))
