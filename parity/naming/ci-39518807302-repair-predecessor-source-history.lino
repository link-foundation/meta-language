%20%20%20%20%20%20value%3D%3E%7Bvalue.declarations.find%28declaration%3D%3Edeclaration.file%3D%3D%3DnativePath%29.span.start%2B%2B%3B%7D%2C%0A%20%20%20%20%20%20value%3D%3E%7Bvalue.declarations.find%28declaration%3D%3Edeclaration.file%3D%3D%3DnativePath%29.source%2B%3D%27%20changed%27%3B%7D%0A%20%20%20%20%5D%29%7Bconst%20value%3DstructuredClone%28actual%29%3Bchange%28value%29%3Bassert.throws%28%28%29%3D%3EcheckOutcomeSourceViews%28value%2Cdecorator%29%29%3B%7D%0A%20%20%20%20const%20returned%3DcheckOutcomeSourceViews%28actual%2Cdecorator%29%3B%0A%20%20%20%20returned.adaptations%5B0%5D.currentSourceProof.selectedDeclarations%5B0%5D.sha256%3D%270%27.repeat%2864%29%3B%0A%20%20%20%20assert.deepEqual%28checkOutcomeSourceViews%28actual%2Cdecorator%29%2Cactual.sourceViews%2C%0A%20%20%20%20%20%20%27caller-owned%20returned%20proofs%20cannot%20mutate%20the%20private%20syntax%20cache%27%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EcheckOutcomeSourceViews%28%7B...actual%2CsourceViews%3Areturned%7D%2Cdecorator%29%2C%0A%20%20%20%20%20%20%27a%20cached%20syntax%20tree%20never%20authenticates%20a%20changed%20returned%20proof%27%29%3B%0A%20%20%20%20const%20overlay%3DapplyFrozenOutcomeProducerCorrection%28capture.historical.get%28nativePath%29.toString%28%29%2Cdecorator%29%3B%0A%20%20%20%20assert.equal%28overlay.original%2Cadaptation.historicalSource%29%3Bassert.equal%28overlay.source%2Ccorrected%29%3Bassert.equal%28overlay.receipt.role%2C%27frozen%20CI%20overlay%27%29%3B%0A%20%20%20%20writeFileSync%28join%28scratch%2CnativePath%29%2Ccorrected%2B%27%5Cn%27%29%3Bassert.throws%28%28%29%3D%3EcaptureOutcomeSourceViews%28scratch%2Cdecorator%29%29%3B%0A%20%20%7D%20finally%20%7BrmSync%28scratch%2C%7Brecursive%3Atrue%2Cforce%3Atrue%7D%29%3B%7D%0A%7D%29) (lang: meta-language%20structured%20data)))
