ection%3A%27inverse%27%7D%29%3B%0A%20%20%20%20assert.equal%28inverse.source%2Coriginal%28nativePath%29%29%3Bassert.equal%28inverse.receipt.inverseVerified%2Ctrue%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27whole%20source%2C%20conditional%20contexts%2C%20spread%20bindings%2C%20keys%20and%20policy%20tampering%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bdecorator%7D%3Dcurrent%28%29%2Cjavascript%3Doriginal%28javascriptPath%29%2Cnative%3Doriginal%28nativePath%29%3B%0A%20%20for%28const%20changed%20of%20%5B%0A%20%20%20%20javascript.replace%28%22if%20%28%21program%29%20%7B%22%2C%22if%20%28program%29%20%7B%22%29%2C%0A%20%20%20%20javascript.replace%28%27const%20diagnostic%20%3D%27%2C%27let%20diagnostic%20%3D%27%29%2C%0A%20%20%20%20javascript.replace%28%27%7B%20...diagnostic%2C%20reason%20%7D%27%2C%27%7B%20reason%2C%20...diagnostic%20%7D%27%29%0A%20%20%5D%29%20%7Bassert.notEqual%28changed%2Cjavascript%29%3Bassert.throws%28%28%29%3D%3EderiveDiagnosticOrderDecorator%28changed%2Cnative%29%2C%2Fauthenticated%2Fu%29%3B%7D%0A%20%20assert.throws%28%28%29%3D%3EderiveDiagnosticOrderDecorator%28javascript%2Cnative%2B%27%5Cn%27%29%2C%2Fauthenticated%2Fu%29%3B%0A%20%20for%28const%20change%20of%20%5B%0A%20%20%20%20value%3D%3E%7Bvalue.edits%5B0%5D.after%3Dvalue.edits%5B0%5D.before%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.matches%5B0%5D.javascript.contexts%3D%5B%5D%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.unmatchedNative%3D%5B%5D%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.baselinePins%5BnativePath%5D%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.inputs%5B0%5D.source%2B%3D%27%5Cn%27%3B%7D%0A%20%20%5D%29%20%7Bconst%20value%3DstructuredClone%28decorator%29%3Bchange%28value%29%3Bassert.throws%28%28%29%3D%3EapplyDiagnosticOrderDecorator%28native%2Cvalue%2C%7Brole%3A%27production%27%7D%29%29%3B%7D%0A%20%20assert.throws%28%28%29%3D%3EapplyDiagnosticOrderDecorator%28native%2Cdecorator%2C%7Brole%3A%27unqualified%27%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EapplyDiagnosticOrderDecorator%28native%2B%27%5Cn%27%2Cdecorator%2C%7Brole%3A%27production%27%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EapplyDiagnosticOrderDecorator%28native%2Cdecorator%2C%7Brole%3A%27production%27%2Cdirection%3A%27inverse%27%7D%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27finite%20CST%20spread%20reader%20refuses%20changed%20local%20mutability%2C%20duplicate%20keys%20and%20computed%20properties%27%2C%28%29%3D%3E%7B%0A%20%20const%20javascript%3Doriginal%28javascriptPath%29%3B%0A%20%20for%28const%20changed%20of%20%5B%0A%20%20%20%20javascript.replace%28%27const%20diagnostic%20%3D%27%2C%27let%20diagnostic%20%3D%27%29%2C%0A%20%20%20%20javascript.replace%28%27const%20diagnostic%20%3D%20%7B%20language%3A%20candidate.name%2C%20start%2C%20end%3A%20region.end%20%7D%3B%27%2C%0A%20%20%20%20%20%20%22const%20diagnostic%20%3D%20%7B%20language%3A%20candidate.name%2C%20start%2C%20end%3A%20region.end%2C%20reason%3A%20%27extra%27%20%7D%3B%22%29%2C%0A%20%20%20%20javascript.replace%28%27%7B%20...diagnostic%2C%20reason%20%7D%27%2C%22%7B%20...diagnostic%2C%20%5B%27reason%27%5D%3A%20reason%20%7D%22%29%2C%0A%20%20%20%20javascript.replace%28%27%7B%20...diagnostic%2C%20reason%20%7D%27%2C%27%7B%20...unknownDiagnostic%2C%20reason%20%7D%27%29%0A%20%20%5D%29%20%7Bassert.notEqual%28changed%2Cjavascript%29%3Bassert.throws%28%28%29%3D%3EreadJavaScriptDiagnosticOrders%28changed%29%29%3B%7D%0A%7D%29%3B%0A%0Atest%28%27actual%20JavaScript%20unknown%20and%20unsupported%20candidate%20diagnostics%20keep%20their%20complete%20original%20ordered%20values%27%2C%28%29%3D%3E%7B%0A%20%20const%20nativeBefore%3DreadFileSync%28repository%2B%27%2F%27%2BnativePath%2C%27utf8%27%29%2CjavascriptBefore%3DreadFileSync%28repository%2B%27%2F%27%2BjavascriptPath%2C%27utf8%27%29%3B%0A%20%20const%20approved%3Dcurrent%28%29%3B%0A%20%20assert.ok%28nativeBefore%3D%3D%3Doriginal%28nativePath%29%7C%7CrestoreGlobalGrammarContextSource%28nativePath%2CnativeBefore%29.predecessor%3D%3D%3Dapproved.corrected%2C%0A%20%20%20%20%27th