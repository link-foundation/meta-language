tory%28%29%20%7B%0A%20%20if%28candidate%29return%20structuredClone%28candidate%29%3B%0A%20%20const%20inventory%3DreadOutcomeInventory%28root%29%2Cscratch%3DmkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-current-context-%27%29%29%3B%0A%20%20try%7B%0A%20%20%20%20let%20size%3D0%3B%0A%20%20%20%20for%28const%20file%20of%20Object.keys%28diagnosticOrderDecorator.baselinePins%29%29%7B%0A%20%20%20%20%20%20const%20bytes%3D%5BjavascriptPath%2CnativePath%5D.includes%28file%29%3FBuffer.from%28readGlobalGrammarContextSourcePair%28file%29.successor.source%29%3AreadFileSync%28join%28root%2Cfile%29%29%3B%0A%20%20%20%20%20%20size%2B%3Dbytes.length%3Bassert.ok%28size%3C%3D2%2A1024%2A1024%29%3B%0A%20%20%20%20%20%20mkdirSync%28dirname%28join%28scratch%2Cfile%29%29%2C%7Brecursive%3Atrue%7D%29%3BwriteFileSync%28join%28scratch%2Cfile%29%2Cbytes%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20capture%3DcaptureOutcomeSourceViews%28scratch%2CdiagnosticOrderDecorator%29%3B%0A%20%20%20%20candidate%3D%7B...inventory%2CsourceViews%3AfinalizeOutcomeSourceViews%28capture%2Cinventory.inputs%2Cinventory.declarations%29%7D%3B%0A%20%20%20%20return%20structuredClone%28candidate%29%3B%0A%20%20%7Dfinally%7BrmSync%28scratch%2C%7Brecursive%3Atrue%2Cforce%3Atrue%7D%29%3B%7D%0A%7D%0A%0Atest%28%27all%20exact%20context%20successor%20sources%20retain%20independent%20original%20membership%20and%20unchanged%20complete%20predecessors%27%2C%28%29%3D%3E%7B%0A%20%20assert.equal%28GLOBAL_GRAMMAR_CONTEXT_SOURCE_PROFILE.files.length%2C4%29%3B%0A%20%20for%28const%20file%20of%20GLOBAL_GRAMMAR_CONTEXT_SOURCE_PROFILE.files%29%7B%0A%20%20%20%20const%20pair%3DreadGlobalGrammarContextSourcePair%28file%29%2Cold%3DrestoreGlobalGrammarContextSource%28file%2Cpair.predecessor.source%29%2Ccurrent%3DrestoreGlobalGrammarContextSource%28file%2Cpair.successor.source%29%3B%0A%20%20%20%20assert.equal%28old.changed%2Cfalse%29%3Bassert.equal%28old.receipt%2Cnull%29%3B%0A%20%20%20%20assert.equal%28current.changed%2Ctrue%29%3Bassert.equal%28current.predecessor%2Cpair.predecessor.source%29%3B%0A%20%20%20%20assert.deepEqual%28checkGlobalGrammarContextSourceReceipt%28file%2Cpair.successor.source%2Ccurrent.receipt%29%2Ccurrent.receipt%29%3B%0A%20%20%20%20assert.notEqual%28pair.predecessor.sha256%2Cpair.successor.sha256%29%3B%0A%20%20%20%20pair.actions%5B0%5D.after%2B%3D%27%20changed%27%3Bassert.notDeepEqual%28readGlobalGrammarContextSourcePair%28file%29%2Cpair%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreGlobalGrammarContextSource%28file%2Ccurrent.current%2B%27%5Cn%27%29%29%3B%0A%20%20%20%20const%20changed%3DstructuredClone%28current.receipt%29%3Bchanged.predecessor.sha256%3Dchanged.current.sha256%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EcheckGlobalGrammarContextSourceReceipt%28file%2Ccurrent.current%2Cchanged%29%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EcheckGlobalGrammarContextSourceReceipt%28file%2Cold.current%2Ccurrent.receipt%29%29%3B%0A%20%20%7D%0A%20%20assert.throws%28%28%29%3D%3EreadGlobalGrammarContextSourcePair%28%27unknown%2Fsource.js%27%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErestoreGlobalGrammarContextSource%28javascriptPath%2C%27x%27.repeat%28131073%29%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27actual%20current%20source%20views%20preserve%20all%20frozen%20pins%20legacy%20validation%20complete%20native%20owners%20and%20diagnostic%20calls%20through%20both%20archives%27%2C%28%29%3D%3E%7B%0A%20%20const%20inventory%3DcurrentContextInventory%28%29%2Cview%3Dinventory.sourceViews%3B%0A%20%20assert.equal%28view.schemaVersion%2C2%29%3Bassert.equal%28view.historicalPins.length%2C13%29%3Bassert.equal%28view.currentPins.length%2C13%29%3B%0A%20%20assert.deepEqual%28view.historicalPins%2Cinventory.pins%29%3Bassert.equal%28view.successors.length%2C2%29%3B%0A%20%20assert.equal%28view.predecessorView.schemaVersion%2C1%29%3Bassert.equal%28view.predecessorView.adaptations.length%2C1%29%3B%0A%20%20const%20javascript%3Dview.successors.find%28row%3D%3Erow.file%3D%3D%3DjavascriptPath%29%2Cnative%3Dview.successors.find%28row%3D%3Erow.file%3D%3D%3DnativePath%29%3B%0A%20%20assert.equal%28javascript.currentSourceProof.diagnosticCalls.length%2C9%29%3B%0A%20%20assert.ok%28native.currentSourceProof.imports.length%3E0%29%3Bassert.ok%28native.currentSourceProof.selectedDeclarations.length%3E0%29%3B%0A%20%20const%20frozen%3DapplyFrozenOutcomeProducerCorrection%28diagnosticOrderDecorator.inputs.find%28row%3D%3Erow.path%3D%3D%3DnativePath%29.source%2CdiagnosticOrderDecorator%29%3B%0A%20%20assert.equal%28frozen.source%2Cnative.predecessorSource%29%3Bassert.notEqual%28frozen.source%2Cnative.currentSource%29%3B%0A%20%20assert.equal%28frozen.receipt.role%2C%27frozen%20CI%20overlay%27%29%3B%0A%20%20assert.deepEqual%28checkOutcomeSourceViews%28inventory%2CdiagnosticOrderDecorator%29%2Cview%29%3B%0A%20%20const%20encoded%3DencodeStructuredDataLinks%28view%29%2Cnetwork%3DLinkNetwork.fromLino%28structuredDataToLino%28view%29%29%3B%0A%20%20for%28const%20graph%20of%20%5Bnetwork%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28network%29%29%5D%29%7B%0A%20%20%20%20const%20restored%3DdecodeStructuredDataLinks%28graph%2Cencoded.root%29%3Bassert.deepEqual%28restored%2Cview%29%3B%0A%20%20%20%20assert.deepEqual%28checkOutcomeSourceViews%28%7B...inventory%2CsourceViews%3Arestored%7D%2CdiagnosticOrderDecorator%29%2Cview%29%3B%0A%20%20%7D%0A%20%20const%20legacy%3D%7B...inventory%2CsourceViews%3Aview.predecessorView%7D%3B%0A%20%20assert.deepEqual%28checkOutcomeSourceViews%28legacy%2CdiagnosticOrderDecorator%29%2Clegacy.sourceViews%29%3B%0A%7D%29%3B%0A%0Atest%28%27current%20source%20views%20refuse%20changed%20frozen%20labels%20missing%20owners%20forged%20receipts%20duplicate%20successors%20and%20caller%20mutations%27%2C%28%29%3D%3E%7B%0A%20%20const%20inventory%3DcurrentContextInventory%28%29%3B%0A%20%20for%28const%20mutate%20of%20%5B%0A%20%20%20%20value%3D%3E%7Bvalue.sourceViews.currentPins.find%28row%3D%3Erow.file%3D%3D%3DnativePath%29.sha256%3Dvalue.pins.find%28row%3D%3Erow.file%3D%3D%