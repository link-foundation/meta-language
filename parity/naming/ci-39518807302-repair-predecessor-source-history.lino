0regions%0A%20%20%20%20%2F%2F%20are%20empty%20and%20the%20full%20scalar%2C%20so%20diagnostics%20retain%20BOTH%20occurrences.%0A%20%20%20%20assert.equal%28sourceCase.source%2C%27%CF%80%27%29%3B%0A%20%20%20%20assert.match%28sourceCase.listing%2C%2F%5C%28rule%20body%20silent%20%5C%28repeat0%20%2Fu%29%3B%0A%20%20%20%20assert.deepEqual%28outcome.rejection.diagnostics.map%28value%3D%3Evalue.end%29%2C%5B0%2CBuffer.byteLength%28sourceCase.source%29%5D%29%3B%0A%20%20%20%20const%20language%3Dreason%3D%3D%3D%27unknownGrammar%27%3F%27missing%27%3A%27first%27%3B%0A%20%20%20%20const%20expected%3D%5B0%2CBuffer.byteLength%28sourceCase.source%29%5D.map%28end%3D%3E%7B%0A%20%20%20%20%20%20const%20values%3D%7Blanguage%2Cstart%3A0%2Cend%2Creason%2C...%28reason%3D%3D%3D%27unsupportedEmbeddingMapping%27%3F%7Bmapping%3A%27quoted-escape%27%7D%3A%7B%7D%29%7D%3B%0A%20%20%20%20%20%20return%20Object.fromEntries%28descriptor%5B0%5D.javascript.keys.map%28key%3D%3E%5Bkey%2Cvalues%5Bkey%5D%5D%29%29%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20assert.deepEqual%28outcome.rejection.diagnostics%2Cexpected%2C%27complete%20independently%20expected%20diagnostic%20list%20for%20both%20original%20regions%27%29%3B%0A%20%20%20%20for%28const%20diagnostic%20of%20outcome.rejection.diagnostics%29%20%7B%0A%20%20%20%20%20%20assert.deepEqual%28Object.keys%28diagnostic%29%2Cdescriptor%5B0%5D.javascript.keys%2C%27actual%20public%20producer%20preserves%20the%20derived%20field%20order%27%29%3B%0A%20%20%20%20%20%20assert.equal%28diagnostic.reason%2Creason%29%3Bassert.equal%28typeof%20diagnostic.language%2C%27string%27%29%3B%0A%20%20%20%20%20%20assert.equal%28diagnostic.language%2Clanguage%29%3Bassert.equal%28diagnostic.start%2C0%29%3B%0A%20%20%20%20%20%20if%28reason%3D%3D%3D%27unsupportedEmbeddingMapping%27%29assert.equal%28diagnostic.mapping%2C%27quoted-escape%27%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20%2F%2F%20Reading%20and%20constructing%20these%20controls%20must%20not%20change%20original%20inputs.%0A%20%20assert.equal%28restoreGlobalGrammarContextSource%28javascriptPath%2CjavascriptBefore%29.predecessor%2Coriginal%28javascriptPath%29%29%3B%0A%20%20assert.equal%28readFileSync%28repository%2B%27%2F%27%2BjavascriptPath%2C%27utf8%27%29%2CjavascriptBefore%29%3B%0A%20%20assert.equal%28readFileSync%28repository%2B%27%2F%27%2BnativePath%2C%27utf8%27%29%2CnativeBefore%29%3B%0A%7D%29) (lang: meta-language%20structured%20data)))
