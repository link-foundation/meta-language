%20%20%27experiments%2Foriginal-link-complete-table-projection%2Fgenerate-successor-source-phases.mjs%27%2C%0A%20%20%27experiments%2Fgrammar-outcome-network%2Fnative-transport%2Finverse%2Fprojection-fixtures.lino%27%5D%3B%0A%0A%2F%2A%2A%20Validate%20the%20complete%20current%20metadata%20and%20the%20exact%20unchanged%20original%20payload.%20%2A%2F%0Aexport%20function%20checkGrammarContextMetadataPredecessor%28file%2Ccurrent%2Cprevious%29%20%7B%0A%20%20assert.ok%28file%3D%3D%3D%27experiments%2Fgrammar-outcome-network%2Fnative-transport%2Finverse%2Fprojection-fixtures.lino%27%0A%20%20%20%20%7C%7Cfile%3D%3D%3D%27parity%2Fself-translation%2Fprivate-output-test-model-generation.lino%27%2C%27one%20explicitly%20recorded%20metadata%20profile%20is%20required%27%29%3B%0A%20%20const%20inverse%3DstructuredClone%28current%29%3B%0A%20%20if%28file.endsWith%28%27%2Fprojection-fixtures.lino%27%29%29%7B%0A%20%20%20%20assert.deepEqual%28current.cases%2Cprevious.cases%2C%27all%20fourteen%20complete%20parser%20and%20boundary%20expectations%20remain%20exact%27%29%3B%0A%20%20%20%20assert.equal%28current.cases.length%2C14%29%3B%0A%20%20%20%20for%28const%20%5Bindex%2Crow%5Dof%20inverse.inputs.entries%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28row.path%2Cprevious.inputs%5Bindex%5D.path%29%3B%0A%20%20%20%20%20%20if%28row.path%21%3D%3D%27js%2Fsrc%2Fgrammar-runtime%2Fgrammar-selection.js%27%29continue%3B%0A%20%20%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28row.path%2Croot%29%2C%27utf8%27%29%3Bassert.deepEqual%28pin%28source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20%20%20const%20restored%3DrestoreGlobalGrammarContextSource%28row.path%2Csource%29%3Bassert.equal%28restored.changed%2Ctrue%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28restored.predecessor%29%2C%7Bbytes%3Aprevious.inputs%5Bindex%5D.bytes%2Csha256%3Aprevious.inputs%5Bindex%5D.sha256%7D%29%3B%0A%20%20%20%20%20%20Object.assign%28row%2Cprevious.inputs%5Bindex%5D%29%3B%0A%20%20%20%20%7D%0A%