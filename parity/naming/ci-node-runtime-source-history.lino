(49: (meta: (t: semantic) (n: 1) (term: string%20value) (def: name%3A%20Dependency%20Refresh%0A%0A%23%20Dependency%20freshness%20is%20live%20registry%20state%20that%20changes%20outside%20any%20pull%0A%23%20request%2C%20so%20no%20pull%20request%20check%20depends%20on%20it.%20This%20scheduled%20job%20on%20main%0A%23%20updates%20the%20lockfiles%20within%20the%20declared%20ranges%2C%20refreshes%20the%20committed%0A%23%20dependency%20audit%20from%20the%20registries%20and%20opens%20its%20own%20pull%20request%2C%20whose%0A%23%20checks%20then%20compare%20offline%20against%20the%20refreshed%20audit.%0Aon%3A%0A%20%20schedule%3A%0A%20%20%20%20-%20cron%3A%20%2717%204%20%2A%20%2A%201%27%0A%20%20workflow_dispatch%3A%0A%0Apermissions%3A%0A%20%20contents%3A%20read%0A%0Aconcurrency%3A%0A%20%20group%3A%20%24%7B%7B%20github.workflow%20%7D%7D-%24%7B%7B%20github.event_name%20%3D%3D%20%27pull_request%27%20%26%26%20github.ref%20%7C%7C%20github.run_id%20%7D%7D%0A%20%20cancel-in-progress%3A%20true%0A%0Ajobs%3A%0A%20%20refresh%3A%0A%20%20%20%20name%3A%20Refresh%20Dependencies%0A%20%20%20%20if%3A%20%24%7B%7B%20github.ref%20%3D%3D%20%27refs%2Fheads%2Fmain%27%20%7D%7D%0A%20%20%20%20runs-on%3A%20ubuntu-latest%0A%20%20%20%20%23%20Only%20this%20job%20pushes%20the%20refresh%20branch%20and%20opens%20its%20pull%20request%2C%20and%0A%20%20%20%20%23%20refreshes%20queue%20instead%20of%20cancelling%20one%20another%20mid-push.%0A%20%20%20%20permissions%3A%0A%20%20%20%20%20%20contents%3A%20write%0A%20%20%20%20%20%20pull-requests%3A%20write%0A%20%20%20%20concurrency%3A%0A%20%20%20%20%20%20group%3A%20dependency-refresh-%24%7B%7B%20github.repository%20%7D%7D-write%0A%20%20%20%20%20%20cancel-in-progress%3A%20false%0A%20%20%20%20timeout-minutes%3A%2030%0A%20%20%20%20steps%3A%0A%20%20%20%20%20%20-%20uses%3A%20actions%2Fcheckout%40v7%0A%0A%20%20%20%20%20%20-%20name%3A%20Setup%20Node.js%0A%20%20%20%20%20%20%20%20uses%3A%20actions%2Fsetup-node%40v7%0A%20%20%20%20%20%20%20%20with%3A%0A%20%20%20%20%20%20%20%20%20%20n