cy.baseCommit%2B%27%5E%7Bcommit%7D%27%5D%29.trim%28%29%2Cpolicy.baseCommit%29%3B%0A%20%20%2F%2F%20Future%20commits%20may%20publish%20experiment%20files.%20Core%20source%2Fdependency%20drift%0A%20%20%2F%2F%20is%20authenticated%20by%20predecessor%20pins%3B%20the%20compiled%20full%20crate%20stays%20frozen.%0A%20%20%2F%2F%20Current%20source%20pins%20are%20retained%20separately%20and%20checked%20again%20after%20execution.%0A%20%20%2F%2F%20Dependency%20locks%20stay%20identical%20for%20the%20shared%20installed%20JS%20build%20dependencies.%0A%20%20git%28repository%2C%5B%27diff%27%2C%27--exit-code%27%2C%27--quiet%27%2Cpolicy.baseCommit%2C%27--%27%2C%27js%2Fpackage.json%27%2C%27js%2Fpackage-lock.json%27%5D%29%3B%0A%20%20const%20executionCommit%3Dgit%28repository%2C%5B%27rev-parse%27%2C%27HEAD%27%5D%29.trim%28%29%3B%0A%20%20const%20%7BreadProjectData%7D%3Dawait%20import%28pathToFileURL%28resolve%28repository%2C%27js%2Fscripts%2Fproject-data.mjs%27%29%29%29%3B%0A%20%20const%20generated%3DbuildIntegration%28repository%29%3B%0A%20%20const%20receipt%3DcandidateDirectory%3FreadProjectData%28resolve%28candidateDirectory%2C%27integration-receipt.lino%27%29%29%3Agenerated.receipt%3B%0A%20%20assert.deepEqual%28receipt%2Cgenerated.receipt%2C%27fresh%20qualified%20bridge%20receipt%27%29%3B%0A%20%20assert.deepEqual%28receipt.predecessor.pins%2Creceipt.predecessor.sourceViews.historicalPins%2C%27frozen%20predecessors%20remain%20separate%27%29%3B%0A%20%20for%28const%20input%20of%20receipt.predecessor.sourceViews.currentPins%29%20assert.equal%28sha256%28bytesAt%28repository%2Cinput.file%29%29%2Cinput.sha256%2C%27current%20authenticated%20source%3A%20%27%2Binput.file%29%3B%0A%20%20const%20originalProducer%3DdiagnosticOrderDecorator.inputs.find%28input%3D%3Einput.path%3D%3D%3D%27rust%2Fsrc%2Fgrammar%2Ffeature_runtime%2Fgrammar_selection.rs%27%29.source%3B%0A%20%20const%20producerCorrection%3DapplyFrozenOutcomeProducerCorrection%28originalProducer%2CdiagnosticOrderDecorator%29%3B%0A%20%20const%