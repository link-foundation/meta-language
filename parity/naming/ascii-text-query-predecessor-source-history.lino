27%3B%0Aimport%20%7B%20lowerGuardedPrivateArrayWrites%20%7D%20from%20%27.%2Fguarded-private-array-writes.js%27%3B%0Aimport%20%7B%20lowerConstructedGuardedArrayWrites%20%7D%20from%20%27.%2Fconstructed-guarded-array-writes.js%27%3B%0Aimport%20%7B%20acceptCompleteDeclarationSourceInterval%20%7D%20from%20%27..%2Fsource-span-rules.js%27%3B%0Aimport%20%7B%20acceptJavaScriptFunctionStart%2C%20acceptJavaScriptNamespaceMethod%2C%0A%20%20readJavaScriptCollectionConstruction%2C%20readJavaScriptConstructionObligation%2C%0A%20%20readJavaScriptDocumentationTypeForm%2C%20readJavaScriptValueCaseForm%2C%0A%20%20acceptJavaScriptValueSwitch%2C%20readJavaScriptValueSwitchInstruction%2C%0A%20%20readJavaScriptValueSwitchPosition%2C%20readJavaScriptObjectStatementForm%2C%0A%20%20readJavaScriptObjectPropertyForm%2C%20readJavaScriptObjectValueForm%2C%0A%20%20readJavaScriptArrayMethodSurfaceForm%2C%20acceptJavaScriptTerminalTagGuard%2C%0A%20%20acceptJavaScriptTagGuardSequence%20%7D%20from%20%27.%2Fjavascript-surface-rules.js%27%3B%0A%0A%2F%2F%20The%20string%20predicates%20of%20the%20portable%20core%3A%20each%20reads%20the%20whole%20string%2C%0A%2F%2F%20so%20it%20means%20the%20same%20over%20UTF-16%2C%20UTF-8%20and%20code%20points.%0A%2F%2F%20String-to-string%20maps%3A%20the%20Unicode%20case%20mappings%2C%20which%20Rust%27s%0A%2F%2F%20to_lowercase%2Fto_uppercase%20also%20follow%2C%20and%20trimming%20of%20the%20JavaScript%0A%2F%2F%20whitespace%20set.%0Aconst%20ROOT%20%3D%20%27crate%27%3B%0Aconst%20EQUALITY%20%3D%20%7B%20%27%3D%3D%3D%27%3A%20%27eq%27%2C%20%27%21%3D%3D%27%3A%20%27ne%27%20%7D%3B%0Aconst%20RELATIONAL%20%3D%20%7B%20%27%3C%27%3A%20%27lt%27%2C%20%27%3C%3D%27%3A%20%27le%27%2C%20%27%3E%27%3A%20%27gt%27%2C%20%27%3E%3D%27%3A%20%27ge%27%20%7D%3B%0Aconst%20MULTIPLICATIVE%20%3D%20%7B%20%27%2A%27%3A%20%27mul%27%2C%20%27%2F%27%3A%20%27div%27%2C%20%27%25%27%3A%20%27rem%27%20%7D%3B%0Aconst%20ASSIGNMENTS%20%3D%20new%20Set%28%5B%27%3D%27%2C%20%27%2B%3D%27%2C%20%27-%3D%27%2C%20%27%2A%3D%27%2C%20%27