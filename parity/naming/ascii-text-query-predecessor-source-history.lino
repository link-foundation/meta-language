(21953: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20source%20views%20for%20the%20current%20CI%20repair%3B%20current%20execution%20stays%20separate.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadBootstrapStructuredDataLino%7D%20from%20%27..%2F..%2Fscripts%2Flib%2Fstructured-data-bootstrap.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20file%3D%27parity%2Fself-translation%2Fci-39422441941-repair-source-history.lino%27%3B%0Aconst%20archiveSha256%3D%27827b5441ceb0a8ec69524de911e05c481da844b0617dce8790135bc108928e29%27%3B%0Aconst%20revision%3D%2790636f9fb52b1b9095defbac041c8089608b8576%27%3B%0Aconst%20pin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Alet%20history%3B%0A%0A%2F%2A%2A%20Unknown%20bytes%20remain%20visible%20to%20the%20original%20historical%20validator.%20Only%20a%0A%20%2A%20complete%20independently%20pinned%20current%20source%20gets%20an%20original%20source%20view.%20%2A%2F%0Aexport%20function%20restoreCurrentCiRepairSource%28source%2Cpath%29%20%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20path%2C%27string%27%29%3B%0A%20%20source%3DrestoreBooleanValueGuardHistory%28source%2Cpath%29%3B%0A%20%20source%3DrestoreRawPlanningWorkflowHistory%28source%2Cpath%29%3B%0A%20%20source%3DrestoreGrammarContextMetadataHistory%28source%2Cpath%29%3B%0A%20%20if%28%21history%29%7Bconst%20bytes%3DreadFileSync%28new%20URL%28file%2Croot%29%29%3Bassert.equal%28pin%28bytes%29.sha256%2CarchiveSha256%29%3Bhistory%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3Bassert.equal%28history.revision%2Crevision%29%3B%7D%0A%20%20const%20row%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3Dpath%29%3Bif%28%21row%29return%20source%3B%0A%20%20const%20actual%3Dpin%28source%29%3B%0A%20%20if%28actual.sha256%21%3D%3Drow.current.sha256%29return%20source%3B%0A%20%20assert.deepEqual%28actual%2Crow.current%29%3B%0A%20%20const%20bytes%3DBuffer.from%28source%29%2Cedit%3Drow.edit%3B%0A%20%20assert.equal%28edit.offsetUnit%2C%27UTF-8%20bytes%27%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%26%26Number.isSafeInteger%28edit.end%29%26%26edit.start%3E%3D0%26%26edit.end%3E%3Dedit.start%26%26edit.end%3C%3Dbytes.length%29%3B%0A%20%20assert.equal%28bytes.subarray%28edit.start%2Cedit.end%29.toString%28%27utf8%27%29%2Cedit.inserted%29%3B%0A%20%20const%20original%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20assert.deepEqual%28pin%28original%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3Bassert.equal%28original.toString%28%27utf8%27%29%2Crow.sourceText%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2Coriginal%2C%7Brevision%2Cpath%7D%29%3B%0A%20%20return%20row.sourceText%3B%0A%7D%0A%0Aimport%20%7BrestoreGrammarContextMetadataHistory%7D%20from%20%27.%2Fgrammar-context-metadata-history.mjs%27%3B%0Aimport%20%7BrestoreRawPlanningWorkflowHistory%7D%20from%20%27.%2Fraw-planning-workflow-history.mjs%27%3B%0Aimport%20%7BrestoreBooleanValueGuardHistory%7D%20from%20%27.%2Fboolean-value-source-history.mjs%27%3B%0A) (lang: meta-language%20structured%20data)))
