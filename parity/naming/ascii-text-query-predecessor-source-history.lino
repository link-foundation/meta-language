ccessors%27%29%2Cfalse%29%3B%0A%20%20records.programStringRepresentationSourceSuccessors%3D%5Bedge%5D%3Bconst%20registerText%3DserializeProjectData%28records%2CregisterFile%29%3B%0A%20%20delete%20records.programStringRepresentationSourceSuccessors%3Bassert.equal%28serializeProjectData%28records%2CregisterFile%29%2Cregister.sourceText%29%3B%0A%20%20const%20receipt%3DreadStructuredDataLino%28loan.sourceText%29%2Cprevious%3DstructuredClone%28receipt.predecessor%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Areceipt.predecessor.bytes%2Csha256%3Areceipt.predecessor.sha256%7D%2Cedge.previous%29%3B%0A%20%20Object.assign%28receipt.predecessor%2Cedge.current%29%3Bconst%20loanText%3DserializeProjectData%28receipt%2CloanFile%29%3Breceipt.predecessor%3Dprevious%3Bassert.equal%28serializeProjectData%28receipt%2CloanFile%29%2Cloan.sourceText%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%2Cartifact%2Cregister%3A%7B...register%2Ccurrent%3Apin%28registerText%29%7D%2Cloan%3A%7B...loan%2Ccurrent%3Apin%28loanText%29%7D%2CsourceOwner%2Cedge%2C%0A%20%20%20%20boundary%3A%27Only%20two%20current%20checked-program%20projection%20descriptor%20fields%20change.%20Every%20complete%20native%20definition%2C%20owner%2C%20archive%2C%20fixture%2C%20input%2Fresult%20and%20older%20receipt%20remains%20exact.%20The%20new%20register%20entry%20and%20borrowed%20predecessor%20descriptor%20have%20complete%20original%20byte%20inverses.%20Actual%20new-source%20generation%20and%20native%20execution%20remain%20mandatory%20independent%20checks.%27%7D%3B%0A%20%20const%20writes%3D%5B%5BartifactFile%2Cartifact.sourceText%2CcurrentText%5D%2C%5BregisterFile%2Cregister.sourceText%2CregisterText%5D%2C%5BloanFile%2Cloan.sourceText%2CloanText%5D%5D%3B%0A%20%20for%28const%5Bfile%2Cold%2Ctext%5Dof%20writes%29%7B%0A%20%20%20%20const%20path%3Dnew%20URL%28file%2Croot%29%2Cactual%3DreadFileSync%28path%2C%27utf8%27%29%3Bassert.ok%28actual%3D%3D%3Dold%7C%7Cactual%3D%3D%3Dtext%2C%27unknown%20provenance%20edits%20refuse%3A%20%27%2Bfile%29%3B%0A%20%20%20%20if%28check%29assert.equal%28actual%2Ctext%29%3B%0A%20%20%7D%0A%20%20if%28check%29checkProjectData%28new%20URL%28output%2Croot%29%2Cpacket%29%3Belse%20writeProjectData%28new%20URL%28output%2Croot%29%2Cpacket%29%3B%0A%20%20if%28%21check%29for%28const%5Bfile%2C%2Ctext%5Dof%20writes%29writeFileSync%28new%20URL%28file%2Croot%29%2Ctext%29%3B%0A%20%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Csource%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2Fconst%20policySha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%3B%0A%20%20assert.equal%28source.split%28pattern%29.length%2C2%29%3Bconst%20expected%3Dsource.replace%28pattern%2C%22const%20policySha256%3D%27%22%2Bpin%28readFileSync%28new%20URL%28output%2Croot%29%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28helperPath%2Cexpected%29%3B%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateProgramStringSourceDescriptors%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Refreshed%20two%20actual%20projection%20source%20descriptor%20fields%3B%20complete%20original%20artifacts%20and%20registers%20remain%20independently%20recoverable.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
