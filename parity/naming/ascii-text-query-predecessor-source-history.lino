7%2C%27declarationNames%27%2C%27totals%27%2C%27assumptions%27%2C%27encodings%27%2C%27mappings%27%2C%27preludeHashes%27%2C%27replays%27%2C%27archive%27%5D%29assert.deepEqual%28artifact%5Bfield%5D%2Crestored.artifact%5Bfield%5D%2Cfield%29%3B%0A%20%20const%20loan%3DreadProjectData%28new%20URL%28packet.loan.file%2Croot%29%29%2Coriginal%3DreadProjectData%28new%20URL%28%27parity%2Fself-translation%2Fprogram-string-source-descriptors.lino%27%2Croot%29%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Aloan.predecessor.bytes%2Csha256%3Aloan.predecessor.sha256%7D%2Cpacket.edge.current%29%3B%0A%20%20const%20old%3DJSON.parse%28JSON.stringify%28loan%29%29%3BObject.assign%28old.predecessor%2Cpacket.edge.previous%29%3B%0A%20%20assert.equal%28serializeProjectData%28old%2Cpacket.loan.file%29%2Coriginal.loan.sourceText%29%3B%0A%20%20assert.equal%28serializeProjectData%28artifact%2Cpacket.artifact.file%29%2CreadFileSync%28new%20URL%28packet.artifact.file%2Croot%29%2C%27utf8%27%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27changed%20descriptor%20ownership%20register%20fields%20edge%20order%20and%20caller%20mutations%20cannot%20enter%20the%20historical%20source%20chain%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DreadProjectData%28new%20URL%28%27parity%2Fself-translation%2Fprogram-string-source-descriptors.lino%27%2Croot%29%29%3B%0A%20%20const%20artifact%3DreadProjectData%28new%20URL%28packet.artifact.file%2Croot%29%29%2Cregister%3DreadProjectData%28new%20URL%28packet.register.file%2Croot%29%29%3B%0A%20%20for%28const%20mutate%20of%20%5B%0A%20%20%20%20value%3D%3E%7Bvalue.programStringRepresentationSourceSuccessors%5B0%5D.changes.reverse%28%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.programStringRepresentationSourceSuccessors%5B0%5D.changes%5B0%5D.path%5B1%5D%3D%2710%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.programStringRepresentationSourceSuccessors%5B0%5D.current.sha256%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.extra%3D%27unknown%27%3B%7D%2C%0A%20%20%5D%29%7Bconst%20changed%3DstructuredClone%28register%29%3Bmutate%28changed%29%3Bassert.throws%28%28%29%3D%3ErestoreProgramStringSourceDescriptorEdge%28artifact%2C%27raw%20consuming%27%2Cchanged%29%29%3B%7D%0A%20%20const%20before%3DserializeProjectData%28register%2Cpacket.register.file%29%2Creturned%3DrestoreProgramStringSourceDescriptorEdge%28artifact%2C%27raw%20consuming%27%2Cregister%29%3B%0A%20%20returned.register.receipts%5B0%5D.identity%3D%27caller%20edit%27%3Breturned.artifact.completeRust%2B%3D%27%20caller%20edit%27%3B%0A%20%20assert.equal%28serializeProjectData%28register%2Cpacket.register.file%29%2Cbefore%29%3B%0A%20%20assert.equal%28serializeProjectData%28restoreProgramStringSourceDescriptorEdge%28artifact%2C%27raw%20consuming%27%2Cregister%29.artifact%2Cpacket.artifact.file%29%2Cpacket.artifact.sourceText%29%3B%0A%20%20const%20changed%3DstructuredClone%28artifact%29%3Bchanged.completeRust%2B%3D%27%20unknown%20edit%27%3B%0A%20%20assert.equal%28restoreProgramStringSourceDescriptorEdge%28changed%2C%27raw%20consuming%27%2Cregister%29.artifact%2Cchanged%2C%27unknown%20artifact%20bytes%20remain%20visible%20to%20the%20unchanged%20strict%20gate%27%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
