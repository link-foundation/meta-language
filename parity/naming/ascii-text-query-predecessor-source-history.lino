(15479: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20One%20finite%20source-descriptor%20edge%2C%20before%20the%20unchanged%20historical%20chain.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadProjectData%2CserializeProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20policyFile%3D%27parity%2Fself-translation%2Fprogram-string-source-descriptors.lino%27%3B%0Aconst%20policySha256%3D%27d404eef323e602b5f31dc88b0588d4a8a4ff5b23af98f82e0ee62540b6b39741%27%3B%0Aconst%20revision%3D%2790636f9fb52b1b9095defbac041c8089608b8576%27%3B%0Aconst%20property%3D%27programStringRepresentationSourceSuccessors%27%3B%0Aconst%20pin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Alet%20policy%3B%0A%0Afunction%20readProgramStringSourceDescriptorPolicy%28%29%20%7B%0A%20%20if%28%21policy%29%7Bconst%20bytes%3DreadFileSync%28new%20URL%28policyFile%2Croot%29%29%3Bassert.equal%28pin%28bytes%29.sha256%2CpolicySha256%29%3Bpolicy%3DreadProjectData%28new%20URL%28policyFile%2Croot%29%29%3Bassert.equal%28policy.schemaVersion%2C1%29%3Bassert.equal%28policy.revision%2Crevision%29%3B%7D%0A%20%20return%20policy%3B%0A%7D%0A%0A%2F%2A%2A%20Remove%20precisely%20the%20appended%20edge%20and%2C%20for%20its%20actual%20new%20artifact%2C%20invert%0A%20%2A%20only%20the%20two%20current%20source%20descriptor%20fields.%20Unknown%20artifacts%20stay%20visible%0A%20%2A%20to%20the%20original%20strict%20gate%20rather%20than%20acquiring%20a%20historical%20identity.%20%2A%2F%0Aexport%20function%20restoreProgramStringSourceDescriptorEdge%28artifact%2Cidentity%2Cregister%29%20%7B%0A%20%20if%28%21Object.hasOwn%28register%2Cproperty%29%29return%7Bartifact%2Cregister%7D%3B%0A%20%20const%20selected%3DreadProgramStringSourceDescriptorPolicy%28%29%3Bassert.deepEqual%28register%5Bproperty%5D%2C%5Bselected.edge%5D%29%3B%0A%20%20const%20bytes%3DBuffer.from%28serializeProjectData%28register%2Cselected.register.file%29%29%3Bassert.deepEqual%28pin%28bytes%29%2Cselected.register.current%29%3B%0A%20%20const%20previousRegister%3D%7B...register%7D%3Bdelete%20previousRegister%5Bproperty%5D%3B%0A%20%20const%20originalRegister%3DBuffer.from%28serializeProjectData%28previousRegister%2Cselected.register.file%29%29%3B%0A%20%20assert.deepEqual%28pin%28originalRegister%29%2C%7Bbytes%3Aselected.register.bytes%2Csha256%3Aselected.register.sha256%7D%29%3B%0A%20%20assert.equal%28originalRegister.toString%28%27utf8%27%29%2Cselected.register.sourceText%29%3B%0A%20%20verifyGitArtifactCertificate%28selected.register.certificate%2CoriginalRegister%2C%7Brevision%2Cpath%3Aselected.register.file%7D%29%3B%0A%20%20if%28identity%21%3D%3D%27raw%20consuming%27%7C%7Cartifact%3D%3D%3Dnull%29return%7Bartifact%2Cregister%3AstructuredClone%28previousRegister%29%7D%3B%0A%20%20const%20current%3DBuffer.from%28serializeProjectData%28artifact%2Cselected.artifact.file%29%29%3B%0A%20%20if%28pin%28current%29.sha256%21%3D%3Dselected.edge.current.sha256%29return%7Bartifact%2Cregister%3AstructuredClone%28previousRegister%29%7D%3B%0A%20%20assert.deepEqual%28pin%28current%29%2Cselected.edge.current%29%3B%0A%20%20const%20owner%3Dselected.sourceOwner%3B%0A%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28owner.file%2Croot%29%29%29%2Cowner.current%2C%27the%20actual%20checked-program%20projection%20source%20remains%20exact%27%29%3B%0A%20%20verifyGitArtifactCertificate%28owner.certificate%2CBuffer.from%28owner.sourceText%29%2C%7Brevision%2Cpath%3Aowner.file%7D%29%3B%0A%20%20const%20restored%3DstructuredClone%28artifact%29%3Bassert.equal%28selected.edge.changes.length%2C2%29%3B%0A%20%20const%20fields%3Dnew%20Set%28%29%3B%0A%20%20for%28const%20change%20of%20selected.edge.changes%29%7B%0A%20%20%20%20assert.deepEqual%28change.path.slice%280%2C-1%29%2C%5B%27decisionSources%27%2C%2711%27%5D%29%3B%0A%20%20%20%20const%20field%3Dchange.path.at%28-1%29%3Bassert.ok%28%5B%27bytes%27%2C%27sha256%27%5D.includes%28field%29%26%26%21fields.has%28field%29%29%3Bfields.add%28field%29%3B%0A%20%20%20%20const%20descriptor%3Drestored.decisionSources%5B11%5D%3Bassert.equal%28descriptor.file%2Cowner.file%29%3B%0A%20%20%20%20assert.equal%28descriptor%5Bfield%5D%2Cchange.after%29%3Bdescriptor%5Bfield%5D%3Dchange.before%3B%0A%20%20%7D%0A%20%20const%20original%3DBuffer.from%28serializeProjectData%28restored%2Cselected.artifact.file%29%29%3B%0A%20%20assert.deepEqual%28pin%28original%29%2C%7Bbytes%3Aselected.artifact.bytes%2Csha256%3Aselected.artifact.sha256%7D%29%3Bassert.equal%28original.toString%28%27utf8%27%29%2Cselected.artifact.sourceText%29%3B%0A%20%20verifyGitArtifactCertificate%28selected.artifact.certificate%2Coriginal%2C%7Brevision%2Cpath%3Aselected.artifact.file%7D%29%3B%0A%20%20return%7Bartifact%3Arestored%2Cregister%3AstructuredClone%28previousRegister%29%7D%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
