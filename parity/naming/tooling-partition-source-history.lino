ual%28current.header.split%28%27group%3A%20%27%2Bsuite.group%2B%27%5Cn%27%29.length%2C2%29%3B%0A%20%20%7D%0A%20%20for%28const%20job%20of%20before.filter%28row%3D%3Erow.id%21%3D%3Dold.id%29%29assert.deepEqual%28after.find%28row%3D%3Erow.id%3D%3D%3Djob.id%29%2Cjob%29%3B%0A%7D%29%3B%0A%0Atest%28%27partial%20repeated%20and%20corrupted%20raw%20contract%20partitions%20refuse%20while%20unrelated%20workflow%20edits%20remain%20visible%27%2C%28%29%3D%3E%7B%0A%20%20const%20workflow%3Dread%28%27.github%2Fworkflows%2Fjs.yml%27%29%3B%0A%20%20for%28const%20change%20of%20history.changes%29for%28const%20replacement%20of%20%5B%27%27%2Cchange.after%2Bchange.after%2C%0A%20%20%20%20change.after.replace%28%27raw-consuming-emission%27%2C%27unknown-consuming-emission%27%29%5D%29%7B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreRawContractPartitionHistory%28workflow.replace%28change.after%2Creplacement%29%29%2Cassert.AssertionError%29%3B%0A%20%20%7D%0A%20%20const%20altered%3Dworkflow.replace%28%27timeout-minutes%3A%2010%27%2C%27timeout-minutes%3A%2011%27%29%3B%0A%20%20assert.notEqual%28altered%2Cworkflow%29%3B%0A%20%20assert.equal%28restoreRawContractPartitionHistory%28altered%29%2Chistory.workflow.source.replace%28%27timeout-minutes%3A%2010%27%2C%27timeout-minutes%3A%2011%27%29%29%3B%0A%20%20assert.equal%28restoreRawContractPartitionHistory%28workflow%2B%27%5Cn%23%20unrelated%20edit%5Cn%27%29%2Chistory.workflow.source%2B%27%5Cn%23%20unrelated%20edit%5Cn%27%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErestoreRawContractPartitionHistory%28null%29%2Cassert.AssertionError%29%3B%0A%7D%29%3B%0A%0Atest%28%27raw%20suite%20selection%20preserves%20all%20original%20assertions%20and%20permits%20isolation%20only%20in%20the%20explicit%20JavaScript%20CI%20mode%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20current%3Dread%28%27experiments%2Foriginal-link-complete-table-projection%2Fraw-native-observations.test.mjs%27%29%3B%0A%20%20assert.equal%28restoreRawContractTestSource%28current%29%2Chistory.source.source%29%3B%0A%20%20verifyGitArtifactCertificate%28history.source.certificate%2CBuffer.from%28history.source.source%29%2C%7B%0A%20%20%20%20revision%3Ahistory.revision%2Cpath%3A%27experiments%2Foriginal-link-complete-table-projection%2Fraw-native-observations.test.mjs%27%7D%29%3B%0A%20%20for%28const%20altered%20of%20%5Bcurrent%2B%27%20%27%2Ccurrent.replace%28%27211%27%2C%27210%27%29%2Ccurrent.replace%28%22CI%2C%27true%27%22%2C%22CI%2C%27false%27%22%29%5D%29%7B%0A%20%20%20%20assert.notEqual%28altered%2Ccurrent%29%3Bassert.throws%28%28%29%3D%3ErestoreRawContractTestSource%28altered%29%29%3B%0A%20%20%7D%0A%20%20%2F%2F%20Replace%20only%20the%20module-loading%20boundary%20with%20a%20recorder%3B%20execute%20the%0A%20%20%2F%2F%20complete%20actual%20selection%20control%20without%20importing%20any%20heavy%20contracts.%0A%20%20const%20AsyncFunction%3DObject.getPrototypeOf%28async%20function%28%29%7B%7D%29.constructor%3B%0A%20%20const%20choose%3Dnew%20AsyncFunction%28%27process%27%2C%27assert%27%2C%27load%27%2Chistory.testChange.after.replaceAll%28%27await%20import%28%27%2C%27await%20load%28%27%29%29%3B%0A%20%20for%28const%20env%20of%20%5B%7B%7D%2C%7BCI%3A%27true%27%2CORIGINAL_LINK_RAW_NATIVE%3A%271%27%7D%2C%7BCI%3A%27true%27%2CORIGINAL_LINK_RAW_NATIVE%3A%270%27%7D%5D%29%7B%0A%20%20%20%20const%20calls%3D%5B%5D%3Bawait%20choose%28%7Benv%7D%2Cassert%2Casync%20path%3D%3Ecalls.push%28path%29%29%3B%0A%20%20%20%20assert.deepEqual%28calls%2Chistory.suites.map%28row%3D%3E%27.%2F%27%2Brow.file%29%29%3B%0A%20%20%7D%0A%20%20const%20calls%3D%5B%5D%3B%0A%20%20await%20choose%28%7Benv%3A%7BCI%3A%27true%27%2CORIGINAL_LINK_RAW_NATIVE%3A%270%27%2CORIGINAL_LINK_RAW_SEPARATE_SUITES%3A%271%27%7D%7D%2Cassert%2Casync%20path%3D%3Ecalls.push%28path%29%29%3B%0A%20%20assert.deepEqual%28calls%2C%5B%5D%29%3B%0A%20%20for%28const%20env%20of%20%5B%7BORIGINAL_LINK_RAW_SEPARATE_SUITES%3A%271%27%7D%2C%0A%20%20%20%20%7BCI%3A%27true%27%2CORIGINAL_LINK_RAW_NATIVE%3A%271%27%2CORIGINAL_LINK_RAW_SEPARATE_SUITES%3A%271%27%7