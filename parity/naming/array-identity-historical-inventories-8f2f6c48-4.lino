(11643: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20The%20%60Math%60%20and%20%60Number%60%20functions%20on%20Rocq%20primitive%20floats%3A%20%60PrimFloat%60%27s%0A%2F%2F%21%20where%20they%20agree%20with%20JavaScript%2C%20and%20the%20generated%20math%20helpers%20otherwise.%0A%0Ause%20super%3A%3A%7BExpr%2C%20Helper%2C%20Node%2C%20Result%2C%20RocqEmitter%7D%3B%0A%0Apub%28super%29%20const%20MATH%3A%20%26str%20%3D%20r%22%28%2A%20Math.trunc%2C%20exactly%20from%20the%20binary%20form%3A%20towards%20zero%2C%20a%20zero%20result%0A%20%20%20keeping%20the%20sign%20of%20the%20argument.%20%2A%29%0ADefinition%20ml_trunc%20%28x%20%3A%20float%29%20%3A%20float%20%3A%3D%0A%20%20match%20Prim2SF%20x%20with%0A%20%20%7C%20S754_finite%20negative%20m%20e%20%3D%3E%0A%20%20%20%20%20%20if%20Z.leb%200%20e%20then%20x%0A%20%20%20%20%20%20else%0A%20%20%20%20%20%20%20%20let%20magnitude%20%3A%3D%20PrimFloat.of_uint63%20%28Uint63.of_Z%20%28Z.div%20%28Z.pos%20m%29%20%282%20%5E%20%28-%20e%29%29%29%29%20in%0A%20%20%20%20%20%20%20%20if%20negative%20then%20PrimFloat.opp%20magnitude%20else%20magnitude%0A%20%20%7C%20_%20%3D%3E%20x%0A%20%20end.%0ADefinition%20ml_floor%20%28x%20%3A%20float%29%20%3A%20float%20%3A%3D%0A%20%20let%20t%20%3A%3D%20ml_trunc%20x%20in%20if%20PrimFloat.ltb%20x%20t%20then%20PrimFloat.sub%20t%201%25float%20else%20t.%0ADefinition%20ml_ceil%20%28x%20%3A%20float%29%20%3A%20float%20%3A%3D%0A%20%20let%20t%20%3A%3D%20ml_trunc%20x%20in%20if%20PrimFloat.ltb%20t%20x%20then%20PrimFloat.add%20t%201%25float%20else%20t.%0A%28%2A%20Math.round%3A%20the%20nearest%20integer%2C%20the%20one%20towards%20%2BInfinity%20on%20a%20tie%2C%20and%20-0%0A%20%20%20from%20-0.5%20up%20to%200.%20%2A%29%0ADefinition%20ml_round%20%28x%20%3A%20float%29%20%3A%20float%20%3A%3D%0A%20%20if%20orb%20%28orb%20%28PrimFloat.is_nan%20x%29%20%28PrimFloat.is_infinity%20x%29%29%20%28PrimFloat.is_zero%20x%29%20then%20x%0A%20%20else%20if%20andb%20%28PrimFloat.ltb%200%25float%20x%29%20%28PrimFloat.ltb%20x%200.5%25float%29%20then%200%25float%0A%20%20else%20if%20andb%20%28PrimFloat.ltb%20x%200%25float%29%20%28PrimFloat.leb%20%28PrimFloat.opp%200.5%25float%29%20x%29%20then%20PrimFloat.opp%200%25float%0A%20%20else%20let%20f%20%3A%3D%20ml_floor%20x%20in%20if%20PrimFloat.leb%200.5%25float%20%28PrimFloat.sub%20x%20f%29%20then%20PrimFloat.add%20f%201%25float%20else%20f.%0A%28%2A%20Math.sign%3A%201%20or%20-1%2C%20and%20-0%2C%200%20and%20NaN%20as%20they%20are.%20%2A%29%0ADefinition%20ml_sign%20%28x%20%3A%20float%29%20%3A%20float%20%3A%3D%0A%20%20if%20PrimFloat.ltb%200%25float%20x%20then%201%25float%20else%20if%20PrimFloat.ltb%20x%200%25float%20then%20PrimFloat.opp%201%25float%20else%20x.%0A%28%2A%20Math.max%20and%20Math.min%20of%20two%20Numbers%3A%20NaN%20when%20either%20is%2C%20and%200%20above%20-0.%20%2A%29%0ADefinition%20ml_max%20%28a%20b%20%3A%20float%29%20%3A%20float%20%3A%3D%0A%20%20if%20PrimFloat.ltb%20b%20a%20then%20a%20else%20if%20PrimFloat.ltb%20a%20b%20then%20b%0A%20%20else%20if%20PrimFloat.eqb%20a%20b%20then%20%28if%20PrimFloat.get_sign%20a%20then%20b%20else%20a%29%20else%20PrimFloat.nan.%0ADefinition%20ml_min%20%28a%20b%20%3A%20float%29%20%3A%20float%20%3A%3D%0A%20%20if%20PrimFloat.ltb%20a%20b%20then%20a%20else%20if%20PrimFloat.ltb%20b%20a%20then%20b%0A%20%20else%20if%20PrimFloat.eqb%20a%20b%20then%20%28if%20PrimFloat.get_sign%20a%20then%20a%20else%20b%29%20else%20PrimFloat.nan.%0ADefinition%20ml_is_finite%20%28x%20%3A%20float%29%20%3A%20bool%20%3A%3D%20negb%20%28orb%20%28PrimFloat.is_nan%20x%29%20%28PrimFloat.is_infinity%20x%29%29.%0ADefinition%20ml_is_integer%20%28x%20%3A%20float%29%20%3A%20bool%20%3A%3D%20andb%20%28ml_is_finite%20x%29%20%28PrimFloat.eqb%20%28ml_trunc%20x%29%20x%29.%0ADefinition%20ml_is_safe_integer%20%28x%20%3A%20float%29%20%3A%20bool%20%3A%3D%0A%20%20andb%20%28ml_is_integer%20x%29%20%28PrimFloat.leb%20%28PrimFloat.abs%20x%29%209007199254740991%25float%29.%22%3B%0A%0Aimpl%20RocqEmitter%3C%27_%3E%20%7B%0A%20%20%20%20pub%28super%29%20fn%20math%28%26mut%20self%2C%20e%3A%20%26Expr%29%20-%3E%20Result%3CString%3E%20%7B%0A%20%20%20%20%20%20%20%20let%20Node%3A%3AMath%20%7B%20op%2C%20args%20%7D%20%3D%20%26e.node%20else%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20unreachable%21%28%22not%20a%20Math%20expression%22%29%0A%20%20%20%20%20%20%20%20%7D%3B%0A%20%20%20%20%20%20%20%20self.floats%28%29%3B%0A%20%20%20%20%20%20%20%20let%20mut%20texts%20%3D%20Vec%3A%3Awith_capacity%28args.len%28%29%29%3B%0A%20%20%20%20%20%20%20%20for%20arg%20in%20args%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20texts.push%28self.expr%28arg%29%3F%29%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20let%20native%20%3D%20match%20op.as_str%28%29%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20%22abs%22%20%3D%3E%20Some%28%22PrimFloat.abs%22%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20%22sqrt%22%20%3D%3E%20Some%28%22PrimFloat.sqrt%22%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20%22isNaN%22%20%3D%3E%20Some%28%22PrimFloat.is_nan%22%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20_%20%3D%3E%20None%2C%0A%20%20%20%20%20%20%20%20%7D%3B%0A%20%20%20%20%20%20%20%20if%20let%20Some%28native%29%20%3D%20native%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20return%20Ok%28format%21%28%22%28%7Bnative%7D%20%7B%7D%29%22%2C%20texts%5B0%5D%29%29%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20self.helpers.insert%28Helper%3A%3AMath%29%3B%0A%20%20%20%20%20%20%20%20let%20bound%20%3D%20%7Cmax%3A%20bool%7C%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20if%20max%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%22PrimFloat.neg_infinity%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%22PrimFloat.infinity%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20%7D%3B%0A%20%20%20%20%20%20%20%20Ok%28match%20op.as_str%28%29%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20%22max%22%20%7C%20%22min%22%20%3D%3E%20texts%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.into_iter%28%29%0A%20%20%20%20%20%20%20%20%2