o%27%2C%0A%20%20sourceRevision%3A%27b4b92d47ee0a186dbe3920c1844eb907afe56aeb%27%2Cbytes%3A1814953%2C%0A%20%20sha256%3A%270698669cdac848bfd661a1f87be629cdc81ddc3b4a2213bfb145d4c9de441644%27%7D%2C%0A%20sources%3A%5B%0A%20%20%7Bfile%3A%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%0A%20%20%20previous%3A%7Bbytes%3A126330%2Csha256%3A%27e4a95a59a9f9878d2842928db794a4973eaa56daae8e11a970dfafd4f15f7551%27%7D%2C%0A%20%20%20current%3A%7Bbytes%3A127369%2Csha256%3A%27abf66bd551b94e9870a8d2c0d709af7c4a72e5fdc3fbd1e828a89de140f92880%27%7D%7D%2C%0A%20%20%7Bfile%3A%27js%2Fsrc%2Ftranslation%2Femit-rust.js%27%2C%0A%20%20%20previous%3A%7Bbytes%3A79266%2Csha256%3A%2769315a498f97e54b16f2fb8f3d7454d84e818ddce7bb89904b4ae85279af1f79%27%7D%2C%0A%20%20%20current%3A%7Bbytes%3A77647%2Csha256%3A%27843b6c072917fa8f86d36eabf64df022c92824062a921e5d8df71ac3d2df0f31%27%7D%7D%2C%0A%20%5D%2C%0A%7D%3B%0A%0A%2F%2A%2A%20Apply%20the%20one%20reviewed%20descriptor%20edge%20before%20the%20original%20receipt%20inverse.%20%2A%2F%0Afunction%20readHistoricalCompleteDeclarationDescriptorSuccessor%28artifact%2Cidentity%2Cregister%29%7B%0A%20const%20%7Bsuccessors%2C...originalRegister%7D%3Dregister%3B%0A%20const%20originalBytes%3DBuffer.from%28structuredDataToLino%28originalRegister%29%29%3B%0A%20assert.equal%28originalBytes.length%2C68598%2C%27all%20four%20original%20receipt%20rows%20retain%20their%20complete%20byte%20count%27%29%3B%0A%20assert.equal%28digest%28originalBytes%29%2C%27932974138d4bcd76ca097ed5d1e726abae850a85bea3f7d96ff8143ad84602ba%27%2C%0A%20%20%27removing%20only%20successors%20restores%20the%20complete%20immutable%20four-row%20register%27%29%3B%0A%20const%20base%3Dregister.receipts.find%28row%3D%3Erow.identity%3D%3D%3Didentity%29%3B%0A%20assert.ok%28base%2C%27the%20successor%20cannot%20introduce%20an%20undeclared%20receipt%20identity%27%29%3B%0A%20const%20bytes%3DBuffer.from%28structuredDataToLino%28artifact%29%29%2Cactual%3Ddigest%28bytes%29%3B%0A%20if%28successors%3D%3D%3Dundefined%29%7B%0A%20%20assert.ok%28%5Bbase.previous.sha256%2Cbase.current.sha256%5D.includes%28actual%29%2C%27unregistered%20descriptor%20successors%20refuse%27%29%3B%0A%20%20return%20%7Bartifact%3AstructuredClone%28artifact%29%2Cbytes%7D%3B%0A%20%7D%0A%20assert.ok%28Array.isArray%28successors%29%29%3B%0A%20assert.equal%28successors.length%2C1%2C%27the%20reviewed%20finite%20chain%20has%20exactly%20one%20descriptor%20successor%27%29%3B%0A%20const%20edge%3Dsuccessors%5B0%5D%2C%7Bchanges%2C...metadata%7D%3Dedge%3B%0A%20assert.deepEqual%28metadata%2CdescriptorSuccessor%2C%27the%20whole%20descriptor%20edge%20and%20both%20source%20revisions%20are%20independently%20pinned%27%29%3B%0A%20const%20expected%3D%5B%5D%3B%0A%20for%28const%20%5Bindex%2Csource%5Dof%20descriptorSuccessor.sources.entries%28%29%29for%28const%20field%20of%20%5B%27bytes%27%2C%27sha256%27%5D%29%7B%0A%20%20expected.push%28%7Bpath%3A%5B%27decisionSources%27%2CString%28index%2B3%29%2Cfield%5D%2Cbefore%3Asource.previous%5Bfield%5D%2Cafter%3Asource.current%5Bfield%5D%7D%29%3B%0A%20%7D%0A%20assert.deepEqual%28changes%2Cexpected%2C%27only%20the%20two%20owned%20descriptor%20byte%20counts%20and%20hashes%20may%20change%27%29%3B%0A%20if%28identity%21%3D%3Dedge.identity%7C%7Cactual%21%3D%3Dedge.current.sha256%29%7B%0A%20%20assert.ok%28%5Bbase.previous.sha256%2Cbase.current.sha256%5D.includes%28actual%29%2C%27unknown%20artifacts%20cannot%20enter%20the%20descriptor%20chain%27%29%3B%0A%20%20return%20%7Bartifact%3AstructuredClone%28artifact%29%2Cbytes%7D%3B%0A%20%7D%0A%20assert.equal%28bytes.length%2Cedge.current.bytes%2C%27the%20entire%20descriptor%20successor%20byte%20count%20is%20exact%27%29%3B%0A%20const%20inverse%3DstructuredClone%28artifact%29%3B%0A%20for%28const%20%5Bindex%2Csource%5Dof%20edge.sources.entries%28%29%29%7B%0A%20%20const%20descriptor%3Dinverse.decisionSources%5Bindex%2B3%5D%3B%0A%20%20assert.deepEqual%28descriptor%2C%7Bfile%3Asource.file%2C...source.current%7D%2C%27each%20actual%20descriptor%20retains%20its%20exact%20file%20