(15791: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Isolate%20full%20CST%20heaps%20while%20retaining%20all%20complete%20source%20replays%20before%20fixtures.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BavailableParallelism%2Cfreemem%7D%20from%20%27node%3Aos%27%3B%0Aimport%20%7BWorker%7D%20from%20%27node%3Aworker_threads%27%3B%0Aconst%20pin%3Dsource%3D%3E%28%7Bbytes%3ABuffer.byteLength%28source%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%7D%29%3B%0A%0Aexport%20function%20readOriginalLinkRawArchiveWorkerSources%28%29%20%7B%0A%20%20return%20%5B%27raw-source-archive-workers.mjs%27%2C%27raw-source-archive-worker.mjs%27%5D.map%28name%3D%3E%7B%0A%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28%27.%2F%27%2Bname%2Cimport.meta.url%29%29%3B%0A%20%20%20%20return%7Bfile%3A%27experiments%2Foriginal-link-complete-table-projection%2F%27%2Bname%2C...pin%28source%29%7D%3B%0A%20%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20Preserve%20ordering%20and%20execute%20every%20source%20even%20when%20a%20sibling%20fails.%20%2A%2F%0Aexport%20async%20function%20runOriginalLinkRawArchiveJobs%28sources%2Cinvoke%2Cconcurrency%2Cmaximum%3D2%29%20%7B%0A%20%20assert.ok%28Array.isArray%28sources%29%26%26sources.length%3E0%26%26sources.length%3C%3D3%29%3B%0A%20%20assert.equal%28typeof%20invoke%2C%27function%27%29%3Bassert.ok%28Number.isSafeInteger%28maximum%29%26%26maximum%3E%3D1%26%26maximum%3C%3D3%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28concurrency%29%26%26concurrency%3E%3D1%26%26concurrency%3C%3Dmaximum%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3Csources.length%3Bindex%2B%2B%29%7B%0A%20%20%20%20assert.ok%28Object.hasOwn%28sources%2Cindex%29%29%3Bconst%20source%3Dsources%5Bindex%5D%3B%0A%20%20%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28source.isWellFormed%28%29%2Ctrue%29%3Bassert.ok%28Buffer.byteLength%28source%29%3C%3D1024%2A1024%29%3B%0A%20%20%7D%0A%20%20const%20input%3D%5B...sources%5D%2Cresults%3Dnew%20Array%28input.length%29%2Cfailures%3D%5B%5D%3Blet%20next%3D0%3B%0A%20%20await%20Promise.all%28Array.from%28%7Blength%3AMath.min%28concurrency%2Cinput.length%29%7D%2Casync%28%29%3D%3E%7B%0A%20%20%20%20while%28next%3Cinput.length%29%7Bconst%20index%3Dnext%2B%2B%3Btry%7Bresults%5Bindex%5D%3Dawait%20invoke%28input%5Bindex%5D%2Cindex%29%3B%7D%0A%20%20%20%20%20%20catch%28error%29%7Bfailures.push%28%7Bindex%2Cerror%7D%29%3B%7D%7D%0A%20%20%7D%29%29%3B%0A%20%20if%28failures.length%29throw%20new%20AggregateError%28failures.sort%28%28a%2Cb%29%3D%3Ea.index-b.index%29.map%28row%3D%3Erow.error%29%2C%27complete%20source%20archive%20replay%20failed%27%29%3B%0A%20%20return%20results%3B%0A%7D%0A%0A%2F%2A%2A%20A%20receipt%20is%20accepted%20only%20after%20a%20successful%20worker%20exit%20releases%20its%20heap.%20%2A%2F%0Aexport%20function%20runOriginalLinkRawArchiveWorker%28source%2Cindex%2CmakeWorker%3D%28...args%29%3D%3Enew%20Worker%28...args%29%29%20%7B%0A%20%20return%20new%20Promise%28%28resolve%2Creject%29%3D%3E%7B%0A%20%20%20%20const%20expected%3Dpin%28source%29%3Blet%20receipt%2Cfailure%2Cmessages%3D0%3B%0A%20%20%20%20const%20worker%3DmakeWorker%28new%20URL%28%27.%2Fraw-source-archive-worker.mjs%27%2Cimport.meta.url%29%2C%7B%0A%20%20%20%20%20%20workerData%3A%7Bsource%2Cindex%2Cexpected%7D%2CexecArgv%3A%5B%5D%2Cname%3A%27complete-source-archive-%27%2Bindex%2C%0A%20%20%20%20%20%20resourceLimits%3A%7BmaxOldGenerationSizeMb%3A1024%2CmaxYoungGenerationSizeMb%3A16%7D%2C%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20worker.on%28%27message%27%2Cvalue%3D%3E%7B%0A%20%20%20%20%20%20messages%2B%2B%3Btry%7B%0A%20%20%20%20%20%20%20%20assert.equal%28messages%2C1%2C%27one%20complete%20archive%20receipt%20per%20worker%27%29%3B%0A%20%20%20%20%20%20%20%20assert.deepEqual%28Object.keys%28value%29.sort%28%29%2C%5B%27binaryReplaySha256%27%2C%27sourceSha256%27%2C%27textReplaySha256%27%5D%29%3B%0A%20%20%20%20%20%20%20%20for%28const%20actual%20of%20Object.values%28value%29%29assert.equal%28actual%2Cexpected.sha256%2C%27each%20complete%20source%20replay%20retains%20all%20original%20bytes%27%29%3B%0A%20%20%20%20%20%20%20%20receipt%3DstructuredClone%28value%29%3B%0A%20%20%20%20%20%20%7Dcatch%28error%29%7Bfailure%3Derror%3B%7D%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20worker.on%28%27error%27%2Cerror%3D%3E%7Bfailure%3Derror%3B%7D%29%3B%0A%20%20%20%20worker.on%28%27exit%27%2Ccode%3D%3E%7B%0A%20%20%20%20%20%20if%28failure%29return%20reject%28failure%29%3B%0A%20%20%20%20%20%20if%28code%21%3D%3D0%29return%20reject%28new%20Error%28%27complete%20source%20archive%20worker%20%27%2Bindex%2B%27%20exited%20%27%2Bcode%29%29%3B%0A%20%20%20%20%20%20if%28messages%21%3D%3D1%7C%7C%21receipt%29return%20reject%28new%20Error%28%27complete%20source%20archive%20worker%20%27%2Bindex%2B%27%20exited%20without%20its%20receipt%27%29%29%3B%0A%20%20%20%20%20%20resolve%28receipt%29%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20Select%20three%20heaps%20only%20when%20actual%20capacity%20leaves%20room%20for%20the%20parent.%20%2A%2F%0Aexport%20function%20readOriginalLinkRawArchiveCapacity%28processors%2CavailableBytes%2Cconfigured%29%20%7B%0A%20%20assert.ok%28Number.isSafeInteger%28processors%29%26%26processors%3E%3D1%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28availableBytes%29%26%26availableBytes%3E%3D0%29%3B%0A%20%20assert.ok%28configured%3D%3D%3Dundefined%7C%7C%2F%5E%5B1-9%5D%5B0-9%5D%2A%24%2Fu.test%28configured%29%2C%27the%20source%20archive%20job%20bound%20is%20a%20positive%20integer%27%29%3B%0A%20%20const%20jobs%3Dconfigured%3D%3D%3Dundefined%3F3%3AMath.min%283%2CNumber%28configured%29%29%3B%0A%20%20const%20memory%3DavailableBytes%3E%3D5%2A1024%2A%2A3%3F3%3AavailableBytes%3E%3D3%2A1024%2A%2A3%3F2%3A1%3B%0A%20%20return%20Math.min%28jobs%2Cprocessors%2Cmemory%29%3B%0A%7D%0A%0A%2F%2A%2A%20Only%20CI%20runs%20complete%20archives.%20Each%20heap%20keeps%20its%20original%20one-GiB%20bound%3B%0A%20%2A%20actual%20memory%2C%20CPUs%20and%20explicit%20job%20bounds%20select%20one%2C%20two%20or%20three.%20%2A%2F%0Aexport%20async%20function%20replayOriginalLinkRawSourceArchives%28sources%2Cenvironment%3Dprocess.env%29%20%7B%0A%20%20assert.equal%28environment.CI%2C%27true%27%2C%27complete%20source%20archive%20workers%20require%20CI%3Dtrue%27%29%3B%0A%20%20const%20processors%3DavailableParallelism%28%29%2CavailableBytes%3Dfreemem%28%29%3B%0A%20%20const%20concurrency%3DreadOriginalLinkRawArchiveCapacity%28processors%2CavailableBytes%2Cenvironment.META_LANGUAGE_JOBS%29%3B%0A%20%20process.stdout.write%28%27Raw%20source%20archive%20capacity%3A%20workers%3D%27%2Bconcurrency%2B%27%3B%20processors%3D%27%2Bprocessors%2B%27%3B%20freeBytes%3D%27%2BavailableBytes%2B%27%3B%20heapMiB%3D1024%5Cn%27%29%3B%0A%20%20return%20runOriginalLinkRawArchiveJobs%28sources%2CrunOriginalLinkRawArchiveWorker%2Cconcurrency%2C3%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
