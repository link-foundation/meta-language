A%20%20%20%20%20%20%20%20%5B%27%20%20%20%20%20%20%20%20%20%20pattern%3A%20translation-test-feedback-%24%7B%7B%20github.sha%20%7D%7D-%2A-of-3%5Cn%27%2C%27%20%20%20%20%20%20%20%20%20%20pattern%3A%20translation-test-feedback-%24%7B%7B%20github.sha%20%7D%7D-%2A-of-6%5Cn%27%5D%2C%0A%20%20%20%20%20%20%20%20%5B%27%20%20%20%20%20%20%20%20%20%20node%20js%2Fscripts%2Ftranslation-test-feedback.mjs%20merge%20%5C%5C%5Cn%27%2C%27%20%20%20%20%20%20%20%20%20%20node%20js%2Fscripts%2Ftranslation-test-feedback.mjs%20merge%20%5C%5C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20--partitions%206%20%5C%5C%5Cn%27%5D%2C%0A%20%20%20%20%20%20%5D%3B%0A%20%20%20%20%20%20for%28const%5Bbefore%2Cafter%5Dof%20changes%29%7Bassert.equal%28expected.split%28before%29.length%2C2%29%3Bexpected%3Dexpected.replace%28before%2Cafter%29%3B%7D%0A%20%20%20%20%7Delse%20if%28file.endsWith%28%27%2Fci.yml%27%29%29%7B%0A%20%20%20%20%20%20const%20start%3DsourceText.indexOf%28%27%20%20native-rust%3A%5Cn%27%29%2Cend%3DsourceText.indexOf%28%27%5Cn%20%20native-translations%3A%27%2Cstart%29%3B%0A%20%20%20%20%20%20assert.ok%28start%3E%3D0%26%26end%3Estart%29%3B%0A%20%20%20%20%20%20const%20region%3DsourceText.slice%28start%2Cend%29%2Canchor%3D%27%20%20%20%20%20%20%20%20%20%20--stage%20%22%24TARGET%22%5Cn%5Cn%27%3B%0A%20%20%20%20%20%20assert.equal%28region.split%28anchor%29.length%2C2%29%3B%0A%20%20%20%20%20%20expected%3DsourceText.slice%280%2Cstart%29%2Bregion.replace%28anchor%2Canchor%2BnativeStep%29%2BsourceText.slice%28end%29%3B%0A%20%20%20%20%7Delse%7B%0A%20%20%20%20%20%20let%20index%3D0%3B%0A%20%20%20%20%20%20expected%3DsourceText.replace%28%2F%5E%20%20%20%20%20%20-%20name%3A%20Retain%20authenticated%20%28%3F%3Afresh%20merge%7Cnative%29%20partition%5Cn%2Fgmu%2C%0A%20%20%20%20%20%20%20%20value%3D%3EartifactStep%28artifactScopes%5Bindex%2B%2B%5D%29%2Bvalue%29%3B%0A%20%20%20%20%20%20assert.equal%28index%2C3%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20current%3DrestoreEvidenceTranslationSourceHistory%28file%2CrestoreCurrentCiRepairSource%28readFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%2Cfile%29%29%3Bassert.equal%28current%2Cexpected%2C%27only%20the%20declared%20complete%20scheduling%20changes%20are%20admitted%27%29%3B%0A%20%20%20%20let%20start%3D0%2Cend%3DsourceText.length%2Cfinish%3Dcurrent.length%3B%0A%20%20%20%20while%28start%3Cend%26%26start%3Cfinish%26%26sourceText%5Bstart%5D%3D%3D%3Dcurrent%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20while%28end%3Estart%26%26finish%3Estart%26%26sourceText%5Bend-1%5D%3D%3D%3Dcurrent%5Bfinish-1%5D%29%7Bend--%3Bfinish--%3B%7D%0A%20%20%20%20const%20edit%3D%7BoffsetUnit%3A%27UTF-8%20bytes%27%2Cstart%3ABuffer.byteLength%28current.slice%280%2Cstart%29%29%2Cend%3ABuffer.byteLength%28current.slice%280%2Cfinish%29%29%2C%0A%20%20%20%20%20%20removed%3AsourceText.slice%28start%2Cend%29%2Cinserted%3Acurrent.slice%28start%2Cfinish%29%7D%3B%0A%20%20%20%20const%20bytes%3DBuffer.from%28current%29%2Cinverse%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20assert.ok%28inverse.equals%28captured.blob%29%29%3B%0A%20%20%20%20return%7Bfile%2Ccommit%3Arevision%2C...pin%28captured.blob%29%2CsourceText%2Ccertificate%3Acaptured.certificate%2Ccurrent%3Apin%28current%29%2Cedit%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3A1%2Crevision%2Cworkflows%2ColdTranslationPartitions%3A3%2CnewTranslationPartitions%3A6%2C%0A%20%20%20%20translationDeadlineMinutes%3A15%2C%0A%20%20%20%20boundary%3A%27Full%20workflow%20source%20preservation%20and%20exact%20scheduling%20inverses%20only.%20Every%20previous%20command%2C%20test%20file%2C%20assertion%2C%20failure%20predicate%2C%20artifact%20root%20and%20deadline%20remains%20required.%20The%20additional%20native%20TypeScript%20control%20runs%20after%20JavaScript%20through%20the%20existing%20Rust%20stage%3B%20separate%20uploads%20retain%20native%20package%20observations%20without%20disturbing%20sealed%20partition%20layouts.%20Na