0encountered%3Dprofile%3D%3D%3D%27schema%27%3Frows.filter%28row%3D%3Erow.partition%3D%3D%3D%27schema%27%29%3Arows%3B%0A%20%20%20%20for%28const%20row%20of%20encountered%29%7B%0A%20%20%20%20%20%20runner.test%28row.name%2C%28%29%3D%3Eexecuted.push%28row.name%29%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20runner.finish%28%29%3Bassert.deepEqual%28registered%2Crows.filter%28row%3D%3Erow.partition%3D%3D%3Dprofile%29.map%28row%3D%3Erow.name%29%29%3B%0A%20%20%7D%0A%20%20assert.equal%28executed.length%2C18%29%3Bassert.equal%28new%20Set%28executed%29.size%2C18%29%3B%0A%20%20assert.deepEqual%28executed%2Crows.map%28row%3D%3Erow.name%29%29%3B%0A%20%20const%20register%3D%28%29%3D%3E1%2Call%3DcreateOriginalLinkRawContractPartition%28register%2C%7B%7D%29%3B%0A%20%20assert.equal%28all.test%2Cregister%29%3Bassert.equal%28all.runPlan%2Ctrue%29%3Ball.finish%28%29%3B%0A%7D%29%3B%0A%0Atest%28%27unknown%20profiles%20missing%20registrations%20duplicates%20and%20native%20admission%20in%20injected%20partitions%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bfixture%7D%3DgenerateRawOracleContractPartitions%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20name%3Dfixture.tests%5B0%5D.name%3B%0A%20%20for%28const%20value%20of%20%5Benvironment%28%27unknown%27%29%2C%7B...environment%28%27plan%27%29%2CCI%3A%27false%27%7D%2C%0A%20%20%20%20%7B...environment%28%27plan%27%29%2CORIGINAL_LINK_RAW_NATIVE%3A%271%27%7D%2C%0A%20%20%20%20%7B...environment%28%27plan%27%29%2CORIGINAL_LINK_RAW_SEPARATE_SUITES%3A%270%27%7D%5D%29%7B%0A%20%20%20%20assert.throws%28%28%29%3D%3EcreateOriginalLinkRawContractPartition%28%28%29%3D%3E%7B%7D%2Cvalue%29%29%3B%0A%20%20%7D%0A%20%20const%20runner%3DcreateOriginalLinkRawContractPartition%28%28%29%3D%3E%7B%7D%2Cenvironment%28%27schema%27%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3Erunner.finish%28%29%29%3Bassert.throws%28%28%29%3D%3Erunner.test%28%27unknown%27%2C%28%29%3D%3E%7B%7D%29%29%3B%0A%20%20runner.test%28name%2C%28%29%3D%3E%7B%7D%29%3Bassert.throws%28%28%29%3D%3Erunner.test%28name%2C%28%29%3D%3E%7B%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3Erunner.test%28fixture.tests.find%28row%3D%3Erow.partition%3D%3D%3D%27native%27%29.name%2C%28%29%3D%3E%7B%7D%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20entire%20current%20test%20source%20retains%20every%20original%20call%20body%20hash%20and%20a%20complete%20certified%20inverse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bfixture%2Chistory%7D%3DgenerateRawOracleContractPartitions%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20source%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bfixture.testPath%2Cimport.meta.url%29%2C%27utf8%27%29%2Cbytes%3DBuffer.from%28source%29%3B%0A%20%20const%20tree%3DparseNative%28%27native-javascript%27%2Csource%29%3Bassert.equal%28tree.hasError%2Cfalse%29%3B%0A%20%20const%20nodes%3D%5Btree%5D%2Cactual%3D%5B%5D%3B%0A%20%20for%28let%20at%3D0%3Bat%3Cnodes.length%3Bat%2B%3D1%29%7B%0A%20%20%20%20const%20node%3Dnodes%5Bat%5D%3Bnodes.push%28...node.children.map%28row%3D%3Erow.node%29%29%3B%0A%20%20%20%20if%28node.term%21%3D%3D%27call_expression%27%29continue%3B%0A%20%20%20%20const%20fn%3Dnode.children.find%28row%3D%3Erow.field%3D%3D%3D%27function%27%29%3F.node%3B%0A%20%20%20%20if%28%21fn%7C%7Cbytes.subarray%28fn.start%2Cfn.end%29.toString%28%29%21%3D%3D%27test%27%29continue%3B%0A%20%20%20%20const%20args%3Dnode.children.find%28row%3D%3Erow.field%3D%3D%3D%27arguments%27%29%3F.node%3B%0A%20%20%20%20const%20name%3Dargs.children.find%28row%3D%3Erow.node.term%3D%3D%3D%27string%27%29%3F.node%3Bassert.ok%28name%29%3B%0A%20%20%20%20actual.push%28%7Bname%3Atokenize%28bytes.subarray%28name.start%2Cname.end%29.toString%28%29%2C%27JavaScript%27%29.tokens%5B0%5D.value%2C%0A%20%20%20%20%20%20start%3Anode.start%2Csha256%3AcreateHash%28%27sha256%27%29.update%28bytes.subarray%28node.start%2Cnode.end%29%29.digest%28%27hex%27%29%7D%29%3B%0A%20%20%7D%0A%20%20actual.sort%28%28first%2Csecond%29%3D%3Efirst.start-second.start%29%3B%0A%20%20assert.deepEqual%28actual.map%28%28%7Bname%2Csha256%7D%29%3D%3E%28%7Bname%2Csha256%7D%29%29%2Cfixture.tests.map%28%28%7Bname%2Csha256%7D%29%3D%3E%28%7Bname%2Csha256%7D%29%29%29%3B%0A%20%20const%20original%3Dhistory.sources.find%28row%3D%3Erow.path%3D%3D%3Dfixture.testPath%29.source%3B%0A%20%20assert.equal%28restoreRawOracleContractPartitionHistory%28source%2Cfixture.testPath%29%2Coriginal%29%3B%0A%20%20assert.equal%28restoreRawOracleContractPartitionHistory%28source%2B%27%5Cn%23%20changed%5Cn%27%2Cfixture.testPath%29%2Csource%2B%27%5Cn%23%20changed%5Cn%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27two%20required%20raw%20contract%20cells%20preserve%20complete%20commands%20limits%20and%20the%20preceding%20whole%20workflow%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bhistory%7D%3DgenerateRawOracleContractPartitions%28%7Bcheck%3Atrue%7D%29%2Cpath%3D%27.github%2Fworkflows%2Fjs.yml%27%3B%0A%20%20const%20currentSource%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bpath%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20const%20previousSource%3Dhistory.sources.find%28row%3D%3Erow.path%3D%3D%3Dpath%29.source%3B%0A%20%20assert.equal%28restoreRawOracleContractPartitionHistory%28currentSource%2Cpath%29%2CpreviousSource%29%3B%0A%20%20const%20previous%3DparseWorkflow%28previousSource%29%2Ccurrent%3DparseWorkflow%28currentSource%29%3B%0A%20%20assert.equal%28current.length%2Cprevious.length%29%3B%0A%20%20const%20before%3Dprevious.find%28row%3D%3Erow.id%3D%3D%3D%27package-checks%27%29%2Cafter%3Dcurrent.find%28row%3D%3Erow.id%3D%3D%3D%27package-checks%27%29%3B%0A%20%20assert.equal%28after.steps.length%2Cbefore.steps.length%2B1%29%3B%0A%20%20const%20old%3Dbefore.steps.find%28row%3D%3Erow.name%3D%3D%3D%27Run%20complete%20original%20link%20raw%20native%20oracle%20contracts%27%29%3B%0A%20%20const%20plan%3Dafter.steps.find%28row%3D%3Erow.name%3D%3D%3Dold.name%29%3B%0A%20%20const%20schema%3Dafter.steps.find%28row%3D%3Erow.name%3D%3D%3D%27Run%20complete%20original%20link%20raw%20schema%20and%20consumer%20contracts%27%29%3B%0A%20%20assert.equal%28plan.text.replace%28%22%5Cn%20%20%20%20%