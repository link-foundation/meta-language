2Cprevious%29%3B%0A%20%20const%20actual%3DreadFileSync%28new%20URL%28expected.file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20assert.ok%28actual%3D%3D%3Dprevious%7C%7Cactual%3D%3D%3Dcurrent%2C%27unknown%20actual%20source%20refuses%3A%20%27%2Bexpected.file%29%3B%0A%20%20if%28check%29assert.equal%28actual%2Ccurrent%2C%27actual%20current%20source%20must%20be%20the%20complete%20normal%20successor%27%29%3B%0A%20%20return%7Bfile%3Aexpected.file%2Ccertificate%3Aoriginal.certificate%2C%0A%20%20%20previous%3A%7Bsource%3Aprevious%2C...pinTruthyProjectionSource%28previous%29%7D%2Ccurrent%3A%7Bsource%3Acurrent%2C...pinTruthyProjectionSource%28current%29%7D%7D%3B%0A%20%7D%29%3B%0A%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%3ATRUTHY_PROJECTION_REVISION%2Cextensions%3ATRUTHY_PROJECTION_ENTRIES%2Csources%2C%0A%20%20boundary%3A%27Two%20additive%20shared%20schema%20entries%20reconstruct%20the%20existing%20checked%20Boolean%20conversion%20exactly.%20Existing%20shared%20source-language%2Ftype%20Boolean%20policy%20owns%20semantics%3B%20complete%20original%20schema%20and%20host%20bytes%20retain%20independent%20committed%20membership%20and%20exact%20inverses.%20No%20source%20rewrites%2C%20old%20abort%20changes%2C%20weakened%20IR%20comparison%20or%20native%20execution%20evidence.%27%7D%3B%0A%20verifyTruthyProjectionSchemaPacket%28packet%29%3B%0A%20const%20output%3Dnew%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%2ChelperFile%3Dnew%20URL%28helper%2Croot%29%2Cbefore%3DreadFileSync%28helperFile%2C%27utf8%27%29%3B%0A%20const%20pattern%3D%2F%5Econst%20recipeSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%24%2Fmu%3Bassert.equal%28before.split%28pattern%29.length%2C2%29%3B%0A%20if%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20const%20after%3Dbefore.replace%28pattern%2C%22const%20recipeSha256%3D%27%22%2BpinTruthyProjectionSource%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20if%28check%29assert.equal%28before%2Cafter%29%3B%0A%20else%7Bfor%28const%20row%20of%20sources%29writeFileSync%28new%20URL%28row.file%2Croot%29%2Crow.current.source%29%3BwriteFileSync%28helperFile%2Cafter%29%3B%7D%0A%20return%20structuredClone%28packet%29%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28args.length%3C%3D1%26%26args.every%28arg%3D%3Earg%3D%3D%3D%27--check%27%29%29%3B%0A%20generateTruthyProjectionSchema%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20console.log%28%27Checked%20Boolean%20conversion%20projection%3A%20complete%20predecessor%2Fcurrent%20sources%20and%20two-entry%20inverse%20authenticated%3B%20execution%20remains%20separate.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
