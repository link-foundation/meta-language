%20%20%20%7D%20else%20if%20%28value.kind%20%3D%3D%3D%20%27tuple%27%29%20%7B%0A%20%20%20%20%20%20if%20%28%21Array.isArray%28value.elements%29%20%7C%7C%20Object.keys%28value%29.some%28field%20%3D%3E%20%21%5B%27kind%27%2C%20%27elements%27%5D.includes%28field%29%29%29%20throw%20new%20TypeError%28%27a%20linked%20tuple%20type%20has%20a%20malformed%20element%20layout%27%29%3B%0A%20%20%20%20%20%20value.elements.forEach%28type%29%3B%0A%20%20%20%20%7D%20else%20if%20%28value.kind%20%3D%3D%3D%20%27union%27%29%20%7B%0A%20%20%20%20%20%20if%20%28%21Array.isArray%28value.alternatives%29%20%7C%7C%20%21acceptUnionTypeCount%28value.alternatives.length%29%0A%20%20%20%20%20%20%20%20%7C%7C%20Object.keys%28value%29.some%28field%20%3D%3E%20%21acceptUnionTypeField%28field%29%29%29%20throw%20new%20TypeError%28%27a%20linked%20union%20type%20has%20a%20malformed%20ordered%20alternative%20layout%27%29%3B%0A%20%20%20%20%20%20for%20%28const%20alternative%20of%20value.alternatives%29%20type%28alternative%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20else%20if%20%28value.kind%20%3D%3D%3D%20%27record%27%29%20value.fields.forEach%28%28field%29%20%3D%3E%20type%28field.type%29%29%3B%0A%20%20%20%20else%20if%20%28value.kind%20%3D%3D%3D%20%27map%27%29%20%7B%20type%28value.key%29%3B%20type%28value.value%29%3B%20%7D%0A%20%20%20%20else%20if%20%28value.kind%20%3D%3D%3D%20%27function%27%29%20%7B%20value.params.forEach%28type%29%3B%20type%28value.ret%29%3B%20%7D%0A%20%20%20%20else%20throw%20new%20TypeError%28%60the%20linked%20program%20contains%20unsupported%20type%20%24%7Bvalue.kind%7D%60%29%3B%0A%20%20%7D%0A%20%20const%20declarations%3DcheckProgramDeclarationOwners%28program%2Cvisit%29%3B%0A%20%20const%20constructorOwners%20%3D%20new%20WeakMap%28%29%3B%0A%20%20const%20binderOwners%20%3D%20new%20WeakMap%28%29%3B%0A%20%20const%20patternOwners%20%3D%20new%20WeakMap%28%29%3B%0A%20%20function%20ownBinder%28binder%2C%20owner%2C%20slot%29%20%7B%0A%20%20%20%20const%20previous%20%3D%20binderOwners.get%28binder%29%3B%0A%20%20%2