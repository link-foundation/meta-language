const%20currentAssertionSource%20%3D%20readFileSync%28new%20URL%28assertionPath%2C%20root%29%2C%20%27utf8%27%29%3B%0A%20%20const%20assertionReplay%20%3D%20replayAsciiHostEdits%28draftSource%2C%20ASCII_ASSERTION_EDITS%29%3B%0A%20%20assert.equal%28currentAssertionSource%2C%20assertionReplay.source%2C%20%27only%20the%20finite%20documented%20incomplete-source%20correction%20and%20added%20String%20spread%20control%27%29%3B%0A%20%20const%20assertionCorrection%20%3D%20%7B%20path%3A%20assertionPath%2C%0A%20%20%20%20draft%3A%20%7B%20kind%3A%20%27unexecuted%20private%20draft%27%2C%20commit%3A%20null%2C%20source%3A%20draftSource%2C%20pin%3A%20asciiHostPin%28draftSource%29%20%7D%2C%0A%20%20%20%20current%3A%20%7B%20source%3A%20currentAssertionSource%2C%20pin%3A%20asciiHostPin%28currentAssertionSource%29%20%7D%2C%20edits%3A%20assertionReplay.edits%2C%0A%20%20%20%20nativeTest%3A%20%27rust%2Ftests%2Funit%2Ftranslation_ascii_text_predicates.rs%27%2C%0A%20%20%20%20nativeAssertion%3A%20%27both_actual_whole_helpers_preserve_sources_cst_native_execution_and_bidirectional_semantic_archives%27%2C%0A%20%20%20%20reason%3A%20%27The%20old%20new-test%20draft%20treated%20emitted%20function%20definitions%20without%20their%20actual%20generated%20runtime%2Fprelude%2Fsource%20context%20as%20a%20complete%20default%20Rust%20source%20interpretation.%20The%20actual%20input%20retains%20its%20exact%20unsupported%20move-closure%20diagnostic%20and%20span%3B%20the%20other%20helper%20still%20reparses.%20All%20original%20scalar%20inputs%20and%20independent%20truth%20observations%20survive%2C%20now%20including%20execution%20of%20the%20complete%20reverse%20JavaScript%20program%20and%20full%20emitted%20Rust%20CST%20through%20both%20codecs.%20Native%20CI%20executes%20complete%20original%2Femitted%2Freverse%20Rust%20and%20JavaScript%20programs%20on%20every%20input%20and%20both%20semantic%20archives.%20Complete%20runtime%20semantic%20reimport%20remains%20an%20unmet%20translation%20obligation%3B%20this%20correction%20does%20not%20claim%20it%20solved.%27%20%7D%3B%0A%20%20const%20hosts%20%3D%20ASCII_HOST_EDITS.map%28specification%20%3D%3E%20%7B%0A%20%20%20%20const%20%7B%20blob%2C%20certificate%20%7D%20%3D%20captureGitArtifactCertificate%28ASCII_HOST_REVISION%2C%20specification.path%29%3B%0A%20%20%20%20const%20source%20%3D%20blob.toString%28%27utf8%27%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.from%28source%29%2C%20blob%29%3B%0A%20%20%20%20const%20replay%20%3D%20replayAsciiHostEdits%28source%2C%20specification.changes%29%3B%0A%20%20%20%20assert.equal%28restoreRequiredFieldNativeHostSource%28readFileSync%28new%20URL%28specification.path%2C%20root%29%2C%20%27utf8%27%29%2C%20specification.path%2C%20%27ASCII%20character%20host%27%29%2C%20replay.source%2C%0A%20%20%20%20%20%20%27capture%20the%20exact%20finite%20reviewed%20successor%2C%20without%20unrelated%20source%20drift%27%29%3B%0A%20%20%20%20return%20%7B%20path%3A%20specification.path%2C%20source%2C%20certificate%2C%20current%3A%20asciiHostPin%28replay.source%29%2C%20edits%3A%20replay.edits%20%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20additions%20%3D%20ASCII_HOST_ADDITIONS.map%28path%20%3D%3E%20%7B%0A%20%20%20%20const%20source%20%3D%20readFileSync%28new%20URL%28path%2C%20root%29%2C%20%27utf8%27%29%3B%0A%20%20%20%20return%20%7B%20path%2C%20source%2C%20pin%3A%20asciiHostPin%28source%29%20%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20artifactPath%20%3D%20%27parity%2Fself-translation%2Fascii-text-predicate-rules-native.lino%27%3B%0A%20%20const%20artifactBytes%20%3D%20readFileSync%28new%20URL%28artifactPath%2C%20root%29%29%3B%0A%20%20const%20artifact%20%3D%20readProjectData%28new%20URL%28artifactPath%2C%20root%29%29%3B%0A%20%20const%20archive%20%3D%20%7B%20schemaVersion%3A%201%2C%20model%3A%20%27Rust%20ASCII%20character%20query%20host%20replay%201%27%2C%0A%20%20%20%20revision%3A%20ASCII_HOST_REVISION%2C%20coordinateUnit%3A%20%27UTF-16%20code%20units%27%2C%20hosts%2C%20additions%2C%0A%20%20%20%20registrations%3A%20ASCII_HOST_REGISTRATIONS%2C