20from%20%27.%2Ftranslation%2Ftypes.js%27%3B%0Aimport%20%7BreadReferenceIdentityComparisonError%7D%20from%20%27.%2Ftranslation%2Freference-identity-rules.js%27%3B%0Aimport%20%7B%20readCallableOwnedParameters%20%7D%20from%20%27.%2Ftranslation%2Fcallable-source.js%27%3B%0Aimport%20%7B%20checkLinkedMatchCoverage%20%7D%20from%20%27.%2Ftranslation%2Fcheck.js%27%3B%0Aimport%20%7B%20acceptLinkedTextConversionKind%2C%20readNumberDisplayRefusal%2C%20readTuplePosition%20%7D%20from%20%27.%2Ftranslation%2Fprimitive-value-rules.js%27%3B%0Aimport%20%7B%20readLinkedPatternBindingScope%20%7D%20from%20%27.%2Ftyped-program-pattern-bindings.js%27%3B%0Aimport%20%7B%20acceptUnionTypeCount%2C%20acceptUnionTypeField%20%7D%20from%20%27.%2Ftranslation%2Ftype-syntax-rules.js%27%3B%0Aimport%20%7BcheckProgramDeclarationOwners%7D%20from%20%27.%2Ftyped-program-declaration-owners.js%27%3B%0Aimport%20%7B%20acceptProgramDivisionRounding%2C%20acceptProgramExpressionField%2C%20acceptProgramExpressionOperation%2C%20acceptProgramOptionalAbsence%2C%20acceptProgramTupleProductModel%2C%20readProgramReferenceRole%20%7D%20from%20%27.%2Ftyped-program-link-rules.js%27%3B%0A%0Aconst%20primitives%20%3D%20new%20Set%28%5B%27nat%27%2C%20%27int%27%2C%20%27bool%27%2C%20%27string%27%2C%20%27unit%27%2C%20%27float%27%2C%20%27output%27%5D%29%3B%0Aconst%20operationKinds%20%3D%20new%20Set%28%5B%27math%27%2C%20%27stringMap%27%2C%20%27stringTest%27%2C%20%27method%27%2C%20%27collectionRead%27%2C%20%27collectionItems%27%2C%20%27optionalPredicate%27%5D%29%3B%0A%0Aexport%20function%20validateLinkedTypedProgram%28program%2C%20references%20%3D%20new%20WeakMap%28%29%2C%20%7B%20graphPatterns%20%3D%20false%2C%20patternScopes%20%3D%20new%20WeakMap%28%29%20%7D%20%3D%20%7B%7D%29%20%7B%0A%20%20checkRustConstFunctionContainers%28program%29%3B%0A%20%20checkRustRuntimeShell%28program%29%3B%0A%20%20checkRustTypeNamespaceRecordShapes%28program%29%3B%0A%20%20%2F%2F%20The%20independently%20selected%20Unit%20profile%20owns%20plain%20data%20thro