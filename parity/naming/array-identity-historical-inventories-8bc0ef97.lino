28path.join%28root%2C%20%27js%2Fsrc%2Findex.js%27%29%29%3B%0A%20%20const%20exportNames%20%3D%20Object.keys%28javascript%29%3B%0A%20%20const%20%7B%20entries%2C%20missing%20%7D%20%3D%20resolveExports%28exportNames%2C%20rustPublicSurface%28%29%29%3B%0A%20%20const%20features%20%3D%20serializeProjectData%28JSON.parse%28withExportsBlock%28%0A%20%20%20%20%60%24%7BJSON.stringify%28readProjectData%28featuresPath%29%2C%20null%2C%202%29%7D%5Cn%60%2C%20entries%2C%0A%20%20%29%29%2C%20featuresPath%29%3B%0A%20%20return%20%7B%20exportNames%2C%20entries%2C%20missing%2C%20features%2C%20rustTest%3A%20renderRustTest%28entries%29%2C%20rustItems%3A%20renderRustItemImports%28entries%29%20%7D%3B%0A%7D%0A%0Aif%20%28process.argv%5B1%5D%20%26%26%20path.resolve%28process.argv%5B1%5D%29%20%3D%3D%3D%20fileURLToPath%28import.meta.url%29%29%20%7B%0A%20%20const%20%7B%20entries%2C%20missing%2C%20features%2C%20rustTest%2C%20rustItems%20%7D%20%3D%20await%20exportParity%28%29%3B%0A%20%20if%20%28process.argv.includes%28%27--report%27%29%29%20%7B%0A%20%20%20%20for%20%28const%20%5Bname%2C%20entry%5D%20of%20Object.entries%28entries%29%29%20console.log%28%60%24%7Bname%7D%20-%3E%20%24%7Bentry.rust%7D%20%5B%24%7Bentry.kind%7D%5D%60%29%3B%0A%20%20%7D%0A%20%20let%20failed%20%3D%20false%3B%0A%20%20if%20%28missing.length%20%3E%200%29%20%7B%0A%20%20%20%20console.error%28%60JavaScript%20exports%20without%20a%20public%20Rust%20item%3A%5Cn-%20%24%7Bmissing.join%28%27%5Cn-%20%27%29%7D%60%29%3B%0A%20%20%20%20failed%20%3D%20true%3B%0A%20%20%7D%0A%20%20const%20outputs%20%3D%20%5B%5BfeaturesPath%2C%20features%5D%2C%20%5BrustTestPath%2C%20rustTest%5D%2C%20%5BrustItemsPath%2C%20rustItems%5D%5D%3B%0A%20%20if%20%28process.argv.includes%28%27--check%27%29%29%20%7B%0A%20%20%20%20for%20%28const%20%5Bfile%2C%20expected%5D%20of%20outputs%29%20%7B%0A%20%20%20%20%20%20const%20actualFile%20%3D%20resolveProjectDataPath%28file%29%3B%0A%20%20%20%20%20%20const%20actual%20%3D%20existsSync%28actualFile%29%20%3F%20readFileSync%28actualFile%