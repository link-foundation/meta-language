fer.from%28source%29.toString%28%27utf8%27%29%2C%20source%2C%20%27lossless%20complete%20source%20encoding%27%29%3B%0A%20%20assert.equal%28Buffer.byteLength%28source%29%2C%20bytes%29%3B%0A%20%20assert.equal%28digest%28source%29%2C%20sha256%29%3B%0A%7D%0A%0A%2F%2A%2A%20Validate%20the%20full%20predecessor%20proofs%20and%20return%20every%20complete%20replayed%20file.%0A%20%2A%20This%20verifier%20reads%20no%20repository%20or%20process%20state%20and%20never%20executes%20Rust.%20%2A%2F%0Aexport%20function%20verifyRustLiteralMatchHosts%28archive%29%20%7B%0A%20%20assert.equal%28archive.schemaVersion%2C%201%29%3B%0A%20%20assert.equal%28archive.model%2C%20%27Rust%20borrowed%20string%20literal%20match%20host%20replay%201%27%29%3B%0A%20%20assert.equal%28archive.revision%2C%20revision%29%3B%0A%20%20assert.equal%28archive.coordinateUnit%2C%20%27UTF-16%20code%20units%27%29%3B%0A%20%20assert.deepEqual%28archive.hosts.map%28row%20%3D%3E%20row.path%29%2C%20predecessors%29%3B%0A%20%20assert.deepEqual%28archive.additions.map%28row%20%3D%3E%20row.path%29%2C%20additions%29%3B%0A%20%20assert.deepEqual%28archive.registrations%2C%20registrations%29%3B%0A%20%20const%20files%20%3D%20%5B%5D%3B%0A%20%20for%20%28const%20row%20of%20archive.hosts%29%20%7B%0A%20%20%20%20assert.equal%28typeof%20row.source%2C%20%27string%27%29%3B%0A%20%20%20%20const%20original%20%3D%20Buffer.from%28row.source%29%3B%0A%20%20%20%20assert.equal%28original.toString%28%27utf8%27%29%2C%20row.source%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2C%20original%2C%20%7B%20revision%2C%20path%3A%20row.path%20%7D%29%3B%0A%20%20%20%20assert.ok%28Array.isArray%28row.edits%29%20%26%26%20row.edits.length%20%3E%200%29%3B%0A%20%20%20%20let%20source%20%3D%20row.source%3B%0A%20%20%20%20for%20%28const%20edit%20of%20row.edits%29%20%7B%0A%20%20%20%20%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%20%26%26%20edit.start%20%3E%3D%200%20%26%26%20edit.start%20%3C%3D%20source.length%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20edit.removed%2C%20%27string%27%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20edit.inserted%2C%20%27string%27%29%3B%0A%20%20%20%20%20%20assert.equal%28source.slice%28edit.start%2C%20edit.start%20%2B%20edit.removed.length%29%2C%20edit.removed%29%3B%0A%20%20%20%20%20%20source%20%3D%20source.slice%280%2C%20edit.start%29%20%2B%20edit.inserted%20%2B%20source.slice%28edit.start%20%2B%20edit.removed.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20checkSource%28source%2C%20row.currentBytes%2C%20row.currentSha256%29%3B%0A%20%20%20%20let%20inverse%20%3D%20source%3B%0A%20%20%20%20for%20%28const%20edit%20of%20%5B...row.edits%5D.reverse%28%29%29%20%7B%0A%20%20%20%20%20%20assert.equal%28inverse.slice%28edit.start%2C%20edit.start%20%2B%20edit.inserted.length%29%2C%20edit.inserted%29%3B%0A%20%20%20%20%20%20inverse%20%3D%20inverse.slice%280%2C%20edit.start%29%20%2B%20edit.removed%20%2B%20inverse.slice%28edit.start%20%2B%20edit.inserted.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2C%20row.source%2C%20%27every%20predecessor%20byte%20and%20old%20macro%2Fcatalog%20branch%20survives%20the%20inverse%27%29%3B%0A%20%20%20%20files.push%28%7B%20path%3A%20row.path%2C%20source%2C%20predecessor%3A%20row.source%20%7D%29%3B%0A%20%20%7D%0A%20%20for%20%28const%20row%20of%20archive.additions%29%20%7B%0A%20%20%20%20checkSource%28row.source%2C%20row.bytes%2C%20row.sha256%29%3B%0A%20%20%20%20files.push%28%7B%20path%3A%20row.path%2C%20source%3A%20row.source%20%7D%29%3B%0A%20%20%7D%0A%20%20return%20files%3B%0A%7D%0A%0A%2F%2A%2A%20Rebuild%20only%20the%20four%20recorded%20native%20adapter%2Ftest%20files%2C%20without%20Git%20or%20a%20compiler.%20%2A%2F%0Aexport%20function%20generateRustLiteralMatchHosts%28%7B%20check%20%3D%20false%20%7D%20%3D%20%7B%7D%29%20%7B%0A%20%20const%20archive%20%3D%20readProjectData%28new%20URL%28%27parity%2Fself-translation%2Frust-literal-match-hosts.lino%27%2C%20root%29%29%3B%0A%20%20const%20files%20%3D%20verifyRustLiteralMatchHosts%28archive%29%3B%0A%20%20%2F%2F%20Root%20module%20ownership%20is%20separate%3A%20observe%20the%20exact%20registered%20paths%2C%0A%20%20%2F%2F%20rather%20than%20rewriting%20either%20shared%20module%20to%20install%20these%20adapters.%0A%20%20for%20%28const%20row%20of%20registrations%29%20%7B%0A%20%20%20%20const%20source%20%3D%20readFileSync%28new%20URL%28row.path%2C%20root%29%2C%20%27utf8%27%29%3B%0A%20%20%20%20assert.equal%28source.split%28row.declaration%29.length%2C%202%2C%20row.path%20%2B%20%27%20retains%20the%20registered%20unit%2Fmodule%20path%27%29%3B%0A%20%20%7D%0A%20%20%2F%2F%20Validate%20every%20destination%20before%20the%20first%20write%3B%20refuse%20unrelated%20drift.%0A%20%20for%20%28const%20row%20of%20files%29%20%7B%0A%20%20%20%20const%20file%20%3D%20new%20URL%28row.path%2C%20root%29%3B%0A%20%20%20%20if%20%28check%29%20assert.equal%28readFileSync%28file%2C%20%27utf8%27%29%2C%20row.source%2C%20row.path%29%3B%0A%20%20%20%20else%20if%20%28existsSync%28file%29%29%20%7B%0A%20%20%20%20%20%20const%20source%20%3D%20readFileSync%28file%2C%20%27utf8%27%29%3B%0A%20%20%20%20%20%20assert.ok%28source%20%3D%3D%3D%20row.source%20%7C%7C%20source%20%3D%3D%3D%20row.predecessor%2C%20%27unknown%20current%20source%3A%20%27%20%2B%20row.path%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20if%20%28%21check%29%20for%20%28const%20row%20of%20files%29%20%7B%0A%20%20%20%20const%20file%20%3D%20fileURLToPath%28new%20URL%28row.path%2C%20root%29%29%3B%0A%20%20%20%20mkdirSync%28dirname%28file%29%2C%20%7B%20recursive%3A%20true%20%7D%29%3B%0A%20%20%20%20writeFileSync%28file%2C%20row.source%29%3B%0A%20%20%7D%0A%20%20return%20%7B%20archive%2C%20files%20%7D%3B%0A%7D%0A%0Aif%20%28process.argv%5B1%5D%20%3D%3D%3D%20fileURLToPath%28import.meta.url%29%29%20%7B%0A%20%20const%20args%20%3D%20process.argv.slice%282%29%3B%0A%20%20assert.ok%28args.length%20%3C%3D%201%20%26%26%20args.every%28argument%20%3D%3E%20argument%20%3D%3D%3D%20%27--check%27%29%29%3B%0A%20%20const%20result%20%3D%20generateRustLiteralMatchHosts%28%7B%20check%3A%20args.includes%28%27--check%27%29%20%7D%29%3B%0A%20%20console.log%28JSON.stringify%28%7B%20predecessor%3A%20revision%2C%20hosts%3A%20result.files.map%28row%20%3D%3E%20row.path%29%2C%0A%20%20%20%20registrations%2C%20nativeCompilation%3A%20false%2C%20nativeExecution%3A%20false%20%7D%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
