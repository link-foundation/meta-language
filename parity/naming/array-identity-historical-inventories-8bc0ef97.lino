3B%0A%20assert.equal%28digest%28item.source%29%2Citem.sha256%29%3B%0A%20const%20from%3DreadSourceTextRustBlock%28source%2C%27fn%27%2Citem.name%29%3B%0A%20assert.equal%28formatProductRuleSource%28from%29.trim%28%29%2Citem.source%2C%27the%20whole%20original%20function%20matches%20the%20actual%20CI%20source%27%29%3B%0A%20const%20tokens%3Dtokenize%28from%2C%27Rust%27%29.tokens%2Crenames%3Dnew%20Map%28%29%2Cseen%3Dnew%20Set%28%29%3B%0A%20assert.equal%28item.renames.length%2C4%29%3B%0A%20for%28const%20row%20of%20item.renames%29%7B%0A%20%20assert.match%28row.from%2C%2F%5E%5Ba-z%5D%5Ba-z_0-9%5D%2A%24%2Fu%29%3Bassert.match%28row.to%2C%2F%5E%5Ba-z%5D%2B%28%3F%3A_%5Ba-z%5D%2B%29%2B%24%2Fu%29%3B%0A%20%20assert.ok%28%21renames.has%28row.from%29%26%26%21seen.has%28row.diagnostic%29%29%3B%0A%20%20const%20diagnostic%3Dfeedback.diagnostics%5Brow.diagnostic%5D%3Bassert.equal%28diagnostic.index%2Crow.diagnostic%29%3B%0A%20%20assert.equal%28diagnostic.path%2Cfeedback.capture.path%29%3B%0A%20%20assert.equal%28diagnostic.message%2C%22binding%27s%20name%20is%20too%20similar%20to%20existing%20binding%22%29%3Bseen.add%28row.diagnostic%29%3B%0A%20%20assert.equal%28tokens.filter%28token%3D%3Etoken.kind%3D%3D%3D%27identifier%27%26%26token.value%3D%3D%3Drow.from%29.length%2C2%2C%27one%20actual%20binding%20and%20one%20actual%20use%27%29%3B%0A%20%20assert.ok%28%21tokens.some%28token%3D%3Etoken.kind%3D%3D%3D%27identifier%27%26%26token.value%3D%3D%3Drow.to%29%2C%27new%20names%20cannot%20capture%20existing%20identifiers%27%29%3B%0A%20%20assert.ok%28%21tokens.some%28token%3D%3Etoken.kind%3D%3D%3D%27string%27%26%26new%20RegExp%28%27%5C%5Cb%27%2Brow.from%2B%27%5C%5Cb%27%2C%27u%27%29.test%28token.value%29%29%2C%27implicit%20format%20captures%20remain%20outside%20this%20finite%20rename%27%29%3B%0A%20%20renames.set%28row.from%2Crow.to%29%3B%0A%20%7D%0A%20assert.equal%28new%20Set%28renames.values%28%29%29.size%2Crenames.size%29%3B%0A%20assert.deepEqual%28%5B...seen%5D.sort%28%28a%2Cb%29%3D%3Ea-b%29%2C%5B0%2C1%2C2%2C3%5D%2C%27every%20reported%20binding%20has%20one%20correction%27%29%3B%0A%20const%20edits%3D%5B%5D%3B%0A%20for%28let%20at%3D0%3Bat%3Ctokens.length%3Bat%2B%3D1%29%7Bconst%20token%3Dtokens%5Bat%5D%3Bif%28token.kind%21%3D%3D%27identifier%27%7C%7C%21renames.has%28token.value%29%29continue%3B%0A%20%20assert.ok%28%21%5B%27.%27%2C%27%3A%3A%27%5D.includes%28tokens%5Bat-1%5D%3F.value%29%2C%27properties%20and%20qualified%20names%20retain%20their%20exact%20identity%27%29%3B%0A%20%20edits.push%28%7Bstart%3Atoken.start%2Cend%3Atoken.end%2Cfrom%3Atoken.value%2Cto%3Arenames.get%28token.value%29%7D%29%3B%0A%20%7D%0A%20assert.equal%28edits.length%2C8%29%3B%0A%20let%20to%3Dfrom%3Bfor%28const%20edit%20of%20%5B...edits%5D.reverse%28%29%29to%3Dto.slice%280%2Cedit.start%29%2Bedit.to%2Bto.slice%28edit.end%29%3B%0A%20const%20result%3Dtokenize%28to%2C%27Rust%27%29.tokens%3Bassert.equal%28result.length%2Ctokens.length%29%3B%0A%20for%28let%20at%3D0%3Bat%3Ctokens.length%3Bat%2B%3D1%29%7Bassert.equal%28result%5Bat%5D.kind%2Ctokens%5Bat%5D.kind%29%3Bassert.equal%28result%5Bat%5D.raw%2Ctokens%5Bat%5D.kind%3D%3D%3D%27identifier%27%26%26renames.has%28tokens%5Bat%5D.value%29%3Frenames.get%28tokens%5Bat%5D.value%29%3Atokens%5Bat%5D.raw%29%3B%7D%0A%20let%20inverse%3Dto%3B%0A%20for%28let%20at%3Dresult.length-1%3Bat%3E%3D0%3Bat-%3D1%29if%28result%5Bat%5D.kind%3D%3D%3D%27identifier%27%26%26%5B...renames.values%28%29%5D.includes%28result%5Bat%5D.value%29%29%7B%0A%20%20const%20original%3D%5B...renames%5D.find%28%28%5B%2Cvalue%5D%29%3D%3Evalue%3D%3D%3Dresult%5Bat%5D.value%29%5B0%5D%3Binverse%3Dinverse.slice%280%2Cresult%5Bat%5D.start%29%2Boriginal%2Binverse.slice%28result%5Bat%5D.end%29%3B%0A%20%7D%0A%20assert.equal%28inverse%2Cfrom%2C%27the%20whole%20original%20function%20byte%20sequence%20is%20recovered%27%29%3B%0A%20assert.equal%28source.split%28from%29.length%2C2%29%3B%0A%20return%20%7Bsource%3Asource.replace%28from%2C%28%29%3D%3Eto%29%2Cactions%3A%5B%7Bop%3A%27replace%27%2Cfield%3A%27source%2