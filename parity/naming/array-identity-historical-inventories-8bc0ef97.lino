%20assert.equal%28inverse%2Cprevious%2C%27every%20original%20host%20byte%20stays%20exact%27%29%3Breturn%20current%3B%0A%7D%0A%0Aexport%20function%20deriveTruthyProjectionSchema%28previous%29%20%7B%0A%20const%20original%3DreadStructuredDataLino%28previous%29%2Ccurrent%3DstructuredClone%28original%29%3B%0A%20assert.deepEqual%28current.expressionOperands.truthy%2C%5B%27arg%27%5D%29%3B%0A%20for%28const%20%5Btable%2Centries%5Dof%20Object.entries%28TRUTHY_PROJECTION_ENTRIES%29%29for%28const%20%5Bkey%2Cvalue%5Dof%20Object.entries%28entries%29%29%7B%0A%20%20assert.equal%28Object.hasOwn%28current%5Btable%5D%2Ckey%29%2Cfalse%2C%27append%20only%20the%20genuinely%20absent%20projection%2Ffield%20entries%27%29%3B%0A%20%20current%5Btable%5D%5Bkey%5D%3DstructuredClone%28value%29%3B%0A%20%7D%0A%20const%20inverse%3DstructuredClone%28current%29%3B%0A%20for%28const%20%5Btable%2Centries%5Dof%20Object.entries%28TRUTHY_PROJECTION_ENTRIES%29%29for%28const%20%5Bkey%2Cvalue%5Dof%20Object.entries%28entries%29%29%7B%0A%20%20assert.equal%28canonical%28inverse%5Btable%5D%5Bkey%5D%29%2Ccanonical%28value%29%29%3Bdelete%20inverse%5Btable%5D%5Bkey%5D%3B%0A%20%7D%0A%20assert.equal%28serializeProjectData%28inverse%2C%27schema.lino%27%29%2Cprevious%2C%27the%20complete%20old%20schema%20is%20byte-exact%27%29%3B%0A%20return%20serializeProjectData%28current%2C%27schema.lino%27%29%3B%0A%7D%0A%0Aexport%20function%20verifyTruthyProjectionSchemaPacket%28packet%29%20%7B%0A%20assert.deepEqual%28Object.keys%28packet%29.sort%28%29%2C%5B%27boundary%27%2C%27extensions%27%2C%27revision%27%2C%27schemaVersion%27%2C%27sources%27%5D%29%3B%0A%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.revision%2CTRUTHY_PROJECTION_REVISION%29%3B%0A%20assert.equal%28canonical%28packet.extensions%29%2Ccanonical%28TRUTHY_PROJECTION_ENTRIES%29%29%3B%0A%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2CinspectedTruthyPreimages.map%28row%3D%3Erow.file%29%29%3B%0A%20for%28const%20%5Bindex%2Crow%5Dof%20packet.sources.entries%28%29%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27certificate%27%2C%27current%27%2C%27file%27%2C%27previous%27%5D%29%3B%0A%20%20assert.deepEqual%28Object.keys%28row.previous%29.sort%28%29%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20assert.deepEqual%28Object.keys%28row.current%29.sort%28%29%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20const%20expected%3DinspectedTruthyPreimages%5Bindex%5D%3B%0A%20%20assert.deepEqual%28pinTruthyProjectionSource%28row.previous.source%29%2C%7Bbytes%3Aexpected.bytes%2Csha256%3Aexpected.sha256%7D%29%3B%0A%20%20assert.deepEqual%28pinTruthyProjectionSource%28row.previous.source%29%2C%7Bbytes%3Arow.previous.bytes%2Csha256%3Arow.previous.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.previous.source%29%2C%7Brevision%3ATRUTHY_PROJECTION_REVISION%2Cpath%3Arow.file%7D%29%3B%0A%20%20const%20derived%3Dindex%3C2%3FderiveTruthyProjectionSchema%28row.previous.source%29%3AderiveTruthyProjectionHostSource%28row.file%2Crow.previous.source%29%3B%0A%20%20assert.equal%28row.current.source%2Cderived%29%3Bassert.deepEqual%28pinTruthyProjectionSource%28derived%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%7D%0A%20assert.equal%28packet.sources%5B0%5D.previous.source%2Cpacket.sources%5B1%5D.previous.source%29%3B%0A%20assert.equal%28packet.sources%5B0%5D.current.source%2Cpacket.sources%5B1%5D.current.source%29%3B%0A%20return%20structuredClone%28packet%29%3B%0A%7D%0A%0Aexport%20function%20readTruthyProjectionSchemaPacket%28%29%20%7B%0A%20const%20bytes%3DreadFileSync%28new%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%29%3B%0A%20assert.equal%28pinTruthyProjectionSource%28bytes%29.sha256%2CrecipeSha256%2C%27complete%20normal-author%20packet%20is%20pinned%27%29%3B%0A%20return%20verifyTruthyProjectionSchemaPacket%28readProjectData%28new%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%29%29%3B%0A%7D%0A%0A%2F%2F%20Explicit%20historical%20readers%20only.%20Runtime%20schema%2Fcheckers%20always%20use%20actual%0A%2F%2F%20current%20bytes%3B%20unknown%20complete%20schema%20or%20host%20successors%20still%20refuse.%0Aexport%20function%20restoreTruthyProjectionHistoricalSource%28bytes%2Cfile%29%20%7B%0A%20assert.ok%28Buffer.isBuffer%28bytes%29%26%26bytes.length%3C%3D256%2A1024%29%3B%0A%20const%20expected%3DinspectedTruthyPreimages.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28expected%2C%27closed%20five-source%20historical%20view%27%29%3B%0A%20const%20text%3Dbytes.toString%28%27utf8%27%29%3Bassert.equal%28Buffer.from%28text%29.equals%28bytes%29%2Ctrue%29%3B%0A%20if%28pinTruthyProjectionSource%28bytes%29.sha256%3D%3D%3Dexpected.sha256%29%7Bassert.equal%28bytes.length%2Cexpected.bytes%29%3Breturn%20text%3B%7D%0A%20const%20packet%3DreadTruthyProjectionSchemaPacket%28%29%2Crow%3Dpacket.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3B%0A%20assert.equal%28text%2Crow.current.source%2C%27unknown%20complete%20current%20source%20refuses%20historical%20authority%27%29%3B%0A%20assert.deepEqual%28pinTruthyProjectionSource%28bytes%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20return%20row.previous.source%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
