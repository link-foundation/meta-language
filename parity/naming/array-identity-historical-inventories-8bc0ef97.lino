%28%27utf8%27%29%2Ccertificate%2Ccurrent%7D%3B%7D%3B%0A%20%20const%20%5Bartifact%2Cregister%2Cloan%5D%3Dpolicy.anchors.map%28row%3D%3Eoriginal%28row.file%2Cnull%29%29%3B%0A%20%20const%20sourceOwner%3D%7B...original%28policy.sourceFile%2Cpolicy.sourceOwner.current%29%2Cedits%3Apolicy.sourceOwner.edits%7D%3B%0A%20%20const%20adapters%3Dpolicy.adapters.map%28row%3D%3E%28%7B...original%28row.file%2Crow.current%29%2Cedits%3Arow.edits%7D%29%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3Apolicy.schemaVersion%2Cmodel%3Apolicy.model%2Crevision%3Apolicy.revision%2Cartifact%2Cregister%2Cloan%2CsourceOwner%2Cadapters%2Cedge%3Anull%2Cboundary%3Apolicy.boundary%7D%3B%0A%20%20const%20derived%3DderiveOwnCodebaseRawDescriptorOutputs%28packet%29%3Bpacket.edge%3Dderived.edge%3B%0A%20%20for%28const%20row%20of%20%5Bartifact%2Cregister%2Cloan%5D%29row.current%3Dpin%28derived.outputs.find%28output%3D%3Eoutput.file%3D%3D%3Drow.file%29.source%29%3B%0A%20%20verifyOwnCodebaseRawDescriptorPacket%28packet%29%3B%0A%20%20assert.deepEqual%28pin%28Buffer.from%28restoreCurrentOwnCodebaseRawSource%28readFileSync%28new%20URL%28policy.sourceFile%2Croot%29%2C%27utf8%27%29%2Cpolicy.sourceFile%29%29%29%2Cpolicy.sourceOwner.current%2C%27the%20original%20frontend%20assertion%20checks%20its%20exact%20historical%20view%3B%20live%20bytes%20belong%20to%20the%20successor%27%29%3B%0A%20%20const%20writes%3Dderived.outputs.map%28row%3D%3E%28%7B...row%2Cprevious%3A%5Bartifact%2Cregister%2Cloan%5D.find%28capture%3D%3Ecapture.file%3D%3D%3Drow.file%29.sourceText%7D%29%29%3B%0A%20%20for%28const%20%5Bindex%2Crow%5Dof%20adapters.entries%28%29%29writes.push%28%7Bfile%3Arow.file%2Cprevious%3Arow.sourceText%2Csource%3AderiveOwnCodebaseRawDescriptorSource%28policy.adapters%5Bindex%5D%2Crow.sourceText%29%7D%29%3B%0A%20%20for%28const%20row%20of%20writes%29%7Bconst%20physical%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Cobserved%3Dcheck%26%26%5Bpolicy.artifactFile%2Cpolicy.registerFile%2Cpolicy.loanFile%5D