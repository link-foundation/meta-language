0%20%7D%0A%20%20const%20row%3Drows.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bif%28%21row%29return%20source%3B%0A%20%20const%20actual%3Ddigest%28source%29%3B%0A%20%20assert.ok%28actual%3D%3D%3Drow.current.sha256%7C%7Cactual%3D%3D%3Drow.sha256%2C%27complete%20changed%20CI%20source%20requires%20a%20reviewed%20historical%20view%27%29%3B%0A%20%20if%28actual%3D%3D%3Drow.current.sha256%29assert.equal%28Buffer.byteLength%28source%29%2Crow.current.bytes%29%3B%0A%20%20const%20original%3DverifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.sourceText%29%2C%7Brevision%3Arow.commit%2Cpath%3Afile%7D%29%3B%0A%20%20assert.equal%28original.length%2Crow.bytes%29%3Bassert.equal%28digest%28original%29%2Crow.sha256%29%3B%0A%20%20if%28actual%3D%3D%3Drow.sha256%29assert.equal%28source%2Crow.sourceText%29%3B%0A%20%20return%20row.sourceText%3B%0A%7D%0A%0Aimport%20%7BrestoreEvidenceTranslationSourceHistory%7D%20from%20%27.%2Fevidence-translation-source-history.mjs%27%3B%0A%0Aimport%20%7BrestoreCurrentCiRepairSource%7D%20from%20%27.%2Fcurrent-ci-repair-source-history.mjs%27%3B%0A) (lang: meta-language%20structured%20data)))
