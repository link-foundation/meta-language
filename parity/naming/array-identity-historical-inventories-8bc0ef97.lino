0%20if%28%21file.startsWith%28%27js%2Fsrc%2F%27%29%29return%20source%3B%0A%20%20const%20module%3Dfile.slice%28%27js%2Fsrc%2F%27.length%29%2Cpacket%3DreadReviewedOverlayProviderSuccession%28%29%3B%0A%20%20let%20historical%3Dsource%3B%0A%20%20for%28const%20profile%20of%20packet.profiles.slice%281%29.toReversed%28%29%29%7B%0A%20%20%20%20const%20row%3Dprofile.certificates.find%28row%3D%3Erow.module%3D%3D%3Dmodule%29%3B%0A%20%20%20%20if%28row%26%26historical%3D%3D%3Drow.current.source%29historical%3Drow.previous.source%3B%0A%20%20%7D%0A%20%20return%20historical%3B%0A%7D%0A%0A%0Aexport%20function%20deriveReviewedOverlayProviderPolicy%28packet%29%7B%0A%20%20const%20original%3Dpacket.historicalOutputs%5B0%5D%2Cpolicy%3DreadStructuredDataLino%28original.source%29%3B%0A%20%20assert.equal%28policy.revisions.at%28-1%29.sourceCommit%2Cpacket.previousSourceCommit%29%3B%0A%20%20policy.revisions.push%28...packet.profiles%29%3Breturn%20policy%3B%0A%7D%0A%0Afunction%20verifyReviewedOverlayProviderEpoch%28packet%2Cindex%29%7B%0A%20%20const%20profile%3Dpacket.profiles%5Bindex%5D%2Cepoch%3Dprofile.epoch%2Creview%3DOVERLAY_PROVIDER_APPEND_REVIEW%3B%0A%20%20exactKeys%28epoch%2C%5B%27reviewKind%27%2C%27predecessorPacket%27%2C%27predecessorOutputs%27%5D%29%3B%0A%20%20assert.equal%28epoch.reviewKind%2Creview.kind%29%3Bassert.equal%28profile.previousSourceCommit%2Creview.previous%29%3B%0A%20%20assert.equal%28profile.review%2Creview.review%29%3Bassert.deepEqual%28profile.inverse.map%28row%3D%3Erow.module%29%2C%5Breview.module%5D%29%3B%0A%20%20const%20changed%3Dprofile.certificates.find%28row%3D%3Erow.module%3D%3D%3Dreview.module%29%3Bassert.ok%28changed%29%3B%0A%20%20assert.equal%28hash%28changed.previous.source%29%2Creview.previousSha256%29%3B%0A%20%20assert.deepEqual%28pin%28changed.current.source%29%2C%7Bbytes%3Areview.currentBytes%2Csha256%3Areview.currentSha256%7D%29%3B%0A%20%20const%20prefix%3D%7B...packet%2Cprofiles%3Apacket.profiles.slice%280%2Cindex%29%7D%3B%0A%20%20const%20oldPacket%