ts%27%2C%20%27distinctFrom%27%2C%0A%5D%29%3B%0A%0Aexport%20function%20buildConceptRecords%28register%29%20%7B%0A%20%20const%20owners%20%3D%20new%20Map%28%29%3B%0A%20%20const%20concepts%20%3D%20register.concepts.map%28%28concept%29%20%3D%3E%20%7B%0A%20%20%20%20for%20%28const%20name%20of%20%5Bconcept.id%2C%20...concept.formerNames%5D%29%20%7B%0A%20%20%20%20%20%20const%20owner%20%3D%20owners.get%28name%29%3B%0A%20%20%20%20%20%20if%20%28owner%29%20throw%20new%20Error%28%60%24%7Bname%7D%20names%20both%20%24%7Bowner%7D%20and%20%24%7Bconcept.id%7D%60%29%3B%0A%20%20%20%20%20%20owners.set%28name%2C%20concept.id%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20unknown%20%3D%20Object.keys%28concept%29.filter%28%28field%29%20%3D%3E%20%21RECORD_FIELDS.includes%28field%29%29%3B%0A%20%20%20%20if%20%28unknown.length%20%3E%200%29%20throw%20new%20Error%28%60%24%7Bconcept.id%7D%20has%20fields%20the%20runtimes%20do%20not%20read%3A%20%24%7Bunknown.join%28%27%2C%20%27%29%7D%60%29%3B%0A%20%20%20%20const%20record%20%3D%20%7B%7D%3B%0A%20%20%20%20for%20%28const%20field%20of%20RECORD_FIELDS%29%20%7B%0A%20%20%20%20%20%20if%20%28concept%5Bfield%5D%20%21%3D%3D%20undefined%29%20record%5Bfield%5D%20%3D%20concept%5Bfield%5D%3B%0A%20%20%20%20%7D%0A%20%20%20%20return%20record%3B%0A%20%20%7D%29%3B%0A%20%20for%20%28const%20concept%20of%20concepts%29%20%7B%0A%20%20%20%20if%20%28concept.represents%20%21%3D%3D%20undefined%20%26%26%20%21concepts.some%28%28%7B%20id%20%7D%29%20%3D%3E%20id%20%3D%3D%3D%20concept.represents%29%29%20%7B%0A%20%20%20%20%20%20throw%20new%20Error%28%60%24%7Bconcept.id%7D%20represents%20unknown%20concept%20%24%7Bconcept.represents%7D%60%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20return%20%7B%0A%20%20%20%20generatedBy%3A%20%27js%2Fscripts%2Fbuild-concept-records.mjs%27%2C%0A%20%20%20%20source%3A%20%27parity%2Fnaming%2Fcanonical-concepts.json%27%2C%0A%20%20%20%20concepts%2C%0A%20%20%7D%3B%0A%7D%0A%0Aexport%20function%20formatConceptRecords%28records%29%20%7B%0A%20%20const%20concepts%20%3