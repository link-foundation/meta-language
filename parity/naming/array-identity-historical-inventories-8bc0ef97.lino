IPTOR_HISTORICAL_FILE%2Croot%29%29%2Cblob%2C%27unknown%20live%20descriptors%20require%20another%20reviewed%20source%20epoch%27%29%3B%0A%20%20const%20borrowed%3DcaptureGitArtifactCertificate%28RAW_DESCRIPTOR_HISTORICAL_REVISION%2CRAW_DESCRIPTOR_BORROWED_FILE%29%2CborrowedCurrent%3Dborrowed.blob.toString%28%27utf8%27%29%3B%0A%20%20assert.deepEqual%28Buffer.from%28borrowedCurrent%29%2Cborrowed.blob%29%3Bassert.deepEqual%28pinRawDescriptorHistoricalSource%28borrowed.blob%29%2CRAW_DESCRIPTOR_BORROWED_CURRENT%29%3B%0A%20%20assert.deepEqual%28readFileSync%28new%20URL%28RAW_DESCRIPTOR_BORROWED_FILE%2Croot%29%29%2Cborrowed.blob%2C%27unknown%20borrowed%20receipt%20successors%20refuse%27%29%3B%0A%20%20const%20borrowedPrevious%3DreadRawDescriptorBorrowedAuthority%28%29.source%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27raw%20descriptor%20historical%20cohort%201%27%2Cfile%3ARAW_DESCRIPTOR_HISTORICAL_FILE%2Crevision%3ARAW_DESCRIPTOR_HISTORICAL_REVISION%2C%0A%20%20%20%20archive%3A%7Bfile%3ARAW_DESCRIPTOR_HISTORICAL_ARCHIVE%2C...RAW_DESCRIPTOR_HISTORICAL_ARCHIVE_PIN%2Cidentity%3A%27raw%20consuming%27%7D%2C%0A%20%20%20%20previous%3A%7Brevision%3Aold.commit%2C...RAW_DESCRIPTOR_HISTORICAL_PREVIOUS%7D%2Ccurrent%3A%7B...RAW_DESCRIPTOR_HISTORICAL_CURRENT%2Ccertificate%7D%2C%0A%20%20%20%20edits%3AderiveRawDescriptorHistoricalChanges%28old.sourceText%2Ccurrent%29%2C%0A%20%20%20%20borrowed%3A%7Bfile%3ARAW_DESCRIPTOR_BORROWED_FILE%2C%0A%20%20%20%20%20%20archive%3A%7Bfile%3ARAW_DESCRIPTOR_CONTINUATION_ARCHIVE%2C...RAW_DESCRIPTOR_CONTINUATION_ARCHIVE_PIN%2Csource%3ARAW_DESCRIPTOR_BORROWED_FILE%2Cprofile%3A%27relative%20array%27%7D%2C%0A%20%20%20%20%20%20previous%3A%7B...RAW_DESCRIPTOR_BORROWED_PREVIOUS%7D%2Ccurrent%3A%7B...RAW_DESCRIPTOR_BORROWED_CURRENT%2Ccertificate%3Aborrowed.certificate%7D%2C%0A%20%20%20%20%20%20edit%3AderiveRawDescriptorBorrowedChange%28borrowedPrevious%2CborrowedCurrent%29%7D%2C%0A%20%20%20%20boundary%3A%27Complete%20committed%20descriptor%20metadata%20