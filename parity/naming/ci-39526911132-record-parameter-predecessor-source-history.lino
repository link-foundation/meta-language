7Brevision%7D%3A%24%7Bpath%7D%60%5D%2C%20%7B%0A%20%20cwd%3A%20root%2C%20maxBuffer%3A%2016%20%2A%201024%20%2A%201024%2C%20timeout%3A%2030000%2C%20stdio%3A%20%5B%27ignore%27%2C%20%27pipe%27%2C%20%27pipe%27%5D%2C%0A%7D%29%3B%0A%0A%2F%2F%20A%20null%20result%20means%20this%20exact%20path%20is%20absent%20from%20an%20otherwise%20valid%20commit.%0A%2F%2F%20Other%20Git%20failures%20remain%20errors%20rather%20than%20being%20interpreted%20as%20missing%20history.%0Aconst%20optionalBlob%20%3D%20%28revision%2C%20path%29%20%3D%3E%20%7B%0A%20%20const%20listing%20%3D%20execFileSync%28%27git%27%2C%20%5B%27ls-tree%27%2C%20revision%2C%20%27--%27%2C%20path%5D%2C%20%7B%0A%20%20%20%20cwd%3A%20root%2C%20maxBuffer%3A%201024%20%2A%201024%2C%20timeout%3A%2030000%2C%20stdio%3A%20%5B%27ignore%27%2C%20%27pipe%27%2C%20%27pipe%27%5D%2C%0A%20%20%7D%29%3B%0A%20%20return%20listing.length%20%3F%20blob%28revision%2C%20path%29%20%3A%20null%3B%0A%7D%3B%0A%0Aexport%20function%20validateTranslationStageRefreshHistory%28history%2C%20loadBlob%20%3D%20optionalBlob%2C%20snapshotRevision%29%20%7B%0A%20%20if%20%28%21history%20%7C%7C%20history.schemaVersion%20%21%3D%3D%201%20%7C%7C%20%21Array.isArray%28history.receipts%29%20%7C%7C%20%21history.receipts.length%0A%20%20%20%20%20%20%7C%7C%20%21isDeepStrictEqual%28Object.keys%28history%29.sort%28%29%2C%20%5B%27receipts%27%2C%20%27schemaVersion%27%5D%29%29%20%7B%0A%20%20%20%20throw%20new%20Error%28%27stage%20refresh%20history%20requires%20a%20nonempty%20ordered%20receipt%20archive%27%29%3B%0A%20%20%7D%0A%20%20const%20identities%20%3D%20new%20Set%28%29%3B%0A%20%20const%20receipts%20%3D%20%5B%5D%3B%0A%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20history.receipts.length%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20const%20entry%20%3D%20history.receipts%5Bindex%5D%3B%0A%20%20%20%20if%20%28%21entry%20%7C%7C%20%21isDeepStrictEqual%28Object.keys%28entry%29.sort%28%29%2C%20%5B%27receipt%27%2C%20%27sourceCommit%27%2C%20%27sourcePath%27%2C%20%27sourceSha256%27%5D%29