.definitions.length%2Cdeclarations.length%29%3B%0A%20%20assert.equal%28emitted.preludes.length%2C0%2C%27the%20complete%20model%20selectors%20remain%20closed%20scalar%20decisions%27%29%3B%0A%20%20const%20files%3DwriteRecordRuleLibrary%28emitted%2C%27string_order_rules%27%2C%7Bcheck%7D%29%3B%0A%20%20const%20values%3D%5B%27%27%2C%27A%27%2C%27AA%27%2C%27AB%27%2C%27B%27%2C%27%5Cu0000%27%2C%27%5Cuffff%27%2C%27%5Cue000%27%2C%27%F0%9F%98%80%27%2C%27%5Cud800%27%2C%27%5Cudc00%27%2C%27%5Cud800%5Cudc00%27%2C%0A%20%20%20%20%27%5Cudbff%5Cudfff%27%2C%27%C3%A9%27%2C%27e%5Cu0301%27%2C%27a%27%2C%27a%5Cu0000%27%2C%27a%5Cud800%27%2C%27a%5Cudc00%27%2C%27a%F0%9F%98%80%27%2C%27%5Cufffd%27%2C%27Z%27%2C%270%27%2C%279%27%2C%27-%27%2C%2700%27%2C%27a%27.repeat%2864%29%5D%3B%0A%20%20const%20units%3Dvalues.map%28value%3D%3EArray.from%28%7Blength%3Avalue.length%7D%2C%28_%2Cindex%29%3D%3Evalue.charCodeAt%28index%29%29%29%3B%0A%20%20const%20cases%3D%5B%5D%3B%0A%20%20for%28let%20left%3D0%3Bleft%3Cvalues.length%3Bleft%2B%2B%29for%28let%20right%3D0%3Bright%3Cvalues.length%3Bright%2B%2B%29for%28const%20row%20of%20model.relations%29%7B%0A%20%20%20%20const%20a%3Dvalues%5Bleft%5D%2Cb%3Dvalues%5Bright%5D%2Cop%3Drow.sourceOperator%3B%0A%20%20%20%20const%20expected%3Dop%3D%3D%3D%27lt%27%3Fa%3Cb%3Aop%3D%3D%3D%27le%27%3Fa%3C%3Db%3Aop%3D%3D%3D%27gt%27%3Fa%3Eb%3Aa%3E%3Db%3B%0A%20%20%20%20cases.push%28%7Bleft%2Cright%2Coperator%3Aop%2Coperation%3Arow.operation%2Cexpected%7D%29%3B%0A%20%20%7D%0A%20%20const%20fixture%3D%7BschemaVersion%3A1%2Cmodel%3Amodel.model%2CnativePreludeSha256%3Amodel.nativePreludeSha256%2Cunits%2Ccases%2C%0A%20%20%20%20boundary%3A%27Independent%20native%20JavaScript%20primitive%20string%20relational%20observations%2C%20preserving%20explicit%20UTF16%20input%20units.%20Shared%20selectors%20and%20actual%20emitted%20programs%20execute%20separately.%20No%20local%20native%20execution%20or%20arbitrary%20Rust%20String%20source%20equivalence%20is%20claimed.%27%7D%3B%0A%20%20const%20fixtureFile%3Dnew%