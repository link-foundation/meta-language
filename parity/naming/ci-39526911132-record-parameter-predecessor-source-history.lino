0A%20%20const%20producerSource%3DproducerOriginal.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28producerSource%29%2CproducerOriginal.blob%29%3B%0A%20%20const%20producerReplay%3DreplayProgramStringRegistrationChanges%28producerSource%2CPROGRAM_STRING_HOST_PRODUCER_CHANGES%29%3B%0A%20%20assert.equal%28readFileSync%28new%20URL%28PROGRAM_STRING_HOST_PRODUCER.path%2Croot%29%2C%27utf8%27%29%2CproducerReplay.source%29%3B%0A%20%20const%20sources%3DPROGRAM_STRING_REGISTRATION_CHANGES.map%28specification%3D%3E%7B%0A%20%20%20%20const%20row%3Dprevious.sources.find%28row%3D%3Erow.file%3D%3D%3Dspecification.path%29%3Bassert.ok%28row%29%3B%0A%20%20%20%20const%20captured%3DcaptureGitArtifactCertificate%28PROGRAM_STRING_REGISTRATION_REVISION%2Cspecification.path%29%3B%0A%20%20%20%20const%20source%3Dcaptured.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28source%29%2Ccaptured.blob%29%3B%0A%20%20%20%20const%20replay%3DreplayProgramStringRegistrationChanges%28row.proposed.source%2Cspecification.changes%29%3B%0A%20%20%20%20assert.equal%28source%2Creplay.source%2C%27only%20the%20finite%20registration%20additions%20belong%20to%20this%20committed%20successor%27%29%3B%0A%20%20%20%20assert.equal%28readFileSync%28new%20URL%28specification.path%2Croot%29%2C%27utf8%27%29%2Csource%2C%27actual%20current%20source%20must%20still%20equal%20the%20certified%20committed%20source%27%29%3B%0A%20%20%20%20return%7Bpath%3Aspecification.path%2Cpredecessor%3A%7Bsource%3Arow.proposed.source%2C...programStringHostRegistrationPin%28row.proposed.source%29%7D%2C%0A%20%20%20%20%20%20current%3A%7Bsource%2C...programStringHostRegistrationPin%28source%29%2Ccertificate%3Acaptured.certificate%7D%2Cedits%3Areplay.edits%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20registrations%3DPROGRAM_STRING_REGISTRATIONS.map%28specification%3D%3E%7B%0A%20%20%20%20const%20captured%3DcaptureGitArtifactCertificate%28PROGRAM_STRING_REGISTRATION_REVISION%2Cspecification.path%29%3B%0A%20%20%20%20assert.deepEqual%28captured.blob%2CreadFileSync%28new%20URL%28specification.path%2Croot%29%29%29%3B%0A%20%20%20%20return%7B...specification%2C...programStringHostRegistrationPin%28captured.blob%29%2Ccertificate%3Acaptured.certificate%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27program%20string%20host%20registration%20succession%201%27%2Crevision%3APROGRAM_STRING_REGISTRATION_REVISION%2C%0A%20%20%20%20hostRevision%3APROGRAM_STRING_HOST_REVISION%2CcoordinateUnit%3A%27UTF-16%20code%20units%27%2C%0A%20%20%20%20hostArchive%3A%7B...PROGRAM_STRING_HOST_ARCHIVE%2Ccertificate%3Aarchived.certificate%7D%2C%0A%20%20%20%20producer%3A%7Bpath%3APROGRAM_STRING_HOST_PRODUCER.path%2Csource%3AproducerSource%2C...programStringHostRegistrationPin%28producerSource%29%2C%0A%20%20%20%20%20%20certificate%3AproducerOriginal.certificate%2Ccurrent%3AprogramStringHostRegistrationPin%28producerReplay.source%29%2Cedits%3AproducerReplay.edits%7D%2C%0A%20%20%20%20sources%2Cregistrations%2C%0A%20%20%20%20boundary%3A%27Complete%20committed%20source%20membership%20and%20finite%20byte%20inverses%20only.%20Every%20original%20program-string%20host%20definition%2C%20test%2C%20source%20action%20and%20assertion%20remains%20in%20the%20separately%20pinned%20unchanged%20nine-host%20archive.%20Current%20native%20registrations%20are%20proved%20separately%20against%20actual%20module%20roots%20and%20actual%20registered%20files.%20This%20authenticates%20no%20new%20runtime%20behavior%2C%20native%20compilation%2Fexecution%2C%20grammar%20coverage%20or%20general%20source%20equivalence.%27%7D%3B%0A%20%20verifyProgramStringHostRegistrationHistory%28packet%29%3B%0A%20%20if%28check%29checkProjectData%28new%20URL%28output%2Croot%29%2Cpacket%29%3Belse%20writeProjectData%28new%20URL%28output%2Croot%29%2Cpacket%29%3B%0A%20%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Csource%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2Fconst%20policySha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%3B%0A%20%20assert.equal%28source.split%28pattern%29.length%2C2%29%3B%0A%20%20const%20expected%3Dsource.replace%28pattern%2C%22const%20policySha256%3D%27%22%2BprogramStringHostRegistrationPin%28readFileSync%28new%20URL%28output%2Croot%29%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28helperPath%2Cexpected%29%3B%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28argument%3D%3Eargument%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20packet%3DgenerateProgramStringHostRegistrationHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28JSON.stringify%28%7BsourceRoots%3Apacket.sources.map%28row%3D%3Erow.path%29%2Cregistrations%3Apacket.registrations.length%2CnativeCompilation%3Afalse%2CnativeExecution%3Afalse%7D%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
