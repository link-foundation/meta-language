ull%29%29%3B%0A%20%20const%20sourceOwner%3D%7B...original%28policy.sourceFile%2Cpolicy.sourceOwner.current%29%2Cedits%3Apolicy.sourceOwner.edits%7D%3B%0A%20%20const%20adapters%3Dpolicy.adapters.map%28row%3D%3E%28%7B...original%28row.file%2Crow.current%29%2Cedits%3Arow.edits%7D%29%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3Apolicy.schemaVersion%2Cmodel%3Apolicy.model%2Crevision%3Apolicy.revision%2Cartifact%2Cregister%2Cloan%2CsourceOwner%2Cadapters%2Cedge%3Anull%2Cboundary%3Apolicy.boundary%7D%3B%0A%20%20const%20derived%3DderiveOwnCodebaseRawDescriptorOutputs%28packet%29%3Bpacket.edge%3Dderived.edge%3B%0A%20%20for%28const%20row%20of%20%5Bartifact%2Cregister%2Cloan%5D%29row.current%3Dpin%28derived.outputs.find%28output%3D%3Eoutput.file%3D%3D%3Drow.file%29.source%29%3B%0A%20%20verifyOwnCodebaseRawDescriptorPacket%28packet%29%3B%0A%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28policy.sourceFile%2Croot%29%29%29%2Cpolicy.sourceOwner.current%2C%27the%20actual%20reviewed%20frontend%20source%2C%20not%20an%20archived%20read%20view%2C%20is%20used%27%29%3B%0A%20%20const%20writes%3Dderived.outputs.map%28row%3D%3E%28%7B...row%2Cprevious%3A%5Bartifact%2Cregister%2Cloan%5D.find%28capture%3D%3Ecapture.file%3D%3D%3Drow.file%29.sourceText%7D%29%29%3B%0A%20%20for%28const%20%5Bindex%2Crow%5Dof%20adapters.entries%28%29%29writes.push%28%7Bfile%3Arow.file%2Cprevious%3Arow.sourceText%2Csource%3AderiveOwnCodebaseRawDescriptorSource%28policy.adapters%5Bindex%5D%2Crow.sourceText%29%7D%29%3B%0A%20%20for%28const%20row%20of%20writes%29%7Bconst%20observed%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%3Bassert.ok%28observed%3D%3D%3Drow.previous%7C%7Cobserved%3D%3D%3Drow.source%2C%27unknown%20complete%20source%20or%20artifact%20changes%20refuse%3A%20%27%2Brow.file%29%3Bif%28check%29assert.equal%28observed%2Crow.source%29%3B%7D%0A%20%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Csource%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2F%5Econst%20policySha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%24%2Fmu%3B%0A%20%20assert.equal%28source.split%28pattern%29.length%2C2%29%3B%0A%20%20if%28check%29checkProjectData%28new%20URL%28output%2Croot%29%2Cpacket%29%3Belse%20writeProjectData%28new%20URL%28output%2Croot%29%2Cpacket%29%3B%0A%20%20const%20expected%3Dsource.replace%28pattern%2C%22const%20policySha256%3D%27%22%2Bpin%28readFileSync%28new%20URL%28output%2Croot%29%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%7Bfor%28const%20row%20of%20writes%29writeFileSync%28new%20URL%28row.file%2Croot%29%2Crow.source%29%3BwriteFileSync%28helperPath%2Cexpected%29%3B%7D%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28args.length%3C%3D1%26%26args.every%28arg%3D%3Earg%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateOwnCodebaseRawSourceDescriptors%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Current%20frontend%20descriptors%20and%20borrowed%20predecessor%20pins%20updated%3B%20every%20certified%20original%20byte%20retained%2C%20without%20translation%20or%20native%20execution.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
