9%3B%0A%20%20%20%20assert.equal%28bytes.length%2C%20successor.current.bytes%29%3B%0A%20%20%20%20let%20limit%20%3D%20bytes.length%3B%0A%20%20%20%20for%20%28const%20edit%20of%20successor.edits.toReversed%28%29%29%20%7B%0A%20%20%20%20%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%20%26%26%20Number.isSafeInteger%28edit.end%29%0A%20%20%20%20%20%20%20%20%26%26%20edit.start%20%3E%3D%200%20%26%26%20edit.end%20%3E%3D%20edit.start%20%26%26%20edit.end%20%3C%3D%20limit%29%3B%0A%20%20%20%20%20%20assert.equal%28bytes.subarray%28edit.start%2C%20edit.end%29.toString%28%27utf8%27%29%2C%20edit.currentText%29%3B%0A%20%20%20%20%20%20bytes%20%3D%20Buffer.concat%28%5Bbytes.subarray%280%2C%20edit.start%29%2C%20Buffer.from%28edit.previousText%29%2C%20bytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20%20%20limit%20%3D%20edit.start%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28bytes.length%2C%20successor.previous.bytes%29%3B%0A%20%20%20%20assert.equal%28digest%28bytes%29%2C%20successor.previous.sha256%29%3B%0A%20%20%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2C%20successor.previous.sourceText%29%3B%0A%20%20%20%20source%20%3D%20bytes.toString%28%27utf8%27%29%3B%0A%20%20%7D%0A%20%20if%20%28digest%28bytes%29%20%3D%3D%3D%20entry.previous.sha256%29%20%7B%0A%20%20%20%20assert.equal%28bytes.length%2C%20entry.previous.bytes%29%3B%0A%20%20%20%20assert.equal%28source%2C%20entry.previous.sourceText%29%3B%0A%20%20%20%20return%20source%3B%0A%20%20%7D%0A%20%20assert.equal%28bytes.length%2C%20entry.current.bytes%2C%20%27unreviewed%20current%20source%20changes%20refuse%27%29%3B%0A%20%20assert.equal%28digest%28bytes%29%2C%20entry.current.sha256%2C%20%27the%20complete%20current%20source%20must%20match%20its%20reviewed%20input%27%29%3B%0A%20%20let%20limit%20%3D%20bytes.length%3B%0A%20%20for%20%28const%20edit%20of%20entry.edits.toReversed%28%29%29%20%7B%0A%20%20%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%20%26%26%20Number.isSafeInteger%28edit.end%29%0A%20%20%20%20%20%20%26%26%20edit.start%20%3E%3D%200%20%26%26%20edit.end%20%3E%3D%20edit.start%20%26%26%20edit.end%20%3C%3D%20limit%2C%20%27ordered%20disjoint%20source%20intervals%20required%27%29%3B%0A%20%20%20%20assert.equal%28bytes.subarray%28edit.start%2C%20edit.end%29.toString%28%27utf8%27%29%2C%20edit.currentText%29%3B%0A%20%20%20%20bytes%20%3D%20Buffer.concat%28%5Bbytes.subarray%280%2C%20edit.start%29%2C%20Buffer.from%28edit.previousText%29%2C%20bytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20limit%20%3D%20edit.start%3B%0A%20%20%7D%0A%20%20assert.equal%28bytes.length%2C%20entry.previous.bytes%2C%20%27the%20complete%20original%20source%20byte%20count%20is%20restored%27%29%3B%0A%20%20assert.equal%28digest%28bytes%29%2C%20entry.previous.sha256%2C%20%27every%20original%20source%20byte%20and%20context%20is%20restored%27%29%3B%0A%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2C%20entry.previous.sourceText%29%3B%0A%20%20return%20bytes.toString%28%27utf8%27%29%3B%0A%7D) (lang: meta-language%20structured%20data)))
