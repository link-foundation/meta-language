(65446: (meta: (t: semantic) (n: 1) (term: string%20value) (def: export%20function%20restoreTranslationSourceHistory%28source%2C%20file%2C%20revision%29%20%7B%0A%20%20assert.equal%28typeof%20source%2C%20%27string%27%2C%20%27a%20complete%20source%20string%20is%20required%27%29%3B%0A%20%20assert.ok%28Buffer.byteLength%28source%29%20%3C%3D%201024%20%2A%201024%2C%20%27bounded%20complete%20source%20required%27%29%3B%0A%20%20if%20%28%21history%29%20%7B%0A%20%20%20%20const%20bytes%20%3D%20readFileSync%28historyFile%29%3B%0A%20%20%20%20assert.equal%28digest%28bytes%29%2C%20historyHash%2C%20%27the%20whole%20reviewed%20inverse%20policy%20remains%20exact%27%29%3B%0A%20%20%20%20history%20%3D%20readProjectData%28historyFile%29%3B%0A%20%20%20%20assert.equal%28history.schemaVersion%2C%201%29%3B%0A%20%20%20%20assert.equal%28history.sources.length%2C%206%29%3B%0A%20%20%7D%0A%20%20const%20entries%20%3D%20history.sources.filter%28row%20%3D%3E%20row.file%20%3D%3D%3D%20file%20%26%26%20row.revision%20%3D%3D%3D%20revision%29%3B%0A%20%20assert.equal%28entries.length%2C%201%2C%20%27one%20exact%20recorded%20source%20and%20predecessor%20revision%20are%20required%27%29%3B%0A%20%20const%20entry%20%3D%20entries%5B0%5D%3B%0A%20%20let%20bytes%20%3D%20Buffer.from%28source%29%3B%0A%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2C%20source%2C%20%27complete%20source%20retains%20valid%20UTF8%27%29%3B%0A%20%20if%20%28digest%28bytes%29%20%3D%3D%3D%20entry.previous.sha256%29%20%7B%0A%20%20%20%20assert.equal%28bytes.length%2C%20entry.previous.bytes%29%3B%0A%20%20%20%20assert.equal%28source%2C%20entry.previous.sourceText%29%3B%0A%20%20%20%20return%20source%3B%0A%20%20%7D%0A%20%20assert.equal%28bytes.length%2C%20entry.current.bytes%2C%20%27unreviewed%20current%20source%20changes%20refuse%27%29%3B%0A%20%20assert.equal%28digest%28bytes%29%2C%20entry.current.sha256%2C%20%27the%20complete%20current%20source%20must%20match%20its%20reviewed%20input%27%29%3B%0A%20%20let%20limit%20%3D%20bytes.length%3B%0A%20%20