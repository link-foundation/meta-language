29%3B%0A%20%20assert.equal%28packet.revision%2CPROGRAM_STRING_REGISTRATION_REVISION%29%3Bassert.equal%28packet.hostRevision%2CPROGRAM_STRING_HOST_REVISION%29%3B%0A%20%20assert.equal%28pairs.size%2C2%29%3Bassert.equal%28packet.registrations.length%2C5%29%3B%0A%20%20const%20bytes%3DreadFileSync%28new%20URL%28PROGRAM_STRING_HOST_ARCHIVE.path%2Croot%29%29%3B%0A%20%20assert.deepEqual%28programStringHostRegistrationPin%28bytes%29%2C%7Bbytes%3APROGRAM_STRING_HOST_ARCHIVE.bytes%2Csha256%3APROGRAM_STRING_HOST_ARCHIVE.sha256%7D%29%3B%0A%20%20const%20original%3DreadProjectData%28new%20URL%28PROGRAM_STRING_HOST_ARCHIVE.path%2Croot%29%29%3B%0A%20%20assert.equal%28original.sources.length%2C9%29%3B%0A%20%20for%28const%20specification%20of%20PROGRAM_STRING_REGISTRATION_CHANGES%29%7B%0A%20%20%20%20const%20pair%3Dpairs.get%28specification.path%29%2Crow%3Doriginal.sources.find%28row%3D%3Erow.file%3D%3D%3Dspecification.path%29%3B%0A%20%20%20%20assert.equal%28pair.previous%2Crow.proposed.source%29%3B%0A%20%20%20%20assert.equal%28pair.current%2CreadFileSync%28new%20URL%28specification.path%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28pair.current%2Cspecification.path%29%2Crow.proposed.source%29%3B%0A%20%20%20%20assert.equal%28replayProgramStringRegistrationChanges%28row.sourceText%2Crow.actions%29.source%2Crow.proposed.source%29%3B%0A%20%20%7D%0A%20%20for%28const%20registration%20of%20PROGRAM_STRING_REGISTRATIONS%29%7B%0A%20%20%20%20assert.equal%28pairs.get%28registration.owner%29.current.split%28registration.declaration%2B%27%5Cn%27%29.length%2C2%29%3B%0A%20%20%20%20assert.ok%28readFileSync%28new%20URL%28registration.path%2Croot%29%29.length%3E0%29%3B%0A%20%20%7D%0A%20%20for%28const%20row%20of%20original.sources.filter%28row%3D%3E%21pairs.has%28row.file%29%29%29%7B%0A%20%20%20%20assert.equal%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.proposed.source%2C%27the%20seven%20other%20complete%20host%20proposals%20remain%20exact%27%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28readFileSync%28new%20URL%28PROGRAM_STRING_HOST_ARCHIVE.path%2Croot%29%29%2Cbytes%2C%27the%20historical%20artifact%20is%20unchanged%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27unknown%20complete%20roots%20wrong%20paths%20changed%20declaration%20order%20and%20newline%20successors%20stay%20visible%20to%20the%20original%20strict%20gate%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3Dpolicy%28%29%2Cold%3DreadProjectData%28new%20URL%28PROGRAM_STRING_HOST_ARCHIVE.path%2Croot%29%29%3B%0A%20%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20%20%20const%20historical%3Dold.sources.find%28owner%3D%3Eowner.file%3D%3D%3Drow.path%29%3B%0A%20%20%20%20const%20other%3Dpacket.sources.find%28owner%3D%3Eowner.path%21%3D%3Drow.path%29%3B%0A%20%20%20%20for%28const%20source%20of%20%5Brow.current.source%2B%27%5Cn%27%2Crow.current.source.replace%28%27mod%20%27%2C%27mod%20%2F%2A%20unknown%20%2A%2F%20%27%29%2C%0A%20%20%20%20%20%20row.current.source.replace%28row.edits%5B0%5D.inserted%2Crow.edits%5B0%5D.inserted.split%28%27%5Cn%27%29.toReversed%28%29.join%28%27%5Cn%27%29%29%5D%29%7B%0A%20%20%20%20%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28source%2Crow.path%29%2Csource%29%3B%0A%20%20%20%20%20%20assert.ok%28source%21%3D%3Dhistorical.sourceText%26%26source%21%3D%3Dhistorical.proposed.source%2C%27the%20unchanged%20old%20host%20assertion%20still%20refuses%20unknown%20source%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28row.current.source%2Cother.path%29%2Crow.current.source%29%3B%0A%20%20%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28row.current.source%2C%27unregistered.rs%27%29%2Crow.current.source%29%3B%0A%20%20%20%20for%28const%20source%20of%20%5Bhistorical.sourceText%2Chistorical.proposed.source%5D%29%7B%0A%20%20%20%20%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28source%2Crow.path%29%2Csource%2C%27both%20original%20h