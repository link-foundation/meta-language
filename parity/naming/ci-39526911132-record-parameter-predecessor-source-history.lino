n%20succession%201%27%29%3B%0A%20%20assert.equal%28packet.revision%2CPROGRAM_STRING_REGISTRATION_REVISION%29%3Bassert.equal%28packet.hostRevision%2CPROGRAM_STRING_HOST_REVISION%29%3B%0A%20%20assert.equal%28packet.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20exactFields%28packet.hostArchive%2C%5B%27path%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20assert.deepEqual%28%7Bpath%3Apacket.hostArchive.path%2Cbytes%3Apacket.hostArchive.bytes%2Csha256%3Apacket.hostArchive.sha256%7D%2CPROGRAM_STRING_HOST_ARCHIVE%29%3B%0A%20%20const%20archived%3DoriginalHosts%28%29%3B%0A%20%20verifyGitArtifactCertificate%28packet.hostArchive.certificate%2Carchived.bytes%2C%7Brevision%3APROGRAM_STRING_REGISTRATION_REVISION%2Cpath%3APROGRAM_STRING_HOST_ARCHIVE.path%7D%29%3B%0A%20%20assert.equal%28archived.value.revision%2CPROGRAM_STRING_HOST_REVISION%29%3Bassert.equal%28archived.value.sources.length%2C9%29%3B%0A%20%20exactFields%28packet.producer%2C%5B%27path%27%2C%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.deepEqual%28%7Bpath%3Apacket.producer.path%2Cbytes%3Apacket.producer.bytes%2Csha256%3Apacket.producer.sha256%7D%2CPROGRAM_STRING_HOST_PRODUCER%29%3B%0A%20%20assert.deepEqual%28programStringHostRegistrationPin%28packet.producer.source%29%2C%7Bbytes%3APROGRAM_STRING_HOST_PRODUCER.bytes%2Csha256%3APROGRAM_STRING_HOST_PRODUCER.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28packet.producer.certificate%2CBuffer.from%28packet.producer.source%29%2C%7Brevision%3APROGRAM_STRING_REGISTRATION_REVISION%2Cpath%3APROGRAM_STRING_HOST_PRODUCER.path%7D%29%3B%0A%20%20const%20producer%3DreplayProgramStringRegistrationChanges%28packet.producer.source%2CPROGRAM_STRING_HOST_PRODUCER_CHANGES%29%3B%0A%20%20assert.deepEqual%28packet.producer.edits%2Cproducer.edits%29%3Bassert.deepEqual%28packet.producer.current%2CprogramStringHostRegistrationPin%28producer.source%29%29%3B%0A%20%20assert.equal%28readFileSync%28new%20URL%28PROGRAM_STRING_HOST_PRODUCER.path%2Croot%29%2C%27utf8%27%29%2Cproducer.source%2C%27the%20actual%20generator%20is%20exactly%20its%20two%20finite%20source-view%20edits%27%29%3B%0A%20%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.path%29%2CPROGRAM_STRING_REGISTRATION_CHANGES.map%28row%3D%3Erow.path%29%29%3B%0A%20%20const%20result%3Dnew%20Map%28%29%3B%0A%20%20for%28const%5Bindex%2Crow%5Dof%20packet.sources.entries%28%29%29%7B%0A%20%20%20%20exactFields%28row%2C%5B%27path%27%2C%27predecessor%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20%20%20exactFields%28row.predecessor%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%5D%29%3BexactFields%28row.current%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20const%20specification%3DPROGRAM_STRING_REGISTRATION_CHANGES%5Bindex%5D%3B%0A%20%20%20%20const%20original%3Darchived.value.sources.find%28owner%3D%3Eowner.file%3D%3D%3Drow.path%29%3Bassert.ok%28original%29%3B%0A%20%20%20%20assert.equal%28original.commit%2CPROGRAM_STRING_HOST_REVISION%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28original.certificate%2CBuffer.from%28original.sourceText%29%2C%7Brevision%3APROGRAM_STRING_HOST_REVISION%2Cpath%3Arow.path%7D%29%3B%0A%20%20%20%20const%20originalReplay%3DreplayProgramStringRegistrationChanges%28original.sourceText%2Coriginal.actions%29%3B%0A%20%20%20%20assert.equal%28originalReplay.source%2Coriginal.proposed.source%29%3B%0A%20%20%20%20assert.deepEqual%28programStringHostRegistrationPin%28originalReplay.source%29%2C%7Bbytes%3Aoriginal.proposed.bytes%2Csha256%3Aoriginal.proposed.sha256%7D%29%3B%0A%20%20%20%20assert.equal%28row.predecessor.source%2Coriginal.proposed.source%29%3B%0A%20%20%20%20assert.deepEqual%28programStringHostRegistrationPin%28row.predecessor.source%29%2C%7Bbytes%3Arow.predecessor.bytes%2Csha256%3Arow.predecessor.sha256%7D%29%3B%0A%20%20%20%20const%20replay%3DreplayProgramStringRegistrationChanges%28row.predecessor.source%2Cspecification.changes%29%3B%0A%20%20%20%20assert.deepEqual%28row.edits%2Creplay.edits%29%3Bassert.equal%28row.current.source%2Creplay.source%29%3B%0A%20%20%20%20assert.deepEqual%28programStringHostRegistrationPin%28row.current.source%29%2Cspecification.current%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%2Cspecification.current%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.current.certificate%2CBuffer.from%28row.current.source%29%2C%7Brevision%3APROGRAM_STRING_REGISTRATION_REVISION%2Cpath%3Arow.path%7D%29%3B%0A%20%20%20%20assert.equal%28readFileSync%28new%20URL%28row.path%2Croot%29%2C%27utf8%27%29%2Crow.current.source%2C%27the%20actual%20current%20module%20root%20retains%20every%20authenticated%20registration%20and%20byte%27%29%3B%0A%20%20%20%20result.set%28row.path%2C%7Bprevious%3Arow.predecessor.source%2Ccurrent%3Arow.current.source%7D%29%3B%0A%20%20%7D%0A%20%20assert.equal%28packet.registrations.length%2CPROGRAM_STRING_REGISTRATIONS.length%29%3B%0A%20%20for%28const%5Bindex%2Crow%5Dof%20packet.registrations.entries%28%29%29%7B%0A%20%20%20%20exactFields%28row%2C%5B%27owner%27%2C%27declaration%27%2C%27path%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bowner%3Arow.owner%2Cdeclaration%3Arow.declaration%2Cpath%3Arow.path%7D%2CPROGRAM_STRING_REGISTRATIONS%5Bindex%5D%29%3B%0A%20%20%20%20assert.equal%28result.get%28row.owner%29.current.split%28row.declaration%2B%27%5Cn%27%29.length%2C2%2C%27one%20actual%20owned%20module%20registration%27%29%3B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28row.path%2Croot%29%29%3B%0A%20%20%20%20assert.deepEqual%28programStringHostRegistrationPin%28bytes%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2Cbytes%2C%7Brevision%3APROGRAM_STRING_REGISTRATION_REVISION%2Cpath%3Arow.path%7D%29%3B%0A%20%20%7D%0A%20%20return%20result%3B%0A%7D%0A%0A%2F%2A%2A%20Unknown%20successors%20remain%20visible%20to%20the%20old%20strict%20host%20assertion.%20%2A%2F%0Aexport%20function%20restoreProgramStringHostRegistrationSource%28source%2Cpath%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20path%2C%27string%27%29%3B%0A%20%20const%20selected%3DPROGRAM_STRING_REGISTRATION_CHANGES.find%28row%3D%3Erow.path%3D%3D%3Dpath%29%3B%0A%20%20if%28%21selected%7C%7CprogramStringHostRegistrationPin%28source%29.sha256%21%3D%3Dselected.current.sha256%29return%20source%3B%0A%20%20assert.deepEqual%28programStringHostRegistrationPin%28source%29%2Cselected.current%29%3B%0A%20%20if%28%21cachedPolicy%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28policyPath%2Croot%29%29%3Bassert.equal%28programStringHostRegistrationPin%28bytes%29.sha256%2CpolicySha256%2C%27the%20whole%20reviewed%20registration%20succession%20is%20pinned%27%29%3B%0A%20%20%20%20const%20packet%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20cachedPolicy%3DverifyProgramStringHostRegistrationHistory%28packet%29%3B%0A%20%20%7D%0A%20%20const%20pair%3DcachedPolicy.get%28path%29%3Bassert.equal%28source%2Cpair.current%29%3Breturn%20pair.previous%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
