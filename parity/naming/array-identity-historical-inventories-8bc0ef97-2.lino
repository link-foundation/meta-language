ipt%27%29.code%2C%20entry.source%2C%20entry.name%29%3B%0A%20%20%20%20%20%20for%20%28const%20observation%20of%20%5Bentry%2C%20...%28entry.additionalCalls%20%3F%3F%20%5B%5D%29%5D%29%20%7B%0A%20%20%20%20%20%20%20%20const%20name%20%3D%20observation%20%3D%3D%3D%20entry%20%3F%20entry.name%20%3A%20%60%24%7Bentry.name%7D-%24%7Bobservation.name%7D%60%3B%0A%20%20%20%20%20%20%20%20const%20expected%20%3D%20execFileSync%28process.execPath%2C%20%5B%27--input-type%3Dmodule%27%2C%20%27-e%27%2C%20%60%24%7Bentry.source%7D%5Cnconsole.log%28%24%7Bobservation.call%7D%29%3B%60%5D%2C%20%7B%20encoding%3A%20%27utf8%27%2C%20timeout%3A%2010_000%20%7D%29%3B%0A%20%20%20%20%20%20%20%20assert.equal%28expected%2C%20observation.expected%2C%20name%29%3B%0A%20%20%20%20%20%20%20%20if%20%28%21directory%29%20continue%3B%0A%20%20%20%20%20%20%20%20const%20source%20%3D%20path.join%28directory%2C%20%60%24%7Bname%7D.rs%60%29%3B%0A%20%20%20%20%20%20%20%20const%20binary%20%3D%20path.join%28directory%2C%20process.platform%20%3D%3D%3D%20%27win32%27%20%3F%20%60%24%7Bname%7D.exe%60%20%3A%20name%29%3B%0A%20%20%20%20%20%20%20%20writeFileSync%28source%2C%20%60%24%7Btranslated.code%7D%5Cnfn%20main%28%29%20%7B%20println%21%28%22%7B%7D%22%2C%20%24%7Bobservation.rustCall%7D%29%3B%20%7D%5Cn%60%29%3B%0A%20%20%20%20%20%20%20%20execFileSync%28%27rustc%27%2C%20%5B%27--edition%27%2C%20%272024%27%2C%20source%2C%20%27-o%27%2C%20binary%5D%2C%20%7B%20stdio%3A%20%27pipe%27%2C%20timeout%3A%2060_000%20%7D%29%3B%0A%20%20%20%20%20%20%20%20const%20actual%20%3D%20execFileSync%28binary%2C%20%5B%5D%2C%20%7B%20encoding%3A%20%27utf8%27%2C%20timeout%3A%2010_000%20%7D%29%3B%0A%20%20%20%20%20%20%20%20assert.equal%28actual%2C%20expected%2C%20name%29%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%20%20%7D%20finally%20%7B%20if%20%28directory%29%20rmSync%28directory%2C%20%7B%20recursive%3A%20true%2C%20force%3A%20true%20%7D%29%3B%20%7D%0A%7D%29%3B%0A%0Atest%28%27a%20carried%20sibling%20and%20its%20caller%20stay%20carried%20without%20poisoning%20an%