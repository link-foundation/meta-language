try.originalJavaScript%2CemitTypedProgramLinks%28LinkNetwork.fromLino%28entry.archive%29%2Centry.root%2C%27JavaScript%27%29.code%5D%29%7B%0A%20%20%20const%20run%3Dobserve%28code%29%3Bassert.deepEqual%28run.output%2Centry.output%2Centry.id%29%3B%0A%20%20%20assert.equal%28run.context.fail%28true%29%2Ctrue%29%3B%0A%20%20%20assert.throws%28%28%29%3D%3Erun.context.fail%28false%29%2Cerror%3D%3E%7Bassert.equal%28error.message%2Centry.message%2Centry.id%29%3Breturn%20true%3B%7D%29%3B%0A%20%20%7D%0A%20%20assert.equal%28emitTypedProgramLinks%28LinkNetwork.fromLino%28entry.archive%29%2Centry.root%2C%27Rust%27%29.code%2Centry.rust%29%3B%0A%20%20assert.deepEqual%28JSON.parse%28JSON.stringify%28parseRust%28entry.source%2C%7BcompletionModel%3Afixture.completionModel%7D%29%29%29%2Centry.surface%29%3B%0A%20%7D%0A%7D%29%3B%0Atest%28%27dynamic%20Display%2C%20other%20templates%20and%20legacy%20formatted%20panic%20keep%20their%20precise%20original%20refusals%27%2C%28%29%3D%3E%7B%0A%20assert.equal%28fixture.invalid.length%2C10%29%3B%0A%20for%28const%20entry%20of%20fixture.invalid%29refused%28entry%2Ctrue%29%3B%0A%20refused%28fixture.defaultCanonical%2Cfalse%29%3Brefused%28fixture.legacy%2Cfalse%29%3Brefused%28fixture.legacy%2Ctrue%29%3B%0A%20assert.equal%28fixture.legacy.id%2C%27frontend-rust%2Ffrontend-rust-panicArguments%27%29%3B%0A%20assert.equal%28fixture.legacy.reason%2C%27panic%21%20arguments%3A%20only%20a%20literal%20message%20is%20portable%27%29%3B%0A%20assert.deepEqual%28fixture.legacy.span%2C%7Bstart%3A24%2Cend%3A42%7D%29%3B%0A%7D%29%3B%0Atest%28%27shared%20literal%20panic%20admission%20and%20source-free%20edits%20require%20the%20exact%20selected%20semantics%27%2C%28%29%3D%3E%7B%0A%20const%20valid%3D%5Bfixture.completionModel%2C%27panic%27%2C%27str%27%2C%27%7B%7D%27%2C%27str%27%2C%272%27%5D%3B%0A%20assert.equal%28acceptRustCompletionPanicArguments%28...valid%29%2Ctrue%29%3B%0A%20for%28const%20%5Bindex%2Cvalue%5D%20of%20%5B%5B0%2C%27%27%5D%2C%5B0%2C%27unknown%27%5D%2C%5B1%2C%27u