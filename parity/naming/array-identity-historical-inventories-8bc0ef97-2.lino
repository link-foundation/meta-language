ity%2842%29%3B%5Cn%22%3B%0A%20%20const%20surface%20%3D%20parseJavaScript%28source%29%3B%0A%20%20assert.equal%28surface.main.effects%5B0%5D.constant%2C%20true%29%3B%0A%20%20const%20program%20%3D%20checkProgram%28surface%29%3B%0A%20%20assert.equal%28program.main.effects%5B0%5D.constant%2C%20true%29%3B%0A%20%20assert.equal%28program.declarations.get%28%27identity%27%29.params%5B0%5D.default%2C%20null%29%3B%0A%7D%29%3B%0A%0Aconst%20DEFAULTS%20%3D%20%60function%20label%28name%2C%20level%20%3D%20%27grammar-rule%27%2C%20depth%20%3D%202%29%20%7B%0A%20%20return%20%5C%60%5C%24%7Bname%7D%3A%5C%24%7Blevel%7D%3A%5C%24%7Bdepth%7D%5C%60%3B%0A%7D%0A%2F%2A%2A%0A%20%2A%20%40param%20%7Bstring%7D%20term%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20children%0A%20%2A%20%40returns%20%7Bnumber%7D%0A%20%2A%2F%0Afunction%20size%28term%2C%20children%20%3D%20%5B%5D%29%20%7B%0A%20%20return%20children.length%20%2B%20%28term%20%3D%3D%3D%20%27%27%20%3F%200%20%3A%201%29%3B%0A%7D%0Aconsole.log%28%27%25s%27%2C%20label%28%27a%27%29%2C%20label%28%27b%27%2C%20%27x%27%29%2C%20label%28%27c%27%2C%20%27y%27%2C%203%29%2C%20size%28%27ab%27%29%2C%20size%28%27%27%2C%20%5B1%2C%202%5D%29%29%3B%0A%60%3B%0A%0Aconst%20refusal%20%3D%20%28source%29%20%3D%3E%20translateProgram%28source%2C%20%27JavaScript%27%2C%20%27Rust%27%29.diagnostic%3F.message%3B%0A%0Atest%28%27a%20call%20that%20leaves%20out%20defaulted%20parameters%20passes%20the%20defaults%20in%20every%20target%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20for%20%28const%20target%20of%20%5B%27Rust%27%2C%20%27Lean%27%2C%20%27Rocq%27%5D%29%20%7B%0A%20%20%20%20const%20translated%20%3D%20translateProgram%28DEFAULTS%2C%20%27JavaScript%27%2C%20target%29%3B%0A%20%20%20%20assert.equal%28translated.diagnostic%2C%20null%2C%20target%29%3B%0A%20%20%20%20assert.equal%28translated.contract.support%2C%20%27semantic-translation%27%2C%20target%29%3B%0A%20%20%7D%0A%20%20const%20rust%20%3D%20translateProgram%28DEFAULTS%2C%20%27JavaScript%27%2C%20%27Rust%27%29.code%3B%0A%20%20assert.ok%28rust