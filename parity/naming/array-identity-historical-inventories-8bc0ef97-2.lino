27ABC%27%3B%7D%0A%2F%2A%2A%20%40returns%20%7Bnumber%7D%20%2A%2Ffunction%20position%28%29%7Bconsole.log%28%27position%27%29%3Breturn%201.9%3B%7D%0Aconsole.log%28receiver%28%29.charAt%28position%28%29%29%29%3Bconsole.log%28receiver%28%29.charAt%28%29%29%3B%0Aconsole.log%28%27ABC%27.charAt%28undefined%29%2C%27ABC%27.charAt%28null%29%2C%27ABC%27.charAt%28NaN%29%29%3B%60%3B%0A%20%20const%20represented%3Dordered.replace%28%22console.log%28%27ABC%27.charAt%28undefined%29%2C%22%2C%20%22console.log%28%27%25s%20%25s%20%25s%27%2C%27ABC%27.charAt%28undefined%29%2C%22%29%3B%0A%20%20for%28const%20text%20of%20%5Bordered%2Crepresented%2CemitJavaScript%28checkProgram%28parseJavaScript%28represented%29%29%29.text%5D%29%7B%0A%20%20%20%20const%20lines%3D%5B%5D%3BrunInNewContext%28text%2C%7Bconsole%3A%7Blog%3A%28...values%29%3D%3Elines.push%28format%28...values%29%29%7D%7D%29%3B%0A%20%20%20%20assert.deepEqual%28lines%2C%5B%27receiver%27%2C%27position%27%2C%27B%27%2C%27receiver%27%2C%27A%27%2C%27A%20A%20A%27%5D%29%3B%0A%20%20%7D%0A%20%20const%20collision%3D%60%2F%2A%2A%20%40param%20%7Bstring%7D%20text%20%40param%20%7Bnumber%7D%20position%20%40param%20%7Bnumber%7D%20Math%20%40param%20%7Bnumber%7D%20Number%20%40returns%20%7Bstring%7D%20%2A%2F%0Afunction%20collision%28text%2Cposition%2CMath%2CNumber%29%7Bconst%20readStringCharacter%3D999%3Breturn%20text.charAt%28position%29%3B%7D%60%3B%0A%20%20const%20compiled%3DrunInNewContext%28emitJavaScript%28checkProgram%28parseJavaScript%28collision%29%29%29.text%2B%27%3Bcollision%3B%27%29%3B%0A%20%20assert.equal%28compiled%28%27ABC%27%2C1%2C8%2C9%29%2C%27B%27%29%3B%0A%20%20for%28const%20position%20of%20%5B%27true%27%2C%27false%27%2C%22%271%27%22%2C%27%7B%7D%27%2C%27%5B1%5D%27%5D%29assert.throws%28%28%29%3D%3EcheckProgram%28parseJavaScript%28%22console.log%28%27ABC%27.charAt%28%22%2Bposition%2B%27%29%29%3B%27%29%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EcheckProgram%28parseJavaScript%28%22console.log%28%27ABC%27.charAt%280%2C1%29%29%3B%22%29%29%2C%2Fexpects%200%20to%201%20arguments%2Fu%29%3B%0A%7D%29%3B%0A%0Atest%28%27character%20selection%20rechecks%20after%20complete%20text%20and%20binary%20Links%20reload%20without%20a%20special%20graph%20operation%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DcreateTypedProgramLinks%28source%2C%27JavaScript%27%29%3B%0A%20%20const%20native%3DemitRust%28checkProgram%28parseJavaScript%28source%29%29%29.text%3B%0A%20%20for%28const%20network%20of%20%5BLinkNetwork.fromLino%28packet.network.toLino%28%29%29%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28packet.network%29%29%5D%29%7B%0A%20%20%20%20const%20restored%3DdecodeTypedProgramLinks%28network%2Cpacket.root%29%3BrecheckLinkedTypedProgram%28restored%2C%7BwholeProgram%3Atrue%7D%29%3B%0A%20%20%20%20assert.equal%28JSON.stringify%28restored.items%29.includes%28%27%22op%22%3A%22charAt%22%27%29%2Cfalse%29%3B%0A%20%20%20%20const%20javascript%3DemitTypedProgramLinks%28network%2Cpacket.root%2C%27JavaScript%27%29.code%3B%0A%20%20%20%20assert.equal%28emitTypedProgramLinks%28network%2Cpacket.root%2C%27Rust%27%29.code%2Cnative%29%3B%0A%20%20%20%20const%20character%3DrunInNewContext%28javascript%2B%27%3Bcharacter%3B%27%29%3B%0A%20%20%20%20for%28const%20text%20of%20texts%29for%28const%20position%20of%20positions%29assert.equal%28character%28text%2Cposition%29%2Ctext.charAt%28position%29%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27the%20packaged%20character%20extension%20preserves%20all%20preceding%20code%20unit%20policy%20bytes%20and%20complete%20source%20round%20trips%27%2C%28%29%3D%3E%7B%0A%20%20const%20policy%3DreadStringCodeUnitTemplateGeneration%28%29%3B%0A%20%20assert.equal%28policy.character.source%2CreadFileSync%28new%20URL%28%27..%2Fsrc%2Ftranslation%2Fstring-character-rules.js%27%2Cimport.meta.url%29%2C%27utf8%27%29%29%3B%0A%20%20assert.equal%28policy.character.originalDeclaration.name%2C%27readStringCharacter%27%29%3B%0A%20%20const%20history%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fnaming%2Fstring-character-source-history.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20const%20old%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3D%27js%2Fsrc%2Ftranslation%2Fdata%2Fstring-code-unit-template.lino%27%29%3B%0A%20%20const%20restored%3DstructuredClone%28policy%29%3Bdelete%20restored.character%3B%0A%20%20assert.deepEqual%28restored%2CreadStructuredDataLino%28old.sourceText%29%29%3B%0A%20%20assert.equal%28serializeProjectData%28restored%2Cold.file%29%2Cold.sourceText%29%3B%0A%20%20for%28const%20file%20of%20%5B%27js%2Fsrc%2Ftranslation%2Fdata%2Fstring-code-unit-template.lino%27%2C%27rust%2Fsrc%2Fdata%2Fstring-code-unit-template.lino%27%5D%29assert.deepEqual%28readProjectData%28new%20URL%28%27..%2F..%2F%27%2Bfile%2Cimport.meta.url%29%29%2Cpolicy%29%3B%0A%20%20const%20translated%3DselfTranslate%28source%2C%27JavaScript%27%2C%27Rust%27%29%3B%0A%20%20assert.equal%28translated.items.filter%28row%3D%3Erow.status%3D%3D%3D%27carried%27%29.length%2C0%29%3B%0A%20%20assert.equal%28selfTranslate%28translated.code%2C%27Rust%27%2C%27JavaScript%27%29.code%2Csource%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
