0assert.equal%28ownStatus%28%7B...node%2Cpinned%3A%2724%27%2Ccompare%3A%27major%27%2Ccurrent%3A%2724.23.0%27%7D%29%2C%27current%27%29%3B%0A%20%20assert.equal%28ownStatus%28%7B...node%2Cpinned%3A%2724.22%27%2Ccompare%3A%27minor%27%2Ccurrent%3A%2724.22.1%27%7D%29%2C%27current%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27one-source%20Node%20reconciliation%20retains%20every%20unrelated%20audit%20fact%20and%20exact%20original%20collector%20bytes%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fnaming%2Fci-node-dependency-source-history.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20for%28const%20source%20of%20history.sources%29%7B%0A%20%20%20%20assert.equal%28Buffer.byteLength%28source.sourceText%29%2Csource.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28source.sourceText%29.digest%28%27hex%27%29%2Csource.sha256%29%3B%0A%20%20%7D%0A%20%20const%20collector%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3D%27js%2Fscripts%2Fdependency-inventory.mjs%27%29%3B%0A%20%20const%20actual%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bcollector.file%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20assert.equal%28actual%2Ccollector.sourceText.replace%28history.before%2Chistory.after%29%2Bhistory.insertion%29%3B%0A%20%20assert.equal%28actual.replace%28history.insertion%2C%27%27%29.replace%28history.after%2Chistory.before%29%2Ccollector.sourceText%29%3B%0A%20%20const%20original%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3D%27parity%2Fdependency-inventory.lino%27%29%3B%0A%20%20const%20before%3DreadStructuredDataLino%28original.sourceText%29%3B%0A%20%20const%20current%3DreadNodeDependencyInventoryOriginalView%28%29%3B%0A%20%20const%20generator%3DreadNodeDependencyGeneratorRegistrationHistory%28%29.generator%3B%0A%20%20assert.deepEqual%28current.items.filter%28row%3D%3Erow.id%3D%3D%3Dgenerator.id%29%2C%5Bgenerator%5D%29%3B%0A%20%20current.items%3Dcurrent.items.filter%28row%3D%3Erow.id%21%3D%3Dgenerator.id%29%3B%0A%20%20assert.equal%28current.items.length%2Cbefore.items.length%29%3Bassert.equal%28current.items.length%2C744%29%3B%0A%20%20assert.equal%28current.auditDate%2Cbefore.auditDate%29%3B%0A%20%20const%20node%3Dcurrent.items.find%28row%3D%3Erow.id%3D%3D%3Dhistory.updatedNodeId%29%3Bassert.ok%28node%29%3B%0A%20%20assert.equal%28node.compare%2C%27version%27%29%3Bassert.equal%28node.current%2Chistory.runtime.nodeVersion%29%3B%0A%20%20assert.equal%28node.auditDate%2Chistory.observationDate%29%3Bassert.ok%28node.evidence.includes%28%27observed%20%27%2Bhistory.observationDate%29%29%3B%0A%20%20const%20restored%3DstructuredClone%28current%29%3B%0A%20%20restored.items%3Drestored.items.map%28row%3D%3E%7B%0A%20%20%20%20if%28row.id%3D%3D%3Dhistory.updatedNodeId%29return%20before.items.find%28old%3D%3Eold.id%3D%3D%3Dhistory.originalNodeId%29%3B%0A%20%20%20%20if%28row.dependsOn%29row.dependsOn%3Drow.dependsOn.map%28id%3D%3Eid%3D%3D%3Dhistory.updatedNodeId%3Fhistory.originalNodeId%3Aid%29%3B%0A%20%20%20%20for%28const%20holder%20of%20row.heldBy%3F%3F%5B%5D%29for%28const%20field%20of%20%5B%27id%27%2C%27requiredBy%27%5D%29if%28holder%5Bfield%5D%3D%3D%3Dhistory.updatedNodeId%29holder%5Bfield%5D%3Dhistory.originalNodeId%3B%0A%20%20%20%20return%20row%3B%0A%20%20%7D%29%3B%0A%20%20assert.deepEqual%28restored%2Cbefore%29%3B%0A%20%20assert.equal%28serializeProjectData%28restored%2Coriginal.file%29%2Coriginal.sourceText%29%3B%0A%7D%29%3B%0A%0Aimport%20%7BpartitionTests%2CtestFiles%7D%20from%20%27..%2Fscripts%2Ftest-groups.mjs%27%3B%0A%0Atest%28%27original%20Node%20dependency%20test%20discovery%20preserves%20all%20draft%20source%20and%20the%20unchanged%20prior%20classifier%27%2C%28%29%3D%3E%7B%0A%20%20const%20location%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fnaming%2Fnode-dependency-test-location-source-history.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20const%20original%3Dlocation.sources%5B0%5D%3B%0A%20%20assert.equal%28original.commit%2Cnull%2C%27the%20retained%20draft%20is%20not%20misrepresented%20as%20a%20committed%20source%27%29%3B%0A%20%20assert.equal%28original.worktreeBaseRevision%2Clocation.revision%29%3B%0A%20%20assert.equal%28Buffer.byteLength%28original.sourceText%29%2Coriginal.bytes%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28original.sourceText%29.digest%28%27hex%27%29%2Coriginal.sha256%29%3B%0A%20%20assert.equal%28restoreNodeDependencyGeneratorTestHistory%28readFileSync%28new%20URL%28import.meta.url%29%2C%27utf8%27%29%29%2Coriginal.sourceText%2Blocation.additions%29%3B%0A%20%20const%20classifier%3DrestoreOwnCodebaseTestRegistrationClassifier%28readFileSync%28new%20URL%28%27..%2F..%2F%27%2Blocation.classifier.file%2Cimport.meta.url%29%29%29%3B%0A%20%20assert.equal%28classifier.length%2Clocation.classifier.bytes%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28classifier%29.digest%28%27hex%27%29%2Clocation.classifier.sha256%29%3B%0A%20%20const%20files%3DtestFiles%28%29%2Cpartition%3DpartitionTests%28files%29%3B%0A%20%20assert.deepEqual%28partition.unassigned%2C%5B%5D%29%3Bassert.deepEqual%28partition.ambiguous%2C%5B%5D%29%3B%0A%20%20assert.ok%28files.includes%28%27issue-195-evidence-node-dependency.test.js%27%29%29%3B%0A%20%20assert.deepEqual%28partitionTests%28%5B%27issue-195-evidence-node-dependency.test.js%27%5D%29.groups.tooling%2C%5B%27issue-195-evidence-node-dependency.test.js%27%5D%29%3B%0A%20%20const%20registrationHistory%3DreadOwnCodebaseTestRegistrationHistory%28%29%3B%0A%20%20assert.equal%28registrationHistory.revision%2C%2752132727d7ce158762a4499b7032a42a9f16f3c3%27%29%3B%0A%20%20for%28const%20row%20of%20registrationHistory.sources%29%7B%0A%20%20%20%20const%20current%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Brow.file%2Cimport.meta.url%29%29%3B%0A%20%20%20%20assert.equal%28current.length%2Crow.current.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28current%29.digest%28%27hex%27%29%2Crow.current.sha256%29%3B%0A%20%20%7D%0A%20%20for%28const%20row%20of%20registrationHistory.registrations%29%7B%0A%20%20%20%20assert.ok%28files.includes%28row.file%29%29%3B%0A%20%20%20%20const%20current%3DpartitionTests%28%5Brow.file%5D%29%3B%0A%20%20%20%20assert.deepEqual%28current.unassigned%2C%5B%5D%29%3Bassert.deepEqual%28current.ambiguous%2C%5B%5D%29%3B%0A%20%20%20%20assert.deepEqual%28current.groups%5Brow.group%5D%2C%5Brow.file%5D%29%3B%0A%20%20%7D%0A%20%20assert.throws%28%28%29%3D%3ErestoreOwnCodebaseTestRegistrationClassifier%28Buffer.from%28%27unknown%20complete%20classifier%27%29%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErestoreNodeDependencyGeneratorTestHistory%28readFileSync%28new%20URL%28import.meta.url%29%2C%27utf8%27%29%2B%27%5Cn%27%29%29%3B%0A%7D%29%3B%0A%0Aimport%20%7BreadNodeDependencyGeneratorRegistrationHistory%2CrestoreNodeDependencyGeneratorTestHistory%7D%20from%20%27..%2Fscripts%2Fnode-dependency-registration-history.mjs%27%3B%0Aimport%20%7BcheckInventory%7D%20from%20%27..%2Fscripts%2Fdependency-inventory.mjs%27%3B%0Aimport%20%7BreadNodeDependencyInventoryOriginalView%7D%20from%20%27..%2Fscripts%2Fdependency-inventory-append-history.mjs%27%3B%0Aimport%20%7BreadOwnCodebaseTestRegistrationHistory%2CrestoreOwnCodebaseTestRegistrationClassifier%7D%20from%20%27..%2Fscripts%2Fown-codebase-test-registration-history.mjs%27%3B%0A%0Atest%28%27the%20new%20source%20placement%20generator%20is%20independently%20inventoried%20with%20every%20preceding%20entry%20intact%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DreadNodeDependencyGeneratorRegistrationHistory%28%29%3B%0A%20%20const%20inventory%3DreadNodeDependencyInventoryOriginalView%28%29%3B%0A%20%20assert.equal%28inventory.items.length%2Chistory.currentItemCount%29%3B%0A%20%20assert.equal%28inventory.items.length%2C745%29%3B%0A%20%20assert.equal%28inventory.auditDate%2Chistory.fullAuditDate%29%3B%0A%20%20assert.deepEqual%28inventory.items.filter%28row%3D%3Erow.id%3D%3D%3Dhistory.generator.id%29%2C%5Bhistory.generator%5D%29%3B%0A%20%20assert.deepEqual%28checkInvento