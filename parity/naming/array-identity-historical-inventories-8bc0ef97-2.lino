9%27%29%3B%0A%20%20assert.ok%28wordnet.lemmas.noun.size%20%3E%20100_000%29%3B%0A%20%20assert.deepEqual%28partsOfSpeech%28wordnet%2C%20%27repetitions%27%29%2C%20%5B%27noun%27%5D%29%3B%0A%20%20assert.deepEqual%28partsOfSpeech%28wordnet%2C%20%27frobnicator%27%29%2C%20%5B%5D%29%3B%0A%20%20assert.ok%28areSynonyms%28wordnet%2C%20%27argument%27%2C%20%27parameter%27%2C%20%27noun%27%29%29%3B%0A%20%20assert.equal%28areSynonyms%28wordnet%2C%20%27loop%27%2C%20%27branch%27%2C%20%27noun%27%29%2C%20false%29%3B%0A%20%20%2F%2F%20Every%20technical%20term%20is%20outside%20WordNet%20in%20the%20part%20of%20speech%20it%20registers%0A%20%20%2F%2F%20and%20cites%20the%20reference%20that%20defines%20it.%0A%20%20for%20%28const%20%5Bword%2C%20term%5D%20of%20registers.vocabulary.technicalTerms%29%20%7B%0A%20%20%20%20assert.ok%28term.partsOfSpeech.some%28%28part%29%20%3D%3E%20%21partsOfSpeech%28wordnet%2C%20word%29.includes%28part%29%29%2C%20word%29%3B%0A%20%20%20%20assert.match%28term.source%2C%20%2F%5CS%2Fu%2C%20word%29%3B%0A%20%20%20%20assert.match%28term.definition%2C%20%2F%5E%5Cp%7BLu%7D.%2A%5C.%24%2Fu%2C%20word%29%3B%0A%20%20%7D%0A%20%20%2F%2F%20Letters-only%20words%20outside%20the%20vocabulary%20are%20rejected.%0A%20%20assert.deepEqual%28kindsOf%28nameProblems%28%27xyzzy_rule%27%2C%20context%29%29%2C%20%5B%27vocabulary%27%5D%29%3B%0A%20%20assert.deepEqual%28kindsOf%28mutated%28%7B%20names%3A%20%5B...repository.names%2C%20%7B%20inventory%3A%20%27inferred%20rule%20names%27%2C%20file%3A%20%27rust%2Fsrc%2Fgrammar%2Finference%2Fadvisor.rs%27%2C%20name%3A%20%27frobnicated_value%27%2C%20record%3A%20null%20%7D%5D%20%7D%29%29%2C%20%5B%27vocabulary%27%5D%29%3B%0A%20%20observe%28%5B%27vocabularyChecked%27%5D%2C%20%27the%20vocabulary%20is%20WordNet%203.1%20plus%20registered%20technical%20terms%2C%20not%20a%20letter%20pattern%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20positive%20and%20negative%20naming%20fixtures%20are%20judged%20as%20they%20expect%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20assert.deepEqual%28checkNamingFixtures%28fixtures%2C%20context%29%2C%20%5B%5D%29%3B%0A%20%20const%20expected%20%3D%20new%20Set%28fixtures.flatMap%28%28fixture%29%20%3D%3E%20fixture.expected%29%29%3B%0A%20%20for%20%28const%20kind%20of%20%5B%27record%27%2C%20%27vocabulary%27%2C%20%27abbreviation%27%2C%20%27phrase-role%27%2C%20%27ambiguous%27%2C%20%27duplicate%27%5D%29%20assert.ok%28expected.has%28kind%29%2C%20kind%29%3B%0A%20%20assert.ok%28fixtures.some%28%28fixture%29%20%3D%3E%20fixture.expected.length%20%3D%3D%3D%200%29%29%3B%0A%20%20%2F%2F%20A%20fixture%20judged%20differently%20than%20it%20expects%20is%20itself%20a%20problem.%0A%20%20const%20%5Baccepted%5D%20%3D%20fixtures.filter%28%28fixture%29%20%3D%3E%20fixture.expected.length%20%3D%3D%3D%200%29%3B%0A%20%20assert.equal%28checkNamingFixtures%28%5B%7B%20...accepted%2C%20expected%3A%20%5B%27abbreviation%27%5D%20%7D%5D%2C%20context%29%5B0%5D.kind%2C%20%27fixture%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27concepts%20must%20be%20noun%20phrases%20and%20operations%20verb%20phrases%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20for%20%28const%20concept%20of%20repository.records.filter%28%28%7B%20role%20%7D%29%20%3D%3E%20role%20%3D%3D%3D%20%27concept%27%29%29%20assert.ok%28concept.phrase.length%20%3E%200%2C%20concept.id%29%3B%0A%20%20assert.ok%28repository.records.some%28%28%7B%20role%20%7D%29%20%3D%3E%20role%20%3D%3D%3D%20%27operation%27%29%29%3B%0A%20%20const%20problems%20%3D%20mutated%28%7B%0A%20%20%20%20records%3A%20%5B%0A%20%20%20%20%20%20...repository.records%2C%0A%20%20%20%20%20%20%7B%20...record%28%27loop%27%29%2C%20id%3A%20%27grammar.parse-quickly%27%2C%20phrase%3A%20%27parse%20quickly%27%2C%20definition%3A%20%27Parsing%20done%20fast.%27%20%7D%2C%0A%20%20%20%20%20%20%7B%20...record%28%27operation.parse%27%29%2C%20id%3A%20%27operation.parser%27%2C%20phrase%3A%20%27parser%27%2C%20definition%3A%20%27A%20program%20that%20parses%20text.%27%20%7D%2C%0A%20%20%20%20%5D%2C%0A%20%20%7D%29.filter%28%28problem%29%20%3D%3E%20problem.kind%20%3D%3D%3D%20%27ph