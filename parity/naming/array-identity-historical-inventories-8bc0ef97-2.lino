29%29%2C%20entry.surface%2C%20entry.id%29%3B%0A%20%20%20%20assert.deepEqual%28observed%28entry.javascript%2C%20entry.name%2C%20entry.inputs%29%2C%20entry.expected%2C%20entry.id%29%3B%0A%20%20%20%20assert.deepEqual%28observed%28entry.replayJavaScript%2C%20entry.name%2C%20entry.inputs%29%2C%20entry.expected%2C%20entry.id%29%3B%0A%20%20%20%20const%20archive%20%3D%20createTypedProgramLinks%28entry.source%2C%20%27Rust%27%29%3B%0A%20%20%20%20const%20network%20%3D%20LinkNetwork.fromLino%28archive.network.toLino%28%29%29%3B%0A%20%20%20%20assert.deepEqual%28observed%28emitTypedProgramLinks%28network%2C%20archive.root%2C%20%27JavaScript%27%29.code%2C%20entry.name%2C%20entry.inputs%29%2C%20entry.expected%2C%20entry.id%29%3B%0A%20%20%20%20const%20emitted%20%3D%20emitTypedProgramLinks%28network%2C%20archive.root%2C%20%27Rust%27%29.code%3B%0A%20%20%20%20assert.ok%28emitted.includes%28entry.rustDefinitions%29%2C%20entry.id%29%3B%0A%20%20%20%20const%20checkedReplay%20%3D%20checkProgram%28parseRust%28entry.rustDefinitions%20%2B%20%27%5Cnfn%20main%28%29%7B%7D%27%29%29%3B%0A%20%20%20%20assert.equal%28emitRust%28checkedReplay%29.definitions.join%28%27%5Cn%5Cn%27%29%2C%20entry.rustDefinitions%2C%20entry.id%29%3B%0A%20%20%20%20assert.deepEqual%28observed%28emitJavaScript%28checkedReplay%29.text%2C%20entry.name%2C%20entry.inputs%29%2C%20entry.expected%2C%20entry.id%29%3B%0A%20%20%7D%0A%7D%29%3B%0Atest%28%27array%20source%20ownership%2C%20unsupported%20borrowing%20and%20generic%20boundaries%20retain%20precise%20refusals%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20for%20%28const%20entry%20of%20fixture.invalid%29%20assert.throws%28%28%29%20%3D%3E%20checkProgram%28parseRust%28entry.source%29%29%2C%20error%20%3D%3E%20%7B%0A%20%20%20%20assert.equal%28error.kind%2C%20entry.kind%2C%20entry.id%29%3B%0A%20%20%20%20assert.equal%28error.reason%2C%20entry.reason%2C%20entry.id%29%3B%0A%20%20%20%20assert.deepEqual%28error.span%20%3F%3F%20null%2C%20entry.span%2C%20entry.id%29%3B%0A%20%20%20%20return%20true%3B%