5B%27format%27%2C%27Rust%27%5D%5D%2Cactions%3Acorrection.actions%7D%5D%29%3B%0A%20assert.equal%28DecoratorSet.fromLino%28styles.toLino%28%29%29.decorate%28%27emitter%27%2C%7Bformat%3A%27Rust%27%2Csource%3Aoriginal%7D%29.source%2Ccorrection.source%29%3B%0A%20const%20shipped%3DreadFileSync%28new%20URL%28%27..%2F..%2Frust%2Fsrc%2Ftranslation%2Flink_network_binary_buffer_rules%2Fpart_2.rs%27%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20assert.equal%28formatProductRuleSource%28correction.source%29.trim%28%29%2CreadSourceTextRustBlock%28shipped%2C%27fn%27%2Creview.function.name%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27binary%20buffer%20compiler%20corrections%20refuse%20altered%20diagnostics%20captures%20aliases%20and%20source%20contexts%27%2C%28%29%3D%3E%7B%0A%20for%28const%20mutate%20of%20%5B%0A%20%20value%3D%3E%7Bvalue.capture.job%2B%3D1%3B%7D%2C%0A%20%20value%3D%3E%7Bvalue.capture.logSha256%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20value%3D%3E%7Bvalue.diagnostics.pop%28%29%3B%7D%2C%0A%20%20value%3D%3E%7Bvalue.diagnostics%5B0%5D.line%2B%3D1%3B%7D%2C%0A%20%20value%3D%3E%7Bvalue.function.renames%5B0%5D.to%3D%27input%27%3B%7D%2C%0A%20%20value%3D%3E%7Bvalue.function.renames%5B0%5D.from%3D%27false%27%3B%7D%2C%0A%20%20value%3D%3E%7Bvalue.function.source%2B%3D%27%5Cn%27%3B%7D%2C%0A%20%5D%29%7Bconst%20value%3DstructuredClone%28review%29%3Bmutate%28value%29%3Bassert.throws%28%28%29%3D%3EreadBinaryBufferCompilerStyles%28review.function.source%2Cvalue%29%29%3B%7D%0A%20assert.throws%28%28%29%3D%3EreadBinaryBufferCompilerStyles%28review.function.source.replace%28%27pub%20fn%27%2C%27pub%20const%20fn%27%29%29%29%3B%0A%20assert.throws%28%28%29%3D%3EreadBinaryBufferCompilerStyles%28review.function.source%2B%27%5Cn%27%2Breview.function.source%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27guard%20planner%20String%20styles%20use%20actual%20recorded%20source%20and%20preserve%20opaque%20macros%20comments%20and%20unknown%20types%27%2C%28%29%3D%3E%7B%0A%20const%20listed%3DDecoratorSet.fromLino%28readFileSync%28new%20URL%28%27..%2F..%2Fparity%2Fself-translation%2Fguarded-private-array-write-rules-decorators.lino%27%2Cimport.meta.url%29%2C%27utf8%27%29%29%3B%0A%20const%20controls%3Dlisted.decorators.flatMap%28row%3D%3Erow.actions%29.filter%28row%3D%3Erow.from%3F.startsWith%28%27pub%20fn%20read_guarded_write_text%28%27%29%26%26row.from.includes%28%27%7C%7C%20String%3A%3Anew%28%29%27%29%26%26%21row.to.includes%28%27%7C%7C%20String%3A%3Anew%28%29%27%29%29%3B%0A%20assert.equal%28controls.length%2C1%2C%27the%20complete%20actual%20getter%20is%20the%20constructor%20correction%20witness%27%29%3B%0A%20const%20result%3DreadGuardedPrivateArrayWriteLibraryStyles%28controls%5B0%5D.from%29%3B%0A%20assert.ok%28result.source.includes%28%27.unwrap_or_default%28%29%27%29%29%3B%0A%20assert.ok%28%21result.source.includes%28%27%7C%7C%20String%3A%3Anew%28%29%27%29%29%3B%0A%20assert.equal%28readGuardedPrivateArrayWriteLibraryStyles%28result.source%29.source%2Cresult.source%29%3B%0A%20for%28const%20part%20of%20%5B1%2C2%2C3%2C4%5D%29%7B%0A%20%20const%20shipped%3DreadFileSync%28new%20URL%28%27..%2F..%2Frust%2Fsrc%2Ftranslation%2Fguarded_private_array_write_rules%2Fpart_%27%2Bpart%2B%27.rs%27%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20assert.equal%28readGuardedPrivateArrayWriteLibraryStyles%28shipped%29.source%2Cshipped%2C%27each%20complete%20corrected%20module%20retains%20its%20original%20lint%20annotations%27%29%3B%0A%20%7D%0A%20const%20opaque%3D%27pub%20fn%20preserved%28value%3A%20Option%3CString%3E%29%20-%3E%20String%20%7B%20opaque%21%28value.unwrap_or_else%28%7C%7C%20String%3A%3Anew%28%29%29%29%20%7D%27%3B%0A%20assert.ok%28readGuardedPrivateArrayWriteLibraryStyles%28opaque%29.source.includes%28%27opaque%21%28value.unwrap_or_else%28%7C%7C%20String%3A%3Anew%28%29%29%29%27%29%29%3B%0A%20const%20commented%3D%27pub%20fn%20preserved%28value%3A%20Option%3CString%3E%29%20-%3E%20String%20%7B%20value.unwrap_or_else%28%7C%7C%20%2F%2A%20retain%20%2A%2F%20String%3A%3Anew%28%29%29%20%7D%27%3B%0A%20ass