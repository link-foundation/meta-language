ectData%28new%20URL%28policy.edge.current.file%2Croot%29%29%3B%0A%20%20assert.equal%28policy.edge.changes.length%2C13%29%3B%0A%20%20const%20previous%3DprojectHistoricalTranslationSourceDescriptorArtifact%28artifact%29%3B%0A%20%20const%20expected%3DexecFileSync%28%27git%27%2C%5B%27show%27%2Cpolicy.edge.previous.revision%2B%27%3A%27%2Bpolicy.edge.previous.file%5D%2C%7Bcwd%3Aroot%2CmaxBuffer%3A4%2A1024%2A1024%7D%29%3B%0A%20%20assert.equal%28serializeProjectData%28previous%2Cpolicy.edge.previous.file%29%2Cexpected.toString%28%27utf8%27%29%29%3B%0A%20%20for%28const%20field%20of%20%5B%27completeRust%27%2C%27owners%27%2C%27declarationNames%27%2C%27totals%27%2C%27assumptions%27%2C%27encodings%27%2C%27mappings%27%2C%27preludeHashes%27%2C%27replays%27%2C%27archive%27%5D%29%7B%0A%20%20%20%20assert.ok%28isDeepStrictEqual%28artifact%5Bfield%5D%2Cprevious%5Bfield%5D%29%2C%27complete%20original%20artifact%20field%20retained%3A%20%27%2Bfield%29%3B%0A%20%20%7D%0A%20%20assert.equal%28artifact.definitionCount%2C106%29%3B%0A%20%20for%28const%20row%20of%20artifact.decisionSources%29%7B%0A%20%20%20%20%2F%2F%20The%20immutable%20artifact%20names%20its%20own%20source%20epoch.%20The%20scoped%20adapter%0A%20%20%20%20%2F%2F%20authenticates%20complete%20physical%20successors%20before%20exposing%20that%20epoch.%0A%20%20%20%20const%20physical%3DreadFileSync%28new%20URL%28row.file%2Croot%29%29%2Cbytes%3DrestoreRawConsumingSnapshotSource%28physical%2Crow.file%29%3Bassert.equal%28bytes.length%2Crow.bytes%29%3Bassert.equal%28hash%28bytes%29%2Crow.sha256%29%3B%0A%20%20%7D%0A%20%20const%20register%3DreadHistoricalTranslationSourceDescriptorRegister%28%29%3B%0A%20%20const%20registerFile%3D%27parity%2Fself-translation%2Fcomplete-declaration-receipts.lino%27%3B%0A%20%20assert.equal%28serializeProjectData%28register%2CregisterFile%29%2CexecFileSync%28%27git%27%2C%5B%27show%27%2Cpolicy.edge.previous.revision%2B%27%3A%27%2BregisterFile%5D%2C%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2CmaxBuffer%3A2%2A1024%2A1024%7D%29%29%3B%0A%20%20for%28const%20mutate%20of%20%5Bvalue%3D%3E%7Bvalue.completeRust%2B%3D%27%5Cn%27%3B%7D%2Cvalue%3D%3E%7Bvalue.owners.reverse%28%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.decisionSources%5B2%5D.sha256%3D%270%27.repeat%2864%29%3B%7D%2Cvalue%3D%3E%7Bdelete%20value.predecessor.proof.producerApplicability.sourceHistory%3B%7D%5D%29%7B%0A%20%20%20%20const%20changed%3DstructuredClone%28artifact%29%3Bmutate%28changed%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EprojectHistoricalTranslationSourceDescriptorArtifact%28changed%29%2C%2Fcomplete%20registered%20artifact%2Fu%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27causal%20source%20applicability%20retains%20actual%20current%20inference%20bytes%20and%20its%20complete%20checked%20predecessor%27%2C%28%29%3D%3E%7B%0A%20%20const%20sources%3DreadOriginalLinkRawEmissionProducerSources%28%29%3B%0A%20%20const%20proof%3DverifyOriginalLinkRawEmissionProducerApplicability%28sources%29%3B%0A%20%20const%20stored%3DreadProjectData%28new%20URL%28policy.edge.current.file%2Croot%29%29.predecessor.proof.producerApplicability%3B%0A%20%20assert.ok%28isDeepStrictEqual%28proof%2Cstored%29%2C%27the%20recorded%20complete%20provenance%20equals%20actual%20source%20verification%27%29%3B%0A%20%20assert.equal%28proof.sources.length%2C14%29%3Bassert.equal%28proof.sourceHistory.revision%2C%2781107a5945651f17c962e4bb81fb560f96c65ccd%27%29%3B%0A%20%20assert.equal%28proof.sourceHistory.current.bytes%2Csources%5Bproof.sourceHistory.current.file%5D.length%29%3B%0A%20%20assert.equal%28proof.sourceHistory.current.sha256%2Chash%28sources%5Bproof.sourceHistory.current.file%5D%29%29%3B%0A%20%20assert.equal%28proof.sourceHistory.current%2Cproof.sources.find%28row%3D%3Erow.file%3D%3D%3Dproof.sourceHistory.current.file%29%29%3B%0A%20%20const%20changed%3D%7B...sources%2C%5Bproof.sourceHistory.current.file%5D%3ABuffer.concat%28%5Bsources%5Bproof.sourceHistory.current.file%5D%2CBuffer.from%28%27%5Cn%27%29%5D%29%7D%3B%0A%20%20assert.throws%28%28%29%3D%3EverifyOriginalLinkRawEmissionProducerApplicability%28changed%29%2Cassert.AssertionError%29%3B%0A%7D%29%3B%0A%0A%0Atest%28%27snapshot%20source%20freshness%20preserves%20actual%20current%20inputs%20and%20rejects%20unknown%20source%20authority%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DgenerateRawConsumingSnapshotSourceProfile%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20assert.deepEqual%28packet%2CreadRawConsumingSnapshotSourceProfile%28%29%29%3B%0A%20%20assert.equal%28packet.sources.length%2C5%29%3B%0A%20%20for%28const%5Bindex%2Crow%5Dof%20packet.sources.entries%28%29%29%7B%0A%20%20%20%20const%20physical%3DreadFileSync%28new%20URL%28row.file%2Croot%29%29%3B%0A%20%20%20%20assert.equal%28physical.toString%28%27utf8%27%29%2Crow.source%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Aphysical.length%2Csha256%3Ahash%28physical%29%7D%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20const%20original%3DrestoreRawConsumingSnapshotSource%28physical%2Crow.file%29%2Cexpected%3DRAW_CONSUMING_SNAPSHOT_FILES%5Bindex%5D%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Aoriginal.length%2Csha256%3Ahash%28original%29%7D%2C%7Bbytes%3Aexpected.bytes%2Csha256%3Aexpected.sha256%7D%29%3B%0A%20%20%20%20if%28row.file%21%3D%3D%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%29assert.notEqual%28hash%28physical%29%2Chash%28original%29%2C%27actual%20successor%20identity%20is%20retained%20separately%3A%20%27%2Brow.file%29%3B%0A%20%20%20%20const%20unknown%3DBuffer.concat%28%5Bphysical%2CBuffer.from%28%27%20%27%29%5D%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreRawConsumingSnapshotSource%28unknown%2Crow.file%29%2Cassert.AssertionError%29%3B%0A%20%20%20%20assert.equal%28restoreRawConsumingSnapshotSource%28unknown%2Crow.file%2Ctrue%29%2Cunknown%2C%27unknown%20historical%20input%20remains%20visible%20to%20its%20strict%20original%20guard%27%29%3B%0A%20%20%20%20for%28const%20mutate%20of%20%5Bvalue%3D%3E%7Bvalue.sources%5Bindex%5D.source%2B%3D%27%20%27%3B%7D%2Cvalue%3D%3E%7Bvalue.sources%5Bi