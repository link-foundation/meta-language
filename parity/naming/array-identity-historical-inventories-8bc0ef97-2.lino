(30649: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20The%20readable-naming%20check%20%28docs%2Fvision.md%23readable-english-names%29%3A%20every%0A%2F%2F%20canonical%20name%20the%20sources%20define%20has%20a%20concept%20record%2C%20every%20record%20is%20an%0A%2F%2F%20unabbreviated%20English%20noun%20phrase%20%28concepts%29%20or%20verb%20phrase%20%28operations%29%0A%2F%2F%20checked%20against%20WordNet%203.1%2C%20and%20a%20mutation%20that%20introduces%20an%20abbreviation%2C%0A%2F%2F%20an%20ambiguity%2C%20a%20semantic%20duplicate%20or%20an%20unrecorded%20name%20fails%20the%20gate.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7B%20createHash%20%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7B%20readFileSync%20%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7B%20fileURLToPath%20%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7B%20test%20%7D%20from%20%27node%3Atest%27%3B%0A%0Aimport%20%7B%20areSynonyms%2C%20loadWordNet%2C%20partsOfSpeech%20%7D%20from%20%27..%2Fscripts%2Fenglish-vocabulary.mjs%27%3B%0Aimport%20%7B%0A%20%20checkConceptRecords%2C%0A%20%20checkNamingFixtures%2C%0A%20%20checkRepositoryNames%2C%0A%20%20extractNameInventory%2C%0A%20%20extractSourceDescriptions%2C%0A%20%20FORMER_NAME_TABLES%2C%0A%20%20loadNamingRegisters%2C%0A%20%20NAME_INVENTORIES%2C%0A%20%20NAMING_FIXTURES%2C%0A%20%20nameProblems%2C%0A%7D%20from%20%27..%2Fscripts%2Fissue-195-naming.mjs%27%3B%0Aimport%20%7B%20recordIssue195Observations%20%7D%20from%20%27.%2Fsupport%2Fissue-195-observations.js%27%3B%0Aimport%20%7B%20extractOwnCodebaseHistoricalNames%2C%20readOwnCodebaseHistoricalNamingPolicy%20%7D%20from%20%27..%2Fscripts%2Fown-codebase-baseline-naming-history.mjs%27%3B%0Aimport%20%7B%20readProjectData%20%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0A%0Aconst%20root%20%3D%20fileURLToPath%28new%20URL%28%27..%2F..%2F%27%2C%20import.meta.url%29%29%3B%0Aconst%20wordnet%20%3D%20loadWordNet%28%29%3B%0Aconst%20registers%20%3D%20loadNamingRegisters%28root%