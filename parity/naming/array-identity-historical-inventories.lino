erifyTruthyProjectionSchemaPacket%28readProjectData%28new%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%29%29%3B%0A%7D%0A%0A%2F%2F%20This%20view%20belongs%20only%20to%20the%20old%20Boolean-projection%20source%20author.%20Both%0A%2F%2F%20complete%20source%20epochs%20have%20independent%20Git%20membership%3B%20runtime%20callers%20keep%0A%2F%2F%20the%20actual%20checker.%20The%20original%20projection%20packet%20remains%20byte-for-byte.%0Aexport%20function%20verifyTruthyProjectionHostSuccessors%28packet%29%20%7B%0A%20assert.deepEqual%28Object.keys%28packet%29.sort%28%29%2C%5B%27boundary%27%2C%27model%27%2C%27previousRevision%27%2C%27revision%27%2C%27schemaVersion%27%2C%27sources%27%5D%29%3B%0A%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27Boolean%20projection%20checker%20source%20succession%201%27%29%3B%0A%20assert.equal%28packet.previousRevision%2C%276ffff3b2dc530a5f24c128dadf877f3fa106932b%27%29%3B%0A%20assert.equal%28packet.revision%2C%273fe3a9f9decfa6431b5b0718729a5d123b5f236b%27%29%3B%0A%20assert.equal%28packet.boundary%2C%27Only%20complete%20certified%20checker%20sources%20receive%20the%20original%20Boolean%20projection%20source%20view.%20Runtime%20semantics%20and%20the%20immutable%20original%20projection%20packet%20remain%20unchanged%3B%20unknown%20source%20bytes%20refuse.%27%29%3B%0A%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2C%5B%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%27rust%2Fsrc%2Ftranslation%2Fsurface%2Fnodes.rs%27%2C%27rust%2Fsrc%2Ftranslation%2Fcheck%2Fexpressions.rs%27%5D%29%3B%0A%20const%20original%3DreadTruthyProjectionSchemaPacket%28%29%3B%0A%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27current%27%2C%27edit%27%2C%27file%27%2C%27previous%27%5D%29%3B%0A%20%20for%28const%20%5Bepoch%2Crevision%5Dof%5B%5B%27previous%27%2Cpacket.previousRevision%5D%2C%5B%27current%27%2Cpacket.revision%5D%5D%29%7B%0A%20%20%20const%20source%3Drow%5Bepoch%5D%3Bassert.deepEqual%28Object.keys%28source%29.sort%28%29%2C%5B%27bytes%27%2C%27certificate%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20%20assert.deepEqual%28pinTruthyProjectionSource%28source.source%29%2C%7Bbytes%3Asource.bytes%2Csha256%3Asource.sha256%7D%29%3B%0A%20%20%20verifyGitArtifactCertificate%28source.certificate%2CBuffer.from%28source.source%29%2C%7Brevision%2Cpath%3Arow.file%7D%29%3B%0A%20%20%7D%0A%20%20assert.equal%28row.previous.source%2Coriginal.sources.find%28source%3D%3Esource.file%3D%3D%3Drow.file%29.current.source%29%3B%0A%20%20const%20%7Bstart%2Cremoved%2Cinserted%7D%3Drow.edit%3Bassert.deepEqual%28Object.keys%28row.edit%29.sort%28%29%2C%5B%27inserted%27%2C%27removed%27%2C%27start%27%5D%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28start%29%26%26start%3E%3D0%29%3Bassert.equal%28typeof%20removed%2C%27string%27%29%3Bassert.equal%28typeof%20inserted%2C%27string%27%29%3B%0A%20%20assert.equal%28row.previous.source.slice%28start%2Cstart%2Bremoved.length%29%2Cremoved%29%3B%0A%20%20assert.equal%28row.previous.source.slice%280%2Cstart%29%2Binserted%2Brow.previous.source.slice%28start%2Bremoved.length%29%2Crow.current.source%29%3B%0A%20%20assert.equal%28row.current.source.slice%280%2Cstart%29%2Bremoved%2Brow.current.source.slice%28start%2Binserted.length%29%2Crow.previous.source%2C%27every%20complete%20old%20checker%20byte%20survives%27%29%3B%0A%20%7D%0A%20return%20packet%3B%0A%7D%0A%0Aexport%20function%20restoreTruthyProjectionHostSource%28source%2Cfile%29%20%7B%0A%20assert.equal%28typeof%20source%2C%27string%27%29%3B%0A%20if%28%21%5B%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%27rust%2Fsrc%2Ftranslation%2Fsurface%2Fnodes.rs%27%2C%27rust%2Fsrc%2Ftranslation%2Fcheck%2Fexpressions.rs%27%5D.includes%28file%29%29return%20source%3B%0A%20const%20packet%3DverifyTruthyProjectionHostSuccessors%28readProjectData%28new%20URL%28TRUTHY_PROJECTION_HOST_SUCCESSORS%2Croot%29%29%29%3B%0A%20const%20row%3Dpacket.sources.find%28value%3D%3Evalue.file%3D%3D%3Dfile%29%3B%0A%20return%20source%3D%3D%3Drow.current.source%3Frow.previous.source%3Asource%3B%0A%7D%0A%0A%2F%2F%20Explicit%20historical%20readers%20only.%20Runtime%20schema%2Fcheckers%20always%20use%20actual%0A%2F%2F%20current%20bytes%3B%20unknown%20complete%20schema%20or%20host%20successors%20still%20refuse.%0Aexport%20function%20restoreTruthyProjectionHistoricalSource%28bytes%2Cfile%29%20%7B%0A%20assert.ok%28Buffer.isBuffer%28bytes%29%26%26bytes.length%3C%3D256%2A1024%29%3B%0A%20const%20expected%3DinspectedTruthyPreimages.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28expected%2C%27closed%20five-source%20historical%20view%27%29%3B%0A%20const%20physical%3Dbytes.toString%28%27utf8%27%29%3Bassert.equal%28Buffer.from%28physical%29.equals%28bytes%29%2Ctrue%29%3B%0A%20const%20text%3DrestoreTruthyProjectionHostSource%28physical%2Cfile%29%3B%0A%20if%28pinTruthyProjectionSource%28bytes%29.sha256%3D%3D%3Dexpected.sha256%29%7Bassert.equal%28bytes.length%2Cexpected.bytes%29%3Breturn%20text%3B%7D%0A%20const%20packet%3DreadTruthyProjectionSchemaPacket%28%29%2Crow%3Dpacket.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3B%0A%20assert.equal%28text%2Crow.current.source%2C%27unknown%20complete%20current%20source%20refuses%20historical%20authority%27%29%3B%0A%20assert.deepEqual%28pinTruthyProjectionSource%28text%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20return%20row.previous.source%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
