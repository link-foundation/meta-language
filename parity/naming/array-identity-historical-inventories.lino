(133845: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %23%21%2Fusr%2Fbin%2Fenv%20node%0A%2F%2F%20Measures%2C%20per%20module%2C%20how%20far%20the%20self-translation%20of%20each%20JavaScript%20module%0A%2F%2F%20of%20js%2Fsrc%20into%20Rust%20is%20from%20its%20hand-written%20Rust%20counterpart%0A%2F%2F%20%28rust%2Fsrc%2F%3Cpath%20in%20snake%20case%3E.rs%20or%20...%2Fmod.rs%29%2C%20and%20writes%20the%20report%20as%0A%2F%2F%20Markdown%20and%20inspectable%20Links%20Notation.%20CI%20runs%20it%20on%20every%20push%20and%0A%2F%2F%20publishes%20both%3B%20it%20reads%20the%20whole%20source%20tree%2C%20so%20it%20is%20not%20meant%20for%20a%0A%2F%2F%20local%20run%20%28pass%20--modules%20to%20measure%20a%20few%20modules%29.%0A%2F%2F%0A%2F%2F%20%20%20node%20js%2Fscripts%2Fgenerate-self-translation-report.mjs%20--out-dir%20%3Cdir%3E%20%5B--modules%20a.js%2Cb.js%5D%0A%2F%2F%20%20%20%20%20%5B--decorators%20parity%2Fself-translation%2Fdecorators.lino%5D%20%5B--shard%20K%2FN%5D%20%5B--list%5D%0A%2F%2F%20%20%20%20%20%5B--replay-plan%20selected-blockers.lino%5D%0A%2F%2F%0A%2F%2F%20The%20whole%20tree%20takes%20over%20an%20hour%20on%20one%20runner%2C%20so%20CI%20splits%20it%3A%20%60--shard%0A%2F%2F%20K%2FN%60%20measures%20the%20K-th%20of%20N%20shards%2C%20balanced%20with%20source-bound%20CI%20timings%0A%2F%2F%20and%20byte-size%20estimates%20for%20changed%20sources.%20%60--list%60%20lists%20its%20modules.%0A%2F%2F%0A%2F%2F%20For%20each%20module%20the%20report%20lists%20its%20top-level%20items%20by%20status%2C%20the%20Rust%0A%2F%2F%20functions%20the%20translation%20writes%2C%20how%20many%20of%20them%20the%20hand-written%20Rust%0A%2F%2F%20defines%20under%20the%20same%20name%20and%20how%20many%20of%20those%20are%20identical%20up%20to%0A%2F%2F%20whitespace%2C%20and%20the%20code%20lines%20of%20the%20translation%20%28no%20comments%2C%20preludes%20or%0A%2F%2F%20blank%20lines%29%20the%20hand-written%20Rust%20holds%20too%2C%20counted%20as%20a%20multiset.%20Each%0A%2F%2F%20module%20is%20measured%20twice%2C%20by%20the%20generic%20translation%20and%20by%20the%20translation%0A%2F%2F%20with%20the%20shared%20emitter%20decorators%20%28docs%2Fdecorators.md%29%2C%20so%20the%20report%20shows%0A%2F%2F%20how%20much%20of%20the%20difference%20the%20decorators%20close.%0Aimport%20%7B%20existsSync%2C%20mkdirSync%2C%20readdirSync%2C%20readFileSync%2C%20realpathSync%2C%20writeFileSync%20%7D%20from%20%27node%3Afs%27%3B%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7B%20execFileSync%20%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7B%20dirname%2C%20join%2C%20posix%2C%20relative%2C%20resolve%2C%20sep%20%7D%20from%20%27node%3Apath%27%3B%0Aimport%20%7B%20createHash%20%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7B%20fileURLToPath%20%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7B%20isMainThread%20%7D%20from%20%27node%3Aworker_threads%27%3B%0Aimport%20%7B%20readProjectData%2C%20writeProjectData%20%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0A%0Aimport%20%7B%20DecoratorSet%20%7D%20from%20%27..%2Fsrc%2Fdecorators.js%27%3B%0Aimport%20%7B%20parseProgrammingLanguage%20%7D%20from%20%27..%2Fsrc%2Fprogramming-language-parser.js%27%3B%0Aimport%20%7B%20selfTranslate%2C%20selfTranslationSignatures%20%7D%20from%20%27..%2Fsrc%2Fself-translation.js%27%3B%0Aimport%20%7B%20tokenize%20%7D%20from%20%27..%2Fsrc%2Ftranslation%2Flexer.js%27%3B%0Aimport%20%7B%20createReportMeasurementWorker%20%7D%20from%20%27.%2Fself-translation-report-worker-host.mjs%27%3B%0Aimport%20%7B%20rankSelfTranslationBlockers%2C%20requireReportSourcePath%2C%20validateSelfTranslationReplayPlan%20%7D%20from%20%27.%2Fself-translation-report-blockers.mjs%27%3B%0Aimport%20%7B%20summarizeRetainedSelfTranslationPhases%2C%20retainedSelfTranslationPhaseMarkdown%20%7D%20from%20%27.%2Fself-translation-phase-summary.mjs%27%3B%0Aimport%20%7BpartitionMeasuredWorkloads%7D%20from%20%27.%2Ftest-groups.mjs%27%3B%0A%0Aconst%20root%20%3D%20resolve%28dirname%28fileURLToPath%28import.meta.url%29%29%2C%20%27..%2F..%27%29%3B%0Aconst%20STATUSES%20%3D%20%5B%27translated%27%2C%20%27carried%27%2C%20%27comment%27%5D%3B%0Aconst%20DEFAULT_DECORATORS%20%3D%20%27parity%2Fself-translation%2Fdecorators.lino%27%3B%0A%2F%2F%20The%20native%20codec%20keeps%20pattern%20graph%20scope%20admission%20in%20this%20component.%0A%2F%2F%20This%20reviewed%20association%20measures%20its%20actual%20bytes%3B%20it%20does%20not%20establish%0A%2F%2F%20that%20the%20JavaScript%20host%20adapter%20has%20been%20completely%20self-translated.%0Aconst%20REVIEWED_COUNTERPARTS%20%3D%20Object.freeze%28%7B%0A%20%20%27js%2Fsrc%2Ftyped-program-pattern-bindings.js%27%3A%20%27rust%2Fsrc%2Ftyped_program_links%2Fcodec_scopes.rs%27%2C%0A%7D%29%3B%0A%0Afunction%20option%28name%29%20%7B%0A%20%20const%20index%20%3D%20process.argv.indexOf%28name%29%3B%0A%20%20return%20index%20%3D%3D%3D%20-1%20%3F%20null%20%3A%20process.argv%5Bindex%20%2B%201%5D%3B%0A%7D%0A%0Afunction%20modules%28replayPlan%29%20%7B%0A%20%20const%20replay%20%3D%20option%28%27--replay-plan%27%29%3B%0A%20%20if%20%28replay%29%20%7B%0A%20%20%20%20assert.ok%28%21option%28%27--modules%27%29%20%26%26%20%21option%28%27--shard%27%29%2C%20%27--replay-plan%20cannot%20silently%20narrow%20--modules%20or%20--shard%27%29%3B%0A%20%20%20%20return%20validateSelfTranslationReplayPlan%28replayPlan%20%3F%3F%20readProjectData%28replay%29%2C%20listSourceModules%28%29%2C%20module%20%3D%3E%20%7B%0A%20%20%20%20%20%20const%20file%20%3D%20realpathSync%28join%28root%2C%20module%29%29%3B%0A%20%20%20%20%20%20const%20path%20%3D%20relative%28realpathSync%28root%29%2C%20file%29.split%28sep%29.join%28%27%2F%27%29%3B%0A%20%20%20%20%20%20requireReportSourcePath%28path%29%3B%0A%20%20%20%20%20%20return%20readFileSync%28file%29%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%7D%0A%20%20const%20listed%20%3D%20option%28%27--modules%27%29%3B%0A%20%20if%20%28listed%29%20%7B%0A%20%20%20%20const%20catalog%20%3D%20new%20Set%28listSourceModules%28%29%29%3B%0A%20%20%20%20const%20selected%20%3D%20listed.split%28%27%2C%27%29.map%28file%20%3D%3E%20requireReportSourcePath%28%60js%2Fsrc%2F%24%7Bfile%7D%60%29%29%3B%0A%20%20%20%20assert.equal%28new%20Set%28selected%29.size%2C%20selected.length%2C%20%27duplicate%20selected%20report%20module%27%29%3B%0A%20%20%20%20for%20%28const%20module%20of%20selected%29%20assert.ok%28catalog.has%28module%29%2C%20%60selected%20report%20source%20is%20missing%3A%20%24%7Bmodule%7D%60%29%3B%0A%20%20%20%20return%20selected%3B%0A%20%20%7D%0A%20%20return%20listSourceModules%28%29%3B%0A%7D%0A%0Afunction%20listSourceModules%28%29%20%7B%0A%20%20const%20walk%20%3D%20%28directory%29%20%3D%3E%20readdirSync%28join%28root%2C%20directory%29%2C%20%7B%20withFileTypes%3A%20true%20%7D%29.flatMap%28%28entry%29%20%3D%3E%20%7B%0A%20%20%20%20const%20path%20%3D%20posix.join%28directory%2C%20entry.name%29%3B%0A%20%20%20%20if%20%28entry.isDirectory%28%29%29%20return%20walk%28path%29%3B%0A%20%20%20%20return%20entry.name.endsWith%28%27.js%27%29%20%3F%20%5Bpath%5D%20%3A%20%5B%5D%3B%0A%20%20%7D%29%3B%0A%20%20return%20walk%28%27js%2Fsrc%27%29.sort%28%29%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20The%20K-th%20measured-cost%20shard%3B%20every%20complete%20current%20source%20appears%20once.%0A%20%2A%2F%0Afunction%20shardOf%28files%2C%20index%2C%20count%29%20%7B%0A%20%20return%20partitionMeasuredWorkloads%28files%2Ccount%29%5Bindex-1%5D%3B%0A%7D%0A%0Afunction%20selectedModules%28replayPlan%29%20%7B%0A%20%20const%20shard%20%3D%20option%28%27--shard%27%29%3B%0A%20%20if%20%28%21shard%29%20return%20modules%28replayPlan%29%3B%0A%20%20const%20match%20%3D%20%2F%5E%28%5B1-9%5D%5B0-9%5D%2A%29%5C%2F%28%5B1-9%5D%5B0-9%5D%2A%29%24%2Fu.exec%28shard%29%3B%0A%20%20if%20%28%21match%20%7C%7C%20Number%28match%5B1%5D%29%20%3E%20Number%28match%5B2%5D%29%29%20%7B%0A%20%20%20%20console.error%28%60--shard%20takes%20K%2FN%20with%201%20%3C%3D%20K%20%3C%3D%20N%2C%20not%20%24%7Bshard%7D%60%29%3B%0A%20%20%20%20process.exit%282%29%3B%0A%20%20%7D%0A%20%20return%20shardOf%28modules%28replayPlan%29%2C%20Number%28match%5B1%5D%29%2