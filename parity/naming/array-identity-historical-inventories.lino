%5D%29assert.deepEqual%28row%5Bkey%5D%2Cexpected%5Bkey%5D%29%3B%0A%20%20%20%20exactKeys%28row.predecessor%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20assert.equal%28typeof%20row.predecessor.source%2C%27string%27%29%3B%0A%20%20%20%20const%20bytes%3DBuffer.from%28row.predecessor.source%29%3Bassert.equal%28bytes.toString%28%27utf8%27%29%2Crow.predecessor.source%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28bytes%29%2Cexpected.predecessor%29%3B%0A%20%20%20%20assert.equal%28row.predecessor.bytes%2Cexpected.predecessor.bytes%29%3Bassert.equal%28row.predecessor.sha256%2Cexpected.predecessor.sha256%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.predecessor.certificate%2Cbytes%2C%7Brevision%3Apolicy.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%20%20%20const%20current%3Dreplay%28row.predecessor.source%2Crow.edits%29%3Bassert.deepEqual%28pin%28current%29%2Crow.current%29%3B%0A%20%20%20%20let%20inverse%3Dcurrent%3B%0A%20%20%20%20for%28const%20edit%20of%20row.edits.toReversed%28%29%29%7Bassert.equal%28inverse.split%28edit.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28edit.after%2C%28%29%3D%3Eedit.before%29%3B%7D%0A%20%20%20%20assert.equal%28inverse%2Crow.predecessor.source%2C%27every%20original%20source%20byte%20and%20assertion%20remains%20exact%27%29%3B%0A%20%20%7D%0A%20%20return%20history%3B%0A%7D%0A%0A%2F%2A%2A%20Normal%20offline%20controls%20need%20only%20this%20compact%20Links%20archive.%20%2A%2F%0Aexport%20function%20readOwnCodebaseTestRegistrationHistory%28%29%7B%0A%20%20const%20source%3DreadFileSync%28new%20URL%28%27..%2F..%2Fparity%2Fnaming%2Fown-codebase-test-registration-source-history.lino%27%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20return%20verifyOwnCodebaseTestRegistrationHistory%28readBootstrapStructuredDataLino%28source%29%29%3B%0A%7D%0A%0Afunction%20restoreSource%28source%2Cfile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%0A%20%20const%20history%3DreadOwnCodebaseTestRegistratio