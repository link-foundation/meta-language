dit%27%5D%29%3B%0A%20%20%20%20assert.equal%28typeof%20row.source%2C%27string%27%29%3Bassert.ok%28Buffer.byteLength%28row.source%29%3C%3D512%2A1024%29%3B%0A%20%20%20%20assert.deepEqual%28pinRawConsumingSnapshotSource%28row.source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20assert.equal%28row.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3Bkeys%28row.edit%2C%5B%27start%27%2C%27removed%27%2C%27inserted%27%5D%29%3B%0A%20%20%20%20const%20original%3Dprevious%5Bindex%5D.source%2Cedit%3Drow.edit%3B%0A%20%20%20%20assert.deepEqual%28edit%2CderiveRawConsumingSnapshotSourceInterval%28original%2Crow.source%29%29%3B%0A%20%20%20%20assert.equal%28original.slice%28edit.start%2Cedit.start%2Bedit.removed.length%29%2Cedit.removed%29%3B%0A%20%20%20%20assert.equal%28original.slice%280%2Cedit.start%29%2Bedit.inserted%2Boriginal.slice%28edit.start%2Bedit.removed.length%29%2Crow.source%29%3B%0A%20%20%20%20assert.equal%28row.source.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20assert.equal%28row.source.slice%280%2Cedit.start%29%2Bedit.removed%2Brow.source.slice%28edit.start%2Bedit.inserted.length%29%2Coriginal%2C%27every%20certified%20historical%20source%20byte%20survives%27%29%3B%0A%20%20%20%20if%28bindCurrent%29assert.equal%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.source%2C%27actual%20final-use%20decision%20sources%20changed%3A%20%27%2Brow.file%29%3B%0A%20%20%7D%0A%20%20return%20packet%3B%0A%7D%0A%0Afunction%20load%28bindCurrent%29%7B%0A%20%20if%28%21cached%29%7B%0A%20%20%20%20assert.match%28packetSha256%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%2C%27the%20normal%20source%20author%20must%20capture%20this%20profile%20first%27%29%3B%0A%20%20%20%20const%20file%3Dnew%20URL%28RAW_CONSUMING_SNAPSHOT_OUTPUT%2Croot%29%2Cbytes%3DreadFileSync%28file%29%3B%0A%20%20%20%20assert.equal%28pinRawConsumingSnapshotSource%28bytes%29.sha256%2CpacketSha256%2C%27the%20complete%20independently%20pinned%20source%20profile%20stays%20exact%27%29%3B%0A%20%20%20%20cached%3DverifyRawConsumingSnapshotSourceStructure%28readProjectData%28file%29%2C%7BbindCurrent%3Afalse%7D%29%3B%0A%20%20%7D%0A%20%20if%28bindCurrent%29for%28const%20row%20of%20cached.sources%29assert.equal%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.source%2C%27actual%20final-use%20decision%20sources%20changed%3A%20%27%2Brow.file%29%3B%0A%20%20return%20cached%3B%0A%7D%0Aexport%20function%20readRawConsumingSnapshotSourceProfile%28%29%7Breturn%20structuredClone%28load%28true%29%29%3B%7D%0Aexport%20function%20readCertifiedRawConsumingSnapshotSources%28%29%7Breturn%20structuredClone%28load%28false%29.previous%29%3B%7D%0A%0A%2F%2A%2A%20Only%20these%20five%20exact%20current%20files%20acquire%20their%20recorded%20snapshot%20source%3B%0A%20%2A%20all%20other%20paths%20are%20identities%2C%20and%20even%20one%20unknown%20selected%20byte%20refuses.%20%2A%2F%0Aexport%20function%20restoreRawConsumingSnapshotSource%28bytes%2Cfile%2CcurrentOnly%3Dfalse%29%7B%0A%20%20const%20index%3DRAW_CONSUMING_SNAPSHOT_FILES.findIndex%28row%3D%3Erow.file%3D%3D%3Dfile%29%3B%0A%20%20if%28index%3C0%29return%20bytes%3B%0A%20%20const%20packet%3Dload%28true%29%2Crow%3Dpacket.sources%5Bindex%5D%3B%0A%20%20assert.ok%28Buffer.isBuffer%28bytes%29%2C%27complete%20current%20source%20bytes%20are%20required%27%29%3B%0A%20%20if%28currentOnly%26%26bytes.toString%28%27utf8%27%29%21%3D%3Drow.source%29return%20bytes%3B%0A%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2Crow.source%2C%27actual%20final-use%20decision%20sources%20changed%3A%20%27%2Bfile%29%3B%0A%20%20assert.deepEqual%28pinRawConsumingSnapshotSource%28bytes%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20return%20Buffer.from%28packet.previous%5Bindex%5D.source%29%3B%0A%7D%0Aexport%20function%20rawConsumingSnapshotSourceReader%28read%29%7B%0A%20%20const%20selected%3Dnew%20Map%28RAW_CONSUMING_SNAPSHOT_FILES.map%28row%3D%3E%5BString%28new%20URL%28row.file%2Croot%