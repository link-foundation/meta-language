vious.bytes%2Csha256%3Aprevious.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28history.historical.certificate%2CBuffer.from%28history.historical.sourceText%29%2C%7Brevision%3Anaming.revision%2Cpath%3Aprevious.file%7D%29%3B%0A%20%20assert.deepEqual%28history.currentAuthority%2C%7Brevision%3Acurrent.revision%2Cfile%3Acurrent.sourceFile%2C%0A%20%20%20%20predecessor%3Acurrent.sourceOwner.predecessor%2Ccurrent%3Acurrent.sourceOwner.current%7D%29%3B%0A%20%20const%20inference%3Dhistory.nullableInference%2CexpectedInference%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE%3B%0A%20%20exactKeys%28inference%2C%5B%27path%27%2C%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.equal%28inference.path%2CexpectedInference.path%29%3Bassert.equal%28inference.revision%2CexpectedInference.revision%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Ainference.bytes%2Csha256%3Ainference.sha256%7D%2CexpectedInference.previous%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28inference.sourceText%29%2CexpectedInference.previous%29%3B%0A%20%20verifyGitArtifactCertificate%28inference.certificate%2CBuffer.from%28inference.sourceText%29%2C%7Brevision%3AexpectedInference.revision%2Cpath%3AexpectedInference.path%7D%29%3B%0A%20%20const%20inferenceReplay%3DreplayRelativeArrayNullableInference%28inference.sourceText%29%3B%0A%20%20assert.deepEqual%28inference.current%2CexpectedInference.current%29%3Bassert.deepEqual%28inference.edits%2CinferenceReplay.edits%29%3B%0A%20%20exactKeys%28history.host%2C%5B%27path%27%2C%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.deepEqual%28%7Bpath%3Ahistory.host.path%2Crevision%3Ahistory.host.revision%2Cbytes%3Ahistory.host.bytes%2Csha256%3Ahistory.host.sha256%7D%2CRELATIVE_ARRAY_FRONTEND_HOST%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28history.host.sourceText%29%2C%7Bbytes%3