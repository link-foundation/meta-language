(118695: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %23%21%2Fusr%2Fbin%2Fenv%20node%0A%2F%2F%20Partitions%20the%20JavaScript%20test%20files%20into%20the%20groups%20CI%20runs%20as%20separate%0A%2F%2F%20jobs%2C%20so%20no%20single%20job%20runs%20the%20whole%20suite%20in%20one%20process.%0A%2F%2F%0A%2F%2F%20%20%20node%20scripts%2Ftest-groups.mjs%20--check%20%20%20%20%20%20%20%20every%20test%20file%20is%20in%20exactly%20one%20group%0A%2F%2F%20%20%20node%20scripts%2Ftest-groups.mjs%20--list%20GROUP%20%20%20print%20the%20files%20of%20GROUP%0A%2F%2F%20%20%20node%20scripts%2Ftest-groups.mjs%20--run%20GROUP%20%20%20%20run%20GROUP%20with%20node%20--test%0A%2F%2F%20%20%20%20%20%5B--shard%20K%2FN%5D%20%28or%20TEST_GROUP_SHARD%3DK%2FN%29%20partitions%20files%20exactly%20once%0A%2F%2F%0A%2F%2F%20A%20new%20test%20file%20that%20no%20group%20claims%20fails%20--check%20%28and%20every%20--run%29%2C%20so%20a%0A%2F%2F%20file%20can%20never%20silently%20drop%20out%20of%20CI.%0Aimport%20%7B%20spawnSync%2CexecFileSync%20%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7B%20readdirSync%2CreadFileSync%20%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20path%20from%20%27node%3Apath%27%3B%0Aimport%20%7B%20fileURLToPath%20%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BreadProjectData%2CwriteProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0A%0Aconst%20packageRoot%20%3D%20path.resolve%28path.dirname%28fileURLToPath%28import.meta.url%29%29%2C%20%27..%27%29%3B%0Aconst%20schedulingFile%3Dnew%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fci-39615628279-workload-costs.lino%27%2Cimport.meta.url%29%3B%0Aconst%20schedulingRevision%3D%278bc0ef9725388c7927acf1854870bf46f5e365be%27%3B%0Aconst%20schedulingDigest%3Dvalue%3D%3EcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0A%0A%2F%2A%2A%20Largest%20observed%20workload%20first%3B%20source%20changes%20use%20a%20byte-size%20estimate.%0A%20%2A%20Timing%20samples%20only%20choose%20owners.%20They%20never%20establish%20test%20completion.%20%2A%2F%0Aexport%20function%20partitionMeasuredWorkloads%28files%2Ccount%2C%7BreadSource%2Ccosts%7D%3D%7B%7D%29%7B%0A%20assert.ok%28Number.isSafeInteger%28count%29%26%26count%3E0%26%26count%3C%3Dfiles.length%29%3B%0A%20assert.equal%28new%20Set%28files%29.size%2Cfiles.length%2C%27workload%20source%20identities%20are%20unique%27%29%3B%0A%20const%20measured%3Dcosts%3F%3FreadProjectData%28schedulingFile%29%3B%0A%20assert.equal%28measured.schemaVersion%2C1%29%3Bassert.equal%28measured.model%2C%27observed%20CI%20workload%20scheduling%20costs%201%27%29%3B%0A%20assert.equal%28measured.run%2C39615628279%29%3Bassert.equal%28measured.revision%2CschedulingRevision%29%3B%0A%20assert.ok%28Array.isArray%28measured.entries%29%26%26measured.entries.length%3C%3D2048%29%3B%0A%20const%20known%3Dnew%20Map%28%29%3B%0A%20for%28const%20row%20of%20measured.entries%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27bytes%27%2C%27file%27%2C%27milliseconds%27%2C%27sha256%27%5D%29%3B%0A%20%20assert.ok%28typeof%20row.file%3D%3D%3D%27string%27%26%26%21known.has%28row.file%29%29%3Bassert.match%28row.sha256%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28row.bytes%29%26%26row.bytes%3E0%26%26Number.isSafeInteger%28row.milliseconds%29%26%26row.milliseconds%3E0%29%3B%0A%20%20known.set%28row.file%2Crow%29%3B%0A%20%7D%0A%20const%20rates%3Dmeasured.entries.map%28row%3D%3Erow.milliseconds%2Frow.bytes%29.sort%28%28a%2Cb%29%3D%3Ea-b%29%3B%0A%20assert.ok%28rates.length%3E0%29%3Bconst%20rate%3Drates%5BMath.floor%28rates.length%2F2%29%5D%3B%0A%20const%20read%3DreadSource%3F%3F%28file%3D%3EreadFileSync%28path.join%28packageRoot%2C%27..%27%2Cfile%29%29%29%3B%0A%20const%20workloads%3Dfiles.map%28file%3D%3E%7Bconst%20bytes%3DBuffer.from%28read%28file%29%29%2Crow%3Dknown.get%28file%29%3B%0A%20%20const%20exact%3Drow%26%26row.bytes%