nError%2C%27tamper%20%27%2Bindex%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27both%20actual%20isolated%20model%20overlays%20load%20using%20the%20updated%20exact%20current%20provider%20receipts%27%2Casync%28%29%3D%3E%7B%0A%20%20for%28const%20create%20of%20%5BcreateRustTextCertificatePublicOverlay%2CcreateRustRawBindingCertificateOverlay%5D%29%7B%0A%20%20%20%20const%20overlay%3Dawait%20create%28%29%3B%0A%20%20%20%20try%7B%0A%20%20%20%20%20%20assert.equal%28overlay.receipts.length%2C5%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20overlay.api.createTypedProgramLinks%2C%27function%27%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20overlay.javascript.emitJavaScript%2C%27function%27%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20overlay.validation.validateLinkedTypedProgram%2C%27function%27%29%3B%0A%20%20%20%20%7Dfinally%7Boverlay.dispose%28%29%3B%7D%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27normal%20source%20review%20refreshes%20only%20current%20receipts%20and%20retains%20both%20immutable%20original%20overlays%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20paths%3DreviewedOverlayProviderPolicy.historicalOverlays.map%28row%3D%3E%27experiments%2F%27%2Brow.experiment%2B%27%2Fdata%2Foverlays.lino%27%29%3B%0A%20%20const%20before%3Dpaths.map%28read%29%3B%0A%20%20const%20packet%3Dawait%20generateReviewedOverlayProviderSuccession%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20assert.deepEqual%28packet%2CreadReviewedOverlayProviderSuccession%28%29%29%3B%0A%20%20paths.forEach%28%28path%2Cindex%29%3D%3Eassert.deepEqual%28read%28path%29%2Cbefore%5Bindex%5D%29%29%3B%0A%20%20assert.deepEqual%28readProjectData%28new%20URL%28%27experiments%2Frust-text-certificate-adapter%2Fdata%2Fprovider-revisions.lino%27%2Croot%29%29%2CreviewedOverlayProviderPolicy%29%3B%0A%7D%29%3B%0A%0A%0Atest%28%27a%20real%20appended%20source%20epoch%20preserves%20the%20complete%20original%20packet%20policy%20receipts%20and%20exact%20only-emitter%20source%20inverse%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20packet%3DreadReviewedOverlayProviderSuccession%28%29%3Bassert.equal%28packet.profiles.length%2C3%29%3B%0A%20%20const%20current%3Dpacket.profiles.at%28-1%29%2Creview%3DOVERLAY_PROVIDER_APPEND_REVIEW%3B%0A%20%20assert.equal%28current.previousSourceCommit%2Cpacket.profiles%5B1%5D.sourceCommit%29%3B%0A%20%20assert.equal%28current.epoch.reviewKind%2Creview.kind%29%3Bassert.equal%28current.review%2Creview.review%29%3B%0A%20%20assert.deepEqual%28current.inverse.map%28row%3D%3Erow.module%29%2C%5B%27translation%2Femit-rust.js%27%5D%29%3B%0A%20%20const%20prefix%3D%7B...packet%2Cprofiles%3Apacket.profiles.slice%280%2C2%29%7D%2Csource%3DserializeProjectData%28prefix%2C%27parity%2Fself-translation%2Freviewed-overlay-provider-succession.lino%27%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3ABuffer.byteLength%28source%29%2Csha256%3Ahash%28source%29%7D%2COVERLAY_PROVIDER_ORIGINAL_PACKET%2C%0A%20%20%20%20%27dropping%20only%20the%20verified%20suffix%20reconstructs%20every%20original%20packet%20byte%27%29%3B%0A%20%20assert.equal%28Object.hasOwn%28current.epoch.predecessorPacket%2C%27source%27%29%2Cfalse%2C%27no%20duplicate%20whole%20packet%20snapshot%20is%20stored%27%29%3B%0A%20%20assert.deepEqual%28deriveReviewedOverlayProviderPolicy%28prefix%29.revisions.slice%28-2%29%2Cprefix.profiles%29%3B%0A%20%20verifyReviewedOverlayProviderSuccessionHistory%28prefix%29%3B%0A%20%20for%28const%20row%20of%20current.certificates%29%7B%0A%20%20%20%20assert.equal%28read%28%27js%2Fsrc%2F%27%2Brow.module%29.toString%28%27utf8%27%29%2Crow.current.source%29%3B%0A%20%20%20%20const%20restored%3DrestoreReviewedOverlayProviderModuleSource%28row.current.source%2C%27js%2Fsrc%2F%27%2Brow.module%29%3B%0A%20%20%20%20const%20original%3Dpacket.profiles%5B0%5D.certificates.find%28value%3D%3Evalue.module%3D%3D%3Drow.module%29%3B%0A%20%20%20%20assert.equal%28restored%2Coriginal.current.source%2C%27the%20explicit%20historical%20module%20view%20reaches%20exact8d%27%29%3B%0A%20%20%20%20assert.equal%28restoreReviewedOverlayProviderModuleSource%