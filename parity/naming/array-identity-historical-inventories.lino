(16593: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Complete%20source-compiler%20proofs%20only.%20No%20corpus%2C%20grammar%20parse%20or%20native%20process.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20test%20from%20%27node%3Atest%27%3B%0Aimport%20%7BstructuredDataToLino%7D%20from%20%27..%2F..%2Fjs%2Fsrc%2Fstructured-data-links.js%27%3B%0Aimport%20%7BreadProjectData%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BrestoreCompleteDeclarationReceipt%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fcomplete-declaration-receipts.mjs%27%3B%0Aimport%20%7BORIGINAL_LINK_RAW_EMISSION_BASELINE%2CORIGINAL_LINK_RAW_CURRENT_ARTIFACT%2CORIGINAL_LINK_RAW_HISTORICAL_ARTIFACT%7D%20from%20%27.%2Fraw-emission-profiles.mjs%27%3B%0Aimport%20%7BORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%2CORIGINAL_LINK_RAW_CONSUMING_HISTORICAL_ARTIFACT%2C%0A%20%20ORIGINAL_LINK_RAW_CONSUMING_SUCCESSOR%2CgenerateOriginalLinkRawConsumingEmission%2C%0A%20%20readOriginalLinkRawConsumingOwnerSites%2CreadOriginalLinkRawConsumingProfile%2C%0A%20%20verifyOriginalLinkRawConsumingConservation%7D%20from%20%27.%2Fraw-consuming-emission.mjs%27%3B%0A%0Aconst%20sha256%3Dvalue%3D%3EcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0Alet%20consumingGeneration%3B%0Aconst%20generation%3D%28%29%3D%3EconsumingGeneration%3F%3F%3DgenerateOriginalLinkRawConsumingEmission%28true%29%3B%0A%0Atest%28%27raw%20consuming%20token%20inventories%20ignore%20text%20and%20retain%20actual%20complete%20owner%20interfaces%27%2C%28%29%3D%3E%7B%0A%20%20const%20source%3D%27pub%20fn%20selected%28values%3AVec%3Cf64%3E%29-%3EVec%3Cf64%3E%7Blet%20text%3D%22values.clone%28%29%20crate%3A%3Aml_array%3A%3Aappend%28%22%3Bvalues.clone%28%29%7D%27%3B%0A%20%20const%20sites%3DreadOriginalLinkRawConsumingOwnerSites%28source%29%3B%0A%20%20assert.equal%28sites.target%2C%27selected%27%29%3Bassert.equal%28sites.kind%2C%27fn%27%29%3B%0A%20%20assert.equal%28sites.cloneSites.length%2C1%29%3Bassert.equal%28sites.appendSites.length%2C0%29%3B%0A%20%20assert.equal%28source.slice%28sites.cloneSites%5B0%5D%2Csites.cloneSites%5B0%5D%2B5%29%2C%27clone%27%29%3B%0A%20%20assert.deepEqual%28sites.header%2C%5B%27pub%27%2C%27fn%27%2C%27selected%27%2C%27%28%27%2C%27values%27%2C%27%3A%27%2C%27Vec%27%2C%27%3C%27%2C%27f64%27%2C%27%3E%27%2C%27%29%27%2C%27-%3E%27%2C%27Vec%27%2C%27%3C%27%2C%27f64%27%2C%27%3E%27%5D%29%3B%0A%20%20assert.throws%28%28%29%3D%3EreadOriginalLinkRawConsumingOwnerSites%28source%2B%27%5Cn%27%2Bsource%29%2C%2Fone%20complete%2Fu%29%3B%0A%7D%29%3B%0A%0Atest%28%27raw%20consuming%20emission%20keeps%20all106owners%20and%20both%20complete%20typed%20archives%20without%20changing%20either%20predecessor%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20historical%3DreadFileSync%28ORIGINAL_LINK_RAW_HISTORICAL_ARTIFACT%29%2C%20current%3DreadFileSync%28ORIGINAL_LINK_RAW_CURRENT_ARTIFACT%29%3B%0A%20%20const%20%7Bartifact%2Cprofile%2CcurrentArtifact%2CcurrentDecisionSources%7D%3Dawait%20generation%28%29%3B%0A%20%20assert.deepEqual%28currentArtifact.decisionSources%2CcurrentDecisionSources%2C%27the%20real%20current%20producer%20retains%20its%20physical%20source%20metadata%27%29%3B%0A%20%20assert.deepEqual%28currentDecisionSources%2Cartifact.decisionSources.map%28row%3D%3E%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Brow.file%2Cimport.meta.url%29%29%3B%0A%20%20%20%20return%7Bfile%3Arow.file%2Cbytes%3Abytes.length%2Csha256%3Asha256%28bytes%29%7D%3B%0A%20%20%7D%29%29%3B%0A%20%20assert.notDeepEqual%28currentDecisionSources%2Cartifact.decisionSources%2C%27the%20original%20snapshot%20is%20not%20relabeled%20as%20current%20source%27%29%3B%0A%20%20const%20%7BdecisionSources%3AactualSources%2C...actualSemanticFields%7D%3DcurrentArtifact%3B%0A%20%20const%20%7BdecisionSources%3AsnapshotSources%2C...snapshotSemanticFields%7D%3Dartifact%3B%0A%20%20assert.deepEqual%28actualSemanticFields%2CsnapshotSemanticFields%2C%27every%20actual%20complete%20emission%20archive%20owner%20mapping%20and%20original%20field%20stays%20exact%27%29%3B%0A%20%20assert.deepEqual%28actualSources%2CcurrentDecisionSources%29%3B%0A%20%20assert.equal%28snapshotSources%2Cartifact.decisionSources%29%3B%0A%20%20assert.deepEqual%28readFileSync%28ORIGINAL_LINK_RAW_HISTORICAL_ARTIFACT%29%2Chistorical%29%3B%0A%20%20assert.deepEqual%28readFileSync%28ORIGINAL_LINK_RAW_CURRENT_ARTIFACT%29%2Ccurrent%29%3B%0A%20%20assert.equal%28sha256%28historical%29%2CORIGINAL_LINK_RAW_EMISSION_BASELINE.artifactSha256%29%3B%0A%20%20assert.equal%28sha256%28readProjectData%28ORIGINAL_LINK_RAW_CURRENT_ARTIFACT%29.completeRust%29%2CORIGINAL_LINK_RAW_EMISSION_BASELINE.currentSha256%29%3B%0A%20%20assert.equal%28artifact.definitionCount%2C106%29%3Bassert.equal%28artifact.owners.length%2C106%29%3B%0A%20%20assert.deepEqual%28artifact.owners.map%28owner%3D%3Eowner.fullName%29%2Cartifact.declarationNames%29%3B%0A%20%20assert.deepEqual%28artifact.declarationNames%2CreadProjectData%28ORIGINAL_LINK_RAW_CURRENT_ARTIFACT%29.declarationNames%29%3B%0A%20%20assert.deepEqual%28artifact.options%2C%7BarrayConsumption%3Atrue%7D%29%3B%0A%20%20assert.deepEqual%28artifact.totals%2C%7Bcopy%3A%7BcloneCalls%3A1004%2CappendCalls%3A31%2CconsumingAppendBindings%3A0%7D%2C%0A%20%20%20%20consuming%3A%7BcloneCalls%3A742%2CappendCalls%3A31%2CconsumingAppendBindings%3A25%7D%7D%29%3B%0A%20%20assert.equal%28artifact.sourceBytes%2C351559%29%3B%0A%20%20assert.equal%28artifact.sourceSha256%2C%27b0820a709afb3c66fc88321ceaa84e00baa795b0f07290896db6d00c740d9c7c%27%29%3B%0A%20%20for%28const%20owner%20of%20artifact.owners%29assert.deepEqual%28owner.consuming.header%2Cowner.copy.header%29%3B%0A%20%20assert.deepEqual%28artifact.replays.map%28row%3D%3Erow.format%29%2C%5B%27text%27%2C%27binary%27%5D%29%3B%0A%20%20for%28const%20replay%20of%20artifact.replays%29%7Bassert.equal%28replay.ownerCount%2C106%29