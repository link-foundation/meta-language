tSource%28file%2Cactual.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20%20%20predecessor%3DBuffer.from%28context.predecessor%29%3B%0A%20%20%20%20%20%20if%28context.changed%29contextSuccessors.push%28%7Bfile%2CpredecessorSource%3Acontext.predecessor%2CcurrentSource%3Acontext.current%2Creceipt%3Acontext.receipt%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20let%20original%3Dpredecessor%3B%0A%20%20%20%20if%28pin%28predecessor%29.sha256%21%3D%3Dexpected%29%7B%0A%20%20%20%20%20%20assert.equal%28file%2CnativePath%2C%27only%20the%20original%20native%20diagnostic%20permutation%20changes%20the%20predecessor%27%29%3B%0A%20%20%20%20%20%20assert.equal%28predecessor.toString%28%27utf8%27%29%2Cchecked.corrected%29%3B%0A%20%20%20%20%20%20const%20inverse%3DapplyDiagnosticOrderDecorator%28checked.corrected%2Cdecorator%2C%7Bdirection%3A%27inverse%27%2Crole%3A%27production%27%7D%29%3B%0A%20%20%20%20%20%20original%3DBuffer.from%28inverse.source%29%3B%0A%20%20%20%20%20%20adaptations.push%28%7Bfile%2CsourceView%3A%27historical%20baseline%20plus%20separately%20authenticated%20current%20producer%27%2C%0A%20%20%20%20%20%20%20%20historicalSource%3Ainverse.source%2CcurrentSource%3Achecked.corrected%2CinverseReceipt%3Ainverse.receipt%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28pin%28original%29.sha256%2Cexpected%2C%27all%20thirteen%20original%20source%20pins%20stay%20exact%27%29%3B%0A%20%20%20%20historical.set%28file%2Coriginal%29%3Bpins.push%28%7Bfile%2C...pin%28original%29%7D%29%3BcurrentPins.push%28%7Bfile%2C...pin%28predecessor%29%7D%29%3B%0A%20%20%7D%0A%20%20return%7Bhistorical%2Cpins%2CcurrentPins%2Cadaptations%2CcontextSuccessors%2CcrateRootSuccessors%7D%3B%0A%7D%0A%0Afunction%20currentContextOwnerProof%28successor%2CpredecessorCapture%2Cinputs%2Cdeclarations%29%20%7B%0A%20%20if%28successor.file%3D%3D%3DjavascriptPath%29%7B%0A%20%20%20%20const%20before%3DreadCurrentContextDiagnosticRows%28successor.predecessorSource%29%2Cafter%3DreadCurrentContextDiagnosticRows%28successor.currentSource%29%3B%0A%20%20%20%20assert.equal%28before.length%2C9%29%3Bassert.equal%28after.length%2Cbefore.length%29%3B%0A%20%20%20%20const%20calls%3Dbefore.map%28%28row%2Cindex%29%3D%3E%7B%0A%20%20%20%20%20%20const%20current%3Dafter%5Bindex%5D%2Csource%3DBuffer.from%28successor.predecessorSource%29.subarray%28row.call.span.start%2Crow.call.span.end%29.toString%28%29%3B%0A%20%20%20%20%20%20assert.equal%28Buffer.from%28successor.currentSource%29.subarray%28current.call.span.start%2Ccurrent.call.span.end%29.toString%28%29%2Csource%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28current.keys%2Crow.keys%29%3Bassert.equal%28current.reason%2Crow.reason%29%3Bassert.equal%28current.detail%2Crow.detail%29%3B%0A%20%20%20%20%20%20return%7Bsource%2Ckeys%3Arow.keys%2Creason%3Arow.reason%2Cdetail%3Arow.detail%2ChistoricalCall%3Arow.call%2CcurrentCall%3Acurrent.call%7D%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20return%7BdiagnosticCalls%3Acalls%2Cconclusion%3A%27All%20nine%20complete%20current%20diagnostic%20calls%20preserve%20every%20field%20value%20spelling%20and%20its%20order.%27%7D%3B%0A%20%20%7D%0A%20%20assert.equal%28successor.file%2CnativePath%29%3B%0A%20%20%2F%2F%20Cache%20only%20complete%20immutable%20inputs.%20Every%20caller%20field%20participates%20in%0A%20%20%2F%2F%20the%20key%2C%20and%20returned%20proofs%20are%20copies.%20Retain%20at%20most%20two%20input%20versions.%0A%20%20const%20key%3Dcanonical%28%7Bsource%3Asuccessor.currentSource%2Cinputs%3Ainputs.filter%28row%3D%3Erow.file%3D%3D%3DnativePath%29%2Cdeclarations%3Adeclarations.filter%28row%3D%3Erow.file%3D%3D%3DnativePath%29%7D%29%3B%0A%20%20if%28nativeOwnerProofs.has%28key%29%29return%20copy%28nativeOwnerProofs.get%28key%29%29%3B%0A%20%20const%20capture%3D%7B...predecessorCapture%2Cadaptations%3ApredecessorCapture.adaptations.map%28row%3D%3Erow.file%3D%3D%3DnativePath%3F%7B...row%2CcurrentSource%3Asuccessor.currentSource%7D%3Arow%29%7D%3B%0A%20%20const%20actual%3DfinalizePredecessorSourceViews%28capture%2Cinputs%2Cdeclarations%29.adaptations.find%28row%3D%3Erow.file%3D%3D%3DnativePath%29%3B%0A%20%20assert.ok%28actual%2C%27a%20native%20successor%20requires%20its%20exact%20original%20diagnostic%20predecessor%27%29%3B%0A%20%20const%7Bimports%2CselectedDeclarations%7D%3Dactual.currentSourceProof%3B%0A%20%20const%20result%3D%7Bimports%2CselectedDeclarations%2Cconclusion%3A%27Every%20actual%20current%20native%20import%2C%20selected%20complete%20type%20declaration%20and%20original%20byte%20interval%20remains%20exact%20after%20context%20reuse.%27%7D%3B%0A%20%20if%28nativeOwnerProofs.size%3D%3D%3D2%29nativeOwnerProofs.delete%28nativeOwnerProofs.keys%28%29.next%28%29.value%29%3B%0A%20%20nativeOwnerProofs.set%28key%2Ccopy%28result%29%29%3Breturn%20copy%28result%29%3B%0A%7D%0A%0A%2F%2A%2A%20Schema%20two%20retains%20the%20complete%20schema-one%20predecessor%20and%20adds%20distinct%0A%20%2A%20current%20bytes%2C%20receipts%20and%20actual%20CST%20owner%20proofs.%20Frozen%20overlay%20output%0A%20%2A%20remains%20the%20original%20diagnostic%20permutation%20rather%20than%20the%20new%20producer.%20%2A%2F%0Afunction%20finalizeContextSourceViews%28capture%2Cinputs%2Cdeclarations%29%20%7B%0A%20%20const%20predecessorView%3DfinalizePredecessorSourceViews%28capture%2Cinputs%2Cdeclarations%29%3B%0A%20%20if%28%21capture.contextSuccessors%3F.length%29return%20predecessorView%3B%0A%20%20const%20currentPins%3Dcopy%28predecessorView.currentPins%29%2Csuccessors%3D%5B%5D%3B%0A%20%20for%28const%20successor%20of%20capture.contextSuccessors%29%7B%0A%20%20%20%20const%20context%3DrestoreGlobalGrammarContextSource%28successor.file%2Csuccessor.currentSource%29%3Bassert.equal%28context.changed%2Ctrue%29%3B%0A%20%20%20%20assert.equal%28context.predecessor%2Csuccessor.predecessorSource%29%3BcheckGlobalGrammarContextSourceReceipt%28successor.file%2Csuccessor.currentSource%2Csuccessor.receipt%29%3B%0A%20%20%20%20const%20current%3DcurrentPins.find%28row%3D%3Erow.file%3D%3D%3Dsuccessor.file%29%3Bassert.ok%28current%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Acurrent.bytes%2Csha256%3Acurrent.sha256%7D%2Cpin%28context.predecessor%29%29%3B%0A%20%20%20%20Object.assign%28current%2Cpin%28context.current%29%29%3B%0A%20%20%20%20successors.push%28%7B...copy%28successor%29%2CcurrentSourceProof%3AcurrentContextOwnerProof%28successor%2Ccapture%2Cinputs%2Cdeclarations%29%7D%29%3B%0A%20%20%7D%0A%20%20assert.ok%28successors.length%3C%3D2%29%3Bassert.equal%28new%20Set%28successors.map%28row%3D%3Erow.file%29%29.size%2Csuccessors.length%29%3B%0A%20%20return%7BschemaVersion%3A2%2Cprofile%3A%27complete%20current%20grammar%20context%20source%20views%201%27%2ChistoricalPins%3Acopy%28predecessorView.historicalPins%29%2CcurrentPins%2C%0A%20%20%20%20predecessorView%2Csuccessors%2Cboundary%3A%27The%20complete%20original%20source%20profile%20remains%20mandatory.%20Actual%20successors%20have%20separate%20whole-source%20receipts%20and%20current%20CST%20proofs%3B%20frozen%20overlay%20identities%20and%20observations%20remain%20separate.%27%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Historical%20archives%20keep%20their%20exact%20original%20validator.%20Current%20archives%0A%20%2A%20must%20reproduce%20both%20complete%20profiles%20and%20every%20current%20owner%20proof.%20%2A%2F%0Afunction%20checkContextSourceViews%28inventory%2Cdecorator%29%20%7B%0A%20%20const%20view%3Dinventory.sourceViews%3B%0A%20%20if%28view%3F.schemaVersion%3D%3D%3D1%29return%20checkPredecessorSourceViews%28inventory%2Cdecorator%29%3B%0A%20%20assert.equal%28view%3F.schemaVersion%2C2%29%3BauthenticateCurrentContextDecorator%28decorator%29%3B%0A%20%20const%20predecessor%3DcheckPredecessorSourceViews%28%7B...inventory%2CsourceViews%3Aview.predecessorView%7D%2Cdecorator%29%3B%0A%20%20assert.deepEqual%28view.historicalPins%2Cpredecessor.historicalPins%29%3B%0A%20%20assert.ok%28Array.isArray%28view.successors%29%26%26view.successors.length%3E0%26%26view.successors.length%3C%3D2%29%3B%0A%20%20assert.equal%28new%20Set%28view.successors.map%28row%3D%3Erow.file%29%29.size%2Cview.successors.length%29%3B%0A%20%20const%20capture%3D%7Bpins%3Apredecessor.historicalPins%2CcurrentPins%3Apredecessor.currentPins%2Cadaptations%3Apredecessor.adaptations%2C%0A%20%20%20%20contextSuccessors%3Aview.successors.map%28%28%7Bfile%2CpredecessorSource%2CcurrentSource%2Creceipt%7D%29%3D%3E%28%7Bfile%2CpredecessorSource%2CcurrentSource%2Creceipt%7D%29%29%7D%3B%0A%20%20const%20expected%3DfinalizeContextSourceViews%28capture%2Cinventory.inputs%2Cinventory.declarations%29%3B%0A%20%20assert.equal%28canonical%28view%29%2Ccanonical%28expected%29%2C%27complete%20original%20and%20current%20context%20source%20conservation%27%29%3B%0A%20%20return%20copy%28expected%29%3B%0A%7D%0A%0A%0A%2F%2A%2A%20The%20crate-root%20successor%20wraps%20the%20complete%20preceding%20context%20profile%3B%20no%20original%20gate%20is%20broadened.%20%2A%2F%0Aexport%20function%20finalizeOutcomeSourceViews%28capture%2Cinputs%2Cdeclarations%29%20%7B%0A%20%20const%20predecessor%3DfinalizeContextSourceViews%28capture%2Cinputs%2Cdeclarations%29%2Csuccessors%3Dcapture.crateRootSuccessors%3F%3F%5B%5D%3B%0A%20%20assert.ok%28Array.isArray%28successors%29%26%26successors.length%3C%3D1%29%3B%0A%20%20return%20successors.length%3FfinalizeOutcomeCrateRootSourceView%28predecessor%2Csuccessors%5B0%5D%29%3Apredecessor%3B%0A%7D%0A%0Aexport%20function%20checkOutcomeSourceViews%28inventory%2Cdecorator%29%20%7B%0A%20%20const%20view%3Dinventory.sourceViews%3B%0A%20%20if%28view%3F.schemaVersion%21%3D%3D3%29return%20checkContextSourceViews%28inventory%2Cdecorator%29%3B%0A%20%20const%20predecessor%3DcheckContextSourceViews%28%7B...inventory%2CsourceViews%3Aview.predecessorView%7D%2Cdecorator%29%3B%0A%20%20const%20expected%3DfinalizeOutcomeCrateRootSourceView%28predecessor%2Cview.crateRootSuccessor%29%3B%0A%20%20assert.equal%28canonical%28view%29%2Ccanonical%28expected%29%2C%27complete%20original%20context%20and%20current%20crate-root%20source%20conservation%27%29%3B%0A%20%20return%20copy%28expected%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
