%20%22currentBytes%22%3A%2026599%2C%0A%20%20%20%20%22currentSha256%22%3A%20%224d7edc5f126877eaa272edabe6c2bd10dc38771bb4cb18c244434fdf98ee93ea%22%0A%20%20%7D%0A%5D%3B%0Aconst%20decisionSource%3D%7B%0A%20%20%22path%22%3A%20%22js%2Fsrc%2Fboolean-declaration-value-rules.js%22%2C%0A%20%20%22sha256%22%3A%20%22fd2a568833e7d0e607bd86400781f17b37b64963e7ec3fc63591b15d836938a9%22%0A%7D%3B%0Aconst%20registrations%3D%5B%7Bpath%3A%27rust%2Fsrc%2Ftranslation%2Fmod.rs%27%2Cdeclaration%3A%27pub%28crate%29%20mod%20boolean_declaration_value_rules%3B%27%7D%5D%3B%0Aconst%20digest%3Dsource%3D%3EcreateHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%3B%0Afunction%20sourcePin%28source%2Cbytes%2Csha256%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28Buffer.from%28source%29.toString%28%27utf8%27%29%2Csource%29%3B%0A%20%20assert.equal%28Buffer.byteLength%28source%29%2Cbytes%29%3Bassert.equal%28digest%28source%29%2Csha256%29%3B%0A%7D%0A%0A%2F%2A%2A%20Verify%20complete%20certified%20predecessors%2C%20reviewed%20successors%20and%20exact%20inverses.%0A%20%2A%20No%20repository%20state%2C%20subprocess%2C%20native%20parser%20or%20native%20compiler%20is%20read.%20%2A%2F%0Aexport%20function%20verifyBooleanDeclarationValueHosts%28archive%29%7B%0A%20%20assert.equal%28archive.schemaVersion%2C1%29%3B%0A%20%20assert.equal%28archive.model%2C%27Boolean%20function%20declaration%20value%20host%20replay%201%27%29%3B%0A%20%20assert.equal%28archive.revision%2Crevision%29%3B%0A%20%20assert.equal%28archive.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20assert.deepEqual%28archive.hosts.map%28row%3D%3Erow.path%29%2Chosts.map%28row%3D%3Erow.path%29%29%3B%0A%20%20assert.deepEqual%28archive.decisionSource%2CdecisionSource%29%3B%0A%20%20assert.deepEqual%28archive.registrations%2Cregistrations%29%3B%0A%20%20const%20files%3D%5B%5D%3B%0A%20%20for%28const%20%5Bindex%2Crow%5Dof%20archive.hosts.entries%28%29%29%7B%0A%20%20%20%20const%20expected%3Dhosts%5Bindex%5D%3B%0A%20%20%20%20sourcePin%28row.source%2Cexpected.predecessorBytes%2Cexpected.predecessorSha256%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%2Cpath%3Arow.path%7D%29%3B%0A%20%20%20%20assert.equal%28row.currentBytes%2Cexpected.currentBytes%29%3Bassert.equal%28row.currentSha256%2Cexpected.currentSha256%29%3B%0A%20%20%20%20assert.ok%28Array.isArray%28row.edits%29%26%26row.edits.length%3E0%29%3B%0A%20%20%20%20let%20current%3Drow.source%3B%0A%20%20%20%20for%28const%20edit%20of%20row.edits%29%7B%0A%20%20%20%20%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%26%26edit.start%3E%3D0%26%26edit.start%3C%3Dcurrent.length%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20edit.removed%2C%27string%27%29%3Bassert.equal%28typeof%20edit.inserted%2C%27string%27%29%3B%0A%20%20%20%20%20%20assert.notEqual%28edit.removed%2Cedit.inserted%29%3B%0A%20%20%20%20%20%20assert.equal%28current.slice%28edit.start%2Cedit.start%2Bedit.removed.length%29%2Cedit.removed%29%3B%0A%20%20%20%20%20%20current%3Dcurrent.slice%280%2Cedit.start%29%2Bedit.inserted%2Bcurrent.slice%28edit.start%2Bedit.removed.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20sourcePin%28current%2Cexpected.currentBytes%2Cexpected.currentSha256%29%3B%0A%20%20%20%20let%20inverse%3Dcurrent%3B%0A%20%20%20%20for%28const%20edit%20of%20archive.hosts%5Bindex%5D.edits.toReversed%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2Crow.source%2C%27every%20original%20source%20byte%20and%20old%20wrapper%20branch%20remains%20recoverable%27%29%3B%0A%20%20%20%20files.push%28%7Bpath%3Arow.path%2Csource%3Acurrent%2Cpredecessor%3Arow.source%7D%29%3B%0A%20%20%7D%0A%20%20return%20files%3B%0A%7D%0A%0A%2F%2A%2A%20Rebuild%20only%20three%20recorded%20host%20transports%3B%20actual%20native%20execution%20is%20CI-only.%20%2A%2F%0Aexport%20function%20generateBooleanDeclarationValueHosts%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%7B%0A%20%20const%20archive%3DreadProjectData%28new%20URL%28%27parity%2Fself-translation%2Fboolean-declaration-value-hosts.lino%27%2Croot%29%29%3B%0A%20%20const%20files%3DverifyBooleanDeclarationValueHosts%28archive%29%3B%0A%20%20assert.equal%28digest%28readFileSync%28new%20URL%28decisionSource.path%2Croot%29%29%29%2CdecisionSource.sha256%29%3B%0A%20%20for%28const%20row%20of%20registrations%29assert.equal%28readFileSync%28new%20URL%28row.path%2Croot%29%2C%27utf8%27%29.split%28row.declaration%29.length%2C2%29%3B%0A%20%20%2F%2F%20Validate%20every%20destination%20before%20the%20first%20possible%20source%20write.%0A%20%20for%28const%20row%20of%20files%29%7B%0A%20%20%20%20const%20file%3Dnew%20URL%28row.path%2Croot%29%3B%0A%20%20%20%20if%28check%29assert.equal%28readFileSync%28file%2C%27utf8%27%29%2Crow.source%2Crow.path%29%3B%0A%20%20%20%20else%20if%28existsSync%28file%29%29%7B%0A%20%20%20%20%20%20const%20actual%3DreadFileSync%28file%2C%27utf8%27%29%3B%0A%20%20%20%20%20%20assert.ok%28actual%3D%3D%3Drow.source%7C%7Cactual%3D%3D%3Drow.predecessor%2C%27unknown%20host%20source%20%27%2Brow.path%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20if%28%21check%29for%28const%20row%20of%20files%29writeFileSync%28new%20URL%28row.path%2Croot%29%2Crow.source%29%3B%0A%20%20return%20%7Barchive%2Cfiles%7D%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28args.length%3C%3D1%26%26args.every%28arg%3D%3Earg%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20result%3DgenerateBooleanDeclarationValueHosts%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28JSON.stringify%28%7Brevision%2Chosts%3Aresult.files.map%28row%3D%3Erow.path%29%2CnativeCompilation%3Afalse%2CnativeExecution%3Afalse%7D%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
