s%20select%20a%20covered%20Node%20runtime%20and%20keep%20the%20complete%20current%20and%20old%20declaration%20hosts%27%2C%28%29%3D%3E%7B%0A%20%20const%5Bmajor%2Cminor%5D%3Dprocess.versions.node.split%28%27.%27%29.map%28Number%29%3B%0A%20%20assert.ok%28major%3D%3D%3D22%26%26minor%3E%3D15%7C%7Cmajor%3D%3D%3D24%2C%27uncovered%20Node%20%27%2Bprocess.versions.node%2B%27%3B%20%3E%3D22.15%20%3C23%20%7C%7C%20%3E%3D24%20%3C25%20required%27%29%3B%0A%20%20const%20packet%3DreadScopedIterationNativeHostSourceHistory%28%29%2Cspecification%3DSCOPED_ITERATION_NATIVE_SOURCE%3B%0A%20%20assert.equal%28packet.current.source%2Cread%28specification.file%29.toString%28%27utf8%27%29%29%3B%0A%20%20assert.equal%28packet.current.bytes-packet.previous.bytes%2C57%29%3B%0A%20%20assert.equal%28restoreScopedIterationNativeHostSource%28packet.current.source%2Cspecification.file%2C%27required%20field%20native%20host%27%29%2Cpacket.previous.source%29%3B%0A%20%20const%20old%3DreadRequiredFieldNativeHostSuccession%28%29.sources.find%28row%3D%3Erow.file%3D%3D%3Dspecification.file%29%3Bassert.ok%28old%29%3B%0A%20%20assert.equal%28packet.previous.source%2Cold.current.source%2C%27the%20whole%20old%20required-field%20input%20remains%20independently%20exact%27%29%3B%0A%20%20const%20current%3DreadCurrentNativeHostSourceHistory%28%29%3Bassert.equal%28current.sources.length%2C4%29%3B%0A%20%20assert.equal%28current.sources.some%28row%3D%3Erow.file%3D%3D%3Dspecification.file%29%2Cfalse%2C%27the%20original%20four-source%20packet%20does%20not%20acquire%20an%20extra%20path%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27unregistered%20readers%20changed%20source%20bytes%20and%20forged%20coherent%20memberships%20retain%20original%20refusals%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DreadScopedIterationNativeHostSourceHistory%28%29%2Cfile%3DSCOPED_ITERATION_NATIVE_SOURCE.file%3B%0A%20%20for%28const%20reader%20of%20%5B%27%27%2C%20%27current%20behavior%27%2C%27ASCII%20character%20host%27%2C%27program%20string%20registration%27%5D