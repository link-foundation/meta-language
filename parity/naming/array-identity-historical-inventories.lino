elativeArrayFrontendDescriptorSource%28source%2Cfile%2Cprofile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bassert.equal%28typeof%20profile%2C%27string%27%29%3B%0A%20%20source%3DrestoreRelativeArrayCurrentSourceView%28source%2Cfile%2Cprofile%29%3B%0A%20%20source%3DrestoreRelativeArrayCurrentFrontendSource%28source%2Cfile%2Cprofile%29%3B%0A%20%20const%20policy%3DreadOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20if%28profile%21%3D%3DRELATIVE_ARRAY_FRONTEND_PROFILE%29return%20source%3B%0A%20%20if%28file%3D%3D%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.path%29%7B%0A%20%20%20%20const%20history%3DreadRelativeArrayFrontendSourceHistory%28%29%2Cprevious%3Dhistory.nullableInference.sourceText%3B%0A%20%20%20%20if%28source%3D%3D%3Dprevious%29return%20source%3B%0A%20%20%20%20assert.deepEqual%28relativeArrayFrontendPin%28source%29%2CRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.current%2C%27an%20unknown%20nullable-inference%20successor%20has%20no%20relative-array%20historical%20authority%27%29%3B%0A%20%20%20%20assert.equal%28source%2CreplayRelativeArrayNullableInference%28previous%29.source%2C%27the%20complete%20current%20nullable-inference%20source%20has%20one%20certified%20finite%20inverse%27%29%3B%0A%20%20%20%20return%20previous%3B%0A%20%20%7D%0A%20%20if%28file%21%3D%3Dpolicy.sourceFile%29return%20source%3B%0A%20%20const%20history%3DreadRelativeArrayFrontendSourceHistory%28%29%2Cprevious%3Dhistory.historical.sourceText%3B%0A%20%20if%28source%3D%3D%3Dprevious%29return%20source%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28source%29%2Cpolicy.sourceOwner.current%2C%27an%20unknown%20frontend%20successor%20has%20no%20relative-array%20historical%20authority%27%29%3B%0A%20%20assert.equal%28source%2CreadAuthenticatedCurrentRelativeArrayFrontend%28%29%2C%27the%20actual%20complete%20current%20frontend%20is%20authenticated%20through%20its%20existing%20source%20receipt%27%29%3B%0A%20%20return%20previous%3B%0A%7D