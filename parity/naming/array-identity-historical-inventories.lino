iews%5Bindex%5D%3BexactKeys%28view%2C%5B%27inventory%27%2C%27file%27%2C%27names%27%2C%27current%27%2C%27predecessor%27%5D%29%3B%0A%20%20%20%20for%28const%20key%20of%20%5B%27inventory%27%2C%27file%27%2C%27names%27%2C%27current%27%5D%29assert.deepEqual%28view%5Bkey%5D%2Cexpected%5Bkey%5D%29%3B%0A%20%20%20%20exactKeys%28view.predecessor%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20assert.equal%28typeof%20view.predecessor.source%2C%27string%27%29%3B%0A%20%20%20%20const%20bytes%3DBuffer.from%28view.predecessor.source%29%3Bassert.equal%28bytes.toString%28%27utf8%27%29%2Cview.predecessor.source%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28bytes%29%2C%7Bbytes%3Aview.predecessor.bytes%2Csha256%3Aview.predecessor.sha256%7D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28view.predecessor.certificate%2Cbytes%2C%7Brevision%3Apolicy.revision%2Cpath%3Aview.file%7D%29%3B%0A%20%20%7D%0A%20%20exactKeys%28history.driver%2C%5B%27file%27%2C%27original%27%2C%27current%27%2C%27edits%27%2C%27source%27%2C%27certificate%27%5D%29%3B%0A%20%20for%28const%20key%20of%20%5B%27file%27%2C%27original%27%2C%27current%27%2C%27edits%27%5D%29assert.deepEqual%28history.driver%5Bkey%5D%2Cpolicy.driver%5Bkey%5D%29%3B%0A%20%20assert.equal%28typeof%20history.driver.source%2C%27string%27%29%3B%0A%20%20assert.deepEqual%28pin%28history.driver.source%29%2Cpolicy.driver.original%29%3B%0A%20%20verifyGitArtifactCertificate%28history.driver.certificate%2CBuffer.from%28history.driver.source%29%2C%7Brevision%3Apolicy.revision%2Cpath%3Apolicy.driver.file%7D%29%3B%0A%20%20let%20current%3Dhistory.driver.source%3B%0A%20%20for%28const%20edit%20of%20policy.driver.edits%29%7Bassert.equal%28current.split%28edit.before%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28edit.before%2C%28%29%3D%3Eedit.after%29%3B%7D%0A%20%20assert.deepEqual%28pin%28current%29%2Cpolicy.driver.current%29%3B%0A%20%20let%20inverse%3Dcurrent%3B%0A%20%20for%28const%20edit%20of%20policy.driver.edits.toReversed%28%29%29%7Bassert.equal%28inverse.split%28edit.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28edit.after%2C%28%29%3D%3Eedit.before%29%3B%7D%0A%20%20assert.equal%28inverse%2Chistory.driver.source%2C%27every%20original%20driver%20byte%20and%20unchanged%20policy%20call%20remains%20recoverable%27%29%3B%0A%20%20return%20history%3B%0A%7D%0A%0A%2F%2A%2A%20Bootstrap%20decoding%20avoids%20retaining%20a%20second%20full%20graph%20in%20the%20normal%20check.%20%2A%2F%0Aexport%20function%20readOwnCodebaseHistoricalNamingSources%28%29%7B%0A%20%20const%20file%3Dnew%20URL%28%27..%2F..%2Fparity%2Fnaming%2Fown-codebase-baseline-naming-history.lino%27%2Cimport.meta.url%29%3B%0A%20%20const%20text%3DreadFileSync%28file%2C%27utf8%27%29%3B%0A%20%20if%28originalSnapshot%3F.text%21%3D%3Dtext%29%7BoriginalSnapshot%3Dundefined%3BoriginalSnapshot%3D%7Btext%2Cvalue%3AverifyOwnCodebaseHistoricalNamingSources%28readBootstrapStructuredDataLino%28text%29%29%7D%3B%7D%0A%20%20return%20structuredClone%28originalSnapshot.value%29%3B%0A%7D%0A%0A%2F%2A%2A%20Supplement%20only%20two%20original%20inventories%20after%20authenticating%20current%20modules.%20%2A%2F%0Aexport%20function%20extractOwnCodebaseHistoricalNames%28root%2Cinventories%2Chistory%3DreadOwnCodebaseHistoricalNamingSources%28%29%29%7B%0A%20%20verifyOwnCodebaseHistoricalNamingSources%28history%29%3B%0A%20%20assert.deepEqual%28pin%28readFileSync%28resolve%28root%2Cpolicy.driver.file%29%29%29%2Cpolicy.driver.current%2C%27the%20entire%20naming%20driver%20has%20its%20reviewed%20additive%20source%20view%27%29%3B%0A%20%20const%20names%3D%5B%5D%3B%0A%20%20for%28const%20view%20of%20history.views%29%7B%0A%20%20%20%20assert.deepEqual%28pin%28readFileSync%28resolve%28root%2Cview.file%29%29%29%2Cview.current%2C%27unknown%20complete%20current%20source%20cannot%20acquire%20historical%20naming%20authority%27%29%3B%0A%20%20%20%20const%20entries%3Dinventories.filter%28entry%3D%3Eentry.inventory%3D%3D%3Dview.inventory%26%26entry.files.length%3D%3D%3D1%26%