e%2C%27children%27%29%3Bassert.equal%28tokens%5Bindex%2B4%5D.kind%2C%27string%27%29%3B%0A%20%20%20%20const%20reference%3Dtokens%5Bindex%2B4%5D.value%2Cexpected%3DbyId.get%28reference%29%3Bassert.ok%28expected%29%3B%0A%20%20%20%20assert.equal%28tokens%5Bindex%2B6%5D.value%2Cexpected.storage.carrier%29%3B%0A%20%20%20%20assert.equal%28tokens%5Bindex%2B8%5D%3F.value%3D%3D%3D%27boxed%27%2Cexpected.storage.boxed%29%3B%0A%20%20%20%20return%5Breference%5D%3B%0A%20%20%7D%29%3B%0A%20%20assert.deepEqual%28calls%2Creferences%2C%27each%20actual%20source%20child%20is%20consumed%20exactly%20once%20in%20source%20order%27%29%3B%0A%20%20const%20initializers%3Dtokens.flatMap%28%28token%2Cindex%29%3D%3Etoken.kind%3D%3D%3D%27identifier%27%26%26tokens%5Bindex%2B1%5D%3F.value%3D%3D%3D%27%3A%27%26%26%2F%5Efield_%5B0-9%5D%2B%24%2Fu.test%28tokens%5Bindex%2B2%5D%3F.value%3F%3F%27%27%29%3F%5B%5Btoken.value%2Ctokens%5Bindex%2B2%5D.value%5D%5D%3A%5B%5D%29%3B%0A%20%20assert.deepEqual%28initializers%2Cfields.map%28%28field%2Cindex%29%3D%3E%5Bfield.name%2C%27field_%27%2Bindex%5D%29%2C%27every%20actual%20native%20field%20receives%20its%20own%20complete%20source-qualified%20operand%27%29%3B%0A%7D%0Afunction%20checkNativeConstructorControl%28inventory%2Crecipe%29%20%7B%0A%20%20const%20byId%3Dnew%20Map%28inventory.operations.map%28row%3D%3E%5Brow.sourceReference%2Crow%5D%29%29%2Cpending%3D%5Brecipe%5D%3Blet%20count%3D0%3B%0A%20%20while%28pending.length%29%7B%0A%20%20%20%20const%20current%3Dpending.pop%28%29%3Bassert.ok%28%2B%2Bcount%3C%3D100000%29%3Bconst%20operation%3DbyId.get%28current.reference%29%3Bassert.ok%28operation%29%3B%0A%20%20%20%20assert.deepEqual%28Object.keys%28current%29%2C%5B%27reference%27%2C%27choice%27%2C%27children%27%2C%27scalar%27%5D%29%3Bassert.ok%28Array.isArray%28current.children%29%29%3B%0A%20%20%20%20let%20references%3D%5B%5D%3B%0A%20%20%20%20if%28operation.variants%29%7Bconst%20variant%3Doperation.variants.find%28row%3D%3Erow.identity%3D%3D%3Dcurrent.choice%29%3Bassert.ok%28variant%29%3Breferences%3D%28variant.fields%3F%3Fvariant.tuple%29.map%28row%3D%3Erow.typeReference%29%3B%7D%0A%20%20%20%20else%20if%28operation.form%3D%3D%3D%27Option%27%29%7Bassert.ok%28%5B%27Some%27%2C%27None%27%5D.includes%28current.choice%29%29%3Breferences%3Dcurrent.choice%3D%3D%3D%27Some%27%3Foperation.arguments%3A%5B%5D%3B%7D%0A%20%20%20%20else%7B%0A%20%20%20%20%20%20assert.equal%28current.choice%2C%27%27%29%3B%0A%20%20%20%20%20%20if%28operation.fields%29references%3Doperation.fields.map%28row%3D%3Erow.typeReference%29%3B%0A%20%20%20%20%20%20else%20if%28%5B%27named%27%2C%27type_item%27%2C%27Box%27%2C%27reference%27%5D.includes%28operation.form%29%29references%3D%5Boperation.child%3F%3Foperation.arguments%5B0%5D%5D%3B%0A%20%20%20%20%20%20else%20if%28operation.form%3D%3D%3D%27Vec%27%29references%3Dcurrent.children.map%28%28%29%3D%3Eoperation.arguments%5B0%5D%29%3B%0A%20%20%20%20%20%20else%20if%28operation.form%3D%3D%3D%27IndexMap%27%29%7Bassert.equal%28current.children.length%252%2C0%29%3Breferences%3Dcurrent.children.map%28%28_%2Cindex%29%3D%3Eoperation.arguments%5Bindex%252%5D%29%3B%7D%0A%20%20%20%20%7D%0A%20%20%20%20assert.deepEqual%28current.children.map%28row%3D%3Erow.reference%29%2Creferences%29%3B%0A%20%20%20%20if%28%5B%27bool%27%2C%27usize%27%2C%27i64%27%2C%27String%27%2C%27str%27%2C%27json%27%2C%27reference%27%5D.includes%28operation.form%29%29%7B%0A%20%20%20%20%20%20assert.ok%28current.scalar%29%3Bassert.deepEqual%28Object.keys%28current.scalar%29%2C%5B%27kind%27%2C%27value%27%5D%29%3Bassert.equal%28current.scalar.kind%2Coperation.storage.carrier%29%3B%0A%20%20%20%20%20%20if%28operation.form%3D%3D%3D%27bool%27%29assert.equal%28typeof%20current.scalar.value%2C%27boolean%27%29%3B%0A%20%20%20%20%20%20if%28%5B%27String%27%2C%27str%27%2C%27reference%27%5D.includes%28operation.form%29%29assert.equal%28typeof%20current.scalar.value%2C%27string%27%29%3B%0A%20%20%20%20%20%20if%28%5B%27usize%27%2C%27i64%27%5D.includes%28operation.form%29%29%7Bassert.match%28current.scalar.value%2C%2F%5E-%3F%28%3F%3A0%7C%5B1-9%5D%5B0-9%5D%2A%29%24%2Fu%29%3Bconst%20value%3DBigInt%28current.scalar.value%29%3Bassert.ok%28value%3E%3D%20%28operation.form%3D%3D%3D%27i64%27%3F-%281n%3C%3C63n%29%3A0n%29%26%26value%3C%28operation.form%3D%3D%3D%27i64%27%3F1n%3C%3C63n%3A1n%3C%3C32n%29%29%3B%7D%0A%20%20%20%20%20%20if%28operation.form%3D%3D%3D%27reference%27%29assert.equal%28current.scalar.value%2Ccurrent.children%5B0%5D.scalar.value%29%3B%0A%20%20%20%20%7Delse%20assert.equal%28current.scalar%2Cnull%29%3B%0A%20%20%20%20pending.push%28...current.children%29%3B%0A%20%20%7D%0A%20%20return%20count%3B%0A%7D%0A%0Atest%28%27all%20actual%20source%20declarations%20and%20every%20source%20type%20occurrence%20retain%20complete%20deterministic%20native%20storage%20generation%27%2C%28%29%3D%3E%7B%0A%20%20const%20result%3DnativeConstructorContext%28%29%2Cinventory%3Dresult.inventory%3B%0A%20%20assert.equal%28inventory.roots.length%2C9%29%3Bassert.equal%28inventory.operations.length%2C120%29%3Bassert.equal%28result.outputs.length%2C6%29%3B%0A%20%20assert.equal%28new%20Set%28inventory.operations.map%28row%3D%3Erow.sourceReference%29%29.size%2Cinventory.operations.length%29%3B%0A%20%20for%28const%20output%20of%20result.outputs%29%7Bconst%20bytes%3DreadFileSync%28new%20URL%28output.file%2Croot%29%29%3Bassert.equal%28bytes.length%2Coutput.bytes%29%3Bassert.equal%28createHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%2Coutput.sha256%29%3B%7D%0A%20%20assert.match%28inventory.boundary%2C%2Fdoes%20not%20validate%20a%20complete%20owned%20model%2Fu%29%3B%0A%20%20assert.ok%28inventory.operations.some%28row%3D%3Erow.form%3D%3D%3D%27reference%27%29%29%3B%0A%20%20assert.ok%28inventory.operations.filter%28row%3D%3Erow.storage.carrier%3D%3D%3D%27Text%27%29.length%3E1%2C%27native%20storage%20sharing%20preserves%20independently%20qualified%20source%20types%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27every%20native%20constructor%20conserves%20actual%20field%20bindings%20child%20order%20source%20qualifiers%20and%20complete%20variant%20choices%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Binventory%2Coutputs%7D%3DnativeConstructorContext%28%29%2CbyId%3Dnew%20Map%28inventory.operations.map%28row%3D%3E%5Brow.sourceReference%2Crow%5D%29%29%3B%0A%20%20const%20texts%3Dnew%20Map%28outputs.map%28row%3D%3E%5Brow.file.split%28%27%2F%27%29.at%28-1%29%2CreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%5D%29%29%3B%0A%20%20for%28const%20text%20of%20texts.values%28%29%29%7Bconst%20tree%3DparseNative%28%27native-rust%27%2Ctext%29%3Bassert.equal%28tree.hasError%2Cfalse%29%3Bassert.equal%28tree.start%2C0%29%3Bassert.equal%28tree.end%2CBuffer.byteLength%28text%29%29%3B%7D%0A%20%20for%28let%20index%3D0%3Bindex%3Cinventory.operations.length%3Bindex%2B%2B%29%7B%0A%20%20%20%20const%20operation%3Dinventory.operations%5Bindex%5D%2Ctext%3Dtexts.get%28%27part_%27%2BMath.floor%28index%2F24%29%2B%27.rs%27%29%3B%0A%20%20%20%20const%20source%3DreadSourceTextRustBlock%28text%2C%27fn%27%2C%27construct_%27%2Bindex%29%3B%0A%20%20%20%20let%20references%3Doperation.fields%3F.map%28row%3D%3Erow.typeReference%29%3F%3F%28%5B%27named%27%2C%27type_item%27%2C%27reference%27%5D.includes%28operation.form%29%3F%5Boperation.child%5D%3Aoperation.arguments%3F%3F%5B%5D%29%3B%0A%20%20%20%20if%28operation.variants%29references%3D%5B%5D%3B%0A%20%20%20%20checkNativeConstructorSourceBindings%28source%2Coperation.fields%3F%3F%5B%5D%2Creferences%2CbyId%29%3B%0A%20%20%20%20for%28let%20variantIndex%3D0%3BvariantIndex%3C%28operation.variants%3F.length%3F%3F0%29%3BvariantIndex%2B%2B%29%7B%0A%20%20%20%20%20%20const%20variant%3Doperation.variants%5BvariantIndex%5D%2Cfields%3Dvariant.fields%3F%3Fvariant.tuple%3B%0A%20%20%20%20%20%20assert.ok%28source.includes%28JSON.stringify%28variant.identity%29%29%29%3B%0A%20%20%20%20%20%20const%20body%3DreadSourceTextRustBlock%28text%2C%27fn%27%2C%27construct_variant_%27%2Bindex%2B%27_%27%2BvariantIndex%29%3B%0A%20%20%20%20%20%20checkNativeConstructorSourceBindings%28body%2Cvariant.fields%3F%3F%5B%5D%2Cfields.map%28row%3D%3Erow.typeReference%29%2CbyId%29%3B%0A%20%20%20%20%20%20assert.ok%28body.includes%28operation.storage.rust%2B%27%3A%3A%27%2Bvariant.name%29%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20operation%3Dinventory.operations.find%28row%3D%3Erow.fields%3F.length%3E1%29%2Cindex%3Dinventory.operations.indexOf%28operation%29%2Ctext%3Dtexts.get%28%27part_%27%2BMath.floor%28index%2F24%29%2B%27.rs%27%29%3B%0A%20%20const%20body%3DreadSourceTextRustBlock%28text%2C%27fn%27%2C%27construct_%27%2Bindex%29%2Cfield%3Doperation.fields%5B0%5D%3B%0A%20%20const%20changed%3Dbody.replace%28field.name%2B%27%3A%20field_0%27%2Cfield.name%2B%27%3A%20field_1%27%29%3Bassert.notEqual%28changed%2Cbody%29%3B%0A%20%20assert.throws%28%28%29%3D%3EcheckNativeConstructorSourceBindings%28changed%2Coperation.fields%2Coperation.fields.map%28row%3D%3Erow.typeReference%29%2CbyId%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27all%20constructor%20branches%20have%20complete%20typed%20controls%20and%20malformed%20child%20or%20lifetime%20labels%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Binventory%7D%3DnativeConstructorContext%28%29%2Ccontrols%3DbuildNativeConstructorStorageControls%28inventory%29%3B%0A%20%20assert.deepEqual%28controls%2CreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fnative-constructor-storage.lino%27%2Cimport.meta.url%29%29%29%3B%0A%20%20assert.deepEqual%28%5B...new%20Set%28controls.cases.map%28row%3D%3Erow.sourceReference%29%29%5D%2Ccontrols.sourceReferences%29%3B%0A%20%20for%28const%20row%20of%20controls.cases%29%7Bassert.ok%28checkNativeConstructorControl%28inventory%2Crow.recipe%29%3E0%29%3Bassert.equal%28row.expectedStorageType%2Cinventory.operations.find%28operation%3D%3Eoperation.sourceReference%3D%3D%3Drow.sourceReference%29.storage.rust%29%3B%7D%0A%20%20for%28const%20operation%20of%20inventory.operations%29%7B%0A%20%20%20%20const%20cases%3Dcontrols.cases.filter%28row%3D%3Erow.sourceReference%3D%3D%3Doperation.sourceReference%29%3B%0A%20%20%20%20if%28operation.variants%29assert.deepEqual%28cases.map%28row%3D%3Erow.recipe.choice%29%2Coperation.variants.map%28row%3D%3Erow.identity%29%29%3B%0A%20%20%20%20if%28operation.form%3D%3D%3D%27Option%27%29assert.deepEqual%28cases.map%28row%3D%3Erow.recipe.choice%29%2C%5B%27None%27%2C%27Some%27%5D%29%3B%0A%20%20%20%20if%28%5B%27Vec%27%2C%27IndexMap%27%5D.includes%28operation.form%29%29assert.deepEqual%28cases.map%28row%3D%3Erow.recipe.children.length%29%2C%5B0%2Coperation.arguments.length%5D%29%3B%0A%20%20%7D%0A%20%20const%20some%3Dcontrols.cases.find%28row%3D%3Erow.recipe.choice%3D%3D%3D%27Some%27%29.recipe%3B%0A%20%20for%28const%20mutate%20of%20%5Bvalue%3D%3E%7Bvalue.reference%3D%27foreign%27%3B%7D%2Cvalue%3D%3E%7Bvalue.children%5B0%5D.reference%3D%27foreign%27%3B%7D%2Cvalue%3D%3E%7Bvalue.children%3D%5B%5D%3B%7D%2Cvalue%3D%3E%7Bvalue.choice%3D%27foreign%27%3B%7D%5D%29%7B%0A%20%20%20%20const%20value%3DstructuredClone%28some%29%3Bmutate%28value%29%3Bassert.throws%28%28%29%3D%3EcheckNativeConstructorControl%28inventory%2Cvalue%29%29%3B%0A%20%20%7D%0A%20%20const%20reference%3Dcontrols.cases.find%28row%3D%3Erow.recipe.scalar%3F.kind%3D%3D%3D%27ExistingStaticReference%27%29.recipe%2Cchanged%3DstructuredClone%28reference%29%3B%0A%20%20changed.children%5B0%5D.scalar.value%3D%27different%27%3Bassert.throws%28%28%29%3D%3EcheckNativeConstructorControl%28inventory%2Cchanged%29%29%3B%0A%20%20const%20module%3DreadFileSync%28new%20URL%28%27..%2F..%2Frust%2Ftests%2Funit%2Fmod.rs%27%2Cimport.meta.url%29%2C%27utf8%27%29%3Bassert.ok%28module.includes%28%27mod%20grammar_outcome_constructor_storage%3B%27%29%29%3B%0A%20%20const%20native%3DreadFileSync%28new%20URL%28%27..%2F..%2Frust%2Ftests%2Funit%2Fgrammar_outcome_constructor_storage.rs%27%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20for%28const%20name%20of%20%5B%27every_captured_native_constructor_branch_packs_actual_typed_source_values%27%2C%27typed_storage_retains_original_number_variants_payload