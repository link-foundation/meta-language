(26418: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Project%20one%20complete%20already-certified%20historical%20module%3B%20reuse%20the%20current%0A%2F%2F%20raw-source%20authority%20and%20capture%20only%20the%20finite%20historical%20reader%20adapter.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BreadFileSync%2CwriteFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BreadBootstrapStructuredDataLino%7D%20from%20%27..%2F..%2Fscripts%2Flib%2Fstructured-data-bootstrap.mjs%27%3B%0Aimport%20%7BcaptureGitArtifactCertificate%7D%20from%20%27.%2Fcapture-git-artifact-certificate.mjs%27%3B%0Aimport%20%7BcheckProjectData%2CwriteProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7BreadOwnCodebaseHistoricalNamingPolicy%7D%20from%20%27.%2Fown-codebase-baseline-naming-history.mjs%27%3B%0Aimport%20%7BreadOwnCodebaseRawDescriptorPolicy%7D%20from%20%27.%2Fown-codebase-raw-source-descriptors.mjs%27%3B%0Aimport%20%7BrestoreRelativeArrayCurrentFrontendSource%7D%20from%20%27.%2Frelative-array-current-frontend-history.mjs%27%3B%0Aimport%20%7BRELATIVE_ARRAY_FRONTEND_PROFILE%2CRELATIVE_ARRAY_FRONTEND_HOST%2CrelativeArrayFrontendPin%2C%0A%20%20replayRelativeArrayFrontendHost%2CreadAuthenticatedCurrentRelativeArrayFrontend%2C%0A%20%20verifyRelativeArrayFrontendSourceHistory%2CRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE%2CreplayRelativeArrayNullableInference%7D%20from%20%27.%2Frelative-array-frontend-source-history.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%2Coutput%3D%27parity%2Fself-translation%2Frelative-array-frontend-source-history.lino%27%3B%0Aconst%20helper%3D%27js%2Fscripts%2Frelative-array-frontend-source-history.mjs%27%3B%0A%0Aexport%20function%20generateRelativeArrayFrontendSourceHistory%28%7Bcheck%3Dfalse%2Capply%3Dfalse%7D%3D%7B%7D%29%7B%0A%20%20assert.equal%28check%26%26apply%2Cfalse%29%3B%0A%20%20const%20naming%3DreadOwnCodebaseHistoricalNamingPolicy%28%29%2Cpolicy%3DreadOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20const%20archiveBytes%3DreadFileSync%28new%20URL%28naming.sourceArchive.path%2Croot%29%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28archiveBytes%29%2C%7Bbytes%3Anaming.sourceArchive.bytes%2Csha256%3Anaming.sourceArchive.sha256%7D%29%3B%0A%20%20let%20archive%3DreadBootstrapStructuredDataLino%28archiveBytes.toString%28%27utf8%27%29%29%3B%0A%20%20assert.equal%28archive.revision%2Cnaming.revision%29%3Bassert.equal%28archive.sources.length%2Cnaming.sourceArchive.sources%29%3B%0A%20%20const%20selected%3Darchive.sources.filter%28row%3D%3Erow.file%3D%3D%3Dpolicy.sourceFile%29%3Bassert.equal%28selected.length%2C1%29%3B%0A%20%20const%20row%3Dselected%5B0%5D%2Chistorical%3D%7Bfile%3Arow.file%2Ccommit%3Arow.commit%2Cbytes%3Arow.bytes%2Csha256%3Arow.sha256%2C%0A%20%20%20%20sourceText%3Arow.sourceText%2Ccertificate%3AstructuredClone%28row.certificate%29%7D%3B%0A%20%20archive%3Dnull%3Bglobal.gc%3F.%28%29%3B%0A%20%20assert.equal%28restoreRelativeArrayCurrentFrontendSource%28readFileSync%28new%20URL%28policy.sourceFile%2Croot%29%2C%27utf8%27%29%2Cpolicy.sourceFile%2CRELATIVE_ARRAY_FRONTEND_PROFILE%29%2CreadAuthenticatedCurrentRelativeArrayFrontend%28%29%29%3B%0A%20%20const%20inferenceOwner%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE%3B%0A%20%20const%20inferenceCapture%3DcaptureGitArtifactCertificate%28inferenceOwner.revision%2CinferenceOwner.path%29%3B%0A%20%20const%20inferenceSource%3DinferenceCapture.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28inferenceSource%29%2CinferenceCapture.blob%29%3B%0A%20%20const%20inferenceReplay%3DreplayRelativeArrayNullableInference%28inferenceSource%29%3B%0A%20%20assert.equal%28readFileSync%28new%20URL%28inferenceOwner.path%2Croot%29%2C%27utf8%27%29%2CinferenceReplay.source%2C%27capture%20refuses%20unknown%20nullable-array%20source%20successors%27%29%3B%0A%20%20const%20captured%3DcaptureGitArtifactCertificate%28RELATIVE_ARRAY_FRONTEND_HOST.revision%2CRELATIVE_ARRAY_FRONTEND_HOST.path%29%3B%0A%20%20const%20sourceText%3Dcaptured.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28sourceText%29%2Ccaptured.blob%29%3B%0A%20%20const%20replay%3DreplayRelativeArrayFrontendHost%28sourceText%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3A2%2Cmodel%3A%27relative%20array%20frontend%20descriptor%20historical%20source%202%27%2Cprofile%3ARELATIVE_ARRAY_FRONTEND_PROFILE%2C%0A%20%20%20%20sourceArchive%3A%7Brevision%3Anaming.revision%2C...naming.sourceArchive%7D%2Chistorical%2C%0A%20%20%20%20currentAuthority%3A%7Brevision%3Apolicy.revision%2Cfile%3Apolicy.sourceFile%2Cpredecessor%3Apolicy.sourceOwner.predecessor%2Ccurrent%3Apolicy.sourceOwner.current%7D%2C%0A%20%20%20%20nullableInference%3A%7Bpath%3AinferenceOwner.path%2Crevision%3AinferenceOwner.revision%2C...relativeArrayFrontendPin%28inferenceSource%29%2C%0A%20%20%20%20%20%20sourceText%3AinferenceSource%2Ccertificate%3AinferenceCapture.certificate%2Ccurrent%3ArelativeArrayFrontendPin%28inferenceReplay.source%29%2Cedits%3AinferenceReplay.edits%7D%2C%0A%20%20%20%20host%3A%7Bpath%3ARELATIVE_ARRAY_FRONTEND_HOST.path%2Crevision%3ARELATIVE_ARRAY_FRONTEND_HOST.revision%2C%0A%20%20%20%20%20%20...relativeArrayFrontendPin%28sourceText%29%2CsourceText%2Ccertificate%3Acaptured.certificate%2Ccurrent%3ArelativeArrayFrontendPin%28replay.source%29%2Cedits%3Areplay.edits%7D%2C%0A%20%20%20%20boundary%3A%27One%20explicit%20historical%20descriptor%20view%20for%20the%20relative-array%20generator%20only.%20The%20complete%20original%20frontend%20retains%20its%20independently%20certified897bfc%20source%20context%3B%20the%20distinct%20current%20frontend%20is%20authenticated%20through%20the%20existing%20checked%20raw-source%20descriptor%20receipt.%20A%20second%20complete%20certified7881%20inference%20source%20has%20one%20finite%20nullable-array%20owner%20insertion%20whose%20inverse%20is%20used%20only%20in%20this%20same%20descriptor%20scope.%20The%20actual%20current%20inference%20fix%20remains%20independently%20exercised%3B%20no%20source%20behavior%20equivalence%20is%20inferred.%20Every%20original%20relative-array%20descriptor%2C%20receipt%2C%20native%20definition%2C24-source%20inventory%2C%20fixture%20and%20two-change%20assertion%20stays%20exact.%20Actual%20current%20parsing%2C%20emission%2C%20source%20descriptors%20and%20native%20CI%20remain%20independent.%27%7D%3B%0A%20%20verifyRelativeArrayFrontendSourceHistory%28history%29%3B%0A%20%20const%20host%3Dnew%20URL%28RELATIVE_ARRAY_FRONTEND_HOST.path%2Croot%29%2Cactual%3DreadFileSync%28host%2C%27utf8%27%29%3B%0A%20%20if%28check%29assert.equal%28actual%2Creplay.source%29%3Belse%20assert.ok%28actual%3D%3D%3DsourceText%7C%7Cactual%3D%3D%3Dreplay.source%2C%27unknown%20host%20source%20is%20never%20overwritten%27%29%3B%0A%20%20if%28check%29checkProjectData%28new%20URL%28output%2Croot%29%2Chistory%29%3Belse%20writeProjectData%28new%20URL%28output%2Croot%29%2Chistory%29%3B%0A%20%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Ccurrent%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2Fconst%20historySha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%3B%0A%20%20assert.equal%28current.split%28pattern%29.length%2C2%29%3B%0A%20%20const%20expected%3Dcurrent.replace%28pattern%2C%22const%20historySha256%3D%27%22%2BrelativeArrayFrontendPin%28readFileSync%28new%20URL%28output%2Croot%29%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28current%2Cexpected%29%3Belse%20writeFileSync%28helperPath%2Cexpected%29%3B%0A%20%20if%28apply%29writeFileSync%28host%2Creplay.source%29%3B%0A%20%20return%20history%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.equal%28new%20Set%28args%29.size%2Cargs.length%29%3Bassert.ok%28args.every%28value%3D%3E%5B%27--check%27%2C%27--apply%27%5D.includes%28value%29%29%29%3B%0A%20%20const%20history%3DgenerateRelativeArrayFrontendSourceHistory%28%7Bcheck%3Aargs.includes%28%27--check%27%29%2Capply%3Aargs.includes%28%27--apply%27%29%7D%29%3B%0A%20%20console.log%28JSON.stringify%28%7Bprofile%3Ahistory.profile%2Cfile%3Ahistory.historical.file%2Chistorical%3Ahistory.historical.sha256%2C%0A%20%20%20%20current%3Ahistory.currentAuthority.current.sha256%2CnativeCompilation%3Afalse%2CnativeExecution%3Afalse%7D%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
