tests%2F%27.length%29%29%3B%0A%20%20for%28const%20file%20of%20partitionTests%28originalFiles%29.groups.translation%29assert.ok%28files.includes%28file%29%2Cfile%29%3B%0A%7D%29%3B%0A%0Atest%28%27six%20feedback%20partitions%20merge%20exact%20scope%20and%20bytes%20while%20missing%20foreign%20and%20tampered%20cohorts%20refuse%27%2C%28t%29%3D%3E%7B%0A%20%20const%20root%3DrealpathSync%28mkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-six-feedback-%27%29%29%29%3B%0A%20%20t.after%28%28%29%3D%3ErmSync%28root%2C%7Brecursive%3Atrue%7D%29%29%3B%0A%20%20mkdirSync%28join%28root%2C%27js%2Ftests%27%29%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3C6%3Bindex%2B%2B%29writeFileSync%28join%28root%2C%27js%2Ftests%2Ftranslation-%27%2Bindex%2B%27.test.js%27%29%2C%27%27%29%3B%0A%20%20const%20payload%3D%27issue-195-artifacts%2Fcompiler-feedback%2Fsource.lino%27%3B%0A%20%20mkdirSync%28join%28root%2C%27issue-195-artifacts%2Fcompiler-feedback%27%29%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20writeFileSync%28join%28root%2Cpayload%29%2C%27%28retained%20compiler%20bytes%29%5Cn%27%29%3B%0A%20%20const%20commit%3D%27a%27.repeat%2840%29%2CinputDirectory%3Djoin%28root%2C%27parts%27%29%2Cdirectories%3D%5B%5D%3B%0A%20%20const%20capture%3Dindex%3D%3EcaptureTranslationTestFeedbackPartition%28%7Broot%2Ccommit%2Cpartitions%3A6%2C%0A%20%20%20%20shard%3A%28index%2B1%29%2B%27%2F6%27%2CoutputDirectory%3Ajoin%28inputDirectory%2C%27translation-test-feedback-%27%2Bcommit%2B%27-%27%2B%28index%2B1%29%2B%27-of-6%27%29%7D%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3C6%3Bindex%2B%2B%29%7B%0A%20%20%20%20const%20receipt%3Dcapture%28index%29%3Bassert.equal%28receipt.files.length%2C1%29%3B%0A%20%20%20%20directories.push%28join%28inputDirectory%2C%27translation-test-feedback-%27%2Bcommit%2B%27-%27%2B%28index%2B1%29%2B%27-of-6%27%29%29%3B%0A%20%20%7D%0A%20%20const%20arguments_%3D%7Broot%2Ccommit%2CinputDirectory%2Cpartitions%3A6%2CoutputDirectory%3Ajoin%28root%2C%27merged%27%29%7D%3B%0A%20%20const%20merged%3DmergeTranslationTestFeedbackPartitions%28arguments_%29%3B%0A%20%20assert.equal%28merged.partitions%2C6%29%3Bassert.deepEqual%28merged.files%2C%5Bpayload%5D%29%3B%0A%20%20assert.equal%28readFileSync%28join%28root%2C%27merged%27%2Cpayload%29%2C%27utf8%27%29%2C%27%28retained%20compiler%20bytes%29%5Cn%27%29%3B%0A%20%20const%20rejected%3D%7B...arguments_%2CoutputDirectory%3Ajoin%28root%2C%27rejected%27%29%7D%3B%0A%20%20assert.throws%28%28%29%3D%3EmergeTranslationTestFeedbackPartitions%28%7B...rejected%2Cpartitions%3A3%7D%29%2C%2Fexactly%20once%2Fu%29%3B%0A%20%20rmSync%28directories%5B3%5D%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20assert.throws%28%28%29%3D%3EmergeTranslationTestFeedbackPartitions%28rejected%29%2C%2Fexactly%20once%2Fu%29%3B%0A%20%20capture%283%29%3B%0A%20%20const%20receiptFile%3Djoin%28directories%5B2%5D%2C%27translation-test-feedback-partition.lino%27%29%3B%0A%20%20const%20receipt%3DreadProjectData%28receiptFile%29%3Breceipt.shard%3D%273%2F3%27%3BwriteProjectData%28receiptFile%2Creceipt%29%3B%0A%20%20assert.throws%28%28%29%3D%3EmergeTranslationTestFeedbackPartitions%28rejected%29%2C%2Fprovenance%2Fu%29%3B%0A%20%20assert.equal%28existsSync%28rejected.outputDirectory%29%2Cfalse%29%3B%0A%7D%29%3B%0A%0Atest%28%27TypeScript%20native%20execution%20follows%20JavaScript%20and%20every%20Rust%20partition%20retains%20its%20actual%20observations%27%2C%28%29%3D%3E%7B%0A%20%20const%20ci%3DparseWorkflow%28read%28%27.github%2Fworkflows%2Fci.yml%27%29%29%3B%0A%20%20const%20native%3Dci.find%28job%3D%3Ejob.id%3D%3D%3D%27native-rust%27%29%2Cjavascript%3Dci.find%28job%3D%3Ejob.id%3D%3D%3D%27native-javascript%27%29%3B%0A%20%20assert.match%28native.header%2C%2Fneeds%3A%20%5C%5Bruntime-parity%2C%20native-javascript%5C%5D%2Fu%29%3B%0A%20%20assert.match%28native.header%2C%2Fneeds%5C.native-javascript%5C.result%20%3D%3D%20%27success%27%2Fu%29%3B%0A%20%20assert.match%28javascript.header%2C%2Fneeds%3A%20%5C%5Bjs%2C%20runtime-parity%5C%5D%2Fu%29%3B%0A%20%20const%20step%3Dnative.