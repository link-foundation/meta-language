nst%20rows%3Dhistory.sources.filter%28row%3D%3Erow.file%3D%3D%3Dfile%26%26row.profiles.includes%28profile%29%29%3B%0A%20%20assert.ok%28rows.length%3C%3D1%2C%27one%20complete%20historical%20input%20per%20profile%27%29%3B%0A%20%20if%28rows.length%3D%3D%3D0%29return%20%5B%27relative%20array%27%2C%27original%20number%20source%20ranges%27%5D.includes%28profile%29%0A%20%20%20%20%3FrestoreCurrentCiRepairSource%28source%2Cfile%29%3Asource%3B%0A%20%20source%3DrestoreCurrentCiRepairSource%28source%2Cfile%29%3B%0A%20%20source%3DrestoreNativeCompatibilitySourceHistory%28file%2Csource%29%3B%0A%20%20const%20row%3Drows%5B0%5D%2Cactual%3Dpin%28source%29%3B%0A%20%20if%28actual.sha256%21%3D%3Drow.current.sha256%29return%20source%3B%0A%20%20assert.deepEqual%28actual%2Crow.current%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.sourceText%29%2C%7Brevision%3Arow.commit%2Cpath%3Afile%7D%29%3B%0A%20%20assert.equal%28row.edit.offsetUnit%2C%27UTF-8%20bytes%27%29%3B%0A%20%20const%20bytes%3DBuffer.from%28source%29%2Cedit%3Drow.edit%3B%0A%20%20assert.equal%28bytes.subarray%28edit.start%2Cedit.end%29.toString%28%27utf8%27%29%2Cedit.inserted%29%3B%0A%20%20const%20restored%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20assert.deepEqual%28pin%28restored%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20assert.equal%28restored.toString%28%27utf8%27%29%2Crow.sourceText%29%3B%0A%20%20return%20row.sourceText%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
