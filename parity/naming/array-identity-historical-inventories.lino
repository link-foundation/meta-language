%28combined.slice%280%2Ccurrent.length%29%2Ccurrent%29%3B%0A%20%20assert.equal%28combined.length%2Ccurrent.length%2B2%29%3B%0A%20%20for%28const%20row%20of%20historical%29%7B%0A%20%20%20%20const%20view%3Dhistory.views.find%28view%3D%3Eview.file%3D%3D%3Drow.file%29%3B%0A%20%20%20%20assert.equal%28row.sourceView.kind%2C%27complete%20certified%20historical%20source%27%29%3B%0A%20%20%20%20assert.equal%28row.sourceView.path%2Cview.file%29%3Bassert.equal%28row.sourceView.revision%2Chistory.revision%29%3B%0A%20%20%20%20assert.equal%28row.sourceView.sha256%2Cdigest%28view.predecessor.source%29%29%3B%0A%20%20%20%20assert.notEqual%28row.sourceView.sha256%2Cview.current.sha256%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28history%2Cbefore%2C%27extractors%20cannot%20replace%20the%20retained%20original%20source%20or%20current%20pins%27%29%3B%0A%20%20const%20changed%3DreadOwnCodebaseHistoricalNamingPolicy%28%29%3Bchanged.views%5B0%5D.current.sha256%3D%270%27.repeat%2864%29%3B%0A%20%20assert.deepEqual%28readOwnCodebaseHistoricalNamingPolicy%28%29.views%2Cbefore.views.map%28%28%7Bpredecessor%2C...view%7D%29%3D%3Eview%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27unknown%20whole%20current%20naming%20sources%20and%20driver%20bytes%20cannot%20borrow%20historical%20authority%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DreadOwnCodebaseHistoricalNamingSources%28%29%2Cscratch%3DmkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-own-naming-%27%29%29%3B%0A%20%20const%20files%3D%5B...history.views.map%28view%3D%3Eview.file%29%2Chistory.driver.file%5D%3B%0A%20%20try%7B%0A%20%20%20%20for%28const%20file%20of%20files%29%7Bconst%20destination%3Djoin%28scratch%2Cfile%29%3BmkdirSync%28dirname%28destination%29%2C%7Brecursive%3Atrue%7D%29%3BwriteFileSync%28destination%2CreadFileSync%28join%28root%2Cfile%29%29%29%3B%7D%0A%20%20%20%20const%20expected%3DextractOwnCodebaseHistoricalNames%28root%2CNAME_INVENTORIES%2Chistory%29%3B%0A%20%20%20%20assert.deepEqual%28extractOwnCodebaseHistoricalNames%28scratch%2CNAME_