t%29%2C%27utf8%27%29%2Ccurrent.source%2C%27author%20refuses%20an%20unrecorded%20live%20native%20successor%27%29%3B%0A%20%20const%20declaration%3D%7BschemaVersion%3A1%2Cmodel%3A%27scoped%20iteration%20native%20historical%20source%201%27%2Cfile%3Aspecification.file%2C%0A%20%20%20%20previousRevision%3Aspecification.previousRevision%2Crevision%3Aspecification.revision%2CcoordinateUnit%3A%27UTF-16%20code%20units%27%2C%0A%20%20%20%20previous%2Ccurrent%2Cedits%3AderiveScopedIterationNativeHostSource%28previous.source%2Ccurrent.source%29%2C%0A%20%20%20%20boundary%3A%27One%20actual%20parser-owned%20iteration-source%20transport%20argument%20is%20retained%20in%20current%20runtime%20bytes.%20Both%20complete%20committed%20source%20epochs%20and%20every%20old%20source%20byte%20are%20independently%20authenticated%20before%20the%20unchanged%20required-field%20historical%20guard.%20Unknown%20paths%2C%20readers%20and%20successors%20remain%20visible%3B%20no%20native%20execution%20or%20semantic-equivalence%20claim.%27%7D%3B%0A%20%20const%20saved%3DcaptureGitArtifactCertificate%28SCOPED_ITERATION_NATIVE_PREDECESSOR_REVISION%2CSCOPED_ITERATION_NATIVE_OUTPUT%29%3B%0A%20%20const%20originalPacket%3DreadBootstrapStructuredDataLino%28saved.blob.toString%28%27utf8%27%29%29%3B%0A%20%20assert.deepEqual%28declaration%2CoriginalPacket%2C%27all%20existing%20declaration%20source%20facts%20and%20controls%20remain%20unchanged%27%29%3B%0A%20%20const%20loop%3DSCOPED_ITERATION_NATIVE_LOOP_SOURCE%3B%0A%20%20const%20captureLoop%3Drevision%3D%3E%7Bconst%20%7Bblob%2Ccertificate%7D%3DcaptureGitArtifactCertificate%28revision%2Cloop.file%29%3Bconst%20source%3Dblob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28source%29%2Cblob%29%3Breturn%7Bsource%2C...pinScopedIterationNativeSource%28blob%29%2Ccertificate%7D%3B%7D%3B%0A%20%20const%20loopPrevious%3DcaptureLoop%28loop.previousRevision%29%2CloopCurrent%3DcaptureLoop%28loop.revision%29%3B%0A%20%20assert.equal%28readFileSync%28new%20URL%28loop.file%2Croot%29%2C%27utf8%27%29%2CloopCurrent.source%2C%27unknown%20actual%20loop%20source%20refuses%27%29%3B%0A%20%20const%20packet%3D%7B...originalPacket%2Cpredecessor%3A%7Brevision%3ASCOPED_ITERATION_NATIVE_PREDECESSOR_REVISION%2C...pinScopedIterationNativeSource%28saved.blob%29%2Ccertificate%3Asaved.certificate%7D%2C%0A%20%20%20%20additionalSources%3A%5B%7Bfile%3Aloop.file%2CpreviousRevision%3Aloop.previousRevision%2Crevision%3Aloop.revision%2CcoordinateUnit%3A%27UTF-16%20code%20units%27%2Cprevious%3AloopPrevious%2Ccurrent%3AloopCurrent%2Cedits%3AderiveScopedIterationNativeLoopSource%28loopPrevious.source%2CloopCurrent.source%29%7D%5D%7D%3B%0A%20%20verifyScopedIterationNativeHostSourceHistory%28packet%29%3B%0A%20%20const%20output%3Dnew%20URL%28SCOPED_ITERATION_NATIVE_OUTPUT%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20%20const%20file%3Dnew%20URL%28helper%2Croot%29%2Cbefore%3DreadFileSync%28file%2C%27utf8%27%29%2Cpattern%3D%2F%5Econst%20packetSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%24%2Fmu%3B%0A%20%20assert.equal%28before.split%28pattern%29.length%2C2%29%3B%0A%20%20const%20after%3Dbefore.replace%28pattern%2C%22const%20packetSha256%3D%27%22%2BpinScopedIterationNativeSource%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28before%2Cafter%29%3Belse%20writeFileSync%28file%2Cafter%29%3B%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateScopedIterationNativeHostSourceHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Authenticated%20two%20complete%20scoped-iteration%20native%20source%20inverses%3B%20runtime%20files%20remain%20current.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
