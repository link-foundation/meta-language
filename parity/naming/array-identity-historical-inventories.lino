(59418: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20The%20readable-naming%20check%20%28docs%2Fvision.md%23readable-english-names%29%3A%20every%0A%2F%2F%20canonical%20name%20the%20sources%20define%20has%20a%20concept%20record%2C%20every%20record%20is%20an%0A%2F%2F%20unabbreviated%20English%20noun%20phrase%20%28concepts%29%20or%20verb%20phrase%20%28operations%29%0A%2F%2F%20checked%20against%20WordNet%203.1%2C%20and%20a%20mutation%20that%20introduces%20an%20abbreviation%2C%0A%2F%2F%20an%20ambiguity%2C%20a%20semantic%20duplicate%20or%20an%20unrecorded%20name%20fails%20the%20gate.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7B%20createHash%20%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7B%20readFileSync%20%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7B%20fileURLToPath%20%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7B%20test%20%7D%20from%20%27node%3Atest%27%3B%0A%0Aimport%20%7B%20areSynonyms%2C%20loadWordNet%2C%20partsOfSpeech%20%7D%20from%20%27..%2Fscripts%2Fenglish-vocabulary.mjs%27%3B%0Aimport%20%7B%0A%20%20checkConceptRecords%2C%0A%20%20checkNamingFixtures%2C%0A%20%20checkRepositoryNames%2C%0A%20%20extractNameInventory%2C%0A%20%20extractSourceDescriptions%2C%0A%20%20FORMER_NAME_TABLES%2C%0A%20%20loadNamingRegisters%2C%0A%20%20NAME_INVENTORIES%2C%0A%20%20NAMING_FIXTURES%2C%0A%20%20nameProblems%2C%0A%7D%20from%20%27..%2Fscripts%2Fissue-195-naming.mjs%27%3B%0Aimport%20%7B%20recordIssue195Observations%20%7D%20from%20%27.%2Fsupport%2Fissue-195-observations.js%27%3B%0Aimport%20%7B%20extractOwnCodebaseHistoricalNames%2C%20readOwnCodebaseHistoricalNamingPolicy%20%7D%20from%20%27..%2Fscripts%2Fown-codebase-baseline-naming-history.mjs%27%3B%0Aimport%20%7B%20readProjectData%20%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0A%0Aconst%20root%20%3D%20fileURLToPath%28new%20URL%28%27..%2F..%2F%27%2C%20import.meta.url%29%29%3B%0Aconst%20wordnet%20%3D%20loadWordNet%28%29%3B%0Aconst%20registers%20%3D%20loadNamingRegisters%28root%29%3B%0Aconst%20context%20%3D%20%7B%20wordnet%2C%20vocabulary%3A%20registers.vocabulary%20%7D%3B%0Aconst%20%7B%20fixtures%20%7D%20%3D%20readProjectData%28new%20URL%28%60..%2F..%2F%24%7BNAMING_FIXTURES%7D%60%2C%20import.meta.url%29%29%3B%0A%2F%2F%20Use%20the%20same%20complete%20current%20plus%20certified%20historical%20source%20inventory%20as%20the%20normal%20naming%20driver.%0Aconst%20currentNames%20%3D%20extractNameInventory%28root%29%3B%0Aconst%20historicalNames%20%3D%20extractOwnCodebaseHistoricalNames%28root%2C%20NAME_INVENTORIES%29%3B%0Aconst%20repository%20%3D%20checkRepositoryNames%28root%2C%20wordnet%2C%20%7B%20names%3A%20%5B...currentNames%2C%20...historicalNames%5D%20%7D%29%3B%0A%0Afunction%20observe%28assertions%2C%20testName%29%20%7B%0A%20%20recordIssue195Observations%28%7B%0A%20%20%20%20requirementId%3A%20%27I195-NAMING-CI-ENFORCEMENT%27%2C%0A%20%20%20%20suffix%3A%20%27behavior%27%2C%0A%20%20%20%20fixtureId%3A%20%27planned%3Arepository-directive%3Ai195-naming-ci-enforcement%27%2C%0A%20%20%20%20fixtureFile%3A%20NAMING_FIXTURES%2C%0A%20%20%20%20assertions%2C%0A%20%20%20%20testName%2C%0A%20%20%20%20runtime%3A%20%27tooling%27%2C%0A%20%20%7D%29%3B%0A%7D%0A%0Aconst%20record%20%3D%20%28id%29%20%3D%3E%20structuredClone%28repository.records.find%28%28candidate%29%20%3D%3E%20candidate.id%20%3D%3D%3D%20id%29%29%3B%0Aconst%20kindsOf%20%3D%20%28problems%29%20%3D%3E%20%5B...new%20Set%28problems.map%28%28problem%29%20%3D%3E%20problem.kind%29%29%5D.sort%28%29%3B%0A%2F%2F%20The%20problems%20of%20the%20repository%20with%20records%20or%20source%20names%20mutated%20in%20memory.%0Aconst%20mutated%20%3D%20%28override%29%20%3D%3E%20checkRepositoryNames%28root%2C%20wordnet%2C%20%7B%20names%3A%20repository.names%2C%20...override%20%7D%29.problems%3B%0A%0Atest%28%27the%20vocabulary%20is%20WordNet%203.1%20plus%20registered%20technical%20terms%2C%20not%20a%20letter%20pattern%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20assert.equal%28wordnet.source%2C%20%27WordNet%203.1%20%28wordnet-db%2