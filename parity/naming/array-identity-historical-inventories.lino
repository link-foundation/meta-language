packet.hosts.entries%28%29%29%7B%0A%20%20%20%20const%20expected%3DTOOLING_FROZEN_HOSTS%5Bindex%5D%3BexactKeys%28row%2C%5B%27path%27%2C%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%2Cexpected.previous%29%3B%0A%20%20%20%20assert.deepEqual%28toolingFrozenSourcePin%28row.source%29%2Cexpected.previous%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%3ATOOLING_FROZEN_SOURCE_REVISION%2Cpath%3Arow.path%7D%29%3B%0A%20%20%20%20const%20replay%3DreplayToolingFrozenHostChanges%28row.source%2Cexpected.changes%29%3B%0A%20%20%20%20assert.deepEqual%28row.edits%2Creplay.edits%29%3Bassert.deepEqual%28row.current%2CtoolingFrozenSourcePin%28replay.source%29%29%3B%0A%20%20%20%20outputs.push%28%7Bpath%3Arow.path%2Cprevious%3Arow.source%2Ccurrent%3Areplay.source%7D%29%3B%0A%20%20%7D%0A%20%20return%20outputs%3B%0A%7D%0A%0Aexport%20function%20readToolingFrozenSourceHistory%28%29%7B%0A%20%20const%20bytes%3DreadFileSync%28new%20URL%28policyPath%2Croot%29%29%3Bassert.equal%28toolingFrozenSourcePin%28bytes%29.sha256%2CpolicySha256%29%3B%0A%20%20const%20packet%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%0A%20%20for%28const%20row%20of%20verifyToolingFrozenSourceHistory%28packet%29%29assert.equal%28readFileSync%28new%20URL%28row.path%2Croot%29%2C%27utf8%27%29%2Crow.current%29%3B%0A%20%20return%20packet%3B%0A%7D%0A%0A%2F%2A%2A%20Compose%20only%20the%20three%20complete%20source%20hosts%20already%20authenticated%20by%0A%20%2A%20this%20packet.%20A%20selected%20unknown%20successor%20cannot%20acquire%20an%20older%20guard%20view.%20%2A%2F%0Aexport%20function%20restoreToolingFrozenHostSource%28source%2Cfile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3B%0A%20%20if%28%21TOOLING_FROZEN_HOSTS.some%28row%3D%3Erow.path%3D%3