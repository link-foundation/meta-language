(58810: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Source-only%20exact%20reference-validator%20succession%20before%20unchanged%20historical%20owner%20gates.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadCollectionSizeProjectionSchemaPacket%2CderiveCollectionSizeProjectionValidationSource%7D%20from%20%27.%2Fcollection-size-projection-schema.mjs%27%3B%0Aimport%20%7BrestoreRawConsumingSnapshotSource%7D%20from%20%27.%2Fraw-consuming-snapshot-source-profile.mjs%27%3B%0Aimport%20%7BtruthyProjectionHostPins%2CrestoreTruthyProjectionHistoricalSource%7D%20from%20%27.%2Ftruthy-projection-schema.mjs%27%3B%0Aconst%20validator%3D%27js%2Fsrc%2Ftyped-program-links-validation.js%27%2Cchecker%3D%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%3B%0Aconst%20changes%3D%5B%0A%20%20%7B%0A%20%20%20%20%22before%22%3A%20%22import%20%7B%20fixedBounds%2C%20sameType%20%7D%20from%20%27.%2Ftranslation%2Ftypes.js%27%3B%22%2C%0A%20%20%20%20%22after%22%3A%20%22import%20%7B%20fixedBounds%2C%20sameType%20%7D%20from%20%27.%2Ftranslation%2Ftypes.js%27%3B%5Cnimport%20%7BreadReferenceIdentityComparisonError%7D%20from%20%27.%2Ftranslation%2Freference-identity-rules.js%27%3B%22%0A%20%20%7D%2C%0A%20%20%7B%0A%20%20%20%20%22before%22%3A%20%22%20%20%20%20%20%20if%20%28node.domain%29%20same%28node.domain%2C%20node.left.type%2C%20%27binary%20operation%20domain%27%29%3B%5Cn%20%20%20%20%20%20const%20comparison%20%3D%22%2C%0A%20%20%20%20%22after%22%3A%20%22%20%20%20%20%20%20if%20%28node.domain%29%20same%28node.domain%2C%20node.left.type%2C%20%27binary%20operation%20domain%27%29%3B%5Cn%20%20%20%20%20%20const%20referenceError%20%3D%20readReferenceIdentityComparisonError%28node.op%2C%20node.left.type.kind%2C%20node.right.type.kind%2C%20node.left.type.reference%20%3D%3D%3D%20true%2C%20node.right.type.reference%20%3D%3D%3D%20true%2C%20sameType%28node.left.type%2C%20node.right.type%29%2C%20node.domain%20%21%3D%3D%20undefined%2C%20node.domain%3F.reference%20%3D%3D%3D%20true%2C%20node.domain%20%21%3D%3D%20undefined%20%26%26%20sameType%28node.domain%2C%20node.left.type%29%29%3B%5Cn%20%20%20%20%20%20if%20%28referenceError%29%20throw%20new%20TypeError%28referenceError%29%3B%5Cn%20%20%20%20%20%20const%20comparison%20%3D%22%0A%20%20%7D%0A%5D%3B%0Aconst%20pin%3Dsource%3D%3E%28%7Bbytes%3ABuffer.byteLength%28source%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%7D%29%3B%0A%0Afunction%20originalOwner%28file%29%7B%0A%20const%20packet%3DreadCollectionSizeProjectionSchemaPacket%28%29%2Cowner%3Dpacket.owners.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28owner%29%3B%0A%20return%20owner%3B%0A%7D%0A%2F%2A%2A%20The%20entire%20previous%20validator%20is%20independently%20certified%20by%20the%20unchanged%20collection%20packet.%20%2A%2F%0Afunction%20deriveWithOwner%28owner%2Cprevious%29%7B%0A%20const%20expected%3DderiveCollectionSizeProjectionValidationSource%28owner.source%29%3B%0A%20assert.equal%28previous%2Cexpected%2C%27only%20the%20complete%20certified%20collection%20validator%20is%20a%20predecessor%27%29%3B%0A%20assert.deepEqual%28pin%28previous%29%2Cowner.current%29%3B%0A%20let%20current%3Dprevious%3B%0A%20for%28const%20change%20of%20changes%29%7Bassert.equal%28current.split%28change.before%29.length%2C2%2C%27one%20actual%20reference-validation%20insertion%27%29%3Bcurrent%3Dcurrent.replace%28change.before%2Cchange.after%29%3B%7D%0A%20let%20inverse%3Dcurrent%3B%0A%20for%28const%20change%20of%20%5B...changes%5D.reverse%28%29%29%7Bassert.equal%28inverse.split%28change.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28change.after%2Cchange.before%29%3B%7D%0A%20assert.equal%28inverse%2Cprevious%2C%27every%20previous%20validator%20byte%20and%20assertion%20survives%27%29%3B%0A%20return%20current%3B%0A%7D%0Aexport%20function%20deriveReferenceIdentityValidationSource%28previous%29%7Breturn%20deriveWithOwner%28originalOwner%28validator%29%2Cprevious%29%3B%7D%0A%2F%2A%2A%20Live%20runtime%2Fcodec%2Fchecker%20use%20never%20invokes%20this%20scoped%20historical%20adapter.%20%2A%2F%0Aexport%20function%20restoreReferenceIdentityHistoricalSource%28source%2Cfile%2Cscope%29%7B%0A%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bassert.equal%28typeof%20scope%2C%27string%27%29%3B%0A%20if%28file%3D%3D%3Dvalidator%26%26%5B%27collection%20size%20projection%27%2C%27program%20string%20registration%27%5D.includes%28scope%29%29%7B%0A%20%20const%20owner%3DoriginalOwner%28file%29%2Cprevious%3DderiveCollectionSizeProjectionValidationSource%28owner.source%29%3B%0A%20%20assert.deepEqual%28pin%28previous%29%2Cowner.current%29%3B%0A%20%20return%20source%3D%3D%3DderiveWithOwner%28owner%2Cprevious%29%3Fprevious%3Asource%3B%0A%20%7D%0A%20if%28file%3D%3D%3Dchecker%26%26scope%3D%3D%3D%27collection%20size%20projection%27%29%7B%0A%20%20const%20owner%3DoriginalOwner%28file%29%3Bassert.deepEqual%28pin%28owner.source%29%2Cowner.current%29%3B%0A%20%20if%28source%3D%3D%3Downer.source%29return%20source%3B%0A%20%20const%20old%3DtruthyProjectionHostPins.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28old%29%3B%0A%20%20if%28pin%28source%29.sha256%3D%3D%3Dold.current.sha256%29%7Bconst%20previous%3DrestoreTruthyProjectionHistoricalSource%28Buffer.from%28source%29%2Cfile%29%3Bassert.equal%28previous%2Cowner.source%29%3Breturn%20previous%3B%7D%0A%20%20%2F%2F%20Existing%20normal%20snapshot%20authority%20authenticates%20all%20actual%20source%20bytes.%0A%20%20%2F%2F%20Unknown%20selected%20source%20stays%20unknown%3B%20a%20stale%20snapshot%20still%20refuses.%0A%20%20const%20historical%3DrestoreRawConsumingSnapshotSource%28Buffer.from%28source%29%2Cfile%2Ctrue%29.toString%28%27utf8%27%29%3B%0A%20%20if%28historical%21%3D%3Dsource%29%7Bassert.equal%28historical%2Cowner.source%2C%27the%20whole%20existing%20checker%20authority%20must%20select%20the%20exact%20certified%20collection%20owner%27%29%3Breturn%20historical%3B%7D%0A%20%7D%0A%20return%20source%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
