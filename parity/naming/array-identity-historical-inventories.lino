%20Node%20selects%20the%20bounded%20native-host%20source%20assertion%20range%27%2C%28%29%3D%3E%7B%0A%20%20const%5Bmajor%2Cminor%5D%3Dprocess.versions.node.split%28%27.%27%29.map%28Number%29%3B%0A%20%20assert.ok%28major%3D%3D%3D22%26%26minor%3E%3D15%7C%7Cmajor%3D%3D%3D24%2C%27uncovered%20Node%20%27%2Bprocess.versions.node%2B%27%3B%20supported%20%3E%3D22.15.0%20%3C23%20or%20%3E%3D24%20%3C25%27%29%3B%0A%7D%29%3B%0Atest%28%27all%20three%20actual%20current%20native%20hosts%20retain%20exact%20a8%20source%20inverses%20and%20original%20independent%20packet%20bytes%27%2C%28%29%3D%3E%7B%0A%20%20const%20value%3DverifyRequiredFieldNativeHostSuccession%28packet%28%29%29%3Bassert.equal%28value.sources.length%2C5%29%3B%0A%20%20const%20originalSources%3Dvalue.sources.slice%280%2C3%29%3Bassert.equal%28originalSources.length%2C3%29%3B%0A%20%20for%28const%5Bindex%2Crow%5Dof%20originalSources.entries%28%29%29%7B%0A%20%20%20%20%2F%2F%20The%20original%20packet%27s%20current%20host%20is%20the%20certified%208d%20version.%20The%0A%20%20%20%20%2F%2F%20separate%20current-native%20controls%20retain%20and%20inspect%20every%20actual%20source.%0A%20%20%20%20const%20current%3DrestoreCurrentNativeHostSource%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.file%29%3Bassert.equal%28current%2Crow.current.source%29%3B%0A%20%20%20%20for%28const%20change%20of%20REQUIRED_FIELD_NATIVE_HOST_SOURCES%5Bindex%5D.changes%29assert.equal%28current.split%28change.after%29.length%2C2%29%3B%0A%20%20%20%20const%20reader%3Dindex%3D%3D%3D2%3F%27ASCII%20character%20host%27%3A%27program%20string%20registration%27%3B%0A%20%20%20%20assert.equal%28restoreRequiredFieldNativeHostSource%28current%2Crow.file%2Creader%29%2Crow.previous.source%29%3B%0A%20%20%20%20assert.equal%28restoreRequiredFieldNativeHostSource%28row.previous.source%2Crow.file%2Creader%29%2Crow.previous.source%29%3B%0A%20%20%7D%0A%20%20const%20modules%3DreadFileSync%28new%20URL%28%27rust%2Fsrc%2Ftranslation%2Fmod.rs%27%2Croot%29%2C%27utf8%