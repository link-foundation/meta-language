t.sources.entries%28%29%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27certificate%27%2C%27current%27%2C%27file%27%2C%27previous%27%5D%29%3B%0A%20%20assert.deepEqual%28Object.keys%28row.previous%29.sort%28%29%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20assert.deepEqual%28Object.keys%28row.current%29.sort%28%29%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20const%20expected%3DinspectedTruthyPreimages%5Bindex%5D%3B%0A%20%20assert.deepEqual%28pinTruthyProjectionSource%28row.previous.source%29%2C%7Bbytes%3Aexpected.bytes%2Csha256%3Aexpected.sha256%7D%29%3B%0A%20%20assert.deepEqual%28pinTruthyProjectionSource%28row.previous.source%29%2C%7Bbytes%3Arow.previous.bytes%2Csha256%3Arow.previous.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.previous.source%29%2C%7Brevision%3ATRUTHY_PROJECTION_REVISION%2Cpath%3Arow.file%7D%29%3B%0A%20%20const%20derived%3Dindex%3C2%3FderiveTruthyProjectionSchema%28row.previous.source%29%3AderiveTruthyProjectionHostSource%28row.file%2Crow.previous.source%29%3B%0A%20%20assert.equal%28row.current.source%2Cderived%29%3Bassert.deepEqual%28pinTruthyProjectionSource%28derived%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%7D%0A%20assert.equal%28packet.sources%5B0%5D.previous.source%2Cpacket.sources%5B1%5D.previous.source%29%3B%0A%20assert.equal%28packet.sources%5B0%5D.current.source%2Cpacket.sources%5B1%5D.current.source%29%3B%0A%20return%20structuredClone%28packet%29%3B%0A%7D%0A%0Aexport%20function%20readTruthyProjectionSchemaPacket%28%29%20%7B%0A%20const%20bytes%3DreadFileSync%28new%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%29%3B%0A%20assert.equal%28pinTruthyProjectionSource%28bytes%29.sha256%2CrecipeSha256%2C%27complete%20normal-author%20packet%20is%20pinned%27%29%3B%0A%20return%20verifyTruthyProjectionSchemaPacket%28readProjectData%28new%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%29%29%3B%0A%7D%0A%0A%2F%2F%20Explicit%20historical%20readers%20only.%20Runtime%20schema%2Fcheckers%20always%20use%20actual%0A%2F%2F%20current%20bytes%3B%20unknown%20complete%20schema%20or%20host%20successors%20still%20refuse.%0Aexport%20function%20restoreTruthyProjectionHistoricalSource%28bytes%2Cfile%29%20%7B%0A%20assert.ok%28Buffer.isBuffer%28bytes%29%26%26bytes.length%3C%3D256%2A1024%29%3B%0A%20const%20expected%3DinspectedTruthyPreimages.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28expected%2C%27closed%20five-source%20historical%20view%27%29%3B%0A%20const%20text%3Dbytes.toString%28%27utf8%27%29%3Bassert.equal%28Buffer.from%28text%29.equals%28bytes%29%2Ctrue%29%3B%0A%20if%28pinTruthyProjectionSource%28bytes%29.sha256%3D%3D%3Dexpected.sha256%29%7Bassert.equal%28bytes.length%2Cexpected.bytes%29%3Breturn%20text%3B%7D%0A%20const%20packet%3DreadTruthyProjectionSchemaPacket%28%29%2Crow%3Dpacket.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3B%0A%20assert.equal%28text%2Crow.current.source%2C%27unknown%20complete%20current%20source%20refuses%20historical%20authority%27%29%3B%0A%20assert.deepEqual%28pinTruthyProjectionSource%28bytes%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20return%20row.previous.source%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
