sts%2Fsupport%2Fgrammar-selection-cases.js%27%3B%0Aimport%20%7BserializeProjectData%2CreadProjectData%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BreadStructuredDataLino%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fsrc%2Fstructured-data-links.js%27%3B%0A%0Aconst%20repository%3Dprocess.env.META_LANGUAGE_DIAGNOSTIC_ORDER_REPOSITORY%3F%3FfileURLToPath%28new%20URL%28%27..%2F..%2F..%2F..%2F%27%2Cimport.meta.url%29%29%3B%0Alet%20captured%3B%0Aconst%20current%3D%28%29%3D%3Ecaptured%3F%3F%3DcaptureDiagnosticOrderDecorator%28%29%3B%0Aconst%20original%3Dpath%3D%3Ecurrent%28%29.decorator.inputs.find%28input%3D%3Einput.path%3D%3D%3Dpath%29.source%3B%0A%0Atest%28%27actual%20complete%20CST%20source%20correspondence%20retains%20all%20nine%20JS%20call%20contexts%20and%20the%20unmatched%20native%20guard%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bdecorator%2Ccorrected%7D%3Dcurrent%28%29%3B%0A%20%20assert.equal%28decorator.matches.length%2C9%29%3Bassert.equal%28decorator.edits.length%2C2%29%3Bassert.equal%28decorator.unmatchedNative.length%2C1%29%3B%0A%20%20assert.equal%28Object.keys%28decorator.baselinePins%29.length%2C13%29%3B%0A%20%20assert.equal%28decorator.matches.filter%28row%3D%3Erow.changed%29.length%2C2%29%3B%0A%20%20for%28const%20match%20of%20decorator.matches%29%20%7B%0A%20%20%20%20assert.ok%28match.javascript.owner.span.end%3Ematch.javascript.owner.span.start%29%3B%0A%20%20%20%20assert.ok%28match.javascript.contexts.length%3E0%29%3B%0A%20%20%20%20assert.ok%28match.native.owner.span.end%3Ematch.native.owner.span.start%29%3B%0A%20%20%20%20assert.ok%28match.native.contexts.length%3E0%29%3B%0A%20%20%20%20assert.deepEqual%28%5B...match.javascript.keys%5D.sort%28%29%2C%5B...match.native.keys%5D.sort%28%29%29%3B%0A%20%20%20%20%2F%2F%20Every%20native%20value%20expression%20and%20its%20complete%20key%3Avalue%20source%20slice%20is%0A%20%20%20%20%2F%2F%20retained.%20Only%20the%20order%20of%20those%20existing%20slices%20may%20change.%0A%20%20%20%20for