TIVE_ARRAY_FRONTEND_PROFILE%29%3B%0A%20%20if%28file%3D%3D%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.path%0A%20%20%20%20%26%26digest%28source%29%3D%3D%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.current.sha256%29%0A%20%20%20%20source%3DrestoreRelativeArrayFrontendDescriptorSource%28source%2Cfile%2CRELATIVE_ARRAY_FRONTEND_PROFILE%29%3B%0A%20%20source%3DrestoreCurrentCiRepairSource%28source%2Cfile%29%3B%0A%20%20source%3DrestoreContinuationHistoricalSource%28source%2Cfile%2C%27relative%20array%27%29%3B%0A%20%20const%20row%3DarrayRelativeElementHistory%28%29.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3B%0A%20%20if%28%21row%29return%20source%3B%0A%20%20const%20hash%3Ddigest%28source%29%3B%0A%20%20if%28hash%3D%3D%3Drow.sha256%29%7Bassert.equal%28Buffer.byteLength%28source%29%2Crow.bytes%29%3Bassert.equal%28source%2Crow.sourceText%29%3Breturn%20source%3B%7D%0A%20%20if%28currentOnly%26%26hash%21%3D%3Drow.current.sha256%29return%20source%3B%0A%20%20assert.equal%28hash%2Crow.current.sha256%2C%27unreviewed%20current%20relative%20array%20source%20changes%20refuse%27%29%3B%0A%20%20assert.equal%28Buffer.byteLength%28source%29%2Crow.current.bytes%29%3B%0A%20%20const%20edit%3Drow.edit%2Cbytes%3DBuffer.from%28source%29%3B%0A%20%20assert.equal%28bytes.subarray%28edit.start%2Cedit.end%29.toString%28%29%2Cedit.currentText%29%3B%0A%20%20const%20restored%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.previousText%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20assert.equal%28restored.length%2Crow.bytes%29%3Bassert.equal%28digest%28restored%29%2Crow.sha256%29%3Bassert.equal%28restored.toString%28%29%2Crow.sourceText%29%3B%0A%20%20return%20restored.toString%28%29%3B%0A%7D%0A%0Aimport%20%7BrestoreCurrentCiRepairSource%7D%20from%20%27.%2Fcurrent-ci-repair-source-history.mjs%27%3B%0Aexport%20function%20restoreArrayRelativeElementProjectData%28value%2Cfile%29%20%7B%0A%20%20const%20row%3DarrayRelativeElementHistory%28%29.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3B%0A%20%20assert.ok%28row%26%26row.role%3D%3D%3D%27historical%20descriptor%27%2C%27a%20complete%20recorded%20descriptor%20source%20is%20required%27%29%3B%0A%20%20%2F%2F%20Each%20current%20descriptor%20is%20checked%20independently%20by%20the%20normal%20current%20gates.%0A%20%20%2F%2F%20This%20historical%20input%20view%20reconstructs%20its%20exact%20immutable%20predecessor.%0A%20%20return%20readStructuredDataLino%28restoreArrayRelativeElementSource%28serializeProjectData%28value%2Cfile%29%2Cfile%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
