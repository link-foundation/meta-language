0A%20%20%7D%0A%7D%29%3B%0Atest%28%27coherent%20repins%20certificate%20substitution%20lost%20owners%20and%20extra%20permissions%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20for%28const%20change%20of%5B%0A%20%20%20%20value%3D%3E%7Bvalue.revision%3D%270%27.repeat%2840%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources.pop%28%29%3B%7D%2Cvalue%3D%3E%7Bvalue.sources.splice%282%2C1%29%3B%7D%2Cvalue%3D%3E%7Bvalue.sources.push%28structuredClone%28value.sources%5B0%5D%29%29%3B%7D%2Cvalue%3D%3E%7Bvalue.sources.reverse%28%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B0%5D.previous.certificate.commitText%2B%3D%27%5Cn%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B0%5D.previous.source%2B%3D%27%5Cn%27%3BObject.assign%28value.sources%5B0%5D.previous%2CpinRequiredFieldNativeHostSource%28value.sources%5B0%5D.previous.source%29%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B2%5D.current.source%2B%3D%27%5Cn%27%3BObject.assign%28value.sources%5B2%5D.current%2CpinRequiredFieldNativeHostSource%28value.sources%5B2%5D.current.source%29%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B2%5D.edits%5B0%5D.inserted%2B%3D%27%2F%2F%20unrelated%5Cn%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B0%5D.permission%3D%27arbitrary%20future%20registrations%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.extraFiles%3D%5B%27unknown.rs%27%5D%3B%7D%2C%0A%20%20%5D%29%7Bconst%20value%3Dpacket%28%29%3Bchange%28value%29%3Bassert.throws%28%28%29%3D%3EverifyRequiredFieldNativeHostSuccession%28value%29%29%3B%7D%0A%7D%29%3B%0Atest%28%27the%20normal%20author%20reproduces%20the%20exact%20packet%20while%20both%20old%20frozen%20packets%20remain%20unchanged%27%2C%28%29%3D%3E%7B%0A%20%20const%20files%3D%5B%27parity%2Fself-translation%2Fprogram-string-host-registration-history.lino%27%2C%27parity%2Fself-translation%2Fascii-text-predicate-hosts.lino%27%5D%3B%0A%20%20const%20before%3Dfiles.map%28file%3D%3EreadFileSync%28new%20URL%28file%2Croot%29%29%29%3B%0A%20%20assert.deepEqual%28generateRequiredFieldNativeHostSuccession%28%7Bcheck%3Atrue%7D%29%2Cpacket%28%29%29%3B%0A%20%20files.forEach%28%28file%2Cindex%29%3D%3Eassert.deepEqual%28readFileSync%28new%20URL%28file%2Croot%29%29%2Cbefore%5Bindex%5D%29%29%3B%0A%7D%29%3B%0A%0A%0Atest%28%27the%20exact%20current%20collection%20validator%20keeps%20its%20certified%20program-string%20source%20view%20without%20admitting%20unknown%20successors%27%2C%28%29%3D%3E%7B%0A%20%20const%20file%3D%27js%2Fsrc%2Ftyped-program-links-validation.js%27%3B%0A%20%20const%20value%3DreadCollectionSizeProjectionSchemaPacket%28%29%2Cowner%3Dvalue.owners.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28owner%29%3B%0A%20%20const%20actual%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20const%20source%3DrestoreReferenceIdentityHistoricalSource%28actual%2Cfile%2C%27collection%20size%20projection%27%29%3B%0A%20%20assert.equal%28source%2CderiveCollectionSizeProjectionValidationSource%28owner.source%29%29%3B%0A%20%20assert.equal%28actual%2CderiveReferenceIdentityValidationSource%28source%29%29%3B%0A%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28actual%2Cfile%29%2Cowner.source%29%3B%0A%20%20assert.deepEqual%28pinRequiredFieldNativeHostSource%28source%29%2Cowner.current%29%3Bassert.notEqual%28source%2Cowner.source%29%3B%0A%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28source%2Cfile%29%2Cowner.source%29%3B%0A%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28owner.source%2Cfile%29%2Cowner.source%29%3B%0A%20%20for%28const%20changed%20of%5Bsource%2B%27%5Cn%27%2Csource.replace%28%27acceptProgramExpressionField%27%2C%27unknownExpressionField%27%29%5D%29%7B%0A%20%20%20%20assert.notEqual%28changed%2Csource%29%3Bassert.equal%28restoreProgramStringHostRegistrationSource%28changed%2Cfile%29%2Cchanged%29%3B%0A%20%20%7D%0A%20%20assert.equal%28restoreProgramStringHostRegistrationSource%28source%2C%27unregistered.js%27%29%2Csource%29%3B%0A%20%20for%28const%20change%20of%5B%0