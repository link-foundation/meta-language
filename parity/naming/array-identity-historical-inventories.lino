(110255: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20test%20from%20%27node%3Atest%27%3B%0Aimport%20%7BreadProjectData%2CserializeProjectData%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BreviewedOverlayProviderPolicy%2CreadReviewedOverlayProviderSources%2CrestoreReviewedOverlayProviderSources%7D%0A%20%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Freviewed-providers.mjs%27%3B%0Aimport%20%7BreadReviewedOverlayProviderSuccession%2CverifyReviewedOverlayProviderSuccession%2C%0A%20%20restoreReviewedOverlayProviderPolicy%2CrestoreReviewedOverlayProviderReceiptSource%2C%0A%20%20OVERLAY_PROVIDER_ORIGINAL_PACKET%2COVERLAY_PROVIDER_APPEND_REVIEW%2CderiveReviewedOverlayProviderPolicy%2C%0A%20%20verifyReviewedOverlayProviderSuccessionHistory%2CrestoreReviewedOverlayProviderModuleSource%7D%0A%20%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fprovider-succession.mjs%27%3B%0Aimport%20%7BgenerateReviewedOverlayProviderSuccession%7D%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fgenerate-provider-succession.mjs%27%3B%0Aimport%20%7BrustTextCertificateOverlayRecords%7D%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fgenerate.mjs%27%3B%0Aimport%20%7BrawBindingCertificateOverlayRecords%7D%20from%20%27..%2F..%2Fexperiments%2Frust-raw-binding-certificate-adapter%2Fgenerate-overlay.mjs%27%3B%0Aimport%20%7BcreateRustTextCertificatePublicOverlay%7D%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fruntime.mjs%27%3B%0Aimport%20%7BcreateRustRawBindingCertificateOverlay%7D%20from%20%27..%2F..%2Fexperiments%2Frust-raw-binding-certificate-adapter%2Fruntime.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%2Cread%3Dfile%3D%3EreadFileSync%28new%20URL%28file