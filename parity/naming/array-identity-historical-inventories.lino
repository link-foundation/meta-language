(31794: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Project%20two%20complete%20already%20certified%20sources%3B%20retain%20the%20driver%20predecessor.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%2CwriteFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BreadBootstrapStructuredDataLino%7D%20from%20%27..%2F..%2Fscripts%2Flib%2Fstructured-data-bootstrap.mjs%27%3B%0Aimport%20%7BcaptureGitArtifactCertificate%7D%20from%20%27.%2Fcapture-git-artifact-certificate.mjs%27%3B%0Aimport%20%7BreadOwnCodebaseHistoricalNamingPolicy%2CverifyOwnCodebaseHistoricalNamingSources%7D%20from%20%27.%2Fown-codebase-baseline-naming-history.mjs%27%3B%0Aimport%20%7BcheckProjectData%2CwriteProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20pin%3Dbytes%3D%3E%28%7Bbytes%3ABuffer.byteLength%28bytes%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%7D%29%3B%0A%0A%2F%2A%2A%20Reproduce%20the%20exact%20compact%20offline%20history%20and%20the%20additive%20driver.%20%2A%2F%0Aexport%20function%20generateOwnCodebaseHistoricalNamingSources%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%7B%0A%20%20const%20policy%3DreadOwnCodebaseHistoricalNamingPolicy%28%29%2CarchiveBytes%3DreadFileSync%28new%20URL%28policy.sourceArchive.path%2Croot%29%29%3B%0A%20%20assert.deepEqual%28pin%28archiveBytes%29%2C%7Bbytes%3Apolicy.sourceArchive.bytes%2Csha256%3Apolicy.sourceArchive.sha256%7D%29%3B%0A%20%20let%20archive%3DreadBootstrapStructuredDataLino%28archiveBytes.toString%28%27utf8%27%29%29%3B%0A%20%20assert.equal%28archive.revision%2Cpolicy.revision%29%3Bassert.equal%28archive.sources.length%2Cpolicy.sourceArchive.sources%29%3B%0A%20%20const%20views%3Dpolicy.views.map%28view%3D%3E%7B%0A%20%20%20%20const%20selected%3Darchive.sources.filter%28row%3D%3Erow.file%3D%3D%3Dview.file%29%3Bassert.equal%28selected.length%2C1%29%3Bconst%20row%3Dselected%5B0%5D%3B%0A%20%20%20%20assert.equal%28row.commit%2Cpolicy.revision%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28view.file%2Croot%29%29%29%2Cview.current%29%3B%0A%20%20%20%20return%20%7B...view%2Cpredecessor%3A%7Bsource%3Arow.sourceText%2Cbytes%3Arow.bytes%2Csha256%3Arow.sha256%2Ccertificate%3AstructuredClone%28row.certificate%29%7D%7D%3B%0A%20%20%7D%29%3B%0A%20%20archive%3Dnull%3Bglobal.gc%3F.%28%29%3B%0A%20%20const%20original%3DcaptureGitArtifactCertificate%28policy.revision%2Cpolicy.driver.file%29%3B%0A%20%20assert.deepEqual%28pin%28original.blob%29%2Cpolicy.driver.original%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3Apolicy.schemaVersion%2Cmodel%3Apolicy.model%2Crevision%3Apolicy.revision%2CsourceArchive%3Apolicy.sourceArchive%2C%0A%20%20%20%20views%2Cdriver%3A%7B...policy.driver%2Csource%3Aoriginal.blob.toString%28%27utf8%27%29%2Ccertificate%3Aoriginal.certificate%7D%7D%3B%0A%20%20verifyOwnCodebaseHistoricalNamingSources%28history%29%3B%0A%20%20let%20current%3Dhistory.driver.source%3B%0A%20%20for%28const%20edit%20of%20history.driver.edits%29%7Bassert.equal%28current.split%28edit.before%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28edit.before%2C%28%29%3D%3Eedit.after%29%3B%7D%0A%20%20const%20driver%3Dnew%20URL%28policy.driver.file%2Croot%29%2Cactual%3DreadFileSync%28driver%2C%27utf8%27%29%3B%0A%20%20assert.ok%28actual%3D%3D%3Dhistory.driver.source%7C%7Cactual%3D%3D%3Dcurrent%2C%27an%20unknown%20driver%20cannot%20be%20replaced%20or%20certified%27%29%3B%0A%20%20const%20file%3Dnew%20URL%28%27parity%2Fnaming%2Fown-codebase-baseline-naming-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29%7BcheckProjectData%28file%2Chistory%29%3Bassert.equal%28actual%2Ccurrent%29%3B%7D%0A%20%20else%7BwriteProjectData%28file%2Chistory%29%3BwriteFileSync%28driver%2Ccurrent%29%3B%7D%0A%20%20return%20history%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28args.length%3C%3D1%26%26args.every%28arg%3D%3Earg%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateOwnCodebaseHistoricalNamingSources%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Two%20complete%20historical%20source%20inventories%20and%20every%20original%20driver%20byte%20retained%3B%20current%20naming%20policy%20unchanged.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
