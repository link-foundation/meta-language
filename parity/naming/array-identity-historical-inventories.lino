dependent%20compatibility%20controls%27%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28row.sourceText%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.sourceText%29%2C%7Brevision%3Arow.commit%2Cpath%3Arow.file%7D%29%3B%0A%20%20%20%20for%28const%20profile%20of%20row.profiles%29%7B%0A%20%20%20%20%20%20assert.equal%28restoreContinuationHistoricalSource%28actual%2Crow.file%2Cprofile%29%2Crow.sourceText%29%3B%0A%20%20%20%20%20%20assert.equal%28restoreContinuationHistoricalSource%28row.sourceText%2Crow.file%2Cprofile%29%2Crow.sourceText%29%3B%0A%20%20%20%20%20%20assert.equal%28restoreContinuationHistoricalSource%28actual%2B%27%5Cn%23%20unreviewed%5Cn%27%2Crow.file%2Cprofile%29%2Cactual%2B%27%5Cn%23%20unreviewed%5Cn%27%2C%0A%20%20%20%20%20%20%20%20%27unknown%20current%20edits%20cannot%20acquire%20an%20authenticated%20predecessor%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28restoreContinuationHistoricalSource%28actual%2Crow.file%2C%27unregistered%20profile%27%29%2Cactual%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.sourceText%2B%27%5Cn%27%29%2C%7Brevision%3Arow.commit%2Cpath%3Arow.file%7D%29%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0A%0Atest%28%27the%20historical%20author%20retains%20both%20complete%20current%20input%20authorities%20without%20adding%20new%20migration%20rows%27%2C%28%29%3D%3E%7B%0A%20%20const%20files%3D%5B%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%27parity%2Fself-translation%2Fcomplete-declaration-receipts.lino%27%5D%3B%0A%20%20const%20archive%3D%27parity%2Fself-translation%2Fci-39389240046-historical-inputs.lino%27%2CprotectedFiles%3D%5B...files%2Carchive%5D%3B%0A%20%20const%20before%3DprotectedFiles.map%28file%3D%3EreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20const%20history%3DreadProjectData%28new%20URL%28%27parity%2Fself-translation%2Farray-relative-element-history.lino%27%2Croot%29%29%3B%0A%20%20const%20snapshot%3DreadRawConsumingSnapshotSourceProfile%28%29%2Craw%3DreadCurrentOwnCodebaseRawDescriptorPacket%28%29%3B%0A%20%20for%28const%5Bindex%2Cfile%5Dof%20files.entries%28%29%29%7B%0A%20%20%20%20const%20current%3Dbefore%5Bindex%5D%2Crow%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28row%29%3B%0A%20%20%20%20if%28index%3D%3D%3D0%29%7Bconst%20owner%3Dsnapshot.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28owner%29%3Bassert.equal%28current%2Cowner.source%29%3Bassert.deepEqual%28pin%28current%29%2C%7Bbytes%3Aowner.bytes%2Csha256%3Aowner.sha256%7D%29%3B%7D%0A%20%20%20%20else%20assert.deepEqual%28pin%28current%29%2Craw.register.current%2C%27the%20physical%20register%20retains%20its%20exact%20independent%20current%20descriptor%20owner%27%29%3B%0A%20%20%20%20const%20previous%3DrestoreContinuationHistoricalAuthorInput%28current%2Cfile%29%3B%0A%20%20%20%20assert.notEqual%28previous%2Ccurrent%2C%27the%20actual%20current%20input%20and%20selected%20historical%20source%20keep%20distinct%20identities%27%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28previous%29%2Crow.current%2C%27the%20complete%20original%20array-history%20input%20remains%20independently%20pinned%27%29%3B%0A%20%20%20%20assert.equal%28restoreContinuationHistoricalAuthorInput%28previous%2Cfile%29%2Cprevious%29%3B%0A%20%20%20%20assert.equal%28restoreContinuationHistoricalAuthorInput%28current%2C%27unregistered.mjs%27%29%2Ccurrent%29%3B%0A%20%20%20%20if%28index%3D%3D%3D0%29assert.equal%28restoreContinuationHistoricalAuthorInput%28current%2B%27%5Cn%27%2Cfile%29%2Ccurrent%2B%27%5Cn%27%29%3B%0A%20%20%20%20else%20assert.throws%28%28%29%3D%3ErestoreContinuationHistoricalAuthorInput%28current%2B%27%5Cn%27%2Cfile%29%2Cassert.AssertionError%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28pin%28before%5B2%5D%29%2C%7Bbytes%3A10759631%2Csha256%3A%2705e17bf81c6304f36411073ee4853798041e2764164c999ca93888870fb61560%27%7D%29%3B%0A%20%20protectedFiles.forEach%28%