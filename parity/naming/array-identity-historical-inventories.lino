ertificate%2Cblob%2C%7Brevision%2Cpath%7D%29%2Cblob%29%3B%0A%20%20%20%20%20%20return%7Bfile%3Apath%2Cpredecessor%3A%7Brevision%2Csource%3Ablob.toString%28%27utf8%27%29%2C...pin%28blob%29%2Ccertificate%7D%2C%0A%20%20%20%20%20%20%20%20current%3Apin%28readFileSync%28new%20URL%28path%2Croot%29%29%29%7D%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%7D%0A%20%20%2F%2F%20Finish%20Git%20object%20capture%20before%20retaining%20the%20complete%20naming%20inventory.%0A%20%20%2F%2F%20Its%20binding%20graph%20and%20Git%27s%20pack%20buffers%20need%20separate%20memory%20lifetimes.%0A%20%20globalThis.gc%3F.%28%29%3B%0A%20%20const%20%7BNAME_INVENTORIES%7D%3Dawait%20import%28%27.%2Fissue-195-naming.mjs%27%29%3B%0A%20%20const%20views%3D%5B%5D%3B%0A%20%20for%28const%20source%20of%20sources%29%7B%0A%20%20%20%20globalThis.gc%3F.%28%29%3B%0A%20%20%20%20const%20current%3DreadFileSync%28new%20URL%28source.file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28current%29%2Csource.current%2C%27normal%20freshness%20checks%20retain%20every%20complete%20current%20source%20pin%27%29%3B%0A%20%20%20%20for%28const%20entry%20of%20NAME_INVENTORIES.filter%28entry%3D%3E%21entry.words%26%26entry.files.includes%28source.file%29%29%29%7B%0A%20%20%20%20%20%20const%20actual%3Dnew%20Set%28entry.extract%28current%2Csource.file%29%29%3B%0A%20%20%20%20%20%20const%20names%3D%5B...new%20Set%28entry.extract%28source.predecessor.source%2Csource.file%29%29%5D.filter%28name%3D%3E%21actual.has%28name%29%29%0A%20%20%20%20%20%20%20%20.map%28name%3D%3E%28%7Bname%2Crecord%3Aentry.recordOf%3Fentry.recordOf%28name%29%3Aname%7D%29%29%3B%0A%20%20%20%20%20%20if%28names.length%29views.push%28%7Binventory%3Aentry.inventory%2Cfile%3Asource.file%2Crevision%3Asource.predecessor.revision%2Cnames%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20history%3D%7BschemaVersion%3A1%2Cmodel%3A%27array%20identity%20historical%20naming%20inventories%201%27%2Crevision%2Csources%2Cviews%2C%0A%20%20%20%20boundary%3A%27Each%20supplemental%20name%20is%20derived%20by%20its%20unchanged%20scoped%20inventory%20from%20a%20complete%20independently%20Git-certified%20original%20module.%20Every%20actual%20current%20source%20name%20is%20still%20extracted%20first.%20Historical%20definitions%20retain%20their%20original%20concept%20identities%3B%20a%20changed%20current%20body%20gains%20no%20equivalence%20proof%20from%20this%20source%20view.%20Whole%20current%20source%20hashes%20bind%20selection%20and%20unknown%20source%20bytes%20refuse.%20These%20source%20certificates%20do%20not%20establish%20runtime%20execution%20or%20requirement%20completion.%27%7D%3B%0A%20%20if%28check%29%7Bassert.deepEqual%28history%2Cstored%29%3BcheckProjectData%28new%20URL%28file%2Croot%29%2Chistory%29%3B%7D%0A%20%20else%7BwriteProjectData%28new%20URL%28file%2Croot%29%2Chistory%29%3BglobalThis.gc%3F.%28%29%3Bassert.deepEqual%28readOwnCodebaseHistoricalNamingPolicy%28%29.additionalSourceViews%2Chistory%29%3B%7D%0A%20%20return%20history%3B%0A%7D%0A%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28new%20Set%28args%29.size%3D%3D%3Dargs.length%26%26args.every%28arg%3D%3E%5B%27--check%27%2C%27--additional-inventories%27%5D.includes%28arg%29%29%29%3B%0A%20%20if%28args.includes%28%27--additional-inventories%27%29%29%7B%0A%20%20%20%20const%20history%3Dawait%20generateAdditionalOwnCodebaseHistoricalNamingSources%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20%20%20%20console.log%28JSON.stringify%28%7BcertifiedSources%3Ahistory.sources.length%2CscopedViews%3Ahistory.views.length%2ChistoricalNames%3Ahistory.views.reduce%28%28total%2Crow%29%3D%3Etotal%2Brow.names.length%2C0%29%2CnativeExecution%3Afalse%7D%29%29%3B%0A%20%20%7Delse%7B%0A%20%20%20%20generateOwnCodebaseHistoricalNamingSources%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20%20%20%20console.log%28%27Two%20complete%20historical%20source%20inventories%20and%20every%20original%20d