lan%20already%20forwards%20known%20arrays%20unchanged.%0A%20%20%20%20%20%20%20%20if%20%28readArrayFromIterableType%28this.resolve%28object%29%29%3F.form%20%3D%3D%3D%200%29%20%7B%0A%20%20%20%20%20%20%20%20%20%20this.collections.set%28node%2C%20object%29%3B%0A%20%20%20%20%20%20%20%20%20%20return%20object%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20const%20result%20%3D%20%7B%20kind%3A%20%27array%27%2C%20element%3A%20this.fresh%28%29%20%7D%3B%0A%20%20%20%20%20%20%20%20this.iterables.push%28%7B%20object%2C%20result%2C%20where%3A%20node.span%20%7D%29%3B%60%2C%0A%7D%3B%0A%0Aexport%20function%20replayRelativeArrayNullableInference%28source%29%7B%0A%20%20const%20change%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_CHANGE%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28source%29%2CRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.previous%29%3B%0A%20%20assert.equal%28source.split%28change.before%29.length%2C2%2C%27one%20exact%20nullable-array%20iterable%20owner%20interval%27%29%3B%0A%20%20const%20start%3Dsource.indexOf%28change.before%29%2Ccurrent%3Dsource.slice%280%2Cstart%29%2Bchange.after%2Bsource.slice%28start%2Bchange.before.length%29%3B%0A%20%20const%20inverse%3Dcurrent.slice%280%2Cstart%29%2Bchange.before%2Bcurrent.slice%28start%2Bchange.after.length%29%3B%0A%20%20assert.equal%28inverse%2Csource%2C%27the%20complete%20certified%20predecessor%20is%20recovered%20without%20editing%20runtime%20source%27%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28current%29%2CRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.current%29%3B%0A%20%20return%7Bsource%3Acurrent%2Cedits%3A%5B%7Bstart%2Cremoved%3Achange.before%2Cinserted%3Achange.after%7D%5D%7D%3B%0A%7D%0A%0Aconst%20historyPath%3D%27parity%2Fself-translation%2Frelative-array-frontend-source-history.lino%27%3B%0Aconst%20historySha256%3D%27b54d02013f60b289d3b7197a87187497960efb951ceedc7dda117cca43467db3%27%3B%0Alet%20cachedHistory%2CcachedCurrentSource%3B%0Aexport%20const%20relativeArrayFrontendPin%3Dvalue%3D%3E%28%7Bbyte