%0A%20%2A%20successors.%20Reuse%20those%20complete%20inverses%20before%20selecting%20this%20author%27s%0A%20%2A%20original%20cohort%3B%20every%20actual%20current%20gate%20remains%20separate%20and%20unchanged.%20%2A%2F%0Aexport%20function%20restoreContinuationHistoricalAuthorInput%28source%2Cfile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3B%0A%20%20source%3DrestoreRawDescriptorHistoricalSource%28source%2Cfile%2C%27continuation%20historical%20input%27%29%3B%0A%20%20if%28%5B%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%27parity%2Fself-translation%2Fcomplete-declaration-receipts.lino%27%5D.includes%28file%29%29%7B%0A%20%20%20%20let%20historical%3B%0A%20%20%20%20if%28file%3D%3D%3D%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%29historical%3DrestoreRawConsumingSnapshotSource%28Buffer.from%28source%29%2Cfile%2Ctrue%29.toString%28%27utf8%27%29%3B%0A%20%20%20%20else%7B%0A%20%20%20%20%20%20const%20value%3DreadStructuredDataLino%28source%29%3B%0A%20%20%20%20%20%20assert.equal%28serializeProjectData%28value%2Cfile%29%2Csource%2C%27the%20complete%20selected%20register%20spelling%20must%20be%20canonical%20before%20its%20original%20whole-byte%20gates%27%29%3B%0A%20%20%20%20%20%20historical%3DserializeProjectData%28restoreProgramStringSourceDescriptorEdge%28null%2C%27historical%20register%27%2Cvalue%29.register%2Cfile%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20row%3DarrayHistory.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28row%29%3B%0A%20%20%20%20if%28historical%21%3D%3Dsource%7C%7Cpin%28source%29.sha256%3D%3D%3Drow.current.sha256%29%7B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28historical%29%2Crow.current%2C%27the%20entire%20independently%20selected%20historical%20author%20input%20must%20retain%20its%20original%20identity%27%29%3B%0A%20%20%20%20%20%20return%20historical%3B%0A%20%20%20%20%7D%0A%20%20%20%20source%3Dhistorical%3B%0A%20%20%7D%0A%20%20return%20restoreNativeCompatibilitySourceHistory%28file%2Csource%29%3B%0A%7D%0A%0A%2F%2A%2A%20Freeze%20exact%20predecessor%20views%3B%20no%20current%20artifact%20or%20implementation%20is%20rewritten.%20%2A%2F%0Aexport%20function%20generateContinuationHistoricalInputs%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20profiles%3Dnew%20Map%28%29%3B%0A%20%20const%20include%3D%28file%2Cprofile%2Cexpected%29%3D%3E%7B%0A%20%20%20%20const%20entry%3Dprofiles.get%28file%29%3F%3F%7Bprofiles%3A%5B%5D%2Cexpected%7D%3B%0A%20%20%20%20assert.deepEqual%28entry.expected%2Cexpected%29%3Bentry.profiles.push%28profile%29%3Bprofiles.set%28file%2Centry%29%3B%0A%20%20%7D%3B%0A%20%20for%28const%20row%20of%20arrayHistory.sources%29include%28row.file%2C%27relative%20array%27%2Crow.current%29%3B%0A%20%20%2F%2F%20This%20library%20is%20an%20input%20of%20the%20old%20descriptor%20generator%2C%20not%20one%20of%20its%0A%20%20%2F%2F%20outputs.%20Its%20current%20packaging%20is%20verified%20by%20the%20independent%20current%20gate.%0A%20%20const%20library%3D%27parity%2Fself-translation%2Fcollection-construction-rules-native.lino%27%3B%0A%20%20include%28library%2C%27relative%20array%27%2Cpin%28captureGitArtifactCertificate%28revision%2Clibrary%29.blob%29%29%3B%0A%20%20for%28const%20row%20of%20rangeHistory.sources%29include%28row.file%2C%27original%20number%20source%20ranges%27%2Crow.current%29%3B%0A%20%20for%28const%20row%20of%20rangeHistory.unchanged%29include%28row.file%2C%27original%20number%20source%20ranges%27%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20include%28rangeHistory.previousReceipt.file%2C%27original%20number%20source%20ranges%27%2CrangeHistory.currentReceipt%29%3B%0A%20%20const%20sources%3D%5B%5D%3B%0A%20%20for%28const%20%5Bfile%2C%7Bprofiles%3Aroles%2Cexpected%7D%5Dof%20profiles%29%7B%0A%20%20%20%20const%20actual%3DrestoreContinuationHistoricalAuthorInput%28readFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%2Cfile%29%3B%0A%20%20%20%20if%28pin%28actual%29.sha256%3D%3D%3Dexpected.sha256%29continue%3B%0A%20%20%20%20const%20original%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%2CsourceText%3Doriginal.blob.toString%28%27utf8%27%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28original.certificate%2Coriginal.blob%2C%7Brevision%2Cpath%3Afile%7D%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28original.blob%29%2Cexpected%2C%27the%20complete%20historical%20input%20is%20independently%20pinned%27%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.from%28sourceText%29%2Coriginal.blob%29%3B%0A%20%20%20%20let%20start%3D0%2Cend%3DsourceText.length%2Cfinish%3Dactual.length%3B%0A%20%20%20%20while%28start%3Cend%26%26start%3Cfinish%26%26sourceText%5Bstart%5D%3D%3D%3Dactual%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20while%28end%3Estart%26%26finish%3Estart%26%26sourceText%5Bend-1%5D%3D%3D%3Dactual%5Bfinish-1%5D%29%7Bend--%3Bfinish--%3B%7D%0A%20%20%20%20%2F%2F%20Common%20prefixes%2Fsuffixes%20may%20split%20a%20surrogate%20pair%3B%20keep%20each%20edit%20on%0A%20%20%20%20%2F%2F%20UTF-8%20scalar%20boundaries%20so%20every%20saved%20spelling%20has%20an%20exact%20byte%20inverse.%0A%20%20%20%20if%28start%3E0%26%26%2F%5B%5CuDC00-%5CuDFFF%5D%2Fu.test%28sourceText%5Bstart%5D%3F%3F%27%27%29%29start--%3B%0A%20%20%20%20if%28end%3CsourceText.length%26%26%2F%5B%5CuDC00-%5CuDFFF%5D%2Fu.test%28sourceText%5Bend%5D%3F%3F%27%27%29%29%7Bend%2B%2B%3Bfinish%2B%2B%3B%7D%0A%20%20%20%20const%20edit%3D%7BoffsetUnit%3A%27UTF-8%20bytes%27%2Cstart%3ABuffer.byteLength%28actual.slice%280%2Cstart%29%29%2Cend%3ABuffer.byteLength%28actual.slice%280%2Cfinish%29%29%2C%0A%20%20%20%20%20%20removed%3AsourceText.slice%28start%2Cend%29%2Cinserted%3Aactual.slice%28start%2Cfinish%29%7D%3B%0A%20%20%20%20const%20bytes%3DBuffer.from%28actual%29%2Cinverse%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20assert.ok%28inverse.equals%28original.blob%29%29%3B%0A%20%20%20%20sources.push%28%7Bfile%2Cprofiles%3Aroles%2Ccommit%3Arevision%2C...expected%2CsourceText%2Ccertificate%3Aoriginal.certificate%2Ccurrent%3Apin%28actual%29%2Cedit%7D%29%3B%0A%20%20%7D%0A%20%20const%20value%3D%7BschemaVersion%3A1%2Crevision%2Crun%3A39389240046%2Csources%2C%0A%20%20%20%20boundary%3A%27Exact%20historical%20input%20views%20only.%20Current%20implementations%20and%20artifacts%20retain%20independent%20current%20gates.%20Unknown%20successors%20are%20never%20authenticated%20by%20these%20views.%20Every%20original%20historical%20assertion%20and%20its%20complete%20input%20remain%20required.%20This%20record%20proves%20source%20preservation%2C%20not%20native%20execution%20or%20semantic%20equivalence.%27%7D%3B%0A%20%20const%20output%3Dnew%20URL%28%27parity%2Fself-translation%2Fci-39389240046-historical-inputs.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28output%2Cvalue%29%3Belse%20writeProjectData%28output%2Cvalue%29%3B%0A%20%20const%20helperFile%3Dnew%20URL%28%27js%2Fscripts%2Fcontinuation-source-history.mjs%27%2Croot%29%2Csource%3DreadFileSync%28helperFile%2C%27utf8%27%29%3B%0A%20%20const%20expected%3Dsource.replace%28%2Fconst%20historyHash%3D%27%28%3F%3A%5Ba-f0-9%5D%7B64%7D%7CPENDING%29%27%3B%2Fu%2C%22const%20historyHash%3D%27%22%2Bpin%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28helperFile%2Cexpected%29%3B%0A%20%20return%20value%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20value%3DgenerateContinuationHistoricalInputs%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Preserved%20%27%2Bvalue.sources.length%2B%27%20complete%20certified%20historical%20inputs%20and%20exact%20current%20guards.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
