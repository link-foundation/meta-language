%20assert.equal%28restoreTranslationWorkflowHistory%28current%2B%27%5Cn%23%20changed%5Cn%27%29%2Ccurrent%2B%27%5Cn%23%20changed%5Cn%27%29%3B%0A%20%20%7D%0A%20%20const%20workflow%3Dread%28%27.github%2Fworkflows%2Fjs.yml%27%29%3B%0A%20%20const%20tests%3DparseWorkflow%28workflow%29.find%28job%3D%3Ejob.id%3D%3D%3D%27tests%27%29%3B%0A%20%20assert.match%28tests.header%2C%2Ftimeout-minutes%3A%2015%2Fu%29%3Bassert.match%28tests.header%2C%2Ffail-fast%3A%20false%2Fu%29%3B%0A%20%20const%20entries%3D%5B...tests.header.matchAll%28%2F%5C%7Bgroup%3A%20translation%2C%20partition%3A%20%28%5B0-9%5D%2B%29%2C%20shards%3A%20%28%5B0-9%5D%2B%29%5C%7D%2Fgu%29%5D%0A%20%20%20%20.map%28%28%5B%2Cindex%2Ccount%5D%29%3D%3E%5BNumber%28index%29%2CNumber%28count%29%5D%29%3B%0A%20%20assert.deepEqual%28entries%2C%5B%5B1%2C6%5D%2C%5B2%2C6%5D%2C%5B3%2C6%5D%2C%5B4%2C6%5D%2C%5B5%2C6%5D%2C%5B6%2C6%5D%5D%29%3B%0A%20%20assert.ok%28workflow.includes%28%27--partitions%20%22%24%7B%7B%20matrix.shards%20%7D%7D%22%27%29%29%3B%0A%20%20assert.ok%28workflow.includes%28%27pattern%3A%20translation-test-feedback-%24%7B%7B%20github.sha%20%7D%7D-%2A-of-6%27%29%29%3B%0A%20%20assert.match%28workflow%2C%2Fmerge%20%5C%5C%5Cn%5Cs%2B--partitions%206%2Fu%29%3B%0A%20%20const%20files%3DpartitionTests%28testFiles%28%29%29.groups.translation%3B%0A%20%20const%20assigned%3Dentries.flatMap%28%28%5Bindex%2Ccount%5D%29%3D%3EpartitionGroupFiles%28files%2Cindex%2B%27%2F%27%2Bcount%29%29%3B%0A%20%20assert.equal%28new%20Set%28assigned%29.size%2Cassigned.length%29%3Bassert.deepEqual%28assigned.toSorted%28%29%2Cfiles.toSorted%28%29%29%3B%0A%20%20const%20originalFiles%3DexecFileSync%28%27git%27%2C%5B%27ls-tree%27%2C%27-r%27%2C%27--name-only%27%2Chistory.revision%2C%27js%2Ftests%27%5D%2C%0A%20%20%20%20%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2CmaxBuffer%3A2%2A1024%2A1024%7D%29.split%28%27%5Cn%27%29%0A%20%20%20%20.filter%28file%3D%3E%2F%5Ejs%5C%2Ftests%5C%2F%5B%5E%2F%5D%2B%5C.test%5C.js%24%2Fu.test%28file%29%29.map%28file%3D%3Efile.slice%28%27js%2Ftests%2F%27.length%29%29%3B%0A%20%20for%28const%20file%20of%20partitionTests%28originalFiles%29.groups.translation%29assert.ok%28files.includes%28file%29%2Cfile%29%3B%0A%7D%29%3B%0A%0Atest%28%27six%20feedback%20partitions%20merge%20exact%20scope%20and%20bytes%20while%20missing%20foreign%20and%20tampered%20cohorts%20refuse%27%2C%28t%29%3D%3E%7B%0A%20%20const%20root%3DrealpathSync%28mkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-six-feedback-%27%29%29%29%3B%0A%20%20t.after%28%28%29%3D%3ErmSync%28root%2C%7Brecursive%3Atrue%7D%29%29%3B%0A%20%20mkdirSync%28join%28root%2C%27js%2Ftests%27%29%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3C6%3Bindex%2B%2B%29writeFileSync%28join%28root%2C%27js%2Ftests%2Ftranslation-%27%2Bindex%2B%27.test.js%27%29%2C%27%27%29%3B%0A%20%20const%20payload%3D%27issue-195-artifacts%2Fcompiler-feedback%2Fsource.lino%27%3B%0A%20%20mkdirSync%28join%28root%2C%27issue-195-artifacts%2Fcompiler-feedback%27%29%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20writeFileSync%28join%28root%2Cpayload%29%2C%27%28retained%20compiler%20bytes%29%5Cn%27%29%3B%0A%20%20const%20commit%3D%27a%27.repeat%2840%29%2CinputDirectory%3Djoin%28root%2C%27parts%27%29%2Cdirectories%3D%5B%5D%3B%0A%20%20const%20capture%3Dindex%3D%3EcaptureTranslationTestFeedbackPartition%28%7Broot%2Ccommit%2Cpartitions%3A6%2C%0A%20%20%20%20shard%3A%28index%2B1%29%2B%27%2F6%27%2CoutputDirectory%3Ajoin%28inputDirectory%2C%27translation-test-feedback-%27%2Bcommit%2B%27-%27%2B%28index%2B1%29%2B%27-of-6%27%29%7D%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3C6%3Bindex%2B%2B%29%7B%0A%20%20%20%20const%20receipt%3Dcapture%28index%29%3Bassert.equal%28receipt.files.length%2C1%29%3B%0A%20%20%20%20directories.push%28join%28inputDirectory%2C%27translation-test-feedback-%27%2Bcommit%2B%27-%27%2B%28index%2B1%29%2B%27-of-6%27%29%29%3B%0A%20%20%7D%0A%20%20const%20arguments_%3D%7Broot%2Ccommit%2CinputDirectory%2Cpartitions%3A6%2CoutputDirectory%3Ajoin%28root%2C%27merged%27%29%7D%3B%0A%20%20const%20