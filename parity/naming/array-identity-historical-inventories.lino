lan%20already%20forwards%20known%20arrays%20unchanged.%0A%20%20%20%20%20%20%20%20if%20%28readArrayFromIterableType%28this.resolve%28object%29%29%3F.form%20%3D%3D%3D%200%29%20%7B%0A%20%20%20%20%20%20%20%20%20%20this.collections.set%28node%2C%20object%29%3B%0A%20%20%20%20%20%20%20%20%20%20return%20object%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20const%20result%20%3D%20%7B%20kind%3A%20%27array%27%2C%20element%3A%20this.fresh%28%29%20%7D%3B%0A%20%20%20%20%20%20%20%20this.iterables.push%28%7B%20object%2C%20result%2C%20where%3A%20node.span%20%7D%29%3B%60%2C%0A%7D%3B%0A%0Aexport%20function%20replayRelativeArrayNullableInference%28source%29%7B%0A%20%20const%20change%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_CHANGE%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28source%29%2CRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.previous%29%3B%0A%20%20assert.equal%28source.split%28change.before%29.length%2C2%2C%27one%20exact%20nullable-array%20iterable%20owner%20interval%27%29%3B%0A%20%20const%20start%3Dsource.indexOf%28change.before%29%2Ccurrent%3Dsource.slice%280%2Cstart%29%2Bchange.after%2Bsource.slice%28start%2Bchange.before.length%29%3B%0A%20%20const%20inverse%3Dcurrent.slice%280%2Cstart%29%2Bchange.before%2Bcurrent.slice%28start%2Bchange.after.length%29%3B%0A%20%20assert.equal%28inverse%2Csource%2C%27the%20complete%20certified%20predecessor%20is%20recovered%20without%20editing%20runtime%20source%27%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28current%29%2CRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.current%29%3B%0A%20%20return%7Bsource%3Acurrent%2Cedits%3A%5B%7Bstart%2Cremoved%3Achange.before%2Cinserted%3Achange.after%7D%5D%7D%3B%0A%7D%0A%0Aconst%20historyPath%3D%27parity%2Fself-translation%2Frelative-array-frontend-source-history.lino%27%3B%0Aconst%20historySha256%3D%27b54d02013f60b289d3b7197a87187497960efb951ceedc7dda117cca43467db3%27%3B%0Alet%20cachedHistory%2CcachedCurrentSource%3B%0Aexport%20const%20relativeArrayFrontendPin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20exactKeys%3D%28value%2Ckeys%29%3D%3E%7Bassert.ok%28value%26%26typeof%20value%3D%3D%3D%27object%27%26%26%21Array.isArray%28value%29%29%3Bassert.deepEqual%28Object.keys%28value%29.sort%28%29%2Ckeys.slice%28%29.sort%28%29%29%3B%7D%3B%0A%0Aexport%20function%20replayRelativeArrayFrontendHost%28source%29%7B%0A%20%20let%20current%3Dsource%3Bconst%20edits%3D%5B%5D%3B%0A%20%20for%28const%20change%20of%20RELATIVE_ARRAY_FRONTEND_HOST_CHANGES%29%7B%0A%20%20%20%20assert.equal%28current.split%28change.before%29.length%2C2%2C%27one%20exact%20existing%20relative-array%20source%20adapter%20interval%27%29%3B%0A%20%20%20%20const%20start%3Dcurrent.indexOf%28change.before%29%3Bedits.push%28%7Bstart%2Cremoved%3Achange.before%2Cinserted%3Achange.after%7D%29%3B%0A%20%20%20%20current%3Dcurrent.slice%280%2Cstart%29%2Bchange.after%2Bcurrent.slice%28start%2Bchange.before.length%29%3B%0A%20%20%7D%0A%20%20let%20inverse%3Dcurrent%3B%0A%20%20for%28const%20edit%20of%20edits.toReversed%28%29%29%7B%0A%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%7D%0A%20%20assert.equal%28inverse%2Csource%2C%27every%20source%20input%20original%20assertion%20descriptor%20field%20and%20native%20receipt%20stays%20exact%27%29%3B%0A%20%20return%7Bsource%3Acurrent%2Cedits%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Reuse%20the%20current%20source%20authority%3B%20do%20not%20invent%20a%20descriptor%20pin%20or%0A%20%2A%20identify%20the%20distinct%20older%20and%20current%20source%20definitions%20as%20equivalent.%20%2A%2F%0Aexport%20function%20readAuthenticatedCurrentRelativeArrayFrontend%28%29%7B%0A%20%20if%28cachedCurrentSource%3D%3D%3Dundefined%29%7B%0A%20%20%20%20const%20policy%3DreadOwnCodebaseRawDescriptorPolicy%28%29%2Cpacket%3DreadOwnCodebaseRawDescriptorPacket%28%29%3B%0A%20%20%20%20assert.equal%28packet.sourceOwner.file%2Cpolicy.sourceFile%29%3B%0A%20%20%20%20cachedCurrentSource%3DderiveOwnCodebaseRawDescriptorSource%28policy.sourceOwner%2Cpacket.sourceOwner.sourceText%29%3B%0A%20%20%20%20assert.deepEqual%28relativeArrayFrontendPin%28cachedCurrentSource%29%2Cpolicy.sourceOwner.current%29%3B%0A%20%20%7D%0A%20%20return%20cachedCurrentSource%3B%0A%7D%0A%0A%2F%2A%2A%20The%20compact%20projection%20contains%20the%20complete%20old%20source%20and%20its%20original%0A%20%2A%20Git%20membership.%20Normal%20verification%20never%20reloads%20the%20large%20naming%20archive.%20%2A%2F%0Aexport%20function%20verifyRelativeArrayFrontendSourceHistory%28history%29%7B%0A%20%20exactKeys%28history%2C%5B%27schemaVersion%27%2C%27model%27%2C%27profile%27%2C%27sourceArchive%27%2C%27historical%27%2C%27currentAuthority%27%2C%27nullableInference%27%2C%27host%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28history.schemaVersion%2C2%29%3Bassert.equal%28history.model%2C%27relative%20array%20frontend%20descriptor%20historical%20source%202%27%29%3B%0A%20%20assert.equal%28history.profile%2CRELATIVE_ARRAY_FRONTEND_PROFILE%29%3B%0A%20%20const%20naming%3DreadOwnCodebaseHistoricalNamingPolicy%28%29%2Ccurrent%3DreadOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20assert.deepEqual%28history.sourceArchive%2C%7Brevision%3Anaming.revision%2C...naming.sourceArchive%7D%29%3B%0A%20%20exactKeys%28history.historical%2C%5B%27file%27%2C%27commit%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%5D%29%3B%0A%20%20const%20previous%3Dcurrent.artifactDescriptorPrevious%3B%0A%20%20assert.deepEqual%28%7Bfile%3Ahistory.historical.file%2Cbytes%3Ahistory.historical.bytes%2Csha256%3Ahistory.historical.sha256%7D%2Cprevious%29%3B%0A%20%20assert.equal%28history.historical.commit%2Cnaming.revision%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28history.historical.sourceText%29%2C%7Bbytes%3Aprevious.bytes%2Csha256%3Aprevious.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28history.historical.certificate%2CBuffer.from%28history.historical.sourceText%29%2C%7Brevision%3Anaming.revision%2Cpath%3Aprevious.file%7D%29%3B%0A%20%20assert.deepEqual%28history.currentAuthority%2C%7Brevision%3Acurrent.revision%2Cfile%3Acurrent.sourceFile%2C%0A%20%20%20%20predecessor%3Acurrent.sourceOwner.predecessor%2Ccurrent%3Acurrent.sourceOwner.current%7D%29%3B%0A%20%20const%20inference%3Dhistory.nullableInference%2CexpectedInference%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE%3B%0A%20%20exactKeys%28inference%2C%5B%27path%27%2C%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.equal%28inference.path%2CexpectedInference.path%29%3Bassert.equal%28inference.revision%2CexpectedInference.revision%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Ainference.bytes%2Csha256%3Ainference.sha256%7D%2CexpectedInference.previous%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28inference.sourceText%29%2CexpectedInference.previous%29%3B%0A%20%20verifyGitArtifactCertificate%28inference.certificate%2CBuffer.from%28inference.sourceText%29%2C%7Brevision%3AexpectedInference.revision%2Cpath%3AexpectedInference.path%7D%29%3B%0A%20%20const%20inferenceReplay%3DreplayRelativeArrayNullableInference%28inference.sourceText%29%3B%0A%20%20assert.deepEqual%28inference.current%2CexpectedInference.current%29%3Bassert.deepEqual%28inference.edits%2CinferenceReplay.edits%29%3B%0A%20%20exactKeys%28history.host%2C%5B%27path%27%2C%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.deepEqual%28%7Bpath%3Ahistory.host.path%2Crevision%3Ahistory.host.revision%2Cbytes%3Ahistory.host.bytes%2Csha256%3Ahistory.host.sha256%7D%2CRELATIVE_ARRAY_FRONTEND_HOST%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28history.host.sourceText%29%2C%7Bbytes%3ARELATIVE_ARRAY_FRONTEND_HOST.bytes%2Csha256%3ARELATIVE_ARRAY_FRONTEND_HOST.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28history.host.certificate%2CBuffer.from%28history.host.sourceText%29%2C%7Brevision%3ARELATIVE_ARRAY_FRONTEND_HOST.revision%2Cpath%3ARELATIVE_ARRAY_FRONTEND_HOST.path%7D%29%3B%0A%20%20const%20replay%3DreplayRelativeArrayFrontendHost%28history.host.sourceText%29%3B%0A%20%20assert.deepEqual%28history.host.current%2CrelativeArrayFrontendPin%28replay.source%29%29%3Bassert.deepEqual%28history.host.edits%2Creplay.edits%29%3B%0A%20%20return%7Bsource%3Ahistory.historical.sourceText%2Chost%3Areplay.source%2CinferenceSource%3Ainference.sourceText%2CcurrentInference%3AinferenceReplay.source%7D%3B%0A%7D%0A%0Aexport%20function%20readRelativeArrayFrontendSourceHistory%28%29%7B%0A%20%20if%28%21cachedHistory%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28historyPath%2Croot%29%29%3Bassert.equal%28relativeArrayFrontendPin%28bytes%29.sha256%2ChistorySha256%29%3B%0A%20%20%20%20cachedHistory%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20const%20verified%3DverifyRelativeArrayFrontendSourceHistory%28cachedHistory%29%3B%0A%20%20%20%20assert.equal%28readFileSync%28new%20URL%28RELATIVE_ARRAY_FRONTEND_HOST.path%2Croot%29%2C%27utf8%27%29%2Cverified.host%2C%27only%20the%20exact%20two%20scoped%20host%20edits%20are%20admitted%27%29%3B%0A%20%20%20%20assert.equal%28readFileSync%28new%20URL%28RELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.path%2Croot%29%2C%27utf8%27%29%2Cverified.currentInference%2C%27the%20actual%20nullable-array%20successor%20retains%20its%20separate%20current%20runtime%20source%27%29%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28cachedHistory%29%3B%0A%7D%0A%0A%2F%2A%2A%20This%20function%20is%20called%20only%20by%20the%20historical%20relative-array%20generator.%0A%20%2A%20Other%20profiles%2Ffiles%20are%20identities%3B%20unknown%20selected%20successors%20refuse.%20%2A%2F%0Aexport%20function%20restoreRelativeArrayFrontendDescriptorSource%28source%2Cfile%2Cprofile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bassert.equal%28typeof%20profile%2C%27string%27%29%3B%0A%20%20source%3DrestoreRelativeArrayCurrentSourceView%28source%2Cfile%2Cprofile%29%3B%0A%20%20source%3DrestoreRelativeArrayCurrentFrontendSource%28source%2Cfile%2Cprofile%29%3B%0A%20%20const%20policy%3DreadOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20if%28profile%21%3D%3DRELATIVE_ARRAY_FRONTEND_PROFILE%29return%20source%3B%0A%20%20if%28file%3D%3D%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.path%29%7B%0A%20%20%20%20const%20history%3DreadRelativeArrayFrontendSourceHistory%28%29%2Cprevious%3Dhistory.nullableInference.sourceText%3B%0A%20%20%20%20if%28source%3D%3D%3Dprevious%29return%20source%3B%0A%20%20%20%20assert.deepEqual%28relativeArrayFrontendPin%28source%29%2CRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.current%2C%27an%20unknown%20nullable-inference%20successor%20has%20no%20relative-array%20historical%20authority%27%29%3B%0A%20%20%20%20assert.equal%28source%2CreplayRelativeArrayNullableInference%28previous%29.source%2C%27the%20complete%20current%20nullable-inference%20source%20has%20one%20certified%20finite%20inverse%27%29%3B%0A%20%20%20%20return%20previous%3B%0A%20%20%7D%0A%20%20if%28file%21%3D%3Dpolicy.sourceFile%29return%20source%3B%0A%20%20const%20history%3DreadRelativeArrayFrontendSourceHistory%28%29%2Cprevious%3Dhistory.historical.sourceText%3B%0A%20%20if%28source%3D%3D%3Dprevious%29return%20source%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28source%29%2Cpolicy.sourceOwner.current%2C%27an%20unknown%20frontend%20successor%20has%20no%20relative-array%20historical%20authority%27%29%3B%0A%20%20assert.equal%28source%2CreadAuthenticatedCurrentRelativeArrayFrontend%28%29%2C%27the%20actual%20complete%20current%20frontend%20is%20authenticated%20through%20its%20existing%20source%20receipt%27%29%3B%0A%20%20return%20previous%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
