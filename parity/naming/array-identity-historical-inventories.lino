(74154: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20CI%20runs%20the%20JavaScript%20tests%20as%20one%20job%20per%20group%20of%20scripts%2Ftest-groups.mjs.%0A%2F%2F%20These%20checks%20keep%20every%20test%20file%20in%20exactly%20one%20group%20and%20the%20workflow%0A%2F%2F%20running%20every%20group%20before%20the%20JavaScript%20Package%20check%20passes.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7B%20createHash%20%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7B%20execFileSync%20%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7B%20readFile%20%7D%20from%20%27node%3Afs%2Fpromises%27%3B%0Aimport%20%7B%20fileURLToPath%20%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7B%20test%20%7D%20from%20%27node%3Atest%27%3B%0A%0Aimport%20%7B%20TEST_GROUPS%2C%20partitionGroupFiles%2C%20partitionProblems%2C%20partitionTests%2C%20testFiles%20%7D%20from%20%27..%2Fscripts%2Ftest-groups.mjs%27%3B%0Aimport%20%7B%20readProjectData%20%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0A%0Atest%28%27CI%20file%20partitions%20preserve%20every%20original%20native%2C%20conformance%20and%20translation%20file%20exactly%20once%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20groups%20%3D%20partitionTests%28testFiles%28%29%29.groups%3B%0A%20%20for%20%28const%20%5Bname%2C%20count%5D%20of%20%5B%5B%27grammar%27%2C%203%5D%2C%20%5B%27grammar-native%27%2C%203%5D%2C%20%5B%27grammar-native%27%2C%206%5D%2C%20%5B%27conformance%27%2C%202%5D%2C%20%5B%27conformance%27%2C%204%5D%2C%20%5B%27translation%27%2C%203%5D%5D%29%20%7B%0A%20%20%20%20const%20shards%20%3D%20Array.from%28%7B%20length%3A%20count%20%7D%2C%20%28_%2C%20index%29%20%3D%3E%20partitionGroupFiles%28groups%5Bname%5D%2C%20%60%24%7Bindex%20%2B%201%7D%2F%24%7Bcount%7D%60%29%29%3B%0A%20%20%20%20assert.ok%28shards.every%28files%20%3D%3E%20files.length%20%3E%200%29%29%3B%0A%20%20%20%20assert.equal%28new%20Set%28shards.flat%28%29%29.size%2C%20groups%5Bname%5D.length%29%3B%0A%20%20%20%20assert.deepEqual%28shar