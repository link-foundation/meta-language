IPTOR_HISTORICAL_FILE%2Croot%29%29%2Cblob%2C%27unknown%20live%20descriptors%20require%20another%20reviewed%20source%20epoch%27%29%3B%0A%20%20const%20borrowed%3DcaptureGitArtifactCertificate%28RAW_DESCRIPTOR_HISTORICAL_REVISION%2CRAW_DESCRIPTOR_BORROWED_FILE%29%2CborrowedCurrent%3Dborrowed.blob.toString%28%27utf8%27%29%3B%0A%20%20assert.deepEqual%28Buffer.from%28borrowedCurrent%29%2Cborrowed.blob%29%3Bassert.deepEqual%28pinRawDescriptorHistoricalSource%28borrowed.blob%29%2CRAW_DESCRIPTOR_BORROWED_CURRENT%29%3B%0A%20%20assert.deepEqual%28readFileSync%28new%20URL%28RAW_DESCRIPTOR_BORROWED_FILE%2Croot%29%29%2Cborrowed.blob%2C%27unknown%20borrowed%20receipt%20successors%20refuse%27%29%3B%0A%20%20const%20borrowedPrevious%3DreadRawDescriptorBorrowedAuthority%28%29.source%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27raw%20descriptor%20historical%20cohort%201%27%2Cfile%3ARAW_DESCRIPTOR_HISTORICAL_FILE%2Crevision%3ARAW_DESCRIPTOR_HISTORICAL_REVISION%2C%0A%20%20%20%20archive%3A%7Bfile%3ARAW_DESCRIPTOR_HISTORICAL_ARCHIVE%2C...RAW_DESCRIPTOR_HISTORICAL_ARCHIVE_PIN%2Cidentity%3A%27raw%20consuming%27%7D%2C%0A%20%20%20%20previous%3A%7Brevision%3Aold.commit%2C...RAW_DESCRIPTOR_HISTORICAL_PREVIOUS%7D%2Ccurrent%3A%7B...RAW_DESCRIPTOR_HISTORICAL_CURRENT%2Ccertificate%7D%2C%0A%20%20%20%20edits%3AderiveRawDescriptorHistoricalChanges%28old.sourceText%2Ccurrent%29%2C%0A%20%20%20%20borrowed%3A%7Bfile%3ARAW_DESCRIPTOR_BORROWED_FILE%2C%0A%20%20%20%20%20%20archive%3A%7Bfile%3ARAW_DESCRIPTOR_CONTINUATION_ARCHIVE%2C...RAW_DESCRIPTOR_CONTINUATION_ARCHIVE_PIN%2Csource%3ARAW_DESCRIPTOR_BORROWED_FILE%2Cprofile%3A%27relative%20array%27%7D%2C%0A%20%20%20%20%20%20previous%3A%7B...RAW_DESCRIPTOR_BORROWED_PREVIOUS%7D%2Ccurrent%3A%7B...RAW_DESCRIPTOR_BORROWED_CURRENT%2Ccertificate%3Aborrowed.certificate%7D%2C%0A%20%20%20%20%20%20edit%3AderiveRawDescriptorBorrowedChange%28borrowedPrevious%2CborrowedCurrent%29%7D%2C%0A%20%20%20%20boundary%3A%27Complete%20committed%20descriptor%20metadata%20only%3B%20unchanged%20definitions%2C%20source%20identities%20and%20historical%20gates.%20This%20is%20not%20native%20execution%20or%20semantic%20equivalence.%27%7D%3B%0A%20%20verifyRawDescriptorHistoricalCohort%28packet%29%3B%0A%20%20const%20output%3Dnew%20URL%28RAW_DESCRIPTOR_HISTORICAL_OUTPUT%2Croot%29%3Bif%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20%20const%20helper%3Dnew%20URL%28%27js%2Fscripts%2Fraw-descriptor-historical-cohort.mjs%27%2Croot%29%2Csource%3DreadFileSync%28helper%2C%27utf8%27%29%3B%0A%20%20const%20pattern%3D%2F%5Econst%20packetSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%24%2Fmu%3Bassert.equal%28source.split%28pattern%29.length%2C2%29%3B%0A%20%20const%20expected%3Dsource.replace%28pattern%2C%22const%20packetSha256%3D%27%22%2BpinRawDescriptorHistoricalSource%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28helper%2Cexpected%29%3Breturn%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateRawDescriptorHistoricalCohort%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Authenticated%20one%20whole%20current%20raw%20descriptor%20and%20two%20exact%20historical%20views%20without%20duplicating%20its%20predecessor%20body.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
