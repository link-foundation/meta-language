(190946: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Complete%20source-only%20bridge%20before%20existing%20historical%20native%20reader%20chains.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadBootstrapStructuredDataLino%7D%20from%20%27..%2F..%2Fscripts%2Flib%2Fstructured-data-bootstrap.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BreplayRequiredFieldNativeHostIntervals%7D%20from%20%27.%2Frequired-field-native-host-succession.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aexport%20const%20CURRENT_NATIVE_HOST_REVISION%3D%278d77e476d097448eb381ebe03e2aa173402bc03d%27%3B%0Aexport%20const%20CURRENT_NATIVE_HOST_OUTPUT%3D%27parity%2Fself-translation%2Fci-39539903548-native-host-source-history.lino%27%3B%0Aexport%20const%20CURRENT_NATIVE_HOST_FILES%3DObject.freeze%28%5B%27rust%2Fsrc%2Fself_translation.rs%27%2C%27rust%2Fsrc%2Ftranslation%2Fmod.rs%27%2C%27rust%2Ftests%2Funit%2Fmod.rs%27%2C%27rust%2Fsrc%2Ftranslation%2Fjavascript%2Fexpressions%2Fvalues.rs%27%5D%29%3B%0Aconst%20packetSha256%3D%27c6b6f5db65721cdef6138af14c66a7895bc99fe3165f6248fd3047e7134d8a06%27%3B%0Alet%20cached%3B%0Aexport%20const%20pinCurrentNativeHostSource%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20exactKeys%3D%28value%2Ckeys%29%3D%3E%7Bassert.ok%28value%26%26typeof%20value%3D%3D%3D%27object%27%26%26%21Array.isArray%28value%29%29%3Bassert.deepEqual%28Object.keys%28value%29.sort%28%29%2C%5B...keys%5D.sort%28%29%29%3B%7D%3B%0A%0Aexport%20function%20deriveCurrentNativeHostSourceIntervals%28previous%2Ccurrent%29%7B%0A%20%20assert.equal%28Buffer.from%28previous%29.toString%28%27utf8%27%29%2Cprevious%29%3Bassert.equal%28Buffer.from%28current%29.toString%28%27utf8%27%29%2Ccurrent%29%3B%0A%20%20const%20before%3D%5B...previous%5D%2Cafter%3D%5B...current%5D%3Blet%20start%3D0%2ColdEnd%3Dbefore.length%2Cend%3Dafter.length%3B%0A%20%20while%28start%3ColdEnd%26%26start%3Cend%26%26before%5Bstart%5D%3D%3D%3Dafter%5Bstart%5D%29start%2B%2B%3B%0A%20%20while%28oldEnd%3Estart%26%26end%3Estart%26%26before%5BoldEnd-1%5D%3D%3D%3Dafter%5Bend-1%5D%29%7BoldEnd--%3Bend--%3B%7D%0A%20%20const%20edits%3D%5B%7Bstart%3Abefore.slice%280%2Cstart%29.join%28%27%27%29.length%2Cremoved%3Abefore.slice%28start%2ColdEnd%29.join%28%27%27%29%2Cinserted%3Aafter.slice%28start%2Cend%29.join%28%27%27%29%7D%5D%3B%0A%20%20assert.equal%28replayRequiredFieldNativeHostIntervals%28previous%2Cedits%29%2Ccurrent%29%3Breturn%20edits%3B%0A%7D%0A%0Aexport%20function%20verifyCurrentNativeHostSourceHistory%28packet%29%7B%0A%20%20exactKeys%28packet%2C%5B%27schemaVersion%27%2C%27model%27%2C%27revision%27%2C%27sources%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27complete%20current%20native%20historical%20host%20sources%201%27%29%3B%0A%20%20assert.equal%28packet.revision%2CCURRENT_NATIVE_HOST_REVISION%29%3B%0A%20%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2CCURRENT_NATIVE_HOST_FILES%29%3B%0A%20%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20%20%20exactKeys%28row%2C%5B%27file%27%2C%27previous%27%2C%27current%27%2C%27coordinateUnit%27%2C%27edits%27%5D%29%3B%0A%20%20%20%20exactKeys%28row.previous%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3BexactKeys%28row.current%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%5D%29%3B%0A%20%20%20%20assert.deepEqual%28pinCurrentNativeHostSource%28row.previous.source%29%2C%7Bbytes%3Arow.previous.bytes%2Csha256%3Arow.previous.sha256%7D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.previous.certificate%2CBuffer.from%28row.previous.source%29%2C%7Brevision%3ACURRENT_NATIVE_HOST_REVISION%2Cpath%3Arow.file%7D%29%3B%0A%20%20%20%20assert.deepEqual%28pinCurrentNativeHostSource%28row.current.source%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%20%20%20assert.equal%28row.current.source%2CreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2C%27the%20entire%20actual%20current%20native%20host%20supplies%20this%20view%27%29%3B%0A%20%20%20%20assert.equal%28row.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20%20%20assert.deepEqual%28row.edits%2CderiveCurrentNativeHostSourceIntervals%28row.previous.source%2Crow.current.source%29%29%3B%0A%20%20%20%20assert.equal%28replayRequiredFieldNativeHostIntervals%28row.previous.source%2Crow.edits%29%2Crow.current.source%29%3B%0A%20%20%20%20let%20inverse%3Drow.current.source%3B%0A%20%20%20%20for%28const%20edit%20of%20row.edits.toReversed%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2Crow.previous.source%29%3B%0A%20%20%7D%0A%20%20return%20packet%3B%0A%7D%0A%0Aexport%20function%20readCurrentNativeHostSourceHistory%28%29%7B%0A%20%20if%28%21cached%29%7Bconst%20bytes%3DreadFileSync%28new%20URL%28CURRENT_NATIVE_HOST_OUTPUT%2Croot%29%29%3Bassert.equal%28pinCurrentNativeHostSource%28bytes%29.sha256%2CpacketSha256%29%3Bcached%3DverifyCurrentNativeHostSourceHistory%28readBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%29%3B%7D%0A%20%20return%20structuredClone%28cached%29%3B%0A%7D%0A%0A%2F%2A%2A%20Unknown%20sources%20remain%20unchanged%20for%20the%20original%20strict%20reader%20to%20refuse.%0A%20%2A%20No%20unknown%20source%20is%20assigned%20a%20historical%20identity%3B%20runtime%20files%20stay%20current.%20%2A%2F%0Aexport%20function%20restoreCurrentNativeHostSource%28source%2Cfile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3B%0A%20%20if%28%21CURRENT_NATIVE_HOST_FILES.includes%28file%29%29return%20source%3B%0A%20%20const%20row%3DreadCurrentNativeHostSourceHistory%28%29.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3B%0A%20%20return%20source%3D%3D%3Drow.current.source%3Frow.previous.source%3Asource%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
