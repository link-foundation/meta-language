defined%7D%20%2A%2F%0Afunction%20relativeBoolean%28values%2Cposition%29%7Breturn%20values.at%28position%29%3B%7D%60%3B%0Aconst%20arrays%3D%5B%5B%5D%2C%5B0%5D%2C%5B1%2C2%2C3%5D%2C%5B-0%2CNaN%2CInfinity%2C-Infinity%5D%5D%3B%0Aconst%20positions%3D%5B-Infinity%2C-9007199254740992%2C-5%2C-4%2C-3%2C-2%2C-1.9%2C-1%2C-0.9%2C-Number.MIN_VALUE%2C-0%2C0%2CNumber.MIN_VALUE%2C0.9%2C1%2C1.9%2C2%2C3%2C4%2C9007199254740992%2CInfinity%2CNaN%5D%3B%0A%0Atest%28%27relative%20array%20selection%20preserves%20all%20numeric%20boundaries%20primitive%20element%20types%20and%20undefined%20values%27%2C%28%29%3D%3E%7B%0A%20%20const%20compiled%3DrunInNewContext%28emitJavaScript%28checkProgram%28parseJavaScript%28source%29%29%29.text%2B%27%3B%28%7BrelativeElement%2CrelativeText%2CrelativeBoolean%7D%29%3B%27%29%3B%0A%20%20for%28const%20values%20of%20arrays%29for%28const%20position%20of%20positions%29%7B%0A%20%20%20%20assert.ok%28Object.is%28readArrayRelativeElement%28values%2Cposition%29%2Cvalues.at%28position%29%29%29%3B%0A%20%20%20%20assert.ok%28Object.is%28compiled.relativeElement%28values%2Cposition%29%2Cvalues.at%28position%29%29%29%3B%0A%20%20%7D%0A%20%20for%28const%20position%20of%20positions%29%7B%0A%20%20%20%20assert.equal%28compiled.relativeText%28%5B%27A%27%2C%27%F0%9F%98%80%27%2C%27%5Cud800%27%5D%2Cposition%29%2C%5B%27A%27%2C%27%F0%9F%98%80%27%2C%27%5Cud800%27%5D.at%28position%29%29%3B%0A%20%20%20%20assert.equal%28compiled.relativeBoolean%28%5Btrue%2Cfalse%2Ctrue%5D%2Cposition%29%2C%5Btrue%2Cfalse%2Ctrue%5D.at%28position%29%29%3B%0A%20%20%7D%0A%20%20for%28const%20position%20of%20%5Bnull%2Cundefined%5D%29assert.equal%28compiled.relativeElement%28%5B5%2C6%5D%2Cposition%29%2C5%29%3B%0A%7D%29%3B%0A%0Atest%28%27relative%20array%20defaults%20and%20operands%20execute%20once%20in%20order%20and%20unsupported%20coercions%20stay%20explicit%27%2C%28%29%3D%3E%7B%0A%20%20const%20ordered%3D%60%2F%2A%2A%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2Ffunction%20receiver%28%29%7Bconsole.log%28%27receiver%27%29%3Breturn%20%5B10%2C20%2C30%5D%3B%7D%0A%2F%2A%2A%20%40returns%20%7Bnumber%7D%20%2A%2Ffunction%20position%28%29%7Bconsole.log%28%27position%27%29%3Breturn%20-1.9%3B%7D%0Aconsole.log%28receiver%28%29.at%28position%28%29%29%29%3Bconsole.log%28receiver%28%29.at%28%29%29%3B%0Aconsole.log%28%27%25s%20%25s%20%25s%27%2C%5B1%5D.at%28undefined%29%2C%5B2%5D.at%28null%29%2C%5B3%5D.at%28NaN%29%29%3B%60%3B%0A%20%20for%28const%20text%20of%20%5Bordered%2CemitJavaScript%28checkProgram%28parseJavaScript%28ordered%29%29%29.text%5D%29%7B%0A%20%20%20%20const%20lines%3D%5B%5D%3BrunInNewContext%28text%2C%7Bconsole%3A%7Blog%3A%28...values%29%3D%3Elines.push%28format%28...values%29%29%7D%7D%29%3B%0A%20%20%20%20assert.deepEqual%28lines%2C%5B%27receiver%27%2C%27position%27%2C%2730%27%2C%27receiver%27%2C%2710%27%2C%271%202%203%27%5D%29%3B%0A%20%20%7D%0A%20%20for%28const%20argument%20of%20%5B%27true%27%2C%22%271%27%22%2C%27%7B%7D%27%2C%27%5B1%5D%27%5D%29assert.throws%28%28%29%3D%3EcheckProgram%28parseJavaScript%28%27console.log%28%5B1%2C2%5D.at%28%27%2Bargument%2B%27%29%29%3B%27%29%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EcheckProgram%28parseJavaScript%28%27console.log%28%5B1%2C2%5D.at%280%2C1%29%29%3B%27%29%29%2C%2Fexpects%200%20to%201%20arguments%2Fu%29%3B%0A%7D%29%3B%0A%0Atest%28%27relative%20array%20source%20free%20typed%20text%20and%20binary%20graphs%20recheck%20and%20preserve%20every%20decision%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DcreateTypedProgramLinks%28source%2C%27JavaScript%27%29%3B%0A%20%20for%28const%20network%20of%20%5BLinkNetwork.fromLino%28packet.network.toLino%28%29%29%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28packet.network%29%29%5D%29%7B%0A%20%20%20%20recheckLinkedTypedProgram%28decodeTypedProgramLinks%28network%2Cpacket.root%29%2C%7BwholeProgram%3Atrue%7D%29%3B%0A%20%20%20%20const%20code%3DemitTypedProgramLinks%28network%2Cpacket.root%2C%27JavaScript%27%29.code%3B%0A%20%20%20%20const%20operation%3DrunInNewContext%28code%2B%27%3BrelativeElement%3B%27%29%3B%0A%20%20%20%20for%28const%20values%20of%20arrays%29for%28const%20position%20of%20positions%29assert.ok%28Object.is%28operation%28values%2Cposition%29%2Cvalues.at%28position%29%29%29%3B%0A%20%20%20%20assert.ok%28emitTypedProgramLinks%28network%2Cpacket.root%2C%27Rust%27%29.code.includes%28%27optional_at%27%29%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27the%20complete%20original%20relative%20array%20kernel%20is%20checked%20shared%20data%20and%20self%20translation%20restores%20every%20byte%27%2C%28%29%3D%3E%7B%0A%20%20generateArrayRelativeElementTemplate%28true%29%3B%0A%20%20const%20kernel%3DreadFileSync%28new%20URL%28%27..%2Fsrc%2Ftranslation%2Farray-relative-element-rules.js%27%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20for%28const%20input%20of%20%5Bsource%2Ckernel%5D%29%7B%0A%20%20%20%20const%20translated%3DselfTranslate%28input%2C%27JavaScript%27%2C%27Rust%27%29%3B%0A%20%20%20%20assert.equal%28translated.items.filter%28row%3D%3Erow.status%3D%3D%3D%27carried%27%29.length%2C0%29%3B%0A%20%20%20%20assert.equal%28selfTranslate%28translated.code%2C%27Rust%27%2C%27JavaScript%27%29.code%2Cinput%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Aimport%20%7BreadProjectData%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0A%0A%0Atest%28%27independent%20complete%20array%20programs%20preserve%20nullable%20elements%20and%20ordered%20observations%27%2C%28%29%3D%3E%7B%0A%20%20const%20fixture%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Farray-relative-element-observations.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20assert.equal%28fixture.programs.length%2C2%29%3Bassert.equal%28fixture.positions.length%2C22%29%3B%0A%20%20for%28const%20row%20of%20fixture.programs%29%7B%0A%20%20%20%20for%28const%20source%20of%20%5Brow.source%2CemitJavaScript%28checkProgram%28parseJavaScript%28row.source%29%29%29.text%5D%29%7B%0A%20%20%20%20%20%20const%20lines%3D%5B%5D%3BrunInNewContext%28source%2C%7Bconsole%3A%7Blog%3A%28...values%29%3D%3Elines.push%28format%28...values%29%29%7D