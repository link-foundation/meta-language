%20does%20not%20claim%20it%20solved.%27%20%7D%3B%0A%20%20const%20hosts%20%3D%20ASCII_HOST_EDITS.map%28specification%20%3D%3E%20%7B%0A%20%20%20%20const%20%7B%20blob%2C%20certificate%20%7D%20%3D%20captureGitArtifactCertificate%28ASCII_HOST_REVISION%2C%20specification.path%29%3B%0A%20%20%20%20const%20source%20%3D%20blob.toString%28%27utf8%27%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.from%28source%29%2C%20blob%29%3B%0A%20%20%20%20const%20replay%20%3D%20replayAsciiHostEdits%28source%2C%20specification.changes%29%3B%0A%20%20%20%20assert.equal%28restoreRequiredFieldNativeHostSource%28readFileSync%28new%20URL%28specification.path%2C%20root%29%2C%20%27utf8%27%29%2C%20specification.path%2C%20%27ASCII%20character%20host%27%29%2C%20replay.source%2C%0A%20%20%20%20%20%20%27capture%20the%20exact%20finite%20reviewed%20successor%2C%20without%20unrelated%20source%20drift%27%29%3B%0A%20%20%20%20return%20%7B%20path%3A%20specification.path%2C%20source%2C%20certificate%2C%20current%3A%20asciiHostPin%28replay.source%29%2C%20edits%3A%20replay.edits%20%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20additions%20%3D%20ASCII_HOST_ADDITIONS.map%28path%20%3D%3E%20%7B%0A%20%20%20%20const%20source%20%3D%20readFileSync%28new%20URL%28path%2C%20root%29%2C%20%27utf8%27%29%3B%0A%20%20%20%20return%20%7B%20path%2C%20source%2C%20pin%3A%20asciiHostPin%28source%29%20%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20artifactPath%20%3D%20%27parity%2Fself-translation%2Fascii-text-predicate-rules-native.lino%27%3B%0A%20%20const%20artifactBytes%20%3D%20readFileSync%28new%20URL%28artifactPath%2C%20root%29%29%3B%0A%20%20const%20artifact%20%3D%20readProjectData%28new%20URL%28artifactPath%2C%20root%29%29%3B%0A%20%20const%20archive%20%3D%20%7B%20schemaVersion%3A%201%2C%20model%3A%20%27Rust%20ASCII%20character%20query%20host%20replay%201%27%2C%0A%20%20%20%20revision%3A%20ASCII_HOST_REVISION%2C%20coordinateUnit%3A%20%27UTF-16%20code%20units%27%2C%20hosts%2C%20additions%2C%0A%20%20%20%20registrations%3A%20ASCII_HOST_REGISTRATIONS%2