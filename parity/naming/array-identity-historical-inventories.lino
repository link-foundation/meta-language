torPolicy%28%29%2Cpacket%3DreadOwnCodebaseRawDescriptorPacket%28%29%3B%0A%20%20%20%20assert.equal%28packet.sourceOwner.file%2Cpolicy.sourceFile%29%3B%0A%20%20%20%20cachedCurrentSource%3DderiveOwnCodebaseRawDescriptorSource%28policy.sourceOwner%2Cpacket.sourceOwner.sourceText%29%3B%0A%20%20%20%20assert.deepEqual%28relativeArrayFrontendPin%28cachedCurrentSource%29%2Cpolicy.sourceOwner.current%29%3B%0A%20%20%7D%0A%20%20return%20cachedCurrentSource%3B%0A%7D%0A%0A%2F%2A%2A%20The%20compact%20projection%20contains%20the%20complete%20old%20source%20and%20its%20original%0A%20%2A%20Git%20membership.%20Normal%20verification%20never%20reloads%20the%20large%20naming%20archive.%20%2A%2F%0Aexport%20function%20verifyRelativeArrayFrontendSourceHistory%28history%29%7B%0A%20%20exactKeys%28history%2C%5B%27schemaVersion%27%2C%27model%27%2C%27profile%27%2C%27sourceArchive%27%2C%27historical%27%2C%27currentAuthority%27%2C%27nullableInference%27%2C%27host%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28history.schemaVersion%2C2%29%3Bassert.equal%28history.model%2C%27relative%20array%20frontend%20descriptor%20historical%20source%202%27%29%3B%0A%20%20assert.equal%28history.profile%2CRELATIVE_ARRAY_FRONTEND_PROFILE%29%3B%0A%20%20const%20naming%3DreadOwnCodebaseHistoricalNamingPolicy%28%29%2Ccurrent%3DreadOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20assert.deepEqual%28history.sourceArchive%2C%7Brevision%3Anaming.revision%2C...naming.sourceArchive%7D%29%3B%0A%20%20exactKeys%28history.historical%2C%5B%27file%27%2C%27commit%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%5D%29%3B%0A%20%20const%20previous%3Dcurrent.artifactDescriptorPrevious%3B%0A%20%20assert.deepEqual%28%7Bfile%3Ahistory.historical.file%2Cbytes%3Ahistory.historical.bytes%2Csha256%3Ahistory.historical.sha256%7D%2Cprevious%29%3B%0A%20%20assert.equal%28history.historical.commit%2Cnaming.revision%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28history.historical.sourceText%29%2C%7Bbytes%3Aprevious.bytes%2Csha256%3Aprevious.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28history.historical.certificate%2CBuffer.from%28history.historical.sourceText%29%2C%7Brevision%3Anaming.revision%2Cpath%3Aprevious.file%7D%29%3B%0A%20%20assert.deepEqual%28history.currentAuthority%2C%7Brevision%3Acurrent.revision%2Cfile%3Acurrent.sourceFile%2C%0A%20%20%20%20predecessor%3Acurrent.sourceOwner.predecessor%2Ccurrent%3Acurrent.sourceOwner.current%7D%29%3B%0A%20%20const%20inference%3Dhistory.nullableInference%2CexpectedInference%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE%3B%0A%20%20exactKeys%28inference%2C%5B%27path%27%2C%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.equal%28inference.path%2CexpectedInference.path%29%3Bassert.equal%28inference.revision%2CexpectedInference.revision%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Ainference.bytes%2Csha256%3Ainference.sha256%7D%2CexpectedInference.previous%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28inference.sourceText%29%2CexpectedInference.previous%29%3B%0A%20%20verifyGitArtifactCertificate%28inference.certificate%2CBuffer.from%28inference.sourceText%29%2C%7Brevision%3AexpectedInference.revision%2Cpath%3AexpectedInference.path%7D%29%3B%0A%20%20const%20inferenceReplay%3DreplayRelativeArrayNullableInference%28inference.sourceText%29%3B%0A%20%20assert.deepEqual%28inference.current%2CexpectedInference.current%29%3Bassert.deepEqual%28inference.edits%2CinferenceReplay.edits%29%3B%0A%20%20exactKeys%28history.host%2C%5B%27path%27%2C%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.deepEqual%28%7Bpath%3Ahistory.host.path%2Crevision%3Ahistory.host.revision%2Cbytes%3Ahistory.host.bytes%2Csha256%3Ahistory.host.sha256%7D%2CRELATIVE_ARRAY_FRONTEND_HOST%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28history.host.sourceText%29%2C%7Bbytes%3