rceText%2Ccertificate%3Aoriginal.certificate%2Ccurrent%3Apin%28actual%29%2Cedit%7D%29%3B%0A%20%20%7D%0A%20%20const%20value%3D%7BschemaVersion%3A1%2Crevision%2Crun%3A39389240046%2Csources%2C%0A%20%20%20%20boundary%3A%27Exact%20historical%20input%20views%20only.%20Current%20implementations%20and%20artifacts%20retain%20independent%20current%20gates.%20Unknown%20successors%20are%20never%20authenticated%20by%20these%20views.%20Every%20original%20historical%20assertion%20and%20its%20complete%20input%20remain%20required.%20This%20record%20proves%20source%20preservation%2C%20not%20native%20execution%20or%20semantic%20equivalence.%27%7D%3B%0A%20%20const%20output%3Dnew%20URL%28%27parity%2Fself-translation%2Fci-39389240046-historical-inputs.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28output%2Cvalue%29%3Belse%20writeProjectData%28output%2Cvalue%29%3B%0A%20%20const%20helperFile%3Dnew%20URL%28%27js%2Fscripts%2Fcontinuation-source-history.mjs%27%2Croot%29%2Csource%3DreadFileSync%28helperFile%2C%27utf8%27%29%3B%0A%20%20const%20expected%3Dsource.replace%28%2Fconst%20historyHash%3D%27%28%3F%3A%5Ba-f0-9%5D%7B64%7D%7CPENDING%29%27%3B%2Fu%2C%22const%20historyHash%3D%27%22%2Bpin%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28helperFile%2Cexpected%29%3B%0A%20%20return%20value%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20value%3DgenerateContinuationHistoricalInputs%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Preserved%20%27%2Bvalue.sources.length%2B%27%20complete%20certified%20historical%20inputs%20and%20exact%20current%20guards.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
