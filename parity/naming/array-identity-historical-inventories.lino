itory.names.slice%280%2C%20currentNames.length%29%2C%20currentNames%29%3B%0A%20%20for%20%28const%20view%20of%20policy.views%29%20%7B%0A%20%20%20%20const%20actual%20%3D%20readFileSync%28new%20URL%28%60..%2F..%2F%24%7Bview.file%7D%60%2C%20import.meta.url%29%29%3B%0A%20%20%20%20assert.equal%28actual.length%2C%20view.current.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28actual%29.digest%28%27hex%27%29%2C%20view.current.sha256%2C%0A%20%20%20%20%20%20%60%24%7Bview.file%7D%20retains%20its%20complete%20independently%20pinned%20actual%20current%20source%60%29%3B%0A%20%20%20%20const%20rows%20%3D%20historicalNames.filter%28%28row%29%20%3D%3E%20row.inventory%20%3D%3D%3D%20view.inventory%20%26%26%20row.file%20%3D%3D%3D%20view.file%29%3B%0A%20%20%20%20assert.deepEqual%28rows.map%28%28%7B%20name%2C%20record%20%7D%29%20%3D%3E%20%28%7B%20name%2C%20record%20%7D%29%29%2C%20view.names%29%3B%0A%20%20%20%20for%20%28const%20row%20of%20rows%29%20%7B%0A%20%20%20%20%20%20assert.equal%28row.sourceView.kind%2C%20%27complete%20certified%20historical%20source%27%29%3B%0A%20%20%20%20%20%20assert.equal%28row.sourceView.revision%2C%20policy.revision%29%3B%0A%20%20%20%20%20%20assert.equal%28row.sourceView.path%2C%20view.file%29%3B%0A%20%20%20%20%20%20assert.ok%28row.sourceView.bytes%20%3E%200%29%3B%0A%20%20%20%20%20%20assert.match%28row.sourceView.sha256%2C%20%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3B%0A%20%20%20%20%20%20assert.equal%28currentNames.some%28%28current%29%20%3D%3E%20current.inventory%20%3D%3D%3D%20row.inventory%20%26%26%20current.file%20%3D%3D%3D%20row.file%20%26%26%20current.name%20%3D%3D%3D%20row.name%29%2C%20false%2C%0A%20%20%20%20%20%20%20%20%27a%20certified%20historical%20owner%20is%20kept%20separate%20from%20actual%20current%20source%20names%27%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20changed%20%3D%20structuredClone%28historicalNames%29%3B%20changed%5B0%5D.sourceView.path%20%3D%20%27unregistered%2Fsource.rs%27%3B%0A%20%20assert.notDeepEqua