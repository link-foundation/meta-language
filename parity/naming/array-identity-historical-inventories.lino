A%20%20%27experiments%2Foriginal-link-complete-table-projection%2Fgenerate-successor-source-phases.mjs%27%2C%0A%20%20%27experiments%2Fgrammar-outcome-network%2Fnative-transport%2Finverse%2Fprojection-fixtures.lino%27%5D%3B%0A%0A%2F%2A%2A%20Validate%20the%20complete%20current%20metadata%20and%20the%20exact%20unchanged%20original%20payload.%20%2A%2F%0Aexport%20function%20checkGrammarContextMetadataPredecessor%28file%2Ccurrent%2Cprevious%29%20%7B%0A%20%20assert.ok%28file%3D%3D%3D%27experiments%2Fgrammar-outcome-network%2Fnative-transport%2Finverse%2Fprojection-fixtures.lino%27%0A%20%20%20%20%7C%7Cfile%3D%3D%3D%27parity%2Fself-translation%2Fprivate-output-test-model-generation.lino%27%2C%27one%20explicitly%20recorded%20metadata%20profile%20is%20required%27%29%3B%0A%20%20const%20inverse%3DstructuredClone%28current%29%3B%0A%20%20if%28file.endsWith%28%27%2Fprojection-fixtures.lino%27%29%29%7B%0A%20%20%20%20assert.deepEqual%28current.cases%2Cprevious.cases%2C%27all%20fourteen%20complete%20parser%20and%20boundary%20expectations%20remain%20exact%27%29%3B%0A%20%20%20%20assert.equal%28current.cases.length%2C14%29%3B%0A%20%20%20%20for%28const%20%5Bindex%2Crow%5Dof%20inverse.inputs.entries%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28row.path%2Cprevious.inputs%5Bindex%5D.path%29%3B%0A%20%20%20%20%20%20if%28row.path%21%3D%3D%27js%2Fsrc%2Fgrammar-runtime%2Fgrammar-selection.js%27%29continue%3B%0A%20%20%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28row.path%2Croot%29%2C%27utf8%27%29%3Bassert.deepEqual%28pin%28source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20%20%20const%20restored%3DrestoreGlobalGrammarContextSource%28row.path%2Csource%29%3Bassert.equal%28restored.changed%2Ctrue%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28restored.predecessor%29%2C%7Bbytes%3Aprevious.inputs%5Bindex%5D.bytes%2Csha256%3Aprevious.inputs%5Bindex%5D.sha256%7D%29%3B%0A%20%20%20%20%20%20Object.assign%28row%2Cprevious.inputs%5Bindex%5D%29%3B%0A%20%20%20%20%7D%0A%20%20%7Delse%7B%0A%20%20%20%20for%28const%20%5Bindex%2Crow%5Dof%20inverse.inputs.entries%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28row.file%2Cprevious.inputs%5Bindex%5D.file%29%3B%0A%20%20%20%20%20%20if%28row.file%21%3D%3D%27rust%2Fsrc%2Fgrammar%2Ffeature_runtime%2Fgrammar_selection.rs%27%29continue%3B%0A%20%20%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%3Bassert.deepEqual%28pin%28source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20%20%20const%20restored%3DrestoreGlobalGrammarContextSource%28row.file%2Csource%29%3Bassert.equal%28restored.changed%2Ctrue%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28restored.predecessor%29%2C%7Bbytes%3Aprevious.inputs%5Bindex%5D.bytes%2Csha256%3Aprevious.inputs%5Bindex%5D.sha256%7D%29%3B%0A%20%20%20%20%20%20Object.assign%28row%2Cprevious.inputs%5Bindex%5D%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20assert.deepEqual%28inverse%2Cprevious%2C%27all%20other%20complete%20source%20facts%2C%20selected%20definitions%2C%20outputs%2C%20controls%20and%20semantics%20remain%20exact%27%29%3B%0A%20%20return%20inverse%3B%0A%7D%0A%0A%2F%2A%2A%20Regeneration%20is%20performed%20by%20the%20original%20authors%2C%20each%20in%20its%20own%20bounded%0A%20%2A%20process.%20This%20author%20only%20proves%20the%20full%20metadata%20inverse%20and%20source%20history.%20%2A%2F%0Aexport%20function%20generateGrammarContextSourceMetadata%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20model%3DreadProjectData%28new%20URL%28%27parity%2Fself-translation%2Fprivate-output-test-model.lino%27%2Croot%29%29%3B%0A%20%20const%20artifacts%3D%5Bmodel.receipt%5D%3B%0A%20%20const%20rows%3D%5B...sources%2C...artifacts%5D.map%28file%3D%3E%7B%0A%20%20%20%20const%7Bblob%2Ccertificate%7D%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%2Cactual%3DreadFileSync%28new%20URL%28file%2Croot%29%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28certificate%2Cblob%2C%7Brevision%2Cpath%3Afile%7D%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.from%28blob.toString%28%29%29%2Cblob%29%3Bassert.deepEqual%28Buffer.from%28actual.toString%28%29%29%2Cactual%29%3B%0A%20%20%20%20if%28artifacts.includes%28file%29%29%7B%0A%20%20%20%20%20%20const%20previous%3DreadStructuredDataLino%28blob.toString%28%29%29%2Ccurrent%3DreadProjectData%28new%20URL%28file%2Croot%29%29%3B%0A%20%20%20%20%20%20const%20inverse%3DcheckGrammarContextMetadataPredecessor%28file%2Ccurrent%2Cprevious%29%3B%0A%20%20%20%20%20%20assert.equal%28serializeProjectData%28inverse%2Cfile%29%2Cblob.toString%28%29%2C%27every%20complete%20predecessor%20Links%20byte%20survives%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20let%20start%3D0%2Cend%3Dactual.length%2ColdEnd%3Dblob.length%3B%0A%20%20%20%20while%28start%3Cend%26%26start%3ColdEnd%26%26actual%5Bstart%5D%3D%3D%3Dblob%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20while%28start%3E0%26%26%28actual%5Bstart%5D%26192%29%3D%3D%3D128%29start--%3B%0A%20%20%20%20while%28end%3Estart%26%26oldEnd%3Estart%26%26actual%5Bend-1%5D%3D%3D%3Dblob%5BoldEnd-1%5D%29%7Bend--%3BoldEnd--%3B%7D%0A%20%20%20%20while%28end%3Cactual.length%26%26%28%28actual%5Bend%5D%26192%29%3D%3D%3D128%7C%7C%28blob%5BoldEnd%5D%26192%29%3D%3D%3D128%29%29%7Bend%2B%2B%3BoldEnd%2B%2B%3B%7D%0A%20%20%20%20const%20removed%3Dblob.subarray%28start%2ColdEnd%29%2Cinserted%3Dactual.subarray%28start%2Cend%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.from%28removed.toString%28%29%29%2Cremoved%29%3Bassert.deepEqual%28Buffer.from%28inserted.toString%28%29%29%2Cinserted%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.concat%28%5Bactual.subarray%280%2Cstart%29%2Cremoved%2Cactual.subarray%28end%29%5D%29%2Cblob%29%3B%0A%20%20%20%20return%7Bfile%2Ccommit%3Arevision%2C...pin%28blob%29%2CsourceText%3Ablob.toString%28%29%2Ccertificate%2Ccurrent%3Apin%28actual%29%2C%0A%20%20%20%20%20%20edit%3A%7BoffsetUnit%3A%27UTF-8%20bytes%27%2Cstart%2Cend%2Cremoved%3Aremoved.toString%28%29%2Cinserted%3Ainserted.toString%28%29%7D%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%2Csources%3Arows%2C%0A%20%20%20%20boundary%3A%27Current%20metadata%20records%20actual%20current%20producers.%20Every%20complete%20predecessor%20retains%20independent%20Git%20membership%20and%20an%20exact%20byte%20inverse.%20Original%20parser%20expectations%2C%20selected%20native%20definitions%2C%20constructor%20bodies%2C%20numeric%20validation%2C%20outputs%20and%20all%20refusal%20assertions%20remain%20required.%20Source%20conservation%20supplies%20no%20native%20execution%20or%20semantic%20equivalence%20evidence.%27%7D%3B%0A%20%20const%20target%3Dnew%20URL%28output%2Croot%29%3Bif%28check%29checkProjectData%28target%2Cpacket%29%3Belse%20writeProjectData%28target%2Cpacket%29%3B%0A%20%20const%20path%3Dnew%20URL%28helper%2Croot%29%2Csource%3DreadFileSync%28path%2C%27utf8%27%29%3B%0A%20%20const%20expected%3Dsource.replace%28%2Fconst%20archiveSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%2C%22const%20archiveSha256%3D%27%22%2Bpin%28readFileSync%28target%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28path%2Cexpected%29%3B%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20packet%3DgenerateGrammarContextSourceMetadata%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Retained%20%27%2Bpacket.sources.length%2B%27%20complete%20original%20sources%20and%20metadata%20with%20unchanged%20expected%20behavior.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
