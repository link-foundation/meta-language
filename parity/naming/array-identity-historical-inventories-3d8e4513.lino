es.filter%28row%3D%3Erow.file%3D%3D%3Dprofile.file%29%3Bassert.equal%28owners.length%2C1%29%3B%0A%20%20const%20original%3Downers%5B0%5D%2Cbefore%3DBuffer.from%28original.sourceText%29%2Cafter%3DreadFileSync%28new%20URL%28profile.file%2Croot%29%29%3B%0A%20%20assert.deepEqual%28pin%28after%29%2Cprofile.current%2C%27only%20the%20complete%20reviewed%20current%20crate-root%20successor%20is%20admitted%27%29%3B%0A%20%20let%20start%3D0%3Bwhile%28start%3Cbefore.length%26%26start%3Cafter.length%26%26before%5Bstart%5D%3D%3D%3Dafter%5Bstart%5D%29start%2B%2B%3B%0A%20%20let%20suffix%3D0%3Bwhile%28suffix%3Cbefore.length-start%26%26suffix%3Cafter.length-start%26%26before%5Bbefore.length-suffix-1%5D%3D%3D%3Dafter%5Bafter.length-suffix-1%5D%29suffix%2B%2B%3B%0A%20%20const%20removed%3Dbefore.subarray%28start%2Cbefore.length-suffix%29%2Cinserted%3Dafter.subarray%28start%2Cafter.length-suffix%29%3B%0A%20%20assert.equal%28Buffer.from%28removed.toString%28%27utf8%27%29%29.equals%28removed%29%2Ctrue%29%3Bassert.equal%28Buffer.from%28inserted.toString%28%27utf8%27%29%29.equals%28inserted%29%2Ctrue%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%3Aprofile.revision%2C%0A%20%20%20%20origin%3A%7Bpath%3Aarchive%2Csha256%3AarchiveSha256%7D%2C%0A%20%20%20%20source%3A%7B...original%2Ccurrent%3Apin%28after%29%2Cedit%3A%7Bstart%2CdeleteBytes%3Aremoved.length%2CinsertText%3Ainserted.toString%28%27utf8%27%29%7D%7D%2C%0A%20%20%20%20boundary%3A%27One%20complete%20independently%20committed%20crate-root%20source%2C%20preserved%20certificate%20and%20automatically%20derived%20exact%20current%20byte%20inverse.%20This%20is%20source%20provenance%20and%20CST%20ownership%2C%20never%20semantic%20or%20native%20execution%20evidence.%27%7D%3B%0A%20%20const%20pair%3DverifyOutcomeCrateRootSourcePacket%28packet%29%3Bassert.equal%28pair.successor.source%2Cafter.toString%28%27utf8%27%29%29%3B%0A%20%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Csource%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2F%5Econst%20recipeSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%24%2Fmu%3B%0A%20%20assert.equal%28source.split%28pattern%29.length%2C2%2C%27one%20complete%20top-level%20recipe%20binding%27%29%3B%0A%20%20const%20output%3Dnew%20URL%28profile.recipe%2Croot%29%3Bif%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20%20const%20expected%3Dsource.replace%28pattern%2C%22const%20recipeSha256%3D%27%22%2Bpin%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28helperPath%2Cexpected%29%3B%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28args.length%3C%3D1%26%26args.every%28arg%3D%3Earg%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateOutcomeCrateRootSource%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Complete%20certified%20crate-root%20predecessor%20and%20finite%20current%20source%20successor%20retained%3B%20native%20execution%20remains%20CI-only.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
