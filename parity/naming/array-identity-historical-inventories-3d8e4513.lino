(3417: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20crate-root%20source%20succession%3B%20complete%20earlier%20transport%20profiles%20remain%20mandatory.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadProjectData%2CserializeProjectData%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BreadRustSourceItems%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fgenerate-private-output-test-model.mjs%27%3B%0Aimport%20%7Btokenize%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fsrc%2Ftranslation%2Flexer.js%27%3B%0Aimport%20%7BoutcomeWirePolicy%7D%20from%20%27..%2Fwire%2Fwire-policy.mjs%27%3B%0A%0Aexport%20const%20outcomeCrateRootPath%3D%27rust%2Fsrc%2Flib.rs%27%3B%0Aexport%20const%20OUTCOME_CRATE_ROOT_SOURCE_PROFILE%3DObject.freeze%28%7B%0A%20%20revision%3A%27897bfc8b2dcc5ec561feffa455ddeb9f95d24335%27%2C%0A%20%20file%3AoutcomeCrateRootPath%2C%0A%20%20current%3AObject.freeze%28%7Bbytes%3A20851%2Csha256%3A%279f4f452ae9ebcf5165506c47d67585af423bfd99d5ccd8640e8226a936dbbc46%27%7D%29%2C%0A%20%20origin%3AObject.freeze%28%7Bpath%3A%27parity%2Fnaming%2Fown-codebase-baseline-predecessor-source-history.lino%27%2Csha256%3A%272aab89c9bf21a9e6f3addf28776bed84ccfdb192e6bb69b59c3fa546e1734abc%27%7D%29%2C%0A%20%20recipe%3A%27experiments%2Fgrammar-outcome-network%2Fnative-transport%2Fdiagnostic-order%2Fcrate-root-source-successor.lino%27%2C%0A%7D%29%3B%0Aconst%20recipeSha256%3D%27c4048cdefd81b07b4ac6130a96476e143b3c40c0426d642dfb8d46c5896c6d13%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20pin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20canonical%3Dvalue%3D%3EserializeProjectData%28value%2C%27crate-root-source-view.lino%27%29%3B%0Aconst%20tokenText%3Dsource%3D%3Etokenize%28source%2C%27Rust%27%29.tokens.filter%28token%3D%3Etoken.kind%21%3D%3D%27eof%27%29.map%28token%3D%3Etoken.value%29.join%28%27%27%29%3B%0Alet%20sourcePair%3B%0Aconst%20crateRootOwnerProofs%3Dnew%20Map%28%29%3B%0A%0A%2F%2A%2A%20Check%20the%20original%20complete%20Git%20source%20and%20derive%20one%20bounded%20exact%20byte%20successor.%0A%20%2A%20This%20certificate%20proves%20source%20membership%20and%20inversion%2C%20never%20runtime%20semantics.%20%2A%2F%0Aexport%20function%20verifyOutcomeCrateRootSourcePacket%28packet%29%20%7B%0A%20%20const%20profile%3DOUTCOME_CRATE_ROOT_SOURCE_PROFILE%2Crow%3Dpacket.source%3B%0A%20%20assert.deepEqual%28Object.keys%28packet%29.sort%28%29%2C%5B%27boundary%27%2C%27origin%27%2C%27revision%27%2C%27schemaVersion%27%2C%27source%27%5D%29%3B%0A%20%20assert.deepEqual%28packet.origin%2Cprofile.origin%29%3B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27bytes%27%2C%27certificate%27%2C%27commit%27%2C%27current%27%2C%27edit%27%2C%27file%27%2C%27sha256%27%2C%27sourceText%27%5D%29%3B%0A%20%20assert.deepEqual%28row.current%2Cprofile.current%2C%27a%20different%20successor%20cannot%20certify%20its%20own%20current%20source%20pin%27%29%3B%0A%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.revision%2Cprofile.revision%29%3B%0A%20%20assert.equal%28row.file%2Cprofile.file%29%3Bassert.equal%28row.commit%2Cprofile.revision%29%3B%0A%20%20assert.equal%28row.sha256%2CoutcomeWirePolicy.pins%5Bprofile.file%5D%2C%27the%20independently%20frozen%20original%20crate%20root%20stays%20exact%27%29%3B%0A%20%20const%20before%3DBuffer.from%28row.sourceText%2C%27utf8%27%29%3Bassert.equal%28before.toString%28%27utf8%27%29%2Crow.sourceText%29%3B%0A%20%20assert.ok%28before.length%3C%3D131072%29%3Bassert.deepEqual%28pin%28before%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2Cbefore%2C%7Brevision%3Aprofile.revision%2Cpath%3Aprofile.file%7D%29%3B%0A%20%20const%20edit%3Drow.edit%3Bassert.deepEqual%28Object.keys%28edit%29.sort%28%29%2C%5B%27deleteBytes%27%2C%27insertText%27%2C%27start%27%5D%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%26%26edit.start%3E%3D0%26%26edit.start%3C%3Dbefore.length%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28edit.deleteBytes%29%26%26edit.deleteBytes%3E%3D0%26%26edit.start%2Bedit.deleteBytes%3C%3Dbefore.length%29%3B%0A%20%20assert.equal%28typeof%20edit.insertText%2C%27string%27%29%3Bconst%20insertion%3DBuffer.from%28edit.insertText%2C%27utf8%27%29%3B%0A%20%20assert.equal%28insertion.toString%28%27utf8%27%29%2Cedit.insertText%29%3B%0A%20%20const%20after%3DBuffer.concat%28%5Bbefore.subarray%280%2Cedit.start%29%2Cinsertion%2Cbefore.subarray%28edit.start%2Bedit.deleteBytes%29%5D%29%3B%0A%20%20assert.ok%28after.length%3C%3D131072%29%3Bassert.equal%28Buffer.from%28after.toString%28%27utf8%27%29%2C%27utf8%27%29.equals%28after%29%2Ctrue%29%3B%0A%20%20assert.deepEqual%28pin%28after%29%2Crow.current%29%3Bassert.notDeepEqual%28pin%28after%29%2Cpin%28before%29%29%3B%0A%20%20const%20inverse%3DBuffer.concat%28%5Bafter.subarray%280%2Cedit.start%29%2Cbefore.subarray%28edit.start%2Cedit.start%2Bedit.deleteBytes%29%2Cafter.subarray%28edit.start%2Binsertion.length%29%5D%29%3B%0A%20%20assert.equal%28inverse.equals%28before%29%2Ctrue%2C%27the%20entire%20independently%20committed%20crate%20root%20is%20restored%27%29%3B%0A%20%20return%7Bfile%3Arow.file%2Crevision%3Arow.commit%2Cpredecessor%3A%7Bsource%3Arow.sourceText%2C...pin%28before%29%7D%2Csuccessor%3A%7Bsource%3Aafter.toString%28%27utf8%27%29%2C...pin%28after%29%7D%2Cedit%3AstructuredClone%28edit%29%7D%3B%0A%7D%0A%0Aexport%20function%20readOutcomeCrateRootSourcePair%28%29%20%7B%0A%20%20if%28%21sourcePair%29%7B%0A%20%20%20%20const%20path%3Dnew%20URL%28OUTCOME_CRATE_ROOT_SOURCE_PROFILE.recipe%2Croot%29%2Cbytes%3DreadFileSync%28path%29%3B%0A%20%20%20%20assert.equal%28pin%28bytes%29.sha256%2CrecipeSha256%2C%27complete%20independently%20pinned%20crate-root%20successor%20recipe%27%29%3B%0A%20%20%20%20sourcePair%3DverifyOutcomeCrateRootSourcePacket%28readProjectData%28path%29%29%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28sourcePair%29%3B%0A%7D%0A%0A%2F%2A%2A%20Admit%20only%20the%20complete%20original%20crate%20root%20or%20its%20independently%20registered%20exact%20successor.%20%2A%2F%0Aexport%20function%20restoreOutcomeCrateRootSource%28file%2Csource%29%20%7B%0A%20%20assert.equal%28file%2CoutcomeCrateRootPath%29%3Bassert.equal%28typeof%20source%2C%27string%27%29%3Bassert.ok%28Buffer.byteLength%28source%29%3C%3D131072%29%3B%0A%20%20const%20pair%3DreadOutcomeCrateRootSourcePair%28%29%3B%0A%20%20if%28source%3D%3D%3Dpair.predecessor.source%29return%7Bfile%2Cpredecessor%3Asource%2Ccurrent%3Asource%2Cchanged%3Afalse%2Creceipt%3Anull%7D%3B%0A%20%20assert.equal%28source%2Cpair.successor.source%2C%27unknown%20complete%20crate-root%20source%20edits%20refuse%27%29%3B%0A%20%20return%7Bfile%2Cpredecessor%3Apair.predecessor.source%2Ccurrent%3Asource%2Cchanged%3Atrue%2Creceipt%3A%7B%0A%20%20%20%20schemaVersion%3A1%2Cprofile%3A%27complete%20grammar%20transport%20crate%20root%20source%20successor%201%27%2Cfile%2Crevision%3Apair.revision%2C%0A%20%20%20%20recipe%3A%7Bpath%3AOUTCOME_CRATE_ROOT_SOURCE_PROFILE.recipe%2Csha256%3ArecipeSha256%7D%2C%0A%20%20%20%20predecessor%3Apin%28pair.predecessor.source%29%2Ccurrent%3Apin%28source%29%2CinverseVerified%3Atrue%2C%0A%20%20%20%20boundary%3A%27Exact%20source%20succession%20and%20original%20Git%20membership%20only%3B%20complete%20current%20reexport%20proofs%20are%20separate%20and%20native%20execution%20remains%20a%20CI%20obligation.%27%7D%7D%3B%0A%7D%0A%0Aexport%20function%20checkOutcomeCrateRootSourceReceipt%28file%2Csource%2Creceipt%29%20%7B%0A%20%20const%20actual%3DrestoreOutcomeCrateRootSource%28file%2Csource%29%3Bassert.equal%28actual.changed%2Ctrue%29%3B%0A%20%20assert.equal%28canonical%28receipt%29%2Ccanonical%28actual.receipt%29%2C%27complete%20crate-root%20receipt%20conservation%27%29%3Breturn%20structuredClone%28actual.receipt%29%3B%0A%7D%0A%0Afunction%20readCrateRootOwnerProof%28source%29%20%7B%0A%20%20%2F%2F%20The%20entire%20source%20and%20every%20consumed%20policy%20field%20participate%20in%20this%20key.%0A%20%20%2F%2F%20Keep%20only%20the%20complete%20predecessor%2Fcurrent%20pair%2C%20and%20never%20share%20returned%20objects.%0A%20%20const%20key%3Dcanonical%28%7Bsource%2CrootReexport%3AoutcomeWirePolicy.rootReexport%2Csources%3AoutcomeWirePolicy.sources%7D%29%3B%0A%20%20if%28crateRootOwnerProofs.has%28key%29%29return%20structuredClone%28crateRootOwnerProofs.get%28key%29%29%3B%0A%20%20const%20parsed%3DreadRustSourceItems%28Buffer.from%28source%29%29%2Cexports%3Dparsed.items.filter%28item%3D%3Eitem.kind%3D%3D%3D%27use_declaration%27%29%3B%0A%20%20const%20describe%3Ditem%3D%3E%28%7Bsource%3Aparsed.text%28item.node%29%2Cspan%3A%7Bstart%3Aitem.node.start%2Cend%3Aitem.node.end%7D%7D%29%3B%0A%20%20const%20roots%3Dexports.filter%28item%3D%3EtokenText%28parsed.text%28item.node%29%29%3D%3D%3DtokenText%28outcomeWirePolicy.rootReexport%29%29%3B%0A%20%20assert.equal%28roots.length%2C1%2C%27the%20actual%20complete%20grammar%20runtime%20crate-root%20reexport%20stays%20owned%27%29%3B%0A%20%20const%20selectedOwners%3DoutcomeWirePolicy.sources.flatMap%28row%3D%3Erow.names%29.map%28name%3D%3E%7B%0A%20%20%20%20const%20owners%3Dexports.filter%28item%3D%3Etokenize%28parsed.text%28item.node%29%2C%27Rust%27%29.tokens.some%28token%3D%3Etoken.value%3D%3D%3Dname%29%29%3B%0A%20%20%20%20assert.equal%28owners.length%2C1%2C%27every%20actual%20grammar%20runtime%20crate-root%20owner%20stays%20unique%3A%20%27%2Bname%29%3B%0A%20%20%20%20return%7Bname%2C...describe%28owners%5B0%5D%29%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20result%3D%7Breexports%3Aexports.map%28describe%29%2CrootReexport%3Adescribe%28roots%5B0%5D%29%2CselectedOwners%7D%3B%0A%20%20if%28crateRootOwnerProofs.size%3D%3D%3D2%29crateRootOwnerProofs.delete%28crateRootOwnerProofs.keys%28%29.next%28%29.value%29%3B%0A%20%20crateRootOwnerProofs.set%28key%2CstructuredClone%28result%29%29%3Breturn%20structuredClone%28result%29%3B%0A%7D%0A%0A%2F%2A%2A%20Schema%20three%20retains%20the%20whole%20original%20context%20profile%20and%20records%20actual%20current%20crate-root%20owners.%20%2A%2F%0Aexport%20function%20finalizeOutcomeCrateRootSourceView%28predecessorView%2Csuccessor%29%20%7B%0A%20%20assert.ok%28%5B1%2C2%5D.includes%28predecessorView.schemaVersion%29%29%3B%0A%20%20const%20actual%3DrestoreOutcomeCrateRootSource%28successor.file%2Csuccessor.currentSource%29%3Bassert.equal%28actual.changed%2Ctrue%29%3B%0A%20%20assert.equal%28actual.predecessor%2Csuccessor.predecessorSource%29%3B%0A%20%20checkOutcomeCrateRootSourceReceipt%28successor.file%2Csuccessor.currentSource%2Csuccessor.receipt%29%3B%0A%20%20const%20before%3DreadCrateRootOwnerProof%28actual.predecessor%29%2Cafter%3DreadCrateRootOwnerProof%28actual.current%29%3B%0A%20%20assert.equal%28after.rootReexport.source%2Cbefore.rootReexport.source%2C%27the%20complete%20selected%20root%20reexport%20is%20unchanged%27%29%3B%0A%20%20assert.deepEqual%28after.selectedOwners.map%28%28%7Bname%2Csource%7D%29%3D%3E%28%7Bname%2Csource%7D%29%29%2Cbefore.selectedOwners.map%28%28%7Bname%2Csource%7D%29%3D%3E%28%7Bname%2Csource%7D%29%29%2C%0A%20%20%20%20%27all%20complete%20selected%20transport%20export%20owners%20remain%20unchanged%27%29%3B%0A%20%20const%20currentPins%3DstructuredClone%28predecessorView.currentPins%29%2Crow%3DcurrentPins.find%28item%3D%3Eitem.file%3D%3D%3DoutcomeCrateRootPath%29%3Bassert.ok%28row%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%2Cpin%28actual.predecessor%29%29%3BObject.assign%28row%2Cpin%28actual.current%29%29%3B%0A%20%20return%7BschemaVersion%3A3%2Cprofile%3A%27complete%20current%20grammar%20transport%20crate%20root%20source%20views%201%27%2C%0A%20%20%20%20historicalPins%3AstructuredClone%28predecessorView.historicalPins%29%2CcurrentPins%2CpredecessorView%3AstructuredClone%28predecessorView%29%2C%0A%20%20%20%20crateRootSuccessor%3A%7Bfile%3Aactual.file%2CpredecessorSource%3Aactual.predecessor%2CcurrentSource%3Aactual.current%2Creceipt%3Aactual.receipt%2C%0A%20%20%20%20%20%20currentSourceProof%3A%7Bpredecessor%3Abefore%2Ccurrent%3Aafter%7D%7D%2C%0A%20%20%20%20boundary%3A%27The%20complete%20original%20diagnostic%20and%20context%20source%20profiles%20stay%20mandatory.%20The%20exact%20current%20crate%20root%20and%20all%20its%20actual%20reexports%20have%20separate%20whole-source%2C%20Git%20and%20CST%20proofs%3B%20no%20semantic%20or%20native%20execution%20observation%20is%20implied.%27%7D%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
