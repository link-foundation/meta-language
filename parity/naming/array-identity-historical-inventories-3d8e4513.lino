%2Ctrue%29%3Bassert.ok%28Buffer.byteLength%28source%29%3C%3D1024%2A1024%29%3B%0A%20%20%7D%0A%20%20const%20input%3D%5B...sources%5D%2Cresults%3Dnew%20Array%28input.length%29%2Cfailures%3D%5B%5D%3Blet%20next%3D0%3B%0A%20%20await%20Promise.all%28Array.from%28%7Blength%3AMath.min%28concurrency%2Cinput.length%29%7D%2Casync%28%29%3D%3E%7B%0A%20%20%20%20while%28next%3Cinput.length%29%7Bconst%20index%3Dnext%2B%2B%3Btry%7Bresults%5Bindex%5D%3Dawait%20invoke%28input%5Bindex%5D%2Cindex%29%3B%7D%0A%20%20%20%20%20%20catch%28error%29%7Bfailures.push%28%7Bindex%2Cerror%7D%29%3B%7D%7D%0A%20%20%7D%29%29%3B%0A%20%20if%28failures.length%29throw%20new%20AggregateError%28failures.sort%28%28a%2Cb%29%3D%3Ea.index-b.index%29.map%28row%3D%3Erow.error%29%2C%27complete%20source%20archive%20replay%20failed%27%29%3B%0A%20%20return%20results%3B%0A%7D%0A%0A%2F%2A%2A%20A%20receipt%20is%20accepted%20only%20after%20a%20successful%20worker%20exit%20releases%20its%20heap.%20%2A%2F%0Aexport%20function%20runOriginalLinkRawArchiveWorker%28source%2Cindex%2CmakeWorker%3D%28...args%29%3D%3Enew%20Worker%28...args%29%29%20%7B%0A%20%20return%20new%20Promise%28%28resolve%2Creject%29%3D%3E%7B%0A%20%20%20%20const%20expected%3Dpin%28source%29%3Blet%20receipt%2Cfailure%2Cmessages%3D0%3B%0A%20%20%20%20const%20worker%3DmakeWorker%28new%20URL%28%27.%2Fraw-source-archive-worker.mjs%27%2Cimport.meta.url%29%2C%7B%0A%20%20%20%20%20%20workerData%3A%7Bsource%2Cindex%2Cexpected%7D%2CexecArgv%3A%5B%5D%2Cname%3A%27complete-source-archive-%27%2Bindex%2C%0A%20%20%20%20%20%20resourceLimits%3A%7BmaxOldGenerationSizeMb%3A1024%2CmaxYoungGenerationSizeMb%3A16%7D%2C%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20worker.on%28%27message%27%2Cvalue%3D%3E%7B%0A%20%20%20%20%20%20messages%2B%2B%3Btry%7B%0A%20%20%20%20%20%20%20%20assert.equal%28messages%2C1%2C%27one%20complete%20archive%20receipt%20per%20worker%27%29%3B%0A%20%20%20%20%20%20%20%20assert.deepEqual%28Object.keys%28value%29.sort%28%29%2C%5B%27binaryReplaySha256%27%2C%27sourceSha256%27%2C%27textReplaySha256%27%5D%29%3B%0A%20%20%20%20%20%20%20%20for%28const%20actual%20of%20Object.values%28value%29%29assert.equal%28actual%2Cexpected.sha256%2C%27each%20complete%20source%20replay%20retains%20all%20original%20bytes%27%29%3B%0A%20%20%20%20%20%20%20%20receipt%3DstructuredClone%28value%29%3B%0A%20%20%20%20%20%20%7Dcatch%28error%29%7Bfailure%3Derror%3B%7D%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20worker.on%28%27error%27%2Cerror%3D%3E%7Bfailure%3Derror%3B%7D%29%3B%0A%20%20%20%20worker.on%28%27exit%27%2Ccode%3D%3E%7B%0A%20%20%20%20%20%20if%28failure%29return%20reject%28failure%29%3B%0A%20%20%20%20%20%20if%28code%21%3D%3D0%29return%20reject%28new%20Error%28%27complete%20source%20archive%20worker%20%27%2Bindex%2B%27%20exited%20%27%2Bcode%29%29%3B%0A%20%20%20%20%20%20if%28messages%21%3D%3D1%7C%7C%21receipt%29return%20reject%28new%20Error%28%27complete%20source%20archive%20worker%20%27%2Bindex%2B%27%20exited%20without%20its%20receipt%27%29%29%3B%0A%20%20%20%20%20%20resolve%28receipt%29%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20Select%20three%20heaps%20only%20when%20actual%20capacity%20leaves%20room%20for%20the%20parent.%20%2A%2F%0Aexport%20function%20readOriginalLinkRawArchiveCapacity%28processors%2CavailableBytes%2Cconfigured%29%20%7B%0A%20%20assert.ok%28Number.isSafeInteger%28processors%29%26%26processors%3E%3D1%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28availableBytes%29%26%26availableBytes%3E%3D0%29%3B%0A%20%20assert.ok%28configured%3D%3D%3Dundefined%7C%7C%2F%5E%5B1-9%5D%5B0-9%5D%2A%24%2Fu.test%28configured%29%2C%27the%20source%20archive%20job%20bound%20is%20a%20positive%20integer%27%29%3B%0A%20%20const%20jobs%3Dconfigured%3D%3D%3Dundefined%3F3%3AMath.min%283%2CNumber%28configured%29%29%3B%0A%20%20const%20memory%3DavailableBytes%3E%3D5%2A1024%2A%2A3%3F3%3AavailableBytes%3E%3D3%2A1024%2A%2A3%3F2%3A1%3B%0A%20%20return%20Math.min%28jobs%2Cprocessors%2Cmemory%29%3B%0A%7D%0A%0A%2F%2A%2A%20Only%20CI%20runs%20complete%20archives.%20Each%20