%20result%3B%0A%7D%0A%0Aexport%20function%20runDevelopmentAuthoringPhase%28plan%2Cname%2C%7Bcheck%3Dfalse%2Cexecute%3DspawnSync%2Cenvironment%3Dprocess.env%2Crecord%3D%28%29%3D%3E%7B%7D%7D%3D%7B%7D%29%7B%0A%20assert.deepEqual%28plan%2CreadDevelopmentAuthoringPlan%28%29%2C%27only%20the%20complete%20recorded%20authoring%20plan%20may%20execute%27%29%3B%0A%20const%20selected%3Dplan.phases.find%28phase%3D%3Ephase.name%3D%3D%3Dname%29%3Bassert.ok%28selected%2C%27unknown%20authoring%20phase%3A%20%27%2Bname%29%3B%0A%20const%20results%3D%5B%5D%3B%0A%20for%28const%20entry%20of%20selected.stages%29%7B%0A%20%20const%20bytes%3DreadFileSync%28resolve%28root%2Centry.script%29%29%3B%0A%20%20const%20args%3D%5B%27--expose-gc%27%2C%27--optimize-for-size%27%2C%27--max-old-space-size%3D352%27%2C%27--max-semi-space-size%3D1%27%2Centry.script%2C...entry.args%2C...%28check%3F%5B%27--check%27%5D%3A%5B%5D%29%5D%3B%0A%20%20process.stderr.write%28%27Authoring%20%27%2Bentry.id%2B%27%3A%20%27%2Bentry.script%2B%27%5Cn%27%29%3B%0A%20%20const%20result%3Dexecute%28process.execPath%2Cargs%2C%7Bcwd%3Aroot%2Cenv%3AdevelopmentAuthoringEnvironment%28environment%29%2Cstdio%3A%27inherit%27%2Ctimeout%3A80000%2CkillSignal%3A%27SIGKILL%27%7D%29%3B%0A%20%20results.push%28%7Bid%3Aentry.id%2Cscript%3Aentry.script%2CsourceSha256%3Adigest%28bytes%29%2Carguments%3Aargs%2CexitCode%3Aresult.status%3F%3Fnull%2Csignal%3Aresult.signal%3F%3Fnull%2Cerror%3Aresult.error%3FString%28result.error%29%3Anull%7D%29%3B%0A%20%20record%28structuredClone%28results%29%29%3B%0A%20%20if%28result.error%29throw%20result.error%3B%0A%20%20assert.equal%28result.signal%2Cnull%2Centry.id%2B%27%3A%20author%20interrupted%27%29%3B%0A%20%20assert.equal%28result.status%2C0%2Centry.id%2B%27%3A%20author%20failed%3B%20dependent%20stages%20must%20not%20run%27%29%3B%0A%20%7D%0A%20return%20results%3B%0A%7D%0A%0Aif%28process.argv%5B1%5D%26%26resolve%28process.argv%5B1%5D%29%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20try%7B%0A%20%20const%20args