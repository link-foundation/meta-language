(32381: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Project%20two%20complete%20already%20certified%20sources%3B%20retain%20the%20driver%20predecessor.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%2CwriteFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BexecFileSync%2CspawnSync%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7BWorker%7D%20from%20%27node%3Aworker_threads%27%3B%0Aimport%20%7BderiveOwnCodebaseHistoricalNamingViews%7D%20from%20%27.%2Fderive-own-codebase-historical-naming-views.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BreadBootstrapStructuredDataLino%7D%20from%20%27..%2F..%2Fscripts%2Flib%2Fstructured-data-bootstrap.mjs%27%3B%0Aimport%20%7BcaptureGitArtifactCertificate%7D%20from%20%27.%2Fcapture-git-artifact-certificate.mjs%27%3B%0Aimport%20%7BreadOwnCodebaseHistoricalNamingPolicy%2CverifyOwnCodebaseHistoricalNamingSources%7D%20from%20%27.%2Fown-codebase-baseline-naming-history.mjs%27%3B%0Aimport%20%7BcheckProjectData%2CwriteProjectData%2CserializeProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20pin%3Dbytes%3D%3E%28%7Bbytes%3ABuffer.byteLength%28bytes%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%7D%29%3B%0A%0A%2F%2A%2A%20Reproduce%20the%20exact%20compact%20offline%20history%20and%20the%20additive%20driver.%20%2A%2F%0Aexport%20function%20generateOwnCodebaseHistoricalNamingSources%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%7B%0A%20%20const%20policy%3DreadOwnCodebaseHistoricalNamingPolicy%28%29%2CarchiveBytes%3DreadFileSync%28new%20URL%28policy.sourceArchive.path%2Croot%29%29%3B%0A%20%20assert.deepEqual%28pin%28archiveBytes%29%2C%7Bbytes%3Apolicy.sourceArchive.bytes%2Csha256%3Apolicy.sourceArchive.sha256%7D%29%3B%0A%20%20let%20archive%3DreadBootstrapStructuredDataLino%28archiveBytes.toString%28%27utf8%27%29%29%3B%0A%20%20assert.equal%28archive.revision%2Cpolicy.revision%29%3Bassert.equal%28archive.sources.length%2Cpolicy.sourceArchive.sources%29%3B%0A%20%20const%20views%3Dpolicy.views.map%28view%3D%3E%7B%0A%20%20%20%20const%20selected%3Darchive.sources.filter%28row%3D%3Erow.file%3D%3D%3Dview.file%29%3Bassert.equal%28selected.length%2C1%29%3Bconst%20row%3Dselected%5B0%5D%3B%0A%20%20%20%20assert.equal%28row.commit%2Cpolicy.revision%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28view.file%2Croot%29%29%29%2Cview.current%29%3B%0A%20%20%20%20return%20%7B...view%2Cpredecessor%3A%7Bsource%3Arow.sourceText%2Cbytes%3Arow.bytes%2Csha256%3Arow.sha256%2Ccertificate%3AstructuredClone%28row.certificate%29%7D%7D%3B%0A%20%20%7D%29%3B%0A%20%20archive%3Dnull%3Bglobal.gc%3F.%28%29%3B%0A%20%20const%20original%3DcaptureGitArtifactCertificate%28policy.revision%2Cpolicy.driver.file%29%3B%0A%20%20assert.deepEqual%28pin%28original.blob%29%2Cpolicy.driver.original%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3Apolicy.schemaVersion%2Cmodel%3Apolicy.model%2Crevision%3Apolicy.revision%2CsourceArchive%3Apolicy.sourceArchive%2C%0A%20%20%20%20views%2Cdriver%3A%7B...policy.driver%2Csource%3Aoriginal.blob.toString%28%27utf8%27%29%2Ccertificate%3Aoriginal.certificate%7D%7D%3B%0A%20%20verifyOwnCodebaseHistoricalNamingSources%28history%29%3B%0A%20%20let%20current%3Dhistory.driver.source%3B%0A%20%20for%28const%20edit%20of%20history.driver.edits%29%7Bassert.equal%28current.split%28edit.before%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28edit.before%2C%28%29%3D%3Eedit.after%29%3B%7D%0A%20%20const%20driver%3Dnew%20URL%28policy.driver.file%2Croot%29%2Cactual%3DreadFileSync%28driver%2C%27utf8%27%29%3B%0A%20%20assert.ok%28actual%3D%3D%3Dhistory.driver.source%7C%7Cactual%3D%3D%3Dcurrent%2C%27an%20unknown%20driver%20cannot%20be%20replaced%20or%20certified%27%29%3B%0A%20%20const%20file%3Dnew%20URL%28%27parity%2Fnaming%2Fown-codebase-baseline-naming-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29%7BcheckProjectData%28file%2Chistory%29%3Bassert.equal%28actual%2Ccurrent%29%3B%7D%0A%20%20else%7BwriteProjectData%28file%2Chistory%29%3BwriteFileSync%28driver%2Ccurrent%29%3B%7D%0A%20%20return%20history%3B%0A%7D%0A%2F%2A%2A%20Append%20only%20independently%20derived%20historical%20names%3B%20current%20extraction%20stays%20separate.%20%2A%2F%0Aexport%20async%20function%20generateAdditionalOwnCodebaseHistoricalNamingSources%28%7Bcheck%3Dfalse%2CauthorOnly%3Dfalse%7D%3D%7B%7D%29%7B%0A%20%20const%20revision%3D%276ffff3b2dc530a5f24c128dadf877f3fa106932b%27%2Cbaseline%3D%278bc0ef9725388c7927acf1854870bf46f5e365be%27%3B%0A%20%20const%20integration%3D%278f2f6c483ec32a3ffc17afec694463965dc7551d%27%3B%0A%20%20const%20file%3D%27parity%2Fnaming%2Farray-identity-historical-inventories.lino%27%3B%0A%20%20let%20sources%2Cstored%3B%0A%20%20if%28check%29%7Bstored%3DreadOwnCodebaseHistoricalNamingPolicy%28%29.additionalSourceViews%3Bsources%3Dstored.sources%3B%7D%0A%20%20else%7B%0A%20%20%20%20const%20originalFiles%3D%5B%27js%2Fsrc%2Ftranslation%2Fjavascript-infer.js%27%2C%27js%2Ftests%2Ftranslation-frontend-rules.test.js%27%2C%0A%20%20%20%20%20%20%27rust%2Ftests%2Funit%2Ftranslation_surface_reference_analysis.rs%27%2C%27js%2Fscripts%2Fown-codebase-baseline-naming-history.mjs%27%5D%3B%0A%20%20%20%20const%20changedAt%3Dselected%3D%3E%7B%0A%20%20%20%20%20%20const%20known%3Dnew%20Set%28execFileSync%28%27git%27%2C%5B%27ls-tree%27%2C%27-r%27%2C%27--name-only%27%2Cselected%5D%2C%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2CmaxBuffer%3A1024%2A1024%7D%29.trim%28%29.split%28%27%5Cn%27%29%29%3B%0A%20%20%20%20%20%20return%20execFileSync%28%27git%27%2C%5B%27diff%27%2Cselected%2C%27--name-only%27%5D%2C%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%7D%29.trim%28%29.split%28%27%5Cn%27%29%0A%20%20%20%20%20%20%20%20.filter%28path%3D%3Eknown.has%28path%29%26%26%2F%5E%28%3F%3Ajs%5C%2F%28%3F%3Asrc%7Cscripts%7Ctests%29%7Crust%5C%2F%28%3F%3Asrc%7Ctests%5C%2Funit%29%7Cexperiments%29%5C%2F.%2B%5C.%28%3F%3Ajs%7Cmjs%7Crs%29%24%2Fu.test%28path%29%29%3B%0A%20%20%20%20%7D%3B%0A%20%20%20%20const%20selections%3D%5B...originalFiles.map%28path%3D%3E%28%7Bpath%2Crevision%7D%29%29%2C...changedAt%28baseline%29.map%28path%3D%3E%28%7Bpath%2Crevision%3Abaseline%7D%29%29%2C%0A%20%20%20%20%20%20...changedAt%28integration%29.map%28path%3D%3E%28%7Bpath%2Crevision%3Aintegration%7D%29%29%5D%3B%0A%20%20%20%20const%20scalarSources%3Dnew%20Map%28%29%3B%0A%20%20%20%20sources%3Dselections.map%28%28%7Bpath%2Crevision%7D%29%3D%3E%7B%0A%20%20%20%20%20%20globalThis.gc%3F.%28%29%3B%0A%20%20%20%20%20%20const%20%7Bblob%2Ccertificate%7D%3DcaptureGitArtifactCertificate%28revision%2Cpath%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28verifyGitArtifactCertificate%28certificate%2Cblob%2C%7Brevision%2Cpath%7D%29%2Cblob%29%3B%0A%20%20%20%20%20%20const%20sourcePin%3Dpin%28blob%29%3B%0A%20%20%20%20%20%20if%28%21scalarSources.has%28sourcePin.sha256%29%29scalarSources.set%28sourcePin.sha256%2Cblob.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20%20%20%2F%2F%20Only%20equal%20immutable%20scalar%20strings%20share%20storage.%20All%20ordered%20source%0A%20%20%20%20%20%20%2F%2F%20rows%2C%20certificates%20and%20containers%20keep%20their%20independent%20identities.%0A%20%20%20%20%20%20return%7Bfile%3Apath%2Cpredecessor%3A%7Brevision%2Csource%3AscalarSources.get%28sourcePin.sha256%29%2C...sourcePin%2Ccertificate%7D%2C%0A%20%20%20%20%20%20%20%20current%3Apin%28readFileSync%28new%20URL%28path%2Croot%29%29%29%7D%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%7D%0A%20%20console.error%28%27Captured%20%27%2Bsources.length%2B%27%20complete%20naming%20source%20epochs.%27%29%3B%0A%20%20%2F%2F%20Finish%20Git%20object%20capture%20before%20retaining%20the%20complete%20naming%20inventory.%0A%20%20%2F%2F%20Its%20binding%20graph%20and%20Git%27s%20pack%20buffers%20need%20separate%20memory%20lifetimes.%0A%20%20globalThis.gc%3F.%28%29%3B%0A%20%20const%20views%3DauthorOnly%3Fawait%20new%20Promise%28%28resolve%2Creject%29%3D%3E%7B%0A%20%20%20%20let%20result%2Cfailure%2Cmessages%3D0%3B%0A%20%20%20%20const%20worker%3Dnew%20Worker%28new%20URL%28%27.%2Fderive-own-codebase-historical-naming-views.mjs%27%2Cimport.meta.url%29%2C%7B%0A%20%20%20%20%20%20workerData%3Asources.map%28%28%7Bfile%2Ccurrent%2Cpredecessor%7D%29%3D%3E%28%7Bfile%2Ccurrent%2Cpredecessor%3A%7Brevision%3Apredecessor.revision%2Csource%3Apredecessor.source%7D%7D%29%29%2C%0A%20%20%20%20%20%20execArgv%3A%5B%5D%2CresourceLimits%3A%7BmaxOldGenerationSizeMb%3A352%2CmaxYoungGenerationSizeMb%3A1%7D%2C%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20worker.on%28%27message%27%2Cvalue%3D%3E%7Bmessages%2B%2B%3Bresult%3Dvalue%3B%7D%29%3B%0A%20%20%20%20worker.on%28%27error%27%2Cerror%3D%3E%7Bfailure%3Derror%3B%7D%29%3B%0A%20%20%20%20%2F%2F%20Wait%20for%20heap%20release%20before%20retaining%20the%20complete%20serialization%20graph.%0A%20%20%20%20worker.on%28%27exit%27%2Ccode%3D%3E%7B%0A%20%20%20%20%20%20if%28failure%29return%20reject%28failure%29%3B%0A%20%20%20%20%20%20if%28code%21%3D%3D0%7C%7Cmessages%21%3D%3D1%7C%7C%21Array.isArray%28result%29%29return%20reject%28new%20Error%28%27complete%20naming%20inventory%20worker%20failed%27%29%29%3B%0A%20%20%20%20%20%20resolve%28result%29%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%7D%29%3AderiveOwnCodebaseHistoricalNamingViews%28sources%2C%28await%20import%28%27.%2Fissue-195-naming.mjs%27%29%29.NAME_INVENTORIES%29%3B%0A%20%20globalThis.gc%3F.%28%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3A1%2Cmodel%3A%27array%20identity%20historical%20naming%20inventories%201%27%2Crevision%2Csources%2Cviews%2C%0A%20%20%20%20boundary%3A%27Each%20supplemental%20name%20is%20derived%20by%20its%20unchanged%20scoped%20inventory%20from%20a%20complete%20independently%20Git-certified%20original%20module.%20Every%20actual%20current%20source%20name%20is%20still%20extracted%20first.%20Historical%20definitions%20retain%20their%20original%20concept%20identities%3B%20a%20changed%20current%20body%20gains%20no%20equivalence%20proof%20from%20this%20source%20view.%20Whole%20current%20source%20hashes%20bind%20selection%20and%20unknown%20source%20bytes%20refuse.%20These%20source%20certificates%20do%20not%20establish%20runtime%20execution%20or%20requirement%20completion.%27%7D%3B%0A%20%20console.error%28%27Derived%20%27%2Bviews.length%2B%27%20historical%20naming%20views.%27%29%3B%0A%20%20if%28check%29%7Bassert.deepEqual%28history%2Cstored%29%3BcheckProjectData%28new%20URL%28file%2Croot%29%2Chistory%29%3B%7D%0A%20%20else%7BwriteProjectData%28new%20URL%28file%2Croot%29%2Chistory%29%3BglobalThis.gc%3F.%28%29%3Bif%28%21authorOnly%29assert.deepEqual%28readOwnCodebaseHistoricalNamingPolicy%28%29.additionalSourceViews%2Chistory%29%3B%7D%0A%20%20return%20history%3B%0A%7D%0A%0A%2F%2F%20The%20normal%20CLI%20keeps%20the%20full%20author%2Freader%20comparison%20while%20separating%0A%2F%2F%20their%20large%20graphs%20into%20fresh%20serial%20processes.%20No%20assertion%20is%20optional%20in%0A%2F%2F%20the%20normal%20command%3B%20the%20internal%20author%20emits%20only%20an%20invocation%20receipt.%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%2Cfile%3Dnew%20URL%28%27..%2F..%2Fparity%2Fnaming%2Farray-identity-historical-inventories.lino%27%2Cimport.meta.url%29%3B%0A%20%20if%28args.length%3D%3D%3D1%26%26args%5B0%5D%3D%3D%3D%27--author-additional-inventories%27%29%7B%0A%20%20%20%20const%20history%3Dawait%20generateAdditionalOwnCodebaseHistoricalNamingSources%28%7BauthorOnly%3Atrue%7D%29%3B%0A%20%20%20%20process.stdout.write%28serializeProjectData%28%7Bsource%3Apin%28readFileSync%28file%29%29%2CcertifiedSources%3Ahistory.sources.length%2CscopedViews%3Ahistory.views.length%2ChistoricalNames%3Ahistory.views.reduce%28%28total%2Crow%29%3D%3Etotal%2Brow.names.length%2C0%29%7D%2C%27receipt.lino%27%29%29%3B%0A%20%20%7Delse%20if%28args.length%3D%3D%3D3%26%26args%5B0%