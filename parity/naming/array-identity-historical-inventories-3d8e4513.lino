thority%3Aoriginal.authority%7D%29%2Crows%3AoldCount%7D%2C%0A%20%20current%3A%7B...pin%28readFileSync%28new%20URL%28file%2Croot%29%29%29%2Crows%3Alist.length%7D%2C%0A%20%20sources%3Asources.map%28path%3D%3E%28%7Bpath%2C...pin%28readFileSync%28new%20URL%28path%2Croot%29%29%29%7D%29%29%2Cadditions%2C%0A%20%20boundary%3A%27Append-only%20source-qualified%20operation%20records.%20Removing%20exactly%20these%20additions%20reconstructs%20every%20complete%20original%20register%20byte%2C%20row%2C%20alias%20and%20order.%20No%20earlier%20identity%20is%20reassigned%20and%20no%20equal-name%20equivalence%20is%20asserted.%20Full%20WordNet%20naming%2C%20native%20execution%20and%20all%20requirement%20checks%20remain%20mandatory.%27%7D%3B%0A%20if%28check%29checkProjectData%28new%20URL%28receiptFile%2Croot%29%2Creceipt%29%3Belse%20writeProjectData%28new%20URL%28receiptFile%2Croot%29%2Creceipt%29%3B%0A%20return%7Bsection%2CpreviousRows%3AoldCount%2Crows%3Alist.length%2Cadded%3Aadditions.length%7D%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20const%20args%3Dprocess.argv.slice%282%29%2Ccheck%3Dargs.at%28-1%29%3D%3D%3D%27--check%27%3Bif%28check%29args.pop%28%29%3Bassert.ok%28args.length%3D%3D%3D2%26%26args%5B0%5D%3D%3D%3D%27--section%27%29%3B%0A%20console.log%28JSON.stringify%28generateModuleScopeNaming%28%7Bsection%3Aargs%5B1%5D%2Ccheck%7D%29%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
