%7Bend--%3Bfinish--%3B%7D%0A%20return%7Bstart%3Aleft.slice%280%2Cstart%29.join%28%27%27%29.length%2Cremoved%3Aleft.slice%28start%2Cend%29.join%28%27%27%29%2Cinserted%3Aright.slice%28start%2Cfinish%29.join%28%27%27%29%7D%3B%0A%7D%0Aexport%20function%20verifyTypedSourceDescriptorHostHistory%28packet%29%7B%0A%20assert.deepEqual%28Object.keys%28packet%29.sort%28%29%2C%5B%27boundary%27%2C%27model%27%2C%27revision%27%2C%27rows%27%2C%27schemaVersion%27%5D%29%3B%0A%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27complete%20typed%20source%20descriptor%20host%20history%201%27%29%3Bassert.equal%28packet.revision%2CTYPED_SOURCE_DESCRIPTOR_HOST_REVISION%29%3B%0A%20assert.deepEqual%28packet.rows.map%28row%3D%3Erow.file%29%2CTYPED_SOURCE_DESCRIPTOR_HOST_FILES%29%3B%0A%20for%28const%20row%20of%20packet.rows%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27current%27%2C%27edit%27%2C%27file%27%2C%27previous%27%5D%29%3B%0A%20%20assert.deepEqual%28Object.keys%28row.previous%29.sort%28%29%2C%5B%27bytes%27%2C%27certificate%27%2C%27sha256%27%2C%27source%27%5D%29%3Bassert.deepEqual%28Object.keys%28row.current%29.sort%28%29%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20assert.deepEqual%28pinTypedSourceDescriptorHost%28row.previous.source%29%2C%7Bbytes%3Arow.previous.bytes%2Csha256%3Arow.previous.sha256%7D%29%3B%0A%20%20assert.deepEqual%28pinTypedSourceDescriptorHost%28row.current.source%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28row.previous.certificate%2CBuffer.from%28row.previous.source%29%2C%7Brevision%3Apacket.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%20assert.deepEqual%28row.edit%2CderiveTypedSourceDescriptorHostEdit%28row.previous.source%2Crow.current.source%29%29%3B%0A%20%20const%20%7Bstart%2Cremoved%2Cinserted%7D%3Drow.edit%3Bassert.equal%28row.current.source.slice%28start%2Cstart%2Binserted.length%29%2Cinserted%29%3B%0A%20%20assert.equal%28row.current.source.slice%280%2Cstart%29%2Bremoved%2Brow.current.source.slice%28start%2Binserted.length%29%2Crow.previous.source%29%3B%0A%20%7D%0A%20return%20packet%3B%0A%7D%0Aexport%20function%20readTypedSourceDescriptorHostHistory%28%29%7B%0A%20if%28%21cached%29%7Bconst%20bytes%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2BTYPED_SOURCE_DESCRIPTOR_HOST_OUTPUT%2Cimport.meta.url%29%29%3Bassert.equal%28pinTypedSourceDescriptorHost%28bytes%29.sha256%2CpacketSha256%29%3Bcached%3DverifyTypedSourceDescriptorHostHistory%28readBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%29%3B%7D%0A%20return%20structuredClone%28cached%29%3B%0A%7D%0Aexport%20function%20restoreTypedSourceDescriptorHostSource%28source%2Cfile%29%7B%0A%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bif%28%21TYPED_SOURCE_DESCRIPTOR_HOST_FILES.includes%28file%29%29return%20source%3B%0A%20const%20row%3DreadTypedSourceDescriptorHostHistory%28%29.rows.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Breturn%20source%3D%3D%3Drow.current.source%3Frow.previous.source%3Asource%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
