8hostSuccessorsOnly%29return%20restoreToolingHostSuccessor%28source%2Cfile%2CpreserveUnknownSource%29%3B%0A%20%20if%28%21TOOLING_FROZEN_HOSTS.some%28row%3D%3Erow.path%3D%3D%3Dfile%29%29return%20source%3B%0A%20%20const%20packet%3DreadToolingFrozenSourceHistory%28%29%2Crow%3Dpacket.hosts.find%28candidate%3D%3Ecandidate.path%3D%3D%3Dfile%29%3B%0A%20%20assert.ok%28row%29%3Bif%28source%3D%3D%3Drow.source%29return%20source%3B%0A%20%20source%3DrestoreToolingHostSuccessor%28source%2Cfile%29%3B%0A%20%20assert.deepEqual%28toolingFrozenSourcePin%28source%29%2Crow.current%2C%27an%20unknown%20tooling%20host%20successor%20has%20no%20complete%20historical%20source%20authority%27%29%3B%0A%20%20const%20expected%3DTOOLING_FROZEN_HOSTS.find%28candidate%3D%3Ecandidate.path%3D%3D%3Dfile%29%3B%0A%20%20assert.equal%28source%2CreplayToolingFrozenHostChanges%28row.source%2Cexpected.changes%29.source%29%3B%0A%20%20return%20row.source%3B%0A%7D%0A%0Afunction%20restoreToolingHostSuccessor%28source%2Cfile%2CpreserveUnknownSource%3Dfalse%29%7B%0A%20%20if%28%21hostSuccessorFiles.includes%28file%29%29return%20source%3B%0A%20%20const%20row%3DreadToolingHostSuccessorSnapshot%28%29.views.find%28candidate%3D%3Ecandidate.path%3D%3D%3Dfile%29%3B%0A%20%20if%28source%3D%3D%3Drow.previous%29return%20source%3B%0A%20%20%2F%2F%20Earlier%20guards%20still%20authenticate%20their%20own%20complete%20older%20epochs.%20An%0A%20%20%2F%2F%20unrecognized%20input%20gains%20no%20authority%20and%20remains%20visible%20to%20that%20guard.%0A%20%20if%28preserveUnknownSource%26%26source%21%3D%3Drow.current%29return%20source%3B%0A%20%20assert.equal%28source%2Crow.current%2C%27an%20unknown%20complete%20tooling%20host%20has%20no%20historical%20source%20authority%27%29%3B%0A%20%20return%20row.previous%3B%0A%7D%0A%0Afunction%20readToolingHostSuccessorSnapshot%28%29%7B%0A%20%20const%20bytes%3DreadFileSync%28new%20URL%28hostSuccessorPath%2Croot%29%29%3B%0A%20%20%2F%2F%20A%20dependency%20mutation%20remains%20visible%20even%20when%20the%20successor%20is%20cached.%0A%20%20assert.equal%28toolingFrozenSourcePin%28readFileSync%28new%20URL%28policyPath%2Croot%29%29%29.sha256%2CpolicySha256%29%3B%0A%20%20if%28hostSuccessorSnapshot%3F.bytes.equals%28bytes%29%29return%20hostSuccessorSnapshot%3B%0A%20%20hostSuccessorSnapshot%3Dundefined%3B%0A%20%20const%20text%3Dbytes.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28text%29%2Cbytes%29%3B%0A%20%20const%20packet%3DreadBootstrapStructuredDataLino%28text%29%2Cviews%3DverifyToolingFrozenSourceHistory%28packet%2C%7BhostSuccessors%3Atrue%7D%29%3B%0A%20%20hostSuccessorSnapshot%3D%7Bbytes%2Cpacket%2Cviews%7D%3Breturn%20hostSuccessorSnapshot%3B%0A%7D%0A%0A%2F%2A%2A%20Only%20the%20complete%20certified%20current%20source%20gets%20its%20older%20source%20view%3B%0A%20%2A%20actual%20current%20requirements%20are%20still%20imported%20by%20the%20real%20manifest.%20%2A%2F%0Aexport%20function%20restoreCriticalDeliveryConversationSource%28source%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%0A%20%20const%20frozen%3DreadCriticalDeliveryFrozenSource%28%29%3Bif%28source%3D%3D%3Dfrozen.source%29return%20source%3B%0A%20%20assert.deepEqual%28toolingFrozenSourcePin%28source%29%2C%7Bbytes%3ACURRENT_CONVERSATION_SOURCE.bytes%2Csha256%3ACURRENT_CONVERSATION_SOURCE.sha256%7D%2C%27an%20unknown%20conversation%20source%20cannot%20acquire%20historical%20scope%20authority%27%29%3B%0A%20%20const%20packet%3DreadToolingFrozenSourceHistory%28%29%3Bassert.equal%28source%2Cpacket.conversation.source%29%3B%0A%20%20assert.equal%28source.slice%280%2Cpacket.conversation.append.start%29%2Bsource.slice%28packet.conversation.append.start%2Bpacket.conversation.append.source.length%29%2Cfrozen.source%29%3B%0A%20%20return%20frozen.source%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
