%20const%20CI_TEST_FEEDBACK_CHANGES%3DObject.freeze%28%5B%0A%20%7Bbefore%3A%22import%20%7B%20partitionGroupFiles%2C%20partitionTests%2C%20testFiles%20%7D%20from%20%27.%2Ftest-groups.mjs%27%3B%22%2Cafter%3A%22import%20%7B%20partitionTests%2C%20testFiles%20%7D%20from%20%27.%2Ftest-groups.mjs%27%3B%5Cnimport%20%7BpartitionCiTestGroupFiles%7D%20from%20%27.%2Fci-test-partitions.mjs%27%3B%22%7D%2C%0A%20%7Bbefore%3A%22return%20partitionGroupFiles%28groups.translation%2C%20shard%29.map%28file%20%3D%3E%20%60js%2Ftests%2F%24%7Bfile%7D%60%29%3B%22%2Cafter%3A%22return%20partitionCiTestGroupFiles%28%27translation%27%2Cgroups.translation%2Cshard%29.map%28file%20%3D%3E%20%60js%2Ftests%2F%24%7Bfile%7D%60%29%3B%22%7D%2C%0A%5D%29%3B%0Aconst%20pin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Alet%20cached%3B%0Aexport%20function%20deriveCiTestPartitionWorkflow%28source%29%7B%0A%20let%20current%3Dsource%3B%0A%20for%28const%7Bbefore%2Cafter%7Dof%20CI_TEST_PARTITION_CHANGES%29%7Bassert.equal%28current.split%28before%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28before%2C%28%29%3D%3Eafter%29%3B%7D%0A%20return%20current%3B%0A%7D%0Aexport%20function%20verifyCiTestPartitionHistory%28packet%29%7B%0A%20const%20row%3Dpacket.feedback%3Bassert.equal%28row.file%2C%27js%2Fscripts%2Ftranslation-test-feedback.mjs%27%29%3B%0A%20verifyGitArtifactCertificate%28row.previous.certificate%2CBuffer.from%28row.previous.source%29%2C%7Brevision%3ACI_TEST_PARTITION_REVISION%2Cpath%3Arow.file%7D%29%3B%0A%20assert.deepEqual%28pin%28row.previous.source%29%2C%7Bbytes%3Arow.previous.bytes%2Csha256%3Arow.previous.sha256%7D%29%3B%0A%20let%20feedback%3Drow.previous.source%3Bfor%28const%7Bbefore%2Cafter%7Dof%20CI_TEST_FEEDBACK_CHANGES%29%7Bassert.equal%28feedback.split%28before%29.length%2C2%29%3Bfeedback%3Dfeedback.replace%28before%2C%28%29%3D%3Eafter%29%3B%7D%0A%20assert.equal%28feedback%2Crow.current.source%29%3Bassert.deepEqual%28pin%28feedback%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20for%28const%7Bbefore%2Cafter%7Dof%20%5B...CI_TEST_FEEDBACK_CHANGES%5D.reverse%28%29%29%7Bassert.equal%28feedback.split%28after%29.length%2C2%29%3Bfeedback%3Dfeedback.replace%28after%2C%28%29%3D%3Ebefore%29%3B%7D%0A%20assert.equal%28feedback%2Crow.previous.source%29%3B%0A%20assert.equal%28packet.model%2C%27complete%20CI%20physical%20test%20partition%20succession%201%27%29%3Bassert.equal%28packet.revision%2CCI_TEST_PARTITION_REVISION%29%3B%0A%20assert.equal%28packet.file%2C%27.github%2Fworkflows%2Fjs.yml%27%29%3Bassert.equal%28packet.run%2C39839936265%29%3B%0A%20assert.deepEqual%28packet.changes%2CCI_TEST_PARTITION_CHANGES%29%3B%0A%20assert.deepEqual%28pin%28packet.previous.source%29%2C%7Bbytes%3Apacket.previous.bytes%2Csha256%3Apacket.previous.sha256%7D%29%3B%0A%20verifyGitArtifactCertificate%28packet.previous.certificate%2CBuffer.from%28packet.previous.source%29%2C%7Brevision%3Apacket.revision%2Cpath%3Apacket.file%7D%29%3B%0A%20const%20source%3DderiveCiTestPartitionWorkflow%28packet.previous.source%29%3Bassert.equal%28source%2Cpacket.current.source%29%3B%0A%20assert.deepEqual%28pin%28source%29%2C%7Bbytes%3Apacket.current.bytes%2Csha256%3Apacket.current.sha256%7D%29%3B%0A%20let%20inverse%3Dsource%3Bfor%28const%7Bbefore%2Cafter%7Dof%20%5B...packet.changes%5D.reverse%28%29%29%7Bassert.equal%28inverse.split%28after%29.length%2C2%29%3Binverse%3Dinverse.replace%28after%2C%28%29%3D%3Ebefore%29%3B%7D%0A%20assert.equal%28inverse%2Cpacket.previous.source%29%3Breturn%20packet%3B%0A%7D%0Aexport%20function%20readCiTestPartitionHistory%28%29%7B%0A%20if%28%21cached%29%7Bconst%20bytes%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2BCI_TEST_PARTITION_HISTORY%2Cimport.meta.url%29%29%3Bassert.equal%28pin%28bytes%29.sha256%2CpacketSha256%29%3Bcached%3DverifyCiTestPartitionHistory%28readBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%29%3B%7D%0A%20return%20structured