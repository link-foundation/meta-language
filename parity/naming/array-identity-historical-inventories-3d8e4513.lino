e%20expanded%20current%20source%20view.%20%2A%2F%0Aexport%20function%20generateEvidenceTranslationNamingHistory%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20revision%3D%2715745ffcd322c48bdd537ccb48a5f7c9deb96917%27%3B%0A%20%20const%20files%3D%5B%0A%20%20%20%20%27experiments%2Fgrammar-outcome-network%2Fnative-transport%2Finverse%2Fgenerate-evidence-translation-history.mjs%27%2C%0A%20%20%20%20%27js%2Fscripts%2Fevidence-translation-source-history.mjs%27%2C%0A%20%20%20%20%27js%2Ftests%2Fissue-195-evidence-translation-partition-conservation.test.js%27%2C%0A%20%20%5D%3B%0A%20%20const%20sources%3Dfiles.map%28file%3D%3E%7B%0A%20%20%20%20const%20original%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28original.certificate%2Coriginal.blob%2C%7Brevision%2Cpath%3Afile%7D%29%3B%0A%20%20%20%20const%20sourceText%3Doriginal.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28sourceText%29%2Coriginal.blob%29%3B%0A%20%20%20%20return%7Bfile%2Ccommit%3Arevision%2C...pin%28original.blob%29%2CsourceText%2Ccertificate%3Aoriginal.certificate%2C%0A%20%20%20%20%20%20current%3Apin%28readFileSync%28new%20URL%28file%2Croot%29%29%29%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%2Csources%2C%0A%20%20%20%20boundary%3A%27Original%20complete%20source%20definitions%20retain%20their%20Git%20membership%20and%20every%20byte.%20Expanded%20current%20source%20views%20have%20separately%20qualified%20identities.%20Source%20preservation%20establishes%20neither%20meaning%20equivalence%20nor%20native%20execution.%27%7D%3B%0A%20%20const%20output%3Dnew%20URL%28%27parity%2Fnaming%2Fevidence-translation-source-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20%20return%20packet%3B%0A%7D%0A%2F%2A%2A%20Capture%20exact%20old%20modules%20and%20current%20digests%3B%20this%20proves%20preservation%20only.%20%2A%2F%0Aexport%20function%20generateEvidenceTranslationHistory%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20generateEvidenceTranslationNamingHistory%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20packets%3D%5B%5D%3B%0A%20%20for%28const%20%5Bkind%2Cpaths%5Dof%20%5B%5B%27sources%27%2Csources%5D%2C%5B%27fixtures%27%2Cfixtures%5D%5D%29%7B%0A%20%20%20%20const%20rows%3Dpaths.map%28file%3D%3E%7B%0A%20%20%20%20%20%20const%20original%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%3B%0A%20%20%20%20%20%20verifyGitArtifactCertificate%28original.certificate%2Coriginal.blob%2C%7Brevision%2Cpath%3Afile%7D%29%3B%0A%20%20%20%20%20%20const%20sourceText%3Doriginal.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28sourceText%29%2Coriginal.blob%29%3B%0A%20%20%20%20%20%20const%20current%3DBuffer.from%28restoreNativeCompatibilitySourceHistory%28file%2CreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%29%29%3Bassert.deepEqual%28Buffer.from%28current.toString%28%27utf8%27%29%29%2Ccurrent%29%3B%0A%20%20%20%20%20%20return%7Bfile%2Ccommit%3Arevision%2C...pin%28original.blob%29%2CsourceText%2Ccertificate%3Aoriginal.certificate%2Ccurrent%3Apin%28current%29%7D%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%2Csources%3Arows%2C%0A%20%20%20%20%20%20boundary%3A%27Complete%20authenticated%20original%20modules%20and%20fixtures%20remain%20available%20after%20CI%20repairs.%20Different%20current%20operations%20have%20separate%20identities.%20Source%20conservation%20establishes%20neither%20native%20execution%20nor%20general%20semantic%20equivalence%3B%20unchanged%20fixture%20inputs%20and%20independent%20controls%20remain%20mandatory.%27%7D%3B%0A%20%20%20%20const%20output%3Dnew%20URL%28%27parity%2Fself-translation%2Fevidence-translation-source-%27%2Bkind%2B%27-history.lino%27%2Croot%29%3B%0A%20%20%20%20if%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3Bpackets.push%28packet%29%3B%0A%20%20%7D%0A%20%20c