ataLino%28source%29%29%3B%0A%20%20const%20records%20%3D%20structuredDataRecordToLino%28value%2C%20namespace%29%20%2B%20structuredDataRecordToLino%28%7B%20next%3A%201%20%7D%29%3B%0A%20%20assert.deepEqual%28readBootstrapStructuredDataRecords%28records%29%2C%20readStructuredDataRecords%28records%29%29%3B%0A%20%20assert.throws%28%28%29%20%3D%3E%20readBootstrapStructuredDataLino%28source.replace%28%27%28n%3A%201%29%27%2C%20%27%28n%3A%200%29%27%29%29%2C%20%2Fcanonical%2F%29%3B%0A%20%20assert.throws%28%28%29%20%3D%3E%20readBootstrapStructuredDataLino%28source.slice%280%2C%20-1%29%29%2C%20%2Fincomplete%2F%29%3B%0A%20%20assert.throws%28%28%29%20%3D%3E%20readBootstrapStructuredDataRecords%28records%20%2B%20structuredDataRecordToLino%28null%2C%20namespace%29%29%2C%20%2Fduplicate%2F%29%3B%0A%20%20const%20shared%20%3D%20%5B%27x%27.repeat%2832%29%5D%3B%0A%20%20const%20two%20%3D%20structuredDataRecordToLino%28%5Bshared%2C%20shared%5D%2C%20namespace%29%20%2B%20structuredDataRecordToLino%28%5Bshared%2C%20shared%5D%29%3B%0A%20%20assert.ok%28Buffer.byteLength%28two%29%20%3C%204096%29%3B%0A%20%20assert.throws%28%28%29%20%3D%3E%20readBootstrapStructuredDataRecords%28two%2C%20%7B%20nodeLimit%3A%2010%2C%20byteLimit%3A%204096%20%7D%29%2C%20%2Fexpanded.%2Aresource%2F%29%3B%0A%7D%29%3B%0A%0Atest%28%27cleanup%20before%20npm%20installation%20writes%20canonical%20reports%20using%20only%20repository%20leaf%20modules%27%2C%20t%20%3D%3E%20%7B%0A%20%20const%20fixture%20%3D%20makeRepository%28makeBase%28t%29%29%3B%0A%20%20cpSync%28path.join%28REPOSITORY_ROOT%2C%20%27scripts%27%29%2C%20path.join%28fixture.root%2C%20%27scripts%27%29%2C%20%7B%20recursive%3A%20true%20%7D%29%3B%0A%20%20copyBootstrapDataModules%28fixture.root%29%3B%0A%20%20assert.equal%28existsSync%28path.join%28fixture.root%2C%20%27node_modules%27%29%29%2C%20false%29%3B%0A%20%20assert.equal%28existsSync%28path.join%28fixture.root%2C%20%27js%2Fnode_modules%27%29%29%2C%20false%29%3B%0A%20%20const%20report%20%3D%20path.join%28fixture.base%2