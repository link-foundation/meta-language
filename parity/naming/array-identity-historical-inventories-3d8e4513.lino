t%2B1%3Bat%3Cend%3Bat%2B%2B%29if%28tokens%5Bat%5D.value%3D%3D%3D%27let%27%26%26tokens%5Bat%2B1%5D%3F.value%3D%3D%3D%27script%27%26%26tokens%5Bat%2B2%5D%3F.value%3D%3D%3D%27%3D%27%26%26tokens%5Bat%2B3%5D%3F.kind%3D%3D%3D%27string%27%29scripts.push%28tokens%5Bat%2B3%5D.value%29%3B%0A%20assert.equal%28scripts.length%2C1%2C%27the%20complete%20actual%20native%20oracle%20owns%20exactly%20one%20JavaScript%20contract%27%29%3Breturn%20scripts%5B0%5D%3B%0A%7D%0Aconst%20execute%3D%28script%2Cargs%3D%5B%5D%29%3D%3EexecFileSync%28process.execPath%2C%5B%27--max-old-space-size%3D352%27%2C%27--max-semi-space-size%3D1%27%2C%27--input-type%3Dmodule%27%2C%27-e%27%2Cscript%2C...args%5D%2C%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2Ctimeout%3A20000%2CmaxBuffer%3A2%2A1024%2A1024%2Cstdio%3A%5B%27ignore%27%2C%27pipe%27%2C%27pipe%27%5D%7D%29%3B%0Atest%28%27the%20actual%20CI%20native%20contract%20transports%20every%20original%20shared-array%20source%20and%20both%20complete%20emitted%20field%20sets%27%2C%28%29%3D%3E%7B%0A%20const%20script%3DnativeContractScript%28%29%3B%0A%20for%28const%20row%20of%20rustSharedArrayHandleRulesPolicy%28%29.cases%29%7B%0A%20%20const%20contract%3DreadStructuredDataLino%28execute%28script%2C%5Brow.source%2Crow.call%5D%29%29%3B%0A%20%20assert.ok%28contract.source.startsWith%28contract.library%29%29%3Bassert.match%28contract.source%2C%2Ffn%20main%5C%28%5C%29%5C%7Bprintln%21%5C%28%22%5C%7B%5C%7D%22%2C%2Fu%29%3B%0A%20%20assert.equal%28contract.surface.main.effects%5B0%5D.k%2C%27print%27%29%3B%0A%20%20for%28const%20target%20of%20%5B%27javascript%27%2C%27rust%27%5D%29for%28const%20field%20of%20%5B%27language%27%2C%27text%27%2C%27definitions%27%2C%27preludes%27%2C%27mappings%27%2C%27assumptions%27%2C%27encodings%27%2C%27theorems%27%2C%27entry%27%5D%29%7B%0A%20%20%20assert.ok%28Object.hasOwn%28contract%5Btarget%5D%2Cfield%29%2Ctarget%2B%27%20%27%2Bfield%2B%27%20remains%20in%20the%20native%20parity%20oracle%27%29%3B%0A%20%20%7D%0A%20%20assert.ok%28contract.javascript.definitions.length%3E0%29%3Bassert.ok%28contract.rust.definitions.length%3E0%29%3B%0A%20%20const%20original%3Dexecute%28row.source%2B%27%5Cnconsole.log%28%27%2Brow.call%2B%27%28%29%29%3B%27%29%3B%0A%20%20assert.equal%28original%2CString%28row.expected%29%2B%27%5Cn%27%29%3Bassert.equal%28execute%28contract.javascript.text%29%2Coriginal%29%3B%0A%20%7D%0A%7D%29%3B%0Atest%28%27native%20contract%20serialization%20refuses%20missing%20required%20values%20rather%20than%20dropping%20them%20with%20optional%20annotations%27%2C%28%29%3D%3E%7B%0A%20const%20script%3DnativeContractScript%28%29%2Cmarker%3D%27console.log%28structuredDataToLino%28%27%3Bassert.equal%28script.split%28marker%29.length%2C2%29%3B%0A%20const%20corrupted%3Dscript.replace%28marker%2C%27surface.items%5B0%5D.body.value%3Dundefined%3B%5Cn%27%2Bmarker%29%2Crow%3DrustSharedArrayHandleRulesPolicy%28%29.cases%5B0%5D%3B%0A%20assert.throws%28%28%29%3D%3Eexecute%28corrupted%2C%5Brow.source%2Crow.call%5D%29%2Cerror%3D%3Eerror.status%21%3D%3D0%26%26String%28error.stderr%29.includes%28%27only%20an%20absent%20optional%20let%20type%20may%20be%20omitted%27%29%29%3B%0A%20for%28const%20mutation%20of%20%5B%0A%20%20%27Object.defineProperty%28surface%2C%22hidden%22%2C%7Bvalue%3Atrue%7D%29%3B%27%2C%0A%20%20%27surface%5BSymbol%28%22hidden%22%29%5D%3Dtrue%3B%27%2C%0A%20%20%27Object.defineProperty%28surface%2C%22accessor%22%2C%7Benumerable%3Atrue%2Cget%28%29%7Bthrow%20new%20Error%28%22accessor%20must%20not%20execute%22%29%3B%7D%7D%29%3B%27%2C%0A%20%20%27Object.setPrototypeOf%28surface%2C%7Binherited%3Atrue%7D%29%3B%27%2C%0A%20%20%27delete%20surface.items%5B0%5D%3B%27%2C%0A%20%20%27surface.items.extra%3Dtrue%3B%27%2C%0A%20%5D%29%7B%0A%20%20const%20invalid%3Dscript.replace%28marker%2Cmutation%2B%27%5Cn%27%2Bmarker%29%3B%0A%20%20assert.throws%28%28%29%3D%3Eexecute%28invalid%2C%5Brow.source%2Crow.call%5D%29%2Cerror%3D%3Eerror.status%21%3D%3D0%26%26String%28error.stderr%29.includes%28%27native%20surface%20contract%20requires%27%29%29%3B%0A%20%7D%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
