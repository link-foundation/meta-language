(115454: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Lossless%20serialization%20of%20a%20link%20network%20to%20and%20from%20Links%20Notation%20text.%0A%2F%2F%0A%2F%2F%20Mirrors%20%60rust%2Fsrc%2Flino_serialization.rs%60%3A%20every%20link%20becomes%20one%20statement%0A%2F%2F%0A%2F%2F%20%20%20%28%3Cid%3E%3A%20%3Cref%3E%20...%20%28meta%3A%20%28t%3A%20%3Ctype%3E%29%20%28n%3A%20%3C0%7C1%3E%29%20%28term%3A%20%3Cpct%3E%29%20...%29%29%0A%2F%2F%0A%2F%2F%20keyed%20by%20its%20numeric%20id.%20String%20payloads%20%28%60term%60%2C%20%60def%60%2C%20%60lang%60%29%20are%0A%2F%2F%20percent-encoded%20so%20they%20always%20form%20a%20single%20escape-free%20reference%20token.%0A%2F%2F%20Both%20runtimes%20write%20byte-identical%20text%20for%20the%20same%20network%20and%20read%20each%0A%2F%2F%20other%27s%20output%20back%20into%20the%20same%20links%2C%20terms%20and%20metadata.%0A%0Aimport%20%7B%20Parser%20%7D%20from%20%27links-notation%27%3B%0A%0Aimport%20%7B%0A%20%20ByteRange%2C%0A%20%20LinkFlags%2C%0A%20%20LinkId%2C%0A%20%20LinkMetadata%2C%0A%20%20LinkType%2C%0A%20%20Point%2C%0A%20%20SourceSpan%2C%0A%7D%20from%20%27.%2Fprimitives.js%27%3B%0A%0Aimport%20%7B%20LinoSerializationError%2C%20linkTypeFromToken%2C%20percentDecode%2C%20structureError%20%7D%20from%20%27.%2Flino-serialization-write.js%27%3B%0Aexport%20%7B%20LinoSerializationError%2C%20linkTypeToken%2C%20linkTypeFromToken%2C%20percentEncode%2C%20percentDecode%2C%20encodeLinkStatement%2C%20encodeNetworkLino%20%7D%20from%20%27.%2Flino-serialization-write.js%27%3B%0A%0A%2F%2A%2A%20Whether%20parsed%20Links%20Notation%20statements%20use%20the%20canonical%20%60meta%60%20sublink%20form.%20%2A%2F%0Aexport%20function%20hasMetaSublinks%28statements%29%20%7B%0A%20%20return%20statements.some%28%28statement%29%20%3D%3E%20%28%0A%20%20%20%20%28statement.values%20%3F%3F%20%5B%5D%29.some%28%28value%29%20%3D%3E%20value.id%20%3D%3D%3D%20%27meta%27%20%26%26%20%28value.values%20%3F%3F%20%5B%5D%29.length%20%3E%200%29%0A%20%20%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Parses%20Links%20Notation%20text%20the%20way%20the%20canonical%20reader%20does%20%28comments%20off%29.%20%2A%2F%0Aexport%20function%20parseLinoStatements%28source%29%20%7B%0A%20%20try%20%7B%0A%20%20%20%20return%20new%20Parser%28%7B%20comments%3A%20false%20%7D%29.parse%28source%29%3B%0A%20%20%7D%20catch%20%28error%29%20%7B%0A%20%20%20%20throw%20new%20LinoSerializationError%28%27parse%27%2C%20error.message%29%3B%0A%20%20%7D%0A%7D%0A%0Afunction%20parseNumber%28value%2C%20message%29%20%7B%0A%20%20if%20%28value%20%3D%3D%3D%20undefined%20%7C%7C%20value%20%3D%3D%3D%20null%20%7C%7C%20%21%2F%5E%5Cd%2B%24%2F.test%28String%28value%29%29%29%20%7B%0A%20%20%20%20throw%20structureError%28message%28value%29%29%3B%0A%20%20%7D%0A%20%20return%20Number%28value%29%3B%0A%7D%0A%0Afunction%20parseLinkId%28value%29%20%7B%0A%20%20try%20%7B%0A%20%20%20%20if%20%28typeof%20value%20%21%3D%3D%20%27string%27%20%7C%7C%20%21%2F%5E%5Cd%2B%24%2Fu.test%28value%29%29%20throw%20new%20TypeError%28%27invalid%20numeric%20token%27%29%3B%0A%20%20%20%20return%20LinkId.from%28value%29.asU64%28%29%3B%0A%20%20%7D%0A%20%20catch%20%7B%20throw%20structureError%28%60invalid%20link%20id%20%5C%60%24%7Bvalue%7D%5C%60%60%29%3B%20%7D%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Decodes%20canonical%20statements%20into%20%60%7B%20id%2C%20references%2C%20metadata%2C%20registered%20%7D%60%0A%20%2A%20records.%20Throws%20%60LinoSerializationError%60%20on%20the%20same%20inputs%20Rust%27s%0A%20%2A%20%60LinkNetwork%3A%3Afrom_lino%60%20rejects.%0A%20%2A%2F%0Aexport%20function%20decodeCanonicalStatements%28statements%29%20%7B%0A%20%20const%20records%20%3D%20%5B%5D%3B%0A%20%20for%20%28const%20statement%20of%20statements%29%20%7B%0A%20%20%20%20if%20%28statement.id%20%3D%3D%3D%20null%20%7C%7C%20statement.id%20%3D%3D%3D%20undefined%20%7C%7C%20statement.values.length%20%3D%3D%3D%200%29%20%7B%0A%20%20%20%20%20%20throw%20structureError%28%27top-level%20statement%20must%20be%20an%20identified%20link%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20id%20%3D%20parseLinkId%28statement.id%29%3B%0A%20%20%20%20const%20references%20%3D%20%5B%5D%3B%0A%20%20%20%20let%20metaFields%3B%0A%20%20%20%20for%20%28const%20value%20of%20statement.values%29%20%7B%0A%20%20%20%20%20%20if%20%28value.values.length%20%3D%3D%3D%200%20%26%26%20value.id%20%21%3D%3D%20null%29%20%7B%0A%20%20%20%20%20%20%20%20references.push%28parseLinkId%28value.id%29%29%3B%0A%20%20%20%20%20%20%7D%20else%20if%20%28value.id%20%3D%3D%3D%20%27meta%27%29%20%7B%0A%20%20%20%20%20%20%20%20metaFields%20%3D%20value.values%3B%0A%20%20%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20%20%20throw%20structureError%28%27statement%20values%20must%20be%20references%20or%20a%20meta%20sublink%27%29%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28%21metaFields%29%20%7B%0A%20%20%20%20%20%20throw%20structureError%28%27statement%20is%20missing%20its%20meta%20sublink%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20%7B%20metadata%2C%20registered%20%7D%20%3D%20decodeMeta%28metaFields%29%3B%0A%20%20%20%20records.push%28%7B%20id%2C%20references%2C%20metadata%2C%20registered%20%7D%29%3B%0A%20%20%7D%0A%20%20return%20records%3B%0A%7D%0A%0Afunction%20decodeMeta%28fields%29%20%7B%0A%20%20let%20metadata%20%3D%20LinkMetadata.new%28%29%3B%0A%20%20let%20registered%20%3D%20false%3B%0A%20%20let%20bits%20%3D%200%3B%0A%20%20for%20%28const%20field%20of%20fields%29%20%7B%0A%20%20%20%20if%20%28field.id%20%3D%3D%3D%20null%20%7C%7C%20field.id%20%3D%3D%3D%20undefined%20%7C%7C%20field.values.length%20%3D%3D%3D%200%29%20%7B%0A%20%20%20%20%20%20throw%20structureError%28%27meta%20field%20must%20be%20an%20identified%20link%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20switch%20%28field.id%29%20%7B%0A%20%20%20%20%20%20case%20%27t%27%3A%0A%20%20%20%20%20%20%20%20metadata%20%3D%20metadata.withLinkType%28linkTypeFromToken%28singleReference%28field%29%29%29%3B%0A%20%20%20%20%20%20%20%20break%3B%0A%20%20%20%20%20%20case%20%27n%27%3A%0A%20%20%20%20%20%20%20%20metadata%20%3D%20met