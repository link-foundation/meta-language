B%0A%0Atest%28%27owned%20history%20migrates%20legacy%20records%20once%20and%20keeps%20exactly%20the%20latest%20200%27%2C%20t%20%3D%3E%20%7B%0A%20%20const%20fixture%20%3D%20makeRepository%28makeBase%28t%29%29%3B%0A%20%20const%20state%20%3D%20path.join%28fixture.root%2C%20%27.git%2Fmeta-language-cache%27%29%3B%0A%20%20mkdirSync%28state%2C%20%7B%20recursive%3A%20true%20%7D%29%3B%0A%20%20writeFileSync%28path.join%28state%2C%20%27history.jsonl%27%29%2C%20Array.from%28%7B%20length%3A%20205%20%7D%2C%20%28_%2C%20sequence%29%20%3D%3E%20JSON.stringify%28%7B%20sequence%20%7D%29%29.join%28%27%5Cn%27%29%20%2B%20%27%5Cn%27%29%3B%0A%20%20writeFileSync%28path.join%28state%2C%20%27last-run.json%27%29%2C%20%27%7B%7D%5Cn%27%29%3B%0A%20%20const%20report%20%3D%20runCleanup%28%7B%20cwd%3A%20fixture.root%2C%20tmpRoot%3A%20fixture.tmpRoot%2C%20classes%3A%20%5B%27javascript%27%5D%2C%20docker%3A%20false%2C%20preflight%3A%20false%20%7D%29%3B%0A%20%20const%20history%20%3D%20readBootstrapStructuredDataRecords%28readFileSync%28path.join%28state%2C%20%27history.lino%27%29%2C%20%27utf8%27%29%29%3B%0A%20%20assert.equal%28history.length%2C%20200%29%3B%0A%20%20assert.deepEqual%28history%5B0%5D%2C%20%7B%20sequence%3A%206%20%7D%29%3B%0A%20%20assert.equal%28history.at%28-1%29.reclaimedBytes%2C%20report.reclaimedBytes%29%3B%0A%20%20assert.equal%28existsSync%28path.join%28state%2C%20%27history.jsonl%27%29%29%2C%20false%29%3B%0A%20%20assert.equal%28existsSync%28path.join%28state%2C%20%27last-run.json%27%29%29%2C%20false%29%3B%0A%20%20runCleanup%28%7B%20cwd%3A%20fixture.root%2C%20tmpRoot%3A%20fixture.tmpRoot%2C%20classes%3A%20%5B%27javascript%27%5D%2C%20docker%3A%20false%2C%20preflight%3A%20false%20%7D%29%3B%0A%20%20const%20next%20%3D%20readBootstrapStructuredDataRecords%28readFileSync%28path.join%28state%2C%20%27history.lino%27%29%2C%20%27utf8%27%29%29%3B%0A%20%20assert.equal%28next.length%2C%20200%29%3B%0A%20%20assert.deepEqual%28next%5B0%5D%2C%20%7B%20sequence%3A%207%20%7D%29%3B%0A%7D%29%3B%0A%0Atest%28%