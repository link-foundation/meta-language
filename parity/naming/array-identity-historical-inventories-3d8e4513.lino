(25709: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Normal%20writer%20for%20the%20exact%20workflow%20change%2C%20independent%20of%20runtime%20execution.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BreadFileSync%2CwriteFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BcaptureGitArtifactCertificate%7D%20from%20%27.%2Fcapture-git-artifact-certificate.mjs%27%3B%0Aimport%20%7BcheckProjectData%2CwriteProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7BCI_TEST_PARTITION_REVISION%2CCI_TEST_PARTITION_HISTORY%2CCI_TEST_PARTITION_CHANGES%2CderiveCiTestPartitionWorkflow%2CverifyCiTestPartitionHistory%7D%20from%20%27.%2Fci-test-partition-history.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%2Cpin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aexport%20function%20generateCiTestPartitionHistory%28%7Bcheck%3Dfalse%2Capply%3Dfalse%7D%3D%7B%7D%29%7B%0A%20assert.equal%28check%26%26apply%2Cfalse%29%3Bconst%20file%3D%27.github%2Fworkflows%2Fjs.yml%27%2Ccaptured%3DcaptureGitArtifactCertificate%28CI_TEST_PARTITION_REVISION%2Cfile%29%3B%0A%20const%20source%3Dcaptured.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28source%29%2Ccaptured.blob%29%3B%0A%20const%20current%3DderiveCiTestPartitionWorkflow%28source%29%2Cactual%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3Bassert.ok%28actual%3D%3D%3Dsource%7C%7Cactual%3D%3D%3Dcurrent%2C%27unknown%20workflow%20changes%20refuse%27%29%3B%0A%20const%20feedbackFile%3D%27js%2Fscripts%2Ftranslation-test-feedback.mjs%27%2CpreviousFeedback%3DcaptureGitArtifactCertificate%28CI_TEST_PARTITION_REVISION%2CfeedbackFile%29%3B%0A%20const%20oldFeedback%3DpreviousFeedback.blob.toString%28%27utf8%27%29%2CcurrentFeedback%3DreadFileSync%28new%20URL%28feedbackFile%2Croot%29%2C%27utf8%27%29%3B%0A%20const%20feedback%3D%7Bfile%3AfeedbackFile%2Cprevious%3A%7Bsource%3AoldFeedback%2C...pin%28oldFeedback%29%2Ccertificate%3ApreviousFeedback.certificate%7D%2Ccurrent%3A%7Bsource%3AcurrentFeedback%2C...pin%28currentFeedback%29%7D%7D%3B%0A%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27complete%20CI%20physical%20test%20partition%20succession%201%27%2Crevision%3ACI_TEST_PARTITION_REVISION%2Crun%3A39839936265%2Cfile%2C%0A%20%20previous%3A%7Bsource%2C...pin%28source%29%2Ccertificate%3Acaptured.certificate%7D%2Ccurrent%3A%7Bsource%3Acurrent%2C...pin%28current%29%7D%2Cchanges%3ACI_TEST_PARTITION_CHANGES%2Cfeedback%2C%0A%20%20boundary%3A%27Physical%20twelve-cell%20translation%20and%20eight-cell%20conformance%20scheduling%20only.%20Each%20pair%20retains%20exactly%20one%20complete%20original%20logical%20partition%3B%20tests%20still%20execute%20serially%20within%20each%20runner%20under%20the%20unchanged%20fifteen-minute%20deadline.%20Every%20original%20assertion%2C%20test%20file%2C%20feedback%20payload%20and%20failure%20predicate%20remains%20mandatory.%20Twelve%20exact-commit%20feedback%20partitions%20must%20merge%20without%20missing%20or%20foreign%20scope.%20Source%20conservation%20is%20not%20test%20execution%20or%20requirement%20completion.%27%7D%3B%0A%20verifyCiTestPartitionHistory%28packet%29%3Bconst%20output%3Dnew%20URL%28CI_TEST_PARTITION_HISTORY%2Croot%29%3B%0A%20if%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20const%20helper%3Dnew%20URL%28%27js%2Fscripts%2Fci-test-partition-history.mjs%27%2Croot%29%2Ctext%3DreadFileSync%28helper%2C%27utf8%27%29%2Cpattern%3D%2Fconst%20packetSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%3B%0A%20assert.equal%28text.split%28pattern%29.length%2C2%29%3Bconst%20expected%3Dtext.replace%28pattern%2C%22const%20packetSha256%3D%27%22%2Bpin%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20if%28check%29%7Bassert.equal%28actual%2Ccurrent%29%3Bassert.equal%28text%2Cexpected%29%3B%7Delse%7BwriteFileSync%28helper%2Cexpected%29%3Bif%28apply%29writeFileSync%28new%20URL%28file%2Croot%29%2Ccurrent%29%3B%7D%0A%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3E%5B%27--check%27%2C%27--apply%27%5D.includes%28value%29%29%29%3B%0A%20generateCiTestPartitionHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%2Capply%3Aprocess.argv.includes%28%27--apply%27%29%7D%29%3Bconsole.log%28%27Preserved%20complete%20logical%20test%20cohorts%20and%20unchanged%20deadlines%20across%20smaller%20physical%20partitions.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
