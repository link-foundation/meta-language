0roots%5B0%5D%29%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%20The%20canonical%20numeric%20graph%20format%20emitted%20by%20structuredDataToLino.%20%2A%2F%0Aexport%20function%20readBootstrapStructuredDataLino%28source%2C%20options%20%3D%20%7B%7D%29%20%7B%0A%20%20textLimit%28source%2C%20options%29%3B%0A%20%20if%20%28%21source.endsWith%28%27%5Cn%27%29%29%20fail%28%27incomplete%20canonical%20document%27%29%3B%0A%20%20return%20graph%28source%2C%20null%2C%20options%29.value%3B%0A%7D%0A%0A%2F%2A%2A%20One%20physical%20line%20per%20complete%20UUID-scoped%20owned%20data%20frame.%20%2A%2F%0Aexport%20function%20readBootstrapStructuredDataRecords%28source%2C%20options%20%3D%20%7B%7D%29%20%7B%0A%20%20const%20limits%20%3D%20textLimit%28source%2C%20options%29%3B%0A%20%20if%20%28source%20%26%26%20%21source.endsWith%28%27%5Cn%27%29%29%20fail%28%27incomplete%20canonical%20record%27%29%3B%0A%20%20for%20%28const%20%5Blabel%2C%20value%5D%20of%20%5B%5B%27t%27%2C%20%27semantic%27%5D%2C%20%5B%27n%27%2C%20%271%27%5D%2C%20%5B%27term%27%2C%20%27structured%2520data%2520record%27%5D%2C%20%5B%27def%27%2C%20%271%27%5D%2C%20%5B%27lang%27%2C%20%27meta-language%2520structured%2520data%27%5D%5D%29%20%7B%0A%20%20%20%20if%20%28%21acceptStructuredDataRecordField%28label%2C%20value%29%29%20fail%28%27unsupported%20shared%20record%20model%27%29%3B%0A%20%20%7D%0A%20%20const%20namespaces%20%3D%20new%20Set%28%29%3B%0A%20%20const%20values%20%3D%20%5B%5D%3B%0A%20%20let%20serializedBytes%20%3D%200%3B%0A%20%20let%20expandedNodes%20%3D%200%3B%0A%20%20let%20expandedBytes%20%3D%200%3B%0A%20%20for%20%28const%20line%20of%20source.split%28%27%5Cn%27%29.slice%280%2C%20-1%29%29%20%7B%0A%20%20%20%20const%20prefix%20%3D%20%2F%5E%5C%28%28%5B0-9a-f-%5D%2B%29%5C%2Frecord%3A%20%5C1%5C%2F%28%5B1-9%5D%5B0-9%5D%2A%29%20%2Fu.exec%28line%29%3B%0A%20%20%20%20if%20%28%21prefix%20%7C%7C%20%21namespacePattern.test%28prefix%5B1%5D%29%20%7C%7C%20namespaces.has%28prefix%5B1%5D%29%20%7C%7C%20%21line.endsWith%28frameFields%29%29%20fail%28%27invalid%20or%20duplicate%20record%20namespace%27%29%3B%0A%20%20%20%20if%20%28namespaces.size%20%3E%3D%20limits.nodeLimit%29%20fail%28%27record%20resource%20limit%20exceeded%27%29%3B%0A%20%20%20%20namespaces.add%28prefix%5B1%5D%29%3B%0A%20%20%20%20serializedBytes%20%2B%3D%20encoder.encode%28line%29.length%3B%0A%20%20%20%20if%20%28serializedBytes%20%3E%20limits.byteLimit%29%20fail%28%27record%20byte%20resource%20limit%20exceeded%27%29%3B%0A%20%20%20%20const%20sourceGraph%20%3D%20line.slice%28prefix%5B0%5D.length%2C%20-frameFields.length%29%3B%0A%20%20%20%20const%20%7B%20value%2C%20cost%20%7D%20%3D%20graph%28sourceGraph%2C%20prefix%5B1%5D%2C%20limits%2C%20identity%28prefix%5B2%5D%29%29%3B%0A%20%20%20%20expandedNodes%20%2B%3D%20cost.nodes%3B%20expandedBytes%20%2B%3D%20cost.bytes%3B%0A%20%20%20%20if%20%28expandedNodes%20%3E%20limits.nodeLimit%20%7C%7C%20expandedBytes%20%3E%20limits.byteLimit%29%20fail%28%27expanded%20record%20resource%20limit%20exceeded%27%29%3B%0A%20%20%20%20values.push%28value%29%3B%0A%20%20%7D%0A%20%20return%20values%3B%0A%7D%0A%0A%2F%2A%2A%20Opt-in%20inspection%20of%20the%20same%20completely%20validated%20canonical%20graph.%20Existing%0A%20%2A%20readers%2C%20their%20exact%20bodies%2C%20and%20default%20resource%20limits%20remain%20unchanged.%20%2A%2F%0Aexport%20function%20inspectBootstrapStructuredDataLino%28source%2C%20options%20%3D%20%7B%7D%29%20%7B%0A%20%20textLimit%28source%2C%20options%29%3B%0A%20%20if%20%28%21source.endsWith%28%27%5Cn%27%29%29%20fail%28%27incomplete%20canonical%20document%27%29%3B%0A%20%20return%20graph%28source%2C%20null%2C%20options%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
