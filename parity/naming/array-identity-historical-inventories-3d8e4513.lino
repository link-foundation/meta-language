pt%27%29.code%2C%20entry.source%2C%20entry.name%29%3B%0A%20%20%20%20%20%20for%20%28const%20observation%20of%20%5Bentry%2C%20...%28entry.additionalCalls%20%3F%3F%20%5B%5D%29%5D%29%20%7B%0A%20%20%20%20%20%20%20%20const%20name%20%3D%20observation%20%3D%3D%3D%20entry%20%3F%20entry.name%20%3A%20%60%24%7Bentry.name%7D-%24%7Bobservation.name%7D%60%3B%0A%20%20%20%20%20%20%20%20const%20expected%20%3D%20execFileSync%28process.execPath%2C%20%5B%27--input-type%3Dmodule%27%2C%20%27-e%27%2C%20%60%24%7Bentry.source%7D%5Cnconsole.log%28%24%7Bobservation.call%7D%29%3B%60%5D%2C%20%7B%20encoding%3A%20%27utf8%27%2C%20timeout%3A%2010_000%20%7D%29%3B%0A%20%20%20%20%20%20%20%20assert.equal%28expected%2C%20observation.expected%2C%20name%29%3B%0A%20%20%20%20%20%20%20%20if%20%28%21directory%29%20continue%3B%0A%20%20%20%20%20%20%20%20const%20source%20%3D%20path.join%28directory%2C%20%60%24%7Bname%7D.rs%60%29%3B%0A%20%20%20%20%20%20%20%20const%20binary%20%3D%20path.join%28directory%2C%20process.platform%20%3D%3D%3D%20%27win32%27%20%3F%20%60%24%7Bname%7D.exe%60%20%3A%20name%29%3B%0A%20%20%20%20%20%20%20%20writeFileSync%28source%2C%20%60%24%7Btranslated.code%7D%5Cnfn%20main%28%29%20%7B%20println%21%28%22%7B%7D%22%2C%20%24%7Bobservation.rustCall%7D%29%3B%20%7D%5Cn%60%29%3B%0A%20%20%20%20%20%20%20%20execFileSync%28%27rustc%27%2C%20%5B%27--edition%27%2C%20%272024%27%2C%20source%2C%20%27-o%27%2C%20binary%5D%2C%20%7B%20stdio%3A%20%27pipe%27%2C%20timeout%3A%2060_000%20%7D%29%3B%0A%20%20%20%20%20%20%20%20const%20actual%20%3D%20execFileSync%28binary%2C%20%5B%5D%2C%20%7B%20encoding%3A%20%27utf8%27%2C%20timeout%3A%2010_000%20%7D%29%3B%0A%20%20%20%20%20%20%20%20assert.equal%28actual%2C%20expected%2C%20name%29%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%20%20%7D%20finally%20%7B%20if%20%28directory%29%20rmSync%28directory%2C%20%7B%20recursive%3A%20true%2C%20force%3A%20true%20%7D%29%3B%20%7D%0A%7D%29%3B%0A%0Atest%28%27a%20carried%20sibling%20and%20its%20caller%20stay%20carried%20without%20poisoning%20an%20independent%20function%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20source%20%3D%20%27%2F%2A%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%5Cnfunction%20good%28%29%20%7B%20return%207%3B%20%7D%5Cn%5Cnfunction%20unavailable%28%29%20%7B%20return%20new%20Date%28%29%3B%20%7D%5Cn%5Cn%2F%2A%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%5Cnexport%20function%20caller%28%29%20%7B%20return%20unavailable%28%29%3B%20%7D%5Cn%27%3B%0A%20%20const%20translated%20%3D%20selfTranslate%28source%2C%20%27JavaScript%27%2C%20%27Rust%27%29%3B%0A%20%20const%20functions%20%3D%20translated.items.filter%28%28%7B%20term%20%7D%29%20%3D%3E%20term%20%3D%3D%3D%20%27function_declaration%27%20%7C%7C%20term%20%3D%3D%3D%20%27export_statement%27%29%3B%0A%20%20assert.deepEqual%28functions.map%28%28%7B%20status%20%7D%29%20%3D%3E%20status%29%2C%20%5B%27translated%27%2C%20%27carried%27%2C%20%27carried%27%5D%29%3B%0A%20%20assert.ok%28%21translated.code.includes%28%27pub%20fn%20unavailable%28%27%29%29%3B%0A%20%20assert.ok%28%21translated.code.includes%28%27pub%20fn%20caller%28%27%29%29%3B%0A%20%20assert.equal%28selfTranslate%28translated.code%2C%20%27Rust%27%2C%20%27JavaScript%27%29.code%2C%20source%29%3B%0A%7D%29%3B%0A%0Atest%28%27mutable%2C%20nonliteral%20and%20temporal-dead-zone%20bindings%20stay%20unbound%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20for%20%28const%20entry%20of%20fixture.refusals%29%20%7B%0A%20%20%20%20const%20translated%20%3D%20selfTranslate%28entry.source%2C%20%27JavaScript%27%2C%20%27Rust%27%29%3B%0A%20%20%20%20const%20functions%20%3D%20translated.items.filter%28%28%7B%20term%20%7D%29%20%3D%3E%20term%20%3D%3D%3D%20%27function_declaration%27%20%7C%7C%20term%20%3D%3D%3D%20%27export_statement%27%29%3B%0A%20%20%20%20assert.deepEqual%28functions.map%28%28%7B%20status%20%7D%29%20%3D%3E%20status%29%2C%20%5B%27carried%27%5D%2C%20entry.name%29%3B%0A%20%20%20%20assert.equal%28selfTranslate%28translated.code%2C%20%27Rust%27%2C%20%27JavaScript%27%29.code%2C%20entry.source%2C%20entry.name%29%3B%0A%20%20%7D%0A%7D%29%3B