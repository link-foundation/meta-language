%20runs%20independently%20to%20keep%20large%20register%20documents%20out%20of%20the%0A%20%2A%20same%20process.%20Complete%20original%20bytes%20and%20ordered%20rows%20survive%20the%20inverse.%20%2A%2F%0Aexport%20function%20generateModuleScopeNaming%28%7Bsection%2Ccheck%3Dfalse%7D%3D%7B%7D%29%7B%0A%20assert.ok%28%5B%27canonical%27%2C%27bindings%27%5D.includes%28section%29%29%3Bconst%20rows%3Doperations%28%29%3B%0A%20const%20file%3Dsection%3D%3D%3D%27canonical%27%3F%27parity%2Fnaming%2Fcanonical-concepts.lino%27%3A%27parity%2Fnaming%2Fsource-bindings.lino%27%3B%0A%20const%20receiptFile%3D%27parity%2Fnaming%2Fmodule-scope-%27%2Bsection%2B%27-registration.lino%27%3B%0A%20let%20original%3B%0A%20if%28section%3D%3D%3D%27bindings%27%29%7B%0A%20%20%2F%2F%20Reuse%20the%20small%2C%20independently%20certified%20source%20profile%20rather%20than%20copying%0A%20%20%2F%2F%20this%2077%20MB%20data%20document%20through%20Git%27s%20generic%2064%20MB%20blob%20transport.%0A%20%20const%20path%3DNAMING_SOURCE_BINDING_CODEC_POLICY.profile%2Ccaptured%3DcaptureGitArtifactCertificate%28revision%2Cpath%29%3B%0A%20%20const%20profile%3DreadBootstrapStructuredDataLino%28captured.blob.toString%28%27utf8%27%29%29%3B%0A%20%20const%20epoch%3Dprofile.profiles.at%28-1%29%3Bassert.equal%28epoch.source.path%2Cfile%29%3B%0A%20%20original%3D%7Bexpected%3A%7Bbytes%3Aepoch.source.bytes%2Csha256%3Aepoch.source.sha256%7D%2C%0A%20%20%20authority%3A%7Bpath%2Csource%3Acaptured.blob.toString%28%27utf8%27%29%2Ccertificate%3Acaptured.certificate%7D%7D%3B%0A%20%7Delse%7B%0A%20%20const%20captured%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%3B%0A%20%20verifyGitArtifactCertificate%28captured.certificate%2Ccaptured.blob%2C%7Brevision%2Cpath%3Afile%7D%29%3B%0A%20%20original%3D%7Bexpected%3Apin%28captured.blob%29%2Ccertificate%3Acaptured.certificate%7D%3B%0A%20%7D%0A%20const%20text%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3B%0A%20let%20document%3B%0A%20if%28section%3D%3D%3D%27bindings%27%29%7B%0A%