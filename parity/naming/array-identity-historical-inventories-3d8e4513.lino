%3DrestoreRawPlanningWorkflowHistory%28source%2Cpath%29%3B%0A%20%20source%3DrestoreGrammarContextMetadataHistory%28source%2Cpath%29%3B%0A%20%20if%28%21history%29%7Bconst%20bytes%3DreadFileSync%28new%20URL%28file%2Croot%29%29%3Bassert.equal%28pin%28bytes%29.sha256%2CarchiveSha256%29%3Bhistory%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3Bassert.equal%28history.revision%2Crevision%29%3B%7D%0A%20%20const%20row%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3Dpath%29%3Bif%28%21row%29return%20source%3B%0A%20%20const%20actual%3Dpin%28source%29%3B%0A%20%20if%28actual.sha256%21%3D%3Drow.current.sha256%29return%20source%3B%0A%20%20assert.deepEqual%28actual%2Crow.current%29%3B%0A%20%20const%20bytes%3DBuffer.from%28source%29%2Cedit%3Drow.edit%3B%0A%20%20assert.equal%28edit.offsetUnit%2C%27UTF-8%20bytes%27%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%26%26Number.isSafeInteger%28edit.end%29%26%26edit.start%3E%3D0%26%26edit.end%3E%3Dedit.start%26%26edit.end%3C%3Dbytes.length%29%3B%0A%20%20assert.equal%28bytes.subarray%28edit.start%2Cedit.end%29.toString%28%27utf8%27%29%2Cedit.inserted%29%3B%0A%20%20const%20original%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20assert.deepEqual%28pin%28original%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3Bassert.equal%28original.toString%28%27utf8%27%29%2Crow.sourceText%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2Coriginal%2C%7Brevision%2Cpath%7D%29%3B%0A%20%20return%20row.sourceText%3B%0A%7D%0A%0Aimport%20%7BrestoreGrammarContextMetadataHistory%7D%20from%20%27.%2Fgrammar-context-metadata-history.mjs%27%3B%0Aimport%20%7BrestoreRawPlanningWorkflowHistory%7D%20from%20%27.%2Fraw-planning-workflow-history.mjs%27%3B%0Aimport%20%7BrestoreBooleanValueGuardHistory%7D%20from%20%27.%2Fboolean-value-source-history.mjs%27%3B%0A) (lang: meta-language%20structured%20data)))
