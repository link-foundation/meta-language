8%29%3B%0A%20%20const%20views%3DauthorOnly%3Fawait%20new%20Promise%28%28resolve%2Creject%29%3D%3E%7B%0A%20%20%20%20let%20result%2Cfailure%2Cmessages%3D0%3B%0A%20%20%20%20const%20worker%3Dnew%20Worker%28new%20URL%28%27.%2Fderive-own-codebase-historical-naming-views.mjs%27%2Cimport.meta.url%29%2C%7B%0A%20%20%20%20%20%20workerData%3Asources.map%28%28%7Bfile%2Ccurrent%2Cpredecessor%7D%29%3D%3E%28%7Bfile%2Ccurrent%2Cpredecessor%3A%7Brevision%3Apredecessor.revision%2Csource%3Apredecessor.source%7D%7D%29%29%2C%0A%20%20%20%20%20%20execArgv%3A%5B%5D%2CresourceLimits%3A%7BmaxOldGenerationSizeMb%3A352%2CmaxYoungGenerationSizeMb%3A1%7D%2C%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20worker.on%28%27message%27%2Cvalue%3D%3E%7Bmessages%2B%2B%3Bresult%3Dvalue%3B%7D%29%3B%0A%20%20%20%20worker.on%28%27error%27%2Cerror%3D%3E%7Bfailure%3Derror%3B%7D%29%3B%0A%20%20%20%20%2F%2F%20Wait%20for%20heap%20release%20before%20retaining%20the%20complete%20serialization%20graph.%0A%20%20%20%20worker.on%28%27exit%27%2Ccode%3D%3E%7B%0A%20%20%20%20%20%20if%28failure%29return%20reject%28failure%29%3B%0A%20%20%20%20%20%20if%28code%21%3D%3D0%7C%7Cmessages%21%3D%3D1%7C%7C%21Array.isArray%28result%29%29return%20reject%28new%20Error%28%27complete%20naming%20inventory%20worker%20failed%27%29%29%3B%0A%20%20%20%20%20%20resolve%28result%29%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%7D%29%3AderiveOwnCodebaseHistoricalNamingViews%28sources%2C%28await%20import%28%27.%2Fissue-195-naming.mjs%27%29%29.NAME_INVENTORIES%29%3B%0A%20%20globalThis.gc%3F.%28%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3A1%2Cmodel%3A%27array%20identity%20historical%20naming%20inventories%201%27%2Crevision%2Csources%2Cviews%2C%0A%20%20%20%20boundary%3A%27Each%20supplemental%20name%20is%20derived%20by%20its%20unchanged%20scoped%20inventory%20from%20a%20complete%20independently%20Git-certified%20original%20module.%20Every%20actual%20current%20source%20name%20is%20still%20extracted%20first.%20Historical%20definitions%20retain%20their%20original%20concept%20identities%3B%20a%20changed%20current%20body%20gains%20no%20equivalence%20proof%20from%20this%20source%20view.%20Whole%20current%20source%20hashes%20bind%20selection%20and%20unknown%20source%20bytes%20refuse.%20These%20source%20certificates%20do%20not%20establish%20runtime%20execution%20or%20requirement%20completion.%27%7D%3B%0A%20%20console.error%28%27Derived%20%27%2Bviews.length%2B%27%20historical%20naming%20views.%27%29%3B%0A%20%20if%28check%29%7Bassert.deepEqual%28history%2Cstored%29%3BcheckProjectData%28new%20URL%28file%2Croot%29%2Chistory%29%3B%7D%0A%20%20else%7BwriteProjectData%28new%20URL%28file%2Croot%29%2Chistory%29%3BglobalThis.gc%3F.%28%29%3Bif%28%21authorOnly%29assert.deepEqual%28readOwnCodebaseHistoricalNamingPolicy%28%29.additionalSourceViews%2Chistory%29%3B%7D%0A%20%20return%20history%3B%0A%7D%0A%0A%2F%2F%20The%20normal%20CLI%20keeps%20the%20full%20author%2Freader%20comparison%20while%20separating%0A%2F%2F%20their%20large%20graphs%20into%20fresh%20serial%20processes.%20No%20assertion%20is%20optional%20in%0A%2F%2F%20the%20normal%20command%3B%20the%20internal%20author%20emits%20only%20an%20invocation%20receipt.%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%2Cfile%3Dnew%20URL%28%27..%2F..%2Fparity%2Fnaming%2Farray-identity-historical-inventories.lino%27%2Cimport.meta.url%29%3B%0A%20%20if%28args.length%3D%3D%3D1%26%26args%5B0%5D%3D%3D%3D%27--author-additional-inventories%27%29%7B%0A%20%20%20%20const%20history%3Dawait%20generateAdditionalOwnCodebaseHistoricalNamingSources%28%7BauthorOnly%3Atrue%7D%29%3B%0A%20%20%20%20process.stdout.write%28serializeProjectData%28%7Bsource%3Apin%28readFileSync%28file%29%29%2CcertifiedSources%3Ahistory.sources.length%2CscopedViews%3Ahistory.views.length%2ChistoricalNames%3Ahistory.views.reduce%28%28total%2Crow%29%3D%3Etotal%2Brow.names.length%2C0%29%7D%2C%27receipt.lino%27%29%29%3B%0A%20%20%7Delse%20if%28args.length%3D%3D%3D3%26%26args%5B0%5