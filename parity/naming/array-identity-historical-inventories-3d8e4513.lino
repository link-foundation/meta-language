ArtifactCertificate%28revision%2Cpath%29%2Csource%3Dcaptured.blob.toString%28%27utf8%27%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28Buffer.from%28source%29%2Ccaptured.blob%29%3Bassert.equal%28readFileSync%28new%20URL%28path%2Croot%29%2C%27utf8%27%29%2Csource%29%3B%0A%20%20%20%20%20%20const%20old%3DcaptureGitArtifactCertificate%28predecessor%2Cpath%29%2Cprior%3Dold.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28prior%29%2Cold.blob%29%3B%0A%20%20%20%20%20%20let%20start%3D0%3Bwhile%28start%3Cprior.length%26%26start%3Csource.length%26%26prior%5Bstart%5D%3D%3D%3Dsource%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20%20%20let%20suffix%3D0%3Bwhile%28suffix%3Cprior.length-start%26%26suffix%3Csource.length-start%26%26prior.at%28-1-suffix%29%3D%3D%3Dsource.at%28-1-suffix%29%29suffix%2B%2B%3B%0A%20%20%20%20%20%20const%20edit%3D%7Bstart%2Cremoved%3Aprior.slice%28start%2Cprior.length-suffix%29%2Cinserted%3Asource.slice%28start%2Csource.length-suffix%29%7D%3B%0A%20%20%20%20%20%20return%7Bpath%2Csource%2C...toolingFrozenSourcePin%28source%29%2Ccertificate%3Acaptured.certificate%2C%0A%20%20%20%20%20%20%20%20previous%3A%7Brevision%3Apredecessor%2Csource%3Aprior%2C...toolingFrozenSourcePin%28prior%29%2Ccertificate%3Aold.certificate%7D%2Cedit%7D%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27certified%20tooling%20host%20successors%201%27%2Crevision%2C%0A%20%20%20%20%20%20sources%2C%0A%20%20%20%20%20%20boundary%3A%27Complete%20current%20workflow%20and%20scheduling%20tests%20and%20the%20crate%20manifest%20are%20independently%20certified%20at%20their%20actual%20commit.%20Finite%20inverses%20retain%20every%20certified%20prior%20source%20byte%3B%20original%20historical%20guards%20keep%20their%20exact%20scope%20while%20current%20tests%20verify%20checkout%20provenance%2C%20measured%20complete-workload%20ownership%20and%20the%20included%20identifier%20policy.%20No%20arbitrary%20successor%2C%20changed%20assertion%2C%20execution%20observation%20or%20weaker%20gate%20is%20authorized.%27%7D%3B%0A%20%20%20%20verifyToolingFrozenSourceHistory%28packet%2C%7BhostSuccessors%3Atrue%7D%29%3B%0A%20%20%20%20const%20target%3Dnew%20URL%28%27parity%2Fself-translation%2Ftooling-frozen-host-successors.lino%27%2Croot%29%3B%0A%20%20%20%20if%28check%29checkProjectData%28target%2Cpacket%29%3Belse%20writeProjectData%28target%2Cpacket%29%3B%0A%20%20%20%20return%20packet%3B%0A%20%20%7D%0A%20%20const%20captured%3DcaptureGitArtifactCertificate%28TOOLING_FROZEN_SOURCE_REVISION%2CCURRENT_CONVERSATION_SOURCE.path%29%3B%0A%20%20const%20source%3Dcaptured.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28source%29%2Ccaptured.blob%29%3B%0A%20%20assert.equal%28readFileSync%28new%20URL%28CURRENT_CONVERSATION_SOURCE.path%2Croot%29%2C%27utf8%27%29%2Csource%29%3B%0A%20%20const%20previous%3DreadCriticalDeliveryFrozenSource%28%29.source%3B%0A%20%20const%20hosts%3DTOOLING_FROZEN_HOSTS.map%28specification%3D%3E%7B%0A%20%20%20%20const%20original%3DcaptureGitArtifactCertificate%28TOOLING_FROZEN_SOURCE_REVISION%2Cspecification.path%29%3B%0A%20%20%20%20const%20source%3Doriginal.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28source%29%2Coriginal.blob%29%3B%0A%20%20%20%20const%20replay%3DreplayToolingFrozenHostChanges%28source%2Cspecification.changes%29%3B%0A%20%20%20%20return%7Bpath%3Aspecification.path%2Csource%2C...toolingFrozenSourcePin%28source%29%2Ccertificate%3Aoriginal.certificate%2C%0A%20%20%20%20%20%20current%3AtoolingFrozenSourcePin%28replay.source%29%2Cedits%3Areplay.edits%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27composed%20CI%20tooling%20historical%20scope%201%27%2Crevision%3ATOOLING_FROZEN_SOURCE_REVISION%2C%0A%20%20%20%20coordinateUnit%3A%27UTF-16%20code%20units%27%2CcriticalHistory%3ACRITICAL_DELIVERY_SOURCE_HISTORY%2C%0A%20%20%20%20conversation%3A%7Bpath%3ACURRENT_CONVERSATION_SOURCE.path%2Csource%2C...toolingFrozenSourcePin%28source%29%2Ccertificate%3Acaptured.certificate%2C%0A%20%20%20%20%20%20previous%3A%7Bsource%3Aprevious%2C...toolingFrozenSourcePin%28previous%29%7D%2Cappend%3AreadCriticalDeliveryAppend%28previous%2Csource%29%7D%2Chosts%2C%0A%20%20%20%20boundary%3A%27Existing%20certified%20test-registration%20history%20supplies%20the%20exact%20historical%20classifier%3B%20every%20actual%20current%20discovered%20file%20and%20registered%20addition%20is%20checked%20independently.%20One%20complete%20certified%20conversation%20successor%20adds%20obligations%20only%20at%20the%20old%20list%20closing%20delimiter%3B%20historical%20byte%20assertions%20retain%20their%20exact%20source%20view%20while%20the%20actual%20current%20manifest%20and%20every%20old%2Fnew%20row%20remain%20gated.%20Complete%20host%20source%20inverses%20retain%20every%20original%20input%20and%20assertion.%20This%20proves%20source%2Fscope%20conservation%2C%20not%20implementation%20completion%2C%20behavioral%20success%20or%20native%20execution.%27%7D%3B%0A%20%20const%20outputs%3DverifyToolingFrozenSourceHistory%28packet%29%3B%0A%20%20for%28const%20row%20of%20outputs%29%7B%0A%20%20%20%20const%20actual%3DreadFileSync%28new%20URL%28row.path%2Croot%29%2C%27utf8%27%29%3B%0A%20%20%20%20if%28check%29assert.equal%28restoreToolingFrozenHostSource%28actual%2Crow.path%29%2Crow.previous%29%3Belse%20assert.ok%28actual%3D%3D%3Drow.previous%7C%7Cactual%3D%3D%3Drow.current%2C%27unknown%20complete%20host%20source%20is%20never%20replaced%27%29%3B%0A%20%20%7D%0A%20%20if%28check%29checkProjectData%28new%20URL%28output%2Croot%29%2Cpacket%29%3Belse%20writeProjectData%28new%20URL%28output%2Croot%29%2Cpacket%29%3B%0A%20%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Ccurrent%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2Fconst%20policySha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%3B%0A%20%20assert.equal%28current.split%28pattern%29.length%2C2%29%3B%0A%20%20const%20expected%3Dcurrent.replace%28pattern%2C%22const%20policySha256%3D%27%22%2BtoolingFrozenSourcePin%28readFileSync%28new%20URL%28output%2Croot%29%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28current%2Cexpected%29%3Belse%20writeFileSync%28helperPath%2Cexpected%29%3B%0A%20%20if%28apply%29for%28const%20row%20of%20outputs%29writeFileSync%28new%20URL%28row.path%2Croot%29%2Crow.current%29%3B%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.equal%28new%20Set%28args%29.size%2Cargs.length%29%3Bassert.ok%28args.every%28value%3D%3E%5B%27--check%27%2C%27--apply%27%2C%27--host-successors%27%5D.includes%28value%29%29%29%3B%0A%20%20const%20packet%3DgenerateToolingFrozenSourceHistory%28%7Bcheck%3Aargs.includes%28%27--check%27%29%2Capply%3Aargs.includes%28%27--apply%27%29%2ChostSuccessors%3Aargs.includes%28%27--host-successors%27%29%7D%29%3B%0A%20%20console.log%28JSON.stringify%28%7BsourceHosts%3A%28packet.hosts%3F%3Fpacket.sources%29.map%28row%3D%3Erow.path%29%2CappendedRequirementIds%3Apacket.conversation%3F.append.ids%3F%3F%5B%5D%2CnativeExecution%3Afalse%7D%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
