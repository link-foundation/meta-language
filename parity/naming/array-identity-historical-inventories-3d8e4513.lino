acket.edge.changes.length%2C10%29%3Bassert.equal%28packet.edge.sources.length%2C3%29%3B%0A%20%20const%20actual%3DreadProjectData%28new%20URL%28policy.artifactFile%2Croot%29%29%2Cregister%3DreadProjectData%28new%20URL%28policy.registerFile%2Croot%29%29%3B%0A%20%20const%20snapshot%3DserializeProjectData%28actual%2Cpolicy.artifactFile%29%2Crestored%3DrestoreCurrentOwnCodebaseRawEdge%28actual%2C%27raw%20consuming%27%2Cregister%29%3B%0A%20%20assert.equal%28serializeProjectData%28restored.artifact%2Cpolicy.artifactFile%29%2Cpacket.artifact.sourceText%29%3B%0A%20%20assert.equal%28serializeProjectData%28restored.register%2Cpolicy.registerFile%29%2Cpacket.register.sourceText%29%3B%0A%20%20assert.equal%28serializeProjectData%28actual%2Cpolicy.artifactFile%29%2Csnapshot%2C%27the%20caller%20graph%20is%20not%20changed%27%29%3B%0A%20%20assert.equal%28actual.definitionCount%2C106%29%3Bassert.equal%28actual.owners.length%2C106%29%3B%0A%20%20for%28const%20field%20of%20%5B%27completeRust%27%2C%27owners%27%2C%27declarationNames%27%2C%27totals%27%2C%27assumptions%27%2C%27encodings%27%2C%27mappings%27%2C%27preludeHashes%27%2C%27replays%27%2C%27archive%27%5D%29assert.deepEqual%28actual%5Bfield%5D%2Crestored.artifact%5Bfield%5D%2Cfield%29%3B%0A%20%20const%20proof%3Dactual.predecessor.proof.producerApplicability%2ColdProof%3Drestored.artifact.predecessor.proof.producerApplicability%3B%0A%20%20assert.equal%28proof.sources.find%28row%3D%3Erow.file%3D%3D%3Dpolicy.sourcePaths%5B1%5D%29%3D%3D%3Dproof.sourceHistory.current%2Cpacket.inferenceDescriptorAlias%29%3B%0A%20%20assert.equal%28oldProof.sources.find%28row%3D%3Erow.file%3D%3D%3Dpolicy.sourcePaths%5B1%5D%29%3D%3D%3DoldProof.sourceHistory.current%2Cpacket.inferenceDescriptorAlias%29%3B%0A%20%20assert.deepEqual%28proof.sourceHistory.current%2Cactual.decisionSources%5B2%5D%29%3B%0A%20%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%3Bassert.equal%28source%2Crow.current.sourceText%29%3Bassert.deepEqual%28pin%28source%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%20%20%20assert.equal%28restoreCurrentOwnCodebaseRawSource%28source%2Crow.file%29%2Crow.sourceText%29%3B%0A%20%20%7D%0A%20%20for%28const%20row%20of%20packet.adapters%29assert.equal%28deriveCurrentOwnCodebaseRawDescriptorSource%28row%29%2CreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20for%28const%20row%20of%5Bpacket.artifact%2Cpacket.register%2Cpacket.loan%5D%29assert.equal%28restoreCurrentOwnCodebaseRawText%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.file%29%2Crow.sourceText%29%3B%0A%20%20const%20loan%3DreadProjectData%28new%20URL%28policy.loanFile%2Croot%29%29%3Bassert.deepEqual%28%7Bbytes%3Aloan.predecessor.bytes%2Csha256%3Aloan.predecessor.sha256%7D%2Cpacket.edge.current%29%3B%0A%20%20assert.doesNotThrow%28%28%29%3D%3ErestoreCompleteDeclarationReceipt%28actual%2C%27raw%20consuming%27%2C%7Bregister%7D%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20old%20own-codebase%20packet%20keeps%20its%20identity%20and%20its%20author%20cannot%20overwrite%20a%20current%20successor%27%2C%28%29%3D%3E%7B%0A%20%20const%20policy%3DreadCurrentOwnCodebaseRawDescriptorPolicy%28%29%2Cold%3DreadOwnCodebaseRawDescriptorPacket%28%29%2Ccurrent%3DreadCurrentOwnCodebaseRawDescriptorPacket%28%29%3B%0A%20%20assert.equal%28old.revision%2C%2752132727d7ce158762a4499b7032a42a9f16f3c3%27%29%3Bassert.equal%28old.sourceOwner.current.bytes%2C133770%29%3B%0A%20%20assert.equal%28current.sources%5B0%5D.bytes%2C133770%29%3Bassert.deepEqual%28pin%28current.sources%5B0%5D.sourceText%29%2Cold.sourceOwner.current%29%3B%0A%20%20assert.equal%28restoreCurrentOwnCodebaseRawSource%28readFileSync%28new%20URL%28policy.sourcePaths%5B0%5D%2Croot%29%2C%27utf8%27%29%2Cpolicy.sourcePaths%5B0%5D%29%2C%0A%20%20%20%20current.sources%5B0%5D.sourceText%29%3B%0A%20%20const%20files%3D%5Bpolicy.artifactFile%2Cpolicy.registerFile%2Cpolicy.loanFile%2C%27parity%2Fself-translation%2Fown-codebase-raw-source-descriptors.lino%27%5D%3B%0A%20%20const%20before%3Dfiles.map%28file%3D%3EreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EgenerateOwnCodebaseRawSourceDescriptors%28%29%2C%2Funknown%20complete%20source%20or%20artifact%20changes%20refuse%2Fu%29%3B%0A%20%20for%28const%5Bindex%2Cfile%5Dof%20files.entries%28%29%29assert.equal%28readFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%2Cbefore%5Bindex%5D%29%3B%0A%7D%29%3B%0A%0Atest%28%27unknown%20complete%20sources%20aliases%20registers%20and%20semantic%20payloads%20cannot%20acquire%20predecessor%20authority%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DreadCurrentOwnCodebaseRawDescriptorPacket%28%29%2Cpolicy%3DreadCurrentOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20const%20artifact%3DreadProjectData%28new%20URL%28policy.artifactFile%2Croot%29%29%2Cregister%3DreadProjectData%28new%20URL%28policy.registerFile%2Croot%29%29%3B%0A%20%20for%28const%20mutate%20of%20%5Bvalue%3D%3E%7Bvalue.extra%3Dtrue%3B%7D%2Cvalue%3D%3E%7Bvalue%5Bpolicy.property%5D%5B0%5D.changes.reverse%28%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue%5Bpolicy.property%5D%5B0%5D.current.sha256%3D%270%27.repeat%2864%29%3B%7D%2Cvalue%3D%3E%7Bvalue.ownCodebaseRawSourceDescriptorSuccessors.reverse%28%29%3Bvalue.ownCodebaseRawSourceDescriptorSuccessors.push%28%7B%7D%29%3B%7D%5D%29%7B%0A%20%20%20%20const%20changed%3DstructuredClone%28register%29%3Bmutate%28changed%29%3Bassert.throws%28%28%29%3D%3ErestoreCurrentOwnCodebaseRawEdge%28artifact%2C%27raw%20consuming%27%2Cchanged%29%29%3B%0A%20%20%7D%0A%20%20for%28const%20mutate%20of%20%5Bvalue%3D%3E%7Bvalue.sources%5B0%5D.current.sourceText%2B%3D%27%20%27%3B%7D%2Cvalue%3D%3E%7Bvalue.sources%5B1%5D.artifactPrevious.bytes%2B%3D1%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B0%5D.sourceText%2B%3D%27%20%27%3B%7D%2Cvalue%3D%3E%7Bvalue.adapters%5B1%5D.edits%5B0%5D.previousText%2B%3D%27%20%27%3B%7D%2C%0A%