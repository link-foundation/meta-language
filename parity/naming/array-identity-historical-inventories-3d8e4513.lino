B%0A%0Atest%28%27owned%20history%20migrates%20legacy%20records%20once%20and%20keeps%20exactly%20the%20latest%20200%27%2C%20t%20%3D%3E%20%7B%0A%20%20const%20fixture%20%3D%20makeRepository%28makeBase%28t%29%29%3B%0A%20%20const%20state%20%3D%20path.join%28fixture.root%2C%20%27.git%2Fmeta-language-cache%27%29%3B%0A%20%20mkdirSync%28state%2C%20%7B%20recursive%3A%20true%20%7D%29%3B%0A%20%20writeFileSync%28path.join%28state%2C%20%27history.jsonl%27%29%2C%20Array.from%28%7B%20length%3A%20205%20%7D%2C%20%28_%2C%20sequence%29%20%3D%3E%20JSON.stringify%28%7B%20sequence%20%7D%29%29.join%28%27%5Cn%27%29%20%2B%20%27%5Cn%27%29%3B%0A%20%20writeFileSync%28path.join%28state%2C%20%27last-run.json%27%29%2C%20%27%7B%7D%5Cn%27%29%3B%0A%20%20const%20report%20%3D%20runCleanup%28%7B%20cwd%3A%20fixture.root%2C%20tmpRoot%3A%20fixture.tmpRoot%2C%20classes%3A%20%5B%27javascript%27%5D%2C%20docker%3A%20false%2C%20preflight%3A%20false%20%7D%29%3B%0A%20%20const%20history%20%3D%20readBootstrapStructuredDataRecords%28readFileSync%28path.join%28state%2C%20%27history.lino%27%29%2C%20%27utf8%27%29%29%3B%0A%20%20assert.equal%28history.length%2C%20200%29%3B%0A%20%20assert.deepEqual%28history%5B0%5D%2C%20%7B%20sequence%3A%206%20%7D%29%3B%0A%20%20assert.equal%28history.at%28-1%29.reclaimedBytes%2C%20report.reclaimedBytes%29%3B%0A%20%20assert.equal%28existsSync%28path.join%28state%2C%20%27history.jsonl%27%29%29%2C%20false%29%3B%0A%20%20assert.equal%28existsSync%28path.join%28state%2C%20%27last-run.json%27%29%29%2C%20false%29%3B%0A%20%20runCleanup%28%7B%20cwd%3A%20fixture.root%2C%20tmpRoot%3A%20fixture.tmpRoot%2C%20classes%3A%20%5B%27javascript%27%5D%2C%20docker%3A%20false%2C%20preflight%3A%20false%20%7D%29%3B%0A%20%20const%20next%20%3D%20readBootstrapStructuredDataRecords%28readFileSync%28path.join%28state%2C%20%27history.lino%27%29%2C%20%27utf8%27%29%29%3B%0A%20%20assert.equal%28next.length%2C%20200%29%3B%0A%20%20assert.deepEqual%28next%5B0%5D%2C%20%7B%20sequence%3A%207%20%7D%29%3B%0A%7D%29%3B%0A%0Atest%28%27older%20active%20owners%20can%20still%20read%20the%20three%20coordination%20protocols%20as%20JSON%27%2C%20t%20%3D%3E%20%7B%0A%20%20const%20fixture%20%3D%20makeRepository%28makeBase%28t%29%29%3B%0A%20%20const%20lease%20%3D%20acquireLease%28%7B%20cwd%3A%20fixture.root%2C%20label%3A%20%27legacy%20reader%27%20%7D%29%3B%0A%20%20t.after%28%28%29%20%3D%3E%20lease.release%28%29%29%3B%0A%20%20assert.equal%28JSON.parse%28readFileSync%28lease.file%2C%20%27utf8%27%29%29.pid%2C%20process.pid%29%3B%0A%20%20const%20directory%20%3D%20makeScratchDirectory%28%27meta-language-bootstrap-%27%2C%20%27legacy%20scratch%20reader%27%29%3B%0A%20%20t.after%28%28%29%20%3D%3E%20rmSync%28directory%2C%20%7B%20recursive%3A%20true%2C%20force%3A%20true%20%7D%29%29%3B%0A%20%20const%20marker%20%3D%20JSON.parse%28readFileSync%28path.join%28directory%2C%20SCRATCH_MARKER%29%2C%20%27utf8%27%29%29%3B%0A%20%20assert.equal%28marker.pid%2C%20process.pid%29%3B%0A%20%20const%20state%20%3D%20path.join%28fixture.root%2C%20%27.git%2Fmeta-language-cache%27%29%3B%0A%20%20const%20lock%20%3D%20path.join%28state%2C%20%27cleanup.lock%27%29%3B%0A%20%20writeFileSync%28lock%2C%20JSON.stringify%28%7B%20pid%3A%20process.ppid%20%7D%29%29%3B%0A%20%20const%20report%20%3D%20runCleanup%28%7B%20cwd%3A%20fixture.root%2C%20docker%3A%20false%2C%20preflight%3A%20false%20%7D%29%3B%0A%20%20assert.equal%28report.status%2C%20%27busy%27%29%3B%0A%20%20assert.equal%28JSON.parse%28readFileSync%28lock%2C%20%27utf8%27%29%29.pid%2C%20process.ppid%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20POSIX%20process%20probe%20resolves%20an%20executable%20invoked%20through%20a%20path%20with%20spaces%27%2C%20%7B%20skip%3A%20process.platform%20%3D%3D%3D%20%27win32%27%20%7D%2C%20async%20t%20%3D%3E%20%7B%0A%20%20const%20directory%20%3D%20makeBase%28t%29%3B%0A%20%20const%20binary%20%3D%20path.join%28directory%2C%20%27node%20with%20spaces%27%29%3B%0A%20%20symlinkSync%28process.execPath%2C%20binary%29%3B%0A%20%20const%20running%20%3D%20spawn%28binary%2C%20%5B%27-e%27%2C%20%27process.stdout.write%28%22ready%5C%5Cn%22%29%3B%20setInterval%28%28%29%20%3D%3E%20%7B%7D%2C%201000%29%3B%27%5D%2C%20%7B%20stdio%3A%20%5B%27ignore%27%2C%20%27pipe%27%2C%20%27pipe%27%5D%20%7D%29%3B%0A%20%20const%20exited%20%3D%20new%20Promise%28resolve%20%3D%3E%20running.once%28%27exit%27%2C%20resolve%29%29%3B%0A%20%20t.after%28async%20%28%29%20%3D%3E%20%7B%20running.kill%28%27SIGKILL%27%29%3B%20await%20exited%3B%20%7D%29%3B%0A%20%20await%20new%20Promise%28%28resolve%2C%20reject%29%20%3D%3E%20%7B%20running.stdout.once%28%27data%27%2C%20resolve%29%3B%20running.once%28%27error%27%2C%20reject%29%3B%20%7D%29%3B%0A%20%20const%20actual%20%3D%20runningProcesses%28%29.processes.find%28entry%20%3D%3E%20entry.pid%20%3D%3D%3D%20running.pid%29%3B%0A%20%20assert.ok%28actual%2C%20%27the%20ready%20fixture%20process%20is%20listed%27%29%3B%0A%20%20assert.equal%28actual.executable%2C%20realpathSync%28process.execPath%29%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
