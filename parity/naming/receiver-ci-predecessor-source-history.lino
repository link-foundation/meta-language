qual%28step.split%28%22matrix.group%20%3D%3D%20%27source-model-raw%27%22%29.length%2C2%29%3B%0A%20%20%20%20expected%3Dexpected.slice%280%2Cstart%29%2Bstep.replace%28%22matrix.group%20%3D%3D%20%27source-model-raw%27%22%2C%22matrix.group%20%3D%3D%20%27source-model-raw-generation%27%22%29%2Bexpected.slice%28end%29%3B%0A%20%20%7D%0A%20%20const%20actual%3DreadFileSync%28new%20URL%28file%2Croot%29%29%3Bassert.equal%28actual.toString%28%29%2Cexpected%29%3B%0A%20%20let%20start%3D0%2Cend%3Dactual.length%2ColdEnd%3Doriginal.blob.length%3B%0A%20%20while%28start%3Cend%26%26start%3ColdEnd%26%26actual%5Bstart%5D%3D%3D%3Doriginal.blob%5Bstart%5D%29start%2B%2B%3B%0A%20%20while%28start%3E0%26%26%28actual%5Bstart%5D%26192%29%3D%3D%3D128%29start--%3B%0A%20%20while%28end%3Estart%26%26oldEnd%3Estart%26%26actual%5Bend-1%5D%3D%3D%3Doriginal.blob%5BoldEnd-1%5D%29%7Bend--%3BoldEnd--%3B%7D%0A%20%20while%28end%3Cactual.length%26%26%28%28actual%5Bend%5D%26192%29%3D%3D%3D128%7C%7C%28original.blob%5BoldEnd%5D%26192%29%3D%3D%3D128%29%29%7Bend%2B%2B%3BoldEnd%2B%2B%3B%7D%0A%20%20const%20value%3D%7BschemaVersion%3A1%2Crevision%2Cfile%2Csource%2Ccertificate%3Aoriginal.certificate%2C%0A%20%20%20%20current%3A%7Bbytes%3Aactual.length%2Csha256%3AcreateHash%28%27sha256%27%29.update%28actual%29.digest%28%27hex%27%29%7D%2C%0A%20%20%20%20edit%3A%7BoffsetUnit%3A%27UTF-8%20bytes%27%2Cstart%2Cend%2Cremoved%3Aoriginal.blob.subarray%28start%2ColdEnd%29.toString%28%29%2Cinserted%3Aactual.subarray%28start%2Cend%29.toString%28%29%7D%2C%0A%20%20%20%20boundary%3A%27One%20required%20generation%2Fprojection%20cell%20and%20two%20scheduling%20predicates%20are%20the%20only%20changes.%20Every%20command%2C%20source%2C%20assertion%2C%20test%20gate%20and%20ten-minute%20deadline%20remains%20exact.%20The%20complete%20original%20workflow%20and%20immediate%20byte%20inverse%20are%20authenticated%20independently%3B%20this%20receipt%20proves%20neither%20new%20timing%20nor%20native%20execution.%27%7D%3B%0A%20%20const%20output%3Dnew%20URL%28%27parity%2Fself-translation%2Fraw-planning-workflow-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28output%2Cvalue%29%3Belse%20writeProjectData%28output%2Cvalue%29%3B%0A%20%20const%20helper%3Dnew%20URL%28%27js%2Fscripts%2Fraw-planning-workflow-history.mjs%27%2Croot%29%2Ctext%3DreadFileSync%28helper%2C%27utf8%27%29%3B%0A%20%20const%20updated%3Dtext.replace%28%2Fconst%20archiveHash%3D%27%28%3F%3APENDING%7C%5B0-9a-f%5D%7B64%7D%29%27%3B%2Fu%2C%0A%20%20%20%20%22const%20archiveHash%3D%27%22%2BcreateHash%28%27sha256%27%29.update%28readFileSync%28output%29%29.digest%28%27hex%27%29%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28text%2Cupdated%29%3Belse%20writeFileSync%28helper%2Cupdated%29%3B%0A%20%20return%20value%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateRawPlanningWorkflowHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
