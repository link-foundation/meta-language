(8298: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Only%20a%20complete%20reviewed%20current%20workflow%20acquires%20its%20immediate%20predecessor.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aconst%20archive%3Dnew%20URL%28%27..%2F..%2Fparity%2Fself-translation%2Fraw-planning-workflow-history.lino%27%2Cimport.meta.url%29%3B%0Aconst%20archiveHash%3D%2723e42299350a76de06cd2c986c8739c63f1213835c9f5cae59d11ed9bb950e46%27%3B%0Alet%20history%3B%0A%0A%2F%2A%2A%20Preserve%20unknown%20changes%20for%20the%20original%20guard%3B%20authenticate%20only%20exact%20bytes.%20%2A%2F%0Aexport%20function%20restoreRawPlanningWorkflowHistory%28source%2Cfile%29%20%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3B%0A%20%20%2F%2F%20Legacy%20guards%20identify%20one%20of%20these%20workflows%20by%20its%20complete%20digest.%0A%20%20%2F%2F%20The%20certificate%20below%20always%20authenticates%20the%20actual%20JavaScript%20owner.%0A%20%20if%28%21%5B%27.github%2Fworkflows%2Fjs.yml%27%2C%27.github%2Fworkflows%2Fci.yml%27%2C%27.github%2Fworkflows%2Frust.yml%27%5D.includes%28file%29%29return%20source%3B%0A%20%20if%28%21history%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28archive%29%3Bassert.equal%28createHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%2CarchiveHash%29%3B%0A%20%20%20%20history%3DreadProjectData%28archive%29%3B%0A%20%20%7D%0A%20%20if%28createHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%21%3D%3Dhistory.current.sha256%29return%20source%3B%0A%20%20assert.equal%28Buffer.byteLength%28source%29%2Chistory.current.bytes%29%3B%0A%20%20const%20bytes%3DBuffer.from%28source%29%2Cedit%3Dhistory.edit%3B%0A%20%20assert.equal%28edit.offsetUnit%2C%27UTF-8%20bytes%27%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%26%26Number.isSafeInteger%28edit.end%29%26%26edit.start%3E%3D0%26%26edit.end%3E%3Dedit.start%26%26edit.end%3C%3Dbytes.length%29%3B%0A%20%20assert.equal%28bytes.subarray%28edit.start%2Cedit.end%29.toString%28%29%2Cedit.inserted%29%3B%0A%20%20const%20original%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20assert.equal%28original.toString%28%29%2Chistory.source%29%3B%0A%20%20verifyGitArtifactCertificate%28history.certificate%2Coriginal%2C%7B%0A%20%20%20%20revision%3A%2776e27c44c5854a2cb547aea5cef06ea80adf729c%27%2Cpath%3A%27.github%2Fworkflows%2Fjs.yml%27%7D%29%3B%0A%20%20return%20history.source%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
