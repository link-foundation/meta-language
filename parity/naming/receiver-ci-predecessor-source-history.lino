(10138: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20test%20from%20%27node%3Atest%27%3B%0Aimport%20%7BcaptureGitArtifactCertificate%7D%20from%20%27..%2Fscripts%2Fcapture-git-artifact-certificate.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27..%2Fscripts%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BparseWorkflow%7D%20from%20%27..%2F..%2Fscripts%2Fcheck-cache-policy.mjs%27%3B%0Aimport%20%7BrestoreRawPlanningWorkflowHistory%7D%20from%20%27..%2Fscripts%2Fraw-planning-workflow-history.mjs%27%3B%0A%0Atest%28%27raw%20generation%20and%20complete%20replay%20retain%20every%20prior%20command%20and%20assertion%20in%20distinct%20required%20ten-minute%20jobs%27%2C%28%29%3D%3E%7B%0A%20%20const%20revision%3D%2776e27c44c5854a2cb547aea5cef06ea80adf729c%27%2Cpath%3D%27.github%2Fworkflows%2Fjs.yml%27%3B%0A%20%20const%20original%3DcaptureGitArtifactCertificate%28revision%2Cpath%29%3B%0A%20%20verifyGitArtifactCertificate%28original.certificate%2Coriginal.blob%2C%7Brevision%2Cpath%7D%29%3B%0A%20%20const%20before%3Doriginal.blob.toString%28%27utf8%27%29%2Cactual%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bpath%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20const%20matrix%3D%27%20%20%20%20%20%20%20%20%20%20-%20group%3A%20source-model-raw%5Cn%20%20%20%20%20%20%20%20%20%20%20%20generated_slice%3A%20first%5Cn%27%3B%0A%20%20assert.equal%28before.split%28matrix%29.length%2C2%29%3B%0A%20%20let%20expected%3Dbefore.replace%28matrix%2Cmatrix%2B%27%20%20%20%20%20%20%20%20%20%20-%20group%3A%20source-model-raw-generation%5Cn%20%20%20%20%20%20%20%20%20%20%20%20generated_slice%3A%20first%5Cn%27%29%3B%0A%20%20const%20names%3D%5B%27Check%20complete%20original%20link%20raw%20projection%20native%20generation%27%2C%27Run%20complete%20original%20link%20raw%20projection%20checks%27%5D%3B%0A%20%20for%28const%20name%20of%20names%29%7B%0A%20%20%20%20const%20start%3Dexpected.indexOf%28%27%20%20%20%20%20%20-%20name%3A%20%27%2Bname%2B%27%5Cn%27%29%3Bassert.ok%28start%3E%3D0%29%3B%0A%20%20%20%20const%20end%3Dexpected.indexOf%28%27%5Cn%20%20%20%20%20%20-%20name%3A%27%2Cstart%2B1%29%3Bassert.ok%28end%3Estart%29%3B%0A%20%20%20%20const%20step%3Dexpected.slice%28start%2Cend%29%3Bassert.equal%28step.split%28%22matrix.group%20%3D%3D%20%27source-model-raw%27%22%29.length%2C2%29%3B%0A%20%20%20%20expected%3Dexpected.slice%280%2Cstart%29%2Bstep.replace%28%22matrix.group%20%3D%3D%20%27source-model-raw%27%22%2C%22matrix.group%20%3D%3D%20%27source-model-raw-generation%27%22%29%2Bexpected.slice%28end%29%3B%0A%20%20%7D%0A%20%20assert.equal%28actual%2Cexpected%2C%27only%20one%20required%20matrix%20cell%20and%20two%20complete%20scheduling%20predicates%20change%27%29%3B%0A%20%20const%20old%3DparseWorkflow%28before%29%2Ccurrent%3DparseWorkflow%28actual%29%3B%0A%20%20assert.equal%28old.length%2Ccurrent.length%29%3B%0A%20%20const%20job%3Dcurrent.find%28row%3D%3Erow.id%3D%3D%3D%27package-checks%27%29%2Cprevious%3Dold.find%28row%3D%3Erow.id%3D%3D%3Djob.id%29%3B%0A%20%20assert.match%28job.header%2C%2F%5E%20%20%20%20timeout-minutes%3A%2010%24%2Fmu%29%3B%0A%20%20assert.match%28job.header%2C%2F%5E%20%20%20%20%20%20fail-fast%3A%20false%24%2Fmu%29%3B%0A%20%20assert.equal%28job.steps.length%2Cprevious.steps.length%29%3B%0A%20%20assert.deepEqual%28job.steps.map%28row%3D%3Erow.name%29%2Cprevious.steps.map%28row%3D%3Erow.name%29%29%3B%0A%20%20const%20retained%3Djob.steps.find%28row%3D%3Erow.name%3D%3D%3D%27Run%20complete%20original%20link%20raw%20native%20oracle%20contracts%27%29%3B%0A%20%20assert.equal%28retained.text%2Cprevious.steps.find%28row%3D%3Erow.name%3D%3D%3Dretained.name%29.text%29%3B%0A%20%20for%28const%20other%20of%20old.filter%28row%3D%3Erow.id%21%3D%3Djob.id%29%29assert.deepEqual%28current.find%28row%3D%3Erow.id%3D%3D%3Dother.id%29%2Cother%29%3B%0A%20%20assert.match%28current.find%28row%3D%3Erow.id%3D%3D%3D%27test%27%29.header%2C%2Fpackage-checks%2Fu%29%3B%0A%7D%29%3B%0A%0Atest%28%27historical%20workflow%20views%20authenticate%20the%20entire%20new%20schedule%20and%20refuse%20unknown%20current%20authentication%27%2C%28%29%3D%3E%7B%0A%20%20const%20path%3D%27.github%2Fworkflows%2Fjs.yml%27%2Csource%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bpath%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20const%20old%3DcaptureGitArtifactCertificate%28%2776e27c44c5854a2cb547aea5cef06ea80adf729c%27%2Cpath%29.blob.toString%28%27utf8%27%29%3B%0A%20%20assert.equal%28restoreRawPlanningWorkflowHistory%28source%2Cpath%29%2Cold%29%3B%0A%20%20for%28const%20legacyHint%20of%20%5B%27.github%2Fworkflows%2Fci.yml%27%2C%27.github%2Fworkflows%2Frust.yml%27%5D%29%7B%0A%20%20%20%20assert.equal%28restoreRawPlanningWorkflowHistory%28source%2ClegacyHint%29%2Cold%2C%0A%20%20%20%20%20%20%27legacy%20cross-workflow%20hints%20still%20require%20the%20exact%20complete%20JavaScript%20digest%20and%20certificate%27%29%3B%0A%20%20%7D%0A%20%20assert.equal%28restoreRawPlanningWorkflowHistory%28source%2C%27unknown.js%27%29%2Csource%29%3B%0A%20%20for%28const%20changed%20of%20%5Bsource%2B%27%5Cn%23%20unknown%20source%5Cn%27%2Csource.replace%28%27timeout-minutes%3A%2010%27%2C%27timeout-minutes%3A%2011%27%29%2C%0A%20%20%20%20source.replace%28%27source-model-raw-generation%27%2C%27unknown-generation%27%29%5D%29%7B%0A%20%20%20%20assert.notEqual%28changed%2Csource%29%3B%0A%20%20%20%20assert.equal%28restoreRawPlanningWorkflowHistory%28changed%2Cpath%29%2Cchanged%29%3B%0A%20%20%7D%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
