(20640: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %23%21%2Fusr%2Fbin%2Fenv%20node%0A%2F%2F%20Checks%20the%20dependency%20inventory%20%28requirement%20I195-DEPENDENCY-INVENTORY%29%3A%0A%2F%2F%20every%20dependency%20the%20repository%20declares%20is%20in%20parity%2Fdependency-inventory.json%0A%2F%2F%20with%20its%20recorded%20pin%2C%20the%20audit%20date%20is%20valid%2C%20every%20retained%20item%20behind%20its%0A%2F%2F%20current%20stable%20release%20records%20a%20compatibility%20reason%2C%20and%0A%2F%2F%20docs%2Fdependency-audit.md%20is%20the%20inventory%27s%20rendering.%0A%2F%2F%0A%2F%2F%20--delivery%20is%20the%20delivery%20gate%20%28I195-DEPENDENCY-CURRENT-STABLE-DELIVERY%29%3A%0A%2F%2F%20every%20retained%20item%20must%20be%20at%20its%20current%20stable%20release%20or%20at%20its%0A%2F%2F%20verified%20newest%20compatible%20release%3B%20a%20reason%20alone%20is%20stale.%20With%20--live%2C%0A%2F%2F%20and%20by%20default%20when%20CI%20or%20ACCEPTANCE_CHECKPOINT%20is%20set%2C%20it%20also%20refreshes%0A%2F%2F%20the%20inventory%20from%20the%20registries%20in%20memory%20and%20fails%20when%20the%20recorded%0A%2F%2F%20audit%20no%20longer%20matches%20them%3B%20--offline%20compares%20with%20the%20recorded%20audit%20only.%0A%2F%2F%0A%2F%2F%20%20%20node%20js%2Fscripts%2Fcheck-dependencies.mjs%20%20%20%20%20%20%20%20%20%20%20%20offline%20check%20%28CI%29%0A%2F%2F%20%20%20node%20js%2Fscripts%2Fcheck-dependencies.mjs%20--refresh%20%20query%20the%20registries%20and%20rewrite%0A%2F%2F%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20the%20inventory%20and%20the%20audit%20document%0A%2F%2F%20%20%20node%20js%2Fscripts%2Fcheck-dependencies.mjs%20--delivery%20%5B--live%7C--offline%5D%20--consumer-lock%20%3Cpackage-lock.json%3E%0Aimport%20%7B%20execFileSync%20%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7B%20existsSync%2C%20readFileSync%2C%20writeFileSync%20%7D%20