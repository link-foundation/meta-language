%5D.start%29%5Cn%20%20%20%20%20%20%20%20%2B%20source.slice%28tokens%5Bfirst.close%20%2B%201%5D.end%2C%20tokens%5Bsecond.start%5D.start%29%3B%5Cn%20%20%20%20%20%20if%20%28gap.trim%28%29%29%20continue%3B%5Cn%20%20%20%20%20%20%2F%2F%20Merging%20must%20not%20discard%20either%20occurrence%20of%20an%20original%20comment.%5Cn%20%20%20%20%20%20let%20prior%20%3D%20tokens%5Bfirst.open%5D.end%2C%20commented%20%3D%20false%3B%5Cn%20%20%20%20%20%20for%20%28let%20at%20%3D%20first.open%20%2B%201%3B%20at%20%3C%3D%20first.close%3B%20at%20%2B%3D%201%29%20%7B%5Cn%20%20%20%20%20%20%20%20if%20%28source.slice%28prior%2C%20tokens%5Bat%5D.start%29.trim%28%29%29%20commented%20%3D%20true%3B%5Cn%20%20%20%20%20%20%20%20prior%20%3D%20tokens%5Bat%5D.end%3B%5Cn%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20if%20%28commented%29%20continue%3B%5Cn%20%20%20%20%20%20%2F%2F%20A%20condition-local%20binding%20cannot%20be%20read%20by%20a%20merged%20sibling%20body.%5Cn%20%20%20%20%20%20const%20firstCondition%20%3D%20tokens.slice%28index%20%2B%201%2C%20first.open%29%3B%5Cn%20%20%20%20%20%20const%20secondCondition%20%3D%20tokens.slice%28second.start%20%2B%201%2C%20second.open%29%3B%5Cn%20%20%20%20%20%20if%20%28%5B...firstCondition%2C%20...secondCondition%5D.some%28token%20%3D%3E%20%5B%27let%27%2C%20%27%7B%27%2C%20%27%7D%27%5D.includes%28token.value%29%29%29%20continue%3B%5Cn%20%20%20%20%20%20const%20left%20%3D%20source.slice%28tokens%5Bindex%5D.end%2C%20tokens%5Bfirst.open%5D.start%29%3B%5Cn%20%20%20%20%20%20const%20right%20%3D%20source.slice%28tokens%5Bsecond.start%5D.end%2C%20tokens%5Bsecond.open%5D.start%29%3B%5Cn%20%20%20%20%20%20replacement%20%3D%20%7Bstart%3A%20tokens%5Bindex%5D.start%2C%20end%3A%20tokens%5Bsecond.open%5D.end%2C%5Cn%20%20%20%20%20%20%20%20text%3A%20%60if%20%28%5C%5Cn%24%7Bleft%7D%5C%5Cn%29%20%7C%7C%20%28%5C%5Cn%24%7Bright%7D%5C%5Cn%29%20%7B%60%7D%3B%5Cn%20%20%20%20%20%20break%3B%5Cn%20%20%20%20%7D%5Cn%20%20%20%20if%20%28%21replacement%29%20return%20source%3B%5Cn%20%20%20%20source%20%3D%20so