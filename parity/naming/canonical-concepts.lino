ivia%5D%2C%20LinkMetadata.new%28%29.withLinkType%28LinkType.Reference%29%29%3B%5Cn%20%20const%20original%20%3D%20network.link%28syntax%29%2C%20originalSpan%20%3D%20original.metadata%28%29.span%3B%5Cn%20%20const%20before%20%3D%20network.toLino%28%29%3B%5Cn%20%20const%20abstract%20%3D%20network.projectedLinks%28NetworkProjection.AbstractSyntax%29%3B%5Cn%20%20assert.deepEqual%28identifiers%28abstract%29%2C%20%5Bsyntax%2C%20label%2C%20field%2C%20region%2C%20provenance%5D.map%28Number%29%29%3B%5Cn%20%20const%20actual%20%3D%20abstract.find%28link%20%3D%3E%20link.id%28%29.equals%28syntax%29%29%3B%5Cn%20%20assert.equal%28actual%2C%20original%29%3B%5Cn%20%20assert.equal%28actual.metadata%28%29.span%2C%20originalSpan%29%3B%5Cn%20%20assert.deepEqual%28actual.metadata%28%29.span%2C%20span%29%3B%5Cn%20%20assert.equal%28actual.metadata%28%29.flags.hasError%2C%20true%29%3B%5Cn%20%20assert.deepEqual%28network.link%28field%29.references%28%29%2C%20%5Bsyntax%2C%20label%2C%20token%5D%29%3B%5Cn%20%20assert.equal%28network.link%28label%29.metadata%28%29.term%2C%20%27name%27%29%3B%5Cn%20%20assert.deepEqual%28actual.references%28%29%2C%20%5Btoken%2C%20trivia%5D%29%3B%5Cn%20%20for%20%28const%20reference%20of%20actual.references%28%29%29%20%7B%5Cn%20%20%20%20assert.ok%28network.link%28reference%29%2C%20%27excluded%20concrete%20links%20remain%20resolvable%20in%20the%20complete%20source%20network%27%29%3B%5Cn%20%20%20%20assert.ok%28%21abstract.includes%28network.link%28reference%29%29%29%3B%5Cn%20%20%7D%5Cn%20%20assert.equal%28network.link%28token%29.metadata%28%29.flags.isMissing%2C%20true%29%3B%5Cn%20%20assert.equal%28network.link%28token%29.metadata%28%29.flags.isExtra%2C%20true%29%3B%5Cn%20%20assert.equal%28network.toLino%28%29%2C%20before%29%3B%5Cn%7D%29%22.) (lang: meta-language%20structured%20data)))
