%20and%200%20above%20-0.%5Cn%20%20%20%20%23%5Bmust_use%5D%5Cn%20%20%20%20pub%20fn%20max%28a%3A%20f64%2C%20b%3A%20f64%29%20-%3E%20f64%20%7B%5Cn%20%20%20%20%20%20%20%20if%20a%20%3E%20b%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20a%5Cn%20%20%20%20%20%20%20%20%7D%20else%20if%20b%20%3E%20a%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20b%5Cn%20%20%20%20%20%20%20%20%7D%20else%20if%20a%20%3D%3D%20b%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20if%20a.is_sign_negative%28%29%20%7B%20b%20%7D%20else%20%7B%20a%20%7D%5Cn%20%20%20%20%20%20%20%20%7D%20else%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20f64%3A%3ANAN%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%2F%2F%2F%20Math.min%20of%20two%20Numbers%3A%20NaN%20when%20either%20is%2C%20and%20-0%20below%200.%5Cn%20%20%20%20%23%5Bmust_use%5D%5Cn%20%20%20%20pub%20fn%20min%28a%3A%20f64%2C%20b%3A%20f64%29%20-%3E%20f64%20%7B%5Cn%20%20%20%20%20%20%20%20if%20a%20%3C%20b%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20a%5Cn%20%20%20%20%20%20%20%20%7D%20else%20if%20b%20%3C%20a%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20b%5Cn%20%20%20%20%20%20%20%20%7D%20else%20if%20a%20%3D%3D%20b%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20if%20a.is_sign_negative%28%29%20%7B%20a%20%7D%20else%20%7B%20b%20%7D%5Cn%20%20%20%20%20%20%20%20%7D%20else%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20f64%3A%3ANAN%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%23%5Bmust_use%5D%5Cn%20%20%20%20pub%20fn%20max_of%28values%3A%20%26%5Bf64%5D%29%20-%3E%20f64%20%7B%5Cn%20%20%20%20%20%20%20%20values.iter%28%29.fold%28f64%3A%3ANEG_INFINITY%2C%20%7Ca%2C%20%26b%7C%20max%28a%2C%20b%29%29%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%23%5Bmust_use%5D%5Cn%20%20%20%20pub%20fn%20min_of%28values%3A%20%26%5Bf64%5D%29%20-%3E%20f64%20%7B%5Cn%20%20%20%20%20%20%20%20values.iter%28%29.fold%28f64%3A%3AINFINITY%2C%20%7Ca%2C%20%26b%7C%20min%28a%2C%20b%29%29%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%23%5Bmust_use%5D%5Cn%20%20%20%20pub%20fn%20is_integer%28x%3A%20f64%