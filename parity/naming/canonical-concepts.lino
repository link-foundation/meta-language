(175161: (meta: (t: semantic) (n: 1) (term: string%20value) (def: The%20actual%20grammar%20lexer%20native%20declaration%20ml_math%20in%20rust%2Fsrc%2Ftranslation%2Fgrammar_lexer_rules%2Fpart_1.rs.%20Complete%20formal%20source%20definition%3A%20encoded%20as%20an%20exact%20JSON%20string%3A%20%22pub%20mod%20ml_math%20%7B%5Cn%20%20%20%20%2F%2F%2F%20Math.round%3A%20the%20nearest%20integer%2C%20the%20one%20towards%20%2BInfinity%20on%20a%20tie%2C%5Cn%20%20%20%20%2F%2F%2F%20with%20the%20sign%20of%20a%20zero%20result%20from%20the%20argument.%5Cn%20%20%20%20%23%5Bmust_use%5D%5Cn%20%20%20%20pub%20fn%20round%28x%3A%20f64%29%20-%3E%20f64%20%7B%5Cn%20%20%20%20%20%20%20%20if%20%21x.is_finite%28%29%20%7C%7C%20x%20%3D%3D%200.0%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20return%20x%3B%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20if%20x%20%3E%200.0%20%26%26%20x%20%3C%200.5%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20return%200.0%3B%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20if%20x%20%3C%200.0%20%26%26%20x%20%3E%3D%20-0.5%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20return%20-0.0%3B%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20let%20floor%20%3D%20x.floor%28%29%3B%5Cn%20%20%20%20%20%20%20%20if%20x%20-%20floor%20%3E%3D%200.5%20%7B%20floor%20%2B%201.0%20%7D%20else%20%7B%20floor%20%7D%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%2F%2F%2F%20Math.sign%2C%20which%20keeps%20-0%2C%200%20and%20NaN%2C%20where%20f64%3A%3Asignum%20does%20not.%5Cn%20%20%20%20%23%5Bmust_use%5D%5Cn%20%20%20%20pub%20fn%20sign%28x%3A%20f64%29%20-%3E%20f64%20%7B%5Cn%20%20%20%20%20%20%20%20if%20x%20%3E%200.0%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%201.0%5Cn%20%20%20%20%20%20%20%20%7D%20else%20if%20x%20%3C%200.0%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20-1.0%5Cn%20%20%20%20%20%20%20%20%7D%20else%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20x%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%2F%2F%2F%20Math.max%20of%20two%20Numbers%3A%20NaN%20when%20either%20is%