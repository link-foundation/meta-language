(182206: (meta: (t: semantic) (n: 1) (term: string%20value) (def: Execute%20the%20actual%20independent%20lexical%20class%20replay%20operation%20independent%20tool%20outcomes%20preserve%20operation%20causes%20and%20refuse%20resource%20failures%20as%20syntax%20evidence.%20Check%20the%20actual%20bounded%20source%2C%20assertion%20and%20fixture%20contract.%20Every%20original%20assertion%20in%20this%20control%20remains%20part%20of%20the%20definition%3B%20observations%20exist%20only%20after%20real%20execution%20on%20the%20recorded%20commit.%20Complete%20exact%20source%20encoded%20as%20one%20JSON%20string%3A%20%22test%28%27independent%20tool%20outcomes%20preserve%20operation%20causes%20and%20refuse%20resource%20failures%20as%20syntax%20evidence%27%2C%20%28%29%20%3D%3E%20%7B%5Cn%20%20const%20cause%20%3D%20new%20Error%28%27original%20operation%20cause%27%29%3B%5Cn%20%20const%20failure%20%3D%20new%20TypeError%28%27target%20action%20failed%27%2C%20%7B%20cause%20%7D%29%3B%5Cn%20%20const%20operation%20%3D%20targetGrammarToolOutcome%28%7B%20parse%28%29%20%7B%20throw%20failure%3B%20%7D%20%7D%2C%20%27%C3%A9%27%29%3B%5Cn%20%20assert.equal%28operation.accepted%2C%20null%29%3B%5Cn%20%20assert.equal%28operation.error.name%2C%20%27TypeError%27%29%3B%5Cn%20%20assert.equal%28operation.error.message%2C%20failure.message%29%3B%5Cn%20%20assert.equal%28operation.error.stack%2C%20failure.stack%29%3B%5Cn%20%20assert.equal%28operation.error.cause.message%2C%20cause.message%29%3B%5Cn%20%20assert.equal%28operation.error.cause.stack%2C%20cause.stack%29%3B%5Cn%20%20assert.equal%28%27offset%27%20in%20operation%2C%20false%29%3B%5Cn%20%20assert.equal%28%27expected%27%20in%20operation%2C%20false%29%3B%5Cn%20%20assert.equal%28isGrammarToolSyntaxRejection%28operation%29%2C%20false%29%3B%5Cn%20%20class%20SyntaxError%20extends%20Error%20%7B%7D%5Cn%20%20const%20syntax%20%3D%20new%20SyntaxError%28%27actual%20target%20syntax%27%29%3B%5Cn%20%20syntax.location%20%3D%20%7B%20start%3A%20%7B%20offset%3A%201%20%7D%20%7D%3B%5Cn%20%20const%20parser%20%3D%20%7B%20SyntaxError%2C%20parse%28%29%20%7B%20throw%20syntax%3B%20%7D%20%7D%3B%5Cn%20%20assert.deepEqual%28targetGrammarToolOutcome%28parser%2C%20%27%C3%A9x%27%29%2C%20%7B%20accepted%3A%20false%2C%20offset%3A%202%2C%20reason%3A%20%27syntax%27%20%7D%29%3B%5Cn%20%20syntax.location.start.offset%20%3D%209%3B%5Cn%20%20assert.equal%28targetGrammarToolOutcome%28parser%2C%20%27%C3%A9x%27%29.accepted%2C%20null%2C%20%27a%20missing%20actual%20source%20location%20is%20an%20operation%20refusal%27%29%3B%5Cn%20%20const%20original%20%3D%20importPest%28%27root%20%3D%20%7B%20%5C%22a%5C%22%20%7D%27%29%3B%5Cn%20%20const%20resource%20%3D%20nativeGrammarToolOutcome%28original%2C%20%27a%27%2C%20%28%29%20%3D%3E%20%7B%20throw%20new%20GrammarParseError%28%7B%20reason%3A%20%27stepLimit%27%2C%20limit%3A%201%20%7D%29%3B%20%7D%29%3B%5Cn%20%20assert.deepEqual%28resource%2C%20%7B%20accepted%3A%20false%2C%20offset%3A%20null%2C%20reason%3A%20%27stepLimit%27%2C%20expected%3A%20%5B%5D%20%7D%29%3B%5Cn%20%20assert.equal%28isGrammarToolSyntaxRejection%28resource%29%2C%20false%29%3B%5Cn%20%20const%20invalid%20%3D%20new%20Grammar%28%27root%27%2C%20new%20Map%28%5B%5B%27root%27%2C%20%7B%20name%3A%20%27root%27%2C%20expression%3A%20%7B%20kind%3A%20%27ref%27%2C%20name%3A%20%27missing%27%20%7D%20%7D%5D%5D%29%29%3B%5Cn%20%20const%20refused%20%3D%20nativeGrammarToolOutcome%28invalid%2C%20%27a%27%2C%20%28tree%29%20%3D%3E%20tree%29%3B%5Cn%20%20assert.equal%28refused.accepted%2C%20null%29%3B%5Cn%20%20assert.equal%28refused.error.name%2C%20%27GrammarRuntimeError%27%29%3B%5Cn%20%20assert.equal%28refused.error.reason%2C%20%27reference%27%29%3B%5Cn%20%20assert.match%28refused.error.message%2C%20%2Fmissing%2Fu%29%3B%5Cn%20%20assert.equal%28isGrammarToolSyntaxRejection%28refused%29%2C%20false%29%3B%5Cn%20%20assert.equal%28grammarToolOperationFailure%28undefined%29.error.thrownType%2C%20%27undefined%27%29%3B%5Cn%7D%29%22.) (lang: meta-language%20structured%20data)))
