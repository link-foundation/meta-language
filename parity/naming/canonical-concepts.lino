5C%5C%5Bexpect%5C%5C%28clippy%3A%3Afn_params_excessive_bools%2C%20reason%20%3D%20%5C%22the%20checked%20source%20interface%20retains%20independent%20Boolean%20and%20text%20inputs%20in%20their%20original%20evaluation%20order%5C%22%5C%5C%29%5C%5C%5D%5C%5Cnpub%20fn%20require_optional_result_binding%2Fu%29%3B%5Cn%20%20assert.ok%28result.source.includes%28%27let%20middle%20%3D%20%28%28lower%20%2B%20upper%29%20%2F%202f64%29.floor%28%29%3B%27%29%29%3B%5Cn%20%20assert.equal%28readSourceTextRustBlock%28result.source%2C%20%27fn%27%2C%20%27other%27%29%2C%20readSourceTextRustBlock%28source%2C%20%27fn%27%2C%20%27other%27%29%29%3B%5Cn%20%20replay%28source%2C%20result%29%3B%5Cn%20%20const%20raw%20%3D%20source.replace%28%27%28%28lower%20%2B%20upper%29%20%2F%202f64%29.floor%28%29%27%2C%20%27%28%28%28lower%20%2B%20upper%29%20%2F%202f64%29%29.floor%28%29%27%29%3B%5Cn%20%20const%20rawResult%20%3D%20readPortableNumberSourceStyles%28raw%29%3B%5Cn%20%20assert.ok%28rawResult.source.includes%28%27let%20middle%20%3D%20%28%28%28lower%20%2B%20upper%29%20%2F%202f64%29%29.floor%28%29%3B%27%29%2C%5Cn%20%20%20%20%27the%20actual%20raw%20emitter%20group%20is%20recognized%20without%20changing%20a%20single%20arithmetic%20or%20grouping%20token%27%29%3B%5Cn%20%20assert.equal%28%28rawResult.source.match%28%2Fclippy%3A%3Amanual_midpoint%2Fgu%29%20%3F%3F%20%5B%5D%29.length%2C%201%29%3B%5Cn%20%20replay%28raw%2C%20rawResult%29%3B%5Cn%20%20for%20%28const%20changed%20of%20%5Bsource.replace%28%27%2F%202f64%27%2C%20%27%2F%203f64%27%29%2C%20source.replace%28%27%28lower%20%2B%20upper%29%27%2C%20%27%28upper%20%2B%20lower%29%27%29%2C%5Cn%20%20%20%20source.replace%28%27lower%3A%20f64%27%2C%20%27lower%3A%20f32%27%29%2C%20source.replace%28%27additional%3A%20bool%27%2C%20%27additional%3A%20i32%27%29%2C%5Cn%20%20%20%20raw.replace%28%27%28%28%28lower%20%2B%20upper%29%20%2F%202f64%29%29%27%2C%20%27%28lower%20%2B%20%28upper%20%2F%202f64%29%29%27%29%2C%5Cn%20%20%20%20raw.replace%28%27%28%28%28lower%20%2B%20upper%29%20%2F%202f