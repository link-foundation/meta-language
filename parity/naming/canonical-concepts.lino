3Ef64%7Bvalue%7D%27%29%2C%5Cn%20%20%20%20%7B%20source%3A%20doc%20%2B%20%27%5C%5Cn%27%20%2B%20%27pub%20fn%20sign%28value%3Af64%29-%3Ef64%7Bvalue%7D%27%2C%20actions%3A%20%5B%5D%20%7D%29%3B%5Cn%20%20for%20%28const%20opaque%20of%20%5B%5Cn%20%20%20%20%27custom%21%7B%27%20%2B%20STRING_PRELUDE%20%2B%20%27%7D%27%2C%5Cn%20%20%20%20%27custom%20%21%20%5B%27%20%2B%20STRING_PRELUDE%20%2B%20%27%5D%27%2C%5Cn%20%20%20%20%27outer%21%28inner%21%7B%27%20%2B%20STRING_PRELUDE%20%2B%20%27%7D%29%27%2C%5Cn%20%20%20%20%27macro_rules%21%20carried%20%7B%20%28%29%20%3D%3E%20%7B%27%20%2B%20STRING_PRELUDE%20%2B%20%27%7D%3B%20%7D%27%2C%5Cn%20%20%20%20%27macro_rules%20%21%20carried%20%7B%20%28%29%20%3D%3E%20%7B%27%20%2B%20STRING_PRELUDE%20%2B%20%27%7D%3B%20%7D%27%2C%5Cn%20%20%20%20%27%23%5Bcarried%28%27%20%2B%20STRING_PRELUDE%20%2B%20%27%29%5D%20struct%20Holder%3B%27%2C%5Cn%20%20%20%20%27%23%21%5Bcarried%28%27%20%2B%20STRING_PRELUDE%20%2B%20%27%29%5D%27%2C%5Cn%20%20%5D%29%20%7B%5Cn%20%20%20%20assert.deepEqual%28readPortableRuntimeSourceStyles%28opaque%29%2C%20%7B%20source%3A%20opaque%2C%20actions%3A%20%5B%5D%20%7D%29%3B%5Cn%20%20%20%20const%20mixed%20%3D%20readPortableRuntimeSourceStyles%28opaque%20%2B%20%27%5C%5Cn%27%20%2B%20STRING_PRELUDE%29%3B%5Cn%20%20%20%20assert.ok%28mixed.source.startsWith%28opaque%20%2B%20%27%5C%5Cn%27%29%29%3B%5Cn%20%20%20%20assert.notEqual%28mixed.source%2C%20opaque%20%2B%20%27%5C%5Cn%27%20%2B%20STRING_PRELUDE%2C%20%27the%20real%20prelude%20after%20opaque%20tokens%20is%20still%20styled%27%29%3B%5Cn%20%20%20%20assert.equal%28replayRuntimeStyles%28opaque%20%2B%20%27%5C%5Cn%27%20%2B%20STRING_PRELUDE%2C%20mixed.actions%29%2C%20mixed.source%29%3B%5Cn%20%20%7D%5Cn%20%20const%20hiddenDoc%20%3D%20%27pub%20mod%20ml_math%20%7B%20unknown%21%7B%5C%5Cn%27%20%2B%20doc%20%2B%20%27%5C%5Cn%7D%20%7D%27%3B%5Cn%20%20assert.deepEqual%28readPortableRuntimeSourceStyles%28hiddenDoc%29%2C%20%7B%20source%3A%20hiddenDoc%2C%20actions%3A%20%5B%5D%20%7D%29%3B%5Cn%20%20const%20numeric%20%3D%20readIntegerRuntime%28%27NUMBER_PRELUDE%27%29%2C%20documented%20%3D%20readPortableRuntimeSourceStyles%28numeric%29.source%3B%5Cn%20%20assert.equal%28documented%2C%20numeric.replace%28%27ECMAScript%20Number%3A%3AtoString%3A%27%2C%20%27ECMAScript%20%60Number%3A%3AtoString%60%3A%27%29%5Cn%20%20%20%20.replace%28%27%2F%2F%2F%20SameValue%2C%20as%20Object.is%20and%20assert.strictEqual%20compare%3A%27%2C%20%27%2F%2F%2F%20%60SameValue%60%2C%20as%20%60Object.is%60%20and%20%60assert.strictEqual%60%20compare%3A%27%29%5Cn%20%20%20%20.replace%28%27pub%20fn%20same_value%27%2C%20%27pub%20const%20fn%20same_value%27%29%29%3B%5Cn%20%20assert.deepEqual%28readPortableRuntimeSourceStyles%28documented%29%2C%20%7B%20source%3A%20documented%2C%20actions%3A%20%5B%5D%20%7D%29%3B%5Cn%20%20const%20changedSameValue%20%3D%20numeric.replace%28%27a.to_bits%28%29%20%3D%3D%20b.to_bits%28%29%27%2C%20%27a%20%3D%3D%20b%27%29%3B%5Cn%20%20const%20changedNumeric%20%3D%20readPortableRuntimeSourceStyles%28changedSameValue%29.source%3B%5Cn%20%20assert.ok%28changedNumeric.includes%28%27pub%20fn%20same_value%27%29%29%3B%5Cn%20%20assert.ok%28changedNumeric.includes%28%27a%20%3D%3D%20b%27%29%29%3B%5Cn%20%20const%20mathRuntime%20%3D%20readIntegerRuntime%28%27MATH_PRELUDE%27%29%2C%20ranged%20%3D%20readPortableRuntimeSourceStyles%28mathRuntime%29.source%3B%5Cn%20%20assert.equal%28ranged%2C%20mathRuntime.replace%28%27if%20x%20%3C%200.0%20%26%26%20x%20%3E%3D%20-0.5%20%7B%27%2C%20%27if%20%28-0.5..0.0%29.contains%28%26x%29%20%7B%27%29%5Cn%20%20%20%20.replace%28%27where%20f64%3A%3Asignum%27%2C%20%27where%20%60f64%3A%3Asignum%60%27%29%29%3B%5Cn%20%20assert.deepEqual%28readPortableRuntimeSourceStyles%28ranged%29%2C%20%7B%20source%3A%20ranged%2C%20actions%3A%20%5B%5D%20%7D%29%3B%5Cn%20%20const%20changedRound%20%3D%20mathRuntime.replace%28%27if%20x%20%3C%200.0%20%26%26%20x%20%3E%3D%20-0.5%20%7B%27%2C%20%27if%20x%20%3C%200.0%20%26%26%20x%20%3E%20-0.5%20%7B%27%29%3B%5Cn%20%20assert.equal%28readPortableRuntimeSourceStyles%28changedRound%