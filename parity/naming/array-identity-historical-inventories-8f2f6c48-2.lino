%2C%20entry.id%29%3B%0A%20%20%20%20return%20true%3B%0A%20%20%7D%29%3B%0A%20%20assert.throws%28%28%29%20%3D%3E%20parseRust%28%27fn%20main%28%29%7B%7D%27%2C%20%7B%20arrayResultModel%3A%20%27unknown%27%20%7D%29%2C%20%2FRust%20array%20result%20model%2Fu%29%3B%0A%20%20assert.throws%28%28%29%20%3D%3E%20createTypedProgramLinks%28%27fn%20main%28%29%7B%7D%27%2C%20%27Rust%27%2C%20%7B%20rustArrayResultModel%3A%20%27unknown%27%20%7D%29%2C%20%2FRust%20array%20result%20model%2Fu%29%3B%0A%20%20assert.throws%28%28%29%20%3D%3E%20createTypedProgramLinks%28%27function%20value%28%29%7Breturn%201%3B%7D%27%2C%20%27JavaScript%27%2C%20%7B%20rustArrayResultModel%3A%20fixture.arrayResultModel%20%7D%29%2C%20%2Frequires%20Rust%20source%2Fu%29%3B%0A%7D%29%3B%0Atest%28%27generated%20profile%20decisions%20require%20fresh%20owned%20scalar%20results%20and%20constructor%20tails%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20model%20%3D%20fixture.arrayResultModel%3B%0A%20%20assert.equal%28acceptRustSourceArrayResultModel%28%27%27%29%2C%20true%29%3B%0A%20%20assert.equal%28acceptRustSourceArrayResultModel%28model%29%2C%20true%29%3B%0A%20%20assert.equal%28acceptRustSourceArrayResultModel%28%27unknown%27%29%2C%20false%29%3B%0A%20%20for%20%28const%20kind%20of%20%5B%27bool%27%2C%20%27float%27%2C%20%27fixed%27%2C%20%27unit%27%5D%29%20%7B%0A%20%20%20%20assert.equal%28acceptRustSourceArrayResult%28model%2C%20kind%2C%20true%2C%20true%29%2C%20true%29%3B%0A%20%20%20%20assert.equal%28acceptRustSourceArrayResult%28%27%27%2C%20kind%2C%20true%2C%20true%29%2C%20false%29%3B%0A%20%20%20%20assert.equal%28acceptRustSourceArrayResult%28model%2C%20kind%2C%20false%2C%20true%29%2C%20false%29%3B%0A%20%20%20%20assert.equal%28acceptRustSourceArrayResult%28model%2C%20kind%2C%20true%2C%20false%29%2C%20false%29%3B%0A%20%20%7D%0A%20%20for%20%28const%20kind%20of%20%5B%27string%27%2C%20%27array%27%2C%20%27named%27%2C%20%27tuple%27%5D%29%20assert.equal%28acceptRustSourceArrayResult%28model%2C%20kind%2C%20true%2C%20true%29%2C%20false%29