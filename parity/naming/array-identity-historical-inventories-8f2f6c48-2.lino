(73260: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Source-only%20controls%20supplement%20every%20unchanged%20historical%20reader%20assertion.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20test%20from%20%27node%3Atest%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadProjectData%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BgenerateJavaScriptMutableArrayBindings%7D%20from%20%27..%2Fscripts%2Fgenerate-javascript-mutable-array-bindings.mjs%27%3B%0Aimport%20%7BrestoreProgramStringHostRegistrationSource%7D%20from%20%27..%2Fscripts%2Fprogram-string-host-registration-history.mjs%27%3B%0Aimport%20%7BderiveReferenceIdentityValidationSource%2CrestoreReferenceIdentityHistoricalSource%7D%20from%20%27..%2Fscripts%2Freference-identity-source-history.mjs%27%3B%0Aimport%20%7BreadCollectionSizeProjectionSchemaPacket%2CderiveCollectionSizeProjectionValidationSource%2CverifyCollectionSizeProjectionSchemaPacket%7D%20from%20%27..%2Fscripts%2Fcollection-size-projection-schema.mjs%27%3B%0Aimport%20%7BgenerateRequiredFieldNativeHostSuccession%7D%20from%20%27..%2Fscripts%2Fgenerate-required-field-native-host-succession.mjs%27%3B%0Aimport%20%7BrestoreCurrentNativeHostSource%7D%20from%20%27..%2Fscripts%2Fcurrent-native-host-source-history.mjs%27%3B%0Aimport%20%7BrestoreScopedIterationNativeHostSource%2CSCOPED_ITERATION_NATIVE_SOURCE%7D%20from%20%27..%2Fscripts%2Fscoped-iteration-native-host-source-history.mjs%27%3B%0Aimport%20%7BREQUIRED_FIELD_NATIVE_HOST_OUTPUT%2CREQUIRED_FIELD_NATIVE_HOST_SOURCES%2CpinRequiredFieldNativeHostSource%2C%0A%20%20verifyRequiredFieldNativeHostSuccession%2CrestoreRequiredFieldNativeHostSource%7D%20from%20%27..%2Fscripts%2Frequired-field-native-host-succession.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20packet%3D%28%29%3D%3EreadProjectData%28new%20URL%28REQUIRED_FIELD_NATIVE_HOST_OUTPUT%2Croot%29%29%3B%0Atest%28%27active%