tests%2F%27.length%29%29%3B%0A%20%20for%28const%20file%20of%20partitionTests%28originalFiles%29.groups.translation%29assert.ok%28files.includes%28file%29%2Cfile%29%3B%0A%7D%29%3B%0A%0Atest%28%27six%20feedback%20partitions%20merge%20exact%20scope%20and%20bytes%20while%20missing%20foreign%20and%20tampered%20cohorts%20refuse%27%2C%28t%29%3D%3E%7B%0A%20%20const%20root%3DrealpathSync%28mkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-six-feedback-%27%29%29%29%3B%0A%20%20t.after%28%28%29%3D%3ErmSync%28root%2C%7Brecursive%3Atrue%7D%29%29%3B%0A%20%20mkdirSync%28join%28root%2C%27js%2Ftests%27%29%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3C6%3Bindex%2B%2B%29writeFileSync%28join%28root%2C%27js%2Ftests%2Ftranslation-%27%2Bindex%2B%27.test.js%27%29%2C%27%27%29%3B%0A%20%20const%20payload%3D%27issue-195-artifacts%2Fcompiler-feedback%2Fsource.lino%27%3B%0A%20%20mkdirSync%28join%28root%2C%27issue-195-artifacts%2Fcompiler-feedback%27%29%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20writeFileSync%28join%28root%2Cpayload%29%2C%27%28retained%20compiler%20bytes%29%5Cn%27%29%3B%0A%20%20const%20commit%3D%27a%27.repeat%2840%29%2CinputDirectory%3Djoin%28root%2C%27parts%27%29%2Cdirectories%3D%5B%5D%3B%0A%20%20const%20capture%3Dindex%3D%3EcaptureTranslationTestFeedbackPartition%28%7Broot%2Ccommit%2Cpartitions%3A6%2C%0A%20%20%20%20shard%3A%28index%2B1%29%2B%27%2F6%27%2CoutputDirectory%3Ajoin%28inputDirectory%2C%27translation-test-feedback-%27%2Bcommit%2B%27-%27%2B%28index%2B1%29%2B%27-of-6%27%29%7D%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3C6%3Bindex%2B%2B%29%7B%0A%20%20%20%20const%20receipt%3Dcapture%28index%29%3Bassert.equal%28receipt.files.length%2C1%29%3B%0A%20%20%20%20directories.push%28join%28inputDirectory%2C%27translation-test-feedback-%27%2Bcommit%2B%27-%27%2B%28index%2B1%29%2B%27-of-6%27%29%29%3B%0A%20%20%7D%0A%20%20const%20arguments_%3D%7Broot%2Ccommit%2CinputDirectory%2Cpartitions%3A6%2CoutputDirectory%3Ajoin%28root%2C%27merged%27%29%7D%3B%0A%20%20const%20