ediate%20predecessor%27%2C%28%29%3D%3E%7B%0A%20%20const%20fixture%3DmakeGitCertificateFixture%28%29%3B%0A%20%20try%7B%0A%20%20%20%20const%20%7Bcertificate%2Cblob%7D%3DcaptureGitArtifactCertificate%28fixture.revision%2Cfixture.path%2C%7Brepository%3Afixture.repository%7D%29%3B%0A%20%20%20%20const%20limits%3D%7BmaxBlobBytes%3Ablob.length%2CmaxCommitBytes%3ABuffer.byteLength%28certificate.commitText%29%2CmaxPathDepth%3Acertificate.trees.length%2C%0A%20%20%20%20%20%20maxTreeEntries%3AMath.max%28...certificate.trees.map%28tree%3D%3Etree.entries.length%29%29%2C%0A%20%20%20%20%20%20maxTreeBytes%3AMath.max%28...certificate.trees.map%28tree%3D%3ENumber%28fixture.git%28%5B%27cat-file%27%2C%27-s%27%2Ctree.objectId%5D%29.trim%28%29%29%29%29%7D%3B%0A%20%20%20%20assert.deepEqual%28verifyGitArtifactCertificate%28certificate%2Cblob%2C%7Brevision%3Afixture.revision%2Cpath%3Afixture.path%2Climits%7D%29%2Cblob%29%3B%0A%20%20%20%20for%28const%20key%20of%20Object.keys%28limits%29%29%7B%0A%20%20%20%20%20%20assert.ok%28limits%5Bkey%5D%3E1%29%3B%0A%20%20%20%20%20%20assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28certificate%2Cblob%2C%7Brevision%3Afixture.revision%2Cpath%3Afixture.path%2Climits%3A%7B...limits%2C%5Bkey%5D%3Alimits%5Bkey%5D-1%7D%7D%29%29%3B%0A%20%20%20%20%20%20for%28const%20value%20of%20%5BNaN%2CInfinity%2C-Infinity%5D%29assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28certificate%2Cblob%2C%7Brevision%3Afixture.revision%2Cpath%3Afixture.path%2Climits%3A%7B...limits%2C%5Bkey%5D%3Avalue%7D%7D%29%29%3B%0A%20%20%20%20%7D%0A%20%20%7Dfinally%7BrmSync%28fixture.repository%2C%7Brecursive%3Atrue%2Cforce%3Atrue%7D%29%3B%7D%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
