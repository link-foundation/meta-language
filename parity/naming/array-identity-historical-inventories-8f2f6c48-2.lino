ision%2C...policy.sourceOwner.predecessor%7D%29%3B%0A%20%20const%20source%3DderiveOwnCodebaseRawDescriptorSource%28policy.sourceOwner%2Cpacket.sourceOwner.sourceText%29%3B%0A%20%20assert.equal%28source%2CrestoreCurrentOwnCodebaseRawSource%28readFileSync%28new%20URL%28policy.sourceFile%2Croot%29%2C%27utf8%27%29%2Cpolicy.sourceFile%29%29%3Bassert.deepEqual%28pin%28source%29%2Cpolicy.sourceOwner.current%29%3B%0A%20%20for%28const%20%5Bindex%2Crow%5Dof%20packet.adapters.entries%28%29%29assert.equal%28deriveOwnCodebaseRawDescriptorSource%28policy.adapters%5Bindex%5D%2Crow.sourceText%29%2CreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20const%20artifact%3DreadProjectData%28new%20URL%28packet.artifact.file%2Croot%29%29%2Cregister%3DreadProjectData%28new%20URL%28packet.register.file%2Croot%29%29%3B%0A%20%20const%20before%3DserializeProjectData%28artifact%2Cpacket.artifact.file%29%2Crestored%3DrestoreOwnCodebaseRawDescriptorEdge%28artifact%2C%27raw%20consuming%27%2Cregister%29%3B%0A%20%20assert.equal%28serializeProjectData%28restored.artifact%2Cpacket.artifact.file%29%2Cpacket.artifact.sourceText%29%3B%0A%20%20assert.equal%28serializeProjectData%28restored.register%2Cpacket.register.file%29%2Cpacket.register.sourceText%29%3B%0A%20%20assert.equal%28serializeProjectData%28artifact%2Cpacket.artifact.file%29%2Cbefore%2C%27the%20caller%20graph%20is%20unchanged%27%29%3B%0A%20%20for%28const%20field%20of%20%5B%27completeRust%27%2C%27owners%27%2C%27declarationNames%27%2C%27totals%27%2C%27assumptions%27%2C%27encodings%27%2C%27mappings%27%2C%27preludeHashes%27%2C%27replays%27%2C%27archive%27%5D%29assert.deepEqual%28artifact%5Bfield%5D%2Crestored.artifact%5Bfield%5D%2Cfield%29%3B%0A%20%20const%20loan%3DrestoreCurrentOwnCodebaseRawData%28readProjectData%28new%20URL%28packet.loan.file%2Croot%29%29%2Cpacket.loan.file%29%3Bassert.deepEqual%28%7Bbytes%3Aloan.predecessor.bytes%2Csha256%3Aloan.predecessor.sha256%7D%2Cpacket.edge.current%29%3B%0A%20%20assert.equal%28serializeProjectData%28restoreOwnCodebaseRawDescriptorData%28loan%2Cpacket.loan.file%29%2Cpacket.loan.file%29%2Cpacket.loan.sourceText%29%3B%0A%20%20for%28const%20row%20of%20%5Bpacket.artifact%2Cpacket.register%2Cpacket.loan%5D%29assert.equal%28restoreOwnCodebaseRawDescriptorText%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.file%29%2Crow.sourceText%29%3B%0A%20%20assert.doesNotThrow%28%28%29%3D%3ErestoreCompleteDeclarationReceipt%28artifact%2C%27raw%20consuming%27%2C%7Bregister%7D%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27changed%20descriptor%20owners%20current%20source%20pins%20registers%20and%20complete%20artifacts%20cannot%20acquire%20historical%20authority%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DreadOwnCodebaseRawDescriptorPacket%28%29%2Cartifact%3DreadProjectData%28new%20URL%28packet.artifact.file%2Croot%29%29%2Cregister%3DreadProjectData%28new%20URL%28packet.register.file%2Croot%29%29%3B%0A%20%20for%28const%20mutate%20of%20%5Bvalue%3D%3E%7Bvalue.extra%3D%27unknown%27%3B%7D%2Cvalue%3D%3E%7Bvalue.ownCodebaseRawSourceDescriptorSuccessors%5B0%5D.changes.reverse%28%29%3B%7D%2Cvalue%3D%3E%7Bvalue.ownCodebaseRawSourceDescriptorSuccessors%5B0%5D.current.sha256%3D%270%27.repeat%2864%29%3B%7D%5D%29%7B%0A%20%20%20%20const%20changed%3DstructuredClone%28register%29%3Bmutate%28changed%29%3Bassert.throws%28%28%29%3D%3ErestoreOwnCodebaseRawDescriptorEdge%28artifact%2C%27raw%20consuming%27%2Cchanged%29%29%3B%0A%20%20%7D%0A%20%20for%28const%20mutate%20of%20%5Bvalue%3D%3E%7Bvalue.sourceOwner.sourceText%2B%3D%27%20%27%3B%7D%2Cvalue%3D%3E%7Bvalue.sourceOwner.current.sha256%3D%270%27.repeat%2864%29%3B%7D%2Cvalue%3D%3E%7Bvalue.artifact.sourceText%2B%3D%27%20%27%3B%7D%2Cvalue%3D%3E%7Bvalue.adapters%5B0%5D.edits%5B0%5D.previousText%2B%3D%27%20%27%3B%7D%5D%29%7B%0A%20%20%20%20const%20changed%3DstructuredClone%28packet%29%3Bmutate%28changed%29%3Bassert.throws%28%28%29%3D%3EverifyOwnCodebaseRawDescriptorPacket%28changed%29%29%3B%0A%20%20%7D%0A%20%20const%20changed%3DstructuredClone%28artifact%29%3Bchanged.completeRust%2B%3D%27%20unknown%27%3B%0A%20%20assert.equal%28restoreOwnCodebaseRawDescriptorEdge%28changed%2C%27raw%20consuming%27%2Cregister%29.artifact%2Cchanged%2C%27unknown%20payload%20stays%20visible%20to%20the%20strict%20original%20gate%27%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErestoreCompleteDeclarationReceipt%28changed%2C%27raw%20consuming%27%2C%7Bregister%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErestoreOwnCodebaseRawDescriptorText%28readFileSync%28new%20URL%28packet.artifact.file%2Croot%29%2C%27utf8%27%29%2B%27%20%27%2Cpacket.artifact.file%29%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
