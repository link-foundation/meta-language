%20items%3DreadRustLibraryItems%28artifact.completeRust%29.items%3B%0A%20%20for%28const%20owner%20of%20artifact.owners%29%20%7B%0A%20%20%20%20const%20candidates%3Ditems.filter%28item%3D%3Eitem.name%3D%3D%3Downer.consuming.target%29%3B%0A%20%20%20%20assert.equal%28candidates.length%2C1%2C%27every%20stored%20owner%20has%20one%20actual%20complete%20definition%27%29%3B%0A%20%20%20%20const%20actual%3DreadOriginalLinkRawConsumingOwnerSites%28candidates%5B0%5D.source%29%3B%0A%20%20%20%20assert.deepEqual%28owner.copy.header%2Cowner.consuming.header%2C%27the%20stored%20successor%20keeps%20the%20original%20complete%20ABI%27%29%3B%0A%20%20%20%20assert.deepEqual%28actual.header%2Cowner.consuming.header%29%3B%0A%20%20%20%20for%28const%20field%20of%20%5B%27cloneSites%27%2C%27appendSites%27%2C%27consumingAppendBindingSites%27%5D%29assert.equal%28actual%5Bfield%5D.length%2Cowner.consuming%5Bfield%5D.length%2C%0A%20%20%20%20%20%20%27stored%20token-site%20counts%20agree%20with%20the%20actual%20complete%20definition%27%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28artifact.totals%2C%7Bcopy%3Atotals%28artifact.owners.map%28owner%3D%3Eowner.copy%29%29%2C%0A%20%20%20%20consuming%3Atotals%28artifact.owners.map%28owner%3D%3Eowner.consuming%29%29%7D%29%3B%0A%20%20assert.equal%28artifact.replays.length%2C2%29%3B%0A%20%20assert.deepEqual%28artifact.replays.map%28row%3D%3Erow.format%29%2C%5B%27text%27%2C%27binary%27%5D%29%3B%0A%20%20assert.equal%28artifact.archive.binaryLimits.recordLimit%2Cartifact.archive.recordCount%29%3B%0A%20%20assert.ok%28artifact.archive.recordCount%3E0%26%26artifact.archive.recordCount%3C%3DmaximumRecords%29%3B%0A%20%20assert.equal%28artifact.archive.maximumRecords%2CmaximumRecords%29%3B%0A%20%20assert.equal%28artifact.archive.binaryLimits.byteLimit%2CmaximumArchiveBytes%29%3B%0A%20%20assert.ok%28artifact.archive.textBytes%3C%3DmaximumArchiveBytes%26%26artifact.archive.binaryBytes%3C%3DmaximumArchiveBytes%29%3B%0A%20%20for%28const%20replay%20of%20artifact.replays%29%20%