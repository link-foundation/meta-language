(5234: (meta: (t: semantic) (n: 1) (term: string%20value) (def: export%20function%20verifyOriginalLinkRawConsumingConservation%28artifact%2Cread%3DreadFileSync%29%20%7B%0A%20%20const%20successor%3DORIGINAL_LINK_RAW_CONSUMING_SUCCESSOR%2C%20originalBytes%3Dread%28ORIGINAL_LINK_RAW_CONSUMING_HISTORICAL_ARTIFACT%29%3B%0A%20%20assert.equal%28originalBytes.length%2Csuccessor.original.bytes%2C%27the%20original%20consuming%20artifact%20byte%20count%20is%20immutable%27%29%3B%0A%20%20assert.equal%28sha256%28originalBytes%29%2Csuccessor.original.sha256%2C%27the%20complete%20original%20consuming%20artifact%20is%20immutable%27%29%3B%0A%20%20const%20original%3DreadStructuredDataLino%28originalBytes.toString%28%27utf8%27%29%29%3B%0A%20%20assert.deepEqual%28artifact.predecessorConservation%2Csuccessor%2C%27the%20explicit%20consuming%20successor%20provenance%20is%20exact%27%29%3B%0A%20%20assert.deepEqual%28artifact.decisionSources%2CdecisionSources%28read%29%2C%27actual%20final-use%20decision%20sources%20changed%27%29%3B%0A%20%20assert.deepEqual%28original.decisionSources.map%28row%3D%3Erow.file%29%2CdecisionFiles%2C%27the%20original%20decision-source%20inventory%20stays%20complete%27%29%3B%0A%20%20assert.equal%28Object.hasOwn%28original%2C%27predecessorConservation%27%29%2Cfalse%29%3B%0A%20%20const%20inverse%3DstructuredClone%28artifact%29%3B%0A%20%20delete%20inverse.predecessorConservation%3B%0A%20%20inverse.decisionSources%3DstructuredClone%28original.decisionSources%29%3B%0A%20%20const%20refresh%3Dsuccessor.receiptRefresh%2C%20applicability%3Dinverse.predecessor.proof.producerApplicability%3B%0A%20%20const%20originalApplicability%3Doriginal.predecessor.proof.producerApplicability%3B%0A%20%20assert.equal%28Object.hasOwn%28originalApplicability%2C%27receiptRefresh%27%29%2Cfalse%29%3B%0A%20%20assert.deepEqual%28applicability.receiptRefresh%2Crefresh%2C%27the%20exact%20predecessor%20receipt%20refresh%20remains%20reachable%27%29%3B%0A%20%20delete%20applicability.receiptRefresh%3B%0A%20%20const%20positions%3Dapplicability.sources.flatMap%28%28row%2Cindex%29%3D%3Erow.file%3D%3D%3Drefresh.current.file%3F%5Bindex%5D%3A%5B%5D%29%3B%0A%20%20const%20originalPositions%3DoriginalApplicability.sources.flatMap%28%28row%2Cindex%29%3D%3Erow.file%3D%3D%3Drefresh.previous.file%3F%5Bindex%5D%3A%5B%5D%29%3B%0A%20%20assert.equal%28positions.length%2C1%2C%27only%20one%20exact%20predecessor%20artifact%20descriptor%20is%20replaced%27%29%3B%0A%20%20assert.deepEqual%28positions%2CoriginalPositions%2C%27the%20predecessor%20artifact%20descriptor%20retains%20its%20original%20position%27%29%3B%0A%20%20assert.deepEqual%28applicability.sources%5Bpositions%5B0%5D%5D%2Crefresh.current%29%3B%0A%20%20assert.deepEqual%28originalApplicability.sources%5Bpositions%5B0%5D%5D%2Crefresh.previous%29%3B%0A%20%20applicability.sources%5Bpositions%5B0%5D%5D%3DstructuredClone%28refresh.previous%29%3B%0A%20%20const%20fields%3Dnew%20Set%28%29%3B%0A%20%20for%28const%20change%20of%20successor.archiveChanges%29%20%7B%0A%20%20%20%20assert.ok%28%5B%27textSha256%27%2C%27binarySha256%27%5D.includes%28change.field%29%26%26%21fields.has%28change.field%29%2C%0A%20%20%20%20%20%20%27only%20distinct%20reviewed%20complete%20archive%20digest%20changes%20are%20admitted%27%29%3B%0A%20%20%20%20fields.add%28change.field%29%3B%0A%20%20%20%20assert.match%28change.before%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3Bassert.match%28change.after%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3B%0A%20%20%20%20assert.notEqual%28change.before%2Cchange.after%29%3B%0A%20%20%20%20assert.equal%28original.archive%5Bchange.field%5D%2Cchange.before%29%3B%0A%20%20%20%20assert.equal%28inverse.archive%5Bchange.field%5D%2Cchange.after%29%3B%0A%20%20%20%20inverse.archive%5Bchange.field%5D%3Dchange.before%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28inverse.archive%2Coriginal.archive%2C%27unreviewed%20archive%20differences%20require%20exact%20recorded%20digest%20changes%27%29%3B%0A%20%20const%20inverseBytes%3DBuffer.from%28structuredDataToLino%28inverse%29%29%3B%0A%20%20assert.equal%28inverseBytes.length%2Csuccessor.original.bytes%2C%27the%20complete%20inverse%20byte%20count%20remains%20exact%27%29%3B%0A%20%20assert.equal%28sha256%28inverseBytes%29%2Csuccessor.original.sha256%2C%27only%20the%20recorded%20consuming%20provenance%20changes%20are%20permitted%27%29%3B%0A%20%20assert.deepEqual%28inverse%2Coriginal%2C%27every%20original%20consuming%20artifact%20field%20and%20owner%20remains%20exact%27%29%3B%0A%20%20assert.deepEqual%28inverseBytes%2CoriginalBytes%2C%0A%20%20%20%20%27the%20complete%20canonical%20original%20artifact%20bytes%20are%20restored%2C%20including%20every%20owner%20and%20archive%20field%27%29%3B%0A%20%20return%20successor%3B%0A%7D) (lang: meta-language%20structured%20data)))
