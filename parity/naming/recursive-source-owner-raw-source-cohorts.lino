am%29.text%29%2C%0A%20%20%20%20declarationNames%3A%5B...predecessor.declarationNames%5D%2Cowners%2Ctotals%3AobservedTotals%2C%0A%20%20%20%20assumptions%3Aemitted.assumptions%2Cencodings%3Aemitted.encodings%2Cmappings%3Aemitted.mappings%2C%0A%20%20%20%20preludeHashes%3Aemitted.preludes.map%28source%3D%3E%28%7Bbytes%3ABuffer.byteLength%28source%29%2Csha256%3Asha256%28source%29%7D%29%29%2C%0A%20%20%20%20archive%3A%7Broot%3Apacket.root.asU64%28%29.toString%28%29%2CrecordCount%2CmaximumRecords%2CbinaryLimits%2C%0A%20%20%20%20%20%20textBytes%3ABuffer.byteLength%28text%29%2CtextSha256%3Asha256%28text%29%2CbinaryBytes%3Abinary.byteLength%2CbinarySha256%3Asha256%28binary%29%7D%2C%0A%20%20%20%20replays%2CsourceBytes%3ABuffer.byteLength%28emitted.text%29%2CsourceSha256%3Asha256%28emitted.text%29%2CcompleteRust%3Aemitted.text%2C%0A%20%20%20%20nativeCompilation%3Afalse%2CnativeExecution%3Afalse%2C%0A%20%20%20%20boundary%3A%27Whole%20checked%20source%2C%20all106owners%20and%20both%20complete%20source-free%20typed%20archives.%20Tokenized%20clone%2Fappend%20sites%20observe%20emitted%20syntax%20only%3B%20the%20existing%20emitter%20performs%20its%20actual%20checked%20final-use%20decisions.%20No%20internal%20proof-node%20inventory%2C%20native%20timing%20or%20completion%20claim.%27%7D%3B%0A%20%20if%28check%29checkProjectData%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%2Cartifact%29%3B%0A%20%20return%20%7Bartifact%2Crust%3Aemitted%2Cprofile%3A%7Bprofile%3A%27consuming%27%2CsourceBytes%3Aartifact.sourceBytes%2CsourceSha256%3Aartifact.sourceSha256%2C%0A%20%20%20%20historicalSourceSha256%3Apredecessor.historicalSourceSha256%2CcurrentSourceSha256%3Apredecessor.currentSourceSha256%2C%0A%20%20%20%20sourceArtifact%2CdeclarationNames%3Aartifact.declarationNames%2CdefinitionCount%3A106%2C%0A%20%20%20%20proof%3A%7BartifactSha256%3Asha256%28structuredDataToLino%28artifact%29%29%2Cpredecessor%2CdecisionSources%3Aartifact.decisionSources%2C%0A%20%20%20%20%20%20options%3Aartifact.options%2Carchive%3Aartif