qual%28sites.appendSites.length%2C0%29%3B%0A%20%20assert.equal%28source.slice%28sites.cloneSites%5B0%5D%2Csites.cloneSites%5B0%5D%2B5%29%2C%27clone%27%29%3B%0A%20%20assert.deepEqual%28sites.header%2C%5B%27pub%27%2C%27fn%27%2C%27selected%27%2C%27%28%27%2C%27values%27%2C%27%3A%27%2C%27Vec%27%2C%27%3C%27%2C%27f64%27%2C%27%3E%27%2C%27%29%27%2C%27-%3E%27%2C%27Vec%27%2C%27%3C%27%2C%27f64%27%2C%27%3E%27%5D%29%3B%0A%20%20assert.throws%28%28%29%3D%3EreadOriginalLinkRawConsumingOwnerSites%28source%2B%27%5Cn%27%2Bsource%29%2C%2Fone%20complete%2Fu%29%3B%0A%7D%29%3B%0A%0Atest%28%27raw%20consuming%20emission%20keeps%20all106owners%20and%20both%20complete%20typed%20archives%20without%20changing%20either%20predecessor%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20historical%3DreadFileSync%28ORIGINAL_LINK_RAW_HISTORICAL_ARTIFACT%29%2C%20current%3DreadFileSync%28ORIGINAL_LINK_RAW_CURRENT_ARTIFACT%29%3B%0A%20%20const%20%7Bartifact%2Cprofile%7D%3Dawait%20generation%28%29%3B%0A%20%20assert.deepEqual%28readFileSync%28ORIGINAL_LINK_RAW_HISTORICAL_ARTIFACT%29%2Chistorical%29%3B%0A%20%20assert.deepEqual%28readFileSync%28ORIGINAL_LINK_RAW_CURRENT_ARTIFACT%29%2Ccurrent%29%3B%0A%20%20assert.equal%28sha256%28historical%29%2CORIGINAL_LINK_RAW_EMISSION_BASELINE.artifactSha256%29%3B%0A%20%20assert.equal%28sha256%28readProjectData%28ORIGINAL_LINK_RAW_CURRENT_ARTIFACT%29.completeRust%29%2CORIGINAL_LINK_RAW_EMISSION_BASELINE.currentSha256%29%3B%0A%20%20assert.equal%28artifact.definitionCount%2C106%29%3Bassert.equal%28artifact.owners.length%2C106%29%3B%0A%20%20assert.deepEqual%28artifact.owners.map%28owner%3D%3Eowner.fullName%29%2Cartifact.declarationNames%29%3B%0A%20%20assert.deepEqual%28artifact.declarationNames%2CreadProjectData%28ORIGINAL_LINK_RAW_CURRENT_ARTIFACT%29.declarationNames%29%3B%0A%20%20assert.deepEqual%28artifact.options%2C%7BarrayConsumption%3Atrue%7D%29%3B%0A%20%20assert.deepEqual%28artifact.totals%2C%7Bcopy%3A%7BcloneCalls%3A1004%2CappendCalls%3A31%2CconsumingAppendBindings%3A0%7D%2C%0A%20%20%20%20consuming%3A%7BcloneCalls%3A742%2CappendCalls%3A31%2CconsumingAppendBindings%3A25%7D%7D%29%3B%0A%20%20assert.equal%28artifact.sourceBytes%2C351559%29%3B%0A%20%20assert.equal%28artifact.sourceSha256%2C%27b0820a709afb3c66fc88321ceaa84e00baa795b0f07290896db6d00c740d9c7c%27%29%3B%0A%20%20for%28const%20owner%20of%20artifact.owners%29assert.deepEqual%28owner.consuming.header%2Cowner.copy.header%29%3B%0A%20%20assert.deepEqual%28artifact.replays.map%28row%3D%3Erow.format%29%2C%5B%27text%27%2C%27binary%27%5D%29%3B%0A%20%20for%28const%20replay%20of%20artifact.replays%29%7Bassert.equal%28replay.ownerCount%2C106%29%3Bassert.equal%28replay.emittedSha256%2Cartifact.sourceSha256%29%3Bassert.equal%28replay.emittedBytes%2Cartifact.sourceBytes%29%3B%7D%0A%20%20assert.equal%28artifact.archive.binaryLimits.recordLimit%2Cartifact.archive.recordCount%29%3B%0A%20%20assert.ok%28artifact.archive.recordCount%3E0%26%26artifact.archive.recordCount%3C%3D1_000_000%29%3B%0A%20%20assert.equal%28artifact.archive.binaryLimits.byteLimit%2C64%2A1024%2A1024%29%3B%0A%20%20assert.equal%28artifact.nativeCompilation%2Cfalse%29%3Bassert.equal%28artifact.nativeExecution%2Cfalse%29%3B%0A%20%20assert.deepEqual%28readOriginalLinkRawConsumingProfile%28artifact.predecessor%29%2Cprofile%29%3B%0A%20%20assert.equal%28profile.proof.artifactSha256%2Csha256%28readFileSync%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%29%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27raw%20consuming%20stored%20profiles%20refuse%20altered%20source%20decisions%20owners%20sites%20options%20and%20archive%20obligations%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20%7Bartifact%7D%3Dawait%20generation%28%29%3B%0A%20%20const%20read%3Dchanged%3D%3Efile%3D%3EString%28file%29%3D%3D%3DString%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%29%0A%20%20%20%20%3FBuffer.from%28structuredDataToLino%28changed%29%29%3AreadFileSync%28file%29%3B%0A%20%20for%28const%20mutate%20of%20%5B%0A%20%20%20%20row%3D%3E%7Brow.options.arrayConsumption%3Dfalse%3B%7D%2C%0A%20%20%20%20row%3D%