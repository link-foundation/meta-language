A%20%20%20%20if%28token.kind%20%3D%3D%3D%20%27identifier%27%20%26%26%20token.value%20%3D%3D%3D%20%27ml_append_left%27%0A%20%20%20%20%20%20%26%26%20tokens%5Bat-1%5D%3F.value%20%3D%3D%3D%20%27%2C%27%20%26%26%20tokens%5Bat%2B1%5D%3F.value%20%3D%3D%3D%20%27%29%27%29%20consumingAppendBindings.push%28token.start%29%3B%0A%20%20%7D%0A%20%20return%20%7Btarget%3Aowner.name%2Ckind%3Aowner.kind%2Cheader%3Awords%28tokens.slice%280%2Cbody%29%29%2Cbytes%3ABuffer.byteLength%28source%29%2C%0A%20%20%20%20sha256%3Asha256%28source%29%2CcloneSites%3Aclones%2CappendSites%3Aappends%2CconsumingAppendBindingSites%3AconsumingAppendBindings%7D%3B%0A%7D%0A%0Afunction%20consumingOwners%28emitted%2Cinventory%29%20%7B%0A%20%20assert.equal%28emitted.definitions.length%2Cinventory.length%29%3B%0A%20%20return%20inventory.map%28%28owner%2Cindex%29%20%3D%3E%20%7B%0A%20%20%20%20const%20mappings%20%3D%20emitted.mappings.filter%28mapping%20%3D%3E%20mapping.source%20%3D%3D%3D%20owner.fullName%0A%20%20%20%20%20%20%26%26%20mapping.kind%20%3D%3D%3D%20%28owner.kind%20%3D%3D%3D%20%27fn%27%20%3F%20%27function%27%20%3A%20owner.kind%29%29%3B%0A%20%20%20%20assert.equal%28mappings.length%2C1%2C%27one%20complete%20emitted%20source%20mapping%3A%20%27%2Bowner.fullName%29%3B%0A%20%20%20%20const%20sites%20%3D%20readOriginalLinkRawConsumingOwnerSites%28emitted.definitions%5Bindex%5D%29%3B%0A%20%20%20%20assert.equal%28sites.target%2Cmappings%5B0%5D.target%2C%27the%20actual%20definition%20order%20follows%20the%20checked%20owner%20order%27%29%3B%0A%20%20%20%20assert.equal%28sites.kind%2Cowner.kind%20%3D%3D%3D%20%27fn%27%20%3F%20%27fn%27%20%3A%20%27enum%27%29%3B%0A%20%20%20%20return%20sites%3B%0A%20%20%7D%29%3B%0A%7D%0Aconst%20totals%20%3D%20owners%20%3D%3E%20%28%7BcloneCalls%3Aowners.reduce%28%28sum%2Cowner%29%3D%3Esum%2Bowner.cloneSites.length%2C0%29%2C%0A%20%20appendCalls%3Aowners.reduce%28%28sum%2Cowner%29%3D%3Esum%2Bowner.appendSites.length%2C0%29%2C%0A%20%20consumingAppendBindings%3Aowners.reduce%28%28sum%2Cowner%29%3D%3Esum%2Bowner.consumingAppendBindingSites.length%2C0%29%7D%29%3B%0A%0A%2F%2A%2A%20Restore%20only%20the%20recorded%20provenance%20changes%20and%20authenticate%20the%20entire%20original%20artifact.%20%2A%2F%0Aexport%20function%20verifyOriginalLinkRawConsumingConservation%28artifact%2Cread%3DreadFileSync%29%20%7B%0A%20%20const%20successor%3DORIGINAL_LINK_RAW_CONSUMING_SUCCESSOR%2C%20originalBytes%3Dread%28ORIGINAL_LINK_RAW_CONSUMING_HISTORICAL_ARTIFACT%29%3B%0A%20%20assert.equal%28originalBytes.length%2Csuccessor.original.bytes%2C%27the%20original%20consuming%20artifact%20byte%20count%20is%20immutable%27%29%3B%0A%20%20assert.equal%28sha256%28originalBytes%29%2Csuccessor.original.sha256%2C%27the%20complete%20original%20consuming%20artifact%20is%20immutable%27%29%3B%0A%20%20const%20original%3DreadStructuredDataLino%28originalBytes.toString%28%27utf8%27%29%29%3B%0A%20%20assert.deepEqual%28artifact.predecessorConservation%2Csuccessor%2C%27the%20explicit%20consuming%20successor%20provenance%20is%20exact%27%29%3B%0A%20%20assert.deepEqual%28artifact.decisionSources%2CdecisionSources%28read%29%2C%27actual%20final-use%20decision%20sources%20changed%27%29%3B%0A%20%20assert.deepEqual%28original.decisionSources.map%28row%3D%3Erow.file%29%2CdecisionFiles%2C%27the%20original%20decision-source%20inventory%20stays%20complete%27%29%3B%0A%20%20assert.equal%28Object.hasOwn%28original%2C%27predecessorConservation%27%29%2Cfalse%29%3B%0A%20%20const%20inverse%3DstructuredClone%28artifact%29%3B%0A%20%20delete%20inverse.predecessorConservation%3B%0A%20%20inverse.decisionSources%3DstructuredClone%28original.decisionSources%29%3B%0A%20%20const%20refresh%3Dsuccessor.receiptRefresh%2C%20applicability%3Dinverse.predecessor.proof.producerApplicability%3B%0A%20%20const%20originalApplicability%3Doriginal.predecessor.proof.producerApplicability%3B%0A%20%20assert.equal%28Object.hasOwn%28originalApplicability%2C%27receiptRefresh%27%29%2Cfalse%29%3B%0A%20%20assert.deepEqual%28applicability.receiptRefresh%2Crefresh%2C%27the%20exact%20predecessor%20receipt%20refresh%20remains%20reachable%27%29%3B%0A%20%20delete%20applicability.receiptRefresh%3B%0A%20%20const%20positions%3Dapplicability.sources.flatMap%28%28row%2Cindex%29%3D%3Erow.file%3D%3D%3Drefresh.current.file%3F%5Bindex%5D%3A%5B%5D%29%3B%0A%20%20const%20originalPositions%3DoriginalApplicability.sources.flatMap%28%28row%2Cindex%29%3D%3Erow.file%3D%3D%3Drefresh.previous.file%3F%5Bindex%5D%3A%5B%5D%29%3B%0A%20%20assert.equal%28positions.length%2C1%2C%27only%20one%20exact%20predecessor%20artifact%20descriptor%20is%20replaced%27%29%3B%0A%20%20assert.deepEqual%28positions%2CoriginalPositions%2C%27the%20predecessor%20artifact%20descriptor%20retains%20its%20original%20position%27%29%3B%0A%20%20assert.deepEqual%28applicability.sources%5Bpositions%5B0%5D%5D%2Crefresh.current%29%3B%0A%20%20assert.deepEqual%28originalApplicability.sources%5Bpositions%5B0%5D%5D%2Crefresh.previous%29%3B%0A%20%20applicability.sources%5Bpositions%5B0%5D%5D%3DstructuredClone%28refresh.previous%29%3B%0A%20%20const%20fields%3Dnew%20Set%28%29%3B%0A%20%20for%28const%20change%20of%20successor.archiveChanges%29%20%7B%0A%20%20%20%20assert.ok%28%5B%27textSha256%27%2C%27binarySha256%27%5D.includes%28change.field%29%26%26%21fields.has%28change.field%29%2C%0A%20%20%20%20%20%20%27only%20distinct%20reviewed%20complete%20archive%20digest%20changes%20are%20admitted%27%29%3B%0A%20%20%20%20fields.add%28change.field%29%3B%0A%20%20%20%20assert.match%28change.before%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3Bassert.match%28change.after%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3B%0A%20%20%20%20assert.notEqual%28change.before%2Cchange.after%29%3B%0A%20%20%20%20assert.equal%28original.archive%5Bchange.field%5D%2Cchange.before%29%3B%0A%20%20%20%20assert.equal%28inverse.archive%5Bchange.field%5D%2Cchange.after%29%3B%0A%20%20%20%20inverse.archive%5Bchange.field%5D%3Dchange.before%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28inverse.archive%2Coriginal.archive%2C%27unreviewed%20ar