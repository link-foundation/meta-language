ittedOwners%5Bindex%5D.header%2CcopyOwners%5Bindex%5D.header%2C%27unchanged%20complete%20owner%20ABI%3A%20%27%2Bowner.fullName%29%3B%0A%20%20%20%20return%20%7B...owner%2Ccopy%3AcopyOwners%5Bindex%5D%2Cconsuming%3AemittedOwners%5Bindex%5D%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20observedTotals%20%3D%20%7Bcopy%3Atotals%28copyOwners%29%2Cconsuming%3Atotals%28emittedOwners%29%7D%3B%0A%20%20assert.ok%28observedTotals.consuming.cloneCalls%20%3C%20observedTotals.copy.cloneCalls%2C%0A%20%20%20%20%27the%20selected%20option%20removes%20actual%20clone%20calls%20rather%20than%20only%20declaring%20a%20profile%27%29%3B%0A%20%20assert.equal%28observedTotals.consuming.appendCalls%2CobservedTotals.copy.appendCalls%29%3B%0A%20%20const%20%7BencodeTypedProgramLinks%2CdecodeTypedProgramLinks%7D%20%3D%20await%20import%28%27..%2F..%2Fjs%2Fsrc%2Ftyped-program-links.js%27%29%3B%0A%20%20const%20%7BrecheckLinkedTypedProgram%7D%20%3D%20await%20import%28%27..%2F..%2Fjs%2Fsrc%2Ftyped-program-checked-projection.js%27%29%3B%0A%20%20const%20%7BLinkNetwork%7D%20%3D%20await%20import%28%27..%2F..%2Fjs%2Fsrc%2Fnetwork.js%27%29%3B%0A%20%20const%20%7BencodeLinkNetworkBinary%2CdecodeLinkNetworkBinary%7D%20%3D%20await%20import%28%27..%2F..%2Fjs%2Fsrc%2Flink-network-binary.js%27%29%3B%0A%20%20const%20packet%20%3D%20encodeTypedProgramLinks%28program%29%2C%20recordCount%20%3D%20packet.network.links%28%29.length%3B%0A%20%20assert.ok%28Number.isSafeInteger%28recordCount%29%26%26recordCount%3E0%26%26recordCount%3C%3DmaximumRecords%29%3B%0A%20%20const%20binaryLimits%20%3D%20%7BrecordLimit%3ArecordCount%2CbyteLimit%3AmaximumArchiveBytes%7D%3B%0A%20%20const%20text%20%3D%20packet.network.toLino%28%29%3Bassert.ok%28Buffer.byteLength%28text%29%3C%3DmaximumArchiveBytes%29%3B%0A%20%20const%20binary%20%3D%20encodeLinkNetworkBinary%28packet.network%2CbinaryLimits%29%3Bassert.ok%28binary.byteLength%3C%3DmaximumArchiveBytes%29%3B%0A%20%20const%20replays%20%3D%20%5B%5D%3B%0A%20%20for%28const%20format%20of%20%5B%27text%27%2C%2