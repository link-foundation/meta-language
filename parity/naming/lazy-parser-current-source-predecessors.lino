(30805: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20The%20native%20grammar%20executor%3A%20it%20interprets%20a%20loaded%20program%20%28load.js%29%20over%0A%2F%2F%20a%20byte%20string%20and%20builds%20the%20lossless%20concrete%20syntax%20tree.%20Generalized%0A%2F%2F%20matching%20keeps%20every%20result%20an%20expression%20can%20produce%2C%20deduplicated%20by%20end%0A%2F%2F%20offset%20and%20parser%20state%3B%20PEG%20matching%20keeps%20at%20most%20one.%20Rule%20calls%20are%0A%2F%2F%20memoized%2C%20left%20recursion%20grows%20a%20seed%20to%20a%20fixpoint%2C%20and%20the%20nesting%20depth%2C%0A%2F%2F%20the%20step%20count%2C%20the%20memo%20size%20and%20the%20memory%20a%20parse%20keeps%20are%20bounded%2C%20so%0A%2F%2F%20a%20hostile%20or%20a%20huge%20input%20ends%20in%20a%20rejection%20instead%20of%20a%20stack%20overflow%2C%0A%2F%2F%20a%20runaway%20parse%20or%20an%20exhausted%20heap.%20Automatic%0A%2F%2F%20recovery%20reruns%20a%20failed%20parse%20with%20repair%20points%2C%20where%20a%20failing%20element%0A%2F%2F%20becomes%20a%20MISSING%20leaf%20or%20skips%20to%20its%20next%20match%20behind%20an%20ERROR%20leaf.%0A%2F%2F%20docs%2Fgrammar%2Ffeature-union.md%23executor%20specifies%20every%20case%20below.%0Aimport%20%7B%0A%20%20evaluateCondition%2C%0A%20%20INITIAL_STATE%2C%0A%20%20OperationFailed%2C%0A%20%20runStatements%2C%0A%20%20settleState%2C%0A%20%20workingState%2C%0A%7D%20from%20%27.%2Foperations.js%27%3B%0Aimport%20%7B%20columnOf%2C%20decodeAt%2C%20encodeText%2C%20quoteText%2C%20textOf%2C%20utf16View%20%7D%20from%20%27.%2Ftext.js%27%3B%0Aimport%20%7B%20acceptFixedLexicalExpression%20%7D%20from%20%27.%2Flexical-cache.js%27%3B%0Aimport%20%7B%20releaseLexicalCaches%2C%20retainLexicalCache%20%7D%20from%20%27.%2Flexical-cache-memory.js%27%3B%0Aimport%20%7B%20packLexicalCacheResults%2C%20readLexicalCacheResults%2C%20packTriviaCacheResult%20%7D%20from%20%27.%2Fcache-storage.js%27%3B%0Aimport%20%7B%20PrefixReachCache%20%7D%20from%20%27.%2Fprefix-reach-cache.js%27%3B%0Aimport%20%7B%20RULE_MEMO_PAGE_WIDTH%2C%20retireCompletedRuleMemoPrefix%20%7D%20from%20%27.%2Frule-memo-window.js%27%3B%0Aimport%20%7B%20readRecursiveMemoSeed%2C%20rememberRecursiveMemoDependency%2C%20acceptRecursiveMemoEntry%2C%20reuseRecursiveMemoEntry%2C%20advanceRecursiveMemoSeed%2C%20finishRecursiveMemoSeed%2C%20storeRecursiveMemoEntry%20%7D%20from%20%27.%2Frecursive-seed-memo.js%27%3B%0Aimport%20%7B%20readTriviaPrefixPolicy%2C%20acceptTriviaExtraPrefix%20%7D%20from%20%27.%2Ftrivia-prefix-cache.js%27%3B%0Aimport%20%7B%20completeRuleContexts%20%7D%20from%20%27.%2Fprecedence-contexts.js%27%3B%0Aimport%20%7B%20acceptLexicalCacheContext%2C%20acceptLexicalCacheReservation%2C%20acceptPrecedenceOperandContext%2C%20acceptPrecedenceOperandHead%2C%20acceptScannerPreemptionBoundary%2C%20readLexicalWinnerIndex%2C%20readScannerContinuationAction%20%7D%20from%20%27..%2Ftranslation%2Ffrontend-rules.js%27%3B%0Aimport%20%7B%20lexerObligationsFor%20%7D%20from%20%27.%2Flexer-election.js%27%3B%0Aimport%20%7B%20acceptGrammarLexerMode%2C%20acceptGrammarLexerTrivia%2C%20acceptGrammarLexerExpectedToken%2C%20readGrammarLexerTriviaIdentity%20%7D%20from%20%27..%2Ftranslation%2Fgrammar-lexer-rules.js%27%3B%0Aimport%20%7B%20GrammarRuntimeError%20%7D%20from%20%27.%2Fload.js%27%3B%0Aimport%20%7B%20evaluateGrammarSelection%2C%20runEmbeddedGrammar%20%7D%20from%20%27.%2Fgrammar-selection.js%27%3B%0Aimport%20%7B%20sameGrammarOutput%2C%20sameGrammarTree%20%7D%20from%20%27.%2Ftree-equality.js%27%3B%0A%0A%2F%2A%2A%20Thrown%20when%20the%20rule%20nesting%20exceeds%20%60maxDepth%60%3B%20the%20driver%20turns%20it%20into%20an%20%60ERROR%60%20root.%20%2A%2F%0Aexport%20class%20NestingTooDeep%20extends%20Error%20%7B%7D%0A%0A%2F%2A%2A%20Thrown%20when%20a%20parse%20runs%20out%20of%20its%20step%20budget.%20%2A%2F%0Aexport%20class%20StepLimitReached%20extends%20Error%20%7B%7D%0A%0A%2F%2A%2A%20Thrown%20when%20a%20parse%20runs%20out%20of%20its%20memory%20budget%20%28see%20%60memoryBudget%60%29.%20%2A%2F%0Aexport%20class%20MemoryBudgetReached%20extends%20Error%20%7B%7D%0A%0Aexport%20const%20DEFAULT_MAX_DEPTH%20%3D%201000%3B%0Aconst%20DEFAULT_MEMO_LIMIT%20%3D%201_000_000%3B%0Aconst%20DEFAULT_MEMORY_LIMIT%20%3D%202_000_000%3B%0Aconst%20NO_CHILDREN%20%3D%20Object.freeze%28%5B%5D%29%3B%0A%2F%2F%20The%20text%20of%20an%20extra%20that%20is%20no%20extra%20where%20it%20starts%20%28see%20%60extraNode%60%29.%0Aconst%20NO_EXTRA%20%3D%20Object.freeze%28%7B%7D%29%3B%0A%2F%2F%20The%20verdict%20of%20the%20precedence%20filter%20on%20a%20result%20whose%20right%20operand%20is%20a%0A%2F%2F%20node%20of%20one%20part%3A%20valid%20unless%20a%20result%20ends%20before%20the%20operand%20%28see%0A%2F%2F%20%60lonePending%60%29.%0Aconst%20LONE%20%3D%20Symbol%28%27lone%20operand%27%29%3B%0A%0A%2F%2A%2A%0A%20%2A%20What%20a%20scanner%27s%20%60%28expected%20ITEM%29%60%20answers%3A%20whether%20the%20parse%20requested%20the%0A%20%2A%20item%2C%20a%20literal%20or%20a%20rule%2C%20at%20the%20scanner%27s%20context%20offset%2C%20as%20a%20tree-sitter%0A%20%2A%20scanner%20asks%20whether%20a%20token%20is%20valid%20in%20the%20parse%20state.%20The%20context%20of%20a%0A%20%2A%20token%20is%20the%20offset%20before%20the%20trivia%20its%20terminal%20skips%2C%20and%20of%20an%20extra%0A%20%2A%20the%20offset%20its%20trivia%20starts%20at.%20A%20request%20is%20recorded%20where%20the%20parse%0A%20%2A%20makes%20it%2C%20so%20one%20the%20scanner%20asks%20about%20before%20the%20parse%20made%20it%20was%0A%20%2A%20answered%20wrong%3A%20the%20parse%20is%20then%20%60stale%60%20and%20runs%20again%2C%20seeded%20with%20the%0A%20%2A%20requests%20so%20far.%20The%20requests%20only%20grow%2C%20so%20the%20runs%20end.%20One%20parse%2C%20its%0A%20%2A%20rounds%20and%20its%20embedded%20languages%20share%20one%20record%3B%20each%20item%20has%20a%0A%20%2A%20distinct%20id%20per%20program.%0A%20%2A%2F%0Aexport%20class%20Expectations%20%7B%0A%20%20constructor%28%29%20%7B%0A%20%20%20%20this.requested%20%3D%20new%20Map%28%29%3B%0A%20%20%20%20this.consulted%20%3D%20new%20Map%28%29%3B%0A%20%20%20%20this.stale%20%3D%20false%3B%0A%20%20%7D%0A%0A%20%20%2F%2A%2A%20Starts%20a%20run%20of%20the%20parse%2C%20keeping%20the%20requests.%20%2A%2F%0A%20%20restart%28%29%20%7B%0A%20%20%20%20this.consulted%20%3D%20new%20Map%28%29%3B%0A%20%20%20%20this.stale%20%3D%20false%3B%0A%20%20%20%20return%20this%3B%0A%20%20%7D%0A%0A%20%20request%28position%2C%20id%29%20%7B%0A%20%20%20%20let%20ids%20%3D%20this.requested.get%28position%29%3B%0A%20%20%20%20if%20%28%21ids%29%20this.requested.set%28position%2C%20ids%20%3D%20new%20Set%28%29%29%3B%0A%20%20%20%20if%20%28ids.has%28id%29%29%20return%3B%0A%20%20%20%20ids.add%28id%29%3B%0A%20%20%20%20if%20%28this.consulted.get%28position%29%3F.has%28id%29%29%20this.stale%20%3D%20true%3B%0A%20%20%7D%0A%0A%20%20holds%28position%2C%20id%29%20%7B%0A%20%20%20%20if%20%28this.requested.get%28position%29%3F.has%28id%29%29%20return%20true%3B%0A%20%20%20%20let%20ids%20%3D%20this.consulted.get%28position%29%3B%0A%20%20%20%20if%20%28%21ids%29%20this.consulted.set%28position%2C%20ids%20%3D%20new%20Set%28%29%29%3B%0A%20%20%20%20ids.add%28id%29%3B%0A%20%20%20%20return%20false%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20The%20step%20budget%20of%20one%20parse%2C%20shared%20with%20every%20embedded-language%20executor%3A%0A%20%2A%20by%20default%20twice%20as%20large%20with%20error%20recovery%2C%20whose%20rounds%20parse%20each%0A%20%2A%20repaired%20alternative%20too.%0A%20%2A%2F%0Aexport%20function%20stepBudget%28options%2C%20length%2C%20memory%20%3D%20memoryBudget%28options%29%29%20%7B%0A%20%20return%20%7B%20steps%3A%200%2C%20limit%3A%20options.stepLimit%20%3F%3F%20%28100_000%20%2B%201000%20%2A%20length%29%20%2A%20%28options.errorRecovery%20%3F%202%20%3A%201%29%2C%20memory%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20The%20memory%20budget%20of%20one%20parse%2C%20shared%20by%20its%20runs%2C%20its%20recovery%20rounds%20and%0A%20%2A%20its%20embedded%20languages%3A%20the%20memo%20cells%20it%20may%20make%2C%20one%20per%20rule%20call%20it%0A%20%2A%20records%2C%20one%20per%20fixed%20lexical%20match%20cached%2C%20and%20one%20per%20result%20each%20keeps%20%28%60memoryLimit%60%2C%20default%0A%20%2A%202000000%29.%20Rule%20cells%20stay%20counted%20until%20the%20parse%20ends%20%28the%20calls%20under%0A%20%2A%20keyword%20lexing%20outlive%20their%20run%29.%20Optional%20fixed%20lexical%20caches%20are%20cleared%0A%20%2A%20when%20memory%20is%20needed%2C%20releasing%20only%20the%20cells%20those%20discarded%20entries%20held.%0A%20%2A%20A%20parse%20whose%20rule%20cells%20need%20more%20is%20rejected%20with%20%60memoryBudget%60%20instead%20of%0A%20%2A%20growing%20until%20the%20process%20runs%20out%20of%20memory.%0A%20%2A%2F%0Aexport%20function%20memoryBudget%28options%29%20%7B%0A%20%20return%20%7B%20cells%3A%200%2C%20limit%3A%20options.memoryLimit%20%3F%3F%20DEFAULT_MEMORY_LIMIT%20%7D%3B%0A%7D%0A%0A%2F%2F%20The%20repair%20cost%20of%20a%20MISSING%20leaf%3B%20an%20ERROR%20leaf%20costs%20the%20bytes%20it%20skips.%0Aconst%20MISSING_COST%20%3D%202%3B%0A%0Afunction%20makeResult%28end%2C%20state%2C%20children%20%3D%20NO_CHILDREN%2C%20dynamic%20%3D%200%2C%20cost%20%3D%200%29%20%7B%0A%20%20return%20%7B%20end%2C%20state%2C%20children%2C%20dynamic%2C%20precedence%3A%20null%2C%20tail%3A%20null%2C%20ambiguous%3A%20false%2C%20cost%20%7D%3B%0A%7D%0A%0Afunction%20resultKey%28result%29%20%7B%0A%20%20return%20%60%24%7Bresult.end%7D%7C%24%7Bresult.state.key%7D%24%7Bresult.lexicalFamily%20%3D%3D%3D%20undefined%20%3F%20%27%27%20%3A%20%60%7Clexer%3A%24%7Bresult.lexicalFamily%7D%60%7D%60%3B%0A%7D%0A%0A%2F%2F%20The%20settling%20of%20a%20program%20loaded%20before%20grammars%20declared%20one%3A%20every%20step.%0Aconst%20ALL_SETTLING%20%3D%20Object.freeze%28%7B%20steps%3A%20Object.freeze%28%5B%27tokens%27%2C%20%27precedence%27%2C%20%27dynamic%27%2C%20%27ambiguity%27%5D%29%2C%20tokens%3A%20true%2C%20precedence%3A%20true%2C%20dynamic%3A%20true%2C%20ambiguity%3A%20true%20%7D%29%3B%0A%0A%2F%2F%20The%20order%20of%20two%20results%20of%20one%20text%20that%20end%20alike%20by%20the%20grammar%27s%0A%2F%2F%20settling%20steps%20%28see%20SETTLING_STEPS%29%3A%201%20when%20%60a%60%20is%20preferred%2C%20-1%20when%20%60b%60%0A%2F%2F%20is%2C%200%20on%20a%20tie.%20%60tokens%60%20holds%20the%20token%20ranks%2C%20the%20input%20bytes%20and%20the%0A%2F%2F%20precedence%20orders%20the%20%60tokens%60%20step%20%28the%20tokens%20a%20lexer%20prefers%2C%20as%20a%0A%2F%2F%20lexer%20decides%20them%20before%20any%20parse%20does%29%20and%20the%20%60precedence%60%20step%20%28the%0A%2F%2F%20shift%20or%20reduction%20an%20LR%20parser%20keeps%20by%20precedence%29%20read%3B%20%60dynamic%60%0A%2F%2F%20prefers%20the%20higher%20dynamic%20precedence.%0Afunction%20settledOrder%28a%2C%20b%2C%20settling%2C%20tokens%29%20%7B%0A%20%20for%20%28const%20step%20of%20settling.steps%29%20%7B%0A%20%20%20%20let%20order%20%3D%200%3B%0A%20%20%20%20if%20%28step%20%3D%3D%3D%20%27tokens%27%29%20order%20%3D%20tokens%20%3F%20preferredTokens%28a%2C%20b%2C%20tokens%29%20%3A%200%3B%0A%20%20%20%20else%20if%20%28step%20%3D%3D%3D%20%27precedence%27%29%20order%20%3D%20tokens%20%3F%20shiftOrder%28a%2C%20b%2C%20tokens.orders%2C%20tokens.grammar%2C%20tokens.bytes%2C%20tokens.owner%29%20%3A%200%3B%0A%20%20%20%20else%20if%20%28step%20%3D%3D%3D%20%27dynamic%27%29%20order%20%3D%20Math.sign%28a.dynamic%20-%20b.dynamic%29%3B%0A%20%20%20%20else%20break%3B%0A%20%20%20%20if%20%28order%20%21%3D%3D%200%29%20return%20order%3B%0A%20%20%7D%0A%20%20return%200%3B%0A%7D%0A%0A%2F%2F%20Adds%20a%20result%20to%20a%20deduplicating%20map%3A%20of%20two%20results%20with%20the%20same%20end%0A%2F%2F%20and%20state%2C%20the%20lower%20repair%20cost%20wins%2C%20then%20the%20one%20the%20grammar%27s%20settling%0A%2F%2F%20steps%20prefer%20%28see%20settledOrder%29%3B%20on%20a%20tie%20the%20first%20stays%20and%2C%20when%20the%0A%2F%2F%20settling%20ends%20in%20%60ambiguity%60%2C%20without%20repairs%20and%20unless%20both%20build%20the%0A%2F%2F%20same%20trees%2C%20is%20marked%20ambiguous%20%28as%20a%20co