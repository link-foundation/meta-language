%27UTF-16%20code%20units%27%29%3B%0A%20%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2CREQUIRED_FIELD_NATIVE_HOST_SOURCES.map%28row%3D%3Erow.file%29%29%3B%0A%20%20const%20frozenSources%3DreadFrozenNativeHostSources%28%29%3B%0A%20%20for%28const%5Bindex%2Crow%5Dof%20packet.sources.entries%28%29%29%7B%0A%20%20%20%20exactKeys%28row%2C%5B%27file%27%2C%27previous%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20%20%20exactKeys%28row.previous%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3BexactKeys%28row.current%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%5D%29%3B%0A%20%20%20%20assert.equal%28typeof%20row.previous.source%2C%27string%27%29%3Bassert.equal%28typeof%20row.current.source%2C%27string%27%29%3B%0A%20%20%20%20const%20original%3DBuffer.from%28row.previous.source%29%3Bassert.equal%28original.toString%28%27utf8%27%29%2Crow.previous.source%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.previous.certificate%2Coriginal%2C%7Brevision%3AREQUIRED_FIELD_NATIVE_HOST_REVISION%2Cpath%3Arow.file%7D%29%3B%0A%20%20%20%20assert.deepEqual%28pinRequiredFieldNativeHostSource%28original%29%2C%7Bbytes%3Arow.previous.bytes%2Csha256%3Arow.previous.sha256%7D%29%3B%0A%20%20%20%20assert.equal%28row.previous.source%2CfrozenSources.get%28row.file%29%2C%27the%20complete%20a8%20source%20equals%20the%20separately%20frozen%20historical%20reader%20input%27%29%3B%0A%20%20%20%20const%20replay%3DderiveRequiredFieldNativeHostSource%28row.previous.source%2Crow.current.source%2CREQUIRED_FIELD_NATIVE_HOST_SOURCES%5Bindex%5D%29%3B%0A%20%20%20%20assert.equal%28row.current.source%2Creplay.source%29%3Bassert.deepEqual%28row.edits%2Creplay.edits%29%3B%0A%20%20%20%20assert.equal%28replayRequiredFieldNativeHostIntervals%28row.previous.source%2Crow.edits%29%2Crow.current.source%29%3B%0A%20%20%20%20assert.deepEqual%28pinRequiredFieldNativeHostSource%28replay.source%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%20%20%20let%20