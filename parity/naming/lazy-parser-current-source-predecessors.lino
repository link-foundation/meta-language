t.keys%28second%29%3B%0A%20%20return%20keys.length%20%3D%3D%3D%20other.length%20%26%26%20keys.every%28%28key%2C%20index%29%20%3D%3E%20%28%21ordered%20%7C%7C%20key%20%3D%3D%3D%20other%5Bindex%5D%29%0A%20%20%20%20%26%26%20Object.hasOwn%28second%2C%20key%29%20%26%26%20sameGrammarMetadata%28first%5Bkey%5D%2C%20second%5Bkey%5D%2C%20ordered%29%29%3B%0A%7D%0A%0Afunction%20sameGrammarHeader%28first%2C%20second%2C%20fields%29%20%7B%0A%20%20return%20fields.every%28field%20%3D%3E%20%7B%0A%20%20%20%20if%20%28field%20%3D%3D%3D%20%27trivia%27%20%7C%7C%20field%20%3D%3D%3D%20%27projectionAnonymous%27%20%7C%7C%20field%20%3D%3D%3D%20%27literal%27%29%20return%20Boolean%28first%5Bfield%5D%29%20%3D%3D%3D%20Boolean%28second%5Bfield%5D%29%3B%0A%20%20%20%20if%20%28field%20%3D%3D%3D%20%27field%27%20%7C%7C%20field%20%3D%3D%3D%20%27language%27%20%7C%7C%20field%20%3D%3D%3D%20%27projectionName%27%29%20return%20%28first%5Bfield%5D%20%3F%3F%20null%29%20%3D%3D%3D%20%28second%5Bfield%5D%20%3F%3F%20null%29%3B%0A%20%20%20%20if%20%28field%20%3D%3D%3D%20%27attributes%27%29%20return%20sameGrammarMetadata%28first%5Bfield%5D%20%3F%3F%20null%2C%20second%5Bfield%5D%20%3F%3F%20null%2C%20false%29%3B%0A%20%20%20%20if%20%28field%20%3D%3D%3D%20%27lexical%27%29%20return%20Object.hasOwn%28first%2C%20field%29%20%3D%3D%3D%20Object.hasOwn%28second%2C%20field%29%20%26%26%20sameGrammarMetadata%28first%5Bfield%5D%2C%20second%5Bfield%5D%29%3B%0A%20%20%20%20return%20first%5Bfield%5D%20%3D%3D%3D%20second%5Bfield%5D%3B%0A%20%20%7D%29%3B%0A%7D%0A%0Afunction%20sameGrammarSelectionMetadata%28first%2C%20second%2C%20fields%2C%20recursive%29%20%7B%0A%20%20if%20%28first%20%3D%3D%3D%20second%29%20return%20true%3B%0A%20%20if%20%28%21first%20%7C%7C%20%21second%29%20return%20false%3B%0A%20%20for%20%28const%20field%20of%20fields%29%20%7B%0A%20%20%20%20if%20%28Object.hasOwn%28first%2C%20field%29%20%21%3D%3D%20Object.hasOwn%28second%2C%20field%29%20%7C%7C%20%21sameGrammarMetadata%28first%5Bfield%5D%2C%20second%5Bfield%5D%29%29%20return%20false%3B%0A%20%20%7D%0A%20%20const%20extra%20%3D%20value%20%3D%3E%20Object.keys%28value%29.filter%28key%20%3D%3E%20%21fields.includes%28key%29%20%26%26%20%21%5B%27program%27%2C%20%27root%27%2C%20%27alternatives%27%2C%20%27sourceBytes%27%5D.includes%28key%29%29%3B%0A%20%20const%20own%20%3D%20extra%28first%29%2C%20other%20%3D%20extra%28second%29%3B%0A%20%20if%20%28own.length%20%21%3D%3D%20other.length%20%7C%7C%20own.some%28%28key%2C%20index%29%20%3D%3E%20key%20%21%3D%3D%20other%5Bindex%5D%20%7C%7C%20%21sameGrammarMetadata%28first%5Bkey%5D%2C%20second%5Bkey%5D%29%29%29%20return%20false%3B%0A%20%20return%20recursive%28first%2C%20second%29%3B%0A%7D%0A%0Afunction%20sameGrammarEmbedding%28first%2C%20second%2C%20fullMemo%29%20%7B%0A%20%20if%20%28Object.hasOwn%28first%2C%20%27sourceChildren%27%29%20%21%3D%3D%20Object.hasOwn%28second%2C%20%27sourceChildren%27%29%29%20return%20false%3B%0A%20%20if%20%28first.sourceChildren%29%20%7B%0A%20%20%20%20if%20%28first.sourceChildren.length%20%21%3D%3D%20second.sourceChildren.length%0A%20%20%20%20%20%20%20%20%7C%7C%20%21first.sourceChildren.every%28%28child%2C%20index%29%20%3D%3E%20sameGrammarTreeWith%28child%2C%20second.sourceChildren%5Bindex%5D%2C%20true%2C%20fullMemo%2C%20fullMemo%29%29%29%20return%20false%3B%0A%20%20%7D%0A%20%20if%20%28%21sameGrammarTreeWith%28first.root%2C%20second.root%2C%20true%2C%20fullMemo%2C%20fullMemo%29%29%20return%20false%3B%0A%20%20if%20%28Object.hasOwn%28first%2C%20%27selection%27%29%20%21%3D%3D%20Object.hasOwn%28second%2C%20%27selection%27%29%29%20return%20false%3B%0A%20%20return%20sameGrammarSelectionMetadata%28first.selection%2C%20second.selection%2C%20selectionFields%2C%20%28own%2C%20other%29%20%3D%3E%20%7B%0A%20%20%20%20if%20%28Object.hasOwn%28own%2C%20%27alternatives%27%29%20%21%3D%3D%20Object.hasOwn%28other%2C%20%27alternatives%27%29%29%20return%20false%3B%0A%20%20%20%20const%20alternatives%20%3D%20own.alternatives%2C%20peers%20%3D%20other.alternatives%3B%0A%20%20%20%20if%20%28alternatives%20%3D%3D