(22381: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20source%20binding%20data%2C%20stored%20as%20Links%20instead%20of%20a%20large%20code%20literal.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7BreadBootstrapStructuredDataLino%7D%20from%20%27..%2F..%2Fscripts%2Flib%2Fstructured-data-bootstrap.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0A%0Aexport%20const%20NAMING_SOURCE_BINDING_STORAGE%3DObject.freeze%28%7B%0A%20%20revision%3A%275a57b666fb54b151249896d90f1e63d7a8866fcf%27%2C%0A%20%20module%3A%27js%2Fscripts%2Fissue-195-naming.mjs%27%2Ctable%3A%27B70_SOURCE_BINDINGS%27%2CbaselineRows%3A3727%2C%0A%20%20data%3A%27parity%2Fnaming%2Fsource-bindings.lino%27%2Cmigration%3A%27parity%2Fnaming%2Fsource-binding-data-migration.lino%27%2C%0A%20%20importSource%3A%22import%20%7B%20readNamingSourceBindings%20%7D%20from%20%27.%2Fnaming-source-bindings.mjs%27%3B%5Cn%22%2C%0A%20%20initializer%3A%27readNamingSourceBindings%28%29%27%2C%0A%7D%29%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%2Cpin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Alet%20cachedBindings%3B%0A%0A%2F%2A%2A%20Serialize%20each%20original%20row%20in%20its%20exact%20existing%20JSON%20literal%20layout.%20No%0A%20%2A%20JSON%20file%20is%20produced%3B%20these%20bytes%20only%20check%20the%20complete%20predecessor.%20%2A%2F%0Aexport%20function%2A%20namingSourceBindingLiteralChunks%28rows%29%20%7B%0A%20%20assert.ok%28Array.isArray%28rows%29%29%3Bif%28%21rows.length%29%7Byield%20Buffer.from%28%27%5B%5D%27%29%3Breturn%3B%7D%0A%20%20for%28const%5Bindex%2Crow%5Dof%20rows.entries%28%29%29%7B%0A%20%20%20%20const%20one%3DJSON.stringify%28%5Brow%5D%2Cnull%2C2%29%3Bassert.ok%28one.startsWith%28%27%5B%5Cn%27%29%26%26one.endsWith%28%27%5Cn%5D%27%29%29%3B%0A%20%20%20%20yield%20Buffer.from%28%28index%3D%3D%3D0%3F%27%5B%5Cn%27%3A%27%2C%5Cn%27%29%2Bone.slice%282%2C-2%29%29%3B%0A%20%20%7D%0A%20%20yield%20Buffer.from%28%27%5Cn%5D%27%29%3B%0A%7D%0A%0Afunction%20uniqueNamingSourceBytes%28source%2Cpattern%29%20%7B%0A%20%20const%20bytes%3DBuffer.from%28pattern%29%2Cstart%3Dsource.indexOf%28bytes%29%3Bassert.ok%28start%3E%3D0%26%26source.indexOf%28bytes%2Cstart%2B1%29%3C0%2C%27one%20exact%20naming%20source%20edit%27%29%3B%0A%20%20return%7Bstart%2Cend%3Astart%2Bbytes.length%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Recreate%20every%20original%20module%20byte%20using%20only%20converted%20code%20and%20the%0A%20%2A%20original%20data%20prefix%3B%20current%20appended%20bindings%20remain%20separate%20inputs.%20%2A%2F%0Aexport%20function%20verifyNamingSourceBindingData%28rows%2Cmigration%2CcurrentModule%29%20%7B%0A%20%20const%20specification%3DNAMING_SOURCE_BINDING_STORAGE%3B%0A%20%20assert.ok%28Array.isArray%28rows%29%26%26rows.length%3E%3Dspecification.baselineRows%29%3B%0A%20%20assert.equal%28migration.schemaVersion%2C1%29%3Bassert.equal%28migration.revision%2Cspecification.revision%29%3B%0A%20%20assert.equal%28migration.module%2Cspecification.module%29%3Bassert.equal%28migration.table%2Cspecification.table%29%3B%0A%20%20assert.equal%28migration.baselineRows%2Cspecification.baselineRows%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28migration.original.bytes%29%26%26migration.original.bytes%3E0%26%26migration.original.bytes%3C%3D64%2A1024%2A1024%2C%27bounded%20complete%20original%20source%27%29%3B%0A%20%20assert.equal%28migration.original.bytes%2Cmigration.certificate.blob.bytes%29%3B%0A%20%20assert.deepEqual%28pin%28currentModule%29%2Cmigration.converted%2C%27unknown%20naming%20module%20edits%20cannot%20acquire%20an%20original%20source%20view%27%29%3B%0A%20%20const%20addition%3DuniqueNamingSourceBytes%28currentModule%2Cspecification.importSource%29%3B%0A%20%20const%20withoutImport%3DBuffer.concat%28%5BcurrentModule.subarray%280%2Caddition.start%29%2CcurrentModule.subarray%28addition.end%29%5D%29%3B%0A%20%20const%20initializer%3DuniqueNamingSourceBytes%28withoutImport%2C%27const%20%27%2Bspecification.table%2B%27%3D%27%2Bspecification.initializer%2B%27%3B%27%29%3B%0A%20%20const%20prefix%3DBuffer.from%28%27const%20%27%2Bspecification.table%2B%27%3D%27%29%2Coriginal%3DBuffer.alloc%28migration.original.bytes%29%3B%0A%20%20let%20cursor%3DwithoutImport.copy%28original%2C0%2C0%2Cinitializer.start%2Bprefix.length%29%3B%0A%20%20const%20literalHash%3DcreateHash%28%27sha256%27%29%3Blet%20literalBytes%3D0%3B%0A%20%20for%28const%20chunk%20of%20namingSourceBindingLiteralChunks%28rows.slice%280%2Cspecification.baselineRows%29%29%29%7B%0A%20%20%20%20assert.ok%28cursor%2Bchunk.length%3C%3Doriginal.length%29%3Bcursor%2B%3Dchunk.copy%28original%2Ccursor%29%3BliteralHash.update%28chunk%29%3BliteralBytes%2B%3Dchunk.length%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28%7Bbytes%3AliteralBytes%2Csha256%3AliteralHash.digest%28%27hex%27%29%7D%2Cmigration.literal%2C%27every%20original%20ordered%20binding%20and%20JSON%20source%20spelling%20remains%20exact%27%29%3B%0A%20%20cursor%2B%3DwithoutImport.copy%28original%2Ccursor%2Cinitializer.end-1%29%3Bassert.equal%28cursor%2Coriginal.length%29%3B%0A%20%20assert.deepEqual%28pin%28original%29%2Cmigration.original%2C%27complete%20original%20naming%20module%20byte%20inverse%27%29%3B%0A%20%20verifyGitArtifactCertificate%28migration.certificate%2Coriginal%2C%7Brevision%3Aspecification.revision%2Cpath%3Aspecification.module%7D%29%3B%0A%20%20return%7Brows%3Arows.length%2CbaselineRows%3Aspecification.baselineRows%2Coriginal%3Amigration.original%2Cconverted%3Amigration.converted%7D%3B%0A%7D%0A%0A%2F%2F%20Copies%20preserve%20ordered%20object%20identities%20and%20share%20immutable%20scalar%20values.%0A%2F%2F%20A%20caller%20cannot%20mutate%20the%20private%20decoded%20data%20through%20its%20returned%20rows.%0Afunction%20copyNamingSourceBindingValues%28value%2Cseen%3Dnew%20WeakMap%28%29%2Cstrings%3Dnull%29%20%7B%0A%20%20if%28strings%26%26typeof%20value%3D%3D%3D%27string%27%29%7B%0A%20%20%20%20if%28%21strings.has%28value%29%29strings.set%28value%2CBuffer.from%28value%2C%27utf16le%27%29.toString%28%27utf16le%27%29%29%3B%0A%20%20%20%20return%20strings.get%28value%29%3B%0A%20%20%7D%0A%20%20if%28value%3D%3D%3Dnull%7C%7Ctypeof%20value%21%3D%3D%27object%27%29return%20value%3B%0A%20%20if%28seen.has%28value%29%29return%20seen.get%28value%29%3B%0A%20%20const%20result%3DArray.isArray%28value%29%3F%5B%5D%3A%7B%7D%3Bseen.set%28value%2Cresult%29%3B%0A%20%20for%28const%5Bkey%2Citem%5Dof%20Object.entries%28value%29%29%7B%0A%20%20%20%20assert.notEqual%28key%2C%27__proto__%27%2C%27source%20bindings%20are%20ordinary%20JSON%20data%27%29%3B%0A%20%20%20%20result%5Bkey%5D%3DcopyNamingSourceBindingValues%28item%2Cseen%2Cstrings%29%3B%0A%20%20%7D%0A%20%20return%20result%3B%0A%7D%0A%0Aexport%20function%20readNamingSourceBindings%28%29%20%7B%0A%20%20if%28%21cachedBindings%29%7B%0A%20%20%20%20const%20specification%3DNAMING_SOURCE_BINDING_STORAGE%3B%0A%20%20%20%20const%20rows%3DreadBootstrapStructuredDataLino%28readFileSync%28new%20URL%28specification.data%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20%20%20const%20migration%3DreadProjectData%28new%20URL%28specification.migration%2Croot%29%29%3B%0A%20%20%20%20verifyNamingSourceBindingData%28rows%2Cmigration%2CreadFileSync%28new%20URL%28specification.module%2Croot%29%29%29%3B%0A%20%20%20%20%2F%2F%20Detach%20scalar%20substrings%20from%20the%20complete%20serialized%20input.%20Only%20strings%0A%20%20%20%20%2F%2F%20share%20identity%3B%20ordered%20arrays%20and%20objects%20retain%20their%20actual%20owners.%0A%20%20%20%20cachedBindings%3DcopyNamingSourceBindingValues%28rows%2Cnew%20WeakMap%28%29%2Cnew%20Map%28%29%29%3B%0A%20%20%7D%0A%20%20return%20copyNamingSourceBindingValues%28cachedBindings%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
