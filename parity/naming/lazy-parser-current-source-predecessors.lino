%20%20%20%20const%20report%20%3D%20readProjectData%28file%29%3B%0A%20%20%20%20if%28report.phaseSummary%21%3D%3Dundefined%29assert.deepEqual%28report.phaseSummary%2CsummarizeRetainedSelfTranslationPhases%28%5Breport%5D%29%2C%60%24%7Bfile%7D%3A%20retained%20phase%20summary%60%29%3B%0A%20%20%20%20assert.equal%28report.schemaVersion%2C%201%2C%20%60%24%7Bfile%7D%3A%20report%20schema%60%29%3B%0A%20%20%20%20assert.equal%28report.commit%2C%20commit%2C%20%60%24%7Bfile%7D%3A%20report%20commit%60%29%3B%0A%20%20%20%20assert.deepEqual%28report.failures%2C%20%5B%5D%2C%20%60%24%7Bfile%7D%3A%20failed%20modules%60%29%3B%0A%20%20%20%20assert.deepEqual%28report.decorators%2C%20decorators%2C%20%60%24%7Bfile%7D%3A%20decorators%60%29%3B%0A%20%20%20%20assert.ok%28Array.isArray%28report.modules%29%2C%20%60%24%7Bfile%7D%3A%20module%20rows%60%29%3B%0A%20%20%20%20if%20%28report.inventory%20%21%3D%3D%20undefined%29%20%7B%0A%20%20%20%20%20%20assert.deepEqual%28report.sourceCatalog%2C%20%5B...expected%5D%2C%20%60%24%7Bfile%7D%3A%20complete%20source%20catalog%60%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28report.blockers%2C%20rankSelfTranslationBlockers%28%5Breport%5D%29%2C%20%60%24%7Bfile%7D%3A%20retained%20blocker%20inventory%60%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20markdown%20%3D%20readFileSync%28join%28dirname%28file%29%2C%20%27self-translation-report.md%27%29%2C%20%27utf8%27%29%3B%0A%20%20%20%20for%20%28const%20row%20of%20report.modules%29%20%7B%0A%20%20%20%20%20%20assert.ok%28expected.has%28row.module%29%2C%20%60%24%7Bfile%7D%3A%20unknown%20module%20%24%7Brow.module%7D%60%29%3B%0A%20%20%20%20%20%20assert.ok%28%21seen.has%28row.module%29%2C%20%60%24%7Bfile%7D%3A%20duplicate%20module%20%24%7Brow.module%7D%60%29%3B%0A%20%20%20%20%20%20seen.add%28row.module%29%3B%0A%20%20%20%20%20%20assert.equal%28row.rust%2C%20counterpart%28row.module%29%2C%20%60%24%7Brow.module%7D%3A%20Rust%20counterpart%60%29%3B%0A%20%20%20%20%20%20assert.equal%28row.sourceSha256%2C%20hash%28readFileSync%28join%28root%2C%20row.module%29%29%29%2C%20%60%24%7Brow.module%7D%3A%20source%20hash%60%29%3B%0A%20%20%20%20%20%20assert.equal%28row.rustSha256%2C%20row.rust%20%3F%20hash%28readFileSync%28join%28root%2C%20row.rust%29%29%29%20%3A%20null%2C%20%60%24%7Brow.module%7D%3A%20Rust%20hash%60%29%3B%0A%20%20%20%20%20%20validateMeasurements%28row%2C%20row.module%29%3B%0A%20%20%20%20%20%20validateMeasurements%28row.decorated%2C%20row.module%29%3B%0A%20%20%20%20%20%20assert.equal%28row.decorated.handWrittenLines%2C%20row.handWrittenLines%2C%20%60%24%7Brow.module%7D%3A%20hand-written%20measurements%60%29%3B%0A%20%20%20%20%20%20for%20%28const%20status%20of%20STATUSES%29%20assert.ok%28Number.isSafeInteger%28row.items%3F.%5Bstatus%5D%29%20%26%26%20row.items%5Bstatus%5D%20%3E%3D%200%2C%20%60%24%7Brow.module%7D%3A%20item%20measurements%60%29%3B%0A%20%20%20%20%20%20assert.ok%28markdown.includes%28%60%7C%20%24%7Brow.module%7D%20%7C%60%29%2C%20%60%24%7Brow.module%7D%3A%20missing%20Markdown%20row%60%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20for%20%28const%20module%20of%20expected%29%20assert.ok%28seen.has%28module%29%2C%20%60missing%20module%20%24%7Bmodule%7D%60%29%3B%0A%20%20console.log%28%60verified%20%24%7Bseen.size%7D%20modules%20at%20%24%7Bcommit%7D%60%29%3B%0A%7D) (lang: meta-language%20structured%20data)))
