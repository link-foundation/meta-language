e%21%3D%3Drow.current.source%29return%20source%3B%0A%20%20assert.deepEqual%28pinRequiredFieldNativeHostSource%28source%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%20return%20row.previous.source%3B%0A%7D%0A%0A%0A%2F%2F%20Metadata%20transport%20only%3A%20source%20symbols%20retain%20complete%20lossless%20UTF-8%20bytes%2C%0A%2F%2F%20while%20recorded%20intervals%20use%20the%20same%20UTF-16%20coordinates%20as%20the%20old%20receipts.%0Aexport%20function%20replayRequiredFieldNativeHostIntervals%28source%2Cedits%29%7B%0A%20%20let%20current%3Dsource%3B%0A%20%20for%28const%20edit%20of%20edits%29%7B%0A%20%20%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%26%26edit.start%3E%3D0%26%26edit.start%3C%3Dcurrent.length%29%3B%0A%20%20%20%20assert.equal%28typeof%20edit.removed%2C%27string%27%29%3Bassert.equal%28typeof%20edit.inserted%2C%27string%27%29%3B%0A%20%20%20%20assert.equal%28current.slice%28edit.start%2Cedit.start%2Bedit.removed.length%29%2Cedit.removed%29%3B%0A%20%20%20%20current%3Dcurrent.slice%280%2Cedit.start%29%2Bedit.inserted%2Bcurrent.slice%28edit.start%2Bedit.removed.length%29%3B%0A%20%20%7D%0A%20%20let%20inverse%3Dcurrent%3B%0A%20%20for%28const%20edit%20of%20edits.toReversed%28%29%29%7B%0A%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%7D%0A%20%20assert.equal%28inverse%2Csource%2C%27the%20entire%20source%20predecessor%20survives%20every%20recorded%20interval%27%29%3Breturn%20current%3B%0A%7D%0A%0Aexport%20function%20deriveRequiredFieldNativeHostSource%28previous%2Ccurrent%2Cspecification%29%7B%0A%20%20if%28specification.changes%29return%20replayAsciiHostEdits%28previous%2Cspecification.changes%29%3B%0A%20%20assert.deepEqual%28pinRequiredFieldNativeHostSource%28current%29%2Cspecification.current%2C%27one%20complete%20reviewed%