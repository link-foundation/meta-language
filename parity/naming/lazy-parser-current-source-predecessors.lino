d.length%29%3B%0A%20%20%20%20%20%20assert.equal%28generated.slice%28edit.start%2C%20edit.start%20%2B%20edit.removed.length%29%2C%20edit.removed%29%3B%0A%20%20%20%20%20%20generated%20%3D%20generated.slice%280%2C%20edit.start%29%20%2B%20edit.inserted%20%2B%20generated.slice%28edit.start%20%2B%20edit.removed.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28digest%28generated%29%2C%20row.currentSha256%2C%20row.path%29%3B%0A%20%20%20%20let%20inverse%20%3D%20generated%3B%0A%20%20%20%20for%20%28const%20edit%20of%20%5B...row.edits%5D.reverse%28%29%29%20%7B%0A%20%20%20%20%20%20assert.equal%28inverse.slice%28edit.start%2C%20edit.start%20%2B%20edit.inserted.length%29%2C%20edit.inserted%29%3B%0A%20%20%20%20%20%20inverse%20%3D%20inverse.slice%280%2C%20edit.start%29%20%2B%20edit.removed%20%2B%20inverse.slice%28edit.start%20%2B%20edit.inserted.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2C%20row.source%2C%20%27the%20complete%20original%20module%20and%20context%20remain%20recoverable%27%29%3B%0A%20%20%20%20const%20file%20%3D%20new%20URL%28row.path%2C%20root%29%2C%20current%20%3D%20readFileSync%28file%2C%20%27utf8%27%29%3B%0A%20%20%20%20if%20%28check%29%20assert.equal%28current%2C%20generated%2C%20row.path%29%3B%0A%20%20%20%20else%20assert.ok%28current%20%3D%3D%3D%20row.source%20%7C%7C%20current%20%3D%3D%3D%20generated%2C%20%27unknown%20current%20source%20%27%20%2B%20row.path%29%3B%0A%20%20%20%20return%20%7B%20file%2C%20generated%20%7D%3B%0A%20%20%7D%29%3B%0A%20%20if%20%28%21check%29%20for%20%28const%20%7B%20file%2C%20generated%20%7D%20of%20outputs%29%20writeFileSync%28file%2C%20generated%29%3B%0A%20%20return%20archive%3B%0A%7D) (lang: meta-language%20structured%20data)))
