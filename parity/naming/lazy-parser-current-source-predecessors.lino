SafeInteger%28edit.start%29%26%26Number.isSafeInteger%28edit.end%29%26%26edit.start%3E%3D0%26%26edit.end%3E%3Dedit.start%26%26edit.end%3C%3Dbytes.length%29%3B%0A%20%20assert.equal%28bytes.subarray%28edit.start%2Cedit.end%29.toString%28%29%2Cedit.inserted%29%3B%0A%20%20const%20inverse%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20assert.deepEqual%28pin%28inverse%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3Bassert.equal%28inverse.toString%28%29%2Crow.sourceText%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2Cinverse%2C%7Brevision%2Cpath%3Afile%7D%29%3Breturn%20row.sourceText%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
