ssert.equal%28positions.length%2C1%29%3B%0A%20%20const%20index%3Dpositions%5B0%5D%3Bassert.deepEqual%28descriptions%5Bindex%5D%2C%7Bfile%3AlibraryFile%2Cbytes%3Abefore.bytes%2Csha256%3Abefore.sha256%7D%29%3B%0A%20%20const%20consumingChanges%3D%5B%5D%3B%0A%20%20for%28const%20field%20of%20%5B%27bytes%27%2C%27sha256%27%5D%29if%28descriptions%5Bindex%5D%5Bfield%5D%21%3D%3Dlibrary.current%5Bfield%5D%29%7B%0A%20%20%20%20consumingChanges.push%28%7Bpath%3A%5B%27predecessor%27%2C%27proof%27%2C%27producerApplicability%27%2C%27sources%27%2CString%28index%29%2Cfield%5D%2C%0A%20%20%20%20%20%20before%3Adescriptions%5Bindex%5D%5Bfield%5D%2Cafter%3Alibrary.current%5Bfield%5D%7D%29%3B%0A%20%20%20%20descriptions%5Bindex%5D%5Bfield%5D%3Dlibrary.current%5Bfield%5D%3B%0A%20%20%7D%0A%20%20assert.ok%28consumingChanges.length%3E0%29%3Bconst%20consumingText%3DserializeProjectData%28consuming%2CconsumingFile%29%3B%0A%20%20const%20rows%3D%5Blibrary%2C%7B...originalConsuming%2Cidentity%3A%27raw%20consuming%27%2Ccurrent%3Apin%28consumingText%29%2Cchanges%3AconsumingChanges%7D%5D%3B%0A%20%20const%20sourceAdapters%3D%5B%27js%2Fscripts%2Fcomplete-declaration-receipts.mjs%27%2C%27js%2Fscripts%2Fcurrent-translation-source-descriptors.mjs%27%5D.map%28file%3D%3E%7B%0A%20%20%20%20const%20row%3Doriginal%28file%2CsourceRevision%29%2Cactual%3DrestoreCurrentCiRepairSource%28readFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%2Cfile%29%3B%0A%20%20%20%20let%20start%3D0%2Cend%3Drow.sourceText.length%2Cfinish%3Dactual.length%3B%0A%20%20%20%20while%28start%3Cend%26%26start%3Cfinish%26%26row.sourceText%5Bstart%5D%3D%3D%3Dactual%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20while%28end%3Estart%26%26finish%3Estart%26%26row.sourceText%5Bend-1%5D%3D%3D%3Dactual%5Bfinish-1%5D%29%7Bend--%3Bfinish--%3B%7D%0A%20%20%20%20const%20edit%3D%7BoffsetUnit%3A%27UTF-16%20code%20units%27%2Cstart%2Cend%2Cremoved%3Arow.sourceText.slice%28start%2Cend%29%2Cinserted%3Aactual.slice%28start%2Cfinish%29%7D%3B%0A%20%20%20%20assert.equal%28actual.slice%280%2Cstart%29%2Bedit.removed%2Bactual.slice%28start%2Bedit.inserted.length%29%2Crow.sourceText%29%3B%0A%20%20%20%20return%7B...row%2Ccurrent%3Apin%28actual%29%2Cedit%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20policy%3D%7BschemaVersion%3A1%2CsourceRevision%2Csources%3Arows%2Cmodules%2CsourceAdapters%2C%0A%20%20%20%20boundary%3A%27An%20exact%20native%20library%20string-literal%20correction%20and%20separately%20identified%20packaging%20provenance.%20Complete%20JavaScript%20algorithms%20checked%20definitions%20numeric%20controls%20archives%20and%20ABI%20remain%20unchanged.%20Source%20history%20is%20not%20native%20execution%20or%20a%20proof%20of%20general%20concept%20equivalence.%27%7D%3B%0A%20%20const%20text%3DserializeProjectData%28policy%2ChistoryFile%29%2ChelperText%3Dhelper.replace%28%27__POLICY_HASH__%27%2Cpin%28text%29.sha256%29%3B%0A%20%20const%20actual%3DreadFileSync%28new%20URL%28consumingFile%2Croot%29%2C%27utf8%27%29%2Chistorical%3DrestoreCurrentCiRepairSource%28actual%2CconsumingFile%29%3B%0A%20%20if%28check%29assert.equal%28historical%2CconsumingText%29%3Belse%7B%0A%20%20%20%20assert.equal%28actual%2Chistorical%2C%27a%20historical%20writer%20cannot%20replace%20a%20newer%20current%20artifact%3B%20use%20--check%27%29%3B%0A%20%20%20%20assert.ok%28actual%3D%3D%3DoriginalConsuming.sourceText%7C%7Cactual%3D%3D%3DconsumingText%2C%27refuse%20unrelated%20consuming%20artifact%20edits%27%29%3B%0A%20%20%7D%0A%20%20if%28check%29%7BcheckProjectData%28new%20URL%28historyFile%2Croot%29%2Cpolicy%29%3Bassert.equal%28readFileSync%28new%20URL%28helperFile%2Croot%29%2C%27utf8%27%29%2ChelperText%29%3B%7D%0A%20%20else%7BwriteFileSync%28new%20URL%28consumingFile%2Croot%29%2CconsumingText%29%3BwriteProjectData%28new%20URL%28historyFile%2Croot%29%2Cpolicy%29%3BwriteFileSync%28new%20URL%28helperFile%2Croot%29%2ChelperText%29%3B%7D%0A%20%20return%20policy%3B%0A%7D%0A%0A%2F%2F%20The%20same%20public%20data%20reader%20handles%20authenticated%20predecessor%20snapshots.%0Afunction%20readProjectDataFromSource%28source%29%20%7B%0A%20%20return%20readStructuredDataLino%28source%29%3B%0A%7D%0Aimport%20%7BreadStructuredDataLino%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fsrc%2Fstructured-data-links.js%27%3B%0A%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20policy%3DgenerateLibraryRelocationHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Preserved%20both%20complete%20original%20receipts%3B%20%27%2Bpolicy.modules.length%2B%27%20actual%20native%20literal%20correction%20and%20exact%20metadata%20successors.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
