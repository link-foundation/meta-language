Afunction%20originData%28network%2Croot%29%20%7B%0A%20%20const%20fields%3Dnetwork.fieldRelations%28%29%3B%0A%20%20const%20origin%3Dfields.find%28row%3D%3Erow.parent.equals%28root%29%26%26row.label%3D%3D%3D%27provenance%27%29%3B%0A%20%20assert.ok%28origin%29%3B%0A%20%20function%20value%28id%29%20%7B%0A%20%20%20%20const%20link%3Dnetwork.link%28id%29%2Cmetadata%3Dlink.metadata%28%29%2Cterm%3Dmetadata.term%3B%0A%20%20%20%20if%28term%3D%3D%3Dschema.containers.array%29return%20link.references%28%29.map%28value%29%3B%0A%20%20%20%20if%28term%3D%3D%3Dschema.containers.record%29%7B%0A%20%20%20%20%20%20const%20entries%3Dfields.filter%28row%3D%3Erow.parent.equals%28id%29%29.map%28row%3D%3E%5BfieldOf%28row.label%29%2Cvalue%28row.child%29%5D%29%3B%0A%20%20%20%20%20%20assert.equal%28new%20Set%28entries.map%28%28%5Bkey%5D%29%3D%3Ekey%29%29.size%2Centries.length%29%3B%0A%20%20%20%20%20%20return%20Object.fromEntries%28entries%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%28term%3D%3D%3Dschema.scalars.string%29return%20metadata.definition%3B%0A%20%20%20%20if%28term%3D%3D%3Dschema.scalars.number%29return%20Number%28metadata.definition%29%3B%0A%20%20%20%20if%28term%3D%3D%3Dschema.scalars.boolean%29return%20metadata.definition%3D%3D%3D%27true%27%3B%0A%20%20%20%20if%28term%3D%3D%3Dschema.scalars.null%29return%20null%3B%0A%20%20%20%20throw%20new%20Error%28%27unexpected%20concrete%20provenance%20scalar%20%27%2Bterm%29%3B%0A%20%20%7D%0A%20%20return%20value%28origin.child%29%3B%0A%7D%0A%0Afunction%20concreteBytes%28tree%29%20%7B%0A%20%20if%28tree.type%3D%3D%3D%27missing%27%29return%20Buffer.alloc%280%29%3B%0A%20%20if%28tree.type%3D%3D%3D%27token%27%7C%7Ctree.type%3D%3D%3D%27error%27%29return%20tree.text%3D%3D%3Dnull%3FBuffer.from%28tree.hex%2C%27hex%27%29%3ABuffer.from%28tree.text%29%3B%0A%20%20return%20Buffer.concat%28%28tree.children%3F%3F%5Btree.root%5D%29.map%28concreteBytes%29%29%3B%0A%7D%0A%0Afunction%20printed%28code%29%20%7B%0A%20%20const%20lines%3D%5B%5D%3B%0A%20%20vm.runInNewContext%28code%2C%7Bconsole%3A%7Blog%3Avalue%3D%3Elines.push%28String%28value%29%29%7D%2Cprocess%3A%7Bargv%3A%5B%5D%7D%7D%2C%20%7Btimeout%3A1000%7D%29%3B%0A%20%20return%20lines%3B%0A%7D%0A%0Atest%28%27TypeScript%20typed%20graphs%20retain%20complete%20original%20and%20lowered%20CSTs%20through%20text%20and%20binary%20Links%20reload%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20fixture%3DgenerateTypeScriptTypedGraphFixtures%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20nativeInputs%3Dawait%20generateTypeScriptTypedGraphArchives%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20assert.equal%28nativeInputs.cases.length%2C4%29%3B%0A%20%20const%20parser%3DcompileGrammar%28parseGrammarLinks%28nativeGrammarText%28%27native-typescript%27%29%29%29%3B%0A%20%20for%28const%20%7Bsource%2CexpectedLines%3Aexpected%7Dof%20fixture.cases%29%7B%0A%20%20%20%20const%20packet%3DcreateTypeScriptSemanticGraph%28source%2C%7Butf16Strings%3Atrue%2Cprovenance%3A%7Bpurpose%3A%27independent%20source%20retention%27%7D%7D%29%3B%0A%20%20%20%20for%28const%20network%20of%20%5Bpacket.network%2CLinkNetwork.fromLino%28packet.network.toLino%28%29%29%2C%0A%20%20%20%20%20%20decodeLinkNetworkBinary%28encodeLinkNetworkBinary%28packet.network%29%29%5D%29%7B%0A%20%20%20%20%20%20const%20program%3DdecodeTypedProgramLinks%28network%2Cpacket.root%29%2Corigin%3DoriginData%28network%2Cpacket.root%29%3B%0A%20%20%20%20%20%20assert.equal%28program.sourceLanguage%2C%27JavaScript%27%2C%27the%20semantic%20frontend%20language%20is%20explicitly%20the%20lowered%20language%27%29%3B%0A%20%20%20%20%20%20assert.equal%28origin.sourceProfile.language%2C%27TypeScript%27%29%3B%0A%20%20%20%20%20%20assert.equal%28origin.sourceProfile.model%2C%27typescript-portable-typing-v1%27%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28origin.userProvenance%2C%7Bpurpose%3A%27independent%20source%20retention%27%7D%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28origin.sourceProfile.concreteSyntax.tree%2Cparser.parseTree%28source%29.tree%29%3B%0A%20%20%20%20%20%20assert.ok%28concreteBytes%