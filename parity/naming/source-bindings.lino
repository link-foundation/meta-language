(172: (meta: (t: semantic) (n: 1) (term: string%20value) (def: export%20function%20readGrammarSelectionFieldRangePolicy%28closed%20%3D%20readGrammarSelectionFieldRangeSource%28%29%29%20%7B%0A%20%20return%20%7B%20schemaVersion%3A%201%2C%20model%3A%20%27proper%20physical%20CST%20field%20range%20selection%201%27%2C%0A%20%20%20%20sourcePath%2C%20source%3A%20closed.source%2C%20sourceBytes%3A%20closed.bytes%2C%20sourceSha256%3A%20closed.sourceSha256%2C%0A%20%20%20%20sourceClosure%3A%20closed.sourceClosure%2C%0A%20%20%20%20profile%3A%20%27The%20field-ranges%20mapping%20admits%20one%20source-field-selector%20with%20an%20exact%20nonempty%20field%20label%2C%20include%20or%20exclude%20mode%2C%20nonnegative%20integral%20first%20occurrence%20and%20strictly%20positive%20integral%20count.%20Counts%20and%20source%20positions%20are%20bounded%20by%20the%20original%20unsigned%2032-bit%20source%20domain.%27%2C%0A%20%20%20%20context%3A%20%27A%20field%20profile%20cannot%20be%20mixed%20with%20another%20source%20mapping%20or%20selected%20inside%20a%20lexical%20token.%20Zero%20count%20never%20means%20all%3B%20the%20exact%20label%20is%20a%20capture%20field%2C%20not%20a%20grammar%20rule%20name.%27%2C%0A%20%20%20%20occurrences%3A%20%27The%20host%20supplies%20topmost%20non-trivia%20physical%20CST%20field%20occurrences%20in%20their%20original%20child%20order.%20Every%20supplied%20absolute%20span%20is%20validated%2C%20including%20unselected%20occurrences.%20The%20closed%20kernel%20neither%20sorts%20nor%20merges%20spans%20nor%20discovers%20trees%20through%20callbacks.%27%2C%0A%20%20%20%20correspondence%3A%20%27The%20complete%20plan%20consumes%20one%20read-only%20flat%20numeric%20span%20column.%20Include%20mode%20retains%20selected%20relative%20pairs%3B%20exclude%20mode%20retains%20their%20ordered%20complement.%20Empty%20and%20full-width%20results%20refuse%2C%20so%20admitted%20output%20is%20a%20proper%20contraction%20consumed%20by%20the%20unchanged%20scalar-aware%20included-range%20mapper.%27%2C%0A%20%20%20%20ownership%3A%20%27The%20existing%20physical%20tree%20traversal%20and%20source-plane%20checker%20retain%20actual%20child%20ownership%2C%20exact%20occurrence%20paths%2C%20complete%20source%20bytes%20and%20UTF8%20scalar%20boundaries.%20Equal%20labels%2C%20byte%20strings%20or%20hashes%20do%20not%20establish%20those%20obligations.%27%2C%0A%20%20%20%20resources%3A%20%27Host%20traversal%2C%20witness%20storage%2C%20source%20mapping%20and%20recursion%20retain%20their%20existing%20memory%2C%20step%20and%20depth%20budgets.%20The%20planner%20does%20not%20copy%20the%20complete%20immutable%20span%20column%20at%20each%20continuation.%27%2C%0A%20%20%20%20archiveBoundary%3A%20%27Generic%20Links%20decoding%20does%20not%20authenticate%20source%20mappings.%20Source-free%20checking%20must%20replay%20the%20actual%20field%20occurrences%20and%20generated%20range%20plan%20against%20the%20complete%20physical%20CST%20and%20retained%20source%20definitions.%27%2C%0A%20%20%20%20legacyBoundary%3A%20%27Identity%2C%20JSON-string%20and%20explicit%20included-range%20decision%20modules%20remain%20separate%20unchanged%20inputs.%20This%20producer%20retains%20every%20complete%20source%20and%20generated%20continuation%20owner%20rather%20than%20selecting%20a%20convenient%20function%20subset.%27%2C%0A%20%20%20%20boundary%3A%20%27This%20finite%20physical-field%20profile%20does%20not%20establish%20complete%20Markdown%20or%20other%20priority-language%20support%2C%20scanner%20context%20discharge%20or%20language-CST%20validity.%20Native%20compilation%20and%20execution%20require%20actual%20CI%20observations.%27%20%7D%3B%0A%7D) (lang: meta-language%20structured%20data)))
