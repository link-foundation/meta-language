ad%28%27rust%2Ftests%2Funit%2Ftranslation_concrete_program_graphs.rs%27%29%2Cmarker%3D%27%5Cn%23%5Btest%5D%5Cn%27%3B%0A%20%20const%20invert%3Dchanges%3D%3Echanges.toReversed%28%29.map%28row%3D%3E%28%7Bbefore%3Arow.after%2Cafter%3Arow.before%2Coccurrences%3Arow.occurrences%7D%29%29%3B%0A%20%20const%20helper%3DapplyNativeConsumerChanges%28rust.slice%280%2Crust.indexOf%28marker%29%29%2Cinvert%28template.rustChanges%29%29%3B%0A%20%20assert.equal%28helper%2BoriginalRust.slice%28originalRust.indexOf%28marker%29%29%2CoriginalRust%29%3B%0A%20%20const%20javascript%3Dread%28%27experiments%2Fconcrete-program-graphs%2Frun-rust-emissions.mjs%27%29%3B%0A%20%20assert.equal%28applyNativeConsumerChanges%28javascript%2Cinvert%28template.javascriptChanges%29%29%2Ctemplate.sources.find%28row%3D%3Erow.file.endsWith%28%27.mjs%27%29%29.sourceText%29%3B%0A%20%20assert.throws%28%28%29%3D%3EapplyNativeConsumerChanges%28%27unknown%20source%27%2Ctemplate.javascriptChanges%29%2Cassert.AssertionError%29%3B%0A%7D%29%3B%0A%0Atest%28%27native%20graph%20registration%20preserves%20every%20original%20source%20guard%20and%20exposes%20unknown%20source%20edits%27%2C%28%29%3D%3E%7B%0A%20%20generateNativeGraphSourceHistory%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20history%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fself-translation%2Fconcrete-program-native-source-sources-history.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20assert.equal%28history.sources.length%2C4%29%3B%0A%20%20for%28const%20row%20of%20history.sources%29%7B%0A%20%20%20%20const%20actual%3Dread%28row.file%29%3Bassert.equal%28Buffer.byteLength%28actual%29%2Crow.current.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28actual%29.digest%28%27hex%27%29%2Crow.current.sha256%29%3B%0A%20%20%20%20assert.equal%28restoreNativeGraphSourceHistory%28row.file%2Cactual%29%2Crow.sourceText%29%3B%0A%20%20%20%20assert.equal%28restoreNativeGraphSourceHistory%28row.file%2Crow.sourceText%29%2Crow.sourceText%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreNativeGraphSourceHistory%28row.file%2Cactual%2B%27%5Cn%23%20unknown%20edit%5Cn%27%29%2Cassert.AssertionError%29%3B%0A%20%20%7D%0A%20%20assert.equal%28restoreNativeGraphSourceHistory%28%27unknown%2Fsource.js%27%2C%27visible%20source%27%29%2C%27visible%20source%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20generated%20native%20transport%20refuses%20local%20execution%20before%20resolving%20a%20compiler%20or%20creating%20outputs%27%2C%28t%29%3D%3E%7B%0A%20%20const%20directory%3DmkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-concrete-native-guard-%27%29%29%3B%0A%20%20t.after%28%28%29%3D%3ErmSync%28directory%2C%7Brecursive%3Atrue%7D%29%29%3B%0A%20%20const%20output%3Dnew%20URL%28%27..%2F..%2Fissue-195-artifacts%2Ftypescript-typed-graph-native%2Fconcrete-program-graphs%27%2Cimport.meta.url%29%3B%0A%20%20const%20existed%3DexistsSync%28output%29%3B%0A%20%20const%20result%3DspawnSync%28process.execPath%2C%5Bnew%20URL%28%27..%2F..%2Fexperiments%2Fconcrete-program-graphs%2Frun-rust-emissions.mjs%27%2Cimport.meta.url%29.pathname%2C%0A%20%20%20%20%27--case%27%2C%270%27%2C%27--results-dir%27%2C%27issue-195-results%27%5D%2C%7Bcwd%3Adirectory%2Cenv%3A%7B...process.env%2CCI%3A%27false%27%2CGITHUB_ACTIONS%3A%27false%27%2CPATH%3A%27%27%7D%2Cencoding%3A%27utf8%27%7D%29%3B%0A%20%20assert.equal%28result.status%2C1%29%3Bassert.match%28result.stderr%2C%2FGitHub%20CI-only%2Fu%29%3B%0A%20%20assert.equal%28existsSync%28join%28directory%2C%27issue-195-results%27%29%29%2Cfalse%29%3Bassert.equal%28existsSync%28output%29%2Cexisted%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
