7%29%2Ccertificate.commitText%29%3Bassert.ok%28commit.length%3C%3Dbounds.maxCommitBytes%29%3B%0A%20%20assert.equal%28gitObjectIdentity%28%27commit%27%2Ccommit%29%2Crevision%2C%27the%20complete%20original%20commit%20is%20the%20trust%20root%27%29%3B%0A%20%20const%20root%3D%2F%5Etree%20%28%5B0-9a-f%5D%7B40%7D%29%5Cn%2Fu.exec%28certificate.commitText%29%3Bassert.ok%28root%29%3B%0A%20%20assert.ok%28Array.isArray%28certificate.trees%29%29%3Bassert.equal%28certificate.trees.length%2Ccomponents.length%29%3B%0A%20%20assert.equal%28Object.keys%28certificate.trees%29.length%2Ccomponents.length%29%3B%0A%20%20let%20expected%3Droot%5B1%5D%3B%0A%20%20for%28let%20at%3D0%3Bat%3Ccomponents.length%3Bat%2B%2B%29%7B%0A%20%20%20%20const%20tree%3Dcertificate.trees%5Bat%5D%3BcheckCertificateRecord%28tree%2C%5B%27objectId%27%2C%27entries%27%5D%29%3B%0A%20%20%20%20assert.equal%28tree.objectId%2Cexpected%29%3B%0A%20%20%20%20assert.equal%28gitObjectIdentity%28%27tree%27%2CencodeCertificateTree%28tree.entries%2Cbounds%29%29%2Cexpected%2C%27every%20complete%20original%20tree%20is%20authenticated%27%29%3B%0A%20%20%20%20const%20entry%3Dtree.entries.find%28entry%3D%3Eentry.name%3D%3D%3Dcomponents%5Bat%5D%29%3Bassert.ok%28entry%2C%27every%20original%20path%20component%20exists%27%29%3B%0A%20%20%20%20if%28at%2B1%3Ccomponents.length%29assert.equal%28entry.mode%2C%2740000%27%2C%27intermediate%20owners%20are%20actual%20trees%27%29%3B%0A%20%20%20%20else%20assert.ok%28%5B%27100644%27%2C%27100755%27%2C%27120000%27%5D.includes%28entry.mode%29%2C%27the%20selected%20original%20object%20is%20a%20blob%27%29%3B%0A%20%20%20%20expected%3Dentry.objectId%3B%0A%20%20%7D%0A%20%20checkCertificateRecord%28certificate.blob%2C%5B%27objectId%27%2C%27bytes%27%2C%27sha256%27%5D%29%3B%0A%20%20assert.equal%28certificate.blob.objectId%2Cexpected%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28certificate.blob.bytes%29%26%26certificate.blob.bytes%3E%3D0%26%26certificate.blob.bytes%3C%3Dbounds.maxBlobBytes%29%3B%0A%20%20assert.ok%28Buffer.isBuffer%28blob%29%29%3Bassert.equal%28blob.length%2Ccertificate.blob.bytes%29%3B%0A%20%20assert.ok%28typeof%20certificate.blob.sha256%3D%3D%3D%27string%27%26%26certificate.blob.sha256.length%3D%3D%3D64%26%26%2F%5E%5B0-9a-f%5D%7B64%7D%24%2Fu.test%28certificate.blob.sha256%29%29%3B%0A%20%20const%20bytes%3DBuffer.from%28blob%29%3B%0A%20%20assert.equal%28gitObjectIdentity%28%27blob%27%2Cbytes%29%2Cexpected%2C%27the%20exact%20original%20file%20belongs%20to%20the%20pinned%20commit%20and%20path%27%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%2Ccertificate.blob.sha256%29%3B%0A%20%20return%20bytes%3B%0A%7D) (lang: meta-language%20structured%20data)))
