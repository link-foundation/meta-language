%20fields%27%2C%28%29%3D%3E%7B%0A%20let%20refused%3D0%3B%0A%20for%28const%20receipt%20of%20register.receipts%29%7B%0A%20%20const%20current%3DreadProjectData%28new%20URL%28receipt.current.file%2Croot%29%29%3B%0A%20%20for%28const%20mutate%20of%5B%0A%20%20%20value%3D%3E%7Bvalue.extra%3D%27unreviewed%27%3B%7D%2C%0A%20%20%20value%3D%3E%7Bvalue.archive.textSha256%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%20value%3D%3E%7Bvalue.archive.textBytes%2B%3D1%3B%7D%2C%0A%20%20%20value%3D%3E%7Bdelete%20value.archive%3B%7D%2C%0A%20%20%20value%3D%3E%7Bif%28value.completeRust%29value.completeRust%2B%3D%27%20%27%3Belse%20value.sourceClosure.source%2B%3D%27%20%27%3B%7D%2C%0A%20%20%20value%3D%3E%7Bconst%20path%3Dreceipt.changes.find%28row%3D%3Erow.path.at%28-2%29%3D%3D%3D%27sourceSpan%27%29.path%3Blet%20parent%3Dvalue%3Bfor%28const%20key%20of%20path.slice%280%2C-1%29%29parent%3Dparent%5Bkey%5D%3Bparent.end%2B%3D1%3B%7D%2C%0A%20%20%5D%29%7B%0A%20%20%20const%20changed%3DstructuredClone%28current%29%3Bmutate%28changed%29%3B%0A%20%20%20assert.throws%28%28%29%3D%3ErestoreCompleteDeclarationReceipt%28changed%2Creceipt.identity%29%2Cassert.AssertionError%29%3Brefused%2B%3D1%3B%0A%20%20%7D%0A%20%20assert.throws%28%28%29%3D%3ErestoreCompleteDeclarationReceipt%28current%2Creceipt.identity%2B%27%20unknown%27%29%2Cassert.AssertionError%29%3Brefused%2B%3D1%3B%0A%20%7D%0A%20assert.equal%28refused%2C14%29%3B%0A%7D%29%3B%0A%0Atest%28%27scalar%20loop%20fixture%20refresh%20retains%20complete%20historical%20bytes%20and%20only%20current%20full%20declaration%20endpoints%27%2C%28%29%3D%3E%7B%0A%20assert.equal%28completeRegister.receipts.length%2C4%29%3B%0A%20assert.deepEqual%28register.receipts.map%28row%3D%3Erow.identity%29%2C%5B%27collection%20construction%27%2C%27raw%20consuming%27%5D%29%3B%0A%20const%20added%3DcompleteRegister.receipts.slice%282%29%3B%0A%20assert.deepEqual%28added.map%28row%3D%3Erow.identity%29%2C%5B%27scalar%20loop%20values%27%2C%27scalar%20loop%20declarations%27%5D%29%3B%0A%20let%20end