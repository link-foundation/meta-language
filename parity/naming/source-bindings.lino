%20assert.deepEqual%28after.map%28%28%7Bkind%2Cname%7D%29%3D%3E%28%7Bkind%2Cname%7D%29%29%2Cbefore.map%28%28%7Bkind%2Cname%7D%29%3D%3E%28%7Bkind%2Cname%7D%29%29%29%3B%0A%20%20assert.equal%28before.filter%28item%3D%3Eitem.kind%3D%3D%3D%27fn%27%29.length%2C64%29%3B%0A%20%20assert.equal%28before.filter%28item%3D%3Eitem.kind%3D%3D%3D%27fn%27%26%26%2F%5Epub%20fn%20%2Fmu.test%28item.source%29%29.length%2C62%29%3B%0A%20%20const%20headers%3Ditems%3D%3Eitems.filter%28item%3D%3Eitem.kind%3D%3D%3D%27fn%27%29.map%28item%3D%3Eitem.source.slice%280%2Citem.source.indexOf%28%27%7B%27%29%29%29%3B%0A%20%20assert.deepEqual%28headers%28after%29%2Cheaders%28before%29%2C%27every%20actual%20public%20and%20continuation%20interface%20is%20unchanged%27%29%3B%0A%20%20let%20restored%3Dlowered.source%3Bfor%28const%20action%20of%20%5B...lowered.actions%5D.reverse%28%29%29%7Bassert.equal%28restored.split%28action.to%29.length%2C2%29%3Brestored%3Drestored.replace%28action.to%2C%28%29%3D%3Eaction.from%29%3B%7D%0A%20%20assert.equal%28restored%2Csource%29%3B%0A%20%20assert.equal%28DecoratorSet.fromLino%28lowered.record.decorators%29.decorate%28%27emitter%27%2C%7Bformat%3A%27Rust%27%2Csource%7D%29.source%2Clowered.source%29%3B%0A%20%20assert.ok%28lowered.record.loans.every%28row%3D%3Erow.readOnlyUses%3E0%26%26row.index%3E%3D0%26%26row.index%3C%3D65535%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20actual%20borrowed%20receipt%20replays%20every%20local%20loan%20without%20selecting%20a%20native%20process%20or%20changing%20its%20predecessor%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bstored%2Clowered%7D%3DcolumnLoanControl%28%29%2Cpredecessor%3DreadOriginalLinkRawConsumingProfile%28stored.predecessor%29%3B%0A%20%20const%20actual%3DprepareOriginalLinkRawBorrowedEmission%28predecessor%29%3B%0A%20%20assert.equal%28actual.source%2Clowered.source%29%3Bassert.deepEqual%28actual.receipt.columnLoans%2Clowered.record%29%3B%0A%20%20assert.deepEqual%28actual.profile.proof.predecessor%2Cpredecessor%29%3B%0A%20%20assert.equal%