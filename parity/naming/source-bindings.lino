0for%28const%20module%20of%20history.modules%29%7B%0A%20%20%20%20verifyGitArtifactCertificate%28module.certificate%2CBuffer.from%28module.sourceText%29%2C%7Brevision%3Amodule.commit%2Cpath%3Amodule.file%7D%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28module.file%2Croot%29%29%29%2Cmodule.current%2C%27the%20actual%20corrected%20native%20module%20remains%20exact%27%29%3B%0A%20%20%7D%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.sourceText%29%2C%7Brevision%3Arow.commit%2Cpath%3Arow.file%7D%29%3B%0A%20%20const%20restored%3DstructuredClone%28artifact%29%3B%0A%20%20for%28const%20change%20of%20row.changes%29%7B%0A%20%20%20%20assert.ok%28change.path.every%28key%3D%3Etypeof%20key%3D%3D%3D%27string%27%26%26%21%5B%27__proto__%27%2C%27constructor%27%2C%27prototype%27%5D.includes%28key%29%29%29%3B%0A%20%20%20%20assert.ok%28change.path%5B0%5D%3D%3D%3D%27library%27%26%26change.path%5B1%5D%3D%3D%3D%27files%27%26%26change.path.length%3D%3D%3D4%0A%20%20%20%20%20%20%7C%7Cchange.path.slice%280%2C4%29.join%28%27.%27%29%3D%3D%3D%27predecessor.proof.producerApplicability.sources%27%26%26change.path.length%3D%3D%3D6%29%3B%0A%20%20%20%20assert.ok%28%5B%27bytes%27%2C%27sourceSha256%27%2C%27sha256%27%5D.includes%28change.path.at%28-1%29%29%29%3B%0A%20%20%20%20let%20parent%3Drestored%3Bfor%28const%20key%20of%20change.path.slice%280%2C-1%29%29%7Bassert.ok%28Object.hasOwn%28parent%2Ckey%29%29%3Bparent%3Dparent%5Bkey%5D%3B%7D%0A%20%20%20%20const%20key%3Dchange.path.at%28-1%29%3Bassert.deepEqual%28parent%5Bkey%5D%2Cchange.after%29%3Bparent%5Bkey%5D%3Dchange.before%3B%0A%20%20%7D%0A%20%20const%20original%3DBuffer.from%28serializeProjectData%28restored%2Crow.file%29%29%3B%0A%20%20assert.deepEqual%28pin%28original%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20assert.equal%28original.toString%28%27utf8%27%29%2Crow.sourceText%2C%27every%20complete%20predecessor%20receipt%20byte%20is%20restored%27%29%3B%0A%20%20return%20restored%3