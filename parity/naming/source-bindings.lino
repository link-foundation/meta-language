sert.equal%2528history.sources.length%252C%25206%2529%253B%250A%2520%2520%257D%250A%2520%2520const%2520entries%2520%253D%2520history.sources.filter%2528row%2520%253D%253E%2520row.file%2520%253D%253D%253D%2520file%2520%2526%2526%2520row.revision%2520%253D%253D%253D%2520revision%2529%253B%250A%2520%2520assert.equal%2528entries.length%252C%25201%252C%2520%2527one%2520exact%2520recorded%2520source%2520and%2520predecessor%2520revision%2520are%2520required%2527%2529%253B%250A%2520%2520const%2520entry%2520%253D%2520entries%255B0%255D%253B%250A%2520%2520let%2520bytes%2520%253D%2520Buffer.from%2528source%2529%253B%250A%2520%2520assert.equal%2528bytes.toString%2528%2527utf8%2527%2529%252C%2520source%252C%2520%2527complete%2520source%2520retains%2520valid%2520UTF8%2527%2529%253B%250A%2520%2520if%2520%2528digest%2528bytes%2529%2520%253D%253D%253D%2520entry.previous.sha256%2529%2520%257B%250A%2520%2520%2520%2520assert.equal%2528bytes.length%252C%2520entry.previous.bytes%2529%253B%250A%2520%2520%2520%2520assert.equal%2528source%252C%2520entry.previous.sourceText%2529%253B%250A%2520%2520%2520%2520return%2520source%253B%250A%2520%2520%257D%250A%2520%2520assert.equal%2528bytes.length%252C%2520entry.current.bytes%252C%2520%2527unreviewed%2520current%2520source%2520changes%2520refuse%2527%2529%253B%250A%2520%2520assert.equal%2528digest%2528bytes%2529%252C%2520entry.current.sha256%252C%2520%2527the%2520complete%2520current%2520source%2520must%2520match%2520its%2520reviewed%2520input%2527%2529%253B%250A%2520%2520let%2520limit%2520%253D%2520bytes.length%253B%250A%2520%2520for%2520%2528const%2520edit%2520of%2520entry.edits.toReversed%2528%2529%2529%2520%257B%250A%2520%2520%2520%2520assert.ok%2528Number.isSafeInteger%2528edit.start%2529%2520%2526%2526%2520Number.isSafeInteger%2528edit.end%2529%250A%2520%2520%2520%2520%2520%2520%2526%2526%2520edit.start%2520%253E%253D%25200%2520%2526%2526%2520edit.end%2520%253E%253D%2520edit.start%2520%2526%2526%2520edit.end%2520%253C%253D%2520limit%252C%25