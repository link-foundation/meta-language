(21114: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Offline%20membership%20proofs%20for%20immutable%20SHA-1%20Git%20artifacts.%20Source%20bytes%2C%0A%2F%2F%20complete%20tree%20entries%20and%20the%20actual%20commit%20retain%20their%20original%20encoding.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0A%0Afunction%20checkCertificateRecord%28value%2Ckeys%29%20%7B%0A%20%20assert.ok%28value%21%3D%3Dnull%26%26typeof%20value%3D%3D%3D%27object%27%26%26%21Array.isArray%28value%29%29%3B%0A%20%20assert.ok%28%5BObject.prototype%2Cnull%5D.includes%28Object.getPrototypeOf%28value%29%29%29%3B%0A%20%20assert.deepEqual%28Object.getOwnPropertySymbols%28value%29%2C%5B%5D%29%3B%0A%20%20assert.deepEqual%28Object.getOwnPropertyNames%28value%29.sort%28%29%2C%5B...keys%5D.sort%28%29%29%3B%0A%20%20for%28const%20key%20of%20keys%29%7Bconst%20descriptor%3DObject.getOwnPropertyDescriptor%28value%2Ckey%29%3Bassert.ok%28descriptor.enumerable%26%26Object.hasOwn%28descriptor%2C%27value%27%29%29%3B%7D%0A%7D%0A%0Afunction%20gitObjectIdentity%28kind%2Cbytes%29%20%7B%0A%20%20return%20createHash%28%27sha1%27%29.update%28kind%2B%27%20%27%2Bbytes.length%2B%27%5C0%27%29.update%28bytes%29.digest%28%27hex%27%29%3B%0A%7D%0A%0Afunction%20encodeCertificateTree%28entries%2Climits%29%20%7B%0A%20%20assert.ok%28Array.isArray%28entries%29%26%26entries.length%3C%3Dlimits.maxTreeEntries%29%3B%0A%20%20assert.equal%28Object.keys%28entries%29.length%2Centries.length%2C%27dense%20ordered%20Git%20tree%20entries%27%29%3B%0A%20%20const%20names%3Dnew%20Set%28%29%2Cparts%3D%5B%5D%3Blet%20size%3D0%3B%0A%20%20for%28const%20entry%20of%20entries%29%7B%0A%20%20%20%20checkCertificateRecord%28entry%2C%5B%27mode%27%2C%27name%27%2C%27objectId%27%5D%29%3B%0A%20%20%20%20assert.ok%28%5B%2740000%27%2C%27100644%27%2C%27100755%27%2C%27120000%27%2C%27160000%27%5D.includes%28entry.mode%29%29%3B%0A%20%20%20%20assert.equal%28typeof%20entry.name%2C%27string%27%29%3B%0A%20%20%20%20assert.ok%28entry.name.length%3E0%26%26%21%5B%27.%27%2C%27..%27%5D.includes%28entry.name%29%26%26%21%2F%5B%5C0%2F%5D%2Fu.test%28entry.name%29%29%3B%0A%20%20%20%20assert.equal%28Buffer.from%28entry.name%2C%27utf8%27%29.toString%28%27utf8%27%29%2Centry.name%2C%27lossless%20UTF-8%20Git%20names%27%29%3B%0A%20%20%20%20assert.ok%28%21names.has%28entry.name%29%2C%27unique%20complete%20tree%20names%27%29%3Bnames.add%28entry.name%29%3B%0A%20%20%20%20assert.ok%28typeof%20entry.objectId%3D%3D%3D%27string%27%26%26entry.objectId.length%3D%3D%3D40%26%26%2F%5E%5B0-9a-f%5D%7B40%7D%24%2Fu.test%28entry.objectId%29%29%3B%0A%20%20%20%20const%20prefix%3DBuffer.from%28entry.mode%2B%27%20%27%2Bentry.name%2B%27%5C0%27%2C%27utf8%27%29%3B%0A%20%20%20%20size%2B%3Dprefix.length%2B20%3Bassert.ok%28size%3C%3Dlimits.maxTreeBytes%2C%27explicit%20complete%20tree%20byte%20bound%27%29%3B%0A%20%20%20%20parts.push%28prefix%2CBuffer.from%28entry.objectId%2C%27hex%27%29%29%3B%0A%20%20%7D%0A%20%20return%20Buffer.concat%28parts%2Csize%29%3B%0A%7D%0A%0A%2F%2A%2A%20The%20caller%20supplies%20both%20trusted%20original%20anchors%20independently%20of%20the%20proof.%0A%20%2A%20Schema%201%20covers%20SHA-1%20repositories%20with%20UTF-8%20commit%20text%20and%20path%20names.%0A%20%2A%20This%20operation%20reads%20no%20repository%2C%20filesystem%2C%20process%20or%20network%20state.%20%2A%2F%0Aexport%20function%20verifyGitArtifactCertificate%28certificate%2Cblob%2C%7Brevision%2Cpath%2Climits%3D%7B%7D%7D%29%20%7B%0A%20%20const%20bounds%3D%7BmaxBlobBytes%3A64%2A1024%2A1024%2CmaxTreeBytes%3A8%2A1024%2A1024%2CmaxTreeEntries%3A100000%2CmaxCommitBytes%3A4%2A1024%2A1024%2CmaxPathDepth%3A64%2C...limits%7D%3B%0A%20%20assert.deepEqual%28Object.keys%28bounds%29.sort%28%29%2C%5B%27maxBlobBytes%27%2C%27maxCommitBytes%27%2C%27maxPathDepth%27%2C%27maxTreeBytes%27%2C%27maxTreeEntries%27%5D%29%3B%0A%20%20for%28const%20value%20of%20Object.values%28bounds%29%29assert.ok%28Number.isSafeInteger%28value%29%26%26value%3E0%29%3B%0A%20%20assert.ok%28typeof%20revision%3D%3D%3D%27string%27%26%26revision.length%3D%3D%3D40%26%26%2F%5E%5B0-9a-f%5D%7B40%7D%24%2Fu.test%28revision%29%2C%27trusted%20full%20original%20revision%27%29%3B%0A%20%20assert.equal%28typeof%20path%2C%27string%27%29%3Bconst%20components%3Dpath.split%28%27%2F%27%29%3B%0A%20%20assert.ok%28components.length%3E0%26%26components.length%3C%3Dbounds.maxPathDepth%29%3B%0A%20%20assert.ok%28components.every%28name%3D%3Ename%26%26%21%5B%27.%27%2C%27..%27%5D.includes%28name%29%26%26%21%2F%5B%5C0%5C%5C%5D%2Fu.test%28name%29%29%2C%27exact%20safe%20original%20Git%20path%27%29%3B%0A%20%20assert.equal%28Buffer.from%28path%2C%27utf8%27%29.toString%28%27utf8%27%29%2Cpath%29%3B%0A%20%20checkCertificateRecord%28certificate%2C%5B%27schemaVersion%27%2C%27objectFormat%27%2C%27revision%27%2C%27path%27%2C%27commitText%27%2C%27trees%27%2C%27blob%27%5D%29%3B%0A%20%20assert.equal%28certificate.schemaVersion%2C1%29%3Bassert.equal%28certificate.objectFormat%2C%27sha1%27%29%3B%0A%20%20assert.equal%28certificate.revision%2Crevision%29%3Bassert.equal%28certificate.path%2Cpath%29%3B%0A%20%20assert.equal%28typeof%20certificate.commitText%2C%27string%27%29%3B%0A%20%20const%20commit%3DBuffer.from%28certificate.commitText%2C%27utf8%27%29%3B%0A%20%20assert.equal%28commit.toString%28%27utf8%27%29%2Ccertificate.commitText%29%3Bassert.ok%28commit.length%3C%3Dbounds.maxCommitBytes%29%3B%0A%20%20assert.equal%28gitObjectIdentity%28%27commit%27%2Ccommit%29%2Crevision%2C%27the%20complete%20original%20commit%20is%20the%20trust%20root%27%29%3B%0A%20%20const%20root%3D%2F%5Etree%20%28%5B0-9a-f%5D%7B40%7D%29%5Cn%2Fu.exec%28certificate.commitText%29%3Bassert.ok%28root%29%3B%0A%20%20assert.ok%28Array.isArray%28certificate.trees%29%29%3Bassert.equal%28certificate.trees.length%2Ccomponents.length%29%3B%0A%20%20assert.equal%28Object.keys%28certificate.trees%29.length%2Ccomponents.length%29%3B%0A%20%20let%20expected%3Droot%5B1%5D%3B%0A%20%20for%28let%20at%3D0%3Bat%3Ccomponents.length%3Bat%2B%2B%29%7B%0A%20%20%20%20const%20tree%3Dcertificate.trees%5Bat%5D%3BcheckCertificateRecord%28tree%2C%5B%27objectId%27%2C%27entries%27%5D%29%3B%0A%20%20%20%20assert.equal%28tree.objectId%2Cexpected%29%3B%0A%20%20%20%20assert.equal%28gitObjectIdentity%28%27tree%27%2CencodeCertificateTree%28tree.entries%2Cbounds%29%29%2Cexpected%2C%27every%20complete%20original%20tree%20is%20authenticated%27%29%3B%0A%20%20%20%20const%20entry%3Dtree.entries.find%28entry%3D%3Eentry.name%3D%3D%3Dcomponents%5Bat%5D%29%3Bassert.ok%28entry%2C%27every%20original%20path%20component%20exists%27%29%3B%0A%20%20%20%20if%28at%2B1%3Ccomponents.length%29assert.equal%28entry.mode%2C%2740000%27%2C%27intermediate%20owners%20are%20actual%20trees%27%29%3B%0A%20%20%20%20else%20assert.ok%28%5B%27100644%27%2C%27100755%27%2C%27120000%27%5D.includes%28entry.mode%29%2C%27the%20selected%20original%20object%20is%20a%20blob%27%29%3B%0A%20%20%20%20expected%3Dentry.objectId%3B%0A%20%20%7D%0A%20%20checkCertificateRecord%28certificate.blob%2C%5B%27objectId%27%2C%27bytes%27%2C%27sha256%27%5D%29%3B%0A%20%20assert.equal%28certificate.blob.objectId%2Cexpected%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28certificate.blob.bytes%29%26%26certificate.blob.bytes%3E%3D0%26%26certificate.blob.bytes%3C%3Dbounds.maxBlobBytes%29%3B%0A%20%20assert.ok%28Buffer.isBuffer%28blob%29%29%3Bassert.equal%28blob.length%2Ccertificate.blob.bytes%29%3B%0A%20%20assert.ok%28typeof%20certificate.blob.sha256%3D%3D%3D%27string%27%26%26certificate.blob.sha256.length%3D%3D%3D64%26%26%2F%5E%5B0-9a-f%5D%7B64%7D%24%2Fu.test%28certificate.blob.sha256%29%29%3B%0A%20%20const%20bytes%3DBuffer.from%28blob%29%3B%0A%20%20assert.equal%28gitObjectIdentity%28%27blob%27%2Cbytes%29%2Cexpected%2C%27the%20exact%20original%20file%20belongs%20to%20the%20pinned%20commit%20and%20path%27%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%2Ccertificate.blob.sha256%29%3B%0A%20%20return%20bytes%3B%0A%7D%0A) (