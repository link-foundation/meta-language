%27binary%27%5D%29%3B%0A%20%20for%28const%20replay%20of%20artifact.replays%29%7Bassert.equal%28replay.ownerCount%2C106%29%3Bassert.equal%28replay.emittedSha256%2Cartifact.sourceSha256%29%3Bassert.equal%28replay.emittedBytes%2Cartifact.sourceBytes%29%3B%7D%0A%20%20assert.equal%28artifact.archive.binaryLimits.recordLimit%2Cartifact.archive.recordCount%29%3B%0A%20%20assert.ok%28artifact.archive.recordCount%3E0%26%26artifact.archive.recordCount%3C%3D1_000_000%29%3B%0A%20%20assert.equal%28artifact.archive.binaryLimits.byteLimit%2C64%2A1024%2A1024%29%3B%0A%20%20assert.equal%28artifact.nativeCompilation%2Cfalse%29%3Bassert.equal%28artifact.nativeExecution%2Cfalse%29%3B%0A%20%20assert.deepEqual%28readOriginalLinkRawConsumingProfile%28artifact.predecessor%29%2Cprofile%29%3B%0A%20%20assert.equal%28profile.proof.artifactSha256%2Csha256%28readFileSync%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%29%29%29%3B%0A%7D%29) (lang: meta-language%20structured%20data)))
