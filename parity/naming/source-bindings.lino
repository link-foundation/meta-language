st%20bytes%3DBuffer.from%28source%29%2Cparsed%3DreadRustSourceItems%28bytes%29%3B%0A%20%20%20%20const%20imports%3Dparsed.items.filter%28row%3D%3Erow.kind%3D%3D%3D%27use_declaration%27%29.map%28row%3D%3E%28%7Bsource%3Aparsed.text%28row.node%29%2Cstart%3Arow.node.start%2Cend%3Arow.node.end%7D%29%29%3B%0A%20%20%20%20const%20declarations%3Dnames.map%28name%3D%3E%7B%0A%20%20%20%20%20%20const%20matches%3Dparsed.items.filter%28row%3D%3Erow.name%3D%3D%3Dname%29%3Bassert.equal%28matches.length%2C1%2Cname%29%3B%0A%20%20%20%20%20%20const%20row%3Dmatches%5B0%5D%2Ctext%3Dbytes.subarray%28row.start%2Crow.end%29.toString%28%29%3B%0A%20%20%20%20%20%20return%7Bname%2Ckind%3Arow.kind%2Cstart%3Arow.start%2Cend%3Arow.end%2Csource%3Atext%2C...pin%28text%29%7D%3B%0A%20%20%20%20%7D%29%3B%0A%20%20%20%20return%7Bimports%2Cdeclarations%7D%3B%0A%20%20%7D%3B%0A%20%20const%20before%3Dread%28original%29%2Cafter%3Dread%28current%29%3B%0A%20%20assert.deepEqual%28after%2Cbefore%2C%27every%20selected%20actual%20native%20import%2C%20complete%20type%20and%20original%20byte%20interval%20stays%20exact%27%29%3B%0A%20%20assert.ok%28after.declarations.length%3E0%29%3B%0A%20%20return%20after%3B%0A%7D%0A%0Afunction%20javaScriptContextDiagnosticProof%28original%2Ccurrent%29%20%7B%0A%20%20const%20before%3DreadJavaScriptDiagnosticOrders%28original%29%2Cafter%3DreadJavaScriptDiagnosticOrders%28current%29%3B%0A%20%20assert.equal%28before.length%2C9%29%3Bassert.equal%28after.length%2Cbefore.length%29%3B%0A%20%20return%20before.map%28%28row%2Cindex%29%3D%3E%7B%0A%20%20%20%20const%20next%3Dafter%5Bindex%5D%2ColdCall%3DBuffer.from%28original%29.subarray%28row.call.span.start%2Crow.call.span.end%29.toString%28%29%3B%0A%20%20%20%20const%20newCall%3DBuffer.from%28current%29.subarray%28next.call.span.start%2Cnext.call.span.end%29.toString%28%29%3B%0A%20%20%20%20assert.equal%28newCall%2ColdCall%2C%27every%20actual%20complete%20diagnostic%20call%20and%20field-value%20spelling%20remains%20exact%27%29%3B%0A%20%20%20%20assert.deepEqual%28next.keys%2Crow.keys%29%3Bassert.equal%28next.reason%2Crow.reason%29%3Bassert.equal%28next.detail%2Crow.detail%29%3B%0A%20%20%20%20return%7Bkeys%3Arow.keys%2Creason%3Arow.reason%2Cdetail%3Arow.detail%2Csource%3AoldCall%2C...pin%28oldCall%29%2C%0A%20%20%20%20%20%20historicalCall%3Arow.call%2CcurrentCall%3Anext.call%7D%3B%0A%20%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20Build%20an%20explicit%20candidate%20profile%20from%20certified%20original%20and%20proposed%20bytes.%20%2A%2F%0Aexport%20function%20buildGlobalGrammarContextSourceProfiles%28%29%20%7B%0A%20%20if%28profile%29return%20structuredClone%28profile%29%3B%0A%20%20const%20packet%3DreadProjectData%28new%20URL%28sourceFile%2Croot%29%29%3B%0A%20%20const%20javascript%3DreadGlobalGrammarContextProposal%28javascriptPath%29%2Cnative%3DreadGlobalGrammarContextProposal%28nativePath%29%3B%0A%20%20const%20originalJavaScript%3DdiagnosticOrderDecorator.inputs.find%28row%3D%3Erow.path%3D%3D%3DjavascriptPath%29.source%3B%0A%20%20const%20originalNative%3DdiagnosticOrderDecorator.inputs.find%28row%3D%3Erow.path%3D%3D%3DnativePath%29.source%3B%0A%20%20const%20corrected%3DapplyDiagnosticOrderDecorator%28originalNative%2CdiagnosticOrderDecorator%2C%7Brole%3A%27frozen%20CI%20overlay%27%7D%29%3B%0A%20%20const%20oldJavaScript%3Dpacket.sources.find%28row%3D%3Erow.file%3D%3D%3DjavascriptPath%29.sourceText%3B%0A%20%20const%20oldNative%3Dpacket.sources.find%28row%3D%3Erow.file%3D%3D%3DnativePath%29.sourceText%3B%0A%20%20assert.equal%28oldJavaScript%2CoriginalJavaScript%29%3Bassert.equal%28oldNative%2Ccorrected.source%29%3B%0A%20%20assert.equal%28pin%28originalJavaScript%29.sha256%2CoutcomeWirePolicy.pins%5BjavascriptPath%5D%29%3B%0A%20%20assert.equal%28pin%28originalNative%29.sha256%2CoutcomeWirePolicy.pins%5BnativePath%5D%29%3B%0A%20%20profile%3D%7BschemaVersion%3A1%2Cprofile%3A%27proposed%20global%20grammar%20context%20source%20views%27%2C%0A%20%20%20%20proposal%3A%7Bpath%3AsourceFile%2C...pin%28readFileSync%28new%20URL%28sourceFile%2Croot%29%29%29%7D%2C%0A%20%20%20%20historicalPins%3AstructuredClone%28outcomeWirePolicy.pins%29%2C%0A%20%20%20%20sources%3A%5B%0A%20%20%20%20%20%20%7Bfile%3AjavascriptPath%2Chistorical%3Apin%28originalJavaScript%29%2CproductionPredecessor%3Apin%28oldJavaScript%29%2Cproposed%3Ajavascript.proposed%2C%0A%20%20%20%20%20%20%20%20inverseSteps%3A%5B%27inverse%20certified%20context%20reuse%20edits%27%5D%2Cproof%3AjavaScriptContextDiagnosticProof%28originalJavaScript%2Cjavascript.source%29%7D%2C%0A%20%20%20%20%20%20%7Bfile%3AnativePath%2Chistorical%3Apin%28originalNative%29%2CproductionPredecessor%3Apin%28oldNative%29%2Cproposed%3Anative.proposed%2C%0A%20%20%20%20%20%20%20%20inverseSteps%3A%5B%27inverse%20certified%20context%20reuse%20edits%27%2C%27inverse%20original%20diagnostic%20key%20permutation%27%5D%2Cproof%3AnativeContextDeclarationProof%28originalNative%2Cnative.source%29%7D%2C%0A%20%20%20%20%5D%2C%0A%20%20%20%20frozenOverlay%3A%7Boriginal%3Apin%28originalNative%29%2Coutput%3Apin%28corrected.source%29%2Creceipt%3Acorrected.receipt%7D%2C%0A%20%20%20%20boundary%3A%27An%20explicit%20candidate%20source%20profile%2C%20not%20installed%20production%20or%20observed%20native%20execution.%20Full%20original%20source%20actions%20authenticate%20the%20proposed%20bytes.%20Native%20imports%20and%20selected%20complete%20type%20declarations%20remain%20exact%3B%20JavaScript%20diagnostic%20calls%20retain%20complete%20field-value%20spellings.%20Frozen%20producer%20and%20overlay%20identities%20remain%20separate%20from%20proposed%20current%20sources.%20Predicate%20equivalence%2C%20compiler%20features%20and%20complete%20native%20execution%20remain%20required.%27%7D%3B%0A%20%20return%20structuredClone%28profile%29%3B%0A%7D%0A%0A%2F%2A%2A%20Caller%20edits%20cannot%20alter%20the%20private%20recomputed%20exact%20candidate%20profile.%20%2A%2F%0Aexport%20function%20checkGlobalGrammarContextSourceProfiles%28value%29%20%7B%0A%20%20const%20expected%3DbuildGlobalGrammarContextSourceProfiles%28%29%3B%0A%20%20assert.equal%28serializeProjectData%28value%2C%27profile.lino%27%29%2CserializeProjectData%28expected%2C%27profile.lino%27%29%2C%27complete%20candidate%20source-profile%20conservation%27%29%3B%0A%20%20return%20structuredClone%28expected%29%3B%0A%7D%0A%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20value%3DbuildGlobalGrammarContextSourceProfiles%28%29%2Cpath%3Dnew%20URL%28%27parity%2Fself-translation%2Fglobal-grammar-context-source-profiles.lino%27%2Croot%29%3B%0A%20%20if%28process.argv.includes%28%27--check%27%29%29checkProjectData%28path%2Cvalue%29%3Belse%20writeProjectData%28path%2Cvalue%29%3B%0A%20%20console.log%28%27Drafted%20two%20current-source%20candidates%20with%20complete%20source%20inverses%20and%20distinct%20frozen%20producer%2Foverlay%20identities.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
