(33334: (meta: (t: semantic) (n: 1) (term: string%20value) (def: function%20readPassiveNumberFactData%28input%29%20%7B%0A%20%20const%20pending%3D%5Binput%5D%2Cseen%3Dnew%20Set%28%29%3Blet%20nodes%3D0%2Cbytes%3D0%3B%0A%20%20while%28pending.length%29%7B%0A%20%20%20%20const%20value%3Dpending.pop%28%29%3Bassert.ok%28%2B%2Bnodes%3C%3D1000000%2C%27number%20fact%20metadata%20node%20limit%27%29%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27string%27%29%7B%0A%20%20%20%20%20%20assert.ok%28value.length%3C%3D33554432-bytes%2C%27number%20fact%20metadata%20byte%20limit%27%29%3B%0A%20%20%20%20%20%20bytes%2B%3DBuffer.byteLength%28value%29%3Bassert.ok%28bytes%3C%3D33554432%2C%27number%20fact%20metadata%20byte%20limit%27%29%3Bcontinue%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%28value%3D%3D%3Dnull%7C%7C%5B%27number%27%2C%27boolean%27%2C%27undefined%27%5D.includes%28typeof%20value%29%29continue%3B%0A%20%20%20%20assert.ok%28typeof%20value%3D%3D%3D%27object%27%26%26%21types.isProxy%28value%29%2C%27passive%20number%20fact%20data%20required%27%29%3B%0A%20%20%20%20assert.ok%28%5BObject.prototype%2CArray.prototype%5D.includes%28Object.getPrototypeOf%28value%29%29%2C%27plain%20number%20fact%20data%20required%27%29%3B%0A%20%20%20%20assert.ok%28%21seen.has%28value%29%2C%27number%20fact%20containers%20cannot%20alias%20or%20cycle%27%29%3Bseen.add%28value%29%3B%0A%20%20%20%20if%28Array.isArray%28value%29%29assert.ok%28value.length%2Bnodes%2Bpending.length%3C%3D1000000%2C%27number%20fact%20array%20reservation%20limit%27%29%3B%0A%20%20%20%20const%20keys%3DReflect.ownKeys%28value%29%3Bassert.ok%28keys.length%2Bnodes%2Bpending.length%3C%3D1000000%2C%27number%20fact%20metadata%20node%20limit%27%29%3B%0A%20%20%20%20for%28const%20key%20of%20keys%29%7B%0A%20%20%20%20%20%20assert.equal%28typeof%20key%2C%27string%27%2C%27symbolic%20number%20fact%20fields%20refuse%27%29%3B%0A%20%20%20%20%20%20const%20descriptor%3DObject.getOwnPropertyDescriptor%28value%2Ckey%29%3Bassert.ok%28Object.hasOwn%28descriptor%2C%27value%27%29%2C%27number%20fact%20accessors%20refuse%27%29%3B%0A%20%20%20%20%20%20pending.push%28descriptor.value%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D) (lang: meta-language%20structured%20data)))
