nal.blob.toString%28%27utf8%27%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28original.certificate%2Coriginal.blob%2C%7Brevision%2Cpath%3Afile%7D%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28original.blob%29%2Cexpected%2C%27the%20complete%20historical%20input%20is%20independently%20pinned%27%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.from%28sourceText%29%2Coriginal.blob%29%3B%0A%20%20%20%20let%20start%3D0%2Cend%3DsourceText.length%2Cfinish%3Dactual.length%3B%0A%20%20%20%20while%28start%3Cend%26%26start%3Cfinish%26%26sourceText%5Bstart%5D%3D%3D%3Dactual%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20while%28end%3Estart%26%26finish%3Estart%26%26sourceText%5Bend-1%5D%3D%3D%3Dactual%5Bfinish-1%5D%29%7Bend--%3Bfinish--%3B%7D%0A%20%20%20%20%2F%2F%20Common%20prefixes%2Fsuffixes%20may%20split%20a%20surrogate%20pair%3B%20keep%20each%20edit%20on%0A%20%20%20%20%2F%2F%20UTF-8%20scalar%20boundaries%20so%20every%20saved%20spelling%20has%20an%20exact%20byte%20inverse.%0A%20%20%20%20if%28start%3E0%26%26%2F%5B%5CuDC00-%5CuDFFF%5D%2Fu.test%28sourceText%5Bstart%5D%3F%3F%27%27%29%29start--%3B%0A%20%20%20%20if%28end%3CsourceText.length%26%26%2F%5B%5CuDC00-%5CuDFFF%5D%2Fu.test%28sourceText%5Bend%5D%3F%3F%27%27%29%29%7Bend%2B%2B%3Bfinish%2B%2B%3B%7D%0A%20%20%20%20const%20edit%3D%7BoffsetUnit%3A%27UTF-8%20bytes%27%2Cstart%3ABuffer.byteLength%28actual.slice%280%2Cstart%29%29%2Cend%3ABuffer.byteLength%28actual.slice%280%2Cfinish%29%29%2C%0A%20%20%20%20%20%20removed%3AsourceText.slice%28start%2Cend%29%2Cinserted%3Aactual.slice%28start%2Cfinish%29%7D%3B%0A%20%20%20%20const%20bytes%3DBuffer.from%28actual%29%2Cinverse%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20assert.ok%28inverse.equals%28original.blob%29%29%3B%0A%20%20%20%20sources.push%28%7Bfile%2Cprofiles%3Aroles%2Ccommit%3Arevision%2C...expected%2CsourceText%2Ccertificate%3Aoriginal.certificate%2Ccurrent%3Apin%28actual%29%2Cedit%7D%29%3B%0A%20%20%7D%0A%20%20const%20value%3D%7BschemaVersion%3A1%2Crevision%2Crun%3A39389240046%2Csources%2C%0A%20%20%20%20boundary%3A%27Exact%20historical%20input%20views%20only.%20Current%20implementations%20and%20artifacts%20retain%20independent%20current%20gates.%20Unknown%20successors%20are%20never%20authenticated%20by%20these%20views.%20Every%20original%20historical%20assertion%20and%20its%20complete%20input%20remain%20required.%20This%20record%20proves%20source%20preservation%2C%20not%20native%20execution%20or%20semantic%20equivalence.%27%7D%3B%0A%20%20const%20output%3Dnew%20URL%28%27parity%2Fself-translation%2Fci-39389240046-historical-inputs.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28output%2Cvalue%29%3Belse%20writeProjectData%28output%2Cvalue%29%3B%0A%20%20const%20helperFile%3Dnew%20URL%28%27js%2Fscripts%2Fcontinuation-source-history.mjs%27%2Croot%29%2Csource%3DreadFileSync%28helperFile%2C%27utf8%27%29%3B%0A%20%20const%20expected%3Dsource.replace%28%2Fconst%20historyHash%3D%27%28%3F%3A%5Ba-f0-9%5D%7B64%7D%7CPENDING%29%27%3B%2Fu%2C%22const%20historyHash%3D%27%22%2Bpin%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28helperFile%2Cexpected%29%3B%0A%20%20return%20value%3B%0A%7D) (lang: meta-language%20structured%20data)))
