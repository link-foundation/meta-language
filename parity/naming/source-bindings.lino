e%20the%20actual%20source%20type%27%29%3B%0A%20%20%20%20const%20kind%3DreadOwnedOutcomeNativeNumberKind%28true%2Cprofile.version%2Cprofile.arbitraryPrecision%2Cfact.signed%2Cfact.unsigned%2Cfact.floating%29%3B%0A%20%20%20%20assert.notEqual%28kind%2C%27%27%2C%27native%20number%20predicates%20must%20select%20one%20supported%20representation%27%29%3B%0A%20%20%20%20assert.equal%28typeof%20fact.payload%2C%27string%27%29%3Bassert.ok%28fact.payload.length%3C%3D20%2C%27bounded%20exact%20native%20number%20payload%20required%27%29%3B%0A%20%20%20%20const%20projected%3DBuffer.from%28required.bits%2C%27hex%27%29.readDoubleBE%28%29%3B%0A%20%20%20%20if%28kind%3D%3D%3D%27floating%20point%27%29%7B%0A%20%20%20%20%20%20assert.match%28fact.payload%2C%2F%5E%5B0-9a-f%5D%7B16%7D%24%2Fu%2C%27exact%20binary64%20bits%20required%27%29%3B%0A%20%20%20%20%20%20assert.equal%28fact.payload%2Crequired.bits%2C%27native%20floating%20payload%20and%20projected%20bits%20must%20match%20exactly%27%29%3B%0A%20%20%20%20%7Delse%7B%0A%20%20%20%20%20%20assert.equal%28fact.payload.startsWith%28%27-%27%29%2Ckind%3D%3D%3D%27signed%20integer%27%2C%27the%20selected%20native%20signed%20variant%20is%20strictly%20negative%27%29%3B%0A%20%20%20%20%20%20assert.ok%28acceptOwnedOutcomeIntegerProjection%28fact.payload%2Ckind%3D%3D%3D%27signed%20integer%27%2C64%2Cprojected%29%2C%0A%20%20%20%20%20%20%20%20%27the%20original%20exact%20integer%20decimal%20must%20survive%20binary64%20projection%20without%20rounding%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20selections.push%28%7Bnode%3Arequired.node%2CtypeReference%3Arequired.typeReference%2Ckind%2Cpayload%3Afact.payload%2CprojectedBits%3Arequired.bits%7D%29%3B%0A%20%20%7D%0A%20%20return%7BschemaVersion%3A1%2Cmodel%3A%27source%20occurrence%20native%20number%20payload%20contract%201%27%2CplanSha256%3Aauthority.sha256%2C%0A%20%20%20%20compilerProfile%3Aprofile.compilerProfile%2Cselections%2C%0A%20%20%20%20boundary%3A%27Checked%20supplied%20payload%20contracts%20only.%20Exact%20source%