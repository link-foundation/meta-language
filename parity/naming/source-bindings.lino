%26%5B%27textBytes%27%2C%27textSha256%27%2C%27binaryBytes%27%2C%27binarySha256%27%5D.includes%28last%29%3B%0A%20%20const%20descriptor%3Didentity%3D%3D%3D%27raw%20consuming%27%26%26%5B%27bytes%27%2C%27sha256%27%5D.includes%28last%29%0A%20%20%20%26%26%28%28path.length%3D%3D%3D3%26%26path%5B0%5D%3D%3D%3D%27decisionSources%27%26%26%2F%5E%5Cd%2B%24%2Fu.test%28path%5B1%5D%29%29%0A%20%20%20%20%7C%7C%28path.length%3D%3D%3D6%26%26path.slice%280%2C4%29.join%28%27.%27%29%3D%3D%3D%27predecessor.proof.producerApplicability.sources%27%26%26%2F%5E%5Cd%2B%24%2Fu.test%28path%5B4%5D%29%29%29%3B%0A%20%20assert.ok%28endpoint%7C%7Carchive%7C%7Cdescriptor%2C%27semantic%20fields%20cannot%20be%20refreshed%20as%20source%20provenance%27%29%3B%0A%20%20if%28endpoint%7C%7Clast.endsWith%28%27Bytes%27%29%7C%7Clast%3D%3D%3D%27bytes%27%29for%28const%20value%20of%5Bchange.before%2Cchange.after%5D%29assert.ok%28Number.isSafeInteger%28value%29%26%26value%3E%3D0%29%3B%0A%20%20else%20for%28const%20value%20of%5Bchange.before%2Cchange.after%5D%29assert.match%28value%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3B%0A%20%20assert.notDeepEqual%28change.before%2Cchange.after%29%3B%0A%20%20let%20parent%3Dinverse%3B%0A%20%20for%28const%20part%20of%20path.slice%280%2C-1%29%29%7Bassert.ok%28Object.hasOwn%28parent%2Cpart%29%29%3Bparent%3Dparent%5Bpart%5D%3B%7D%0A%20%20assert.ok%28Object.hasOwn%28parent%2Clast%29%29%3Bassert.deepEqual%28parent%5Blast%5D%2Cchange.after%29%3B%0A%20%20parent%5Blast%5D%3DstructuredClone%28change.before%29%3B%0A%20%7D%0A%20const%20restored%3DBuffer.from%28structuredDataToLino%28inverse%29%29%3B%0A%20assert.equal%28restored.length%2Creceipt.previous.bytes%2C%27the%20complete%20previous%20byte%20count%20is%20restored%27%29%3B%0A%20assert.equal%28digest%28restored%29%2Creceipt.previous.sha256%2C%27the%20complete%20immutable%20previous%20artifact%20is%20restored%27%29%3B%0A%20return%20inverse%3B%0A%7D) (lang: meta-language%20structured%20data)))
