oad%29%3B%0A%20%20%7D%0A%20%20if%28type.kind%3D%3D%3D%27json%27%29%20%7B%0A%20%20%20%20if%28value%3D%3D%3Dnull%29%20return%20%7Bkind%3A%27null%27%7D%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27boolean%27%29%20return%20%7Bkind%3A%27boolean%27%2Cvalue%7D%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27number%27%29%20return%20%7Bkind%3A%27number%27%2Cvalue%7D%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27string%27%29%20return%20%7Bkind%3A%27string%27%2Cvalue%3Atext%28value%29%7D%3B%0A%20%20%20%20if%28Array.isArray%28value%29%29%20return%20%7Bkind%3A%27array%27%2Cidentity%3Avalue%2Cvalues%3Avalue%2Citem%3Ajson%7D%3B%0A%20%20%20%20assert.ok%28value%26%26Object.getPrototypeOf%28value%29%3D%3D%3DObject.prototype%2C%27native%20JSON%20control%20must%20be%20representable%20plain%20data%27%29%3B%0A%20%20%20%20return%20%7Bkind%3A%27object%27%2Cidentity%3Avalue%2Centries%3A%28function%2A%28%29%7Bfor%28const%20key%20of%20Object.keys%28value%29%29%20yield%20%7Bkey%3Atext%28key%29%2Ctype%3Ajson%2Cvalue%3Avalue%5Bkey%5D%7D%3B%7D%29%28%29%7D%3B%0A%20%20%7D%0A%20%20if%28type.kind%3D%3D%3D%27null%27%29%20%7Bassert.equal%28value%2Cnull%29%3Breturn%20%7Bkind%3A%27null%27%7D%3B%7D%0A%20%20if%28type.kind%3D%3D%3D%27string%27%29%20return%20%7Bkind%3A%27string%27%2Cvalue%3Atext%28value%29%7D%3B%0A%20%20if%28type.kind%3D%3D%3D%27bool%27%29%20%7Bassert.equal%28typeof%20value%2C%27boolean%27%29%3Breturn%20%7Bkind%3A%27boolean%27%2Cvalue%7D%3B%7D%0A%20%20if%28type.kind%3D%3D%3D%27usize%27%7C%7Ctype.kind%3D%3D%3D%27i64%27%29%20%7B%0A%20%20%20%20assert.ok%28typeof%20value%3D%3D%3D%27bigint%27%7C%7Ctypeof%20value%3D%3D%3D%27number%27%2C%27integer%20fixture%20must%20retain%20its%20original%20integer%27%29%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27number%27%29%20assert.ok%28Number.isSafeInteger%28value%29%2C%27use%20BigInt%20for%20large%20native%20integer%20controls%27%29%3B%0A%20%20%20%20const%20integer%3DBigInt%28value%29%3B%0A%20%20%20%20if%28type.kind%3D%3D%3D%27i64%27%29%20assert.ok%