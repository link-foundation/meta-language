20%20assert.throws%28%28%29%3D%3Epacket.parent.inverse%28packet.parent.source.replace%28%27mod%20grammar_outcome%3B%27%2C%27mod%20foreign%3B%27%29%29%29%3B%0A%20%20const%20changed%3Dpacket.parent.source.replace%28%27const%20LANGUAGE%3A%27%2C%20%27const%20OTHER_LANGUAGE%3A%27%29%3B%0A%20%20assert.notEqual%28packet.parent.inverse%28changed%29%2Cpacket.original%29%3B%0A%7D%29) (lang: meta-language%20structured%20data)))
