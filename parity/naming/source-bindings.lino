(51201: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Engine%20behind%20scripts%2Fclean-caches.mjs%3A%20discovers%20the%20cache%20classes%20of%0A%2F%2F%20cache-classes.mjs%2C%20keeps%20only%20candidates%20that%20are%20provably%20regenerable%2C%20and%0A%2F%2F%20removes%20them%20within%20the%20disk%20budget.%20See%20docs%2Fcache-cleanup.md.%0A%2F%2F%0A%2F%2F%20A%20candidate%20is%20removed%20only%20when%20every%20check%20passes%3A%0A%2F%2F%20-%20it%20is%20not%20a%20symlink%20and%20its%20real%20path%20is%20its%20own%20path%2C%20so%20nothing%20escapes%0A%2F%2F%20%20%20through%20a%20link%3B%0A%2F%2F%20-%20it%20lies%20inside%20this%20worktree%2C%20inside%20a%20Cargo%20target%20directory%20the%20caller%0A%2F%2F%20%20%20named%20explicitly%20%28recognized%20by%20CACHEDIR.TAG%29%2C%20or%20is%20a%20temporary%20directory%0A%2F%2F%20%20%20this%20repository%20marked%20as%20scratch%20and%20whose%20creator%20has%20exited%3B%0A%2F%2F%20-%20git%20reports%20it%20ignored%2C%20and%20no%20tracked%20file%20lies%20under%20it%2C%20so%20source%2C%0A%2F%2F%20%20%20vendored%20grammars%2C%20fixtures%2C%20proofs%2C%20corpora%20and%20uncommitted%20work%20stay%3B%0A%2F%2F%20-%20it%20is%20not%20evidence%20%28results%20other%20than%20their%20%60work%60%20scratch%2C%20artifacts%2C%0A%2F%2F%20%20%20logs%29%20and%20holds%20no%20other%20worktree%3B%0A%2F%2F%20-%20no%20build%20is%20active%20on%20it%3A%20no%20live%20lease%2C%20and%20no%20Cargo%20lock%20held.%0Aimport%20%7B%20execFileSync%2C%20spawnSync%20%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7B%20randomUUID%20%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7B%0A%20%20existsSync%2C%0A%20%20linkSync%2C%0A%20%20lstatSync%2C%0A%20%20mkdirSync%2C%0A%20%20readdirSync%2C%0A%20%20readFileSync%2C%0A%20%20readlinkSync%2C%0A%20%20realpathSync%2C%0A%20%20renameSync%2C%0A%20%20rmSync%2C%0A%20%20statSync%2C%0A%20%20statfsSync%2C%0A%20%20writeFileSync%2C%0A%7D%20from%20%27node%3Afs%27%3B%0Aimport%20os%20from%20%27node%3Aos%27%3B%0Aimport%20path%20from%20%27node%3Apath%27%3B%0Aimport%20%7B%20processIdentity%2C%20processIdentityAlive%2C%20sameProcess%20%7D%20from%20%27.%2Fprocess-identity.mjs%27%3B%0Aimport%20%7B%20readBootstrapStructuredDataRecords%2C%20structuredDataRecordToLino%2C%20structuredDataToLino%20%7D%20from%20%27.%2Fstructured-data-bootstrap.mjs%27%3B%0A%0Aimport%20%7B%0A%20%20BUILDKIT_BUILDER%2C%0A%20%20CACHE_CLASSES%2C%0A%20%20CONTAINER_LABEL%2C%0A%20%20isCargoTargetDirectory%2C%0A%7D%20from%20%27.%2Fcache-classes.mjs%27%3B%0A%0Aexport%20const%20DEFAULT_BUDGET_MB%20%3D%204096%3B%0Aexport%20const%20DEFAULT_MIN_FREE_MB%20%3D%202048%3B%0Aconst%20MB%20%3D%201024%20%2A%201024%3B%0Aconst%20HISTORY_LIMIT%20%3D%20200%3B%0Aconst%20DEFAULT_RESULTS_DIRECTORIES%20%3D%20%5B%27issue-195-results%27%5D%3B%0Aconst%20PROTECTED_DIRECTORIES%20%3D%20%5B%27issue-195-artifacts%27%2C%20%27ci-logs%27%2C%20%27logs%27%2C%20%27dev%2Flog%27%2C%20%27docs%27%2C%20%27parity%27%2C%20%27.git%27%5D%3B%0Aconst%20CARGO_LOCK_BUSY%20%3D%2075%3B%0A%0A%2F%2A%2A%20Runs%20git%20and%20returns%20stdout%2C%20or%20null%20when%20git%20is%20missing%20or%20fails.%20%2A%2F%0Afunction%20git%28cwd%2C%20args%29%20%7B%0A%20%20try%20%7B%0A%20%20%20%20return%20execFileSync%28%27git%27%2C%20args%2C%20%7B%20cwd%2C%20encoding%3A%20%27utf8%27%2C%20stdio%3A%20%5B%27ignore%27%2C%20%27pipe%27%2C%20%27ignore%27%5D%20%7D%29%3B%0A%20%20%7D%20catch%20%7B%0A%20%20%20%20return%20null%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20Real%20path%2C%20or%20the%20resolved%20path%20when%20it%20does%20not%20exist.%20%2A%2F%0Afunction%20real%28candidate%29%20%7B%0A%20%20try%20%7B%0A%20%20%20%20return%20realpathSync%28candidate%29%3B%0A%20%20%7D%20catch%20%7B%0A%20%20%20%20return%20path.resolve%28candidate%29%3B%0A%20%20%7D%0A%7D%0A%0Aconst%20inside%20%3D%20%28child%2C%20parent%29%20%3D%3E%20child%20%3D%3D%3D%20parent%20%7C%7C%20child.startsWith%28parent.endsWith%28path.sep%29%20%3F%20parent%20%3A%20parent%20%2B%20path.sep%29%3B%0Aconst%20strictlyInside%20%3D%20%28child%