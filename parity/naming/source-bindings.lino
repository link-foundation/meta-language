it%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20let%20source%3DreadFileSync%28new%20URL%28module.file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20for%28const%20edit%20of%20module.edits%29%7Bassert.equal%28source.slice%28edit.start%2Cedit.start%2Bedit.to.length%29%2Cedit.to%29%3Bsource%3Dsource.slice%280%2Cedit.start%29%2Bedit.from%2Bsource.slice%28edit.start%2Bedit.to.length%29%3B%7D%0A%20%20assert.equal%28source%2Cmodule.sourceText%29%3B%0A%7D%29%3B%0A%0Atest%28%27actual%20packaging%20descriptors%20remain%20distinct%20while%20every%20complete%20historical%20gate%20still%20executes%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DgenerateLibraryRelocationHistory%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20for%28const%20row%20of%20history.sources%29%7B%0A%20%20%20%20const%20actual%3DreadProjectData%28new%20URL%28row.file%2Croot%29%29%3B%0A%20%20%20%20const%20current%3DreadStructuredDataLino%28restoreCurrentCiRepairSource%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.file%29%29%2Crestored%3DrestoreNativeLibraryReceipt%28current%2Crow.identity%29%3B%0A%20%20%20%20assert.equal%28serializeProjectData%28restored%2Crow.file%29%2Crow.sourceText%29%3B%0A%20%20%20%20assert.deepEqual%28readNativeLibraryReceiptProfile%28row.identity%29%2C%7Bfile%3Arow.file%2C...row.current%7D%29%3B%0A%20%20%20%20assert.notEqual%28row.current.sha256%2Crow.sha256%29%3B%0A%20%20%20%20const%20original%3DrestoreCompleteDeclarationReceipt%28restored%2Crow.identity%29%3B%0A%20%20%20%20assert.deepEqual%28restoreCompleteDeclarationReceipt%28current%2Crow.identity%29%2Coriginal%29%3B%0A%20%20%20%20assert.deepEqual%28restoreCompleteDeclarationReceipt%28actual%2Crow.identity%29%2Coriginal%2C%27the%20complete%20actual%20successor%20also%20reaches%20every%20original%20gate%27%29%3B%0A%20%20%20%20assert.equal%28serializeProjectData%28actual%2Crow.file%29%2CreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27changed%20algorithms%20unknown%20fields%20i