ended%3D%7Bid%3A%27independent%20continuation%20input%27%2Csource%3A%27separate%20source%27%2Cname%3A%27separate%20operation%27%7D%3B%0A%20%20assert.equal%28verifyNamingSourceBindingData%28%5B...rows%2Cappended%5D%2Cmigration%2CreadFileSync%28new%20URL%28specification.module%2Croot%29%29%29.rows%2Crows.length%2B1%29%3B%0A%20%20const%20first%3Drows%5B0%5D.source%3Brows%5B0%5D.source%3D%27caller%20mutation%27%3Brows.reverse%28%29%3B%0A%20%20assert.equal%28readNamingSourceBindings%28%29%5B0%5D.source%2Cfirst%2C%27caller%20data%20cannot%20change%20the%20verified%20private%20cache%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27naming%20data%20preserves%20scalar%20code%20units%20object%20ownership%20and%20exact%20source%20literal%20spelling%20through%20both%20archive%20formats%27%2C%28%29%3D%3E%7B%0A%20%20const%20first%3D%7BsourceContext%3A%27line%5Cu2028separator%5Cud800%27%2CsourceRange%3A%7Bstart%3A0%2Cend%3A2%7D%7D%2Csecond%3D%7B...first%2CsourceRange%3A%7Bstart%3A0%2Cend%3A2%7D%7D%3B%0A%20%20const%20rows%3D%5Bfirst%2Csecond%5D%2Cliteral%3DBuffer.concat%28%5B...namingSourceBindingLiteralChunks%28rows%29%5D%29.toString%28%29%3B%0A%20%20assert.equal%28literal%2CJSON.stringify%28rows%2Cnull%2C2%29%29%3B%0A%20%20const%20encoded%3DencodeStructuredDataLinks%28rows%29%2Cnetwork%3DLinkNetwork.fromLino%28structuredDataToLino%28rows%29%29%3B%0A%20%20for%28const%20graph%20of%20%5Bnetwork%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28network%29%29%5D%29%7B%0A%20%20%20%20const%20restored%3DdecodeStructuredDataLinks%28graph%2Cencoded.root%29%3Bassert.deepEqual%28restored%2Crows%29%3B%0A%20%20%20%20assert.notEqual%28restored%5B0%5D%2Crestored%5B1%5D%29%3Bassert.notEqual%28restored%5B0%5D.sourceRange%2Crestored%5B1%5D.sourceRange%29%3B%0A%20%20%20%20assert.equal%28Buffer.concat%28%5B...namingSourceBindingLiteralChunks%28restored%29%5D%29.toString%28%29%2Cliteral%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27naming%20storage%20refuses%20missing%20reordered%20or%20changed%20original%20bind