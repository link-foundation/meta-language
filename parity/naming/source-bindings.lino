Bassert.equal%28serializeProjectData%28inverse%2CartifactFile%29%2Coriginals.get%28artifactFile%29.source%29%3B%0A%20%20for%28const%20field%20of%20%5B%27completeRust%27%2C%27owners%27%2C%27declarationNames%27%2C%27totals%27%2C%27assumptions%27%2C%27encodings%27%2C%27mappings%27%2C%27preludeHashes%27%2C%27replays%27%2C%27archive%27%5D%29assert.deepEqual%28artifact%5Bfield%5D%2Cprevious%5Bfield%5D%2Cfield%29%3B%0A%20%20const%20artifactText%3DserializeProjectData%28artifact%2CartifactFile%29%3B%0A%20%20Object.assign%28policy.edge.current%2Cpin%28artifactText%29%29%3B%0A%20%20for%28const%20change%20of%20policy.edge.changes%29%7Blet%20owner%3Dartifact%3Bfor%28const%20key%20of%20change.path%29owner%3Downer%5Bkey%5D%3Bchange.after%3DstructuredClone%28owner%29%3B%7D%0A%20%20assert.equal%28policy.edge.changes.length%2C13%29%3B%0A%20%20register.sourceDescriptorSuccessors%3D%5Bpolicy.edge%5D%3BObject.assign%28loan.predecessor%2Cpin%28artifactText%29%29%3B%0A%20%20const%20descriptorValues%3Dnew%20Map%28%5B%5BartifactFile%2Cartifact%5D%2C%5BpolicyFile%2Cpolicy%5D%2C%5BregisterFile%2Cregister%5D%2C%5BloanFile%2Cloan%5D%5D%29%3B%0A%20%20for%28const%20%5Bfile%2Cvalue%5Dof%20descriptorValues%29%7Bif%28check%29checkProjectData%28new%20URL%28file%2Croot%29%2Cvalue%29%3Belse%20writeProjectData%28new%20URL%28file%2Croot%29%2Cvalue%29%3B%7D%0A%20%20const%20helperFile%3Dnew%20URL%28%27js%2Fscripts%2Fcurrent-translation-source-descriptors.mjs%27%2Croot%29%2Chelper%3DreadFileSync%28helperFile%2C%27utf8%27%29%3B%0A%20%20const%20expected%3Dhelper.replace%28%2Fconst%20policyHash%3D%27%5Ba-f0-9%5D%7B64%7D%27%3B%2Fu%2C%22const%20policyHash%3D%27%22%2Bdigest%28readFileSync%28new%20URL%28policyFile%2Croot%29%29%29%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28helper%2Cexpected%29%3Belse%20writeFileSync%28helperFile%2Cexpected%29%3B%0A%20%20const%20sources%3DsourceFiles.map%28file%3D%3E%7B%0A%20%20%20%20const%20%7Bsource%3AsourceText%2Ccertificate%7D%3Doriginals.get%28file%29%2Ccurrent%3