dFixture%28%29%2Crow%3Dfixture.cases.find%28row%3D%3Erow.name%3D%3D%3D%27fixed%20fields%27%29%3B%0A%20%20const%20columns%3D%5Brow.types%2Crow.selectors%2Crow.offsets%2Crow.children%2Cfixture.schema.modes%2Cfixture.schema.patterns%2C%0A%20%20%20%20fixture.schema.patternOffsets%2Cfixture.schema.patternTypes%2Cfixture.schema.variantOwners%5D%3B%0A%20%20const%20expected%3D%5B-3%2C-4%2C-2%2C-6%2C-1%2C-1%2C-1%2C-1%2C-1%5D%3B%0A%20%20for%28const%20value%20of%20%5BNaN%2CInfinity%2C-Infinity%5D%29for%28let%20index%3D0%3Bindex%3Ccolumns.length%3Bindex%2B%2B%29%7B%0A%20%20%20%20const%20altered%3DstructuredClone%28columns%29%3Baltered%5Bindex%5D%5B0%5D%3Dvalue%3B%0A%20%20%20%20assert.equal%28checkOwnedOutcomeSourceTypes%28...altered%29%2Cexpected%5Bindex%5D%2C%27nonfinite%20channel%20%27%2Bindex%29%3B%0A%20%20%7D%0A%20%20const%20count%3D8192%2Coffsets%3DArray.from%28%7Blength%3Acount%2B1%7D%2C%28_%2Cindex%29%3D%3EMath.min%28index%2Ccount-1%29%29%3B%0A%20%20const%20children%3DArray.from%28%7Blength%3Acount-1%7D%2C%28_%2Cindex%29%3D%3Eindex%2B2%29%3B%0A%20%20const%20deep%3D%7Btypes%3AArray%28count%29.fill%287%29%2Cselectors%3AArray%28count%29.fill%284%29%2Coffsets%2Cchildren%7D%3Bdeep.selectors%5Bcount-1%5D%3D0%3B%0A%20%20assert.deepEqual%28checkOwnedOutcomePreorder%28offsets%2Cchildren%2Ccount%2Ccount-1%2Ccount%29%2C%5B0%2Ccount%2Ccount-1%2Ccount%5D%29%3B%0A%20%20assert.equal%28check%28fixture.schema%2Cdeep%29%2C0%29%3B%0A%20%20assert.deepEqual%28checkOwnedOutcomePreorder%28offsets%2Cchildren%2Ccount%2Ccount-1%2Ccount-1%29%2C%5B-5%2C0%2C0%2C0%5D%29%3B%0A%20%20deep.types%5Bcount-1%5D%3D0%3Bassert.equal%28check%28fixture.schema%2Cdeep%29%2C-6%29%3B%0A%7D%29%3B%0A%0Atest%28%27source%20type%20adapters%20authenticate%20captured%20plans%20before%20reading%20caller%20data%20and%20isolate%20schema%20copies%27%2C%28%29%3D%3E%7B%0A%20%20const%20ordinary%3DcaptureOrdinaryInversePlan%28%29%2Crecursive%3DextendRecursiveInversePlan%28ordinary%29%3B%0A%20%20let%20invoked%3Dfalse%3Bconst%20forg