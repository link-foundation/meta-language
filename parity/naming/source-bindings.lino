(4211: (meta: (t: semantic) (n: 1) (term: string%20value) (def: export%20function%20readGrammarRuleCompositionPolicy%28closed%20%3D%20readGrammarRuleCompositionSource%28%29%29%20%7B%0A%20%20return%20%7B%20schemaVersion%3A%201%2C%20model%3A%20%27explicit%20syntactic%20grammar%20rule%20composition%201%27%2C%0A%20%20%20%20sourcePath%2C%20source%3A%20closed.source%2C%20sourceBytes%3A%20closed.bytes%2C%20sourceSha256%3A%20closed.sourceSha256%2C%0A%20%20%20%20sourceClosure%3A%20closed.sourceClosure%2C%20decisions%3A%20closed.exports%2C%0A%20%20%20%20default%3A%20%27An%20absent%20or%20empty%20composition%20keeps%20the%20original%20grammar%20expression%20and%20default%20complete%20CST%20behavior.%27%2C%0A%20%20%20%20admission%3A%20%27A%20final%20normal%20syntactic%20rule%20accepts%20only%20one%20any-grammar%20or%20all-grammar%20expression%20with%20one%20exact%20empty%20authoring%20slot%20and%20a%20nonempty%20complete%20candidate%20list.%20The%20original%20actual%20expression%20replaces%20only%20that%20slot.%27%2C%0A%20%20%20%20candidates%3A%20%27Exact%20existing%20candidate%20and%20selector%20validation%20precedes%20the%20primitive%20facts.%20All%20candidates%20share%20field-ranges%20with%20one%20exact%20common%20selector%2C%20or%20json-string%20without%20a%20selector.%20Source%20names%20are%20nonempty%20and%20unique%3B%20candidate%20order%20and%20every%20selector%20field%20are%20retained.%27%2C%0A%20%20%20%20repetition%3A%20%27The%20complete%20validated%20ordered%20candidate%20key%20and%20outer%20mode%20determine%20whether%20the%20current%20wrapper%20is%20retained.%20A%20different%20existing%20wrapper%20remains%20the%20complete%20original%20item%3B%20no%20pointer%20or%20name-only%20marker%20establishes%20equality.%27%2C%0A%20%20%20%20sourceOwnership%3A%20%27Source-qualified%20decorator%20sets%20are%20applied%20to%20their%20actual%20grammar%20before%20resolver%20construction.%20Candidate%20source%20identities%20are%20not%20local%20rule%20references.%20Existing%20source-plane%2C%20source-view%2C%20scanner%20and%20archive%20checks%20remain%20authoritative.%27%2C%0A%20%20%20%20treeDecorators%3A%20%27Composition%20refuses%20executor%20or%20recovery%20decorators%20without%20a%20source-witness%20proof.%20The%20publication%20guard%20uses%20the%20actual%20mapped-source%20registry%20and%20effective%20tree-decorator%20presence%20to%20refuse%20mapped%20results%20before%20tree%20decoration.%20Existing%20identity-only%20tree%20decoration%20is%20unchanged.%27%2C%0A%20%20%20%20resources%3A%20%27Materialization%20retains%20the%20actual%20original%20expression.%20Runtime%20selection%2C%20recursive%20parsing%2C%20mapping%20and%20checking%20use%20the%20existing%20memory%2C%20step%2C%20depth%20and%20source%20budgets.%27%2C%0A%20%20%20%20boundary%3A%20%27Finite%20opt-in%20authoring%20decisions%20and%20complete-source%20translation%20proofs%20do%20not%20establish%20catalog%20coverage%2C%20language-CST%20validity%20or%20native%20execution.%20Those%20require%20their%20actual%20runtime%20and%20CI%20assertions.%27%20%7D%3B%0A%7D) (lang: meta-language%20structured%20data)))
