%20%27node%3Afs%27%3B%22%2C%0A%20%20%20%20%20%20to%3A%22import%20%7BappendFileSync%2C%20closeSync%2C%20fstatSync%2C%20mkdirSync%2C%20openSync%2C%20readFileSync%2C%20readSync%2C%20readdirSync%2C%20writeFileSync%2C%20writeSync%7D%20from%20%27node%3Afs%27%3B%22%7D%2C%0A%20%20%20%20%7Bfrom%3A%22import%20%7BreadStructuredDataLino%2C%20structuredDataToLino%7D%20from%20%27..%2Fsrc%2Fstructured-data-links.js%27%3B%22%2C%0A%20%20%20%20%20%20to%3A%22import%20%7BreadStructuredDataLino%2C%20structuredDataToLino%7D%20from%20%27..%2Fsrc%2Fstructured-data-links.js%27%3B%5Cnimport%20%7BreadNativeNumberControlPublication%7D%20from%20%27..%2F..%2Fexperiments%2Fgrammar-outcome-network%2Fnative-transport%2Finverse%2Fnumber-publication.mjs%27%3B%22%7D%2C%0A%20%20%20%20%7Bfrom%3A%27async%20function%20runHarness%28binary%2C%20arguments_%29%20%7B%27%2Cto%3A%60function%20readNativePublicationText%28filename%29%20%7B%0A%20%20const%20descriptor%20%3D%20openSync%28filename%2C%20%27r%27%29%3B%0A%20%20try%20%7B%0A%20%20%20%20const%20info%20%3D%20fstatSync%28descriptor%29%3B%0A%20%20%20%20requireValue%28info.isFile%28%29%20%26%26%20info.size%20%3C%3D%2016%20%2A%201024%20%2A%201024%2C%20%27native%20publication%20text%20resource%20limit%27%29%3B%0A%20%20%20%20const%20buffer%20%3D%20Buffer.alloc%28info.size%29%3B%0A%20%20%20%20let%20offset%20%3D%200%3B%0A%20%20%20%20while%20%28offset%20%3C%20buffer.length%29%20%7B%0A%20%20%20%20%20%20const%20count%20%3D%20readSync%28descriptor%2C%20buffer%2C%20offset%2C%20buffer.length%20-%20offset%2C%20null%29%3B%0A%20%20%20%20%20%20requireValue%28count%20%3E%200%2C%20%27incomplete%20retained%20native%20publication%20text%27%29%3Boffset%20%2B%3D%20count%3B%0A%20%20%20%20%7D%0A%20%20%20%20requireValue%28readSync%28descriptor%2C%20Buffer.alloc%281%29%2C%200%2C%201%2C%20null%29%20%3D%3D%3D%200%2C%20%27changed%20retained%20native%20publication%20text%20length%27%29%3B%0A%20%20%20%20return%20new%20TextDecoder%28%27utf-8%27%2C%20%7Bfatal%3A%20true%2C%20ignoreBOM%3A%20true%7D%29.decode%28buffer%29%3B%0A%20%20%7D%20finally%20%7BcloseSync%28descriptor%29%3B%7D%0A%7D%0A%0Aexport%20function%20retainNativeNumberPublication%28directory%2C%20name%2C%20receipt%29%20%7B%0A%20%20const%20testName%20%3D%20%27grammar_outcome_original_numbers%3A%3Aoriginal_borrowed_number_predicates_payloads_and_wire_positions_match_every_independent_control%27%3B%0A%20%20if%20%28receipt.identity.profile%20%21%3D%3D%20%27evidence%27%20%7C%7C%20%21receipt.selected.some%28row%20%3D%3E%20row.name%20%3D%3D%3D%20testName%29%29%20return%20false%3B%0A%20%20requireValue%28typeof%20name%20%3D%3D%3D%20%27string%27%20%26%26%20%2F%5E%5B0-9a-f%5D%7B24%7D%24%2Fu.test%28name%29%2C%20%27invalid%20native%20publication%20artifact%20identity%27%29%3B%0A%20%20const%20prefix%20%3D%20path.join%28directory%2C%20name%29%3B%0A%20%20const%20receiptSource%20%3D%20readNativePublicationText%28prefix%20%2B%20%27.lino%27%29%3B%0A%20%20const%20report%20%3D%20readNativeNumberControlPublication%28readNativePublicationText%28prefix%20%2B%20%27.stderr.log%27%29%2C%0A%20%20%20%20readNativePublicationText%28prefix%20%2B%20%27.stdout.log%27%29%2C%20receiptSource%2C%20encoded%28receipt.identity%29%29%3B%0A%20%20requireValue%28JSON.stringify%28readStructuredDataLino%28receiptSource%29%29%20%3D%3D%3D%20JSON.stringify%28receipt%29%2C%20%27the%20actual%20retained%20native%20execution%20receipt%20changed%27%29%3B%0A%20%20writeFileSync%28prefix%20%2B%20%27.original-number-publication.lino.log%27%2C%20encoded%28report%29%2C%20%7Bflag%3A%20%27wx%27%7D%29%3B%0A%20%20return%20true%3B%0A%7D%0A%0Aasync%20function%20runHarness%28binary%2C%20arguments_%29%20%7B%60%7D%2C%0A%20%20%20%20%7Bfrom%3A%27%20%20verifyHarnessExecution%28receipt%29%3B%5Cn%20%20return%20receipt.exitCode%3B%5Cn%7D%27%2C%0A%20%20%20%20%20%20to%3A%27%20%20verifyHarnessExecution%28receipt%29%3B%5Cn%20%20retainNativeNumberPublication%28current.directory%2C%20name%2C%20receipt%29%3B%5Cn%20%20return%20receipt.exitCode%3B%5Cn%7D%27%7D%2C%0A%20%20%5D%3B%0A%20%20let%20current%3Dsource%3B%0A%20%20for%28const%20action%20of%20additions%29%7Bassert.equal%28current.split%28action.from%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28action.from%2Caction.to%29%3B%7D%0A%20%20let%20inverse%3Dcurrent%3Bfor%28const%20action%20of%20%5B...additions%5D.reverse%28%29%29%7Bassert.equal%28inverse.split%28action.to%29.length%2C2%29%3Binverse%3Dinverse.replace%28action.to%2Caction.from%29%3B%7D%0A%20%20assert.equal%28inverse%2Csource%2C%27every%20original%20scheduling%20selection%20native%20command%20verification%20and%20sealing%20byte%20survives%27%29%3B%0A%20%20const%20tree%3DparseNative%28%27native-javascript%27%2Ccurrent%29%3Bassert.equal%28tree.hasError%2Cfalse%29%3Bassert.equal%28tree.end%2CBuffer.byteLength%28current%29%29%3B%0A%20%20const%20receipt%3D%7BschemaVersion%3A1%2Crevision%3Aoriginal.certificate.revision%2Csources%3A%5B%7Bfile%2Ccommit%3Aoriginal.certificate.revision%2C...pin%28original.blob%29%2CsourceText%3Asource%2Ccertificate%3Aoriginal.certificate%2Ccurrent%3Apin%28current%29%2Cactions%3Aadditions%7D%5D%2C%0A%20%20%20%20boundary%3A%27Add%20bounded%20retained-text%20reads%20and%20a%20post-verification%20artifact%20only%20for%20the%20selected%20current%20native%20number%20control%20in%20the%20evidence%20profile.%20The%20original%20command%20inventory%20output%20digest%20selection%20result%20and%20complete%20physical%20seal%20algorithms%20remain%20exact.%20Derived%20artifacts%20are%20reproducible%20from%20sealed%20raw%20inputs%3B%20they%20are%20not%20independent%20CI%20authentication%20or%20complete%20native%20reconstruction.%27%7D%3B%0A%20%20const%20output%3Dnew%20URL%28%27..%2F..%2F..%2F..%2Fparity%2Fself-translation%2Fnative-number-publication-runner.lino%27%2Cimport.meta.url%29%3B%0A%20%20if%28check%29%7Bassert.equal%28readFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%2Ccurrent%29%3BcheckProjectData%28output%2Creceipt%29%3B%7D%0A%20%20else%7BwriteFileSync%28new%20URL%28file%2Croot%29%2Ccurrent%29%3BwriteProjectData%28output%2Creceipt%29%3B%7D%0A%20%20return%20receipt%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateNativeNumberPublicationRunner%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Generated%20additive%20native%20number%20artifact%20retention%20while%20conserving%20every%20complete%20original%20runner%20byte.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
