(13384: (meta: (t: semantic) (n: 1) (term: string%20value) (def: export%20function%20buildIntegration%28root%3Drepository%29%20%7B%0A%20%20%2F%2F%20This%20reauthenticates%20all%20B94%20source%20pins%2C%20aliases%2C%20imports%2C%20root%20paths%20and%0A%20%20%2F%2F%20every%20one%20of%20the%20nine%20declarations%20before%20emitting%20any%20private%20output.%0A%20%20const%20packet%3DbuildOutcomePacket%28root%29%3B%0A%20%20const%20original%3DreadFileSync%28resolve%28root%2CparentPath%29%2C%27utf8%27%29%3B%0A%20%20const%20parent%3DproposeParent%28original%29%3B%0A%20%20const%20template%3DreadFileSync%28new%20URL%28%27.%2Fsinks.rs%27%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20const%20oldNotice%3D%27%2F%2F%20PRIVATE%20GENERATED%20PROPOSAL%3B%20no%20concrete%20sink%20or%20native%20execution.%5Cn%27%0A%20%20%20%20%2B%27%2F%2F%20One%20ordered%20borrowed%20visitor%20drives%20CountSink%28Node%3D%28%29%29%20and%20DirectSink%28Node%3DLinkId%29.%5Cn%27%0A%20%20%20%20%2B%27%2F%2F%20Recursive%20control%20flow%20below%20is%20NOT%20an%20arbitrary-depth%20resource%20proof.%5Cn%27%3B%0A%20%20assert.ok%28packet.source.startsWith%28oldNotice%29%2C%27exact%20unchanged%20generated%20visitor%20notice%27%29%3B%0A%20%20const%20notice%3D%27%2F%2F%20Generated%20exact%20borrowed%20declaration%20transport.%20Native%20execution%20remains%20unverified.%5Cn%27%0A%20%20%20%20%2B%27%2F%2F%20Recursive%20visitor%20admission%20is%20explicitly%20bounded%20to%20depth%20limits%20at%20most%20256.%5Cn%27%3B%0A%20%20const%20child%3Dtemplate%2B%27%5Cn%27%2Bnotice%2Bpacket.source.slice%28oldNotice.length%29%3B%0A%20%20assert.ok%28%21child.includes%28%27.clone%28%27%29%26%26%21child.includes%28%27to_value%27%29%26%26%21child.includes%28%27from_json%28%27%29%29%3B%0A%20%20assert.ok%28%21child.includes%28%27StructuredDataValue%27%29%26%26%21child.includes%28%27%20as%20f64%27%29%29%3B%0A%20%20assert.ok%28child.split%28%27%5Cn%27%29.length%3C1000%2C%27bounded%20source%20owner%27%29%3B%0A%20%20return%20%7Boriginal%