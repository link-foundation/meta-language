SourceTextRustBlock%28text%2C%27fn%27%2C%27construct_variant_%27%2Bindex%2B%27_%27%2BvariantIndex%29%3B%0A%20%20%20%20%20%20checkNativeConstructorSourceBindings%28body%2Cvariant.fields%3F%3F%5B%5D%2Cfields.map%28row%3D%3Erow.typeReference%29%2CbyId%29%3B%0A%20%20%20%20%20%20assert.ok%28body.includes%28operation.storage.rust%2B%27%3A%3A%27%2Bvariant.name%29%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20operation%3Dinventory.operations.find%28row%3D%3Erow.fields%3F.length%3E1%29%2Cindex%3Dinventory.operations.indexOf%28operation%29%2Ctext%3Dtexts.get%28%27part_%27%2BMath.floor%28index%2F24%29%2B%27.rs%27%29%3B%0A%20%20const%20body%3DreadSourceTextRustBlock%28text%2C%27fn%27%2C%27construct_%27%2Bindex%29%2Cfield%3Doperation.fields%5B0%5D%3B%0A%20%20const%20changed%3Dbody.replace%28field.name%2B%27%3A%20field_0%27%2Cfield.name%2B%27%3A%20field_1%27%29%3Bassert.notEqual%28changed%2Cbody%29%3B%0A%20%20assert.throws%28%28%29%3D%3EcheckNativeConstructorSourceBindings%28changed%2Coperation.fields%2Coperation.fields.map%28row%3D%3Erow.typeReference%29%2CbyId%29%29%3B%0A%7D%29) (lang: meta-language%20structured%20data)))
