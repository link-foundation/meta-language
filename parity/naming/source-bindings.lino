nsport%2Finverse%2Fgenerate-original-number-observations.mjs%27%2C...pin%28readFileSync%28new%20URL%28import.meta.url%29%29%29%7D%2C%0A%20%20%20%20byteRangeReader%3A%7Bfile%3A%27js%2Fscripts%2Fnative-source-byte-ranges.mjs%27%2C...pin%28readFileSync%28new%20URL%28%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fnative-source-byte-ranges.mjs%27%2Cimport.meta.url%29%29%29%7D%2C%0A%20%20%20%20originalVisitors%3Apacket.source%2Ctrait%3A%7Bbefore%3Atrait%2Cafter%3AextendedTrait%7D%2CjsonVisitor%3A%7Bbefore%3AjsonVisitor%2Cafter%3AobservedVisitor%7D%2Ccallback%2C%0A%20%20%20%20observationDeclaration%2CobservationMethod%2Cstorage%3A%7B...storage%2Cafter%3AobservedStorage%7D%2Cinherent%3ArenamedInherent%2Cimplementation%3A%7B...renamedImplementation%2Cafter%3AobservedImplementation%7D%2C%0A%20%20%20%20relocation%2CrawModel%3Araw%2Coutputs%3Aoutputs.map%28%28%7Bfile%2Csource%7D%29%3D%3E%28%7Bfile%2C...pin%28source%29%7D%29%29%2C%0A%20%20%20%20limits%3A%7BnodeLimit%3A100000%2CbyteLimit%3A16%2A1024%2A1024%2CdepthLimit%3A256%7D%2C%0A%20%20%20%20counterBoundary%3A%27The%20complete%20original%20allocation-free%20preflight%20precedes%20observation%20construction.%20Primitive%20usize%20and%20i64%20conversion%20calls%20retain%20json_number%3B%20only%20original%20serde_json%3A%3AValue%3A%3ANumber%20uses%20native_json_number.%20Raw%20predicate%20and%20payload%20accessors%20execute%20before%20the%20unchanged%20projection%20validator.%27%7D%7D%3B%0A%7D%0A%0Aexport%20function%20generateOriginalNativeNumberObservations%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20lockSource%3DreadFileSync%28new%20URL%28%27rust%2FCargo.lock%27%2Croot%29%2C%27utf8%27%29%2Cpackages%3DparseCargoLock%28lockSource%29.filter%28row%3D%3Erow.name%3D%3D%3D%27serde_json%27%29%3B%0A%20%20assert.equal%28packages.length%2C1%29%3Bassert.equal%28packages%5B0%5D.version%2C%271.0.151%27%2C%27uncovered%20native%20number%20expectation%20dependency%20version%27%29%3B%0A%20%20const%20result%3DbuildOriginalNativeNumberObservati