.%2F..%2F%27%2Cimport.meta.url%29%29%29%29%29%2Cbefore%29%3B%0A%7D%29%3B%0A%0Atest%28%27standalone%20immutable%20commands%20retain%20their%20strict%20live-successor%20refusals%20and%20the%20source%20loader%20refuses%20update%20arguments%27%2C%28%29%3D%3E%7B%0A%20%20for%28const%20file%20of%20SCHEMA_COMMAND_SOURCE_PROFILE.files%29%7B%0A%20%20%20%20const%20original%3DspawnSync%28process.execPath%2C%5B%27--max-old-space-size%3D288%27%2Cfile%2C%27--check%27%5D%2C%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2Ctimeout%3A15000%2CmaxBuffer%3A262144%7D%29%3B%0A%20%20%20%20assert.equal%28original.error%2Cundefined%29%3Bassert.equal%28original.signal%2Cnull%29%3Bassert.equal%28original.status%2C1%29%3Bassert.match%28original.stderr%2C%2F145652%20%21%3D%3D%20153938%2Fu%29%3B%0A%20%20%20%20const%20refused%3DspawnSync%28process.execPath%2C%5B%27--import%27%2CfileURLToPath%28new%20URL%28%27..%2Fscripts%2Fschema-command-source-loader.mjs%27%2Cimport.meta.url%29%29%2Cfile%2C%27--write%27%5D%2C%0A%20%20%20%20%20%20%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2Ctimeout%3A10000%2CmaxBuffer%3A262144%7D%29%3B%0A%20%20%20%20assert.equal%28refused.error%2Cundefined%29%3Bassert.equal%28refused.signal%2Cnull%29%3Bassert.equal%28refused.status%2C1%29%3Bassert.match%28refused.stderr%2C%2Fcheck-only%2Fu%29%3B%0A%20%20%7D%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
