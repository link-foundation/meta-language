%3D%3D%3D%27historical%20descriptor%27%29%7B%0A%20%20%20%20%20%20const%20value%3DreadProjectData%28new%20URL%28row.file%2Croot%29%29%3B%0A%20%20%20%20%20%20assert.equal%28serializeProjectData%28restoreArrayRelativeElementProjectData%28value%2Crow.file%29%2Crow.file%29%2Crow.sourceText%29%3B%0A%20%20%20%20%20%20const%20corrupt%3DstructuredClone%28value%29%3Bcorrupt.unreviewed%3Dtrue%3B%0A%20%20%20%20%20%20assert.throws%28%28%29%3D%3ErestoreArrayRelativeElementProjectData%28corrupt%2Crow.file%29%2Cassert.AssertionError%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20file%3D%27experiments%2Foriginal-link-complete-table-projection%2Fdata%2Fraw-consuming-current-native-definitions.lino%27%3B%0A%20%20const%20current%3DreadProjectData%28new%20URL%28file%2Croot%29%29%2Cprevious%3DrestoreArrayRelativeElementProjectData%28current%2Cfile%29%3B%0A%20%20for%28const%20field%20of%20%5B%27completeRust%27%2C%27owners%27%2C%27declarationNames%27%2C%27totals%27%2C%27assumptions%27%2C%27encodings%27%2C%27mappings%27%2C%27preludeHashes%27%2C%27replays%27%2C%27archive%27%5D%29assert.deepEqual%28current%5Bfield%5D%2Cprevious%5Bfield%5D%2Cfield%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20original%20array%20input%20is%20retained%20while%20the%20wrong%20unsupported%20expectation%20has%20explicit%20standard%20bounds%27%2C%28%29%3D%3E%7B%0A%20%20assert.equal%28history.assertionCorrection.input%2C%27%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20values%20%40returns%20%7Bnumber%7Cundefined%7D%20%2A%2Ffunction%20last%28values%29%7Breturn%20values.at%28-1%29%3B%7D%27%29%3B%0A%20%20assert.deepEqual%28history.assertionCorrection.languageVersions%2C%7Bminimum%3A%272022%27%2CmaximumExclusive%3A%272027%27%7D%29%3B%0A%20%20const%20row%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3Dhistory.assertionCorrection.file%29%3B%0A%20%20assert.ok%28row.sourceText.includes%28history.assertionCorrection.input%29%29%3B%0A%20%20assert.ok%28row.sourceText.includes%28%27assert.throws%28%28%29%3D%3EcheckProgram%28parseJ