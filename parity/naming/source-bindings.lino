eration.%20Keep%20the%20original%20input%20and%20predecessor%20source%3B%20require%20its%20independently%20observed%20present%20and%20absent%20results.%27%7D%2C%0A%20%20%20%20boundary%3A%27Whole%20predecessor%20sources%20and%20descriptors%20only.%20Every%20recorded%20native%20definition%20ABI%20owner%20replay%20archive%20and%20original%20assertion%20remains.%20Current%20execution%20and%20descriptor%20gates%20read%20current%20data%3B%20historical%20views%20invert%20only%20complete%20authenticated%20inputs.%20No%20native%20execution%20or%20global%20equivalence%20claim.%27%7D%3B%0A%20%20const%20file%3Dnew%20URL%28%27parity%2Fself-translation%2Farray-relative-element-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28file%2Chistory%29%3Belse%20writeProjectData%28file%2Chistory%29%3B%0A%20%20const%20adapter%3Dnew%20URL%28%27js%2Fscripts%2Farray-relative-element-history.mjs%27%2Croot%29%2Ctext%3DreadFileSync%28adapter%2C%27utf8%27%29%3B%0A%20%20const%20pinned%3Dtext.replace%28%2Fconst%20historyHash%3D%27%5Ba-f0-9%5D%7B64%7D%27%3B%2Fu%2C%22const%20historyHash%3D%27%22%2Bdigest%28readFileSync%28file%29%29%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28text%2Cpinned%29%3Belse%20writeFileSync%28adapter%2Cpinned%29%3B%0A%20%20return%20history%3B%0A%7D) (lang: meta-language%20structured%20data)))
