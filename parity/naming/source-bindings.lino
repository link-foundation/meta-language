Rust%28program%2Coptions%29%3B%0A%20%20assert.equal%28emitted.definitions.length%2Cinventory.length%29%3B%0A%20%20for%28const%20owner%20of%20inventory%29%20assert.equal%28emitted.mappings.filter%28row%3D%3Erow.source%3D%3D%3Downer.fullName%0A%20%20%20%20%26%26row.kind%3D%3D%3D%28owner.kind%3D%3D%3D%27fn%27%3F%27function%27%3Aowner.kind%29%29.length%2C1%2C%27one%20complete%20mapping%3A%20%27%2Bowner.fullName%29%3B%0A%20%20const%20packet%3DencodeTypedProgramLinks%28program%29%2CrecordCount%3Dpacket.network.links%28%29.length%3B%0A%20%20assert.ok%28recordCount%3E0%26%26recordCount%3C%3D1_000_000%2C%27the%20complete%20source%20archive%20has%20an%20explicit%20bounded%20record%20census%27%29%3B%0A%20%20const%20binaryLimits%3D%7BrecordLimit%3ArecordCount%2CbyteLimit%3A64%2A1024%2A1024%7D%3B%0A%20%20const%20text%3Dpacket.network.toLino%28%29%2Cbinary%3DencodeLinkNetworkBinary%28packet.network%2CbinaryLimits%29%3B%0A%20%20assert.ok%28Buffer.byteLength%28text%29%3C%3DbinaryLimits.byteLimit%29%3B%0A%20%20const%20replays%3D%5B%5D%3B%0A%20%20for%28const%20format%20of%20%5B%27text%27%2C%27binary%27%5D%29%20%7B%0A%20%20%20%20const%20network%3Dformat%3D%3D%3D%27text%27%3FLinkNetwork.fromLino%28text%29%3AdecodeLinkNetworkBinary%28binary%2CbinaryLimits%29%3B%0A%20%20%20%20assert.equal%28network.links%28%29.length%2CrecordCount%29%3B%0A%20%20%20%20const%20restored%3DrecheckLinkedTypedProgram%28decodeTypedProgramLinks%28network%2Cpacket.root%29%2C%7BwholeProgram%3Atrue%7D%29%3B%0A%20%20%20%20assert.deepEqual%28restored.items.map%28row%3D%3Erow.fullName%29%2Cinventory.map%28row%3D%3Erow.fullName%29%29%3B%0A%20%20%20%20const%20replay%3DemitRust%28restored%2Coptions%29%3B%0A%20%20%20%20for%28const%20field%20of%20%5B%27text%27%2C%27definitions%27%2C%27preludes%27%2C%27mappings%27%2C%27assumptions%27%2C%27encodings%27%5D%29assert.deepEqual%28replay%5Bfield%5D%2Cemitted%5Bfield%5D%2C%0A%20%20%20%20%20%20%27the%20entire%20source-free%20emitted%20%27%2Bfield%2B%27%20agrees%20after%20%27%2Bformat%29%3B%0A%20%20%20%20replays.push%28%7Bformat%2Cowners%3Arestored.declarations.size%2CemittedBytes%3ABuffer.byteLength%28replay.text%29%2CemittedSha256%3Adigest%28replay.text%29%7D%29%3B%0A%20%20%7D%0A%20%20const%20files%3DwriteRecordRuleLibrary%28emitted%2C%27link_network_binary_buffer_rules%27%2C%7Bcheck%7D%29%3B%0A%20%20const%20artifact%3D%7BschemaVersion%3A1%2Cmodel%3A%27owned%20binary%20framing%20field%20buffers%201%27%2C%0A%20%20%20%20inputs%3A%5BsourceFile%2CprimitiveFile%2CoriginalFile%5D.map%28path%3D%3E%7Bconst%20bytes%3DreadFileSync%28new%20URL%28path%2Croot%29%29%3Breturn%7Bpath%2Cbytes%3Abytes.length%2Csha256%3Adigest%28bytes%29%7D%3B%7D%29%2C%0A%20%20%20%20sourceClosure%3A%7Bsource%2Cbytes%3ABuffer.byteLength%28source%29%2Csha256%3Adigest%28source%29%2CremovedImport%3Aimported%7D%2C%0A%20%20%20%20options%2Cinventory%2CdefinitionCount%3Ainventory.length%2Cemitted%3A%7Btext%3Aemitted.text%2Cbytes%3ABuffer.byteLength%28emitted.text%29%2Csha256%3Adigest%28emitted.text%29%2C%0A%20%20%20%20%20%20mappings%3Aemitted.mappings%2Cassumptions%3Aemitted.assumptions%2Cencodings%3Aemitted.encodings%7D%2C%0A%20%20%20%20library%3Afiles.map%28row%3D%3E%28%7Bpath%3Arow.path%3F%3F%27link_network_binary_buffer_rules.rs%27%2Cbytes%3ABuffer.byteLength%28row.source%29%2Csha256%3Adigest%28row.source%29%7D%29%29%2C%0A%20%20%20%20archive%3A%7BrecordCount%2CbinaryLimits%2CtextBytes%3ABuffer.byteLength%28text%29%2CtextSha256%3Adigest%28text%29%2CbinaryBytes%3Abinary.byteLength%2CbinarySha256%3Adigest%28binary%29%7D%2C%0A%20%20%20%20replays%2CnativeCompilation%3Afalse%2CnativeExecution%3Afalse%2C%0A%20%20%20%20boundary%3A%27All%20complete%20primitive%20and%20framing%20owners%2C%20actual%20final-use%20array%20moves%20and%20both%20complete%20checked-program%20archives.%20Native%20runtime%20parity%20and%20full-grammar%20timing%20remain%20CI%20evidence.%27%7D%3B%0A%20%20if%28check%29checkProjectData%28artifactFile%2Cartifact%29%3Belse%20writeProjectData%28artifactFile%2Cartifact%29%3