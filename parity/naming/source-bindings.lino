ndings%28body%2Cvariant.fields%3F%3F%5B%5D%2Cfields.map%28row%3D%3Erow.typeReference%29%2CbyId%29%3B%0A%20%20%20%20%20%20assert.ok%28body.includes%28operation.storage.rust%2B%27%3A%3A%27%2Bvariant.name%29%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20operation%3Dinventory.operations.find%28row%3D%3Erow.fields%3F.length%3E1%29%2Cindex%3Dinventory.operations.indexOf%28operation%29%2Ctext%3Dtexts.get%28%27part_%27%2BMath.floor%28index%2F24%29%2B%27.rs%27%29%3B%0A%20%20const%20body%3DreadSourceTextRustBlock%28text%2C%27fn%27%2C%27construct_%27%2Bindex%29%2Cfield%3Doperation.fields%5B0%5D%3B%0A%20%20const%20changed%3Dbody.replace%28field.name%2B%27%3A%20field_0%27%2Cfield.name%2B%27%3A%20field_1%27%29%3Bassert.notEqual%28changed%2Cbody%29%3B%0A%20%20assert.throws%28%28%29%3D%3EcheckNativeConstructorSourceBindings%28changed%2Coperation.fields%2Coperation.fields.map%28row%3D%3Erow.typeReference%29%2CbyId%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27all%20constructor%20branches%20have%20complete%20typed%20controls%20and%20malformed%20child%20or%20lifetime%20labels%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Binventory%7D%3DnativeConstructorContext%28%29%2Ccontrols%3DbuildNativeConstructorStorageControls%28inventory%29%3B%0A%20%20assert.deepEqual%28controls%2CreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fnative-constructor-storage.lino%27%2Cimport.meta.url%29%29%29%3B%0A%20%20assert.deepEqual%28%5B...new%20Set%28controls.cases.map%28row%3D%3Erow.sourceReference%29%29%5D%2Ccontrols.sourceReferences%29%3B%0A%20%20for%28const%20row%20of%20controls.cases%29%7Bassert.ok%28checkNativeConstructorControl%28inventory%2Crow.recipe%29%3E0%29%3Bassert.equal%28row.expectedStorageType%2Cinventory.operations.find%28operation%3D%3Eoperation.sourceReference%3D%3D%3Drow.sourceReference%29.storage.rust%29%3B%7D%0A%20%20for%28const%20operation%20of%20inventory.operations%29%7B%0A%20%20%20%20const%20cases%3Dcontrols.cases.filter%28row%3D%3Erow.sourceReference%3D%3D%3Doperation.