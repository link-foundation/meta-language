%7D%0A%20%20const%20changed%3Ddecorator.matches.filter%28row%3D%3Erow.changed%29%3B%0A%20%20assert.deepEqual%28changed.map%28row%3D%3Erow.javascript.reason%29.sort%28%29%2C%5B%27unknownGrammar%27%2C%27unsupportedEmbeddingMapping%27%5D%29%3B%0A%20%20assert.deepEqual%28changed.find%28row%3D%3Erow.javascript.reason%3D%3D%3D%27unknownGrammar%27%29.javascript.keys%2C%5B%27language%27%2C%27start%27%2C%27end%27%2C%27reason%27%5D%29%3B%0A%20%20assert.deepEqual%28changed.find%28row%3D%3Erow.javascript.reason%3D%3D%3D%27unsupportedEmbeddingMapping%27%29.javascript.keys%2C%5B%27language%27%2C%27start%27%2C%27end%27%2C%27reason%27%2C%27mapping%27%5D%29%3B%0A%20%20assert.ok%28corrected.includes%28decorator.unmatchedNative%5B0%5D.source%29%2C%27unmatched%20guard%20remains%20byte-exact%27%29%3B%0A%20%20assert.equal%28Buffer.byteLength%28corrected%29%2CBuffer.byteLength%28original%28nativePath%29%29%29%3B%0A%20%20const%20normal%3DserializeProjectData%28decorator%2C%27decorator.lino%27%29%3B%0A%20%20assert.deepEqual%28readStructuredDataLino%28normal%29%2Cdecorator%2C%27shared%20Links%20policy%20retains%20the%20complete%20source%2Fcontext%20archive%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27one%20generated%20decorator%20supplies%20separate%20production%20and%20frozen%20overlay%20receipts%20and%20exact%20whole-source%20inverses%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bdecorator%2Ccorrected%7D%3Dcurrent%28%29%3B%0A%20%20for%28const%20role%20of%20%5B%27production%27%2C%27frozen%20CI%20overlay%27%5D%29%20%7B%0A%20%20%20%20const%20forward%3DapplyDiagnosticOrderDecorator%28original%28nativePath%29%2Cdecorator%2C%7Brole%7D%29%3B%0A%20%20%20%20assert.equal%28forward.source%2Ccorrected%29%3Bassert.equal%28forward.receipt.role%2Crole%29%3Bassert.equal%28forward.receipt.inverseVerified%2Ctrue%29%3B%0A%20%20%20%20assert.deepEqual%28forward.receipt.preservedBaselinePins%2Cdecorator.baselinePins%29%3B%0A%20%20%20%20const%20inverse%3DapplyDiagnosticOrderDecorator%28forward.source%2Cdecorator%2C%7Brole%2Cdirection%3A%27inverse%27%7D%29%3B%0A%20%20%20%20assert.equal%28inverse.source%2Coriginal%28nativePath%29%29%3Bassert.equal%28inverse.receipt.inverseVerified%2Ctrue%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27whole%20source%2C%20conditional%20contexts%2C%20spread%20bindings%2C%20keys%20and%20policy%20tampering%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bdecorator%7D%3Dcurrent%28%29%2Cjavascript%3Doriginal%28javascriptPath%29%2Cnative%3Doriginal%28nativePath%29%3B%0A%20%20for%28const%20changed%20of%20%5B%0A%20%20%20%20javascript.replace%28%22if%20%28%21program%29%20%7B%22%2C%22if%20%28program%29%20%7B%22%29%2C%0A%20%20%20%20javascript.replace%28%27const%20diagnostic%20%3D%27%2C%27let%20diagnostic%20%3D%27%29%2C%0A%20%20%20%20javascript.replace%28%27%7B%20...diagnostic%2C%20reason%20%7D%27%2C%27%7B%20reason%2C%20...diagnostic%20%7D%27%29%0A%20%20%5D%29%20%7Bassert.notEqual%28changed%2Cjavascript%29%3Bassert.throws%28%28%29%3D%3EderiveDiagnosticOrderDecorator%28changed%2Cnative%29%2C%2Fauthenticated%2Fu%29%3B%7D%0A%20%20assert.throws%28%28%29%3D%3EderiveDiagnosticOrderDecorator%28javascript%2Cnative%2B%27%5Cn%27%29%2C%2Fauthenticated%2Fu%29%3B%0A%20%20for%28const%20change%20of%20%5B%0A%20%20%20%20value%3D%3E%7Bvalue.edits%5B0%5D.after%3Dvalue.edits%5B0%5D.before%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.matches%5B0%5D.javascript.contexts%3D%5B%5D%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.unmatchedNative%3D%5B%5D%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.baselinePins%5BnativePath%5D%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.inputs%5B0%5D.source%2B%3D%27%5Cn%27%3B%7D%0A%20%20%5D%29%20%7Bconst%20value%3DstructuredClone%28decorator%29%3Bchange%28value%29%3Bassert.throws%28%28%29%3D%3EapplyDiagnosticOrderDecorator%28native%2Cvalue%2C%7Brole%3A%27production%27%7D%29%29%3B%7D%0A%20%20assert.throws%28%28%29%3D%3EapplyDiagnosticOrderDecorator%28native%2Cdecorator%2C%7Brole%3A%27unqualified%27%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3Eapply