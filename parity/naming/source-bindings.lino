(57068: (meta: (t: semantic) (n: 1) (term: string%20value) (def: export%20function%20readGlobalGrammarContextSourcePair%28file%29%20%7B%0A%20%20const%20profile%3DGLOBAL_GRAMMAR_CONTEXT_SOURCE_PROFILE%3B%0A%20%20assert.ok%28profile.files.includes%28file%29%2C%27an%20exact%20registered%20context%20source%20owner%20is%20required%27%29%3B%0A%20%20if%28%21sourcePairs%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28profile.path%2Croot%29%29%3Bassert.equal%28pin%28bytes%29.sha256%2Cprofile.sha256%2C%27complete%20independently%20pinned%20context%20source%20recipe%27%29%3B%0A%20%20%20%20const%20packet%3DreadProjectData%28new%20URL%28profile.path%2Croot%29%29%3B%0A%20%20%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.revision%2Cprofile.revision%29%3B%0A%20%20%20%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2Cprofile.files%29%3B%0A%20%20%20%20const%20pairs%3Dnew%20Map%28%29%3B%0A%20%20%20%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20%20%20%20%20const%20original%3DBuffer.from%28row.sourceText%29%3Bassert.ok%28original.length%3C%3D131072%2C%27bounded%20complete%20context%20source%27%29%3B%0A%20%20%20%20%20%20assert.equal%28row.commit%2Cprofile.revision%29%3B%0A%20%20%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2Coriginal%2C%7Brevision%3Aprofile.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28original%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20%20%20let%20source%3Drow.sourceText%3B%0A%20%20%20%20%20%20for%28const%20action%20of%20row.actions%29%7Bassert.equal%28source.split%28action.before%29.length%2C2%29%3Bsource%3Dsource.replace%28action.before%2Caction.after%29%3B%7D%0A%20%20%20%20%20%20assert.deepEqual%28pin%28source%29%2Crow.proposed%29%3Bassert.ok%28Buffer.byteLength%28source%29%3C%3D131072%29%3B%0A%20%20%20%20%20%20let%20inverse%3Dsource%3B%0A%20%20%20%20%20%20for%28const%20action%20of%20row.actions.toReversed%28%29%29%7Bassert.equal%28inverse.split%28action.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28action.after%2Caction.before%29%3B%7D%0A%20%20%20%20%20%20assert.equal%28inverse%2Crow.sourceText%2C%27the%20entire%20original%20context%20source%20stays%20exact%27%29%3B%0A%20%20%20%20%20%20pairs.set%28row.file%2C%7Bfile%3Arow.file%2Crevision%3Aprofile.revision%2C%0A%20%20%20%20%20%20%20%20predecessor%3A%7Bsource%3Arow.sourceText%2C...pin%28original%29%7D%2Csuccessor%3A%7Bsource%2C...pin%28source%29%7D%2Cactions%3Arow.actions%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20sourcePairs%3Dpairs%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28sourcePairs.get%28file%29%29%3B%0A%7D) (lang: meta-language%20structured%20data)))
