ngth%20counts%20UTF-16%20code%20units%2C%20which%20the%20portable%20string%20types%20do%20not%20keep%20at%2028..36%27%3B%0A%20assert.ok%28oldLiterals.includes%28oldStringDiagnostic%29%29%3B%0A%20const%20sources%3D%5B...originals%2CreadNativeSourceLiteral%28bases%5B1%5D.source%2C%27utf16_string_length_retains_supplementary_characters_in_each_target%27%29%2C%0A%20%20readNativeSourceLiteral%28bases%5B1%5D.source%2C%27out_of_bounds_array_reads_retain_absence_instead_of_an_in_bounds_assumption%27%29%5D%3B%0A%20const%20expected%3D%5B%0A%20%20%7Boutcome%3A%27admitted%27%2Cstdout%3A%274%5Cn3n%5Cn%27%7D%2C%7Boutcome%3A%27admitted%27%2Cstdout%3A%273%5Cn%27%7D%2C%7Boutcome%3A%27admitted%27%2Cstdout%3A%272%5Cn%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27exact%27%2Cdiagnostic%3A%27text%20of%20an%20array%3A%20console.log%20lays%20an%20array%20out%20with%20util.inspect%20and%20String%20joins%20its%20elements%20with%20commas%2C%20which%20the%20translation%20does%20not%20reproduce%20yet%3B%20print%20the%20elements%20one%20by%20one%20at%2031..33%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27exact%27%2Cdiagnostic%3A%27reference%20mutation%3A%20this%20mutation%20requires%20its%20shared%20reference%20and%20slot%20operations%20to%20be%20represented%20at%2019..28%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27exact%27%2Cdiagnostic%3A%27comparison%20of%20arrays%3A%20%3D%3D%3D%20of%20two%20arrays%20compares%20which%20array%20each%20is%2C%20which%20a%20value%20translation%20does%20not%20keep%3B%20compare%20their%20elements%20at%2031..40%27%7D%2C%0A%20%20%7Boutcome%3A%27admitted%27%2Cstdout%3A%272%5Cn%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27prefix%27%2Cdiagnostic%3A%27array%20hole%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27prefix%27%2Cdiagnostic%3A%27for%E2%80%A6in%20loop%27%7D%2C%0A%20%20%7Boutcome%3A%27admitted%27%2Cstdout%3A%274%5Cn%27%7D%2C%7Boutcome%3A%27admitted%27%2Cstdout%3A%279%5Cn%27%7D%2C%0A%20%5D%3B%0A%20return%20%7B