0%20%20%20%7D%0A%20%20%7D%0A%20%20const%20restored%3DBuffer.from%28structuredDataToLino%28inverse%29%29%3B%0A%20%20assert.equal%28restored.length%2Cselected.edge.previous.bytes%29%3B%0A%20%20assert.equal%28hash%28restored%29%2Cselected.edge.previous.sha256%2C%27only%20recorded%20provenance%20changes%20may%20differ%20in%20the%20entire%20previous%20artifact%27%29%3B%0A%20%20return%7Bartifact%3Ainverse%2Cregister%3ApreviousRegister%7D%3B%0A%7D%0A%0Aexport%20function%20readHistoricalTranslationSourceDescriptorRegister%28%29%7B%0A%20%20return%20restoreCurrentTranslationSourceDescriptors%28null%2C%27historical%20register%27%2CreadProjectData%28registerFile%29%29.register%3B%0A%7D%0A%0Aexport%20function%20projectHistoricalTranslationSourceDescriptorArtifact%28artifact%29%7B%0A%20%20artifact%3DrestoreNativeLibraryReceipt%28artifact%2C%27raw%20consuming%27%29%3B%0A%20%20const%20selected%3DreadSourceDescriptorPolicy%28%29%2Cbytes%3DBuffer.from%28structuredDataToLino%28artifact%29%29%3B%0A%20%20assert.ok%28%5Bselected.edge.current.sha256%2Cselected.edge.previous.sha256%5D.includes%28hash%28bytes%29%29%2C%0A%20%20%20%20%27a%20historical%20descriptor%20view%20requires%20one%20complete%20registered%20artifact%27%29%3B%0A%20%20return%20restoreCurrentTranslationSourceDescriptors%28artifact%2Cselected.edge.identity%2CreadProjectData%28registerFile%29%29.artifact%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
