w%20Map%28%29%3B%0A%20%20%20%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20%20%20%20%20const%20bytes%3DBuffer.from%28row.source%29%3Bassert.ok%28bytes.length%3C%3D131072%29%3B%0A%20%20%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2Cbytes%2C%7Brevision%3Aspecification.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28bytes%29%2Crow.original%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28row.view%2CderiveSchemaCommandSourceView%28row.file%2Crow.source%2Crow.certificate%29.receipt%29%3B%0A%20%20%20%20%20%20checked.set%28row.file%2Crow%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20sources%3Dchecked%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28sources.get%28file%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Only%20the%20schema%20read%20and%20its%20explicit%20validating%20import%20change.%20Every%20other%0A%20%2A%20original%20source%20byte%2C%20assertion%2C%20immutable%20source%20owner%20and%20refusal%20remains.%20%2A%2F%0Aexport%20function%20deriveSchemaCommandSourceView%28file%2Csource%2Ccertificate%29%20%7B%0A%20%20assert.ok%28SCHEMA_COMMAND_SOURCE_PROFILE.files.includes%28file%29%29%3Bassert.equal%28typeof%20source%2C%27string%27%29%3Bassert.ok%28Buffer.byteLength%28source%29%3C%3D131072%29%3B%0A%20%20verifyGitArtifactCertificate%28certificate%2CBuffer.from%28source%29%2C%7Brevision%3ASCHEMA_COMMAND_SOURCE_PROFILE.revision%2Cpath%3Afile%7D%29%3B%0A%20%20const%20anchor%3D%22import%20%7BreadStructuredDataLino%7D%20from%20%27..%2Fsrc%2Fstructured-data-links.js%27%3B%5Cn%22%3B%0A%20%20const%20addition%3D%22import%20%7BreadStringOrderSchemaPredecessor%7D%20from%20%27.%2Fcheck-typed-program-schema-history.mjs%27%3B%5Cn%22%3B%0A%20%20const%20second%3Dfile%3D%3D%3DSCHEMA_COMMAND_SOURCE_PROFILE.files%5B0%5D%3B%0A%20%20const%20actions%3D%5B%7Bbefore%3Aanchor%2Cafter%3Aanchor%2Baddition%7D%2Csecond%3F%0A%20%20%20%20%7Bbefore%3A%27let%20actualBytes%20%3D%20readFileSync%28schemaFile%29%3B%27%2Cafter%3A%27let%20actualBytes%20%3D%20readStringOrderS