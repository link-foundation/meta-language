urceText.replace%28history.before%2Chistory.after%29%29%3B%0A%20%20%20%20assert.equal%28restoreWindowsLinkerLookupHistory%28current%29%2Coriginal.sourceText%29%3B%0A%20%20%20%20assert.equal%28readActualWindowsLinkerLookup%28file%2Cidentifier%29%2CreadActualWindowsLinkerLookup%28%27.github%2Fworkflows%2Frust.yml%27%2C%27test%27%29%29%3B%0A%20%20%7D%0A%20%20const%20source%3DreadActualWindowsLinkerLookup%28%27.github%2Fworkflows%2Frust.yml%27%2C%27test%27%29%3B%0A%20%20const%20expected%3D%27C%3A%5C%5CProgram%20Files%5C%5CVisual%20Studio%5C%5CVC%5C%5Cbin%5C%5CHostx64%5C%5Cx64%5C%5Clink.exe%27%3B%0A%20%20const%20other%3D%27C%3A%5C%5CProgram%20Files%5C%5CGit%5C%5Cusr%5C%5Cbin%5C%5Clink.exe%27%3B%0A%20%20const%20success%3D%7Bstatus%3A0%2Csignal%3Anull%2Cstdout%3Aexpected%2B%27%5Cr%5Cn%27%2Bother%2B%27%5Cr%5Cn%27%2Cstderr%3A%27%27%7D%3B%0A%20%20const%20timeout%3D%7Bstatus%3Anull%2Csignal%3A%27SIGTERM%27%2Cstdout%3A%27%27%2Cstderr%3A%27%27%2Cerror%3AObject.assign%28new%20Error%28%27spawnSync%20where.exe%20ETIMEDOUT%27%29%2C%7Bcode%3A%27ETIMEDOUT%27%7D%29%7D%3B%0A%20%20for%28let%20failed%3D0%3Bfailed%3C%3D2%3Bfailed%2B%2B%29%7B%0A%20%20%20%20const%20result%3DexecuteWindowsLinkerLookup%28source%2C%5B...Array%28failed%29.fill%28timeout%29%2Csuccess%5D%2Cexpected%29%3B%0A%20%20%20%20assert.equal%28result.error%2Cundefined%29%3Bassert.equal%28result.calls.length%2Cfailed%2B1%29%3B%0A%20%20%20%20assert.deepEqual%28result.output%2C%5B%27Validated%20Windows%20native%20child%20linker%3A%20%27%2Bexpected%5D%29%3B%0A%20%20%20%20assert.equal%28result.diagnostics.length%2Cfailed%29%3B%0A%20%20%20%20for%28const%20%5Bat%2Cmessage%5Dof%20result.diagnostics.entries%28%29%29assert.equal%28message%2C%27Retrying%20timed-out%20Windows%20linker%20lookup%20%28%27%2B%28at%2B1%29%2B%27%2F3%29%3A%20spawnSync%20where.exe%20ETIMEDOUT%27%29%3B%0A%20%20%20%20for%28const%20call%20of%20result.calls%29assert.deepEqual%28call%2C%7Bcommand%3A%27where.exe%27%2Cargs%3A%5B%27link.exe%27%5D%2Coptions%3A%7Bencodin