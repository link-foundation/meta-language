(25541: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Translates%20meta-language%27s%20own%20modules%20between%20JavaScript%2C%20TypeScript%20and%0A%2F%2F%20Rust%20through%20meta-language%20links.%20The%20source%20is%20parsed%20losslessly%20with%20its%0A%2F%2F%20native%20grammar%3B%20a%20translation%20into%20the%20same%20language%20writes%20the%20links%20back%0A%2F%2F%20byte%20for%20byte%2C%20and%20a%20translation%20into%20the%20other%20language%20translates%20each%0A%2F%2F%20top-level%20item%20the%20portable%20core%20can%20express%20and%20carries%20every%20other%20item%0A%2F%2F%20verbatim%20in%20a%20marked%20comment.%20Both%20kinds%20of%20item%20keep%20their%20source%20as%0A%2F%2F%20provenance%2C%20so%20translating%20an%20unedited%20translation%20back%20restores%20the%0A%2F%2F%20source%20byte%20for%20byte.%0Aimport%20%7B%20createHash%20%7D%20from%20%27node%3Acrypto%27%3B%0A%0Aimport%20%7B%20decoratorSet%20%7D%20from%20%27.%2Fdecorators.js%27%3B%0Aimport%20%7B%20decorateEmitted%20%7D%20from%20%27.%2Fgrammar-emitters%2Fcommon.js%27%3B%0Aimport%20%7B%20LinkNetwork%20%7D%20from%20%27.%2Fnetwork.js%27%3B%0Aimport%20%7B%20ParseConfiguration%20%7D%20from%20%27.%2Fprimitives.js%27%3B%0Aimport%20%7B%20parseProgrammingLanguage%20%7D%20from%20%27.%2Fprogramming-language-parser.js%27%3B%0Aimport%20%7B%20acceptSelfTranslationUtf16Member%2C%20requireSelfTranslationUtf16Representation%20%7D%20from%20%27.%2Fself-translation-representation-rules.js%27%3B%0Aimport%20%7B%20checkProgram%20%7D%20from%20%27.%2Ftranslation%2Fcheck.js%27%3B%0Aimport%20%7B%20TranslationError%20%7D%20from%20%27.%2Ftranslation%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20emitJavaScript%20%7D%20from%20%27.%2Ftranslation%2Femit-javascript.js%27%3B%0Aimport%20%7B%20emitRust%2C%20emitRustConstants%20%7D%20from%20%27.%2Ftranslation%2Femit-rust.js%27%3B%0Aimport%20%7B%20parseJavaScript%20%7D%20from%20%27.%2Ftranslation%2Fjavascript.js%27%3B%0Aimport%20%7B%20requiresReferenceSemantics%20%7D%20from%20