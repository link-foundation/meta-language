9%3B%0A%20%20assert.equal%28policy.sourceSha256%2C%20applicabilityDigest%28kernel%29%29%3B%0A%20%20assert.deepEqual%28policy.sourceClosure%2C%20%7B%0A%20%20%20%20source%2C%20sourceSha256%3A%20revision.sourceClosure.sha256%2C%20bytes%3A%20revision.sourceClosure.bytes%2C%0A%20%20%20%20removedImports%3A%20%5Brevision.sourceClosure.removedImport%5D%2C%0A%20%20%20%20inputs%3A%20%5BfactPath%2C%20kernelPath%5D.map%28path%20%3D%3E%20%28%7B%20path%2C%20source%3A%20text%28path%29%2C%20sourceSha256%3A%20applicabilityDigest%28sources%5Bpath%5D%29%2C%20bytes%3A%20sources%5Bpath%5D.length%20%7D%29%29%2C%0A%20%20%7D%29%3B%0A%20%20const%20artifact%20%3D%20readStructuredDataLino%28text%28%27parity%2Fself-translation%2Fcollection-construction-rules-native.lino%27%29%29%3B%0A%20%20assert.equal%28artifact.model%2C%20policy.model%29%3B%0A%20%20assert.deepEqual%28artifact.sourceClosure%2C%20policy.sourceClosure%29%3B%0A%20%20assert.equal%28artifact.inventory.length%2C%20revision.sourceClosure.checkedOwners%29%3B%0A%20%20assert.equal%28artifact.checkedNamedSourceInventory.length%2C%20revision.sourceClosure.checkedOwners%29%3B%0A%20%20assert.deepEqual%28artifact.inventory.filter%28row%20%3D%3E%20row.kind%20%3D%3D%3D%20%27fn%27%20%26%26%20%21row.generated%29.map%28row%20%3D%3E%20row.name%29%2C%20functions%29%3B%0A%20%20assert.deepEqual%28artifact.checkedNamedSourceInventory.map%28%28%7B%20fullName%2C%20modulePath%2C%20...row%20%7D%29%20%3D%3E%20row%29%2C%20artifact.inventory%29%3B%0A%20%20assert.equal%28artifact.emittedTextBytes%2C%20Buffer.byteLength%28artifact.emitted.text%29%29%3B%0A%20%20assert.equal%28artifact.emittedTextSha256%2C%20applicabilityDigest%28artifact.emitted.text%29%29%3B%0A%20%20assert.deepEqual%28artifact.replays.map%28row%20%3D%3E%20row.format%29%2C%20%5B%27text%27%2C%20%27binary%27%5D%29%3B%0A%20%20for%20%28const%20replay%20of%20artifact.replays%29%20%7B%0A%20%20%20%20assert.deepEqual%28replay.checkedNamedSourceInventory%2C%20artifact.checkedNamedSourceInventory%29%3B%