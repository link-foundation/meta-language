(33336: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Bind%20explicit%20supplied%20number%20payloads%20to%20complete%20checked%20source%20occurrences.%0A%2F%2F%20This%20reader%20cannot%20turn%20supplied%20records%20into%20observations%20of%20original%20objects.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7Btypes%7D%20from%20%27node%3Autil%27%3B%0Aimport%20%7BprojectOrdinaryOutcome%7D%20from%20%27.%2Fowned.mjs%27%3B%0Aimport%20%7BreadOwnedOutcomeNativeNumberProfile%7D%20from%20%27.%2Fnumber-profile.mjs%27%3B%0Aimport%20%7BreadOwnedOutcomeNativeNumberKind%7D%20from%20%27.%2Fnumber-kind-rules.mjs%27%3B%0Aimport%20%7BacceptOwnedOutcomeIntegerProjection%7D%20from%20%27.%2Finteger-projection-rules.mjs%27%3B%0A%0Afunction%20readPassiveNumberFactData%28input%29%20%7B%0A%20%20const%20pending%3D%5Binput%5D%2Cseen%3Dnew%20Set%28%29%3Blet%20nodes%3D0%2Cbytes%3D0%3B%0A%20%20while%28pending.length%29%7B%0A%20%20%20%20const%20value%3Dpending.pop%28%29%3Bassert.ok%28%2B%2Bnodes%3C%3D1000000%2C%27number%20fact%20metadata%20node%20limit%27%29%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27string%27%29%7B%0A%20%20%20%20%20%20assert.ok%28value.length%3C%3D33554432-bytes%2C%27number%20fact%20metadata%20byte%20limit%27%29%3B%0A%20%20%20%20%20%20bytes%2B%3DBuffer.byteLength%28value%29%3Bassert.ok%28bytes%3C%3D33554432%2C%27number%20fact%20metadata%20byte%20limit%27%29%3Bcontinue%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%28value%3D%3D%3Dnull%7C%7C%5B%27number%27%2C%27boolean%27%2C%27undefined%27%5D.includes%28typeof%20value%29%29continue%3B%0A%20%20%20%20assert.ok%28typeof%20value%3D%3D%3D%27object%27%26%26%21types.isProxy%28value%29%2C%27passive%20number%20fact%20data%20required%27%29%3B%0A%20%20%20%20assert.ok%28%5BObject.prototype%2CArray.prototype%5D.includes%28Object.getPrototypeOf%28value%29%29%2C%27plain%20number%20fact%20data%20required%27%29%3B%0A%20%20%20%20assert.ok%28%21seen.has%28value%29%2C%27number%20fact%20containers%20cannot%20alias%20or%20cycle%27%29%3Bseen.add%28value%29%3B%0A%20%20%20%20if%28Array.isArray%28value%29%29assert.ok%28value.length%2Bnodes%2Bpending.length%3C%3D1000000%2C%27number%20fact%20array%20reservation%20limit%27%29%3B%0A%20%20%20%20const%20keys%3DReflect.ownKeys%28value%29%3Bassert.ok%28keys.length%2Bnodes%2Bpending.length%3C%3D1000000%2C%27number%20fact%20metadata%20node%20limit%27%29%3B%0A%20%20%20%20for%28const%20key%20of%20keys%29%7B%0A%20%20%20%20%20%20assert.equal%28typeof%20key%2C%27string%27%2C%27symbolic%20number%20fact%20fields%20refuse%27%29%3B%0A%20%20%20%20%20%20const%20descriptor%3DObject.getOwnPropertyDescriptor%28value%2Ckey%29%3Bassert.ok%28Object.hasOwn%28descriptor%2C%27value%27%29%2C%27number%20fact%20accessors%20refuse%27%29%3B%0A%20%20%20%20%20%20pending.push%28descriptor.value%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20A%20contract%20over%20supplied%20native%20facts%3B%20an%20actual%20producer%20remains%20required.%20%2A%2F%0Aexport%20function%20planOwnedOutcomeNativeNumbers%28authority%2Cmodel%2Cfacts%2CcompilerInputs%2Coptions%3D%7B%7D%29%20%7B%0A%20%20readPassiveNumberFactData%28facts%29%3BreadPassiveNumberFactData%28compilerInputs%29%3B%0A%20%20const%20profile%3DreadOwnedOutcomeNativeNumberProfile%28compilerInputs%29%3B%0A%20%20projectOrdinaryOutcome%28authority%2Cmodel%2Coptions%29%3B%0A%20%20assert.equal%28profile.compilerProfile.usizeBits%2Cmodel.targetProfile.usizeBits%2C%27actual%20selected%20target%20profile%20must%20match%20the%20checked%20owned%20model%27%29%3B%0A%20%20assert.ok%28Array.isArray%28model.jsonRequirements%29%2C%27the%20recursive%20source%20profile%20must%20declare%20every%20unresolved%20number%20occurrence%27%29%3B%0A%20%20assert.ok%28Array.isArray%28facts%29%26%26facts.length%3D%3D%3Dmodel.jsonRequirements.length%26%26facts.length%3C%3D100000%2C%27one%20supplied%20fact%20per%20original%20number%20occurrence%27%29%3B%0A%20%20assert.deepEqual%28Reflect.ownKeys%28facts%29%2C%5B...facts.map%28%28_%2Cindex%29%3D%3EString%28index%29%29%2C%27length%27%5D%2C%27dense%20closed%20number%20fact%20sequence%20required%27%29%3B%0A%20%20const%20selections%3D%5B%5D%3B%0A%20%20for%28let%20index%3D0%3Bindex%3Cfacts.length%3Bindex%2B%2B%29%7B%0A%20%20%20%20const%20fact%3Dfacts%5Bindex%5D%2Crequired%3Dmodel.jsonRequirements%5Bindex%5D%3B%0A%20%20%20%20assert.ok%28fact%26%26Object.getPrototypeOf%28fact%29%3D%3D%3DObject.prototype%29%3B%0A%20%20%20%20assert.deepEqual%28Reflect.ownKeys%28fact%29%2C%5B%27node%27%2C%27typeReference%27%2C%27signed%27%2C%27unsigned%27%2C%27floating%27%2C%27payload%27%5D%2C%27complete%20closed%20native%20number%20fact%20required%27%29%3B%0A%20%20%20%20assert.equal%28fact.node%2Crequired.node%2C%27native%20number%20fact%20occurrence%20order%20and%20ownership%20must%20match%27%29%3B%0A%20%20%20%20assert.equal%28fact.typeReference%2Crequired.typeReference%2C%27native%20number%20fact%20must%20name%20the%20actual%20source%20type%27%29%3B%0A%20%20%20%20const%20kind%3DreadOwnedOutcomeNativeNumberKind%28true%2Cprofile.version%2Cprofile.arbitraryPrecision%2Cfact.signed%2Cfact.unsigned%2Cfact.floating%29%3B%0A%20%20%20%20assert.notEqual%28kind%2C%27%27%2C%27native%20number%20predicates%20must%20select%20one%20supported%20representation%27%29%3B%0A%20%20%20%20assert.equal%28typeof%20fact.payload%2C%27string%27%29%3Bassert.ok%28fact.payload.length%3C%3D20%2C%27bounded%20exact%20native%20number%20payload%20required%27%29%3B%0A%20%20%20%20const%20projected%3DBuffer.from%28required.bits%2C%27hex%27%29.readDoubleBE%28%29%3B%0A%20%20%20%20if%28kind%3D%3D%3D%27floating%20point%27%29%7B%0A%20%20%20%20%20%20assert.match%28fact.payload%2C%2F%5E%5B0-9a-f%5D%7B16%7D%24%2Fu%2C%27exact%20binary64%20bits%20required%27%29%3B%0A%20%20%20%20%20%20assert.equal%28fact.payload%2Crequired.bits%2C%27native%20floating%20payload%20and%20projected%20bits%20must%20match%20exactly%27%29%3B%0A%20%20%20%20%7Delse%7B%0A%20%20%20%20%20%20assert.equal%28fact.payload.startsWith%28%27-%27%29%2Ckind%3D%3D%3D%27signed%20integer%27%2C%27the%20selected%20native%20signed%20variant%20is%20strictly%20negative%27%29%3B%0A%20%20%20%20%20%20assert.ok%28acceptOwnedOutcomeIntegerProjection%28fact.payload%2Ckind%3D%3D%3D%27signed%20integer%27%2C64%2Cprojected%29%2C%0A%20%20%20%20%20%20%20%20%27the%20original%20exact%20integer%20decimal%20must%20survive%20binary64%20projection%20without%20rounding%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20selections.push%28%7Bnode%3Arequired.node%2CtypeReference%3Arequired.typeReference%2Ckind%2Cpayload%3Afact.payload%2CprojectedBits%3Arequired.bits%7D%29%3B%0A%20%20%7D%0A%20%20return%7BschemaVersion%3A1%2Cmodel%3A%27source%20occurrence%20native%20number%20payload%20contract%201%27%2CplanSha256%3Aauthority.sha256%2C%0A%20%20%20%20compilerProfile%3Aprofile.compilerProfile%2Cselections%2C%0A%20%20%20%20boundary%3A%27Checked%20supplied%20payload%20contracts%20only.%20Exact%20source%20occurrence%2C%20selected%20compiler%20profile%2C%20native%20variant%20and%20projected%20bits%20agree.%20Original%20object%20capture%2C%20live%20execution%20provenance%2C%20complete%20native%20DTO%20construction%20and%20physical%20CST%20ownership%20are%20not%20supplied.%27%7D%3B%0A%7D%0A%0Aexport%20function%20checkOwnedOutcomeNativeNumberPlan%28authority%2Cmodel%2Cfacts%2CcompilerInputs%2Cselection%2Coptions%3D%7B%7D%29%20%7B%0A%20%20readPassiveNumberFactData%28selection%29%3B%0A%20%20assert.deepEqual%28selection%2CplanOwnedOutcomeNativeNumbers%28authority%2Cmodel%2Cfacts%2CcompilerInputs%2Coptions%29%2C%0A%20%20%20%20%27every%20supplied%20native%20number%20selection%20must%20reconstruct%20from%20the%20complete%20checked%20model%20and%20original%20payload%20contract%27%29%3B%0A%20%20return%20selection%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
