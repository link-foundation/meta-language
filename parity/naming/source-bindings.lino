20stays%20exact%27%29%3B%0A%20%20let%20inverse%20%3D%20styled.source%3B%0A%20%20for%20%28const%20action%20of%20%5B...styled.actions%5D.reverse%28%29%29%20%7B%0A%20%20%20%20assert.equal%28action.op%2C%20%27replace%27%29%3B%20assert.equal%28action.field%2C%20%27source%27%29%3B%0A%20%20%20%20assert.equal%28inverse.split%28action.to%29.length%2C%202%2C%20%27a%20whole%20styled%20function%20has%20exactly%20one%20inverse%27%29%3B%0A%20%20%20%20inverse%20%3D%20inverse.replace%28action.to%2C%20%28%29%20%3D%3E%20action.from%29%3B%0A%20%20%7D%0A%20%20assert.equal%28inverse%2C%20source%2C%20%27every%20complete%20predecessor%20byte%20is%20recovered%27%29%3B%0A%20%20const%20receipt%20%3D%20%7Bversion%3A%201%2C%20profile%3A%20%27borrowed%20consuming%27%2C%20options%2C%0A%20%20%20%20predecessor%3A%20%7B...descriptor%28storedBytes%29%2C%20source%3A%20descriptor%28source%29%7D%2C%0A%20%20%20%20source%3A%20descriptor%28styled.source%29%2C%20definitionCount%3A%20106%2C%0A%20%20%20%20declarationNames%3A%20stored.declarationNames%2C%20publicEntryHeader%3A%20header%28source%29%2C%0A%20%20%20%20decisions%3A%20decisions.map%28file%20%3D%3E%20%28%7Bfile%2C%20...descriptor%28read%28new%20URL%28file%2C%20root%29%29%29%7D%29%29%2C%0A%20%20%20%20styles%3A%20styled.actions.map%28action%20%3D%3E%20%28%7Bname%3A%20names%28action.from%29%5B0%5D%2C%0A%20%20%20%20%20%20before%3A%20descriptor%28action.from%29%2C%20after%3A%20descriptor%28action.to%29%7D%29%29%2C%0A%20%20%20%20cloneCalls%3A%20%7Bbefore%3A%20cloneCalls%28source%29%2C%20after%3A%20cloneCalls%28styled.source%29%7D%2C%0A%20%20%20%20columnLoans%3Acolumns.record%2C%0A%20%20%20%20nativeCompilation%3A%20false%2C%20nativeExecution%3A%20false%2C%0A%20%20%20%20boundary%3A%20%27Exact%20mechanical%20parameter%20styles%20and%20whole%20predecessor%20inverse%3B%20no%20native%20timing%20or%20execution%20claim.%27%7D%3B%0A%20%20assert.ok%28receipt.cloneCalls.after%20%3C%20receipt.cloneCalls.before%29%3B%0A%20%20if%20%28check%29%20checkProjectData%28ORIGI