(51115: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Retain%20the%20complete%20inputs%20of%20historical%20controls%20after%20current%20CI%20repairs.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%2CwriteFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BcaptureGitArtifactCertificate%7D%20from%20%27.%2Fcapture-git-artifact-certificate.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BreadProjectData%2CcheckProjectData%2CwriteProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0A%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%2Crevision%3D%27d1232503fb38246f7e28f5d414c882a70944b38b%27%3B%0Aconst%20pin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20arrayHistory%3DreadProjectData%28new%20URL%28%27parity%2Fself-translation%2Farray-relative-element-history.lino%27%2Croot%29%29%3B%0Aconst%20rangeHistory%3DreadProjectData%28new%20URL%28%27parity%2Fself-translation%2Foriginal-number-source-range-history.lino%27%2Croot%29%29%3B%0A%0A%2F%2A%2A%20Freeze%20exact%20predecessor%20views%3B%20no%20current%20artifact%20or%20implementation%20is%20rewritten.%20%2A%2F%0Aexport%20function%20generateContinuationHistoricalInputs%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20profiles%3Dnew%20Map%28%29%3B%0A%20%20const%20include%3D%28file%2Cprofile%2Cexpected%29%3D%3E%7B%0A%20%20%20%20const%20entry%3Dprofiles.get%28file%29%3F%3F%7Bprofiles%3A%5B%5D%2Cexpected%7D%3B%0A%20%20%20%20assert.deepEqual%28entry.expected%2Cexpected%29%3Bentry.profiles.push%28profile%29%3Bprofiles.set%28file%2Centry%29%3B%0A%20%20%7D%3B%0A%20%20for%28const%20row%20of%20arrayHistory.sources%29include%28row.file%2C%27relative%20array%27%2Crow.current%29%3B%0A%20%20%2F%2F%20This%20library%20is%20an%20input%20of%20the%20old%20descriptor%20generator%2C%20not%20one%20of%20its%0A%20%20%2F%2F%20outputs.%20Its%20current%20packaging%20is%20verified%20by%20the%20independent%20current%20gate.%0A%20%20const%20library%3D%27parity%2Fself-translation%2Fcollection-construction-rules-native.lino%27%3B%0A%20%20include%28library%2C%27relative%20array%27%2Cpin%28captureGitArtifactCertificate%28revision%2Clibrary%29.blob%29%29%3B%0A%20%20for%28const%20row%20of%20rangeHistory.sources%29include%28row.file%2C%27original%20number%20source%20ranges%27%2Crow.current%29%3B%0A%20%20for%28const%20row%20of%20rangeHistory.unchanged%29include%28row.file%2C%27original%20number%20source%20ranges%27%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20include%28rangeHistory.previousReceipt.file%2C%27original%20number%20source%20ranges%27%2CrangeHistory.currentReceipt%29%3B%0A%20%20const%20sources%3D%5B%5D%3B%0A%20%20for%28const%20%5Bfile%2C%7Bprofiles%3Aroles%2Cexpected%7D%5Dof%20profiles%29%7B%0A%20%20%20%20const%20actual%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20%20%20if%28pin%28actual%29.sha256%3D%3D%3Dexpected.sha256%29continue%3B%0A%20%20%20%20const%20original%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%2CsourceText%3Doriginal.blob.toString%28%27utf8%27%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28original.certificate%2Coriginal.blob%2C%7Brevision%2Cpath%3Afile%7D%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28original.blob%29%2Cexpected%2C%27the%20complete%20historical%20input%20is%20independently%20pinned%27%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.from%28sourceText%29%2Coriginal.blob%29%3B%0A%20%20%20%20let%20start%3D0%2Cend%3DsourceText.length%2Cfinish%3Dactual.length%3B%0A%20%20%20%20while%28start%3Cend%26%26start%3Cfinish%26%26sourceText%5Bstart%5D%3D%3D%3Dactual%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20while%28end%3Estart%26%26finish%3Estart%26%26sourceText%5Bend-1%5D%3D%3D%3Dactual%5Bfinish-1%5D%29%7Bend--%3Bfinish--%3B%7D%0A%20%20%20%20%2F%2F%20Common%20prefixes%2Fsuffixes%20may%20split%20a%20surrogate%20pair%3B%20keep%20each%20edit%20on%0A%20%20%20%20%2F%2F%20UTF-8%20scalar%20boundaries%20so%20every%20saved%20spelling%20has%20an%20exact%20byte%20inverse.%0A%20%20%20%20if%28start%3E0%26%26%2F%5B%5CuDC00-%5CuDFFF%5D%2Fu.test%28sourceText%5Bstart%5D%3F%3F%27%27%29%29start--%3B%0A%20%20%20%20if%28end%3CsourceText.length%26%26%2F%5B%5CuDC00-%5CuDFFF%5D%2Fu.test%28sourceText%5Bend%5D%3F%3F%27%27%29%29%7Bend%2B%2B%3Bfinish%2B%2B%3B%7D%0A%20%20%20%20const%20edit%3D%7BoffsetUnit%3A%27UTF-8%20bytes%27%2Cstart%3ABuffer.byteLength%28actual.slice%280%2Cstart%29%29%2Cend%3ABuffer.byteLength%28actual.slice%280%2Cfinish%29%29%2C%0A%20%20%20%20%20%20removed%3AsourceText.slice%28start%2Cend%29%2Cinserted%3Aactual.slice%28start%2Cfinish%29%7D%3B%0A%20%20%20%20const%20bytes%3DBuffer.from%28actual%29%2Cinverse%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.removed%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20assert.ok%28inverse.equals%28original.blob%29%29%3B%0A%20%20%20%20sources.push%28%7Bfile%2Cprofiles%3Aroles%2Ccommit%3Arevision%2C...expected%2CsourceText%2Ccertificate%3Aoriginal.certificate%2Ccurrent%3Apin%28actual%29%2Cedit%7D%29%3B%0A%20%20%7D%0A%20%20const%20value%3D%7BschemaVersion%3A1%2Crevision%2Crun%3A39389240046%2Csources%2C%0A%20%20%20%20boundary%3A%27Exact%20historical%20input%20views%20only.%20Current%20implementations%20and%20artifacts%20retain%20independent%20current%20gates.%20Unknown%20successors%20are%20never%20authenticated%20by%20these%20views.%20Every%20original%20historical%20assertion%20and%20its%20complete%20input%20remain%20required.%20This%20record%20proves%20source%20preservation%2C%20not%20native%20execution%20or%20semantic%20equivalence.%27%7D%3B%0A%20%20const%20output%3Dnew%20URL%28%27parity%2Fself-translation%2Fci-39389240046-historical-inputs.lino%27%2Croot%29%3B%0