ks%20without%20parser%20state%27%2C%28%29%3D%3E%7B%0A%20%20generateConcreteProgramOriginFixtures%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20%7Bfixture%7D%3DgenerateConcreteProgramGraphFixtures%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20for%28const%20row%20of%20fixture.cases%29%7B%0A%20%20%20%20const%20packet%3DcreateConcreteProgramLinks%28row.source%2Crow.language%2C%7Butf16Strings%3Atrue%7D%29%3B%0A%20%20%20%20for%28const%20network%20of%20%5BLinkNetwork.fromLino%28packet.network.toLino%28%29%29%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28packet.network%29%29%5D%29%7B%0A%20%20%20%20%20%20const%20before%3Dnetwork.toLino%28%29%2Corigin%3DreadConcreteProgramOriginText%28network%2Cpacket.root%29%3B%0A%20%20%20%20%20%20assert.equal%28origin.language%2Crow.language%29%3Bassert.equal%28origin.plane%2C%27source%27%29%3Bassert.equal%28origin.text%2Crow.source%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28Buffer.from%28origin.bytes%29%2CBuffer.from%28row.source%29%29%3Bassert.equal%28network.toLino%28%29%2Cbefore%29%3B%0A%20%20%20%20%20%20if%28row.language%3D%3D%3D%27TypeScript%27%29%7B%0A%20%20%20%20%20%20%20%20const%20lowered%3DreadConcreteProgramOriginText%28network%2Cpacket.root%2C%7Bplane%3A%27lowered%27%7D%29%3B%0A%20%20%20%20%20%20%20%20assert.equal%28lowered.language%2C%27JavaScript%27%29%3Bassert.ok%28lowered.text.includes%28%27%40param%27%29%29%3B%0A%20%20%20%20%20%20%20%20assert.equal%28lowered.text.includes%28%27value%3A%20string%27%29%2Cfalse%29%3B%0A%20%20%20%20%20%20%7Delse%20assert.throws%28%28%29%3D%3EreadConcreteProgramOrigin%28network%2Cpacket.root%2C%7Bplane%3A%27lowered%27%7D%29%2C%2Fmissing%20lowering%2Fu%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27origin%20reads%20keep%20the%20stored%20source%20after%20semantic%20edits%20and%20nested%20selected%20Rust%20models%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DoriginalPacket%28%29%2Cnetwork%3DLinkNetwork.fromLino%28packet.network.toLino%28%29%29%3B%0A%20%20const%20operation%3Dnetwork.fiel