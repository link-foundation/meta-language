%20push%28%7Bkind%3A%27value%27%2Ctype%3Aframe.item%2Cvalue%2Cdepth%3Adepth%2B1%7D%29%3Bcontinue%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%28frame.kind%3D%3D%3D%27endPair%27%29%20%7Byield%20%7Bkind%3A%27endPair%27%2Cdepth%7D%3Bcontinue%3B%7D%0A%20%20%20%20const%20result%3Dclassify%28plan%2Cframe.type%2Cframe.value%29%3B%0A%20%20%20%20if%28result.kind%21%3D%3D%27object%27%26%26result.kind%21%3D%3D%27array%27%29%20%7Byield%20%7B...result%2Cdepth%7D%3Bcontinue%3B%7D%0A%20%20%20%20assert.ok%28%21active.has%28result.identity%29%2C%27cyclic%20native%20control%20fixture%27%29%3B%0A%20%20%20%20yield%20%7Bkind%3Aresult.kind%2Cdepth%7D%3B%20%2F%2F%20Budget%20sink%20sees%20this%20BEFORE%20child%20frames.%0A%20%20%20%20active.add%28result.identity%29%3B%0A%20%20%20%20push%28%7Bkind%3A%27end%27%2Cidentity%3Aresult.identity%2Carray%3Aresult.kind%3D%3D%3D%27array%27%2Cdepth%7D%29%3B%0A%20%20%20%20if%28result.kind%3D%3D%3D%27array%27%29%20push%28%7Bkind%3A%27items%27%2Cvalues%3Aresult.values%2Citem%3Aresult.item%2Cindex%3A0%2Cdepth%7D%29%3B%0A%20%20%20%20else%20push%28%7Bkind%3A%27fields%27%2Centries%3Aresult.entries%2Cdepth%7D%29%3B%0A%20%20%7D%0A%20%20yield%20%7Bkind%3A%27root%27%2Cdepth%3A0%7D%3B%20%2F%2F%20Existing%20Encoder%20inserts%20schema%20root%20last.%0A%7D) (lang: meta-language%20structured%20data)))
