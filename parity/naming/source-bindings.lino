nal.source%7D%29%2C%0A%20%20%20%20%7Bcapture%3Arelative%2Csource%3Acurrent%7D%2Crelative%2B%27%3A%20complete%20forward%20correction%27%29%3B%0A%20%20assert.deepEqual%28DecoratorSet.fromLino%28profile.reverseDecorators%29.decorate%28%27emitter%27%2C%7Bcapture%3Arelative%2Csource%3Acurrent%7D%29%2C%0A%20%20%20%20%7Bcapture%3Arelative%2Csource%3Aoriginal.source%7D%2Crelative%2B%27%3A%20complete%20reverse%20correction%27%29%3B%0A%20%20return%20Buffer.from%28original.source%29%3B%0A%7D) (lang: meta-language%20structured%20data)))
