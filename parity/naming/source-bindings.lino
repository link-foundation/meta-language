%2C%27children%27%29%3Bassert.equal%28tokens%5Bindex%2B4%5D.kind%2C%27string%27%29%3B%0A%20%20%20%20const%20reference%3Dtokens%5Bindex%2B4%5D.value%2Cexpected%3DbyId.get%28reference%29%3Bassert.ok%28expected%29%3B%0A%20%20%20%20assert.equal%28tokens%5Bindex%2B6%5D.value%2Cexpected.storage.carrier%29%3B%0A%20%20%20%20assert.equal%28tokens%5Bindex%2B8%5D%3F.value%3D%3D%3D%27boxed%27%2Cexpected.storage.boxed%29%3B%0A%20%20%20%20return%5Breference%5D%3B%0A%20%20%7D%29%3B%0A%20%20assert.deepEqual%28calls%2Creferences%2C%27each%20actual%20source%20child%20is%20consumed%20exactly%20once%20in%20source%20order%27%29%3B%0A%20%20const%20initializers%3Dtokens.flatMap%28%28token%2Cindex%29%3D%3Etoken.kind%3D%3D%3D%27identifier%27%26%26tokens%5Bindex%2B1%5D%3F.value%3D%3D%3D%27%3A%27%26%26%2F%5Efield_%5B0-9%5D%2B%24%2Fu.test%28tokens%5Bindex%2B2%5D%3F.value%3F%3F%27%27%29%3F%5B%5Btoken.value%2Ctokens%5Bindex%2B2%5D.value%5D%5D%3A%5B%5D%29%3B%0A%20%20assert.deepEqual%28initializers%2Cfields.map%28%28field%2Cindex%29%3D%3E%5Bfield.name%2C%27field_%27%2Bindex%5D%29%2C%27every%20actual%20native%20field%20receives%20its%20own%20complete%20source-qualified%20operand%27%29%3B%0A%7D%0Afunction%20checkNativeConstructorControl%28inventory%2Crecipe%29%20%7B%0A%20%20const%20byId%3Dnew%20Map%28inventory.operations.map%28row%3D%3E%5Brow.sourceReference%2Crow%5D%29%29%2Cpending%3D%5Brecipe%5D%3Blet%20count%3D0%3B%0A%20%20while%28pending.length%29%7B%0A%20%20%20%20const%20current%3Dpending.pop%28%29%3Bassert.ok%28%2B%2Bcount%3C%3D100000%29%3Bconst%20operation%3DbyId.get%28current.reference%29%3Bassert.ok%28operation%29%3B%0A%20%20%20%20assert.deepEqual%28Object.keys%28current%29%2C%5B%27reference%27%2C%27choice%27%2C%27children%27%2C%27scalar%27%5D%29%3Bassert.ok%28Array.isArray%28current.children%29%29%3B%0A%20%20%20%20let%20references%3D%5B%5D%3B%0A%20%20%20%20if%28operation.variants%29%7Bconst%20variant%3Doperation.variants.find%28row%3D%3Erow.identity%3D%3D%3Dcurrent.choice%29%3Bassert.ok%28variant%29%3Breferences%3D%28variant.fields%3F%3Fvariant.tuple%29.map%28row%3D%3Erow.typeReference%29%3B%7D%0A%20%20%20%20else%20if%28operation.form%3D%3D%3D%27Option%27%29%7Bassert.ok%28%5B%27Some%27%2C%27None%27%5D.includes%28current.choice%29%29%3Breferences%3Dcurrent.choice%3D%3D%3D%27Some%27%3Foperation.arguments%3A%5B%5D%3B%7D%0A%20%20%20%20else%7B%0A%20%20%20%20%20%20assert.equal%28current.choice%2C%27%27%29%3B%0A%20%20%20%20%20%20if%28operation.fields%29references%3Doperation.fields.map%28row%3D%3Erow.typeReference%29%3B%0A%20%20%20%20%20%20else%20if%28%5B%27named%27%2C%27type_item%27%2C%27Box%27%2C%27reference%27%5D.includes%28operation.form%29%29references%3D%5Boperation.child%3F%3Foperation.arguments%5B0%5D%5D%3B%0A%20%20%20%20%20%20else%20if%28operation.form%3D%3D%3D%27Vec%27%29references%3Dcurrent.children.map%28%28%29%3D%3Eoperation.arguments%5B0%5D%29%3B%0A%20%20%20%20%20%20else%20if%28operation.form%3D%3D%3D%27IndexMap%27%29%7Bassert.equal%28current.children.length%252%2C0%29%3Breferences%3Dcurrent.children.map%28%28_%2Cindex%29%3D%3Eoperation.arguments%5Bindex%252%5D%29%3B%7D%0A%20%20%20%20%7D%0A%20%20%20%20assert.deepEqual%28current.children.map%28row%3D%3Erow.reference%29%2Creferences%29%3B%0A%20%20%20%20if%28%5B%27bool%27%2C%27usize%27%2C%27i64%27%2C%27String%27%2C%27str%27%2C%27json%27%2C%27reference%27%5D.includes%28operation.form%29%29%7B%0A%20%20%20%20%20%20assert.ok%28current.scalar%29%3Bassert.deepEqual%28Object.keys%28current.scalar%29%2C%5B%27kind%27%2C%27value%27%5D%29%3Bassert.equal%28current.scalar.kind%2Coperation.storage.carrier%29%3B%0A%20%20%20%20%20%20if%28operation.form%3D%3D%3D%27bool%27%29assert.equal%28typeof%20current.scalar.value%2C%27boolean%27%29%3B%0A%20%20%20%20%20%20if%28%5B%27String%27%2C%27str%27%2C%27reference%27%5D.includes%28operation.form%29%29assert.equal%28typeof%20current.scalar.value%2C%27string%27%29%3B%0A%20%20%20%20%20%20if%28%5B%27usize%27%2C%27i64%27%5D.includes%28operation.form%29%29%7Bassert.match%28cur