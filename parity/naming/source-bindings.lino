(7209: (meta: (t: semantic) (n: 1) (term: string%20value) (def: test%28%27historical%20code%20unit%20templates%20preserve%20complete%20metadata%20and%20agree%20through%20actual%20caller%20span%20instantiation%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20historicalPath%20%3D%20new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fhistorical%2Ffrontend-const-lists%2Fstring-code-unit-template.lino%27%2C%20import.meta.url%29%3B%0A%20%20const%20historicalBytes%20%3D%20readFileSync%28historicalPath%29%3B%0A%20%20const%20digest%20%3D%20value%20%3D%3E%20createHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0A%20%20%2F%2F%20Exact%20complete%20Git%20blob%20extracted%20from%20this%20original%20revision%3B%20this%20is%0A%20%20%2F%2F%20retained%20independently%20of%20the%20newly%20generated%20runtime%20copies.%0A%20%20const%20originalRevision%20%3D%20%27858665058648a3f1f9ce05ff3b0668b9ccfd66eb%27%3B%0A%20%20assert.equal%28historicalBytes.length%2C%20110810%29%3B%0A%20%20assert.equal%28digest%28historicalBytes%29%2C%20%27549da9c740846c976a077aed192918e62a1f8ecd9b63109739763b196b553c4f%27%2C%0A%20%20%20%20%27the%20whole%20original%20template%20at%20%27%20%2B%20originalRevision%29%3B%0A%20%20const%20historical%20%3D%20readProjectData%28historicalPath%29%3B%0A%20%20const%20current%20%3D%20readStringCodeUnitTemplateGeneration%28%29%3B%0A%20%20const%20sourceSha256%20%3D%20%27171561add319a13fc6b28af7c9121db192e9983f53fca209ff3bbb0c17c35d9d%27%3B%0A%20%20const%20basePreludeSha256%20%3D%20%27dcc6da567430fa71a318f5d5d9beb873f23e009dfc7d9a7c1bfb66a0e9231ea5%27%3B%0A%20%20assert.equal%28digest%28historical.source%29%2C%20sourceSha256%29%3B%0A%20%20assert.equal%28historical.sourceSha256%2C%20sourceSha256%29%3B%0A%20%20assert.equal%28current.sourceSha256%2C%20sourceSha256%29%3B%0A%20%20assert.equal%28readFileSync%28new%20URL%28%27..%2Fsrc%2Ftranslation%2Fstring-code-unit-rules.js%27%2C%20import.meta.url%29%2C%20%27utf8%27%29%2C%20historical.source%29%3B%0A%20%20assert.equal%28historical.basePreludeSha256%2C%20basePreludeSha256%29%3B%0A%20%20assert.equal%28current.basePreludeSha256%2C%20basePreludeSha256%29%3B%0A%20%20assert.equal%28digest%28STRING_PRELUDE%29%2C%20basePreludeSha256%29%3B%0A%20%20assert.deepEqual%28historical.inventory%2C%20%5B%7B%20kind%3A%20%27fn%27%2C%20name%3A%20%27readStringCodeUnit%27%2C%20span%3A%20%7B%20start%3A%20227%2C%20end%3A%20233%20%7D%20%7D%5D%29%3B%0A%20%20assert.deepEqual%28current.inventory%2C%20historical.inventory%29%3B%0A%20%20assert.equal%28historical.source%5B345%5D%2C%20%27%3B%27%29%3B%0A%20%20assert.equal%28historical.source.slice%28345%2C%20349%29%2C%20%27%3B%5Cn%20%20%27%29%3B%0A%20%20assert.equal%28historical.source.slice%28349%2C%20351%29%2C%20%27if%27%29%3B%0A%20%20const%20expectedCurrent%20%3D%20structuredClone%28historical%29%3B%0A%20%20for%20%28const%20field%20of%20%5B%27originalDeclaration%27%2C%20%27checkedDeclaration%27%2C%20%27template%27%5D%29%20%7B%0A%20%20%20%20assert.deepEqual%28historical%5Bfield%5D.body.span%2C%20%7B%20start%3A%20282%2C%20end%3A%20349%20%7D%29%3B%0A%20%20%20%20assert.deepEqual%28current%5Bfield%5D.body.span%2C%20%7B%20start%3A%20282%2C%20end%3A%20345%20%7D%29%3B%0A%20%20%20%20expectedCurrent%5Bfield%5D.body.span.end%20%3D%20345%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28current%2C%20expectedCurrent%2C%0A%20%20%20%20%27every%20source%2C%20declaration%2C%20operation%2C%20binder%2C%20type%20and%20metadata%20field%20is%20retained%20except%20exactly%20three%20authenticated%20endpoints%27%29%3B%0A%20%20const%20caller%20%3D%20parseJavaScript%28source%2C%20%7B%20referenceSemantics%3A%20false%20%7D%29.items%5B0%5D.body%3B%0A%20%20assert.equal%28caller.k%2C%20%27method%27%29%3B%0A%20%20assert.equal%28caller.op%2C%20%27charCodeAt%27%29%3B%0A%20%20assert.ok%28caller.span.end%20%3E%20caller.span.start%29%3B%0A%20%20const%20oldExpression%20%3D%20instantiateCapturedCodeUnitTemplate%28historical%2C%20caller.span%29%3B%0A%20%20const%20currentExpression%20%3D%20instantiateCapturedCodeUnitTemplate%28current%2C%20caller.span%29%3B%0A%20%20assert.deepEqual%28currentExpression%2C%20oldExpression%2C%0A%20%20%20%20%27the%20actual%20production%20instantiator%20sets%20caller%20spans%20without%20deleting%20or%20changing%20any%20executable%20field%27%29%3B%0A%20%20assert.deepEqual%28currentExpression%2C%20createStringCodeUnitTemplateExpression%28caller.span%29%29%3B%0A%20%20assert.deepEqual%28oldExpression.span%2C%20caller.span%29%3B%0A%20%20assert.deepEqual%28oldExpression.body.span%2C%20caller.span%29%3B%0A%20%20const%20emitted%20%3D%20%5BoldExpression%2C%20currentExpression%5D.map%28template%20%3D%3E%20%7B%0A%20%20%20%20const%20surface%20%3D%20parseJavaScript%28historical.source%2C%20%7B%20referenceSemantics%3A%20false%20%7D%29%3B%0A%20%20%20%20surface.items%5B0%5D%20%3D%20%7B%20...surface.items%5B0%5D%2C%20params%3A%20template.params%2C%20body%3A%20template.body%2C%20ret%3A%20template.ret%20%7D%3B%0A%20%20%20%20return%20emitJavaScript%28checkProgram%28surface%29%29%3B%0A%20%20%7D%29%3B%0A%20%20assert.deepEqual%28emitted%5B0%5D%2C%20emitted%5B1%5D%2C%20%27both%20complete%20instantiated%20templates%20emit%20identical%20programs%20and%20provenance%27%29%3B%0A%20%20const%20original%20%3D%20vm.runInNewContext%28emitted%5B0%5D.text%20%2B%20%27%3BreadStringCodeUnit%3B%27%29%3B%0A%20%20const%20translated%20%3D%20vm.runInNewContext%28emitted%5B1%5D.text%20%2B%20%27%3BreadStringCodeUnit%3B%27%29%3B%0A%20%20for%20%28const%20text%20of%20%5B%27%27%2C%20%27ABC%27%2C%20%27A%F0%9F%98%80B%27%2C%20%27%5Cud800x%5Cudfff%27%5D%29%20for%20%28const%20position%20of%20%5B-Infinity%2C%20-0.9%2C%200%2C%201.9%2C%202%2C%20Infinity%2C%20NaN%5D%29%20%7B%0A%20%20%20%20assert.equal%28original%28text%2C%20position%29%2C%20text.charCodeAt%28position%29%29%3B%0A%20%20%20%20assert.equal%28translated%28text%2C%20position%29%2C%20text.charCodeAt%28position%29%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28historical.template.body.span%2C%20%7B%20start%3A%20282%2C%20end%3A%20349%20%7D%2C%20%27the%20historical%20template%20was%20not%20rewritten%27%29%3B%0A%7D%29) (lang: meta-language%20structured%20data)))
