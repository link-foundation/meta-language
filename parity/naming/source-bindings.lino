(18208: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20CI-only%20experiment%20runner.%20Default%20is%20source%20plan%2Fcheck%20only.%0A%2F%2F%20No%20production%20source%20write%2C%20install%2C%20fetch%2C%20clone%2C%20or%20observation-ledger%20call.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7Bspawn%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7BchmodSync%2CexistsSync%2ClstatSync%2CmkdirSync%2CmkdtempSync%2CreadFileSync%2CrealpathSync%2CsymlinkSync%2CwriteFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7Bresolve%2Cjoin%2Cdirname%7D%20from%20%27node%3Apath%27%3B%0Aimport%20%7BfileURLToPath%2CpathToFileURL%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BoverlayPolicy%20as%20policy%7D%20from%20%27.%2Fpolicy.mjs%27%3B%0Aimport%20%7BbytesAt%2CcrateInventory%2CcreateOverlayPlan%2CfrozenSourceBytes%2Csha256%2Cwithin%7D%20from%20%27.%2Fplan.mjs%27%3B%0Aimport%20%7BcheckRunnerPublication%7D%20from%20%27.%2Fgenerate-publication.mjs%27%3B%0Aimport%20%7BverifyPublication%7D%20from%20%27..%2Fwire%2Fpublication.mjs%27%3B%0Aimport%20%7BreadOutcomeCompilerProfile%2CreadOutcomeCompilerInvocation%7D%20from%20%27.%2Fcompiler-profile.mjs%27%3B%0A%0A%2F%2A%2A%20Must%20run%20before%20ANY%20compiler%20command%2C%20including%20metadata%2Fversion%20queries%2C%0A%20%2A%20before%20compiler%20scratch%20creation%2C%20and%20before%20injected%20process%20contracts.%0A%20%2A%2F%0Aexport%20function%20requireNativeCI%28plan%2Cenvironment%3Dprocess.env%2Cplatform%3Dprocess.platform%29%20%7B%0A%20%20assert.equal%28environment.META_LANGUAGE_B95_NATIVE_OUTCOME%2C%271%27%2C%27explicit%20native%20experiment%20opt-in%20required%27%29%3B%0A%20%20assert.equal%28environment.CI%2C%27true%27%2C%27native%20execution%20is%20forbidden%20locally%27%29%3B%0A%20%20assert.equal%28environment.GITHUB_ACTIONS%2C%27true%27%2C%27native%20execution%20requires%20GitHub%20Actions%27%29%3B%0A%20%20assert.equal%28platform%2C%27linux%27%2C%27first%20experiment%20process-gr