28register%252C%2527sourceDescriptorSuccessors%2527%2529%2529return%257Bartifact%252Cregister%257D%253B%250A%2520%2520const%2520selected%253DreadSourceDescriptorPolicy%2528%2529%253B%250A%2520%2520assert.equal%2528Object.keys%2528register%2529.at%2528-1%2529%252C%2527sourceDescriptorSuccessors%2527%2529%253B%250A%2520%2520const%2520%257BsourceDescriptorSuccessors%252C...previousRegister%257D%253Dregister%253B%250A%2520%2520assert.deepEqual%2528sourceDescriptorSuccessors%252C%255Bselected.edge%255D%252C%2527only%2520the%2520exact%2520reviewed%2520source%2520descriptor%2520successor%2520is%2520admitted%2527%2529%253B%250A%2520%2520const%2520registerBytes%253DBuffer.from%2528structuredDataToLino%2528previousRegister%2529%2529%253B%250A%2520%2520assert.equal%2528registerBytes.length%252Cselected.previousRegister.bytes%2529%253B%250A%2520%2520assert.equal%2528hash%2528registerBytes%2529%252Cselected.previousRegister.sha256%252C%2527every%2520complete%2520previous%2520receipt%2520and%2520field%2520remains%2520unchanged%2527%2529%253B%250A%2520%2520const%2520bytes%253DBuffer.from%2528structuredDataToLino%2528artifact%2529%2529%253B%250A%2520%2520if%2528identity%2521%253D%253Dselected.edge.identity%257C%257Chash%2528bytes%2529%2521%253D%253Dselected.edge.current.sha256%2529%257B%250A%2520%2520%2520%2520return%257Bartifact%252Cregister%253ApreviousRegister%257D%253B%250A%2520%2520%257D%250A%2520%2520assert.equal%2528bytes.length%252Cselected.edge.current.bytes%2529%253B%250A%2520%2520const%2520inverse%253DstructuredClone%2528artifact%2529%253B%250A%2520%2520for%2528const%2520change%2520of%2520selected.edge.changes%2529%257B%250A%2520%2520%2520%2520assert.ok%2528change.path.length%253E1%2526%2526change.path.every%2528key%253D%253Etypeof%2520key%253D%253D%253D%2527string%2527%2526%2526%2521%255B%2527__proto__%2527%252C%2527prototype%2527%252C%2527constructor%2527%255D.includes%2528key%2529%2529%2529%253B%250A%2520%2520%2520%2520let%2520owner%253Dinverse%253B%250A%2520%2520%2520%2520for%2528const%2520key%2520of%2520change.path.slice%25280%252C-1%2529%2529%257Bassert.ok%2528Object.hasOwn%2528owner%252Ckey%2529%2529%253Bowner%253Downer%255Bkey%255D%253B%257D%250A%2520%2520%2520%2520const%2520key%253Dchange.path.at%2528-1%2529%253B%250A%2520%2520%2520%2520assert.deepEqual%2528owner%255Bkey%255D%252Cchange.after%2529%253B%250A%2520%2520%2520%2520if%2528change.kind%253D%253D%253D%2527source%2520history%2527%2529%257B%250A%2520%2520%2520%2520%2520%2520assert.equal%2528key%252C%2527sourceHistory%2527%2529%253Bassert.equal%2528change.before%252C%2527absent%2527%2529%253Bassert.equal%2528delete%2520owner%255Bkey%255D%252Ctrue%2529%253B%250A%2520%2520%2520%2520%257Delse%257B%250A%2520%2520%2520%2520%2520%2520assert.equal%2528change.kind%252C%2527source%2520descriptor%2527%2529%253Bassert.ok%2528%255B%2527bytes%2527%252C%2527sha256%2527%255D.includes%2528key%2529%2529%253Bowner%255Bkey%255D%253Dchange.before%253B%250A%2520%2520%2520%2520%257D%250A%2520%2520%257D%250A%2520%2520const%2520restored%253DBuffer.from%2528structuredDataToLino%2528inverse%2529%2529%253B%250A%2520%2520assert.equal%2528restored.length%252Cselected.edge.previous.bytes%2529%253B%250A%2520%2520assert.equal%2528hash%2528restored%2529%252Cselected.edge.previous.sha256%252C%2527only%2520recorded%2520provenance%2520changes%2520may%2520differ%2520in%2520the%2520entire%2520previous%2520artifact%2527%2529%253B%250A%2520%2520return%257Bartifact%253Ainverse%252Cregister%253ApreviousRegister%257D%253B%250A%257D%250A%250Aexport%2520function%2520readHistoricalTranslationSourceDescriptorRegister%2528%2529%257B%250A%2520%2520return%2520restoreCurrentTranslationSourceDescriptors%2528null%252C%2527historical%2520register%2527%252CreadProjectData%2528registerFile%2529%2529.register%253B%250A%257D%250A%250Aexport%2520function%2520projectHistoricalTranslationSourceDescriptorArtifact%2528artifact%2529%257B%250A%2520%2520const%2520selected%253DreadSourceDescriptorPolicy%2528%2529%252Cbytes%253DBuffer