20Do%20not%20edit%20by%20hand.%20--%3E%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27%23%20Dependency%20audit%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%60Audit%20date%3A%20%24%7Binventory.auditDate%7D%60%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27This%20inventory%20lists%20every%20runtime%2C%20development%2C%20build%20and%20optional%20dependency%27%2C%0A%20%20%20%20%27of%20the%20two%20published%20packages%20and%20the%20website%20crate%2C%20every%20lockfile%27%2C%0A%20%20%20%20%27resolution%2C%20the%20experiment%20manifests%2C%20the%20vendored%20grammar%20assets%2C%20the%27%2C%0A%20%20%20%20%27generators%2C%20the%20toolchains%2C%20the%20GitHub%20Actions%2C%20the%20build%20images%2C%20the%20runners%27%2C%0A%20%20%20%20%27and%20the%20published%20artifact%20contents%2C%20each%20with%20the%20current%20stable%20release%20its%27%2C%0A%20%20%20%20%27source%20reported%20on%20the%20audit%20date%20or%20a%20later%20item-specific%20registry%20receipt.%27%2C%0A%20%20%20%20%27A%20receipt%20with%20%60checkedAt%60%20updates%20only%20that%20item%3B%20the%20full%20audit%20date%20and%27%2C%0A%20%20%20%20%27the%20previously%20recorded%20releases%20of%20every%20other%20item%20stay%20unchanged.%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27%23%23%20Method%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27%60node%20js%2Fscripts%2Fcheck-dependencies.mjs%20--refresh%60%20%28%60npm%20run%20dependencies%3Arefresh%60%29%27%2C%0A%20%20%20%20%27reads%20every%20pin%20from%20the%20repository%2C%20queries%20the%20npm%20registry%2C%20the%20crates.io%27%2C%0A%20%20%20%20%27index%2C%20PyPI%20JSON%20registry%2C%20GitHub%20releases%2C%20nodejs.org%20and%20Docker%20Hub%20for%20the%20current%20stable%27%2C%0A%20%20%20%20%27release%2C%20derives%20the%20reason%20of%20a%20locked%20package%20that%20a%20dependent%5C%27s%20requirement%27%2C%0A%20%20%20%20%27holds%20from%20%60js%2Fpackage-lock.json%60%20and%20%60cargo%20metadata%60%2C%20and%20rewrites%27%2C%0A%20%20%20%20%27%60parity%2Fdependency-inventory.json%60%20and%20this%20document.%20Every%20other%20reason%20is%27%2C%0A%20%20%20%20%27recorded%20by%20hand%20in%20the%20inventory.%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27%60npm%20run%20check%3Adependencies%60%2C%20which%20CI%20runs%2C%20is%20offline.%20It%20fails%20when%20the%27%2C%0A%20%20%20%20%27repository%20declares%20an%20item%20the%20inventory%20does%20not%20list%2C%20or%20a%20pin%20the%27%2C%0A%20%20%20%20%27inventory%20does%20not%20record%3B%20when%20the%20audit%20date%20is%20missing%20or%20invalid%3B%20and%20when%27%2C%0A%20%20%20%20%27a%20retained%20item%20is%20behind%20its%20current%20stable%20release%20without%20a%20recorded%27%2C%0A%20%20%20%20%27compatibility%20reason.%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27%60npm%20run%20check%3Adependencies%3Adelivery%60%20is%20the%20delivery%20gate.%20A%20recorded%20reason%27%2C%0A%20%20%20%20%27does%20not%20count%20as%20an%20upgrade%3A%20an%20item%20behind%20its%20current%20stable%20release%20is%27%2C%0A%20%20%20%20%27delivered%20only%20at%20its%20newest%20compatible%20release%2C%20the%20newest%20stable%20release%27%2C%0A%20%20%20%20%27that%20every%20requirement%20holding%20it%20admits%2C%20which%20the%20refresh%20records%20with%20the%27%2C%0A%20%20%20%20%27holders%20whose%20requirements%20exclude%20the%20current%20release.%20Each%20holder%20must%20be%20an%27%2C%0A%20%20%20%20%27inventoried%20item%20that%20is%20itself%20delivered%2C%20or%20an%20external%20package%20at%20its%27%2C%0A%20%20%20%20%27newest%20release%3B%20anything%20else%2C%20and%20anything%20built%20from%20it%2C%20is%20stale.%20Pull%27%2C%0A%20%20%20%20%27request%20checks%20compare%20offline%20against%20this%20committed%20audit.%20With%20%60--live%60%2C%27%2C%0A%20%20%20%20%27which%20runs%20only%20on%20main%2C%20the%20gate%20refreshes%20the%20inventory%20from%20the%20registries%27%2C%0A%20%20%20%20%27in%20memory%20and%20fails%20when%20a%20current%20or%20compatible%20release%20differs%20from%20this%27%2C%0A%20%20%20%20%27audit%3B%20the%20scheduled%20dependency%20refresh%20on%20main%20then%20opens%20a%20pull%20request%20that%27%2C%0A%20%20%20%20%27moves%20the%20item%20to%20it.%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27Comparisons%3A%20%60version%60%20means%20the%20pin%20must%20be%20at%20least%20the%20current%20release%3B%27%2C%0A%20%20%20%20%27%60major%60%20and%20%60minor%60%20mean%20a%20moving%20tag%20%28%60v7%60%2C%20%605.4%60%29%20that%20must%20name%20the%20current%27%2C%0A%20%20%20%20%27release%20line%3B%20%60floor%60%20means%20a%20supported%20minimum%20%28the%20%60engines%60%20floor%20must%20be%20a%27%2C%0A%20%20%20%20%27maintained%20Node.js%20line%2C%20%60rust-version%60%20must%20be%20at%20least%20what%20the%20resolved%27%2C%0A%20%20%20%20%27crates%20declare%29%3B%20%60revision%60%20means%20a%20vendored%20commit%20that%20must%20contain%20the%27%2C%0A%20%20%20%20%27upstream%20release%3B%20%60floating%60%20means%20the%20newest%20release%20is%20installed%20on%20every%27%2C%0A%20%20%20%20%27run%3B%20%60derived%60%20means%20an%20artifact%20built%20from%20the%20items%20it%20names%2C%20behind%20when%27%2C%0A%20%20%20%20%27they%20are.%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27%23%23%20Summary%27%2C%0A%20%20%20%20%27%27%2C%0A%20%20%20%20%27%7C%20Category%20%7C%20Items%20%7C%20Current%20%7C%20Behind%20%7C%20Not%20applicable%20%7C%27%2C%0A%20%20%20%20%27%7C---%7C---%7C---%7C---%7C---%7C%27%2C%0A%20%20%29%3B%0A%20%20for%20%28const%20%7B%20id%2C%20title%20%7D%20of%20CATEGORIES%29%20%7B%0A%20%20%20%20const%20members%20%3D%20items.filter%28%28item%29%20%3D%3E%20item.category%20%3D%3D%3D%20id%29%3B%0A%20%20%20%20if%20%28members.length%20%3D%3D%3D%200%29%20continue%3B%0A%20%20%20%20const%20count%20%3D%20%28status%29%20%3D%3E%20members.filter%28%28item%29%20%3D%3E%20statusCache.get%28item.id%29%20%3D%3D%3D%20status%29.length%3B%0A%20%20%20%20push%28%60%7C%20%24%7Btitle%7D%20%7C%20%24%7Bmembers.length%7D%20%7C%20%24%7Bcount%28%27current%27%29%7D%20%7C%20%24%7Bcount%28%27behind%27%29%7D%20%7C%20%24%7Bcoun