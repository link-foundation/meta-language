lue%29%27%29.split%28%27%5Cn%27%29.map%28line%3D%3E%27%20%20%20%20%27%2Bline%29.join%28%27%5Cn%27%29%2B%27%5Cn%7D%5Cn%5Cn%27%3B%0A%20%20assert.equal%28sha256%28helper%29%2Creceipt.parent.helperSha256%29%3B%0A%20%20const%20module%3D%27mod%20grammar_outcome%3B%5Cnpub%20use%20grammar_outcome%3A%3Aencode_grammar_parse_outcome_links%3B%5Cn%5Cn%27%3B%0A%20%20const%20call%3D%27%20%20%20%20%20%20%20%20Value%3A%3ANumber%28number%29%20%3D%3E%20StructuredDataValue%3A%3ANumber%28exact_json_number%28number%29%3F%29%2C%27%3B%0A%20%20let%20restored%3Dproposed.toString%28%27utf8%27%29%3B%0A%20%20for%28const%20part%20of%20%5Bmodule%2Chelper%2Ccall%5D%29%20assert.equal%28restored.split%28part%29.length%2C2%2C%27one%20exact%20inverse%20source%20operation%27%29%3B%0A%20%20restored%3Drestored.replace%28module%2C%27%27%29.replace%28helper%2C%27%27%29.replace%28call%2Carm%29%3B%0A%20%20assert.deepEqual%28Buffer.from%28restored%29%2Coriginal%2C%27whole%20original%20parent%20inverse%27%29%3B%0A%7D) (lang: meta-language%20structured%20data)))
