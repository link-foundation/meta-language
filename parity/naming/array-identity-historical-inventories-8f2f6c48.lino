Cview.file%29%29%29%2Csource.current%2C%27the%20selected%20root%20retains%20every%20complete%20actual%20source%20byte%27%29%3B%0A%20%20%20%20const%20entry%3Dentries%5B0%5D%2Cfound%3D%5B...new%20Set%28entry.extract%28source.predecessor.source%2Cview.file%29%29%5D%0A%20%20%20%20%20%20.map%28name%3D%3E%28%7Bname%2Crecord%3Aentry.recordOf%28name%29%7D%29%29%3B%0A%20%20%20%20const%20current%3Dnew%20Set%28entry.extract%28readFileSync%28resolve%28root%2Cview.file%29%2C%27utf8%27%29%2Cview.file%29%29%3B%0A%20%20%20%20for%28const%20row%20of%20view.names%29%7B%0A%20%20%20%20%20%20assert.ok%28found.some%28candidate%3D%3Ecandidate.name%3D%3D%3Drow.name%26%26candidate.record%3D%3D%3Drow.record%29%2C%27an%20unchanged%20extractor%20must%20derive%20each%20original%20name%20and%20identity%27%29%3B%0A%20%20%20%20%20%20assert.equal%28current.has%28row.name%29%2Cfalse%2C%27actual%20current%20names%20stay%20in%20the%20separate%20current%20inventory%27%29%3B%0A%20%20%20%20%20%20names.push%28%7Binventory%3Aview.inventory%2Cfile%3Aview.file%2C...row%2CsourceView%3A%7B%0A%20%20%20%20%20%20%20%20kind%3A%27complete%20certified%20historical%20source%27%2Crevision%3Aview.revision%2Cpath%3Aview.file%2C%0A%20%20%20%20%20%20%20%20bytes%3Asource.predecessor.bytes%2Csha256%3Asource.predecessor.sha256%2C%0A%20%20%20%20%20%20%20%20archive%3A%27parity%2Fnaming%2Farray-identity-historical-inventories.lino%27%2Cboundary%3Aadditional.boundary%7D%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20return%20names%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
