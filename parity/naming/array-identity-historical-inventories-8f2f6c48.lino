for%20%28const%20row%20of%20ASCII_HOST_REGISTRATIONS%29%20%7B%0A%20%20%20%20assert.equal%28readFileSync%28new%20URL%28row.path%2C%20root%29%2C%20%27utf8%27%29.split%28row.declaration%29.length%2C%202%2C%0A%20%20%20%20%20%20row.path%20%2B%20%27%20actually%20registers%20the%20generated%20module%20and%20native%20unit%20source%27%29%3B%0A%20%20%7D%0A%20%20const%20protectedSources%20%3D%20new%20Set%28%29%3B%0A%20%20for%20%28const%20row%20of%20files%29%20%7B%0A%20%20%20%20const%20file%20%3D%20new%20URL%28row.path%2C%20root%29%3B%0A%20%20%20%20if%20%28check%29%20assert.equal%28restoreRequiredFieldNativeHostSource%28readFileSync%28file%2C%20%27utf8%27%29%2C%20row.path%2C%20%27ASCII%20character%20host%27%29%2C%20row.source%2C%20row.path%29%3B%0A%20%20%20%20else%20if%20%28existsSync%28file%29%29%20%7B%0A%20%20%20%20%20%20const%20physical%20%3D%20readFileSync%28file%2C%20%27utf8%27%29%3B%0A%20%20%20%20%20%20const%20actual%20%3D%20restoreRequiredFieldNativeHostSource%28physical%2C%20row.path%2C%20%27ASCII%20character%20host%27%29%3B%0A%20%20%20%20%20%20assert.ok%28actual%20%3D%3D%3D%20row.source%20%7C%7C%20actual%20%3D%3D%3D%20row.predecessor%2C%20%27unknown%20current%20source%20must%20not%20be%20overwritten%3A%20%27%20%2B%20row.path%29%3B%0A%20%20%20%20%20%20if%20%28actual%20%21%3D%3D%20physical%29%20protectedSources.add%28row.path%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20if%20%28%21check%29%20for%20%28const%20row%20of%20files%29%20%7B%0A%20%20%20%20if%20%28protectedSources.has%28row.path%29%29%20continue%3B%0A%20%20%20%20const%20file%20%3D%20fileURLToPath%28new%20URL%28row.path%2C%20root%29%29%3B%0A%20%20%20%20mkdirSync%28dirname%28file%29%2C%20%7B%20recursive%3A%20true%20%7D%29%3B%0A%20%20%20%20writeFileSync%28file%2C%20row.source%29%3B%0A%20%20%7D%0A%20%20return%20%7B%20archive%2C%20files%20%7D%3B%0A%7D%0A%0Aif%20%28process.argv%5B1%5D%20%3D%3D%3D%20fileURLToPath%28import.meta.url%29%29%20%7B%0A%20%20const%20args%20%3D%20process.argv.slice%282%29%3B%0A%20%20assert.ok%28args.length%20%3C%3D%201%20%26%26%20args.every%28argument%20%3D%3E%20argument%20%3D%3D%3D%20%27--check%27%29%29%3B%0A%20%20const%20result%20%3D%20generateAsciiTextPredicateHosts%28%7B%20check%3A%20args.includes%28%27--check%27%29%20%7D%29%3B%0A%20%20console.log%28JSON.stringify%28%7B%20hosts%3A%20result.files.map%28row%20%3D%3E%20row.path%29%2C%0A%20%20%20%20registrations%3A%20ASCII_HOST_REGISTRATIONS%2C%20nativeCompilation%3A%20false%2C%20nativeExecution%3A%20false%20%7D%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
