essor.artifact%3B%0A%20assert.equal%28register.schemaVersion%2C1%29%3B%0A%20const%20matches%3Dregister.receipts.filter%28row%3D%3Erow.identity%3D%3D%3Didentity%29%3B%0A%20assert.equal%28matches.length%2C1%2C%27one%20complete%20declaration-range%20receipt%20has%20this%20identity%27%29%3B%0A%20const%20receipt%3Dmatches%5B0%5D%2Cbytes%3Dsuccessor.bytes%2Cactual%3Ddigest%28bytes%29%3B%0A%20if%28actual%3D%3D%3Dreceipt.previous.sha256%29%7Bassert.equal%28bytes.length%2Creceipt.previous.bytes%29%3Breturn%20structuredClone%28artifact%29%3B%7D%0A%20assert.equal%28actual%2Creceipt.current.sha256%2C%27the%20entire%20current%20artifact%20must%20match%20its%20reviewed%20receipt%27%29%3B%0A%20assert.equal%28bytes.length%2Creceipt.current.bytes%29%3B%0A%20assert.equal%28receipt.previous.file%2Creceipt.current.file%29%3B%0A%20assert.match%28receipt.previous.revision%2C%2F%5E%5Ba-f0-9%5D%7B40%7D%24%2Fu%29%3B%0A%20const%20inverse%3DstructuredClone%28artifact%29%2Cpaths%3Dnew%20Set%28%29%3B%0A%20for%28const%20change%20of%20receipt.changes%29%7B%0A%20%20const%20path%3Dchange.path%2Ckey%3DJSON.stringify%28path%29%2Clast%3Dpath.at%28-1%29%3B%0A%20%20assert.ok%28path.length%3E1%26%26%21paths.has%28key%29%26%26path.every%28part%3D%3Etypeof%20part%3D%3D%3D%27string%27%26%26%21%5B%27__proto__%27%2C%27prototype%27%2C%27constructor%27%5D.includes%28part%29%29%2C%27each%20recorded%20path%20is%20distinct%20and%20owned%27%29%3B%0A%20%20paths.add%28key%29%3B%0A%20%20const%20endpoint%3D%5B%27span%27%2C%27sourceSpan%27%5D.includes%28path.at%28-2%29%29%26%26last%3D%3D%3D%27end%27%3B%0A%20%20const%20archive%3Dpath.includes%28%27archive%27%29%26%26%5B%27textBytes%27%2C%27textSha256%27%2C%27binaryBytes%27%2C%27binarySha256%27%5D.includes%28last%29%3B%0A%20%20const%20descriptor%3Didentity%3D%3D%3D%27raw%20consuming%27%26%26%5B%27bytes%27%2C%27sha256%27%5D.includes%28last%29%0A%20%20%20%26%26%28%28path.length%3D%3D%3D3%26%26path%5B0%5D%3D%3D%3D%27decisionSources%27%26%26%2F%5E%5Cd%2B%24%2Fu.test%28path%5B