%20components%29%7B%0A%20%20%20%20const%20bytes%3Dgit%28%27tree%27%2CobjectId%29%2Centries%3D%5B%5D%3Blet%20at%3D0%3B%0A%20%20%20%20while%28at%3Cbytes.length%29%7B%0A%20%20%20%20%20%20const%20space%3Dbytes.indexOf%2832%2Cat%29%2Czero%3Dbytes.indexOf%280%2Cspace%2B1%29%3B%0A%20%20%20%20%20%20assert.ok%28space%3Eat%26%26zero%3Espace%2B1%26%26zero%2B21%3C%3Dbytes.length%29%3B%0A%20%20%20%20%20%20const%20mode%3Dbytes.subarray%28at%2Cspace%29.toString%28%27ascii%27%29%2CnameBytes%3Dbytes.subarray%28space%2B1%2Czero%29%2Cname%3DnameBytes.toString%28%27utf8%27%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28Buffer.from%28name%29%2CnameBytes%2C%27original%20tree%20names%20must%20remain%20lossless%27%29%3B%0A%20%20%20%20%20%20entries.push%28%7Bmode%2Cname%2CobjectId%3Abytes.subarray%28zero%2B1%2Czero%2B21%29.toString%28%27hex%27%29%7D%29%3Bat%3Dzero%2B21%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28at%2Cbytes.length%29%3Btrees.push%28%7BobjectId%2Centries%7D%29%3B%0A%20%20%20%20const%20selected%3Dentries.find%28entry%3D%3Eentry.name%3D%3D%3Dcomponent%29%3Bassert.ok%28selected%2C%27the%20pinned%20Git%20path%20exists%27%29%3BobjectId%3Dselected.objectId%3B%0A%20%20%7D%0A%20%20const%20blob%3Dgit%28%27blob%27%2CobjectId%29%3B%0A%20%20const%20certificate%3D%7BschemaVersion%3A1%2CobjectFormat%3A%27sha1%27%2Crevision%2Cpath%2CcommitText%2Ctrees%2C%0A%20%20%20%20blob%3A%7BobjectId%2Cbytes%3Ablob.length%2Csha256%3AcreateHash%28%27sha256%27%29.update%28blob%29.digest%28%27hex%27%29%7D%7D%3B%0A%20%20assert.deepEqual%28verifyGitArtifactCertificate%28certificate%2Cblob%2C%7Brevision%2Cpath%7D%29%2Cblob%29%3B%0A%20%20return%7Bcertificate%2Cblob%7D%3B%0A%7D%0A%0Aif%28process.argv%5B1%5D%26%26resolve%28process.argv%5B1%5D%29%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%2Coptions%3D%7B%7D%3B%0A%20%20for%28let%20at%3D0%3Bat%3Cargs.length%3Bat%2B%2B%29%7B%0A%20%20%20%20const%20key%3Dargs%5Bat%5D%3Bassert.ok%28%5B%27--revision%27%2C%27--path%27%2C%27--certificate%27%2C%27--blob%27%2C%27--check%27%5D.includes%28key%29%29%3Bassert.equal%28options%5Bkey%5D%2Cundefined%29%3B%0A%20%20%20%20options%5Bkey%5D%3Dkey%3D%3D%3D%27--check%27%3Ftrue%3Aargs%5B%2B%2Bat%5D%3Bassert.ok%28options%5Bkey%5D%29%3B%0A%20%20%7D%0A%20%20for%28const%20key%20of%20%5B%27--revision%27%2C%27--path%27%2C%27--certificate%27%2C%27--blob%27%5D%29assert.equal%28typeof%20options%5Bkey%5D%2C%27string%27%29%3B%0A%20%20assert.notEqual%28resolve%28options%5B%27--certificate%27%5D%29%2Cresolve%28options%5B%27--blob%27%5D%29%29%3B%0A%20%20assert.ok%28options%5B%27--certificate%27%5D.endsWith%28%27.lino%27%29%26%26options%5B%27--blob%27%5D.endsWith%28%27.lino%27%29%2C%27linked%20proof%20and%20original%20linked%20artifact%27%29%3B%0A%20%20const%20%7Bcertificate%2Cblob%7D%3DcaptureGitArtifactCertificate%28options%5B%27--revision%27%5D%2Coptions%5B%27--path%27%5D%29%3B%0A%20%20if%28options%5B%27--check%27%5D%29%7BcheckProjectData%28options%5B%27--certificate%27%5D%2Ccertificate%29%3Bassert.deepEqual%28readFileSync%28options%5B%27--blob%27%5D%29%2Cblob%29%3B%7D%0A%20%20else%7BwriteProjectData%28options%5B%27--certificate%27%5D%2Ccertificate%29%3BwriteFileSync%28options%5B%27--blob%27%5D%2Cblob%29%3B%7D%0A%20%20console.log%28%27Authenticated%20original%20Git%20commit%2C%20%27%2Bcertificate.trees.length%2B%27%20complete%20trees%20and%20%27%2Bblob.length%2B%27%20exact%20artifact%20bytes.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
