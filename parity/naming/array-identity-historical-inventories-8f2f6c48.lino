reeze%28%5B%5B%22javascript-set-size%22%2C%22JavaScript%22%2C%22%2F%2A%2A%20%40param%20%7BSet%3Cnumber%3E%7D%20values%20%2A%2F%20function%20count%28values%29%7Breturn%20values.size%3B%7Dconsole.log%28count%28new%20Set%28%5B1%2C1%2C2%5D%29%29%29%3B%22%2C%5B%222%22%5D%5D%2C%5B%22javascript-map-size%22%2C%22JavaScript%22%2C%22%2F%2A%2A%20%40param%20%7BMap%3Cstring%2Cnumber%3E%7D%20values%20%2A%2F%20function%20count%28values%29%7Breturn%20values.size%3B%7Dconsole.log%28count%28new%20Map%28%5B%5B%5C%22second%5C%22%2C2%5D%2C%5B%5C%22first%5C%22%2C1%5D%2C%5B%5C%22second%5C%22%2C3%5D%5D%29%29%29%3B%22%2C%5B%222%22%5D%5D%5D%29%3B%0A%0Aexport%20function%20deriveCollectionSizeProjectionFixtureSource%28predecessor%29%20%7B%0A%20for%28const%20row%20of%20COLLECTION_SIZE_PROJECTION_FIXTURE_INPUTS%29assert.equal%28predecessor.includes%28JSON.stringify%28row%5B0%5D%29%29%2Cfalse%2C%27new%20fixture%20identity%20must%20not%20duplicate%20an%20existing%20input%27%29%3B%0A%20const%20before%3D%27%5Cn%5D%3B%5Cn%5Cnfunction%20execute%28code%29%20%7B%27%3B%0A%20const%20after%3D%27%5Cn%27%2BCOLLECTION_SIZE_PROJECTION_FIXTURE_INPUTS.map%28row%3D%3E%27%20%20%27%2BJSON.stringify%28row%29%2B%27%2C%27%29.join%28%27%5Cn%27%29%2Bbefore%3B%0A%20assert.equal%28predecessor.split%28before%29.length%2C2%2C%27one%20complete%20original%20fixture%20input-list%20boundary%27%29%3B%0A%20const%20current%3Dpredecessor.replace%28before%2Cafter%29%3Bassert.equal%28current.split%28after%29.length%2C2%29%3B%0A%20assert.equal%28current.replace%28after%2Cbefore%29%2Cpredecessor%2C%27every%20original%20fixture%20input%20and%20generator%20byte%20stays%20exact%27%29%3Breturn%20current%3B%0A%7D%0Aexport%20function%20deriveCollectionSizeProjectionValidationSource%28predecessor%29%20%7B%0A%20const%20before%3D%22%20%20%20%20if%20%28%5B%27tuple%27%2C%20%27tupleIndex%27%5D.includes%28node.k%29%5Cn%20%20%20%20%20%20%26%26%20Object.keys%28node%29.some%28field%20%3D%3E%20%21acceptProgramExpressionField%28node.k%2C%20field%29%29%29%20throw%20new%20TypeError%28%27a%20linked%20tuple%20expression%20has%20an%20unrecognized%20projection%20field%27%29%3B%22%2Cafter%3D%22%20%20%20%20if%20%28acceptProgramExpressionField%28node.k%20%3F%3F%20%27%27%2C%20%27k%27%29%5Cn%20%20%20%20%20%20%26%26%20Object.keys%28node%29.some%28field%20%3D%3E%20%21acceptProgramExpressionField%28node.k%2C%20field%29%29%29%20throw%20new%20TypeError%28%5Cn%20%20%20%20%20%20%20%20%5B%27tuple%27%2C%20%27tupleIndex%27%5D.includes%28node.k%29%20%3F%20%27a%20linked%20tuple%20expression%20has%20an%20unrecognized%20projection%20field%27%5Cn%20%20%20%20%20%20%20%20%20%20%3A%20%27a%20linked%20expression%20contains%20an%20unrecognized%20semantic%20field%27%29%3B%22%3B%0A%20assert.equal%28predecessor.split%28before%29.length%2C2%2C%27one%20complete%20original%20tuple-only%20closure%20boundary%27%29%3B%0A%20const%20current%3Dpredecessor.replace%28before%2Cafter%29%3Bassert.equal%28current.split%28after%29.length%2C2%29%3B%0A%20assert.equal%28current.replace%28after%2Cbefore%29%2Cpredecessor%2C%27every%20original%20validator%20byte%20and%20tuple%20refusal%20stays%20exact%27%29%3Breturn%20current%3B%0A%7D%0A%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20recipeSha256%3D%273dc57ac68653607f0f95fcea65164d83fe5fb2325d9984878da751023da9ab85%27%3B%0Aconst%20pin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20canonical%3Dvalue%3D%3EserializeProjectData%28value%2C%27collection-size-projection-schema.lino%27%29%3B%0Alet%20sourcePair%3B%0A%0A%2F%2A%2A%20Exactly%20two%20additive%20entries%3B%20inverse%20conservation%20covers%20the%20entire%20earlier%20schema.%20%2A%2F%0Aexport%20function%20deriveCollectionSizeProjectionSchema%28predecessor%29%20%7B%0A%20const%20before%3DreadStructuredDataLino%28predecessor%29%2Cafter%3DstructuredClone%28before%29%3B%0A%20for%28const%20%5Btable%2Centries%5Dof%20Object.entries%28COLLECTION_SIZE_PROJECTION_SCHEMA_ENTRIES%29%29%7B%0A%20%20assert.ok%28Object.hasOwn%28after%2Ctable%29%29%3B%0A%20%20for%28const%20%5Bkey%2Cvalue%5Dof%20Object.entries%28entries%29%29%7Bassert.equal%28Object.hasOwn%28after%5Btable%5D%2Ckey%29%2Cfalse%29%3Bafter%5Btable%5D%5Bkey%5D%3DstructuredClone%28value%29%3B%7D%0A%20%7D%0A%20const%20current%3DserializeProjectData%28after%2C%27schema.lino%27%29%2Cinverse%3DstructuredClone%28after%29%3B%0A%20for%28const%20%5Btable%2Centries%5Dof%20Object.entries%28COLLECTION_SIZE_PROJECTION_SCHEMA_ENTRIES%29%29for%28const%20%5Bkey%2Cvalue%5Dof%20Object.entries%28entries%29%29%7B%0A%20%20assert.equal%28canonical%28inverse%5Btable%5D%5Bkey%5D%29%2Ccanonical%28value%29%29%3Bdelete%20inverse%5Btable%5D%5Bkey%5D%3B%0A%20%7D%0A%20assert.equal%28serializeProjectData%28inverse%2C%27schema.lino%27%29%2Cpredecessor%2C%27every%20original%20schema%20byte%20and%20every%20prior%20table%20entry%20remains%20exact%27%29%3B%0A%20return%20current%3B%0A%7D%0A%0Aexport%20function%20verifyCollectionSizeProjectionSchemaPacket%28packet%29%20%7B%0A%20const%20policy%3DCOLLECTION_SIZE_PROJECTION_SCHEMA_POLICY%3B%0A%20assert.deepEqual%28Object.keys%28packet%29.sort%28%29%2C%5B%27boundary%27%2C%27current%27%2C%27extensions%27%2C%27owners%27%2C%27predecessor%27%2C%27revision%27%2C%27schemaVersion%27%5D%29%3B%0A%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.revision%2Cpolicy.revision%29%3B%0A%20assert.equal%28canonical%28packet.extensions%29%2Ccanonical%28COLLECTION_SIZE_PROJECTION_SCHEMA_ENTRIES%29%29%3B%0A%20assert.deepEqual%28Object.keys%28packet.predecessor%29.sort%28%29%2C%5B%27bytes%27%2C%27certificates%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20assert.deepEqual%28pin%28packet.predecessor.source%29%2Cpolicy.predecessor%29%3B%0A%20assert.equal%28packet.predecessor.bytes%2Cpolicy.predecessor.bytes%29%3Bassert.equal%28packet.predecessor.sha256%2Cpolicy.predecessor.sha256%29%3B%0A%20assert.deepEqual%28packet.predecessor.certificates.map%28row%3D%3Erow.file%29%2Cpolicy.files%29%3B%0A%20for%28const%20row%20of%20packet.predecessor.certificates%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27certificate%27%2C%27file%27%5D%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28packet.predecessor.source%29%2C%7Brevision%3Apolicy.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%7D%0A%20const%20owners%3D%5B%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%27js%2Fsrc%2Ftyped-program-expression-projection.js%27%2C%27rust%2Fsrc%2Ftyped_program_links%2Fprojection.rs%27%2C%27js%2Fscripts%2Fgenerate-typed-program-links-fixtures.mjs%27%2C%27js%2Fsrc%2Ftyped-program-links-validation.js%27%5D%3B%0A%20assert.deepEqual%28packet.owners.map%28row%3D%3Erow.file%29%2Cowners%29%3B%0A%20for%28const%20row%20of%20packet.owners%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27bytes%27%2C%27certificate%27%2C%27current%27%2C%27file%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20assert.deepEqual%28pin%28row.source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%3Apolicy.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%20const%20current%3Drow.file%3D%3D%3D%27js%2Fscripts%2Fgenerate-typed-program-links-fixtures.mjs%27%3FderiveCollectionSizeProjectionFixtureSource%28row.source%29%0A%20%20%20%3Arow.file%3D%3D%3D%27js%2Fsrc%2Ftyped-program-links-validation.js%27%3FderiveCollectionSizeProjectionValidationSource%28row.source%29%3Arow.source%3B%0A%20%20assert.deepEqual%28pin%28current%29%2Crow.current%2C%27fixture%20rows%20are%20additive%3B%20validator%20closure%20is%20exactly%20shared-data-driven%3B%20every%20other%20complete%20owner%20stays%20exact%27%29%3B%0A%20%7D%0A%20const%20source%3DderiveCollectionSizeProjectionSchema%28packet.predecessor.source%29%3Bassert.deepEqual%28pin%28source%29%2Cpacket.current%29%3B%0A%20return%7Bpredecessor%3Apacket.predecessor.source%2Ccurrent%3Asource%2Cextensions%3AstructuredClone%28packet.extensions%29%7D%3B%0A%7D%0A%0Aexport%20function%20readCollectionSizeProjectionSchemaPacket%28%29%20%7B%0A%20const%20bytes%3DreadFileSync%28new%20URL%28COLLECTION_SIZE_PROJECTION_SCHEMA_POLICY.recipe%2Croot%29%29%3Bassert.equal%28pin%28bytes%29.sha256%2CrecipeSha256%29%3B%0A%20const%20packet%3DreadProjectData%28new%20URL%28COLLECTION_SIZE_PROJECTION_SCHEMA_POLICY.recipe%2Croot%29%29%3BverifyCollectionSizeProjectionSchemaPacket%28packet%29%3Breturn%20packet%3B%0A%7D%0A%0A%2F%2A%2A%20Use%20only%20within%20explicit%20historical%20schema%20checks.%20Live%20classifiers%20and%20projectors%20read%20current%20files%20directly.%20%2A%2F%0Aexport%20function%20restoreCollectionSizeProjectionSchema%28bytes%2Cfile%29%20%7B%0A%20const%20policy%3DCOLLECTION_SIZE_PROJECTION_SCHEMA_POLICY%3Bassert.ok%28policy.files.includes%28file%29%29%3B%0A%20assert.ok%28Buffer.isBuffer%28bytes%29%26%26bytes.length%3C%3D256%2A1024%29%3Bconst%20source%3Dbytes.toString%28%27utf8%27%29%3Bassert.equal%28Buffer.from%28source%29.equals%28bytes%29%2Ctrue%29%3B%0A%20if%28pin%28bytes%29.sha256%3D%3D%3Dpolicy.predecessor.sha256%29%7Bassert.deepEqual%28pin%28bytes%29%2Cpolicy.predecessor%29%3Breturn%20source%3B%7D%0A%20if%28%21sourcePair%29sourcePair%3DverifyCollectionSizeProjectionSchemaPacket%28readCollectionSizeProjectionSchemaPacket%28%29%29%3B%0A%20const%20historical%3DrestoreTruthyProjectionHistoricalSource%28bytes%2Cfile%29%3B%0A%20assert.equal%28historical%2CsourcePair.current%2C%27unknown%20complete%20current%20schema%20changes%20refuse%20historical%20source%20authority%27%29%3B%0A%20return%20sourcePair.predecessor%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
