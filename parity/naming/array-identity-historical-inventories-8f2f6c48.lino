UCCESSOR%20%3D%20Object.freeze%28%7B%0A%20%20version%3A1%2C%0A%20%20original%3AObject.freeze%28%7B%0A%20%20%20%20file%3A%27experiments%2Foriginal-link-complete-table-projection%2Fdata%2Fraw-consuming-native-definitions.lino%27%2C%0A%20%20%20%20revision%3A%27410f51f086010fcfa895001f4f12b61700fbcfad%27%2Cbytes%3A1801946%2C%0A%20%20%20%20sha256%3A%273c1793f7ce672a846e2fc480f20596e985b9528644748a8078cd170ef5ac81c8%27%2C%0A%20%20%7D%29%2C%0A%20%20currentArtifact%3A%27data%2Fraw-consuming-current-native-definitions.lino%27%2C%0A%20%20receiptRefresh%3AORIGINAL_LINK_RAW_COLLECTION_ARCHIVE_RECEIPT_REFRESH%2C%0A%20%20%2F%2F%20No%20archive%20difference%20has%20been%20observed.%20Only%20reviewed%20exact%20before%2Fafter%0A%20%20%2F%2F%20textSha256%20or%20binarySha256%20rows%20may%20be%20added%3B%20every%20other%20field%20stays%20exact.%0A%20%20archiveChanges%3AObject.freeze%28%5B%5D%29%2C%0A%7D%29%3B%0Aconst%20root%20%3D%20new%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20sha256%20%3D%20value%20%3D%3E%20createHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0Aconst%20sourceArtifact%20%3D%20ORIGINAL_LINK_RAW_CONSUMING_SUCCESSOR.currentArtifact%3B%0Aconst%20maximumRecords%20%3D%201_000_000%2C%20maximumArchiveBytes%20%3D%2064%20%2A%201024%20%2A%201024%3B%0Aconst%20decisionFiles%20%3D%20Object.freeze%28%5B%0A%20%20%27experiments%2Foriginal-link-complete-table-projection%2Fraw-consuming-emission.mjs%27%2C%0A%20%20%27js%2Fsrc%2Ftranslation%2Fjavascript.js%27%2C%20%27js%2Fsrc%2Ftranslation%2Fjavascript-infer.js%27%2C%0A%20%20%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%20%27js%2Fsrc%2Ftranslation%2Femit-rust.js%27%2C%0A%20%20%27js%2Fsrc%2Ftranslation%2Femit-javascript.js%27%2C%0A%20%20%27js%2Fsrc%2Ftranslation%2Fowned-array-moves.js%27%2C%20%27js%2Fsrc%2Ftranslation%2Fowned-array-append-rules.js%27%2C%0A%20%20%27js%2Fsrc%2Ftranslation%2Ffact-column-rules.js%27%2C%20%27js%2Fsrc%2Ftyped-program-link-rules.js%27%2C%0A%20%20%27js%2Fsrc%2Ftyped-program-links.js%27%2C%20%27js%2Fsrc%2Ftyped-program-checked-projection.js%27%2C%0A%5D%29%3B%0Aconst%20decisionSources%20%3D%20read%20%3D%3E%20decisionFiles.map%28file%20%3D%3E%20%7B%0A%20%20const%20bytes%20%3D%20read%28new%20URL%28file%2Croot%29%29%3B%0A%20%20return%20%7Bfile%2Cbytes%3Abytes.length%2Csha256%3Asha256%28bytes%29%7D%3B%0A%7D%29%3B%0Aconst%20words%20%3D%20tokens%20%3D%3E%20tokens.filter%28token%20%3D%3E%20token.kind%20%21%3D%3D%20%27eof%27%29%0A%20%20.map%28token%20%3D%3E%20token.kind%20%3D%3D%3D%20%27number%27%20%3F%20token.raw%20%3A%20token.value%29%3B%0A%0A%2F%2A%2A%20Inspect%20actual%20emitted%20tokens%3B%20a%20spelling%20inside%20a%20String%20is%20never%20a%20site.%20%2A%2F%0Aexport%20function%20readOriginalLinkRawConsumingOwnerSites%28source%29%20%7B%0A%20%20const%20items%20%3D%20readRustLibraryItems%28source%29.items%3B%0A%20%20assert.equal%28items.length%2C1%2C%27one%20complete%20emitted%20owner%20is%20inspected%27%29%3B%0A%20%20const%20owner%20%3D%20items%5B0%5D%2C%20tokens%20%3D%20tokenize%28owner.source%2C%27Rust%27%29.tokens%3B%0A%20%20const%20body%20%3D%20tokens.findIndex%28token%20%3D%3E%20token.kind%20%3D%3D%3D%20%27punct%27%20%26%26%20token.value%20%3D%3D%3D%20%27%7B%27%29%3B%0A%20%20assert.ok%28body%20%3E%3D%200%2C%27the%20complete%20emitted%20owner%20has%20its%20body%27%29%3B%0A%20%20const%20clones%20%3D%20%5B%5D%2C%20appends%20%3D%20%5B%5D%2C%20consumingAppendBindings%20%3D%20%5B%5D%3B%0A%20%20for%28let%20at%3Dbody%2B1%3Bat%3Ctokens.length%3Bat%2B%2B%29%20%7B%0A%20%20%20%20const%20token%20%3D%20tokens%5Bat%5D%3B%0A%20%20%20%20if%28token.kind%20%3D%3D%3D%20%27identifier%27%20%26%26%20token.value%20%3D%3D%3D%20%27clone%27%20%26%26%20tokens%5Bat-1%5D%3F.value%20%3D%3D%3D%20%27.%27%0A%20%20%20%20%20%20%26%26%20tokens%5Bat%2B1%5D%3F.value%20%3D%3D%3D%20%27%28%27%20%26%26%20tokens%5Bat%2B2%5D%3F.value%20%3D%3D%3D%20%27%29%27%29%20clones.push%28token.start%29%3B%0A%20%20%20%20if%28token.kind%20%3D%3D%3D%20%27identifier%27%20%26%26%20token.value%20%3D%3D%3D%20%27append%27%20%26%26%20tokens%5Bat-1%5D%3F.value%20%3D%3D%3D%20%27%3A%3A%27%0A%20%20%20%20%20%20%26%26%20tokens%5Bat-2%5D%3F.value%20%3D%3D%3D%20%27ml_array%27%20%26%26%20tokens%5Bat%2B1%5D%3F.value%20%3D%3D%3D%20%27%28%27%29%20appends.push%28token.start%29%3B%0A%20%20%20%20if%28token.kind%20%3D%3D%3D%20%27identifier%27%20%26%26%20token.value%20%3D%3D%3D%20%27ml_append_left%27%0A%20%20%20%20%20%20%26%26%20tokens%5Bat-1%5D%3F.value%20%3D%3D%3D%20%27%2C%27%20%26%26%20tokens%5Bat%2B1%5D%3F.value%20%3D%3D%3D%20%27%29%27%29%20consumingAppendBindings.push%28token.start%29%3B%0A%20%20%7D%0A%20%20return%20%7Btarget%3Aowner.name%2Ckind%3Aowner.kind%2Cheader%3Awords%28tokens.slice%280%2Cbody%29%29%2Cbytes%3ABuffer.byteLength%28source%29%2C%0A%20%20%20%20sha256%3Asha256%28source%29%2CcloneSites%3Aclones%2CappendSites%3Aappends%2CconsumingAppendBindingSites%3AconsumingAppendBindings%7D%3B%0A%7D%0A%0Afunction%20consumingOwners%28emitted%2Cinventory%29%20%7B%0A%20%20assert.equal%28emitted.definitions.length%2Cinventory.length%29%3B%0A%20%20return%20inventory.map%28%28owner%2Cindex%29%20%3D%3E%20%7B%0A%20%20%20%20const%20mappings%20%3D%20emitted.mappings.filter%28mapping%20%3D%3E%20mapping.source%20%3D%3D%3D%20owner.fullName%0A%20%20%20%20%20%20%26%26%20mapping.kind%20%3D%3D%3D%20%28owner.kind%20%3D%3D%3D%20%27fn%27%20%3F%20%27function%27%20%3A%20owner.kind%29%29%3B%0A%20%20%20%20assert.equal%28mappings.length%2C1%2C%27one%20complete%20emitted%20source%20mapping%3A%20%27%2Bowner.fullName%29%3B%0A%20%20%20%20const%20sites%20%3D%20readOriginalLinkRawConsumingOwnerSites%28emitted.definitions%5Bindex%5D%29%3B%0A%20%20%20%20assert.equal%28sites.target%2Cmappings%5B0%5D.target%2C%27the%20actual%20definition%20order%20follows%20the%20checked%20owner%20order%27%29%3B%0A%20%20%20%20assert.equal%28sites.kind%2Cowner.kind%20%3D%3D%3D%20%27fn%27%20%3F%20%27fn%27%20%3A%20%27enum%27%29%3B%0A%20%20%20%20return%20sites%3B%0A%20%20%7D%29%3B%0A%7D%0Aconst%20totals%20%3D%20owners%20%3D%3E%20%28%7