%28%29%29%7Bassert.equal%28inverse.split%28edit.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28edit.after%2C%28%29%3D%3Eedit.before%29%3B%7D%0A%20%20assert.equal%28inverse%2Chistory.driver.source%2C%27every%20original%20driver%20byte%20and%20unchanged%20policy%20call%20remains%20recoverable%27%29%3B%0A%20%20return%20history%3B%0A%7D%0A%0A%2F%2A%2A%20Bootstrap%20decoding%20avoids%20retaining%20a%20second%20full%20graph%20in%20the%20normal%20check.%20%2A%2F%0Aexport%20function%20readOwnCodebaseHistoricalNamingSources%28%29%7B%0A%20%20const%20file%3Dnew%20URL%28%27..%2F..%2Fparity%2Fnaming%2Fown-codebase-baseline-naming-history.lino%27%2Cimport.meta.url%29%3B%0A%20%20const%20text%3DreadFileSync%28file%2C%27utf8%27%29%3B%0A%20%20if%28originalSnapshot%3F.text%21%3D%3Dtext%29%7BoriginalSnapshot%3Dundefined%3BoriginalSnapshot%3D%7Btext%2Cvalue%3AverifyOwnCodebaseHistoricalNamingSources%28readBootstrapStructuredDataLino%28text%29%29%7D%3B%7D%0A%20%20return%20structuredClone%28originalSnapshot.value%29%3B%0A%7D%0A%0A%2F%2A%2A%20Supplement%20only%20two%20original%20inventories%20after%20authenticating%20current%20modules.%20%2A%2F%0Aexport%20function%20extractOwnCodebaseHistoricalNames%28root%2Cinventories%2Chistory%3DreadOwnCodebaseHistoricalNamingSources%28%29%29%7B%0A%20%20verifyOwnCodebaseHistoricalNamingSources%28history%29%3B%0A%20%20assert.deepEqual%28pin%28readFileSync%28resolve%28root%2Cpolicy.driver.file%29%29%29%2Cpolicy.driver.current%2C%27the%20entire%20naming%20driver%20has%20its%20reviewed%20additive%20source%20view%27%29%3B%0A%20%20const%20names%3D%5B%5D%3B%0A%20%20for%28const%20view%20of%20history.views%29%7B%0A%20%20%20%20assert.deepEqual%28pin%28readFileSync%28resolve%28root%2Cview.file%29%29%29%2Cview.current%2C%27unknown%20complete%20current%20source%20cannot%20acquire%20historical%20naming%20authority%27%29%3B%0A%20%20%20%20const%20entries%3Dinventories.filter%28entry%3D%3Eentry.inventory%3D%3D%3Dview.inventory%26%26entry.files.length%3D%3D%3D1%26%26entry.files%5B0%5D%3D%3D%3Dview.file%29%3B%0A%20%20%20%20assert.equal%28entries.length%2C1%2C%27one%20unchanged%20actual%20historical%20inventory%20extractor%27%29%3B%0A%20%20%20%20const%20entry%3Dentries%5B0%5D%2Cfound%3D%5B...new%20Set%28entry.extract%28view.predecessor.source%2Cview.file%29%29%5D.map%28name%3D%3E%28%7Bname%2Crecord%3Aentry.recordOf%28name%29%7D%29%29%3B%0A%20%20%20%20assert.deepEqual%28found%2Cview.names%2C%27every%20name%20comes%20from%20the%20complete%20certified%20original%20source%20and%20unchanged%20extractor%27%29%3B%0A%20%20%20%20names.push%28...found.map%28row%3D%3E%28%7Binventory%3Aview.inventory%2Cfile%3Aview.file%2C...row%2CsourceView%3A%7B%0A%20%20%20%20%20%20kind%3A%27complete%20certified%20historical%20source%27%2Crevision%3Apolicy.revision%2Cpath%3Aview.file%2C%0A%20%20%20%20%20%20bytes%3Aview.predecessor.bytes%2Csha256%3Aview.predecessor.sha256%2C%0A%20%20%20%20%20%20archive%3A%27parity%2Fnaming%2Fown-codebase-baseline-naming-history.lino%27%2C%0A%20%20%20%20%20%20boundary%3A%27Historical%20definitions%20keep%20their%20original%20identities.%20Every%20actual%20current%20inventory%20row%20is%20retained%20separately%3B%20changed%20source%20owners%20have%20distinct%20qualified%20records.%27%7D%7D%29%29%29%3B%0A%20%20%7D%0A%20%20const%20additional%3DreadOwnCodebaseHistoricalNamingPolicy%28%29.additionalSourceViews%3B%0A%20%20for%28const%20view%20of%20additional.views%29%7B%0A%20%20%20%20const%20source%3Dadditional.sources.find%28row%3D%3Erow.file%3D%3D%3Dview.file%26%26row.predecessor.revision%3D%3D%3Dview.revision%29%3B%0A%20%20%20%20const%20entries%3Dinventories.filter%28entry%3D%3Eentry.inventory%3D%3D%3Dview.inventory%26%26entry.files.includes%28view.file%29%29%3B%0A%20%20%20%20if%28entries.length%3D%3D%3D0%29continue%3B%0A%20%20%20%20assert.equal%28entries.length%2C1%2C%27the%20same%20actual%20extractor%20owns%20the%20additional%20historical%20names%27%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28readFileSync%28resolve%28root%2Cview.file%29%29%29%2Csource.current%2C%27the%20selected%20root%20retains%20every%20complete%20actual%20source%20byte%27%29%3B%0A%20%20%20%20const%20entry%3Dentries%5B0%5D%2Cfound%3D%5B...new%20Set%28entry.extract%28source.predecessor.source%2Cview.file%29%29%5D%0A%20%20%20%20%20%20.map%28name%3D%3E%28%7Bname%2Crecord%3Aentry.recordOf%28name%29%7D%29%29%3B%0A%20%20%20%20const%20current%3Dnew%20Set%28entry.extract%28readFileSync%28resolve%28root%2Cview.file%29%2C%27utf8%27%29%2Cview.file%29%29%3B%0A%20%20%20%20for%28const%20row%20of%20view.names%29%7B%0A%20%20%20%20%20%20assert.ok%28found.some%28candidate%3D%3Ecandidate.name%3D%3D%3Drow.name%26%26candidate.record%3D%3D%3Drow.record%29%2C%27an%20unchanged%20extractor%20must%20derive%20each%20original%20name%20and%20identity%27%29%3B%0A%20%20%20%20%20%20assert.equal%28current.has%28row.name%29%2Cfalse%2C%27actual%20current%20names%20stay%20in%20the%20separate%20current%20inventory%27%29%3B%0A%20%20%20%20%20%20names.push%28%7Binventory%3Aview.inventory%2Cfile%3Aview.file%2C...row%2CsourceView%3A%7B%0A%20%20%20%20%20%20%20%20kind%3A%27complete%20certified%20historical%20source%27%2Crevision%3Aview.revision%2Cpath%3Aview.file%2C%0A%20%20%20%20%20%20%20%20bytes%3Asource.predecessor.bytes%2Csha256%3Asource.predecessor.sha256%2C%0A%20%20%20%20%20%20%20%20archive%3A%27parity%2Fnaming%2Farray-identity-historical-inventories.lino%27%2Cboundary%3Aadditional.boundary%7D%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20return%20names%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
