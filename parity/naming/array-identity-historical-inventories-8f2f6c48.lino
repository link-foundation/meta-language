eProgram%3Atrue%7D%29%2Crestored%29%3B%0A%20%20%20assert.deepEqual%28observe%28emitTypedProgramLinks%28network%2Cpacket.root%2C%27JavaScript%27%29.code%29%2Cinput.expected%2Cinput.id%29%3B%0A%20%20%20assert.equal%28emitTypedProgramLinks%28network%2Cpacket.root%2C%27Rust%27%29.code%2Crust%29%3B%0A%20%20%7D%0A%20%7D%0A%7D%29%3B%0A%0Atest%28%27Boolean%20conversion%20projection%20cannot%20hide%20forged%20owners%20types%20operands%20operations%20or%20result%20wrappers%27%2C%28%29%3D%3E%7B%0A%20const%20source%3DTRUTHY_PROJECTION_CASES%5B0%5D.source%2Coriginal%3DcheckProgram%28parseJavaScript%28source%29%29%3B%0A%20for%28const%20change%20of%20%5B%0A%20%20%28program%2Cvalue%29%3D%3E%7Bvalue.type%3D%7Bkind%3A%27string%27%7D%3B%7D%2C%0A%20%20%28program%2Cvalue%29%3D%3E%7Bvalue.arg.name%3D%27unbound%27%3B%7D%2C%0A%20%20%28program%2Cvalue%29%3D%3E%7Bvalue.arg.type%3D%7Bkind%3A%27string%27%7D%3B%7D%2C%0A%20%20%28program%2Cvalue%29%3D%3E%7Bvalue.op%3D%27arbitrary%27%3B%7D%2C%0A%20%20%28program%2Cvalue%29%3D%3E%7Bvalue.unrepresentedPolicy%3Dtrue%3B%7D%2C%0A%20%20%28program%2Cvalue%29%3D%3E%7Bvalue.arg%3D%7Bk%3A%27lit%27%2Cvalue%3Atrue%2Ctype%3A%7Bkind%3A%27bool%27%7D%7D%3B%7D%2C%0A%20%5D%29%7B%0A%20%20const%20changed%3DstructuredClone%28original%29%3Bchange%28changed%2Ctruthy%28changed%29%5B0%5D%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErecheckLinkedTypedProgram%28changed%2C%7BwholeProgram%3Atrue%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3E%7BrecheckLinkedTypedProgram%28changed%2C%7BwholeProgram%3Atrue%7D%29%3Breturn%20encodeTypedProgramLinks%28changed%29%3B%7D%29%3B%0A%20%7D%0A%20const%20packet%3DencodeTypedProgramLinks%28original%29%3B%0A%20for%28const%20reload%20of%20archives%28packet.network%29%29%7B%0A%20%20const%20owner%3Dreload.fieldRelations%28%29.find%28row%3D%3Erow.label%3D%3D%3D%27construct%20kind%27%26%26reload.link%28row.child%29.metadata%28%29.definition%3D%3D%3D%27truthy%27%29%3B%0A%20%20assert.ok%28owner%29%3Breload.insertFieldRelation%28owner.parent%2C%27unrep