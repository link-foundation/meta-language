es.push%28%7Bmodule%2Cprevious%3AstructuredClone%28previous%29%2Ccurrent%3A%7Brevision%2Csource%3Acurrent.source%2Ccertificate%3Acurrent.certificate%7D%7D%29%3B%0A%20%20%20%20%20%20if%28current.source%21%3D%3Dprevious.source%29inverse.push%28%7Bmodule%2Cfrom%3Acurrent.source%2Cto%3Aprevious.source%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.deepEqual%28inverse.map%28row%3D%3Erow.module%29%2C%28review.modules%3F%3F%5Breview%5D%29.map%28row%3D%3Erow.module%29%2C%27only%20the%20complete%20individually%20reviewed%20source%20providers%20change%27%29%3B%0A%20%20%20%20const%20metadata%3Drow%3D%3E%28%7Brevision%3Arow.revision%2Cfile%3Arow.file%2Cbytes%3Arow.bytes%2Csha256%3Arow.sha256%2Ccertificate%3Arow.certificate%7D%29%3B%0A%20%20%20%20const%20profile%3D%7BsourceCommit%3Arevision%2CpreviousSourceCommit%3Alast.sourceCommit%2Creview%3Areview.review%2Cproviders%2Cinverse%2Ccertificates%2C%0A%20%20%20%20%20%20epoch%3A%7BreviewKind%3Areview.kind%2CpredecessorPacket%3Ametadata%28preceding%29%2CpredecessorOutputs%3ApriorOutputs.map%28metadata%29%7D%7D%3B%0A%20%20%20%20packet%3D%7B...original%2Cprofiles%3A%5B...original.profiles%2Cprofile%5D%7D%3B%0A%20%20%20%20verifyReviewedOverlayProviderSuccessionHistory%28packet%29%3BverifyCurrentReviewedOverlayProviderSources%28packet%29%3B%0A%20%20%20%20%2F%2F%20The%20prior%20complete%20packet%2Fthree%20receipts%20are%20independently%20certified%20at%0A%20%20%20%20%2F%2F%20this%20real%20commit%20but%20never%20duplicated%20as%20a%20new%20multi-megabyte%20snapshot.%0A%20%20%20%20const%20currentOutputs%3Doutputs%28packet%29%2ChelperPath%3Dnew%20URL%28helperFile%2Croot%29%2Chelper%3DreadFileSync%28helperPath%2C%27utf8%27%29%3B%0A%20%20%20%20const%20pattern%3D%2Fconst%20packetSha256%3D%27%5Ba-f0-9%5D%7B64%7D%27%3B%2Fu%3Bassert.equal%28helper.split%28pattern%29.length%2C2%29%3B%0A%20%20%20%20const%20source%3DserializeProjectData%28packet%2Coutput%29%2Cupdated%3Dhelper.replace%28pattern%2C%22const%20packetSha256%3D%27%22%2Bhash%28source%29%2B