%29.map%28input%3D%3EString%28input.expected%29%29%2CTRUTHY_PROJECTION_LITERAL_INPUT.expected%29%3B%0A%7D%29%3B%0A%0Atest%28%27complete%20original%20string%20parameter%20preserves%20the%20same%20values%20and%20lone%20surrogates%20through%20both%20checked%20semantic%20codecs%27%2C%28%29%3D%3E%7B%0A%20const%20source%3DTRUTHY_PROJECTION_HOST_PARAMETER_SOURCE%3B%0A%20const%20original%3DrunInNewContext%28source%2B%27%5Cnprobe%3B%27%2C%7B%7D%2C%20%7Btimeout%3A1000%7D%29%3B%0A%20const%20values%3DTRUTHY_PROJECTION_HOST_PARAMETER_VALUES.map%28input%3D%3EString.fromCharCode%28...input.units%29%29%3B%0A%20for%28const%20%5Bindex%2Cvalue%5Dof%20values.entries%28%29%29assert.equal%28original%28value%29%2CTRUTHY_PROJECTION_HOST_PARAMETER_VALUES%5Bindex%5D.expected%29%3B%0A%20%2F%2F%20The%20first%20six%20values%20are%20exactly%20those%20evaluated%20by%20the%20retained%20complete%0A%20%2F%2F%20literal%20input%2C%20including%20its%20otherwise%20unsupported%20lone%20high%20surrogate.%0A%20const%20literalValues%3DrunInNewContext%28%27%5B%22%22%2C%220%22%2C%22false%22%2C%22%5C%5Cu0000%22%2C%22%5C%5Cud800%22%2C%22%F0%9F%98%80%22%5D%27%2C%7B%7D%2C%20%7Btimeout%3A1000%7D%29%3B%0A%20assert.deepEqual%28values.slice%280%2C6%29%2CArray.from%28literalValues%29%29%3B%0A%20const%20program%3DcheckProgram%28parseJavaScript%28source%29%29%3Bprogram.utf16Strings%3Dtrue%3B%0A%20assert.equal%28recheckLinkedTypedProgram%28program%2C%7BwholeProgram%3Atrue%7D%29%2Cprogram%29%3B%0A%20assert.equal%28truthy%28program%29.length%2C1%29%3B%0A%20const%20packet%3DencodeTypedProgramLinks%28program%29%2Crust%3DemitTypedProgramLinks%28packet.network%2Cpacket.root%2C%27Rust%27%29.code%3B%0A%20for%28const%20network%20of%20archives%28packet.network%29%29%7B%0A%20%20const%20restored%3DdecodeTypedProgramLinks%28network%2Cpacket.root%29%3Bassert.deepEqual%28restored%2Cprogram%29%3B%0A%20%20assert.equal%28restored.utf16Strings%2Ctrue%29%3Bassert.equal%28recheckLinkedTypedProgram%28restored%2C%7BwholeProgram%3Atrue%7D%29%2C