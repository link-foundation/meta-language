t%29%2C%27utf8%27%29%2Crow.current.sourceText%2C%27normal%20refresh%20uses%20exact%20actual%20current%20source%20bytes%27%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28packet.adapters%2Cprevious.adapters%2C%27the%20complete%20three%20original%20adapter%20recipes%20remain%20exact%27%29%3B%0A%20%20for%28const%20row%20of%20packet.adapters%29assert.equal%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2CderiveCurrentOwnCodebaseRawDescriptorSource%28row%29%29%3B%0A%20%20assert.equal%28packet.edge.changes.length%2Cprevious.edge.changes.length%2C%27all%20ten%20logical%20descriptor%20fields%20remain%20represented%27%29%3B%0A%20%20return%20packet%3B%0A%7D%0A%0Afunction%20load%28%29%7B%0A%20%20if%28%21cached%29%7Bconst%20bytes%3DreadFileSync%28new%20URL%28output%2Croot%29%29%3Bassert.equal%28pin%28bytes%29.sha256%2CpolicySha256%2C%27the%20entire%20finite%20reviewed%20packet%20is%20pinned%27%29%3Bcached%3DverifyCurrentOwnCodebaseRawDescriptorPacket%28readBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%29%3B%7D%0A%20%20return%20cached%3B%0A%7D%0Aexport%20function%20readCurrentOwnCodebaseRawDescriptorPacket%28%29%7Breturn%20structuredClone%28load%28%29%29%3B%7D%0A%0A%2F%2A%2A%20Historical%20assertions%20get%20an%20exact%20whole%20source%20view%2C%20never%20arbitrary%20input.%20%2A%2F%0Aexport%20function%20restoreCurrentOwnCodebaseRawSource%28source%2Cfile%2CcurrentOnly%3Dfalse%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bconst%20row%3Dload%28%29.sources.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28row%2C%27one%20exact%20source%20path%27%29%3B%0A%20%20if%28source%3D%3D%3Drow.sourceText%29return%20source%3B%0A%20%20if%28currentOnly%26%26pin%28source%29.sha256%21%3D%3Drow.current.sha256%29return%20source%3B%0A%20%20assert.deepEqual%28pin%28source%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3Bassert.equal%28source%2Crow.current.sourceText%29%3B%0A%20%20return%20row.sourceText%3B%0A%7D%0A%0Afunctio