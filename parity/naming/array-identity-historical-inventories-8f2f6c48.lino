ds%5D.sort%28%29%2C%27the%20complete%20registration%20proof%20layout%20is%20exact%27%29%3B%0A%0Aexport%20function%20replayProgramStringRegistrationChanges%28source%2Cchanges%29%7B%0A%20%20let%20current%3Dsource%3Bconst%20edits%3D%5B%5D%3B%0A%20%20for%28const%20change%20of%20changes%29%7B%0A%20%20%20%20assert.equal%28current.split%28change.before%29.length%2C2%2C%27one%20exact%20reviewed%20registration%2Fsource%20interval%27%29%3B%0A%20%20%20%20const%20start%3Dcurrent.indexOf%28change.before%29%3B%0A%20%20%20%20edits.push%28%7Bstart%2Cremoved%3Achange.before%2Cinserted%3Achange.after%7D%29%3B%0A%20%20%20%20current%3Dcurrent.slice%280%2Cstart%29%2Bchange.after%2Bcurrent.slice%28start%2Bchange.before.length%29%3B%0A%20%20%7D%0A%20%20let%20inverse%3Dcurrent%3B%0A%20%20for%28const%20edit%20of%20edits.toReversed%28%29%29%7B%0A%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%7D%0A%20%20assert.equal%28inverse%2Csource%2C%27every%20complete%20predecessor%20byte%20remains%20exact%27%29%3B%0A%20%20return%7Bsource%3Acurrent%2Cedits%7D%3B%0A%7D%0A%0Afunction%20originalHosts%28%29%7B%0A%20%20if%28%21cachedArchive%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28PROGRAM_STRING_HOST_ARCHIVE.path%2Croot%29%29%3B%0A%20%20%20%20assert.deepEqual%28programStringHostRegistrationPin%28bytes%29%2C%7Bbytes%3APROGRAM_STRING_HOST_ARCHIVE.bytes%2Csha256%3APROGRAM_STRING_HOST_ARCHIVE.sha256%7D%2C%27the%20frozen%20nine-host%20artifact%20is%20unchanged%27%29%3B%0A%20%20%20%20cachedArchive%3D%7Bbytes%2Cvalue%3AreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%7D%3B%0A%20%20%7D%0A%20%20return%20cachedArchive%3B%0A%7D%0A%0A%2F%2A%2A%20Authenticate%20complete%20current%20files%2C%20then%20invert%20only%20the%20declared%20literal%0A%20%2A%20registrations.%20Frozen%20h