LUDE_BEGIN%20%3D%20%27%2F%2F%20meta-language%3Aprelude%20begin%27%3B%0Aconst%20PRELUDE_END%20%3D%20%27%2F%2F%20meta-language%3Aprelude%20end%27%3B%0A%2F%2F%20Portable-core%20Rust%20keeps%20the%20source%27s%20parentheses%20and%20names.%0Aconst%20RUST_ALLOW%20%3D%20%27%23%21%5Ballow%28unused%2C%20unreachable_patterns%2C%20non_snake_case%2C%20non_camel_case_types%2C%20invalid_nan_comparisons%29%5D%27%3B%0Aconst%20ALIASES%20%3D%20new%20Map%28%5B%0A%20%20%5B%27javascript%27%2C%20%27JavaScript%27%5D%2C%20%5B%27js%27%2C%20%27JavaScript%27%5D%2C%20%5B%27mjs%27%2C%20%27JavaScript%27%5D%2C%0A%20%20%5B%27typescript%27%2C%20%27TypeScript%27%5D%2C%20%5B%27ts%27%2C%20%27TypeScript%27%5D%2C%0A%20%20%5B%27rust%27%2C%20%27Rust%27%5D%2C%20%5B%27rs%27%2C%20%27Rust%27%5D%2C%0A%5D%29%3B%0Aconst%20COMMENTS%20%3D%20new%20Set%28%5B%27comment%27%2C%20%27line_comment%27%2C%20%27block_comment%27%5D%29%3B%0A%0A%2F%2A%2A%20Thrown%20for%20an%20unknown%20language%20or%20a%20source%20the%20links%20do%20not%20reproduce.%20%2A%2F%0Aexport%20class%20SelfTranslationError%20extends%20Error%20%7B%0A%20%20constructor%28message%29%20%7B%0A%20%20%20%20super%28message%29%3B%0A%20%20%20%20this.name%20%3D%20%27SelfTranslationError%27%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20The%20self-translation%20language%20%60language%60%20names%2C%20or%20%60null%60.%20%2A%2F%0Aexport%20function%20selfTranslationLanguage%28language%29%20%7B%0A%20%20return%20ALIASES.get%28String%28language%29.toLowerCase%28%29%29%20%3F%3F%20null%3B%0A%7D%0A%0Afunction%20required%28language%29%20%7B%0A%20%20const%20name%20%3D%20selfTranslationLanguage%28language%29%3B%0A%20%20if%20%28%21name%29%20throw%20new%20SelfTranslationError%28%60self-translation%20reads%20and%20writes%20%24%7BSELF_TRANSLATION_LANGUAGES.join%28%27%2C%20%27%29%7D%2C%20not%20%24%7Blanguage%7D%60%29%3B%0A%20%20return%20name%3B%0A%7D%0A%0A%2F%2F%20The%20family%20a%20language%27s%20code%20is%20written%20in%3A%20TypeScript%20items%20are%20read%20and%0A%2F%2F%20written%20as%20JavaScript.%0Aconst%20family%20%3D%20%28language%29%20%3D%3E%20%28language%20%3D%3D%3D%20%27Rust%27%20%3F%20%27Rust%27%20%3A%20%27JavaScript%27%29%3B%0Aconst%20sha256%20%3D%20%28text%29%20%3D%3E%20createHash%28%27sha256%27%29.update%28Buffer.from%28text%2C%20%27utf8%27%29%29.digest%28%27hex%27%29%3B%0A%0A%2F%2A%2A%0A%20%2A%20Translates%20%60source%60%20from%20%60sourceLanguage%60%20to%20%60targetLanguage%60%2C%20each%20one%20of%0A%20%2A%20%7B%40link%20SELF_TRANSLATION_LANGUAGES%7D%20or%20an%20alias%20of%20one.%0A%20%2A%0A%20%2A%20The%20result%20is%20%60%7B%20sourceLanguage%2C%20targetLanguage%2C%20code%2C%20items%20%7D%60.%20Each%20item%0A%20%2A%20%60%7B%20term%2C%20start%2C%20end%2C%20status%2C%20reason%20%7D%60%20is%20a%20top-level%20item%20of%20the%20source%0A%20%2A%20%28byte%20offsets%29%20with%20its%20status%3A%20%60kept%60%20%28same%20language%29%2C%20%60translated%60%2C%0A%20%2A%20%60restored%60%20%28provenance%20gave%20back%20its%20source%29%2C%20%60comment%60%2C%20%60provenance%60%20%28a%0A%20%2A%20self-translation%20header%20or%20prelude%29%20or%20%60carried%60%2C%20with%20the%20reason%20it%20was%0A%20%2A%20carried.%0A%20%2A%0A%20%2A%20%60options.decorators%60%20%28a%20DecoratorSet%20or%20an%20array%20of%20decorators%29%20decorates%0A%20%2A%20each%20translated%20item%20at%20the%20%60emitter%60%20level%2C%20one%20%60%7B%20format%2C%20number%2C%20line%20%7D%60%0A%20%2A%20record%20per%20line%20of%20its%20definitions%20with%20the%20target%20language%20as%20%60format%60%2C%0A%20%2A%20before%20its%20provenance%20is%20recorded%2C%20so%20a%20translation%20can%20be%20brought%20to%20match%0A%20%2A%20hand-written%20code%20and%20still%20restores%20its%20source.%0A%20%2A%0A%20%2A%20From%20JavaScript%20or%20TypeScript%20into%20Rust%2C%20an%20item%20may%20call%20and%20read%20the%0A%20%2A%20module%27s%20other%20top-level%20items%3A%20each%20item%20is%20translated%20after%20the%20items%20it%0A%20%2A%20names%2C%20with%20the%20signatures%20of%20those%20that%20translated%20bound%2C%20and%20the%20Rust%0A%20%2A%20names%20them%20as%20its%20own%20translation%20does.%20%60import%20%7B%20a%2C%20b%20as%20c%20%7D%20from%0A%20%2A%20%27.%2Fm.mjs%27%60%20becomes%20%60use%20crate%3A%3Am%3A%3A%7Ba%2C%20b%20as%20c%7D%3B%60%3A%20%60options.moduleDirectory%60%0A%20%2A%20%28path%20segments%2C%20the%20crate%20root%20by%20default%29%20is%20the%20module%27s%20directory%20inside%0A%20%2A%20the%20crate%2C%20and%20%60options.imports%60%20maps%20an%20import%20specifier%20to%20the%20signatures%0A%20%2A%20%7B%40link%20selfTranslationSignatures%7D%20gives%20for%20that%20module%2C%20which%20bind%20the%0A%20%2A%20imported%20names%20the%20same%20way.%0A%20%2A%0A%20%2A%20Report%20tooling%20can%20opt%20into%20%60retainDiagnostics%3A%20true%60%20to%20retain%20the%20actual%0A%20%2A%20TranslationError%20kind%2C%20reason%2C%20message%2C%20span%20and%20details%20on%20carried%20items.%0A%20%2A%20The%20diagnostic%20also%20records%20the%20complete%20source%20group%27s%20UTF-8%20byte%20range%3B%0A%20%2A%20the%20original%20frontend%20span%20is%20retained%20without%20coordinate%20conversion.%0A%20%2A%20This%20does%20not%20change%20emitted%20code%20or%20ordinary%20item%20fields.%0A%20%2A%2F%0Aexport%20function%20selfTranslate%28source%2C%20sourceLanguage%2C%20targetLanguage%2C%20options%20%3D%20%7B%7D%29%20%7B%0A%20%20return%20translateModule%28source%2C%20sourceLanguage%2C%20targetLanguage%2C%20options%29.translation%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20The%20signatures%20of%20the%20exported%20items%20of%20the%20JavaScript%20or%20TypeScript%20module%0A%20%2A%20%60source%60%20that%20translate%20into%20Rust%2C%20in%20source%20order%2C%20for%0A%20%2A%20%7B%40link%20selfTranslate%7D%27s%20%60options.imports%60%20of%20a%20module%20that%20imports%20them%3A%0A%20%2A%20%60%7B%20k%3A%20%27fn%27%2C%20name%2C%20params%3A%20%5B%7B%20name%2C%20type%20%7D%5D%2C%20ret%20%7D%60%20for%20a%20function%20and%0A%20%2A%20%60%7B%20k%3A%20%27const%27%2C%20name%2C%20type%2C%20literal%20%7D%60%20for%20a%20constant%2C%20where%20%60literal%60%20tells%0A%20%2A%20whether%20a%20literal%20gives%20its%20value.%20%60options%60%20are%20%7B%40link%20selfTranslate%7D%27s.%0A%20%2A%2F%0Aexport%20function%20selfTranslationSignatures%28source%2C%20language%2C%20options%20%3D%20%7B%7D%29%20%7B%0A%20%20if%20%28family%28required%28language%29%29%20%21%3D%3D%20%27JavaScript%27%29%20%7B%0A%20%20%20%20throw%20new%20SelfTranslationError%28%60signatures%20are%20read%20from%20JavaScript%20or%20TypeScript%20modules%2C%20not%20%24%7Blanguage%7D%60%29%3B%0A%20%20%7D%0A%20%20return%20translateModule%28source%2C%20language%2C%20%27Rust%27%2C%20options%2C%20true%29.signatures%3B%0A%7D%0A%0Afunction%20translateModule%28source%2C%20sourceLanguage%2C%20targetLanguage%2C%20%7B%20decorators%2C%20moduleDirectory%20%3D%20%5B%5D%2C%20imports%20%3D%20%7B%7D%2C%20utf16Strings%20%3D%20false%2C%20referenceSemantics%20%3D%20false%2C%20retainDiagnostics%20%3D%20false%20%7D%20%3D%20%7B%7D%2C%20signaturesOnly%20%3D%20false%29%20%7B%0A%20%20const%20from%20%3D%20required%28sourceLanguage%29%3B%0A%20%20const%20to%20%3D%20required%28targetLanguage%29%3B%0A%20%20const%20set%20%3D%20decoratorSet%28decorators%29%3B%0A%20%20const%20text%20%3D%20String%28source%29%3B%0A%20%20const%20bytes%20%3D%20Buffer.from%28text%2C%20%27utf8%27%29%3B%0A%20%20const%20parsed%20%3D%20parseProgrammingLanguage%28text%2C%20from%29%3B%0A%20%20%2F%2F%20Signature%20discovery%20still%20checks%20and%20translates%20every%20declaration.%20It%0A%20%20%2F%2F%20does%20not%20need%20a%20second%20complete%20source%20graph%20or%20a%20provenance%20envelope.%0A%20%20const%20reconstructed%20%3D%20signaturesOnly%20%3F%20bytes.toString%28%27utf8%27%29%20%3A%20LinkNetwork._parseWithLinks%28text%2C%20from%2C%20ParseConfiguration.default%28%29%2C%20parsed%29.network.reconstructText%28%29%3B%0A%20%20if%20%28reconstructed%20%21%3D%3D%20text%29%20%7B%0A%20%20%20%20throw%20new%20SelfTranslationError%28%60the%20%24%7Bfrom%7D%20links%20of%20the%20source%20do%20not%20re