20misrepresented%20as%20a%20committed%20source%27%29%3B%0A%20%20assert.equal%28original.worktreeBaseRevision%2Clocation.revision%29%3B%0A%20%20assert.equal%28Buffer.byteLength%28original.sourceText%29%2Coriginal.bytes%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28original.sourceText%29.digest%28%27hex%27%29%2Coriginal.sha256%29%3B%0A%20%20assert.equal%28restoreNodeDependencyGeneratorTestHistory%28readFileSync%28new%20URL%28import.meta.url%29%2C%27utf8%27%29%29%2Coriginal.sourceText%2Blocation.additions%29%3B%0A%20%20const%20classifier%3DrestoreOwnCodebaseTestRegistrationClassifier%28readFileSync%28new%20URL%28%27..%2F..%2F%27%2Blocation.classifier.file%2Cimport.meta.url%29%29%29%3B%0A%20%20assert.equal%28classifier.length%2Clocation.classifier.bytes%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28classifier%29.digest%28%27hex%27%29%2Clocation.classifier.sha256%29%3B%0A%20%20const%20files%3DtestFiles%28%29%2Cpartition%3DpartitionTests%28files%29%3B%0A%20%20assert.deepEqual%28partition.unassigned%2C%5B%5D%29%3Bassert.deepEqual%28partition.ambiguous%2C%5B%5D%29%3B%0A%20%20assert.ok%28files.includes%28%27issue-195-evidence-node-dependency.test.js%27%29%29%3B%0A%20%20assert.deepEqual%28partitionTests%28%5B%27issue-195-evidence-node-dependency.test.js%27%5D%29.groups.tooling%2C%5B%27issue-195-evidence-node-dependency.test.js%27%5D%29%3B%0A%20%20const%20registrationHistory%3DreadOwnCodebaseTestRegistrationHistory%28%29%3B%0A%20%20assert.equal%28registrationHistory.revision%2C%2752132727d7ce158762a4499b7032a42a9f16f3c3%27%29%3B%0A%20%20for%28const%20row%20of%20registrationHistory.sources%29%7B%0A%20%20%20%20const%20current%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Brow.file%2Cimport.meta.url%29%29%3B%0A%20%20%20%20assert.equal%28current.length%2Crow.current.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28current%29.digest%28%27hex%27%29%2Crow.current.sha256%29%3B%0A%20%20%7D%0A%20%20for%28const%20ro