nal.decisionSources%29%3B%0A%20%20const%20refresh%3Dsuccessor.receiptRefresh%2C%20applicability%3Dinverse.predecessor.proof.producerApplicability%3B%0A%20%20const%20originalApplicability%3Doriginal.predecessor.proof.producerApplicability%3B%0A%20%20assert.equal%28Object.hasOwn%28originalApplicability%2C%27receiptRefresh%27%29%2Cfalse%29%3B%0A%20%20assert.deepEqual%28applicability.receiptRefresh%2Crefresh%2C%27the%20exact%20predecessor%20receipt%20refresh%20remains%20reachable%27%29%3B%0A%20%20delete%20applicability.receiptRefresh%3B%0A%20%20const%20positions%3Dapplicability.sources.flatMap%28%28row%2Cindex%29%3D%3Erow.file%3D%3D%3Drefresh.current.file%3F%5Bindex%5D%3A%5B%5D%29%3B%0A%20%20const%20originalPositions%3DoriginalApplicability.sources.flatMap%28%28row%2Cindex%29%3D%3Erow.file%3D%3D%3Drefresh.previous.file%3F%5Bindex%5D%3A%5B%5D%29%3B%0A%20%20assert.equal%28positions.length%2C1%2C%27only%20one%20exact%20predecessor%20artifact%20descriptor%20is%20replaced%27%29%3B%0A%20%20assert.deepEqual%28positions%2CoriginalPositions%2C%27the%20predecessor%20artifact%20descriptor%20retains%20its%20original%20position%27%29%3B%0A%20%20assert.deepEqual%28applicability.sources%5Bpositions%5B0%5D%5D%2Crefresh.current%29%3B%0A%20%20assert.deepEqual%28originalApplicability.sources%5Bpositions%5B0%5D%5D%2Crefresh.previous%29%3B%0A%20%20applicability.sources%5Bpositions%5B0%5D%5D%3DstructuredClone%28refresh.previous%29%3B%0A%20%20const%20fields%3Dnew%20Set%28%29%3B%0A%20%20for%28const%20change%20of%20successor.archiveChanges%29%20%7B%0A%20%20%20%20assert.ok%28%5B%27textSha256%27%2C%27binarySha256%27%5D.includes%28change.field%29%26%26%21fields.has%28change.field%29%2C%0A%20%20%20%20%20%20%27only%20distinct%20reviewed%20complete%20archive%20digest%20changes%20are%20admitted%27%29%3B%0A%20%20%20%20fields.add%28change.field%29%3B%0A%20%20%20%20assert.match%28change.before%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3Bassert.match%28change.after%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%29%3B%0