port%20function%20restoreProgramStringSourceDescriptorEdge%28artifact%2Cidentity%2Cregister%29%20%7B%0A%20%20%28%7Bartifact%2Cregister%7D%3DrestoreOwnCodebaseRawDescriptorEdge%28artifact%2Cidentity%2Cregister%29%29%3B%0A%20%20if%28%21Object.hasOwn%28register%2Cproperty%29%29return%7Bartifact%2Cregister%7D%3B%0A%20%20const%20selected%3DreadProgramStringSourceDescriptorPolicy%28%29%3Bassert.deepEqual%28register%5Bproperty%5D%2C%5Bselected.edge%5D%29%3B%0A%20%20const%20bytes%3DBuffer.from%28serializeProjectData%28register%2Cselected.register.file%29%29%3Bassert.deepEqual%28pin%28bytes%29%2Cselected.register.current%29%3B%0A%20%20const%20previousRegister%3D%7B...register%7D%3Bdelete%20previousRegister%5Bproperty%5D%3B%0A%20%20const%20originalRegister%3DBuffer.from%28serializeProjectData%28previousRegister%2Cselected.register.file%29%29%3B%0A%20%20assert.deepEqual%28pin%28originalRegister%29%2C%7Bbytes%3Aselected.register.bytes%2Csha256%3Aselected.register.sha256%7D%29%3B%0A%20%20assert.equal%28originalRegister.toString%28%27utf8%27%29%2Cselected.register.sourceText%29%3B%0A%20%20verifyGitArtifactCertificate%28selected.register.certificate%2CoriginalRegister%2C%7Brevision%2Cpath%3Aselected.register.file%7D%29%3B%0A%20%20if%28identity%21%3D%3D%27raw%20consuming%27%7C%7Cartifact%3D%3D%3Dnull%29return%7Bartifact%2Cregister%3AstructuredClone%28previousRegister%29%7D%3B%0A%20%20const%20current%3DBuffer.from%28serializeProjectData%28artifact%2Cselected.artifact.file%29%29%3B%0A%20%20if%28pin%28current%29.sha256%21%3D%3Dselected.edge.current.sha256%29return%7Bartifact%2Cregister%3AstructuredClone%28previousRegister%29%7D%3B%0A%20%20assert.deepEqual%28pin%28current%29%2Cselected.edge.current%29%3B%0A%20%20const%20owner%3Dselected.sourceOwner%3B%0A%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28owner.file%2Croot%29%29%29%2Cowner.current%2C%27the%20actual%20checked-program%20projection%20source%20remains%20exact%27%29%3B%0A%20%20verifyGitArtifactCertificate%28owner.certificate%2CBuffer.from%28owner.sourceText%29%2C%7Brevision%2Cpath%3Aowner.file%7D%29%3B%0A%20%20const%20restored%3DstructuredClone%28artifact%29%3Bassert.equal%28selected.edge.changes.length%2C2%29%3B%0A%20%20const%20fields%3Dnew%20Set%28%29%3B%0A%20%20for%28const%20change%20of%20selected.edge.changes%29%7B%0A%20%20%20%20assert.deepEqual%28change.path.slice%280%2C-1%29%2C%5B%27decisionSources%27%2C%2711%27%5D%29%3B%0A%20%20%20%20const%20field%3Dchange.path.at%28-1%29%3Bassert.ok%28%5B%27bytes%27%2C%27sha256%27%5D.includes%28field%29%26%26%21fields.has%28field%29%29%3Bfields.add%28field%29%3B%0A%20%20%20%20const%20descriptor%3Drestored.decisionSources%5B11%5D%3Bassert.equal%28descriptor.file%2Cowner.file%29%3B%0A%20%20%20%20assert.equal%28descriptor%5Bfield%5D%2Cchange.after%29%3Bdescriptor%5Bfield%5D%3Dchange.before%3B%0A%20%20%7D%0A%20%20const%20original%3DBuffer.from%28serializeProjectData%28restored%2Cselected.artifact.file%29%29%3B%0A%20%20assert.deepEqual%28pin%28original%29%2C%7Bbytes%3Aselected.artifact.bytes%2Csha256%3Aselected.artifact.sha256%7D%29%3Bassert.equal%28original.toString%28%27utf8%27%29%2Cselected.artifact.sourceText%29%3B%0A%20%20verifyGitArtifactCertificate%28selected.artifact.certificate%2Coriginal%2C%7Brevision%2Cpath%3Aselected.artifact.file%7D%29%3B%0A%20%20return%7Bartifact%3Arestored%2Cregister%3AstructuredClone%28previousRegister%29%7D%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
