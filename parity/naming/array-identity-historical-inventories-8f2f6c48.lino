p%28row%3D%3Erow.file%29%2CinspectedTruthyPreimages.map%28row%3D%3Erow.file%29%29%3B%0A%20for%28const%20%5Bindex%2Crow%5Dof%20packet.sources.entries%28%29%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27certificate%27%2C%27current%27%2C%27file%27%2C%27previous%27%5D%29%3B%0A%20%20assert.deepEqual%28Object.keys%28row.previous%29.sort%28%29%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20assert.deepEqual%28Object.keys%28row.current%29.sort%28%29%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20const%20expected%3DinspectedTruthyPreimages%5Bindex%5D%3B%0A%20%20assert.deepEqual%28pinTruthyProjectionSource%28row.previous.source%29%2C%7Bbytes%3Aexpected.bytes%2Csha256%3Aexpected.sha256%7D%29%3B%0A%20%20assert.deepEqual%28pinTruthyProjectionSource%28row.previous.source%29%2C%7Bbytes%3Arow.previous.bytes%2Csha256%3Arow.previous.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.previous.source%29%2C%7Brevision%3ATRUTHY_PROJECTION_REVISION%2Cpath%3Arow.file%7D%29%3B%0A%20%20const%20derived%3Dindex%3C2%3FderiveTruthyProjectionSchema%28row.previous.source%29%3AderiveTruthyProjectionHostSource%28row.file%2Crow.previous.source%29%3B%0A%20%20assert.equal%28row.current.source%2Cderived%29%3Bassert.deepEqual%28pinTruthyProjectionSource%28derived%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%7D%0A%20assert.equal%28packet.sources%5B0%5D.previous.source%2Cpacket.sources%5B1%5D.previous.source%29%3B%0A%20assert.equal%28packet.sources%5B0%5D.current.source%2Cpacket.sources%5B1%5D.current.source%29%3B%0A%20return%20structuredClone%28packet%29%3B%0A%7D%0A%0Aexport%20function%20readTruthyProjectionSchemaPacket%28%29%20%7B%0A%20const%20bytes%3DreadFileSync%28new%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%29%3B%0A%20assert.equal%28pinTruthyProjectionSource%28bytes%29.sha256%2CrecipeSha256%2C%27complete%20normal-author%20packet%20is%20pinned%27%29%3B%0A%20return%20verifyTruthyProjectionSchemaPacket%28readProjectData%28new%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%29%29%3B%0A%7D%0A%0A%2F%2F%20This%20view%20belongs%20only%20to%20the%20old%20Boolean-projection%20source%20author.%20Both%0A%2F%2F%20complete%20source%20epochs%20have%20independent%20Git%20membership%3B%20runtime%20callers%20keep%0A%2F%2F%20the%20actual%20checker.%20The%20original%20projection%20packet%20remains%20byte-for-byte.%0Aexport%20function%20verifyTruthyProjectionHostSuccessors%28packet%29%20%7B%0A%20assert.deepEqual%28Object.keys%28packet%29.sort%28%29%2C%5B%27boundary%27%2C%27model%27%2C%27previousRevision%27%2C%27revision%27%2C%27schemaVersion%27%2C%27sources%27%5D%29%3B%0A%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27Boolean%20projection%20checker%20source%20succession%201%27%29%3B%0A%20assert.equal%28packet.previousRevision%2C%276ffff3b2dc530a5f24c128dadf877f3fa106932b%27%29%3B%0A%20assert.equal%28packet.revision%2C%273fe3a9f9decfa6431b5b0718729a5d123b5f236b%27%29%3B%0A%20assert.equal%28packet.boundary%2C%27Only%20complete%20certified%20checker%20sources%20receive%20the%20original%20Boolean%20projection%20source%20view.%20Runtime%20semantics%20and%20the%20immutable%20original%20projection%20packet%20remain%20unchanged%3B%20unknown%20source%20bytes%20refuse.%27%29%3B%0A%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2C%5B%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%27rust%2Fsrc%2Ftranslation%2Fsurface%2Fnodes.rs%27%2C%27rust%2Fsrc%2Ftranslation%2Fcheck%2Fexpressions.rs%27%5D%29%3B%0A%20const%20original%3DreadTruthyProjectionSchemaPacket%28%29%3B%0A%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27current%27%2C%27edit%27%2C%27file%27%2C%27previous%27%5D%29%3B%0A%20%20for%28const%20%5Bepoch%2Crevision%5Dof%5B%5B%27previous%27%2Cpacket.previousRevision%5D%2C%5B%27current%27%2Cpacket.revision%5D%5D%29%7B%0A%20%20%20const%20source%3Drow%5Bepoch%5D