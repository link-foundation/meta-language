3B%0A%20%20const%20current%3Dindex%3C2%3FderiveTruthyProjectionSchema%28previous%29%3AderiveTruthyProjectionHostSource%28expected.file%2Cprevious%29%3B%0A%20%20const%20physical%3DreadFileSync%28new%20URL%28expected.file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20const%20actual%3Dcheck%3FrestoreTruthyProjectionHostSource%28physical%2Cexpected.file%29%3Aphysical%3B%0A%20%20assert.ok%28actual%3D%3D%3Dprevious%7C%7Cactual%3D%3D%3Dcurrent%2C%27unknown%20actual%20source%20refuses%3A%20%27%2Bexpected.file%29%3B%0A%20%20if%28check%29assert.equal%28actual%2Ccurrent%2C%27actual%20current%20source%20must%20be%20the%20complete%20normal%20successor%27%29%3B%0A%20%20return%7Bfile%3Aexpected.file%2Ccertificate%3Aoriginal.certificate%2C%0A%20%20%20previous%3A%7Bsource%3Aprevious%2C...pinTruthyProjectionSource%28previous%29%7D%2Ccurrent%3A%7Bsource%3Acurrent%2C...pinTruthyProjectionSource%28current%29%7D%7D%3B%0A%20%7D%29%3B%0A%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%3ATRUTHY_PROJECTION_REVISION%2Cextensions%3ATRUTHY_PROJECTION_ENTRIES%2Csources%2C%0A%20%20boundary%3A%27Two%20additive%20shared%20schema%20entries%20reconstruct%20the%20existing%20checked%20Boolean%20conversion%20exactly.%20Existing%20shared%20source-language%2Ftype%20Boolean%20policy%20owns%20semantics%3B%20complete%20original%20schema%20and%20host%20bytes%20retain%20independent%20committed%20membership%20and%20exact%20inverses.%20No%20source%20rewrites%2C%20old%20abort%20changes%2C%20weakened%20IR%20comparison%20or%20native%20execution%20evidence.%27%7D%3B%0A%20verifyTruthyProjectionSchemaPacket%28packet%29%3B%0A%20const%20output%3Dnew%20URL%28TRUTHY_PROJECTION_OUTPUT%2Croot%29%2ChelperFile%3Dnew%20URL%28helper%2Croot%29%2Cbefore%3DreadFileSync%28helperFile%2C%27utf8%27%29%3B%0A%20const%20pattern%3D%2F%5Econst%20recipeSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%24%2Fmu%3Bassert.equal%28before.split%28pattern%29.length%2C2%29%3B%0A%20if%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20const%20after%3Dbefore.replace%28pattern%2C%22const%20recipeSha256%3D%27%22%2BpinTruthyProjectionSource%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20if%28check%29assert.equal%28before%2Cafter%29%3B%0A%20else%7Bfor%28const%20row%20of%20sources%29writeFileSync%28new%20URL%28row.file%2Croot%29%2Crow.current.source%29%3BwriteFileSync%28helperFile%2Cafter%29%3B%7D%0A%20return%20structuredClone%28packet%29%3B%0A%7D%0A%0Aexport%20function%20generateTruthyProjectionHostSuccessors%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20const%20output%3Dnew%20URL%28TRUTHY_PROJECTION_HOST_SUCCESSORS%2Croot%29%3B%0A%20if%28check%29%7Bconst%20packet%3DverifyTruthyProjectionHostSuccessors%28readProjectData%28output%29%29%3Bfor%28const%20row%20of%20packet.sources%29assert.equal%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.current.source%29%3BcheckProjectData%28output%2Cpacket%29%3Breturn%20packet%3B%7D%0A%20const%20previousRevision%3D%276ffff3b2dc530a5f24c128dadf877f3fa106932b%27%2Crevision%3D%273fe3a9f9decfa6431b5b0718729a5d123b5f236b%27%3B%0A%20const%20sources%3D%5B%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%27rust%2Fsrc%2Ftranslation%2Fsurface%2Fnodes.rs%27%2C%27rust%2Fsrc%2Ftranslation%2Fcheck%2Fexpressions.rs%27%5D.map%28file%3D%3E%7B%0A%20%20const%20capture%3Dcommit%3D%3E%7Bconst%20%7Bblob%2Ccertificate%7D%3DcaptureGitArtifactCertificate%28commit%2Cfile%29%3Bconst%20source%3Dblob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28source%29%2Cblob%29%3Breturn%20%7Bsource%2C...pinTruthyProjectionSource%28source%29%2Ccertificate%7D%3B%7D%3B%0A%20%20const%20previous%3Dcapture%28previousRevision%29%2Ccurrent%3Dcapture%28revision%29%3Bassert.equal%28readFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%2Ccurrent.source%29%3B%0A%20%20let%20start%3D0%2Cend%3D0%3Bwhile%28previous.source%5Bstart%5D%3D%3D%3Dcurrent.source%5Bstart%5D%26%26start%3CMath.min%28previous.source.length%2Ccurrent.source.length%29%29start%2B%2B%3B%0A%20%20while%28end%3CMath.min%28previous.source.length%2Ccurrent.source.length%29-start%26%26previous.source.at%28-end-1%29%3D%3D%3Dcurrent.source.at%28-end-1%29%29end%2B%2B%3B%0A%20%20return%20%7Bfile%2Cprevious%2Ccurrent%2Cedit%3A%7Bstart%2Cremoved%3Aprevious.source.slice%28start%2Cprevious.source.length-end%29%2Cinserted%3Acurrent.source.slice%28start%2Ccurrent.source.length-end%29%7D%7D%3B%0A%20%7D%29%3B%0A%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27Boolean%20projection%20checker%20source%20succession%201%27%2CpreviousRevision%2Crevision%2Csources%2C%0A%20%20boundary%3A%27Only%20complete%20certified%20checker%20sources%20receive%20the%20original%20Boolean%20projection%20source%20view.%20Runtime%20semantics%20and%20the%20immutable%20original%20projection%20packet%20remain%20unchanged%3B%20unknown%20source%20bytes%20refuse.%27%7D%3B%0A%20verifyTruthyProjectionHostSuccessors%28packet%29%3BwriteProjectData%28output%2Cpacket%29%3Breturn%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28args.length%3C%3D2%26%26new%20Set%28args%29.size%3D%3D%3Dargs.length%26%26args.every%28arg%3D%3E%5B%27--check%27%2C%27--host-successors%27%5D.includes%28arg%29%29%29%3B%0A%20%28args.includes%28%27--host-successors%27%29%3FgenerateTruthyProjectionHostSuccessors%3AgenerateTruthyProjectionSchema%29%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20console.log%28%27Checked%20Boolean%20conversion%20projection%3A%20complete%20predecessor%2Fcurrent%20sources%20and%20two-entry%20inverse%20authenticated%3B%20execution%20remains%20separate.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
