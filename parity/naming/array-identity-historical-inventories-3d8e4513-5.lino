%20tag%0A%2F%2F%2F%20and%20the%20data%20type%20that%20has%20it.%0A%23%5Bderive%28Clone%2C%20Debug%2C%20PartialEq%2C%20Eq%2C%20Serialize%2C%20Deserialize%29%5D%0Apub%20struct%20STagTest%20%7B%0A%20%20%20%20pub%20object%3A%20SExpr%2C%0A%20%20%20%20pub%20tag%3A%20String%2C%0A%20%20%20%20pub%20data%3A%20SData%2C%0A%20%20%20%20pub%20negated%3A%20bool%2C%0A%7D%0A%0Aimpl%20SExpr%20%7B%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20const%20fn%20new%28node%3A%20SNode%2C%20span%3A%20Option%3CSpan%3E%29%20-%3E%20Self%20%7B%0A%20%20%20%20%20%20%20%20Self%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20node%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20span%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20parenthesized%3A%20None%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20block%3A%20false%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20tag_test%3A%20None%2C%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20A%20name%20reference%20without%20a%20span%2C%20as%20the%20checker%20builds%20them.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20fn%20name%28name%3A%20%26str%29%20-%3E%20Self%20%7B%0A%20%20%20%20%20%20%20%20Self%3A%3Anew%28%0A%20%20%20%20%20%20%20%20%20%20%20%20SNode%3A%3AName%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20path%3A%20vec%21%5Bname.to_owned%28%29%5D%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20%7D%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20None%2C%0A%20%20%20%20%20%20%20%20%29%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20The%20single-segment%20name%20this%20expression%20refers%20to%2C%20if%20it%20is%20one.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20fn%20simple_name%28%26self%29%20-%3E%20Option%3C%26str%3E%20%7B%0A%20%20%20%20%20%20%20%20match%20%26self.node%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20SNode%3A%3AName%20%7B%20path%20%7D%20if%20path.len%28%29%20%3D%3D%201%20%3D%3E%20Some%28%26path%5B0%5D%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20_%20%3D%3E%20None%2C%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%7D%0A%0A%23%5Bderive%2