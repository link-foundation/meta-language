7D%20languages%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20starts%20%40param%20%7Bnumber%5B%5D%7D%20ends%0A%20%2A%20%40param%20%7Bnumber%7D%20parent%20%40param%20%7Bnumber%7D%20language%0A%20%2A%20%40param%20%7Bnumber%7D%20start%20%40param%20%7Bnumber%7D%20end%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readEmbeddedRegionAncestor%28parents%2C%20languages%2C%20starts%2C%20ends%2C%20parent%2C%20language%2C%20start%2C%20end%29%20%7B%0A%20%20if%20%28parents.length%20%21%3D%3D%20languages.length%20%7C%7C%20starts.length%20%21%3D%3D%20parents.length%20%7C%7C%20ends.length%20%21%3D%3D%20parents.length%29%20return%20-2%3B%0A%20%20if%20%28%21acceptEmbeddedRegionLimit%28language%29%20%7C%7C%20%21acceptEmbeddedRegionBounds%280%2C%209007199254740991%2C%20start%2C%20end%29%29%20return%20-2%3B%0A%20%20let%20position%20%3D%20parent%3B%0A%20%20while%20%28position%20%3E%3D%200%29%20%7B%0A%20%20%20%20if%20%28%21acceptEmbeddedRegionLimit%28position%29%20%7C%7C%20position%20%3E%3D%20parents.length%29%20return%20-2%3B%0A%20%20%20%20const%20previous%20%3D%20parents%5Bposition%5D%20%3F%3F%20NaN%3B%0A%20%20%20%20const%20selectedLanguage%20%3D%20languages%5Bposition%5D%20%3F%3F%20NaN%3B%0A%20%20%20%20const%20selectedStart%20%3D%20starts%5Bposition%5D%20%3F%3F%20NaN%3B%0A%20%20%20%20const%20selectedEnd%20%3D%20ends%5Bposition%5D%20%3F%3F%20NaN%3B%0A%20%20%20%20if%20%28previous%20%21%3D%3D%20-1%20%26%26%20%28%21acceptEmbeddedRegionLimit%28previous%29%20%7C%7C%20previous%20%3E%3D%20position%29%29%20return%20-2%3B%0A%20%20%20%20if%20%28%21acceptEmbeddedRegionLimit%28selectedLanguage%29%20%7C%7C%20%21acceptEmbeddedRegionBounds%280%2C%209007199254740991%2C%20selectedStart%2C%20selectedEnd%29%29%20return%20-2%3B%0A%20%20%20%20if%20%28selectedLanguage%20%3D%3D%3D%20language%20%26%26%20selectedStart%20%3D%3D%3D%20start%20%26%26%20selectedEnd%20%3D%3D%3D%20end%29%20return%20position%3B%0A%20%20%20%20position%20%3D%20previous%3B%0A%20%20%7D%0A%20%20return%20position%20%3D%3D%3D%20-1%20%3F%20-1%20%3A%20-2%3B%0A%7D%0A%0A%2F%2A%2A%20The%20host%20supplies%20physical%2C%20absolute%20byte%20bounds%20and%20current%20counters.%0A%20%2A%20Reusing%20the%20current%20whole%20host%20preserves%20the%20pre-existing%20self-region%0A%20%2A%20behavior%3B%20returning%20to%20an%20earlier%20identical%20host%20is%20a%20non-consuming%20cycle.%0A%20%2A%20%40param%20%7Bnumber%7D%20parentStart%20%40param%20%7Bnumber%7D%20parentEnd%0A%20%2A%20%40param%20%7Bnumber%7D%20parentLanguage%20%40param%20%7Bnumber%7D%20language%0A%20%2A%20%40param%20%7Bnumber%7D%20start%20%40param%20%7Bnumber%7D%20end%20%40param%20%7Bnumber%7D%20ancestor%0A%20%2A%20%40param%20%7Bnumber%7D%20depth%20%40param%20%7Bnumber%7D%20count%20%40param%20%7Bnumber%7D%20bytes%0A%20%2A%20%40param%20%7Bnumber%7D%20depthLimit%20%40param%20%7Bnumber%7D%20countLimit%20%40param%20%7Bnumber%7D%20byteLimit%0A%20%2A%20%40param%20%7Bboolean%7D%20rootSpellingReuse%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readEmbeddedRegionDisposition%28parentStart%2C%20parentEnd%2C%20parentLanguage%2C%20language%2C%0A%20%20start%2C%20end%2C%20ancestor%2C%20depth%2C%20count%2C%20bytes%2C%20depthLimit%2C%20countLimit%2C%20byteLimit%2C%20rootSpellingReuse%29%20%7B%0A%20%20if%20%28%21acceptEmbeddedRegionBounds%28parentStart%2C%20parentEnd%2C%20start%2C%20end%29%29%20return%20%27invalidEmbeddedRegionBounds%27%3B%0A%20%20if%20%28ancestor%20%3D%3D%3D%20-2%29%20return%20%27invalidEmbeddedRegionAncestry%27%3B%0A%20%20const%20sameHost%20%3D%20parentLanguage%20%3D%3D%3D%20language%20%26%26%20start%20%3D%3D%3D%20parentStart%20%26%26%20end%20%3D%3D%3D%20parentEnd%3B%0A%20%20if%20%28sameHost%20%26%26%20depth%20%21%3D%3D%201%29%20return%20%27reuseAttached%27%3B%0A%20%20if%20%28sameHost%20%26%26%20rootSpellingReuse%29%20return%20%27reuse%27%3B%0A%20%20%2F%2F%20The%20original%20root%20adapter%20parsed%20a%20canonical%20whole-buffer%20region%20once%0A%20%20%2F%2F%20when%20the%20requested%20alias%20had%20another%20spelling.%20Preserve%20that%20exact%20view.%0A%20%20const%20legacyRootAlias%20%3D%20sameHost%20%26%26%20depth%20%3D%3D%3D%201%20%26%26%20%21rootSpellingReuse%3B%0A%20%20if%20%28ancestor%20%3E%3D%200%20%26%26%20%21legacyRootAlias%29%20return%20%27nonConsumingEmbeddingCycle%27%3B%0A%20%20if%20%28%21acceptEmbeddedRegionLimit%28depth%29%20%7C%7C%20%21acceptEmbeddedRegionLimit%28count%29%20%7C%7C%20%21acceptEmbeddedRegionLimit%28bytes%29%0A%20%20%20%20%7C%7C%20%21acceptEmbeddedRegionLimit%28depthLimit%29%20%7C%7C%20%21acceptEmbeddedRegionLimit%28countLimit%29%20%7C%7C%20%21acceptEmbeddedRegionLimit%28byteLimit%29%29%20return%20%27invalidEmbeddedRegionLimits%27%3B%0A%20%20if%20%28depth%20%3E%20depthLimit%29%20return%20%27embeddedRegionDepthLimit%27%3B%0A%20%20if%20%28count%20%3E%3D%20countLimit%29%20return%20%27embeddedRegionCountLimit%27%3B%0A%20%20if%20%28bytes%20%3E%20byteLimit%20%7C%7C%20end%20-%20start%20%3E%20byteLimit%20-%20bytes%29%20return%20%27embeddedRegionByteLimit%27%3B%0A%20%20return%20%27parse%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20current%20%40param%20%7Bnumber%7D%20start%20%40param%20%7Bnumber%7D%20end%0A%20%2A%20%40param%20%7Bboolean%7D%20byteCharge%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readEmbeddedRegionCharge%28current%2C%20start%2C%20end%2C%20byteCharge%29%20%7B%0A%20%20return%20current%20%2B%20%28byteCharge%20%3F%20end%20-%20start%20%3A%201%29%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20reason%20%40param%20%7Bnumber%7D%20depth%20%40param%20%7Bnumber%7D%20count%0A%20%2A%20%40param%20%7Bnumber%7D%20bytes%20%40param%20%7Bnumber%7D%20start%20%40param%20%7Bnumber%7D%20end%0A%20%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readEmbeddedRegionDiagnosticObserved%28reason%2C%20depth%2C%20count%2C%20bytes%2C%20start%2C%20end%29%20%7B%0A%20%20if%20%28reason%20%3D%3D%3D%20%27embeddedRegionDepthLimit%27%29%20return%20depth%3B%0A%20%20if%20%28reason%20%3D%3D%3D%20%27embeddedRegionCountLimit%27%29%20%7B%0A%20%20%20%20const