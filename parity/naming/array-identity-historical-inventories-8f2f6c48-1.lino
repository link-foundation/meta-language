0%27var%27%29%20return%20%5B%5D%3B%0A%20%20return%20%5B0%2C%20kind%20%3D%3D%3D%20%27option%27%20%3F%20optionalFactField%28starts%2C%20counts%2C%20labels%2C%20targets%2C%20resolved%2C%20%27element%27%29%20%3A%20left%2C%20right%5D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20The%20first%20identity%20is%20the%20field%27s%20receiver%20element.%20-1%20requests%20one%20fresh%0A%20%2A%20element%20and%20the%20second%20identity%20receives%20Option%2Fboth%20of%20that%20fresh%20element.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20texts%20%40param%20%7Bnumber%5B%5D%7D%20starts%20%40param%20%7Bnumber%5B%5D%7D%20counts%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20labels%20%40param%20%7Bnumber%5B%5D%7D%20targets%20%40param%20%7Bnumber%7D%20object%0A%20%2A%20%40param%20%7Bnumber%7D%20resolved%20%40returns%20%7Bnumber%5B%5D%7D%0A%20%2A%2F%0Aexport%20function%20planOptionalFieldInference%28texts%2C%20starts%2C%20counts%2C%20labels%2C%20targets%2C%20object%2C%20resolved%29%20%7B%0A%20%20const%20kind%20%3D%20optionalFactTag%28texts%2C%20starts%2C%20counts%2C%20labels%2C%20targets%2C%20resolved%2C%20%27kind%27%29%3B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27var%27%29%20return%20%5B-1%2C%20object%5D%3B%0A%20%20return%20%5Bkind%20%3D%3D%3D%20%27option%27%20%3F%20optionalFactField%28starts%2C%20counts%2C%20labels%2C%20targets%2C%20resolved%2C%20%27element%27%29%20%3A%20object%5D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Opcode%200%20recursively%20unifies%20%5Bleft%2Cright%5D%20and%20then%20resolves%20the%20selected%0A%20%2A%20value.%20Opcode%201%20reuses%20the%20current%20optional%20value%3B%20opcode%202%20constructs%20one%0A%20%2A%20Option%2Fundefined%20of%20the%20selected%20original%20branch.%20Reuse%20preserves%20identity%0A%20%2A%20at%20a%20fixed%20point%2C%20rather%20than%20manufacturing%20a%20fresh%20equivalent%20record.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20texts%20%40param%20%7Bnumber%5B%5D%7D%20starts%20%40param%20%7Bnumber%5B%5D%7D%20counts%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20labels%20%40par