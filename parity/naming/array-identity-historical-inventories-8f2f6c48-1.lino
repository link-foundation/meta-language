(50322: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Imperative%20JavaScript%20function%20bodies%20to%20one%20expression.%20%60let%60%20variables%2C%0A%2F%2F%20assignments%2C%20loops%2C%20%60break%60%20and%20%60continue%60%20have%20a%20faithful%20functional%0A%2F%2F%20reading%3A%20an%20assignment%20%60x%20%3D%20e%60%20binds%20a%20new%20%60x%60%20for%20the%20statements%20after%0A%2F%2F%20it%3B%20a%20statement%20after%20which%20control%20continues%20at%20several%20places%20%28an%20%60if%60%0A%2F%2F%20that%20assigns%20in%20both%20branches%2C%20a%20loop%20that%20breaks%20at%20two%20points%29%20is%20joined%0A%2F%2F%20by%20a%20data%20type%20whose%20alternatives%20carry%20the%20variables%20it%20assigns%2C%20so%20the%0A%2F%2F%20statements%20after%20it%20are%20translated%20once%3B%20and%20a%20loop%20is%20a%20tail-recursive%0A%2F%2F%20function%20of%20the%20variables%20it%20uses%2C%20lifted%20to%20the%20top%20level%2C%20whose%20result%0A%2F%2F%20carries%20the%20variables%20it%20assigns%20back%20to%20the%20statements%20after%20it%2C%20or%20the%0A%2F%2F%20value%20the%20loop%20returns%20from%20the%20function.%20Only%20the%20variables%20a%20later%0A%2F%2F%20statement%20may%20read%20are%20carried.%20The%20variables%20of%20a%20block%20that%20shadow%20a%0A%2F%2F%20variable%20in%20scope%20are%20renamed%2C%20so%20no%20later%20statement%20sees%20them.%0A%0Aimport%20%7B%20TranslationError%2C%20unsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20mutableClosureCells%20%7D%20from%20%27.%2Fjavascript-cells.js%27%3B%0Aimport%20%7B%20readCallableCellLowering%2C%20renderCallableCellParameterName%20%7D%20from%20%27.%2Fcallable-source-rules.js%27%3B%0Aimport%20%7B%20renameCallableSourceExpression%20%7D%20from%20%27.%2Fcallable-source.js%27%3B%0Aimport%20%7B%20requireJavaScriptBranchContinuation%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0Aimport%20%7B%20acceptJavaScriptValueSwitch%2C%20readJavaScriptValueSwitchInstruction%2C%0A%20%20readJavaScriptValueSwitchPosition%20%7D%20from%20%27.%2Fjavascript-surface-rules.js%27%3B%0A%0Aconst%20ROOT%20%3D%20%27crate%27%3B%0Aconst%20IMPERATIVE%20%3D%20new%20Set%28%5B%27let%27%2C%20%27assign%27%2C%20%27assignReference%27%2C%20%27while%27%2C%20%27doWhile%27%2C%20%27for%27%2C%20%27break%27%2C%20%27continue%27%2C%20%27print%27%2C%20%27expr%27%5D%29%3B%0A%0A%2F%2A%2A%20Whether%20statements%20use%20%60let%60%2C%20assignments%2C%20loops%2C%20%60break%60%2C%20%60continue%60%2C%20print%20or%20discard%20a%20value.%20%2A%2F%0Aexport%20function%20imperative%28statements%2C%20parser%29%20%7B%0A%20%20if%20%28mutableClosureCells%28statements%29.size%29%20return%20true%3B%0A%20%20return%20statements.some%28function%20visit%28statement%29%20%7B%0A%20%20%20%20if%20%28IMPERATIVE.has%28statement.s%29%29%20return%20true%3B%0A%20%20%20%20if%20%28statement.s%20%3D%3D%3D%20%27block%27%29%20return%20%21statement.inline%20%26%26%20%21parser.terminates%28statement.body%29%20%7C%7C%20statement.body.some%28visit%29%3B%0A%20%20%20%20if%20%28statement.s%20%3D%3D%3D%20%27if%27%29%20return%20requireJavaScriptBranchContinuation%28parser.terminates%28statement.then%29%2C%0A%20%20%20%20%20%20Boolean%28statement.else%29%2C%20Boolean%28statement.else%20%26%26%20parser.terminates%28statement.else%29%29%29%0A%20%20%20%20%20%20%7C%7C%20statement.then.some%28visit%29%20%7C%7C%20Boolean%28statement.else%3F.some%28visit%29%29%3B%0A%20%20%20%20if%20%28statement.s%20%3D%3D%3D%20%27switch%27%29%20return%20statement.clauses.some%28%28clause%29%20%3D%3E%20clause.body.some%28visit%29%29%3B%0A%20%20%20%20return%20false%3B%0A%20%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20The%20names%20statements%20read%20or%20assign%20%28%60free%60%29%20and%20assign%20%28%60assigned%60%29%0A%20%2A%20without%20declaring%20them%20first%2C%20so%20the%20ones%20they%20share%20with%20their%20context.%0A%20%2A%2F%0Aexport%20function%20statementUses%28statements%2C%20declared%20%3D%20new%20Set%28%29%29%20%7B%0A%20%20const%20uses%20%3D%20%7B%20free%3A