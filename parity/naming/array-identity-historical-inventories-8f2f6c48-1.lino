%7D%29%3B%0Aconst%20predecessorPacket%3D%7B%22bytes%22%3A593225%2C%22sha256%22%3A%22e1948cf3bfcd36baac5ab585d838fd4b8f40cd9dc89160a0794d369197648db4%22%7D%3B%0Aexport%20const%20SCOPED_ITERATION_NATIVE_OUTPUT%3D%27parity%2Fself-translation%2Fscoped-iteration-native-host-source-history.lino%27%3B%0Aconst%20packetSha256%3D%2780f6f0086f0eb34a47b87ec474febbf2aaf03f04f8faa14993f6c0b126f7e841%27%3B%0Aconst%20anchor%3D%27%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20super%3A%3Aowned_array_append%3A%3Alower_owned_array_appends%28%5Cn%27%0A%20%20%2B%27%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%26mut%20statements%2C%5Cn%27%0A%20%20%2B%27%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%26params%2C%5Cn%27%0A%20%20%2B%27%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%26self.owned_array_readers%2C%5Cn%27%3B%0Aconst%20addition%3D%27%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%26self.owned_array_iteration_sources%2C%5Cn%27%3B%0Alet%20cached%3B%0Aexport%20const%20pinScopedIterationNativeSource%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20exactKeys%3D%28value%2Ckeys%29%3D%3Eassert.deepEqual%28Object.keys%28value%29.sort%28%29%2C%5B...keys%5D.sort%28%29%29%3B%0A%0Aexport%20function%20deriveScopedIterationNativeHostSource%28previous%2Ccurrent%29%7B%0A%20%20const%20specification%3DSCOPED_ITERATION_NATIVE_SOURCE%3B%0A%20%20assert.deepEqual%28pinScopedIterationNativeSource%28previous%29%2Cspecification.previous%29%3B%0A%20%20assert.deepEqual%28pinScopedIterationNativeSource%28current%29%2Cspecification.current%29%3B%0A%20%20assert.equal%28Buffer.from%28previous%29.toString%28%27utf8%27%29%2Cprevious%29%3Bassert.equal%28Buffer.from%28current%29.toString%28%27utf8%27%29%2Ccurrent%29%3B%0A%20%20assert.equal%28previous.split%28anchor%29.length%2C2%29%3Bassert.equal%28previous.includes%28addition%29%2Cfalse%29%3B%0A%20%20const%20start%3Dprevious.indexOf%28anchor%29%2Banchor.length%3B%0A%20%20assert.equal%28current%2Cprevious.slice%280%2Cstart%29%2Baddition%2Bprevious.slice%28start%29%2C%27only%20the%20actual%20parser-owned%20iteration%20observation%20is%20added%27%29%3B%0A%20%20assert.equal%28current.slice%28start%2Cstart%2Baddition.length%29%2Caddition%29%3B%0A%20%20assert.equal%28current.slice%280%2Cstart%29%2Bcurrent.slice%28start%2Baddition.length%29%2Cprevious%2C%27every%20complete%20predecessor%20byte%20survives%27%29%3B%0A%20%20return%5B%7Bstart%2Cremoved%3A%27%27%2Cinserted%3Aaddition%7D%5D%3B%0A%7D%0A%0Aexport%20function%20verifyScopedIterationNativeHostSourceHistory%28packet%29%7B%0A%20%20exactKeys%28packet%2C%5B%27schemaVersion%27%2C%27model%27%2C%27file%27%2C%27previousRevision%27%2C%27revision%27%2C%27coordinateUnit%27%2C%27previous%27%2C%27current%27%2C%27edits%27%2C%27boundary%27%2C%27predecessor%27%2C%27additionalSources%27%5D%29%3B%0A%20%20const%20specification%3DSCOPED_ITERATION_NATIVE_SOURCE%3B%0A%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27scoped%20iteration%20native%20historical%20source%201%27%29%3B%0A%20%20for%28const%20key%20of%20%5B%27file%27%2C%27previousRevision%27%2C%27revision%27%5D%29assert.equal%28packet%5Bkey%5D%2Cspecification%5Bkey%5D%29%3B%0A%20%20assert.equal%28packet.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20for%28const%20key%20of%20%5B%27previous%27%2C%27current%27%5D%29%7B%0A%20%20%20%20const%20row%3Dpacket%5Bkey%5D%3BexactKeys%28row%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20assert.equal%28typeof%20row.source%2C%27string%27%29%3Bassert.deepEqual%28pinScopedIterationNativeSource%28row.source%29%2Cspecification%5Bkey%5D%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%2Cspecification%5Bkey%5D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%3Akey%3D%3D%3D%27previous%27%3Fspecification.previousRevision%3Aspecification.revision%2Cpath%3Aspecification.file%7D%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28packet.edits%2CderiveScopedIterationNativeHostSource%28packet.previous.source%2Cpacket.current.source%29%29%3B%0A%20%20assert.equal%28typeof%20packet.boundary%2C%27string%27%29%3Bassert.ok%28packet.boundary.length%3E0%29%3B%0A%20%20exactKeys%28packet.predecessor%2C%5B%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20assert.equal%28packet.predecessor.revision%2CSCOPED_ITERATION_NATIVE_PREDECESSOR_REVISION%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Apacket.predecessor.bytes%2Csha256%3Apacket.predecessor.sha256%7D%2CpredecessorPacket%29%3B%0A%20%20const%20%7Bpredecessor%2CadditionalSources%2C...previous%7D%3Dpacket%3B%0A%20%20const%20original%3DBuffer.from%28serializeProjectData%28previous%2CSCOPED_ITERATION_NATIVE_OUTPUT%29%29%3B%0A%20%20assert.deepEqual%28pinScopedIterationNativeSource%28original%29%2CpredecessorPacket%2C%27the%20entire%20first%20declaration%20source%20packet%20survives%20exactly%27%29%3B%0A%20%20verifyGitArtifactCertificate%28predecessor.certificate%2Coriginal%2C%7Brevision%3ASCOPED_ITERATION_NATIVE_PREDECESSOR_REVISION%2Cpath%3ASCOPED_ITERATION_NATIVE_OUTPUT%7D%29%3B%0A%20%20assert.ok%28Array.isArray%28additionalSources%29%29%3Bassert.equal%28additionalSources.length%2C1%29%3B%0A%20%20verifyScopedIterationNativeLoopSource%28additionalSources%5B0%5D%29%3B%0A%20%20return%20packet%3B%0A%7D%0A%0Aexport%20function%20readScopedIterationNativeHostSourceHistory%28%29%7B%0A%20%20if%28%21cached%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28SCOPED_ITERATION_NATIVE_OUTPUT%2Croot%29%29%3B%0A%20%20%20%20assert.equal%28pinScopedIterationNativeSource%28bytes%29.sha256%2CpacketSha256%2C%27the%20whole%20source-only%20packet%20remains%20exact%27%29%3B%0A%20%20%20%20cached%3DverifyScopedIterationNativeHostSourceHistory%28readBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%29%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28cached%29%3B%0A%7D%0A%0Aexport%20function%20restoreScopedIterationNativeHostSource%28source%2Cfile%2Creader%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bassert.equal%28typeof%20reader%2C%27string%27%29%3B%0A%20%20if%28file%3D%3D%3DSCOPED_ITERATION_NATIVE_LOOP_SOURCE.file%26%26reader%3D%3D%3D%27mutable%20array%20binding%20host%27%29%7B%0A%20%20%20%20const%20actual%3DpinScopedIterationNativeSource%28source%29%2Cexpected%3DSCOPED_ITERATION_NATIVE_LOOP_SOURCE.current%3B%0A%20%20%20%20if%28actual.bytes%21%3D%3Dexpected.bytes%7C%7Cactual.sha256%21%3D%3Dexpected.sha256%29return%20source%3B%0A%20%20%20%20const%20row%3DreadScopedIterationNativeHostSourceHistory%28%29.additionalSources%5B0%5D%3Bassert.equal%28source%2Crow.current.source%29%3B%0A%20%20%20%20return%20row.previous.source%3B%0A%20%20%7D%0A%20%20if%28file%21%3D%3DSCOPED_ITERATION_NATIVE_SOURCE.file%7C%7Creader%21%3D%3D%27required%20field%20native%20host%27%29return%20source%3B%0A%20%20const%20actual%3DpinScopedIterationNativeSource%28source%29%2Cexpected%3DSCOPED_ITERATION_NATIVE_SOURCE.current%3B%0A%20%20if%28actual.bytes%21%3D%3Dexpected.bytes%7C%7Cactual.sha256%21%3D%3Dexpected.sha256%29return%20source%3B%0A%20%20const%20packet%3DreadScopedIterationNativeHostSourceHistory%28%29%3Bassert.equal%28source%2Cpacket.current.source%29%3B%0A%20%20return%20packet.previous.source%3B%0A%7D%0A%0A%0Aconst%20loopAnchor%3D%27%20%20%20%20%20%20%20%20declarations.push%28Stmt%3A%3ABlock%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20body%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20inline%3A%20false%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20span%3A%20place%2C%5Cn%20%20%20%20%20%20%20%20%7D%29%3B%5Cn%27%3B%0Aconst%20loopAddition%3D%27%20%20%20%20%20%20%20%20self.owned_array_iteration_sources%5Cn%20%20%20%20%20%20%20%20%20%20%20%20.insert%28%28place%2C%20values.clone%28%29%2C%20index.clone%28%29%29%29%3B%5Cn%27%3B%0Aexport%20function%20deriveScopedIterationNativeLoopSource%28previous%2Ccurrent%29%7B%0A%20%20const%20specification%3DSCOPED_ITERATION_NATIVE_LOOP_SOURCE%3B%0A%20%20assert.deepEqual%28pinScopedIterationNativeSource%28previous%29%2Cspecification.previous%29%3Bassert.deepEqual%28pinScopedIterationNativeSource%28current%29%2Cspecification.current%29%3B%0A%20%20assert.equal%28previous.split%28loopAnchor%29.length%2C2%29%3Bassert.equal%28previous.includes%28loopAddition%29%2Cfalse%29%3B%0A%20%20const%20start%3Dprevious.indexOf%28loopAnchor%29%2BloopAnchor.length%3B%0A%20%20assert.equal%28current%2Cprevious.slice%280%2Cstart%29%2BloopAddition%2Bprevious.slice%28start%29%2C%27only%20the%20actual%20for-of%20source%20observation%20is%20added%27%29%3B%0A%20%20assert.equal%28current.slice%280%2Cstart%29%2Bcurrent.slice%28start%2BloopAddition.length%29%2Cprevious%29%3B%0A%20%20return%5B%7Bstart%2Cremoved%3A%27%27%2Cinserted%3AloopAddition%7D%5D%3B%0A%7D%0Aexport%20function%20verifyScopedIterationNativeLoopSource%28row%29%7B%0A%20%20exactKeys%28row%2C%5B%27file%27%2C%27previousRevision%27%2C%27revision%27%2C%27coordinateUnit%27%2C%27previous%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20const%20specification%3DSCOPED_ITERATION_NATIVE_LOOP_SOURCE%3B%0A%20%20for%28const%20key%20of%5B%27file%27%2C%27previousRevision%27%2C%27revision%27%5D%29assert.equal%28row%5Bkey%5D%2Cspecification%5Bkey%5D%29%3B%0A%20%20assert.equal%28row.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20for%28const%20key%20of%5B%27previous%27%2C%27current%27%5D%29%7B%0A%20%20%20%20exactKeys%28row%5Bkey%5D%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20assert.deepEqual%28pinScopedIterationNativeSource%28row%5Bkey%5D.source%29%2Cspecification%5Bkey%5D%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Arow%5Bkey%5D.bytes%2Csha256%3Arow%5Bkey%5D.sha256%7D%2Cspecification%5Bkey%5D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row%5Bkey%5D.ce