(25063: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7B%20decoratorSet%20%7D%20from%20%27.%2Fdecorators.js%27%3B%0Aimport%20%7B%20languageSupport%20%7D%20from%20%27.%2Flanguage-support.js%27%3B%0Aimport%20%7B%0A%20%20applyBindingExtents%2C%0A%20%20declareSyntaxBinders%2C%0A%20%20identifierContinue%2C%0A%20%20identifierStart%2C%0A%20%20isRustItem%2C%0A%20%20preferBinding%2C%0A%20%20resolveRustPath%2C%0A%20%20rustUseAliases%2C%0A%20%20unmaskInterpolations%2C%0A%7D%20from%20%27.%2Fprogram-binding-extents.js%27%3B%0Aimport%20%7B%20LinkNetwork%20%7D%20from%20%27.%2Fnetwork.js%27%3B%0Aimport%20%7B%20LinkType%20%7D%20from%20%27.%2Fprimitives.js%27%3B%0Aimport%20%7B%20projectEvidence%2C%20projectSemantics%20%7D%20from%20%27.%2Fprogram-project.js%27%3B%0Aimport%20%7B%20createProgramSnapshot%2C%20readProgramSnapshot%20%7D%20from%20%27.%2Fprogram-snapshot.js%27%3B%0A%0A%2F%2A%2A%20Schema%20revision%20for%20four-language%20program%20representations.%20%2A%2F%0Aexport%20const%20PROGRAM_REPRESENTATION_SCHEMA_VERSION%20%3D%201%3B%0A%0Aexport%20const%20SEMANTIC_CONSTRUCTS%20%3D%20Object.freeze%28%5B%0A%20%20%27modules-and-imports%27%2C%0A%20%20%27scopes-and-bindings%27%2C%0A%20%20%27recursive-definitions%27%2C%0A%20%20%27types-and-universes%27%2C%0A%20%20%27effects%27%2C%0A%20%20%27attributes%27%2C%0A%20%20%27macros-and-notation%27%2C%0A%20%20%27proof-terms-and-tactics%27%2C%0A%20%20%27surface-expansion-elaboration-traces%27%2C%0A%20%20%27project-context-and-dependencies%27%2C%0A%5D%29%3B%0A%0Aexport%20class%20BindingRenameError%20extends%20Error%20%7B%7D%0Aexport%20class%20ProgramTransformationError%20extends%20Error%20%7B%7D%0A%0A%2F%2A%2A%0A%20%2A%20Parses%20source%20into%20a%20CST-backed%20program%20model%20with%20scopes%2C%20bindings%2C%20source%0A%20%2A%20mappings%2C%20language-specific%20constructs%2C%20and%20project%20provenance.%0A%20%2A%20%60options.decorators%60%20holds%20%60cst-to-ast%60%20decorators%2C%20which%20see%20each%20syntax%0A%20%2A%20node