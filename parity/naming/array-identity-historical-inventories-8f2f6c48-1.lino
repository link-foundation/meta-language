.origins.origin%28value%2C%20path%29%3B%0A%20%20%20%20const%20source%20%3D%20origin.sourceOwner%20%3F%3F%20%7B%20kind%3A%20%27primitive%27%2C%20path%3A%20%5B%27f64%27%5D%20%7D%3B%0A%20%20%20%20const%20resolved%20%3D%20parser.resolve%28%5B%27f64%27%5D%2C%20origin.path%29%3B%0A%20%20%20%20const%20shadowed%20%3D%20Boolean%28parser.origins.lookup%28%5B%27f64%27%5D%2C%20origin.path%29%20%7C%7C%20parser.origins.lookup%28resolved%2C%20origin.path%29%29%3B%0A%20%20%20%20const%20layer%20%3D%20origin.wrappers.length%20%3D%3D%3D%200%20%3F%20%27value%27%20%3A%20origin.wrappers.length%20%3D%3D%3D%201%20%3F%20origin.wrappers%5B0%5D%20%3A%20%27multiple%27%3B%0A%20%20%20%20if%20%28%21parser.origins.collecting%20%26%26%20%28%21acceptRustReadOnlyQueryOwner%28%27inclusive%20range%27%2C%20source.kind%2C%20source.path.join%28%27%3A%3A%27%29%29%0A%20%20%20%20%20%20%7C%7C%20%21acceptRustInclusiveRangeOperand%28origin.type%3F.kind%20%3F%3F%20%27%27%2C%20origin.floatSourceModel%20%3F%3F%20%27%27%2C%20origin.proven%2C%20layer%2C%20borrowed%2C%20shadowed%29%29%29%20%7B%0A%20%20%20%20%20%20throw%20unsupported%28%27inclusive%20range%20query%27%2C%20%27endpoints%20need%20direct%20primitive%20f64%20values%20and%20contains%20needs%20one%20immutable%20f64%20reference%27%2C%20value.span%20%3F%3F%20range%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20values%20%3D%20%5Blower%2C%20upper%2C%20argument%5D%3B%0A%20%20const%20names%20%3D%20values.map%28%28%29%20%3D%3E%20parser.freshProductBinding%28%29%29%3B%0A%20%20const%20read%20%3D%20index%20%3D%3E%20%28%7B%20k%3A%20%27name%27%2C%20path%3A%20%5Bnames%5Bindex%5D%5D%2C%20span%3A%20values%5Bindex%5D.span%20%7D%29%3B%0A%20%20const%20comparison%20%3D%20%28left%2C%20right%29%20%3D%3E%20%28%7B%20k%3A%20%27binary%27%2C%20op%3A%20%27le%27%2C%20left%2C%20right%2C%20span%3A%20range%20%7D%29%3B%0A%20%20const%20test%20%3D%20%7B%20k%3A%20%27binary%27%2C%20op%3A%20%27and%27%2C%20left%3A%20comparison%28read%280%29%2C%20read%282%29%29%2C%20right%3A%20comparison%28r