(2071: (meta: (t: semantic) (n: 1) (term: string%20value) (def: export%20function%20verifyModuleScopeDeclarationHistory%28packet%29%7B%0A%20assert.deepEqual%28Object.keys%28packet%29.sort%28%29%2C%5B%27schemaVersion%27%2C%27model%27%2C%27revision%27%2C%27register%27%2C%27receipt%27%2C%27codec%27%2C%27sources%27%2C%27declarations%27%2C%27boundary%27%5D.sort%28%29%29%3B%0A%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27complete%20original%20module%20scope%20declarations%201%27%29%3B%0A%20const%20origin%3DMODULE_SCOPE_DECLARATION_ORIGIN%3Bassert.equal%28packet.revision%2Corigin.revision%29%3B%0A%20assert.deepEqual%28packet.register%2C%7Bfile%3Aorigin.register%2Cbytes%3Aorigin.bytes%2Csha256%3Aorigin.sha256%2Crows%3Aorigin.rows%7D%29%3B%0A%20for%28const%20row%20of%20%5Bpacket.receipt%2Cpacket.codec%2C...packet.sources%5D%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27file%27%2C%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D.sort%28%29%29%3B%0A%20%20assert.equal%28typeof%20row.source%2C%27string%27%29%3Bassert.equal%28row.source.isWellFormed%28%29%2Ctrue%29%3B%0A%20%20assert.deepEqual%28identity%28row.source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%3Aorigin.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%7D%0A%20assert.equal%28packet.receipt.file%2Corigin.receipt%29%3Bassert.equal%28packet.codec.file%2Corigin.codec%29%3B%0A%20const%20receipt%3DreadBootstrapStructuredDataLino%28packet.receipt.source%29%2Ccodec%3DreadBootstrapStructuredDataLino%28packet.codec.source%29%3B%0A%20assert.equal%28receipt.file%2Corigin.register%29%3Bassert.deepEqual%28receipt.current%2C%7Bbytes%3Aorigin.bytes%2Csha256%3Aorigin.sha256%2Crows%3Aorigin.rows%7D%29%3B%0A%20assert.deepEqual%28codec.profiles.at%28-1%29.source%2C%7Bpath%3Aorigin.register%2Cbytes%3Aorigin.bytes%2Csha256%3Aorigin.sha256%7D%29%3B%0A%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2CMODULE_SCOPE_DECLARATION_CORRECTIONS.map%28row%3D%3Erow.source%29%29%3B%0A%20assert.deepEqual%28packet.declarations.map%28row%3D%3E%28%7Bsource%3Arow.source%2Cname%3Arow.name%7D%29%29%2CMODULE_SCOPE_DECLARATION_CORRECTIONS%29%3B%0A%20for%28const%20row%20of%20packet.declarations%29%7B%0A%20%20assert.deepEqual%28Object.keys%28row%29.sort%28%29%2C%5B%27id%27%2C%27source%27%2C%27name%27%2C%27previous%27%2C%27current%27%5D.sort%28%29%29%3B%0A%20%20const%20prior%3Dreceipt.additions.filter%28item%3D%3Eitem.source%3D%3D%3Drow.source%26%26item.name%3D%3D%3Drow.name%29%3Bassert.equal%28prior.length%2C1%29%3B%0A%20%20assert.equal%28row.id%2Cprior%5B0%5D.id%29%3Bassert.equal%28row.previous%2Cprior%5B0%5D.sourceText%29%3B%0A%20%20const%20source%3Dpacket.sources.find%28item%3D%3Eitem.file%3D%3D%3Drow.source%29.source%2Ctokens%3Dtokenize%28source%2C%27JavaScript%27%29.tokens%3B%0A%20%20const%20positions%3Dtokens.flatMap%28%28token%2Cindex%29%3D%3Etoken.value%3D%3D%3D%27function%27%26%26tokens%5Bindex%2B1%5D%3F.value%3D%3D%3Drow.name%3F%5Bindex%5D%3A%5B%5D%29%3Bassert.equal%28positions.length%2C1%29%3B%0A%20%20const%20at%3Dpositions%5B0%5D%2Crange%3DfindCompleteModuleScopeDeclaration%28tokens.map%28token%3D%3Etoken.kind%29%2Ctokens.map%28token%3D%3Etoken.value%29%2Cat%29%3Bassert.equal%28range.length%2C2%29%3B%0A%20%20let%20declaration%3Dat%3Bif%28tokens%5Bdeclaration-1%5D%3F.value%3D%3D%3D%27async%27%29declaration--%3Bif%28tokens%5Bdeclaration-1%5D%3F.value%3D%3D%3D%27export%27%29declaration--%3B%0A%20%20assert.deepEqual%28Object.keys%28row.current%29.sort%28%29%2C%5B%27start%27%2C%27end%27%2C%27source%27%5D.sort%28%29%29%3B%0A%20%20assert.deepEqual%28row.current%2C%7Bstart%3Atokens%5Bdeclaration%5D.start%2Cend%3Atokens%5Brange%5B1%5D-1%5D.end%2Csource%3Asource.slice%28tokens%5Bdeclaration%5D.start%2Ctokens%5Brange%5B1%5D-1%5D.end%29%7D%29%3B%0A%20%20%2F%2F%20Reproduce%20the%20original%20faulty%20selector%20independently.%20