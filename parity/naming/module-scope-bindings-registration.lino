..oldFields%7D%3Dbefore%2C%7Bfiles%3AnewFiles%2C...newFields%7D%3Dafter%3B%0A%20%20%20assert.deepEqual%28newFields%2ColdFields%2C%27every%20checked%20program%2C%20source%2C%20replay%2C%20interface%20and%20original%20field%20stays%20exact%27%29%3B%0A%20%20%20assert.deepEqual%28newFiles.map%28file%3D%3Efile.path%29%2ColdFiles.map%28file%3D%3Efile.path%29%29%3B%0A%20%20%20for%28const%20file%20of%20%5B...oldFiles%2C...newFiles%5D%29%7Bassert.deepEqual%28Object.keys%28file%29.sort%28%29%2C%5B%27path%27%2C%27source%27%2C%27bytes%27%2C%27sourceSha256%27%5D.sort%28%29%29%3Bassert.deepEqual%28readNativeCompilerHostSourceIdentity%28file.source%29%2C%7Bbytes%3Afile.bytes%2Csha256%3Afile.sourceSha256%7D%29%3B%7D%0A%20%20%7Delse%7B%0A%20%20%20let%20current%3Drow.previous.source%3B%0A%20%20%20for%28const%7Bbefore%2Cafter%7Dof%20row.changes%29%7Bassert.equal%28current.split%28before%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28before%2C%28%29%3D%3Eafter%29%3B%7D%0A%20%20%20assert.equal%28current%2Crow.current.source%29%3B%0A%20%20%20for%28const%7Bbefore%2Cafter%7Dof%20%5B...row.changes%5D.reverse%28%29%29%7Bassert.equal%28current.split%28after%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28after%2C%28%29%3D%3Ebefore%29%3B%7D%0A%20%20%20assert.equal%28current%2Crow.previous.source%2C%27every%20complete%20preceding%20byte%20survives%27%29%3B%0A%20%20%7D%0A%20%7D%0A%20assert.equal%28typeof%20packet.boundary%2C%27string%27%29%3Bassert.ok%28packet.boundary.length%3E0%29%3Breturn%20packet%3B%0A%7D) (lang: meta-language%20structured%20data)))
