(43506: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BrustEscape%2CrustString%7D%20from%20%27.%2Frust-string-literals.js%27%3B%0Aimport%20%7BcheckRustRuntimeShell%2CemitRustRuntimeShell%2CrefuseRustRuntimeShellComposition%7D%20from%20%27.%2Frust-runtime-shell.js%27%3B%0Aimport%20%7B%20renderStringLengthExpression%2C%20renderStringMapExpression%2C%20renderStringTestExpression%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0Aimport%20%7BrequireStringOrderUnits%2CrenderStringOrderExpression%7D%20from%20%27.%2Fstring-order-rules.js%27%3B%0A%2F%2F%20Rust%20emitter.%20Naturals%20and%20integers%20are%20%60ml%3A%3ABig%60%2C%20an%20unbounded%20integer%0A%2F%2F%20the%20translation%20carries%20in%20its%20own%20prelude%2C%20so%20no%20value%20is%20ever%20narrowed%3B%0A%2F%2F%20machine%20integers%20stay%20Rust%20machine%20integers%20with%20checked%20arithmetic%2C%20which%0A%2F%2F%20panics%20exactly%20where%20the%20source%20aborts%3B%20a%20JavaScript%20Number%20is%20an%20%60f64%60%2C%0A%2F%2F%20printed%20by%20%60ml_number%3A%3Ajs_number%60%20exactly%20as%20JavaScript%20prints%20it.%20Data%20types%20are%20enums%20whose%0A%2F%2F%20data-typed%20fields%20are%20boxed.%20Every%20value%20is%20owned%3A%20a%20variable%20is%20cloned%0A%2F%2F%20where%20it%20is%20consumed.%20Theorems%20cannot%20be%20proved%20in%20Rust%3A%20each%20becomes%20an%0A%2F%2F%20executable%20property%2C%20checked%20over%20a%20bounded%20domain%20by%0A%2F%2F%20%60--ml-check-theorems%60%2C%20while%20the%20proof%20stays%20discharged%20by%20the%20source%20kernel.%0A%0Aimport%20%7B%20castMessage%2C%20overflowMessage%2C%20zeroDivisorMessage%20%7D%20from%20%27.%2Faborts.js%27%3B%0Aimport%20%7B%20renderCollectionIteration%2C%20renderOptionalArrayRead%2C%20renderStringPointIteration%20%7D%20from%20%27.%2Farray-value-rules.js%27%3B%0Aimport%20%7B%20renderArrayFromMapping%20%7D%20from%20%27.%2Farray-from-rules.js%27%3B%0Aimport%20%7B%20renderArrayCallbackExpression%2C%20renderArrayCallbackReferenceExpression