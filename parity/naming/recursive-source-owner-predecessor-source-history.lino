al%28source%2Ccurrent.source%2C%27an%20unknown%20current%20overlay%20receipt%20cannot%20acquire%20historical%20identity%27%29%3B%0A%20%20return%20row.source%3B%0A%7D%0A%0Aexport%20function%20restoreReviewedOverlayProviderHostSource%28source%2Cfile%29%7B%0A%20%20if%28file%21%3D%3DOVERLAY_PROVIDER_HOST%29return%20source%3B%0A%20%20const%20row%3DreadReviewedOverlayProviderSuccession%28%29.host%3B%0A%20%20return%20source%3D%3D%3DreplayOverlayProviderHost%28row.source%29%3Frow.source%3Asource%3B%0A%7D%0A%0A%2F%2A%2A%20Only%20an%20explicitly%20historical%20caller%20uses%20this%20exact%20checkpoint%E2%86%928d%20view.%20%2A%2F%0Aexport%20function%20restoreReviewedOverlayProviderModuleSource%28source%2Cfile%29%7B%0A%20%20if%28%21file.startsWith%28%27js%2Fsrc%2F%27%29%29return%20source%3B%0A%20%20const%20module%3Dfile.slice%28%27js%2Fsrc%2F%27.length%29%2Cpacket%3DreadReviewedOverlayProviderSuccession%28%29%3B%0A%20%20const%20row%3Dpacket.profiles%5B1%5D.certificates.find%28row%3D%3Erow.module%3D%3D%3Dmodule%29%3B%0A%20%20return%20row%26%26source%3D%3D%3Drow.current.source%3Frow.previous.source%3Asource%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
