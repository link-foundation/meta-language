The%20large%20archived%20document%20is%20retained%20verbatim%20exactly%20once.%20Its%20physical%0A%20%2A%20outputs%20are%20reconstructed%20from%20it%20and%20checked%20against%20independent8d%20Git%20blobs.%20%2A%2F%0Aexport%20function%20verifyCurrentRawPredecessorHistory%28history%2CarchiveBytes%3DreadFileSync%28new%20URL%28CURRENT_RAW_PREDECESSOR_ARCHIVE%2Croot%29%29%29%7B%0A%20%20exactKeys%28history%2C%5B%27schemaVersion%27%2C%27model%27%2C%27revision%27%2C%27archive%27%2C%27outputs%27%2C%27sources%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28history.schemaVersion%2C1%29%3Bassert.equal%28history.model%2C%27complete%20prior%20current%20raw%20source%20descriptors%201%27%29%3B%0A%20%20assert.equal%28history.revision%2CCURRENT_RAW_PREDECESSOR_REVISION%29%3B%0A%20%20const%20policy%3DreadCurrentOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20exactKeys%28history.archive%2C%5B%27path%27%2C%27file%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20assert.equal%28history.archive.path%2CCURRENT_RAW_PREDECESSOR_ARCHIVE%29%3Bassert.equal%28history.archive.file%2Cpolicy.output%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Ahistory.archive.bytes%2Csha256%3Ahistory.archive.sha256%7D%2CCURRENT_RAW_PREDECESSOR_PIN%29%3B%0A%20%20assert.deepEqual%28pinCurrentRawPredecessorSource%28archiveBytes%29%2CCURRENT_RAW_PREDECESSOR_PIN%29%3B%0A%20%20verifyGitArtifactCertificate%28history.archive.certificate%2CarchiveBytes%2C%7Brevision%3ACURRENT_RAW_PREDECESSOR_REVISION%2Cpath%3Apolicy.output%7D%29%3B%0A%20%20const%20packet%3DreadBootstrapStructuredDataLino%28archiveBytes.toString%28%27utf8%27%29%29%3B%0A%20%20verifyCurrentOwnCodebaseRawDescriptorStructure%28packet%29%3B%0A%20%20const%20derived%3DderiveCurrentOwnCodebaseRawDescriptorOutputs%28packet%29%3Bassert.deepEqual%28packet.edge%2Cderived.edge%29%3B%0A%20%20assert.equal%28packet.inferenceDescriptorAlias%2Cderived.edge.inferenceDescriptorAlias%29%3B%0A%20%20assert.deepEqual%28history.outputs.map%28row%3D%3Erow.file%29%2C%5Bpolicy.artifactFile%2Cpolicy.registerFile%2Cpolicy.loanFile%5D%29%3B%0A%20%20assert.deepEqual%28history.sources.map%28row%3D%3Erow.file%29%2Cpolicy.sourcePaths%29%3B%0A%20%20for%28const%20row%20of%20%5B...history.outputs%2C...history.sources%5D%29%7B%0A%20%20%20%20exactKeys%28row%2C%5B%27file%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20const%20source%3Dhistory.outputs.includes%28row%29%3Fderived.outputs.find%28output%3D%3Eoutput.file%3D%3D%3Drow.file%29.source%0A%20%20%20%20%20%20%3Apacket.sources.find%28source%3D%3Esource.file%3D%3D%3Drow.file%29.current.sourceText%3B%0A%20%20%20%20assert.deepEqual%28pinCurrentRawPredecessorSource%28source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28source%29%2C%7Brevision%3ACURRENT_RAW_PREDECESSOR_REVISION%2Cpath%3Arow.file%7D%29%3B%0A%20%20%7D%0A%20%20for%28const%20row%20of%20history.outputs%29%7B%0A%20%20%20%20const%20original%3D%5Bpacket.artifact%2Cpacket.register%2Cpacket.loan%5D.find%28input%3D%3Einput.file%3D%3D%3Drow.file%29%3B%0A%20%20%20%20assert.deepEqual%28original.current%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%7D%0A%20%20return%7Bpacket%2Coutputs%3Aderived.outputs%7D%3B%0A%7D%0A%0Afunction%20load%28%29%7B%0A%20%20if%28%21cached%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28CURRENT_RAW_PREDECESSOR_OUTPUT%2Croot%29%29%3B%0A%20%20%20%20assert.equal%28pinCurrentRawPredecessorSource%28bytes%29.sha256%2ChistorySha256%29%3B%0A%20%20%20%20const%20history%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20cached%3D%7Bhistory%2C...verifyCurrentRawPredecessorHistory%28history%29%7D%3B%0A%20%20%7D%0A%20%20return%20cached%3B%0A%7D%0A%0Aexport%20function%20readCurrentRawPredecessorHistory%28%29%7Breturn%20structuredClone%28load%28%29.history%29%3B%7D%0Aexport%20function%20readCurrentRawPredecessorPacket%28%29%7Breturn%20structuredClone%28load%28%29.packet%29%3B%7D%0Aexport%20function%20readCurrentRawPredecessorOutputs%28%29%7Breturn%20structuredClone%28load%28%29.outputs%29%3B%7D%0A%0A%2F%2A%2A%20An%20author%20may%20replace%20only%20the%20three%20exact%20certified%20prior%20current%20outputs.%0A%20%2A%20No%20other%20path%20or%20even%20one%20unreviewed%20byte%20obtains%20this%20admission.%20%2A%2F%0Aexport%20function%20acceptCurrentRawPredecessorOutput%28source%2Cfile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3B%0A%20%20return%20load%28%29.outputs.some%28row%3D%3Erow.file%3D%3D%3Dfile%26%26row.source%3D%3D%3Dsource%29%3B%0A%7D%0A%0Aexport%20function%20acceptCurrentRawPredecessorPacketSource%28source%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bload%28%29%3B%0A%20%20const%20bytes%3DBuffer.from%28source%29%3Breturn%20bytes.length%3D%3D%3DCURRENT_RAW_PREDECESSOR_PIN.bytes%0A%20%20%20%20%26%26pinCurrentRawPredecessorSource%28bytes%29.sha256%3D%3D%3DCURRENT_RAW_PREDECESSOR_PIN.sha256%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
