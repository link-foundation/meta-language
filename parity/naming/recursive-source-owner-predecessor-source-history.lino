rent%27%3Fprofile.sourceCommit%3Aprofile.previousSourceCommit%3B%0A%20%20%20%20%20%20%20%20assert.equal%28source.revision%2Crevision%29%3B%0A%20%20%20%20%20%20%20%20verifyGitArtifactCertificate%28source.certificate%2CBuffer.from%28source.source%29%2C%7Brevision%2Cpath%3A%27js%2Fsrc%2F%27%2Brow.module%7D%29%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20assert.equal%28hash%28row.current.source%29%2Cprofile.providers%5Bowner%5D.sourceSha256%29%3B%0A%20%20%20%20%20%20if%28index%3E0%29assert.equal%28hash%28row.previous.source%29%2Cpacket.profiles%5Bindex-1%5D.providers%5Bowner%5D.sourceSha256%29%3B%0A%20%20%20%20%20%20const%20actions%3Dprofile.inverse.filter%28action%3D%3Eaction.module%3D%3D%3Drow.module%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28actions%2Crow.current.source%3D%3D%3Drow.previous.source%3F%5B%5D%3A%5B%7Bmodule%3Arow.module%2Cfrom%3Arow.current.source%2Cto%3Arow.previous.source%7D%5D%29%3B%0A%20%20%20%20%20%20if%28index%3D%3D%3Dpacket.profiles.length-1%29assert.equal%28row.current.source%2CreadFileSync%28new%20URL%28%27js%2Fsrc%2F%27%2Brow.module%2Croot%29%2C%27utf8%27%29%2C%27every%20actual%20complete%20current%20provider%20belongs%20to%20the%20real%20checkpoint%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.deepEqual%28profile.inverse.map%28row%3D%3Erow.module%29%2Cindex%3D%3D%3D0%3F%5B%27typed-program-links-validation.js%27%5D%3A%5B%27translation%2Femit-javascript.js%27%5D%29%3B%0A%20%20%20%20previous%3Dprofile.sourceCommit%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28packet.historicalOutputs.map%28row%3D%3Erow.file%29%2C%5B%0A%20%20%20%20%27experiments%2Frust-text-certificate-adapter%2Fdata%2Fprovider-revisions.lino%27%2C%0A%20%20%20%20%27experiments%2Frust-text-certificate-adapter%2Fdata%2Foverlays-current.lino%27%2C%0A%20%20%20%20%27experiments%2Frust-raw-binding-certificate-adapter%2Fdata%2Foverlays-current.lino%27%2C%0A%20%20%5D%29%3B%0A%20%20for%28const%20row%20of%20%5B...packet.historicalOutputs%2Cpacket.host%5D%29%7B%0A%20%20%20%20assert.equal%