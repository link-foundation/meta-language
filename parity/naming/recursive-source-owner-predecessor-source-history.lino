(64456: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20test%20from%20%27node%3Atest%27%3B%0Aimport%20%7BreadProjectData%2CserializeProjectData%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BreviewedOverlayProviderPolicy%2CreadReviewedOverlayProviderSources%2CrestoreReviewedOverlayProviderSources%7D%0A%20%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Freviewed-providers.mjs%27%3B%0Aimport%20%7BreadReviewedOverlayProviderSuccession%2CverifyReviewedOverlayProviderSuccession%2C%0A%20%20restoreReviewedOverlayProviderPolicy%2CrestoreReviewedOverlayProviderReceiptSource%7D%0A%20%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fprovider-succession.mjs%27%3B%0Aimport%20%7BgenerateReviewedOverlayProviderSuccession%7D%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fgenerate-provider-succession.mjs%27%3B%0Aimport%20%7BrustTextCertificateOverlayRecords%7D%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fgenerate.mjs%27%3B%0Aimport%20%7BrawBindingCertificateOverlayRecords%7D%20from%20%27..%2F..%2Fexperiments%2Frust-raw-binding-certificate-adapter%2Fgenerate-overlay.mjs%27%3B%0Aimport%20%7BcreateRustTextCertificatePublicOverlay%7D%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fruntime.mjs%27%3B%0Aimport%20%7BcreateRustRawBindingCertificateOverlay%7D%20from%20%27..%2F..%2Fexperiments%2Frust-raw-binding-certificate-adapter%2Fruntime.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%2Cread%3Dfile%3D%3EreadFileSync%28new%20URL%28file%2Croot%29%29%3B%0Aconst%20hash%3Dvalue%3D%3EcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0A%0Atest%28%27reviewed%20overlay%20source%20assertions%20select%20covered%20active%20Node%20versions%27%2C%28%29%3D%3E%7B%0A%20%20const%5Bmajor%2Cminor%5D%3Dprocess.versions.node.split%28%27.%27%29.map%28Number%29%3B%0A%20%20assert.ok%28major%3D%3D%3D22%26%26minor%3E%3D15%7C%7Cmajor%3D%3D%3D24%2C%27uncovered%20Node%20%27%2Bprocess.versions.node%2B%27%3B%20%3E%3D22.15%20%3C23%20%7C%7C%20%3E%3D24%20%3C25%20required%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27actual%20five-provider%20profiles%20have%20one%20exact%20reviewed%20revision%20and%20complete%20committed%20inverses%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DreadReviewedOverlayProviderSuccession%28%29%2Ccurrent%3DreviewedOverlayProviderPolicy.revisions.at%28-1%29%2Cmodules%3Dcurrent.providers.map%28row%3D%3Erow.module%29%3B%0A%20%20assert.equal%28current.sourceCommit%2C%278ef026a395ebbbc415f948777f7f6f7e082a572e%27%29%3B%0A%20%20assert.deepEqual%28packet.profiles.map%28row%3D%3Erow.inverse.map%28action%3D%3Eaction.module%29%29%2C%5B%5B%27typed-program-links-validation.js%27%5D%2C%5B%27translation%2Femit-javascript.js%27%5D%5D%29%3B%0A%20%20for%28const%20experiment%20of%20%5B%27rust-text-certificate-adapter%27%2C%27rust-raw-binding-certificate-adapter%27%5D%29%7B%0A%20%20%20%20const%20actual%3DreadReviewedOverlayProviderSources%28%7Bexperiment%2Cmodules%7D%29%3Bassert.equal%28actual.revision%2Ccurrent%29%3B%0A%20%20%20%20for%28const%20row%20of%20current.providers%29assert.equal%28hash%28read%28%27js%2Fsrc%2F%27%2Brow.module%29%29%2Crow.sourceSha256%29%3B%0A%20%20%20%20for%28const%20sourceCommit%20of%20%5B%278d77e476d097448eb381ebe03e2aa173402bc03d%27%2Cpacket.previousSourceCommit%5D%29%7B%0A%20%20%20%20%20%20const%20restored%3DrestoreReviewedOverlayProviderSources%28%7Bexperiment%2Cmodules%2CsourceCommit%7D%29%3B%0A%20%20%20%20%20%20for%28const%20row%20of%20restored.revision.providers%29assert.equal%28hash%28restored.sources.get%28row.module%29%29%2Crow.sourceSha256%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20for%28const%20changed%20of%20modules%29assert.throws%28%28%29%3D%3EreadReviewedOverlayProviderSources%28%7Bexperiment%2Cmodules%2C%0A%20%20%20%20%20%20readSource%3Amodule%3D%3Eactual.sources.get%28module%29%2B%28module%3D%3D%3Dchanged%3F%27%5Cn%27%3A%27%27%29%7D%29%2C%2Fno%20unique%20reviewed%20revision%2Fu%2Cchanged%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreReviewedOverlayProviderSources%28%7Bexperiment%2Cmodules%2CsourceCommit%3A%270%27.repeat%2840%29%7D%29%2C%2Fone%20reviewed%20historical%2Fu%29%3B%0A%20%20%7D%0A%20%20const%20original%3DrestoreReviewedOverlayProviderPolicy%28reviewedOverlayProviderPolicy%29%3B%0A%20%20assert.equal%28serializeProjectData%28original%2Cpacket.historicalOutputs%5B0%5D.file%29%2Cpacket.historicalOutputs%5B0%5D.source%29%3B%0A%7D%29%3B%0A%0Atest%28%27both%20current%20overlay%20receipts%20retain%20every%20old%20decorator%20action%20and%20exact%20committed%20historical%20bytes%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DreadReviewedOverlayProviderSuccession%28%29%3B%0A%20%20for%28const%5Bindex%2Cauthor%5Dof%20%5BrustTextCertificateOverlayRecords%2CrawBindingCertificateOverlayRecords%5D.entries%28%29%29%7B%0A%20%20%20%20const%20row%3Dpacket.historicalOutputs%5Bindex%2B1%5D%2Cactual%3Dread%28row.file%29.toString%28%27utf8%27%29%3B%0A%20%20%20%20assert.equal%28actual%2CserializeProjectData%28author%28%29%2Crow.file%29%29%3B%0A%20%20%20%20assert.equal%28restoreReviewedOverlayProviderReceiptSource%28actual%2Crow.file%29%2Crow.source%29%3B%0A%20%20%20%20assert.equal%28restoreReviewedOverlayProviderReceiptSource%28row.source%2Crow.file%29%2Crow.source%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreReviewedOverlayProviderReceiptSource%28actual%2B%27%5Cn%27%2Crow.file%29%2Cassert.AssertionError%29%3B%0A%20%20%20%20const%20historical%3Dauthor%28%7BsourceCommit%3Apacket.previousSourceCommit%7D%29%3B%0A%20%20%20%20assert.equal%28serializeProjectData%28historical%2Crow.file%29%2Crow.source%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27coherent%20profile%20source%20mutations%20forged%20Git%20memberships%20inverse%20deletion%20and%20duplicate%20profiles%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20mutations%3D%5B%0A%20%20%20%20packet%3D%3E%7Bpacket.profiles.reverse%28%29%3B%7D%2Cpacket%3D%3E%7Bpacket.profiles%5B0%5D.sourceCommit%3D%270%27.repeat%2840%29%3B%7D%2C%0A%20%20%20%20packet%3D%3E%7Bpacket.profiles%5B1%5D.previousSourceCommit%3Dpacket.previousSourceCommit%3B%7D%2C%0A%20%20%20%20packet%3D%3E%7Bpacket.profiles%5B0%5D.certificates%5B1%5D.current.certificate.path%3D%27unregistered.js%27%3B%7D%2C%0A%20%20%20%20packet%3D%3E%7Bpacket.profiles%5B1%5D.certificates%5B3%5D.current.source%2B%3D%27%5Cn%27%3Bpacket.profiles%5B1%5D.providers%5B3%5D.sourceSha256%3Dhash%28packet.profiles%5B1%5D.certificates%5B3%5D.current.source%29%3B%7D%2C%0A%20%20%20%20packet%3D%3E%7Bpacket.profiles%5B0%5D.inverse%3D%5B%5D%3B%7D%2Cpacket%3D%3E%7Bpacket.profiles%5B1%5D.inverse%5B0%5D.to%2B%3D%27%5Cn%27%3B%7D%2C%0A%20%20%20%20packet%3D%3E%7Bpacket.profiles.push%28structuredClone%28packet.profiles%5B1%5D%29%29%3B%7D%2C%0A%20%20%20%20packet%3D%3E%7Bpacket.historicalOutputs%5B1%5D.source%2B%3D%27%5Cn%27%3Bpacket.historicalOutputs%5B1%5D.bytes%2B%3D1%3Bpacket.historicalOutputs%5B1%5D.sha256%3Dhash%28packet.historicalOutputs%5B1%5D.source%29%3B%7D%2C%0A%20%20%20%20packet%3D%3E%7Bpacket.host.source%2B%3D%27%5Cn%27%3Bpacket.host.bytes%2B%3D1%3Bpacket.host.sha256%3Dhash%28packet.host.source%29%3B%7D%2C%0A%20%20%5D%3B%0A%20%20for%28const%5Bindex%2Cmutate%5Dof%20mutations.entries%28%29%29%7B%0A%20%20%20%20const%20packet%3DreadReviewedOverlayProviderSuccession%28%29%3Bmutate%28packet%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EverifyReviewedOverlayProviderSuccession%28packet%29%2Cassert.AssertionError%2C%27tamper%20%27%2Bindex%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27both%20actual%20isolated%20model%20overlays%20load%20using%20the%20updated%20exact%20current%20provider%20receipts%27%2Casync%28%29%3D%3E%7B%0A%20%20for%28const%20create%20of%20%5BcreateRustTextCertificatePublicOverlay%2CcreateRustRawBindingCertificateOverlay%5D%29%7B%0A%20%20%20%20const%20overlay%3Dawait%20create%28%29%3B%0A%20%20%20%20try%7B%0A%20%20%20%20%20%20assert.equal%28overlay.receipts.length%2C5%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20overlay.api.createTypedProgramLinks%2C%27function%27%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20overlay.javascript.emitJavaScript%2C%27function%27%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20overlay.validation.validateLinkedTypedProgram%2C%27function%27%29%3B%0A%20%20%20%20%7Dfinally%7Boverlay.dispose%28%29%3B%7D%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27normal%20source%20review%20refreshes%20only%20current%20receipts%20and%20retains%20both%20immutable%20original%20overlays%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20paths%3DreviewedOverlayProviderPolicy.historicalOverlays.map%28row%3D%3E%27experiments%2F%27%2Brow.experiment%2B%27%2Fdata%2Foverlays.lino%27%29%3B%0A%20%20const%20before%3Dpaths.map%28read%29%3B%0A%20%20const%20packet%3Dawait%20generateReviewedOverlayProviderSuccession%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20assert.deepEqual%28packet%2CreadReviewedOverlayProviderSuccession%28%29%29%3B%0A%20%20paths.forEach%28%28path%2Cindex%29%3D%3Eassert.deepEqual%28read%28path%29%2Cbefore%5Bindex%5D%29%29%3B%0A%20%20assert.deepEqual%28readProjectData%28new%20URL%28%27experiments%2Frust-text-certificate-adapter%2Fdata%2Fprovider-revisions.lino%27%2Croot%29%29%2CreviewedOverlayProviderPolicy%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
