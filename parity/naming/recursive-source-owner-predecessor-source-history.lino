9%7B%0A%20%20exactKeys%28packet%2C%5B%27schemaVersion%27%2C%27model%27%2C%27profile%27%2C%27file%27%2C%27sourceArchive%27%2C%27anchors%27%2C%27current%27%2C%27edges%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27relative%20array%20complete%20current%20frontend%20succession%201%27%29%3B%0A%20%20assert.equal%28packet.profile%2C%27relative%20array%27%29%3Bassert.equal%28packet.file%2CRELATIVE_ARRAY_CURRENT_FRONTEND%29%3B%0A%20%20assert.deepEqual%28packet.sourceArchive%2CRELATIVE_ARRAY_CURRENT_FRONTEND_NAMING%29%3B%0A%20%20assert.ok%28Array.isArray%28packet.anchors%29%29%3Bassert.equal%28packet.anchors.length%2C2%29%3B%0A%20%20for%28const%5Bindex%2Crow%5Dof%20packet.anchors.entries%28%29%29%7B%0A%20%20%20%20exactKeys%28row%2C%5B%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27source%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20const%20expected%3DRELATIVE_ARRAY_CURRENT_FRONTEND_ANCHORS%5Bindex%5D%3B%0A%20%20%20%20assert.deepEqual%28%7Brevision%3Arow.revision%2Cbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%2Cexpected%29%3B%0A%20%20%20%20assert.deepEqual%28pinRelativeArrayCurrentFrontend%28row.source%29%2C%7Bbytes%3Aexpected.bytes%2Csha256%3Aexpected.sha256%7D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%3Aexpected.revision%2Cpath%3Apacket.file%7D%29%3B%0A%20%20%7D%0A%20%20exactKeys%28packet.current%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20assert.equal%28typeof%20packet.current.source%2C%27string%27%29%3B%0A%20%20assert.deepEqual%28pinRelativeArrayCurrentFrontend%28packet.current.source%29%2C%7Bbytes%3Apacket.current.bytes%2Csha256%3Apacket.current.sha256%7D%29%3B%0A%20%20assert.equal%28packet.current.source%2CreadFileSync%28new%20URL%28packet.file%2Croot%29%2C%27utf8%27%29%2C%27only%20the%20actual%20complete%20current%20frontend%20has%20this%20source%20view%27%29%3B%0A%20%20assert.ok%28Array.isArray%28packet.edges%29%29%3Bassert.equal%28packet.edges.length%2C2%29%3B%0A%20%20const%20sources%3D%5Bpacket.anchors%5B0%5D.source%2Cpacket.anchors%5B1%5D.source%2Cpacket.current.source%5D%3B%0A%20%20for%28const%5Bindex%2Cedge%5Dof%20packet.edges.entries%28%29%29%7B%0A%20%20%20%20exactKeys%28edge%2C%5B%27from%27%2C%27to%27%2C%27coordinateUnit%27%2C%27edits%27%5D%29%3B%0A%20%20%20%20assert.deepEqual%28edge.from%2CpinRelativeArrayCurrentFrontend%28sources%5Bindex%5D%29%29%3B%0A%20%20%20%20assert.deepEqual%28edge.to%2CpinRelativeArrayCurrentFrontend%28sources%5Bindex%2B1%5D%29%29%3B%0A%20%20%20%20assert.equal%28edge.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20%20%20assert.deepEqual%28edge.edits%2CderiveRelativeArrayFrontendIntervals%28sources%5Bindex%5D%2Csources%5Bindex%2B1%5D%29%29%3B%0A%20%20%20%20assert.equal%28replayRequiredFieldNativeHostIntervals%28sources%5Bindex%5D%2Cedge.edits%29%2Csources%5Bindex%2B1%5D%29%3B%0A%20%20%20%20let%20inverse%3Dsources%5Bindex%2B1%5D%3B%0A%20%20%20%20for%28const%20edit%20of%20edge.edits.toReversed%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2Csources%5Bindex%5D%2C%27every%20original%20complete%20source%20byte%20remains%27%29%3B%0A%20%20%7D%0A%20%20return%20packet.anchors%5B0%5D.source%3B%0A%7D%0A%0Aexport%20function%20readRelativeArrayCurrentFrontendHistory%28%29%7B%0A%20%20if%28%21cached%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28RELATIVE_ARRAY_CURRENT_FRONTEND_OUTPUT%2Croot%29%29%3B%0A%20%20%20%20assert.equal%28pinRelativeArrayCurrentFrontend%28bytes%29.sha256%2CpacketSha256%29%3B%0A%20%20%20%20cached%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20verifyRelativeArrayCurrentFrontendHistory%28cached%29%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28cached%29%3B%0A%7D%0A%0A%2F%2A%2A%20The%20older%20certified897%20source%20is%20already%20historical%20and%20remains%20an%20identity.%0A%20%2A%20All%20unrelated%20profiles%2Fpaths%20are%20identities.%20Every%20unknown%20selected%20successor%20refuses.%20%2A%2F%0Aexport%20function%20restoreRelativeArrayCurrentFrontendSource%28source%2Cfile%2Cprofile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bassert.equal%28typeof%20profile%2C%27string%27%29%3B%0A%20%20if%28profile%21%3D%3D%27relative%20array%27%7C%7Cfile%21%3D%3DRELATIVE_ARRAY_CURRENT_FRONTEND%29return%20source%3B%0A%20%20const%20actual%3DpinRelativeArrayCurrentFrontend%28source%29%3B%0A%20%20if%28actual.bytes%3D%3D%3Dlegacy.bytes%26%26actual.sha256%3D%3D%3Dlegacy.sha256%29return%20source%3B%0A%20%20const%20packet%3DreadRelativeArrayCurrentFrontendHistory%28%29%3B%0A%20%20for%28const%20row%20of%20%5B...packet.anchors%2Cpacket.current%5D%29%7B%0A%20%20%20%20if%28source%3D%3D%3Drow.source%29return%20packet.anchors%5B0%5D.source%3B%0A%20%20%7D%0A%20%20assert.fail%28%27an%20unknown%20complete%20frontend%20successor%20has%20no%20relative-array%20current-source%20authority%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
