ourceFile%2Croot%29%2C%27utf8%27%29%2Cpolicy.sourceFile%29%29%29%22%29%3B%0A%20%20%20%20source%3Donce%28source%2C%22%27the%20actual%20reviewed%20frontend%20source%2C%20not%20an%20archived%20read%20view%2C%20is%20used%27%22%2C%22%27the%20original%20frontend%20assertion%20checks%20its%20exact%20historical%20view%3B%20live%20bytes%20belong%20to%20the%20successor%27%22%29%3B%0A%20%20%20%20return%20once%28source%2C%22for%28const%20row%20of%20writes%29%7Bconst%20observed%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%3Bassert.ok%28%22%2C%0A%20%20%20%20%20%20%22for%28const%20row%20of%20writes%29%7Bconst%20physical%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Cobserved%3Dcheck%26%26%5Bpolicy.artifactFile%2Cpolicy.registerFile%2Cpolicy.loanFile%5D.includes%28row.file%29%3FrestoreCurrentOwnCodebaseRawText%28physical%2Crow.file%29%3Aphysical%3Bassert.ok%28%22%29%3B%0A%20%20%7D%0A%20%20assert.equal%28file%2C%27js%2Ftests%2Ftranslation-own-codebase-raw-source-descriptors.test.js%27%29%3B%0A%20%20source%3Donce%28source%2Cprefix%2C%22%5Cnimport%20%7BrestoreCurrentOwnCodebaseRawSource%2CrestoreCurrentOwnCodebaseRawData%7D%20from%20%27..%2Fscripts%2Fcurrent-own-codebase-raw-source-descriptors.mjs%27%3B%22%2Bprefix%29%3B%0A%20%20source%3Donce%28source%2C%22assert.equal%28source%2CreadFileSync%28new%20URL%28policy.sourceFile%2Croot%29%2C%27utf8%27%29%29%3B%22%2C%0A%20%20%20%20%22assert.equal%28source%2CrestoreCurrentOwnCodebaseRawSource%28readFileSync%28new%20URL%28policy.sourceFile%2Croot%29%2C%27utf8%27%29%2Cpolicy.sourceFile%29%29%3B%22%29%3B%0A%20%20return%20once%28source%2C%22const%20loan%3DreadProjectData%28new%20URL%28packet.loan.file%2Croot%29%29%3Bassert.deepEqual%28%22%2C%0A%20%20%20%20%22const%20loan%3DrestoreCurrentOwnCodebaseRawData%28readProjectData%28new%20URL%28packet.loan.file%2Croot%29%29%2Cpacket.loan.file%29%3Bassert.deepEqual%28%22%29%3B%0A%7D%0A%0Aexport%20function%20generateCurrentOwnCodebaseRawSourceDescriptors%28%7Bcheck%3D