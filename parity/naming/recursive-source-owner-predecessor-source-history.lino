2C%27declarationNames%27%2C%27totals%27%2C%27assumptions%27%2C%27encodings%27%2C%27mappings%27%2C%27preludeHashes%27%2C%27replays%27%2C%27archive%27%5D%3B%0A%0Atest%28%27current%20raw%20version-conservation%20controls%20select%20a%20covered%20active%20Node%20range%27%2C%28%29%3D%3E%7B%0A%20%20const%5Bmajor%2Cminor%5D%3Dprocess.versions.node.split%28%27.%27%29.map%28Number%29%3B%0A%20%20assert.ok%28major%3D%3D%3D22%26%26minor%3E%3D15%7C%7Cmajor%3D%3D%3D24%2C%27uncovered%20Node%20%27%2Bprocess.versions.node%2B%27%3B%20%3E%3D22.15%20%3C23%20%7C%7C%20%3E%3D24%20%3C25%20required%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20complete8d%20current%20packet%20and%20its106%20native%20definitions%20remain%20separately%20available%20with%20exact%20source%20aliases%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DreadCurrentRawPredecessorHistory%28%29%2Cold%3DreadCurrentRawPredecessorPacket%28%29%2Ccurrent%3DreadCurrentOwnCodebaseRawDescriptorPacket%28%29%3B%0A%20%20assert.deepEqual%28pinCurrentRawPredecessorSource%28read%28CURRENT_RAW_PREDECESSOR_ARCHIVE%29%29%2CCURRENT_RAW_PREDECESSOR_PIN%29%3B%0A%20%20assert.equal%28old.schemaVersion%2C1%29%3Bassert.equal%28current.schemaVersion%2Cold.schemaVersion%29%3B%0A%20%20assert.equal%28old.sources%5B0%5D.current.bytes%2C136201%29%3B%0A%20%20assert.equal%28old.sources%5B0%5D.current.sha256%2C%27face5521fb69545cd5c06ff2eebed38878ccba559e69d1454cb7cc352efc43ed%27%29%3B%0A%20%20assert.equal%28old.edge.changes.length%2C10%29%3Bassert.equal%28current.edge.changes.length%2C10%29%3B%0A%20%20const%20outputs%3DreadCurrentRawPredecessorOutputs%28%29%3Bassert.equal%28outputs.length%2C3%29%3B%0A%20%20const%20prior%3DreadStructuredDataLino%28outputs%5B0%5D.source%29%2Cactual%3DreadProjectData%28new%20URL%28history.outputs%5B0%5D.file%2Croot%29%29%3B%0A%20%20assert.equal%28prior.definitionCount%2C106%29%3Bassert.equal%28prior.owners.length%2C106%29%3B%0A%20%20assert.equal%28actual.definitionCount%2C106%29%3Bassert.equal%28actual.owners.length%2C106%29%3B%0A%20%20for%28const%20field%20of%20fields%29assert.deepEqual%28actual%5Bfield%5D%2Cprior%5Bfield%5D%2Cfield%2B%27%20is%20conserved%20as%20its%20original%20complete%20definition%27%29%3B%0A%20%20for%28const%5Bpacket%2Cartifact%5Dof%20%5B%5Bold%2Cprior%5D%2C%5Bcurrent%2Cactual%5D%5D%29%7B%0A%20%20%20%20const%20proof%3Dartifact.predecessor.proof.producerApplicability%3B%0A%20%20%20%20assert.equal%28proof.sources.find%28row%3D%3Erow.file%3D%3D%3Dpacket.sources%5B1%5D.file%29%3D%3D%3Dproof.sourceHistory.current%2Cpacket.inferenceDescriptorAlias%29%3B%0A%20%20%20%20assert.deepEqual%28packet.edge%2CderiveCurrentOwnCodebaseRawDescriptorOutputs%28packet%29.edge%29%3B%0A%20%20%7D%0A%20%20assert.equal%28serializeProjectData%28old%2CreadCurrentOwnCodebaseRawDescriptorPolicy%28%29.output%29%2Cread%28CURRENT_RAW_PREDECESSOR_ARCHIVE%29.toString%28%27utf8%27%29%29%3B%0A%20%20const%20detached%3DreadCurrentRawPredecessorPacket%28%29%3Bdetached.edge.changes.reverse%28%29%3B%0A%20%20assert.deepEqual%28readCurrentRawPredecessorPacket%28%29.edge%2Cold.edge%29%3B%0A%7D%29%3B%0A%0Atest%28%27normal%20transition%20admits%20only%20the%20three%20complete%20certified%20prior%20output%20bytes%20and%20never%20an%20unknown%20path%20or%20mutation%27%2C%28%29%3D%3E%7B%0A%20%20for%28const%20row%20of%20readCurrentRawPredecessorOutputs%28%29%29%7B%0A%20%20%20%20assert.equal%28acceptCurrentRawPredecessorOutput%28row.source%2Crow.file%29%2Ctrue%29%3B%0A%20%20%20%20assert.equal%28acceptCurrentRawPredecessorOutput%28row.source%2B%27%5Cn%27%2Crow.file%29%2Cfalse%29%3B%0A%20%20%20%20assert.equal%28acceptCurrentRawPredecessorOutput%28row.source%2C%27unregistered.lino%27%29%2Cfalse%29%3B%0A%20%20%7D%0A%20%20const%20source%3Dread%28CURRENT_RAW_PREDECESSOR_ARCHIVE%29.toString%28%27utf8%27%29%3B%0A%20%20assert.equal%28acceptCurrentRawPredecessorPacketSource%28source%29%2Ctrue%29%3B%0A%20%20assert.equal%28acceptCurrentRawPredecessorPacketSource%28source%2B%27%5Cn%27%29%2Cfalse%29%3B%0A%7D%29%3B%0A%0Atest%28%27new%20active%20provenance%20uses%20actual%20physical%20sources%20while%20the%20old%20current%20revision%20keeps%20its%20own%20identity%27%2C%28%29%3D%3E%7B%0A%20%20const%20current%3DreadCurrentOwnCodebaseRawDescriptorPacket%28%29%2Cold%3DreadCurrentRawPredecessorPacket%28%29%3B%0A%20%20assert.notEqual%28current.sources%5B0%5D.current.sourceText%2Cold.sources%5B0%5D.current.sourceText%2C%27the%20actual%20SCC%20frontend%20is%20not%20assigned%20the%20old8d%20definition%27%29%3B%0A%20%20for%28const%20row%20of%20current.sources%29%7B%0A%20%20%20%20assert.equal%28row.current.sourceText%2Cread%28row.file%29.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20assert.deepEqual%28pinCurrentRawPredecessorSource%28read%28row.file%29%29%2C%7Bbytes%3Arow.current.bytes%2Csha256%3Arow.current.sha256%7D%29%3B%0A%20%20%7D%0A%20%20verifyCurrentOwnCodebaseRawDescriptorRefresh%28current%29%3B%0A%20%20%2F%2F%20Public%20readers%20retain%20their%20exact%20installed%20packet%20digest.%20The%20separate%0A%20%20%2F%2F%20historical%20packet%20cannot%20be%20substituted%2C%20even%20though%20all%20its%20proofs%20pass.%0A%20%20assert.throws%28%28%29%3D%3EverifyCurrentOwnCodebaseRawDescriptorPacket%28old%29%2Cassert.AssertionError%29%3B%0A%20%20const%20changed%3DstructuredClone%28current%29%3Bchanged.sources%5B0%5D.current.sourceText%2B%3D%27%5Cn%27%3B%0A%20%20assert.throws%28%28%29%3D%3EverifyCurrentOwnCodebaseRawDescriptorRefresh%28changed%29%2Cassert.AssertionError%29%3B%0A%20%20const%20boundary%3DstructuredClone%28current%29%3Bboundary.boundary%2B%3D%27changed%20scope%27%3B%0A%20%20assert.throws%28%28%29%3D%3EverifyCurrentOwnCodebaseRawDescriptorRefresh%28boundary%29%2Cassert.AssertionError%29%3B%0A%7D%29%3B%0A%0Atest%28%27forged%20archive%20membership%20output%20revisions%20coherent%20pins%20and%20source-owner%20substitutions%20cannot%20authenticate%27%2C%28%29%3D%3E%7B%0A%20%20const%20mutations%3D%5B%0A%20%20%20%20history%3D%3E%7Bhistory.revision%3D%270%27.repeat%2840%29%3B%7D%2Chistory%3D%3E%7Bhistory.archive.path%3D%27unregistered.lino%27%3B%7D%2C%0A%20%20%20%20history%3D%3E%7Bhistory.archive.sha256%3D%270%27.repeat%2864%29%3B%7D%2Chistory%3D%3E%7Bhistory.archive.certificate.path%3D%27unregistered.lino%27%3B%7D%2C%0A%20%20%20%20history%3D%3E%7Bhistory.outputs.reverse%28%29%3B%7D%2Chistory%3D%3E%7Bhistory.sources.reverse%28%29%3B%7D%2C%0A%20%20%20%20history%3D%3E%7Bhistory.outputs%5B0%5D.certificate.revision%3D%270%27.repeat%2840%29%3B%7D%2C%0A%20%20%20%20history%3D%3E%7Bhistory.outputs%5B1%5D.bytes%2B%3D1%3Bhistory.outputs%5B1%5D.sha256%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%20%20history%3D%3E%7Bhistory.sources%5B0%5D.certificate.path%3Dhistory.sources%5B1%5D.file%3B%7D%2C%0A%20%20%20%20history%3D%3E%7Bhistory.additionalOutputs%3D%5B%27unregistered.lino%27%5D%3B%7D%2C%0A%20%20%5D%3B%0A%20%20const%20archive%3Dread%28CURRENT_RAW_PREDECESSOR_ARCHIVE%29%3B%0A%20%20for%28const%5Bindex%2Cmutate%5Dof%20mutations.entries%28%29%29%7B%0A%20%20%20%20const%20history%3DreadCurrentRawPredecessorHistory%28%29%3Bmutate%28history%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EverifyCurrentRawPredecessorHistory%28history%2Carchive%29%2Cassert.AssertionError%2C%27tamper%20%27%2Bindex%29%3B%0A%20%20%7D%0A%20%20assert.throws%28%28%29%3D%3EverifyCurrentRawPredecessorHistory%28readCurrentRawPredecessorHistory%28%29%2CBuffer.concat%28%5Barchive%2CBuffer.from%28%27%5Cn%27%29%5D%29%29%2Cassert.AssertionError%29%3B%0A%7D%29%3B%0A%0Atest%28%27compact%20historical%20memberships%20survive%20both%20Links%20codecs%20without%20duplicating%20the%20large%20archived%20packet%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DreadCurrentRawPredecessorHistory%28%29%2Csaved%3DencodeStructuredDataLinks%28history%29%3B%0A%20%20const%20canonical%3DLinkNetwork.fromLino%28saved.network.toLino%28%29%29%3B%0A%20%20for%28const%20network%20of%20%5Bcanonical%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28canonical%29%29%5D%29%7B%0A%20%20%20%20const%20restored%3DdecodeStructuredDataLinks%28network%2Csaved.root%29%3Bassert.deepEqual%28restored%2Chistory%29%3B%0A%20%20%20%20assert.deepEqual%28verifyCurrentRawPredecessorHistory%28restored%29.packet.edge%2CreadCurrentRawPredecessorPacket%28%29.edge%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27both%20normal%20authors%20remain%20repeatable%20without%20overwriting%20any%20prior%20packet%20receipt%20native%20definition%20or%20runtime%20source%27%2C%28%29%3D%3E%7B%0A%20%20const%20policy%3DreadCurrentOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20const%20paths%3D%5Bpolicy.output%2CCURRENT_RAW_PREDECESSOR_ARCHIVE%2Cpolicy.artifactFile%2Cpolicy.registerFile%2Cpolicy.loanFile%2C...policy.sourcePaths%5D%3B%0A%20%20const%20before%3Dpaths.map%28read%29%3B%0A%20%20assert.deepEqual%28generateCurrentRawPredecessorHistory%28%7Bcheck%3Atrue%7D%29%2CreadCurrentRawPredecessorHistory%28%29%29%3B%0A%20%20assert.deepEqual%28generateCurrentOwnCodebaseRawSourceDescriptors%28%7Bcheck%3Atrue%7D%29%2CreadCurrentOwnCodebaseRawDescriptorPacket%28%29%29%3B%0A%20%20paths.forEach%28%28file%2Cindex%29%3D%3Eassert.deepEqual%28read%28file%29%2Cbefore%5Bindex%5D%2Cfile%29%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
