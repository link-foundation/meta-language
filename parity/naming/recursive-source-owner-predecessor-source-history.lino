_with%28%22function%20caller%22%29%29%0A%20%20%20%20%20%20%20%20.expect%28%22the%20caller%20is%20an%20item%22%29%3B%0A%20%20%20%20assert_eq%21%28caller.reason%2C%20None%29%3B%0A%20%20%20%20let%20rust%20%3D%20emitted_rust%28%26translation%29%3B%0A%20%20%20%20for%20definition%20in%20%5B%0A%20%20%20%20%20%20%20%20%22pub%20fn%20opaque%28x%3A%20f64%29%20-%3E%20Option%3Cf64%3E%22%2C%0A%20%20%20%20%20%20%20%20%22pub%20fn%20caller%28x%3A%20f64%29%20-%3E%20f64%22%2C%0A%20%20%20%20%20%20%20%20%22crate%3A%3Aopaque%28x%29%22%2C%0A%20%20%20%20%20%20%20%20%22pub%20fn%20is_even%28%22%2C%0A%20%20%20%20%20%20%20%20%22pub%20fn%20is_odd%28%22%2C%0A%20%20%20%20%5D%20%7B%0A%20%20%20%20%20%20%20%20assert%21%28rust.contains%28definition%29%2C%20%22%7Bdefinition%7D%3A%20%7Brust%7D%22%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20let%20restored%20%3D%20self_translate%28%26translation.code%2C%20%22Rust%22%2C%20%22JavaScript%22%29.expect%28%22restores%22%29%3B%0A%20%20%20%20assert_eq%21%28restored.code%2C%20source%29%3B%0A%0A%20%20%20%20let%20unsupported%20%3D%20%22%2F%2A%2A%20%40param%20%7Bnumber%7D%20x%20%40returns%20%7Bnumber%7D%20%2A%2F%5Cnfunction%20opaqueRegex%28x%29%20%7B%20return%20%2F.%2Fu.test%28String%28x%29%29%20%3F%20x%20%3A%200%3B%20%7D%5Cn%2F%2A%2A%20%40param%20%7Bnumber%7D%20x%20%40returns%20%7Bnumber%7D%20%2A%2F%5Cnfunction%20regexCaller%28x%29%20%7B%20return%20opaqueRegex%28x%29%20%2B%201%3B%20%7D%5Cn%22%3B%0A%20%20%20%20let%20carried%20%3D%0A%20%20%20%20%20%20%20%20self_translate%28unsupported%2C%20%22JavaScript%22%2C%20%22Rust%22%29.expect%28%22carries%20unsupported%20siblings%22%29%3B%0A%20%20%20%20for%20needle%20in%20%5B%22function%20opaqueRegex%22%2C%20%22function%20regexCaller%22%5D%20%7B%0A%20%20%20%20%20%20%20%20assert_eq%21%28%0A%20%20%20%20%20%20%20%20%20%20%20%20status_of%28%26carried%2C%20unsupported%2C%20needle%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20%22carried%22%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20%22%7Bneedle%7D%22%0A%20%20%20%20%20%20%20%20%29%3B%0A%20%20%2