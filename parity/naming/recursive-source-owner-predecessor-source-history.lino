(36048: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20current-source%20views%20for%20the%20existing%20relative-array%20historical%20readers.%0A%2F%2F%20These%20source%20identities%20do%20not%20replace%20current%20parsing%2C%20emission%20or%20native%20gates.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadBootstrapStructuredDataLino%7D%20from%20%27..%2F..%2Fscripts%2Flib%2Fstructured-data-bootstrap.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BrestoreCurrentOwnCodebaseRawSource%7D%20from%20%27.%2Fcurrent-own-codebase-raw-source-descriptors.mjs%27%3B%0Aimport%20%7BrestoreReviewedOverlayProviderModuleSource%7D%20from%20%27..%2F..%2Fexperiments%2Frust-text-certificate-adapter%2Fprovider-succession.mjs%27%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aexport%20const%20RELATIVE_ARRAY_CURRENT_SOURCE_PROFILE%3D%27relative%20array%27%3B%0Aexport%20const%20RELATIVE_ARRAY_OWNED_RULE_SOURCE%3D%27js%2Fsrc%2Ftranslation%2Fowned-array-append-rules.js%27%3B%0Aexport%20const%20RELATIVE_ARRAY_OWNED_RULE_REVISION%3D%278d77e476d097448eb381ebe03e2aa173402bc03d%27%3B%0Aexport%20const%20RELATIVE_ARRAY_OWNED_RULE_OUTPUT%3D%27parity%2Fself-translation%2Frelative-array-owned-rule-source-history.lino%27%3B%0Aexport%20const%20RELATIVE_ARRAY_OWNED_RULE_PREVIOUS%3DObject.freeze%28%7Bbytes%3A4830%2Csha256%3A%27eb349133f29d2e5944ace3b96975d508a92d265231518ac2b99a604129c7b48a%27%7D%29%3B%0Aexport%20const%20RELATIVE_ARRAY_OWNED_RULE_CURRENT%3DObject.freeze%28%7Bbytes%3A5765%2Csha256%3A%27b367a8b068e4f59c26eaba8b7f8a8c5c039b01922aaf93bd0c312accce7fc5f3%27%7D%29%3B%0Aexport%20const%20RELATIVE_ARRAY_OWNED_RULE_BOUNDARY%3D%27One%20complete%20certified8d%20owned-array-rule%20source%20and%20its%20exact%20current%20UTF-8%20source%20are%20retained.%20The%20finite%20source%20inverse%20is%20available%20only%20to%20the%20relative-array%20historical%20profile.%20Both%20earlier%20rule%20behavior%20and%20current%20expanded%20iteration%2Fself-slice%20behavior%20require%20their%20own%20semantic%20tests.%20No%20native%20body%2C%20descriptor%20gate%2C%20source%20fixture%20or%20previous%20history%20packet%20is%20rewritten.%27%3B%0Aconst%20packetSha256%3D%274be14bb53c2111ac4963f37b37ac0b65e0a06f79c226ea84eee2f77a265fc029%27%3B%0Alet%20cached%3B%0Aexport%20const%20pinRelativeArrayCurrentSource%3Dsource%3D%3E%28%7Bbytes%3ABuffer.byteLength%28source%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20keys%3D%28value%2Cnames%29%3D%3E%7Bassert.ok%28value%26%26typeof%20value%3D%3D%3D%27object%27%26%26%21Array.isArray%28value%29%29%3Bassert.deepEqual%28Object.keys%28value%29.sort%28%29%2C%5B...names%5D.sort%28%29%29%3B%7D%3B%0A%0Aexport%20function%20deriveRelativeArrayOwnedRuleSourceIntervals%28previous%2Ccurrent%29%7B%0A%20%20assert.equal%28Buffer.from%28previous%29.toString%28%27utf8%27%29%2Cprevious%29%3Bassert.equal%28Buffer.from%28current%29.toString%28%27utf8%27%29%2Ccurrent%29%3B%0A%20%20const%20before%3D%5B...previous%5D%2Cafter%3D%5B...current%5D%3Blet%20start%3D0%2ColdEnd%3Dbefore.length%2Cend%3Dafter.length%3B%0A%20%20while%28start%3ColdEnd%26%26start%3Cend%26%26before%5Bstart%5D%3D%3D%3Dafter%5Bstart%5D%29start%2B%2B%3B%0A%20%20while%28oldEnd%3Estart%26%26end%3Estart%26%26before%5BoldEnd-1%5D%3D%3D%3Dafter%5Bend-1%5D%29%7BoldEnd--%3Bend--%3B%7D%0A%20%20return%5B%7Bstart%3Abefore.slice%280%2Cstart%29.join%28%27%27%29.length%2Cremoved%3Abefore.slice%28start%2ColdEnd%29.join%28%27%27%29%2Cinserted%3Aafter.slice%28start%2Cend%29.join%28%27%27%29%7D%5D%3B%0A%7D%0A%0Aexport%20function%20verifyRelativeArrayOwnedRuleSourceHistory%28packet%29%7B%0A%20%20keys%28packet%2C%5B%27schemaVersion%27%2C%27model%27%2C%27revision%27%2C%27source%27%2C%27previous%27%2C%27current%27%2C%27coordinateUnit%27%2C%27edits%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27relative%20array%20complete%20owned%20rule%20source%20history%201%27%29%3B%0A%20%20assert.equal%28packet.revision%2CRELATIVE_ARRAY_OWNED_RULE_REVISION%29%3Bassert.equal%28packet.source%2CRELATIVE_ARRAY_OWNED_RULE_SOURCE%29%3B%0A%20%20assert.equal%28packet.boundary%2CRELATIVE_ARRAY_OWNED_RULE_BOUNDARY%29%3Bassert.equal%28packet.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20keys%28packet.previous%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3Bkeys%28packet.current%2C%5B%27source%27%2C%27bytes%27%2C%27sha256%27%5D%29%3B%0A%20%20for%28const%5Bside%2Cexpected%5Dof%20%5B%5B%27previous%27%2CRELATIVE_ARRAY_OWNED_RULE_PREVIOUS%5D%2C%5B%27current%27%2CRELATIVE_ARRAY_OWNED_RULE_CURRENT%5D%5D%29%7B%0A%20%20%20%20const%20row%3Dpacket%5Bside%5D%3Bassert.equal%28typeof%20row.source%2C%27string%27%29%3Bassert.deepEqual%28pinRelativeArrayCurrentSource%28row.source%29%2Cexpected%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%2Cexpected%29%3B%0A%20%20%7D%0A%20%20verifyGitArtifactCertificate%28packet.previous.certificate%2CBuffer.from%28packet.previous.source%29%2C%7Brevision%3Apacket.revision%2Cpath%3Apacket.source%7D%29%3B%0A%20%20assert.equal%28packet.current.source%2CreadFileSync%28new%20URL%28packet.source%2Croot%29%2C%27utf8%27%29%2C%27the%20complete%20current%20owned-rule%20source%20stays%20separately%20bound%20to%20the%20filesystem%27%29%3B%0A%20%20assert.deepEqual%28packet.edits%2CderiveRelativeArrayOwnedRuleSourceIntervals%28packet.previous.source%2Cpacket.current.source%29%29%3B%0A%20%20let%20current%3Dpacket.previous.source%3B%0A%20%20for%28const%20edit%20of%20packet.edits%29%7B%0A%20%20%20%20keys%28edit%2C%5B%27start%27%2C%27removed%27%2C%27inserted%27%5D%29%3Bassert.ok%28Number.isSafeInteger%28edit.start%29%26%26edit.start%3E%3D0%26%26edit.start%3C%3Dcurrent.length%29%3B%0A%20%20%20%20assert.equal%28current.slice%28edit.start%2Cedit.start%2Bedit.removed.length%29%2Cedit.removed%29%3B%0A%20%20%20%20current%3Dcurrent.slice%280%2Cedit.start%29%2Bedit.inserted%2Bcurrent.slice%28edit.start%2Bedit.removed.length%29%3B%0A%20%20%7D%0A%20%20assert.equal%28current%2Cpacket.current.source%29%3B%0A%20%20for%28const%20edit%20of%20packet.edits.toReversed%28%29%29%7B%0A%20%20%20%20assert.equal%28current.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20current%3Dcurrent.slice%280%2Cedit.start%29%2Bedit.removed%2Bcurrent.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%7D%0A%20%20assert.equal%28current%2Cpacket.previous.source%2C%27every%20complete%20certified%20predecessor%20byte%20survives%27%29%3Breturn%20packet%3B%0A%7D%0A%0Aexport%20function%20readRelativeArrayOwnedRuleSourceHistory%28%29%7B%0A%20%20if%28%21cached%29%7B%0A%20%20%20%20assert.match%28packetSha256%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%2C%27only%20a%20normally%20captured%2C%20independently%20pinned%20source%20packet%20is%20readable%27%29%3B%0A%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28RELATIVE_ARRAY_OWNED_RULE_OUTPUT%2Croot%29%29%3Bassert.equal%28pinRelativeArrayCurrentSource%28source%29.sha256%2CpacketSha256%29%3B%0A%20%20%20%20cached%3DverifyRelativeArrayOwnedRuleSourceHistory%28readBootstrapStructuredDataLino%28source.toString%28%27utf8%27%29%29%29%3B%0A%20%20%7D%0A%20%20assert.equal%28readFileSync%28new%20URL%28RELATIVE_ARRAY_OWNED_RULE_SOURCE%2Croot%29%2C%27utf8%27%29%2Ccached.current.source%29%3B%0A%20%20return%20structuredClone%28cached%29%3B%0A%7D%0A%0A%2F%2A%2A%20Other%20profiles%20and%20files%20are%20identities%3B%20unknown%20selected%20bytes%20stay%20visible%0A%20%2A%20to%20the%20original%20descriptor%2Ffreshness%20guards%20rather%20than%20gaining%20an%20old%20owner.%20%2A%2F%0Aexport%20function%20restoreRelativeArrayCurrentSourceView%28source%2Cfile%2Cprofile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bassert.equal%28typeof%20profile%2C%27string%27%29%3B%0A%20%20if%28profile%21%3D%3DRELATIVE_ARRAY_CURRENT_SOURCE_PROFILE%29return%20source%3B%0A%20%20if%28file%3D%3D%3D%27js%2Fsrc%2Ftranslation%2Femit-javascript.js%27%29return%20restoreReviewedOverlayProviderModuleSource%28source%2Cfile%29%3B%0A%20%20if%28file%3D%3D%3D%27js%2Fsrc%2Ftyped-program-link-rules.js%27%29return%20restoreCurrentOwnCodebaseRawSource%28source%2Cfile%2Ctrue%29%3B%0A%20%20if%28file%21%3D%3DRELATIVE_ARRAY_OWNED_RULE_SOURCE%29return%20source%3B%0A%20%20const%20packet%3DreadRelativeArrayOwnedRuleSourceHistory%28%29%3B%0A%20%20return%20source%3D%3D%3Dpacket.current.source%3Fpacket.previous.source%3Asource%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
