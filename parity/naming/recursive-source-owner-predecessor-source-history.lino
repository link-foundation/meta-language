eClosure.removedImports.length%2C1%29%3B%0A%20assert.equal%28collectionSource.split%28collectionPolicy.sourceClosure.removedImports%5B0%5D%29.length%2C2%29%3B%0A%20assert.equal%28collectionPolicy.sourceClosure.source%2CcollectionPolicy.sourceClosure.inputs%5B0%5D.source%2B%27%5Cn%27%2BcollectionSource.replace%28collectionPolicy.sourceClosure.removedImports%5B0%5D%2C%27%27%29%29%3B%0A%20const%20sourceSurface%3DparseJavaScript%28collectionPolicy.sourceClosure.source%2C%7BreferenceSemantics%3Afalse%7D%29%3B%0A%20const%20sourceInventory%3DsourceSurface.items.map%28%28item%2Cordinal%29%3D%3E%28%7Bordinal%2Ckind%3Aitem.k%2Cname%3Aitem.name%2Cgenerated%3Aitem.generated%3D%3D%3Dtrue%7D%29%29%3B%0A%20assert.deepEqual%28sourceInventory.filter%28item%3D%3E%21item.generated%29.map%28item%3D%3E%5Bitem.kind%2Citem.name%5D%29%2C%5B%0A%20%20%5B%27fn%27%2C%27refuseRequiredNumberFact%27%5D%2C%5B%27fn%27%2C%27refuseRequiredTextFact%27%5D%2C%5B%27fn%27%2C%27refuseRequiredBooleanFact%27%5D%2C%0A%20%20%5B%27fn%27%2C%27readRequiredNumberFact%27%5D%2C%5B%27fn%27%2C%27readRequiredTextFact%27%5D%2C%5B%27fn%27%2C%27readRequiredBooleanFact%27%5D%2C%0A%20%20%5B%27fn%27%2C%27readCollectionConstructionField%27%5D%2C%5B%27fn%27%2C%27readCollectionConstructionElement%27%5D%2C%5B%27fn%27%2C%27readCollectionConstructionKind%27%5D%2C%0A%20%20%5B%27fn%27%2C%27planCollectionConstructionInference%27%5D%2C%5B%27fn%27%2C%27planCollectionConstructionChecked%27%5D%2C%5B%27fn%27%2C%27readCollectionConstructionKeyAdmission%27%5D%2C%0A%20%20%5B%27fn%27%2C%27readCollectionConstructionDiagnostic%27%5D%2C%5B%27fn%27%2C%27readCollectionConstructionBinding%27%5D%2C%0A%20%20%5B%27fn%27%2C%27renderCollectionConstructionType%27%5D%2C%5B%27fn%27%2C%27renderCollectionConstruction%27%5D%2C%0A%20%5D%2C%27all%20ten%20construction%20definitions%2C%20three%20required%20readers%20and%20three%20private%20refusal%20helpers%20retain%20their%20actual%20source%20owners%27%29%3B%0A%20assert.deepEqual%28sourceInventory.filter%28item%3D%3Eitem.generated%29.map%28item%3D%3E%5Bitem.kind%2Citem.name%5D%29%2C%5B%0A%20%20%5B%27data%27%2C%27ml_readCollectionConstructionField_loop1_result%27%5D%2C%5B%27fn%27%2C%27ml_readCollectionConstructionField_loop1%27%5D%2C%0A%20%5D%2C%27both%20actual%20generated%20data%2Ffunction%20owners%20remain%20represented%27%29%3B%0A%20const%20artifact%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fself-translation%2Fcollection-construction-rules-native.lino%27%2Cimport.meta.url%29%29%3B%0A%20assert.deepEqual%28artifact.sourceClosure%2CcollectionPolicy.sourceClosure%29%3B%0A%20assert.deepEqual%28artifact.inventory%2CsourceInventory%29%3B%0A%20assert.deepEqual%28artifact.checkedNamedSourceInventory.map%28%28%7Bordinal%2Ckind%2Cname%2Cgenerated%7D%29%3D%3E%28%7Bordinal%2Ckind%2Cname%2Cgenerated%7D%29%29%2CsourceInventory%29%3B%0A%20for%28const%20replay%20of%20artifact.replays%29assert.deepEqual%28replay.checkedNamedSourceInventory%2Cartifact.checkedNamedSourceInventory%29%3B%0A%20const%20replacements%3D%7B%0A%20%20%27translation%2Femit-javascript.js%27%3A%20%7Boriginal%3Abranches.JavaScript%2Ccurrent%3A%22%20%20%20%20%20%20case%20%27set%27%3A%5Cn%20%20%20%20%20%20case%20%27map%27%3A%5Cn%20%20%20%20%20%20%20%20return%20renderCollectionConstruction%28%27JavaScript%27%2C%20e.k%2C%20%27%27%2C%20this.expr%28e.k%20%3D%3D%3D%20%27set%27%20%3F%20e.items%20%3A%20e.entries%29%2C%20%27%27%2C%20%27%27%2C%20%27%27%29%3B%5Cn%22%7D%2C%0A%20%20%27translation%2Femit-rust.js%27%3A%20%7Boriginal%3Abranches.Rust%2Ccurrent%3A%22%20%20%20%20%20%20case%20%27set%27%3A%5Cn%20%20%20%20%20%20case%20%27map%27%3A%20%7B%5Cn%20%20%20%20%20%20%20%20this.usesArray%20%3D%20true%3B%5Cn%20%20%20%20%20%20%20%20this.usesStandardArray%20%3D%20true%3B%5Cn%20%20%20%20%20%20%20%20const%20key%20%3D%20e.k%20%3D%3D%3D%20%27set%27%20%3F%20e.type.element%20%3A%20e.type.key%3B%5Cn%20%20%20%20%20%20%20%20const%20values%20%3D%20this.expr%28e.k%20%3D%3D%3D%20%27set%27%20%3F%20e.items%20%3A%20e.entries%29%3B%5Cn%20%20%20%20%20%20%20%20return%20renderCollectionConstruction%28%27Rust%27%2C%20e.k%2C%20key.kind%2C%20values%2C%20%27%27%2C%20%27%27%2C%20%27%27%29%3B%5Cn%20%20%20%20%20%20%7D%5Cn%22%7D%2C%0A%20%7D%3B%0A%20const%20changed%3D%5B%5D%2CsourceRoot%3Dnew%20URL%28%27..%2F..%2Fjs%2Fsrc%2F%27%2Cimport.meta.url%29%3B%0A%20for%28const%5Bindex%2Crow%5Dof%20current.providers.entries%28%29%29%7B%0A%20%20const%20source%3DreadFileSync%28new%20URL%28row.module%2CsourceRoot%29%2C%27utf8%27%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%2Crow.sourceSha256%29%3B%0A%20%20let%20restored%3Dsource%3B%0A%20%20if%28Object.hasOwn%28replacements%2Crow.module%29%29%7B%0A%20%20%20changed.push%28row.module%29%3B%0A%20%20%20const%20imported%3D%22import%20%7B%20renderCollectionConstruction%20%7D%20from%20%27.%2Fcollection-construction-rules.js%27%3B%5Cn%22%2Creplacement%3Dreplacements%5Brow.module%5D%3B%0A%20%20%20assert.equal%28restored.split%28imported%29.length%2C2%29%3Bassert.equal%28restored.split%28replacement.current%29.length%2C2%29%3B%0A%20%20%20restored%3Drestored.replace%28imported%2C%27%27%29.replace%28replacement.current%2Creplacement.original%29%3B%0A%20%20%7D%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28restored%29.digest%28%27hex%27%29%2Cprevious.providers%5Bindex%5D.sourceSha256%2C%0A%20%20%20row.module%2B%27%3A%20the%20exact%20contextual%20inverse%20restores%20the%20complete%20preceding%20source%27%29%3B%0A%20%7D%0A%20assert.deepEqual%28changed%2C%5B%27translation%2Femit-javascript.js%27%2C%27translation%2Femit-rust.js%27%5D%29%3B%0A%20for%28const%20historical%20of%20reviewedOverlayProviderPolicy.historicalOverlays%29%7B%0A%20%20const%20bytes%3DreadFileSync%28new%20URL%28%27..%2F%27%2Bhistorical.experiment%2B%27%2Fdata%2Foverlays.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%2Chistorical.sourceSha256%29%3B%0A%20%7D%0A%7D%29) (lang: meta-lan