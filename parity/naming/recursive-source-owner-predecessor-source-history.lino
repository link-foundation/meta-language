ition%20%40returns%20%7Bboolean%7D%0A%20%2A%2F%0Aexport%20function%20acceptOwnedArrayAppendUses%28allocationLoops%2C%20appendLoops%2C%20escapeLoops%2C%20escapeStarts%2C%20escapeCounts%2C%20escapePositions%2C%20position%29%20%7B%0A%20%20for%20%28let%20escape%20%3D%200%3B%20escape%20%3C%20escapePositions.length%3B%20escape%20%2B%3D%201%29%20%7B%0A%20%20%20%20if%20%28readRequiredNumberFact%28escapePositions%2C%20escape%29%20%3C%20position%29%20return%20false%3B%0A%20%20%20%20const%20start%20%3D%20readRequiredNumberFact%28escapeStarts%2C%20escape%29%3B%0A%20%20%20%20const%20end%20%3D%20start%20%2B%20readRequiredNumberFact%28escapeCounts%2C%20escape%29%3B%0A%20%20%20%20for%20%28let%20edge%20%3D%20start%3B%20edge%20%3C%20end%3B%20edge%20%2B%3D%201%29%20%7B%0A%20%20%20%20%20%20const%20loop%20%3D%20readRequiredNumberFact%28escapeLoops%2C%20edge%29%3B%0A%20%20%20%20%20%20let%20appendInside%20%3D%20false%3B%0A%20%20%20%20%20%20let%20allocationInside%20%3D%20false%3B%0A%20%20%20%20%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20appendLoops.length%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20%20%20%20%20if%20%28readRequiredNumberFact%28appendLoops%2C%20index%29%20%3D%3D%3D%20loop%29%20appendInside%20%3D%20true%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20allocationLoops.length%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20%20%20%20%20if%20%28readRequiredNumberFact%28allocationLoops%2C%20index%29%20%3D%3D%3D%20loop%29%20allocationInside%20%3D%20true%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20if%20%28appendInside%20%26%26%20%21allocationInside%29%20return%20false%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20return%20true%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20A%20complete%20RHS%20read%20walk%20must%20still%20record%20every%20actual%20unsafe%20use%20before%0A%20%2A%20this%20shape%20can%20omit%20the%20assignment%20escape.%20Existing%20escapes%20are%20retained.%0A%20%2A%20This%20decision%20never%20creates%20an%20owner%20or%20blesses%20a%20parameter%2Fforeign%20array.%0A%20%2A%20%40param%20%7Bstring%7D%20expression%20%40param%20%7Bstring%7D%20operation%20%40param%20%7Bstring%7D%20receiver%0A%20%2A%20%40param%20%7Bnumber%7D%20pathLength%20%40param%20%7Bboolean%7D%20sameOwner%0A%20%2A%20%40param%20%7Bnumber%7D%20argumentsCount%20%40returns%20%7Bboolean%7D%0A%20%2A%2F%0Aexport%20function%20acceptOwnedArraySelfSliceRebinding%28expression%2C%20operation%2C%20receiver%2C%20pathLength%2C%20sameOwner%2C%20argumentsCount%29%20%7B%0A%20%20if%20%28expression%20%3D%3D%3D%20%27copySlice%27%29%20return%20operation%20%3D%3D%3D%20%27%27%20%26%26%20receiver%20%3D%3D%3D%20%27name%27%0A%20%20%20%20%26%26%20pathLength%20%3D%3D%3D%201%20%26%26%20sameOwner%20%26%26%20argumentsCount%20%3D%3D%3D%200%3B%0A%20%20return%20expression%20%3D%3D%3D%20%27method%27%20%26%26%20operation%20%3D%3D%3D%20%27slice%27%20%26%26%20receiver%20%3D%3D%3D%20%27name%27%0A%20%20%20%20%26%26%20pathLength%20%3D%3D%3D%201%20%26%26%20sameOwner%0A%20%20%20%20%26%26%20%28argumentsCount%20%3D%3D%3D%200%20%7C%7C%20argumentsCount%20%3D%3D%3D%201%20%7C%7C%20argumentsCount%20%3D%3D%3D%202%29%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20A%20consuming%20array%20use%20may%20move%20its%20actual%20lexical%20value%20only%20when%20no%0A%20%2A%20reachable%20continuation%20reads%20that%20same%20binding.%20Edges%20describe%20evaluation%0A%20%2A%20order%3B%20alternatives%20join%20their%20actual%20continuation%20rather%20than%20each%20other.%0A%20%2A%20%40param%20%7Bnumber%7D%20position%20%40param%20%7Bnumber%5B%5D%7D%20bindings%20%40param%20%7Bnumber%5B%5D%7D%20starts%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20counts%20%40param%20%7Bnumber%5B%5D%7D%20successors%20%40returns%20%7Bboolean%7D%0A%20%2A%2F%0Aexport%20function%20acceptOwnedArrayFinalUse%28position%2C%20bindings%2C%20starts%2C%20counts%2C%20successors%29%20%7B%0A%20%20const%20binding%20%3D%20readRequiredNumberFact%28bindings%2C%20position%29%3B%0A%20%20const%20pending%20%3D%20%5B%5D%3B%0A%20%20const%20see