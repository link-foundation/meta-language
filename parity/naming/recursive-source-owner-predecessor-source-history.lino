let%20current%3Dpacket.previous.source%3B%0A%20%20for%28const%20edit%20of%20packet.edits%29%7B%0A%20%20%20%20keys%28edit%2C%5B%27start%27%2C%27removed%27%2C%27inserted%27%5D%29%3Bassert.ok%28Number.isSafeInteger%28edit.start%29%26%26edit.start%3E%3D0%26%26edit.start%3C%3Dcurrent.length%29%3B%0A%20%20%20%20assert.equal%28current.slice%28edit.start%2Cedit.start%2Bedit.removed.length%29%2Cedit.removed%29%3B%0A%20%20%20%20current%3Dcurrent.slice%280%2Cedit.start%29%2Bedit.inserted%2Bcurrent.slice%28edit.start%2Bedit.removed.length%29%3B%0A%20%20%7D%0A%20%20assert.equal%28current%2Cpacket.current.source%29%3B%0A%20%20for%28const%20edit%20of%20packet.edits.toReversed%28%29%29%7B%0A%20%20%20%20assert.equal%28current.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20current%3Dcurrent.slice%280%2Cedit.start%29%2Bedit.removed%2Bcurrent.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%7D%0A%20%20assert.equal%28current%2Cpacket.previous.source%2C%27every%20complete%20certified%20predecessor%20byte%20survives%27%29%3Breturn%20packet%3B%0A%7D) (lang: meta-language%20structured%20data)))
