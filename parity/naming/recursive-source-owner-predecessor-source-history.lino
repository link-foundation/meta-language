emittedOwners%5Bindex%5D.header%2CcopyOwners%5Bindex%5D.header%2C%27unchanged%20complete%20owner%20ABI%3A%20%27%2Bowner.fullName%29%3B%0A%20%20%20%20return%20%7B...owner%2Ccopy%3AcopyOwners%5Bindex%5D%2Cconsuming%3AemittedOwners%5Bindex%5D%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20observedTotals%20%3D%20%7Bcopy%3Atotals%28copyOwners%29%2Cconsuming%3Atotals%28emittedOwners%29%7D%3B%0A%20%20assert.ok%28observedTotals.consuming.cloneCalls%20%3C%20observedTotals.copy.cloneCalls%2C%0A%20%20%20%20%27the%20selected%20option%20removes%20actual%20clone%20calls%20rather%20than%20only%20declaring%20a%20profile%27%29%3B%0A%20%20assert.equal%28observedTotals.consuming.appendCalls%2CobservedTotals.copy.appendCalls%29%3B%0A%20%20const%20%7BencodeTypedProgramLinks%2CdecodeTypedProgramLinks%7D%20%3D%20await%20import%28%27..%2F..%2Fjs%2Fsrc%2Ftyped-program-links.js%27%29%3B%0A%20%20const%20%7BrecheckLinkedTypedProgram%7D%20%3D%20await%20import%28%27..%2F..%2Fjs%2Fsrc%2Ftyped-program-checked-projection.js%27%29%3B%0A%20%20const%20%7BLinkNetwork%7D%20%3D%20await%20import%28%27..%2F..%2Fjs%2Fsrc%2Fnetwork.js%27%29%3B%0A%20%20const%20%7BencodeLinkNetworkBinary%2CdecodeLinkNetworkBinary%7D%20%3D%20await%20import%28%27..%2F..%2Fjs%2Fsrc%2Flink-network-binary.js%27%29%3B%0A%20%20const%20packet%20%3D%20encodeTypedProgramLinks%28program%29%2C%20recordCount%20%3D%20packet.network.links%28%29.length%3B%0A%20%20assert.ok%28Number.isSafeInteger%28recordCount%29%26%26recordCount%3E0%26%26recordCount%3C%3DmaximumRecords%29%3B%0A%20%20const%20binaryLimits%20%3D%20%7BrecordLimit%3ArecordCount%2CbyteLimit%3AmaximumArchiveBytes%7D%3B%0A%20%20const%20text%20%3D%20packet.network.toLino%28%29%3Bassert.ok%28Buffer.byteLength%28text%29%3C%3DmaximumArchiveBytes%29%3B%0A%20%20const%20binary%20%3D%20encodeLinkNetworkBinary%28packet.network%2CbinaryLimits%29%3Bassert.ok%28binary.byteLength%3C%3DmaximumArchiveBytes%29%3B%0A%20%20const%20replays%20%3D%20%5B%5D%3B%0A%20%20for%28const%20format%20of%20%5B%27text%27%2C%27binary%27%5D%29%20%7B%0A%20%20%20%20const%20network%20%3D%20format%3D%3D%3D%27text%27%20%3F%20LinkNetwork.fromLino%28text%29%20%3A%20decodeLinkNetworkBinary%28binary%2CbinaryLimits%29%3B%0A%20%20%20%20assert.equal%28network.links%28%29.length%2CrecordCount%2C%27every%20actual%20archive%20record%20survives%20%27%2Bformat%29%3B%0A%20%20%20%20const%20restored%20%3D%20recheckLinkedTypedProgram%28decodeTypedProgramLinks%28network%2Cpacket.root%29%2C%7BwholeProgram%3Atrue%7D%29%3B%0A%20%20%20%20assert.deepEqual%28restored.items.map%28row%3D%3Erow.fullName%29%2Cprogram.items.map%28row%3D%3Erow.fullName%29%29%3B%0A%20%20%20%20assert.deepEqual%28%5B...restored.declarations.keys%28%29%5D%2C%5B...program.declarations.keys%28%29%5D%29%3B%0A%20%20%20%20const%20replay%20%3D%20emitRust%28restored%2C%7BarrayConsumption%3Atrue%7D%29%3B%0A%20%20%20%20for%28const%20field%20of%20%5B%27text%27%2C%27definitions%27%2C%27preludes%27%2C%27mappings%27%2C%27assumptions%27%2C%27encodings%27%5D%29%20assert.deepEqual%28replay%5Bfield%5D%2Cemitted%5Bfield%5D%2C%0A%20%20%20%20%20%20%27complete%20source-free%20%27%2Bfield%2B%27%20agrees%20after%20%27%2Bformat%29%3B%0A%20%20%20%20assert.deepEqual%28consumingOwners%28replay%2Cinventory%29%2CemittedOwners%29%3B%0A%20%20%20%20replays.push%28%7Bformat%2CownerCount%3Arestored.declarations.size%2CemittedBytes%3ABuffer.byteLength%28replay.text%29%2CemittedSha256%3Asha256%28replay.text%29%7D%29%3B%0A%20%20%7D%0A%20%20const%20artifact%20%3D%20%7Bversion%3A1%2Cmodel%3Aprepared.currentArtifact.model%2Cprofile%3A%27consuming%27%2Coptions%3A%7BarrayConsumption%3Atrue%7D%2C%0A%20%20%20%20source%3A%7Bpath%3A%27experiments%2Foriginal-link-complete-table-projection%2Fraw-rules.mjs%27%2C%0A%20%20%20%20%20%20bytes%3ABuffer.byteLength%28prepared.source%29%2Csha256%3Asha256%28prepared.source%29%7D%2C%0A%20%20%20%20predecessor%2CdecisionSources%3AdecisionSources%28readFileSync%29%2CdefinitionCount%3A106%2C%0A%20%20%20%20javaScriptSha256%3Asha256%28emitJavaScript%28program%29.text%29%2C%0A%20%20%20%20declarationNames%3A%5B...predecessor.declarationNames%5D%2Cowners%2Ctotals%3AobservedTotals%2C%0A%20%20%20%20assumptions%3Aemitted.assumptions%2Cencodings%3Aemitted.encodings%2Cmappings%3Aemitted.mappings%2C%0A%20%20%20%20preludeHashes%3Aemitted.preludes.map%28source%3D%3E%28%7Bbytes%3ABuffer.byteLength%28source%29%2Csha256%3Asha256%28source%29%7D%29%29%2C%0A%20%20%20%20archive%3A%7Broot%3Apacket.root.asU64%28%29.toString%28%29%2CrecordCount%2CmaximumRecords%2CbinaryLimits%2C%0A%20%20%20%20%20%20textBytes%3ABuffer.byteLength%28text%29%2CtextSha256%3Asha256%28text%29%2CbinaryBytes%3Abinary.byteLength%2CbinarySha256%3Asha256%28binary%29%7D%2C%0A%20%20%20%20replays%2CsourceBytes%3ABuffer.byteLength%28emitted.text%29%2CsourceSha256%3Asha256%28emitted.text%29%2CcompleteRust%3Aemitted.text%2C%0A%20%20%20%20nativeCompilation%3Afalse%2CnativeExecution%3Afalse%2C%0A%20%20%20%20boundary%3A%27Whole%20checked%20source%2C%20all106owners%20and%20both%20complete%20source-free%20typed%20archives.%20Tokenized%20clone%2Fappend%20sites%20observe%20emitted%20syntax%20only%3B%20the%20existing%20emitter%20performs%20its%20actual%20checked%20final-use%20decisions.%20No%20internal%20proof-node%20inventory%2C%20native%20timing%20or%20completion%20claim.%27%2C%0A%20%20%20%20predecessorConservation%3AstructuredClone%28ORIGINAL_LINK_RAW_CONSUMING_SUCCESSOR%29%7D%3B%0A%20%20verifyOriginalLinkRawConsumingConservation%28artifact%29%3B%0A%20%20if%28check%29checkProjectData%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%2Cartifact%29%3B%0A%20%20return%20%7Bartifact%2Crust%3Aemitted%2Cprofile%3A%7Bprofile%3A%27consuming%27%2CsourceBytes%3Aartifact.sourceBytes%2CsourceSha256%3Aartifact.sourceSha256%2C%0A%20%20%20%20historicalSourceSha256%3Apredecessor.historicalSourceSha256%2CcurrentSourceSha256%3Apredecessor.currentSourceSha256%2C%0A%20%20%20%20sourceArtifact%2CdeclarationNames%3Aartifact.declarationNames%2CdefinitionCount%3A106%2C%0A%20%20%20%20proof%3A%7BartifactSha256%3As