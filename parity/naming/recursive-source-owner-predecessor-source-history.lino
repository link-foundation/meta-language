e%3B%0A%20%20%7D%0A%20%20return%20true%3B%0A%7D%0A%0A%2F%2A%2A%20Iterative%20two-pass%20SCC%20partition.%20Each%20result%20is%20its%20component%27s%20least%0A%20%2A%20original%20node%20index.%20No%20recursion%2C%20matrix%2C%20source%20rewriting%20or%20callbacks.%0A%20%2A%20The%20reverse%20walk%20scans%20the%20retained%20edges%2C%20so%20memory%20is%20O%28V%2BE%29%2C%20and%20the%0A%20%2A%20simple%20immutable%20fact%20implementation%20takes%20O%28V%2A%28V%2BE%29%29%20comparisons.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20starts%20%40param%20%7Bnumber%5B%5D%7D%20counts%20%40param%20%7Bnumber%5B%5D%7D%20targets%0A%20%2A%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20readDeclarationDependencyComponents%28starts%2C%20counts%2C%20targets%29%20%7B%0A%20%20if%20%28%21acceptDeclarationDependencyFacts%28starts%2C%20counts%2C%20targets%29%29%20%7B%0A%20%20%20%20throw%20new%20RangeError%28%27invalid%20declaration%20dependency%20facts%27%29%3B%0A%20%20%7D%0A%20%20let%20visited%20%3D%20%5B%5D%3B%0A%20%20for%20%28let%20node%20%3D%200%3B%20node%20%3C%20starts.length%3B%20node%20%2B%3D%201%29%20visited.push%280%29%3B%0A%20%20let%20finished%20%3D%20%5B%5D%3B%0A%20%20for%20%28let%20root%20%3D%200%3B%20root%20%3C%20starts.length%3B%20root%20%2B%3D%201%29%20%7B%0A%20%20%20%20if%20%28readRequiredNumberFact%28visited%2C%20root%29%20%3D%3D%3D%201%29%20continue%3B%0A%20%20%20%20let%20pending%20%3D%20%5Broot%5D%3B%0A%20%20%20%20while%20%28pending.length%20%3E%200%29%20%7B%0A%20%20%20%20%20%20const%20instruction%20%3D%20readRequiredNumberFact%28pending%2C%20pending.length%20-%201%29%3B%0A%20%20%20%20%20%20pending%20%3D%20pending.slice%280%2C%20pending.length%20-%201%29%3B%0A%20%20%20%20%20%20if%20%28instruction%20%3C%200%29%20finished.push%28-instruction%20-%201%29%3B%0A%20%20%20%20%20%20else%20if%20%28readRequiredNumberFact%28visited%2C%20instruction%29%20%3D%3D%3D%200%29%20%7B%0A%20%20%20%20%20%20%20%20visited%20%3D%20visited.slice%280%2C%20instruction%29.concat%28%5B1%5D%2