(23: (meta: (t: semantic) (n: 1) (term: string%20value) (def: name%3A%20JavaScript%0A%0A%23%20.github%2Fworkflows%2Fci.yml%20calls%20this%20workflow%20on%20pushes%20to%20main%20and%20on%20pull%0A%23%20requests%2C%20before%20the%20Rust%20workflow%2C%20so%20the%20Rust%20jobs%20run%20only%20after%20the%0A%23%20JavaScript%20jobs%20pass.%20A%20release%20and%20a%20manual%20dispatch%20run%20it%20standalone%2C%20so%0A%23%20the%20npm%20trusted%20publisher%20stays%20this%20file.%0Aon%3A%0A%20%20workflow_call%3A%0A%20%20%20%20inputs%3A%0A%20%20%20%20%20%20external_reports%3A%0A%20%20%20%20%20%20%20%20description%3A%20%27The%20caller%20produces%20and%20validates%20the%20complete%20self-translation%20report%20artifacts%27%0A%20%20%20%20%20%20%20%20required%3A%20false%0A%20%20%20%20%20%20%20%20default%3A%20false%0A%20%20%20%20%20%20%20%20type%3A%20boolean%0A%20%20release%3A%0A%20%20%20%20types%3A%20%5Bpublished%5D%0A%20%20workflow_dispatch%3A%0A%20%20%20%20inputs%3A%0A%20%20%20%20%20%20release_version%3A%0A%20%20%20%20%20%20%20%20description%3A%20%27Expected%20package%20version%20%28optional%20safety%20check%29%27%0A%20%20%20%20%20%20%20%20required%3A%20false%0A%20%20%20%20%20%20%20%20type%3A%20string%0A%0Apermissions%3A%0A%20%20contents%3A%20read%0A%0A%23%20Pull%20request%20numbers%20identify%20update%20queues%2C%20including%20a%20late%20merged%20run.%0A%23%20Push%2C%20release%20and%20dispatch%20verification%20runs%20use%20their%20own%20run%20id%20in%20every%0A%23%20job%3B%20write%20jobs%20retain%20the%20shared%20release%20queue%20below.%20The%20group%20has%0A%23%20its%20own%20literal%20prefix%3A%20called%20from%20ci.yml%2C%20github.workflow%20names%20the%20caller%2C%0A%23%20and%20a%20group%20equal%20to%20the%20caller%27s%20would%20deadlock%20with%20it.%0Aconcurrency%3A%0A%20%20group%3A%20js-%24%7B%7B%20github.event_name%20%3D%3D%20%27pull_request%27%20%26%26%20format%28%27pull-%7B0%7D%27%2C%20github.event.pull_request.number%29%20%7C%7C%20github.run_id%20%7D%7D%0A%20%20cancel-in-progress%3A%20true%0A%0Aenv%3A%0A%20%20GIT_CONFIG_COUNT%3A%20%271%27%0A%20%20GIT_CONFIG_KEY_0%3A%20init.defaultBranch%0A%20%20GIT_CONFIG_VALUE_0%3A%20main%0A%0Ajobs%3A%0A%20%20%23%20Standalone%20release%2Fdispatch%20runs%20produce%20the%20same%20report%20artifacts%20as%20CI.%0A%20%20%23%20ci.yml%20supplies%20its%20existing%20parallel%20shards%20and%20validates%20them%20separately.%0A%20%20reports%3A%0A%20%20%20%20name%3A%20Self-Translation%20Report%20%28%24%7B%7B%20matrix.shard%20%7D%7D%2F8%29%0A%20%20%20%20if%3A%20%24%7B%7B%20%21inputs.external_reports%20%7D%7D%0A%20%20%20%20runs-on%3A%20ubuntu-latest%0A%20%20%20%20timeout-minutes%3A%2030%0A%20%20%20%20strategy%3A%0A%20%20%20%20%20%20fail-fast%3A%20false%0A%20%20%20%20%20%20matrix%3A%0A%20%20%20%20%20%20%20%20shard%3A%20%5B1%2C%202%2C%203%2C%204%2C%205%2C%206%2C%207%2C%208%5D%0A%20%20%20%20steps%3A%0A%20%20%20%20%20%20-%20uses%3A%20actions%2Fcheckout%40v7%0A%20%20%20%20%20%20%20%20with%3A%0A%20%20%20%20%20%20%20%20%20%20ref%3A%20%24%7B%7B%20github.sha%20%7D%7D%0A%0A%20%20%20%20%20%20-%20name%3A%20Setup%20Node.js%0A%20%20%20%20%20%20%20%20uses%3A%20actions%2Fsetup-node%40v7%0A%20%20%20%20%20%20%20%20with%3A%0A%20%20%20%20%20%20%20%20%20%20node-version%3A%2022%0A%20%20%20%20%20%20%20%20%20%20cache%3A%20npm%0A%20%20%20%20%20%20%20%20%20%20cache-dependency-path%3A%20js%2Fpackage-lock.json%0A%0A%20%20%20%20%20%20-%20name%3A%20Install%20dependencies%0A%20%20%20%20%20%20%20%20run%3A%20npm%20ci%0A%20%20%20%20%20%20%20%20working-directory%3A%20js%0A%0A%20%20%20%20%20%20-%20name%3A%20Report%20self-translation%20against%20the%20hand-written%20Rust%0A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20META_LANGUAGE_REPORT_PROGRESS%3A%20%271%27%0A%20%20%20%20%20%20%20%20run%3A%20%7C%0A%20%20%20%20%20%20%20%20%20%20node%20scripts%2Fgenerate-self-translation-report.mjs%20--shard%20%24%7B%7B%20matrix.shard%20%7D%7D%2F8%20--out-dir%20..%2Fself-translation-report%20%3E%20%2Fdev%2Fnull%0A%20%20%20%20%20%20%20%20%20%20cat