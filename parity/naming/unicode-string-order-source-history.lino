(69: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7B%20renderStringLengthExpression%2C%20readStringMapRefusal%2C%20renderStringTestExpression%2C%20readStringTestHelper%2C%20readStringTestSupport%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0A%2F%2F%20Rocq%20emitter.%20Naturals%20become%20binary%20%60N%60%20and%20integers%20%60Z%60%2C%20so%20programs%0A%2F%2F%20run%20at%20their%20source%20sizes%20%28unary%20%60nat%60%20cannot%20hold%2020%21%29.%20Structural%0A%2F%2F%20recursion%20over%20data%20is%20a%20%60Fixpoint%60%3B%20recursion%20that%20decreases%20a%20natural%20is%0A%2F%2F%20a%20%60Function%60%20with%20the%20measure%20%60N.to_nat%60%2C%20whose%20obligations%20%60lia%60%0A%2F%2F%20discharges%20and%20whose%20equation%20lemma%20the%20reconstructed%20proofs%20rewrite%20with.%0A%2F%2F%20A%20JavaScript%20Number%20is%20a%20primitive%20%60float%60%2C%20which%20the%20kernel%20computes%20with%2C%0A%2F%2F%20so%20assertions%20about%20Numbers%20are%20still%20theorems%20closed%20by%20computation.%0A%0Aimport%20%7B%20typeError%2C%20unsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20readCollectionConstructionBinding%2C%20renderCollectionConstruction%2C%20renderCollectionConstructionType%20%7D%20from%20%27.%2Fcollection-construction-rules.js%27%3B%0Aimport%20%7B%20renderOptionalAbsentValue%2C%20renderOptionalCoalescing%2C%20renderOptionalConsoleText%2C%20renderOptionalFlattening%2C%20renderOptionalMatch%2C%20renderOptionalNumericPresent%2C%20renderOptionalPresentValue%2C%20renderOptionalPrimitiveTruth%2C%20renderOptionalProjection%2C%20renderOptionalStrictEquality%2C%20renderOptionalTypeQueryPresent%2C%20renderOptionalUnwrapping%2C%20requireOptionalNumericPredicate%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20renderCollectionIteration%2C%20renderOptionalArrayRead%20%7D%20from%20%27.%2Farray-value-rules.js%27%3B%0Aimport%20%7B%20renderArrayFromMapping%20%7D%20from%20%27.%2Farray-from-rules.js%27%3B%0Aimport%20%7B%20readPrimitiveMethodRenderingRefusal%20%7D%20from%20%27.%2Fprimitive-method-rules.js%27%3B%0Aimport%20%7B%20renderRecordProductField%2C%20renderRecordType%2C%20renderRecordValue%20%7D%20from%20%27.%2Frecord-emission-rules.js%27%3B%0Aimport%20%7B%20readUnionTargetRefusal%20%7D%20from%20%27.%2Ftype-syntax-rules.js%27%3B%0Aimport%20%7B%20renderCallableApplication%2C%20renderCallableFunctionReference%2C%20renderCallableFunctionType%2C%20renderCallableLambda%20%7D%20from%20%27.%2Fcallable-source-rules.js%27%3B%0Aimport%20%7B%20acceptProgramTupleProductModel%20%7D%20from%20%27..%2Ftyped-program-link-rules.js%27%3B%0Aimport%20%7B%20renderAbsentNumberExpression%20%7D%20from%20%27.%2Fprimitive-value-rules.js%27%3B%0Aimport%20%7B%20propFunctions%20%7D%20from%20%27.%2Fproof.js%27%3B%0Aimport%20%7B%20renameFunction%2C%20renameMain%2C%20renameTheorem%20%7D%20from%20%27.%2Fir.js%27%3B%0Aimport%20%7B%20threadOutput%20%7D%20from%20%27.%2Foutput.js%27%3B%0Aimport%20%7B%20EmitState%2C%20mutualGroups%2C%20orderDeclarations%2C%20unthreaded%20%7D%20from%20%27.%2Femit-common.js%27%3B%0A%0Aconst%20KEYWORDS%20%3D%20new%20Set%28%5B%0A%20%20%27as%27%2C%20%27at%27%2C%20%27cofix%27%2C%20%27else%27%2C%20%27end%27%2C%20%27exists%27%2C%20%27exists2%27%2C%20%27fix%27%2C%20%27for%27%2C%20%27forall%27%2C%20%27fun%27%2C%20%27if%27%2C%20%27IF%27%2C%20%27in%27%2C%20%27let%27%2C%0A%20%20%27match%27%2C%20%27mod%27%2C%20%27Prop%27%2C%20%27return%27%2C%20%27Set%27%2C%20%27SProp%27%2C%20%27then%27%2C%20%27Type%27%2C%20%27using%27%2C%20%27where%27%2C%20%27with%27%2C%20%27struct%27%2C%20%27measure%27%2C%0A%20%20%27wf%27%2C%20%27Definition%27%2C%20%27Fixpoint%27%2C%20%27Function%27%2C%20%27Theorem%27%2C%20%27Lemma%27%2C%20%27Proof%27%2C%20%27Qed%27%2C%20%27Defined%27%2C%20%27Module%27%2C%20%27End%27%2C%0A%20%20%27Inductive%27%2C%20%27Import%27%2C%20%27Require%27%2C%20%27From%27%2C%20%27Open%27%2C%20%27Scope%27%2C%20%27Eval%27%2C%20%27Compute%27%2C%20%27Check%27%2C%20%27Print%27%2C%0A%20%20%2F%2F%20Standard-library%20names%20the%20emitted%20code%20uses%20unqualified.%0A%20%20%27N%27%2C%20%27Z%27%2C%20%27String%27%2C%20%27EmptyString%27%2C%20%27negb%27%2C%20%27andb%27%2C%20%27orb%27%2C%20%27true%27%2C%20%27false%27%2C%20%27bool%27%2C%20%27string%27%2C%20%27list%27%2C%20%27nil%27%2C%20%27cons%27%2C%0A%20%20%27unit%27%2C%20%27tt%27%2C%20%27nat%27%2C%20%27O%27%2C%20%27S%27%2C%20%27Bool%27%2C%20%27Ascii%27%2C%20%27main%27%2C%20%27lia%27%2C%20%27nia%27%2C%20%27float%27%2C%20%27PrimFloat%27%2C%0A%20%20%2F%2F%20Imported%20constructors%3A%20a%20pattern%20variable%20with%20one%20of%20these%20names%20would%20match%20the%20constructor%20instead.%0A%20%20%27left%27%2C%20%27right%27%2C%20%27inleft%27%2C%20%27inright%27%2C%20%27Some%27%2C%20%27None%27%2C%20%27pair%27%2C%20%27inl%27%2C%20%27inr%27%2C%20%27exist%27%2C%20%27existT%27%2C%20%27I%27%2C%20%27conj%27%2C%20%27or_introl%27%2C%0A%20%20%27or_intror%27%2C%20%27ex_intro%27%2C%20%27eq_refl%27%2C%20%27Eq%27%2C%20%27Lt%27%2C%20%27Gt%27%2C%20%27CompEq%27%2C%20%27CompLt%27%2C%20%27CompGt%27%2C%20%27xI%27%2C%20%27xO%27%2C%20%27xH%27%2C%20%27N0%27%2C%20%27Npos%27%2C%20%27Z0%27%2C%0A%20%20%27Zpos%27%2C%20%27Zneg%27%2C%20%27ReflectT%27%2C%20%27ReflectF%27%2C%20%27identity_refl%27%2C%0A%5D%29%3B%0A%0Aexport%20const%20ROCQ_PRELUDE%20%3D%20%5B%0A%20%20%27From%20Stdlib%20Require%20Import%20NArith%20ZArith%20Lia%20Recdef%20String%20List%20Ascii.%27%2C%0A%5D%3B%0A%0A%2F%2F%20Number%20literals%20are%20written%20as%20in%20the%20source%3B%20Rocq%20reads%20each%20one%20as%20the%0A%2F%2F%20nearest%20float%2C%20as%20JavaScript%20does%2C%20and%20would%20otherwise%20warn%20that%20it%20rounds.%0Aconst%20FLOAT_PRELUDE%20%3D%20%5B%0A%20%20%27From%20Stdlib%20Require%20Import%20NArith%20ZArith%20Lia%20Recdef%20String%20List%20Ascii%20Floats.%27%2C%0A%20%20%27Set%20Warnings%20%22-inexact-float%22.%27%2C%0A%5D%3B%0A%0A%2F%2F%20How%20many%20times%20one%20proof%20step%20rewrites%20with%20one%20hypothesis%20or%20lemma.%0Aconst%20REWRITE_BOUND%20%3D%208%3B%0A%0Aconst%20HELPERS%20%3D%20%7B%0A%20%20digits%3A%20%60Fixpoint%20ml_digits%20%28fuel%20%3A%20nat%29%20%28n%20%3A%20N%29%20%28acc%20%3A%20string%29%20%3A%20string%20%3A%3D%0A%20%20match%20fuel%20with%0A%20%20%7C%20O%20%3D%3E%20acc%0A%20%20%7C%20S%20rest%20%3D%3E%0A%20%20%20%20%20%20let%20acc%27%20%3A%3D%20String%20%28ascii_of_N%20%2848%20%2B%20N.modulo%20n%2010%29%29%20acc%20in%0A%20%20%20%20%20%20if%20N.ltb%20n%2010%20then%20acc%27%20else%20ml_digits%20rest%20%28N.div%20n%2010%29%20acc%27%0A%20%20end.%0ADefinition%20ml_N_to_string%20%28n%20%3A%20N%29%20%3A%20string%20%3A%3D%20ml_digits%20%28S%20%28N.size_nat%20n%29%29%20n%20EmptyString.%60%2C%0A%20%20zToString%3A%20%60Definition%20ml_Z_to_string%20%28z%20%3A%20Z%29%20%3A%20string%20%3A%3D%0A%20%20if%20Z.ltb%20z%200%20then%20String.append%20%22-%22%20%28ml_N_to_string%20%28Z.to_N%20%28Z.opp%20z%29%29%29%20else%20ml_N_to_string%20%28Z.to_N%20z%29.%60%2C%0A%20%20boolToString%3A%20%60Definition%20ml_bool_to_string%20%28b%20%3A%20bool%29%20%3A%20string%20%3A%3D%20if%20b%20then%20%22true%22%20else%20%22false%22.%60%2C%0A%20%20euclid%3A%20%60%28%2A%20Euclidean%20division%2C%20the%20rounding%20of%20Lean%27s%20Int%20%2F%20and%20%25%3A%20the%20remainder%20is%20never%20negative.%20%2A%29%0ADefinition%20ml_Z_ediv%20%28a%20b%20%3A%20Z%29%20%3A%20Z%20%3A%3D%20Z.mul%20%28Z.sgn%20b%29%20%28Z.div%20a%20%28Z.abs%20b%29%29.%0ADefinition%20ml_Z_emod%20%28a%20b%20%3A%20Z%29%20%3A%20Z%20%3A%3D%20Z.modulo%20a%20%28Z.abs%20b%29.%60%2C%0A%20%20tactics%3A%20%60Ltac%20ml_N_norm%20%3A%3D%20repeat%20first%0A%20%20%5B%20rewrite%20N.pred_succ%0A%20%20%7C%20rewrite%20%28proj2%20%28N.eqb_neq%20%28N.succ%20_%29%200%29%20%28N.neq_succ_0%20_%29%29%0A%20%20%7C%20rewrite%20N.eqb_refl%20%5D.%0ALtac%20ml_obligation%20%3A%3D%20intros%3B%20repeat%20match%20goal%20with%20H%20%3A%20N.eqb%20_%20_%20%3D%20false%20%7C-%20_%20%3D%3E%20apply%20N.eqb_neq%20in%20H%20end%3B%20lia.%0ALtac%20ml_close%20%3A%3D%20first%20%5Breflexivity%20%7C%20lia%20%7C%20nia%20%7C%20congruence%5D.%60%2C%0A%20%20%2F%2F%20A%20closed%20assertion%20computes%20to%20connectives%20over%20literal%20%28in%29equalities%3A%0A%20%20%2F%2F%20prove%20the%20goal%2C%20or%20refute%20a%20hypothesis%2C%20one%20connective%20at%20a%20time.%0A%20%20jsNumber%3A%20%60%28%2A%20ECMAScript%20Number%3A%3AtoString%20for%20binary64%3A%20the%20shortest%20decimal%20that%20rounds%0A%20%20%20back%20to%20the%20value%20%28the%20nearest%20one%2C%20the%20even%20one%20on%20a%20tie%29%2C%20laid%20out%20as%0A%20%20%20JavaScript%20prints%20it.%20Exact%20Z%20arithmetic%20on%20the%20decomposed%20float.%20%2A%29%0AFixpoint%20ml_js_zeros%20%28n%20%3A%20nat%29%20%3A%20string%20%3A%3D%0A%20%20match%20n%20with%20O%20%3D%3E%20EmptyString%20%7C%20S%20k%20%3D%3E%20String%20%220%22%25char%20%28ml_js_zeros%20k%29%20end.%0AFixpoint%20ml_js_trim%20%28s%20%3A%20string%29%20%3A%20string%20%3A%3D%0A%20%20match%20s%20with%0A%20%20%7C%20EmptyString%20%3D%3E%20EmptyString%0A%20%20%7C%20String%20c%20rest%20%3D%3E%0A%20%20%20%20%20%20let%20r%20%3A%3D%20ml_js_trim%20rest%20in%0A%20%20%20%20%20%20if%20andb%20%28Ascii.eqb%20c%20%220%22%25char%29%20%28String.eqb%20r%20EmptyString%29%20then%20EmptyString%20else%20String%20c%20r%0A%20%20end.%0ADefinition%20ml_js_layout%20%28digits%20%3A%20string%29%20%28n%20%3A%20Z%29%20%3A%20string%20%3A%3D%0A%20%20let%20len%20%3A%3D%20String.length%20digits%20in%0A%20%20let%20k%20%3A%3D%20Z.of_nat%20len%20in%0A%20%20if%20andb%20%28Z.leb%20k%20n%29%20%28Z.leb%20n%2021%29%20then%20%28digits%20%2B%2B%20ml_js_zeros%20%28Z.to_nat%20%28n%20-%20k%29%29%29%25string%0A%20%20else%20if%20andb%20%28Z.ltb%200%20n%29%20%28Z.leb%20n%2021%29%20then%0A%20%20%20%20%28substring%200%20%28Z.to_nat%20n%29%20digits%20%2B%2B%20%22.%22%20%2B%2B%20substring%20%28Z.to_nat%20n%29%20len%20digits%29%25string%0A%20%20else%20if%20andb%20%28Z.ltb%20%28-6%29%20n%29%20%28Z.leb%20n%200%29%20then%20%28%220.%22%20%2B%2B%20ml_js_zeros%20%28Z.to_nat%20%28-%20n%29%29%20%2B%2B%20digits%29%25string%0A%20%20else%0A%20%20%20%20let