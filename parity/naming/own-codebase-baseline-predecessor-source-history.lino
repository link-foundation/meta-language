(47526: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Explicit%20current-source%20admission%3B%20the%20frozen%20diagnostic%20producer%20stays%20exact.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadProjectData%2CserializeProjectData%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fgit-object-certificate.mjs%27%3B%0A%0Aexport%20const%20GLOBAL_GRAMMAR_CONTEXT_SOURCE_PROFILE%3DObject.freeze%28%7B%0A%20%20revision%3A%27bd939f8df9dd6156b7208a4d22843ba7e59a3c46%27%2C%0A%20%20path%3A%27parity%2Fself-translation%2Fglobal-grammar-context-reuse.lino%27%2C%0A%20%20sha256%3A%273ab63b29e01be1e18fe2b08f86e3e73cbda28b34728a19ee69fc6f280f79e63c%27%2C%0A%20%20files%3AObject.freeze%28%5B%27js%2Fsrc%2Fgrammar-runtime%2Fgrammar-selection.js%27%2C%0A%20%20%20%20%27rust%2Fsrc%2Fgrammar%2Ffeature_runtime%2Fgrammar_selection.rs%27%2C%0A%20%20%20%20%27js%2Ftests%2Fglobal-concept-archive-parser.test.js%27%2C%0A%20%20%20%20%27rust%2Ftests%2Funit%2Fglobal_concept_archive_parser.rs%27%5D%29%2C%0A%7D%29%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20pin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Alet%20sourcePairs%3B%0A%0A%2F%2A%2A%20Derive%20exact%20successor%20sources%20from%20one%20independently%20pinned%20Links%20recipe.%0A%20%2A%20Whole%20original%20Git%20membership%20and%20the%20inverse%20of%20every%20action%20are%20checked.%0A%20%2A%20No%20current%20file%2C%20caller%20proof%20or%20mutable%20returned%20object%20is%20an%20authority.%20%2A%2F%0Aexport%20function%20readGlobalGrammarContextSourcePair%28file%29%20%7B%0A%20%20const%20profile%3DGLOBAL_GRAMMAR_CONTEXT_SOURCE_PROFILE%3B%0A%20%20assert.ok%28profile.files.includes%28file%29%2C%27an%20exact%20registered%20context%20source%20owner%20is%20required%27%29%3B%0A%20%20if%28%21sourcePairs%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28profile.path%2Croot%29%29%3Bassert.equal%28pin%28bytes%29.sha256%2Cprofile.sha256%2C%27complete%20independently%20pinned%20context%20source%20recipe%27%29%3B%0A%20%20%20%20const%20packet%3DreadProjectData%28new%20URL%28profile.path%2Croot%29%29%3B%0A%20%20%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.revision%2Cprofile.revision%29%3B%0A%20%20%20%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2Cprofile.files%29%3B%0A%20%20%20%20const%20pairs%3Dnew%20Map%28%29%3B%0A%20%20%20%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20%20%20%20%20const%20original%3DBuffer.from%28row.sourceText%29%3Bassert.ok%28original.length%3C%3D131072%2C%27bounded%20complete%20context%20source%27%29%3B%0A%20%20%20%20%20%20assert.equal%28row.commit%2Cprofile.revision%29%3B%0A%20%20%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2Coriginal%2C%7Brevision%3Aprofile.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28original%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20%20%20let%20source%3Drow.sourceText%3B%0A%20%20%20%20%20%20for%28const%20action%20of%20row.actions%29%7Bassert.equal%28source.split%28action.before%29.length%2C2%29%3Bsource%3Dsource.replace%28action.before%2Caction.after%29%3B%7D%0A%20%20%20%20%20%20assert.deepEqual%28pin%28source%29%2Crow.proposed%29%3Bassert.ok%28Buffer.byteLength%28source%29%3C%3D131072%29%3B%0A%20%20%20%20%20%20let%20inverse%3Dsource%3B%0A%20%20%20%20%20%20for%28const%20action%20of%20row.actions.toReversed%28%29%29%7Bassert.equal%28inverse.split%28action.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28action.after%2Caction.before%29%3B%7D%0A%20%20%20%20%20%20assert.equal%28inverse%2Crow.sourceText%2C%27the%20entire%20original%20context%20source%20stays%20exact%27%29%3B%0A%20%20%20%20%20%20pairs.set%28row.file%2C%7Bfile%3Arow.file%2Crevision%3Aprofile.revision%2C%0A%20%20%20%20%20%20%20%20predecessor%3A%7Bsource%3Arow.sourceText%2C...pin%28original%29%7D%2Csuccessor%3A%7Bsource%2C...pin%28source%29%7D%2Cactions%3Arow.actions%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20sourcePairs%3Dpairs%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28sourcePairs.get%28file%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Admit%20only%20a%20complete%20original%20or%20its%20exact%20context-reuse%20successor.%0A%20%2A%20Historical%20wire%20pins%20and%20frozen-overlay%20roles%20are%20deliberately%20not%20inputs.%20%2A%2F%0Aexport%20function%20restoreGlobalGrammarContextSource%28file%2Csource%29%20%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.ok%28Buffer.byteLength%28source%29%3C%3D131072%29%3B%0A%20%20const%20pair%3DreadGlobalGrammarContextSourcePair%28file%29%2Ccurrent%3Dpin%28source%29%3B%0A%20%20if%28source%3D%3D%3Dpair.predecessor.source%29return%7Bfile%2Cpredecessor%3Asource%2Ccurrent%3Asource%2Cchanged%3Afalse%2Creceipt%3Anull%7D%3B%0A%20%20assert.equal%28source%2Cpair.successor.source%2C%27unknown%20current%20context%20source%20edits%20refuse%27%29%3B%0A%20%20let%20inverse%3Dsource%3B%0A%20%20for%28const%20action%20of%20pair.actions.toReversed%28%29%29%7Bassert.equal%28inverse.split%28action.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28action.after%2Caction.before%29%3B%7D%0A%20%20assert.equal%28inverse%2Cpair.predecessor.source%29%3B%0A%20%20return%7Bfile%2Cpredecessor%3Ainverse%2Ccurrent%3Asource%2Cchanged%3Atrue%2Creceipt%3A%7B%0A%20%20%20%20schemaVersion%3A1%2Cprofile%3A%27complete%20global%20grammar%20context%20source%20successor%201%27%2Cfile%2Crevision%3Apair.revision%2C%0A%20%20%20%20recipe%3A%7Bpath%3AGLOBAL_GRAMMAR_CONTEXT_SOURCE_PROFILE.path%2Csha256%3AGLOBAL_GRAMMAR_CONTEXT_SOURCE_PROFILE.sha256%7D%2C%0A%20%20%20%20predecessor%3Apin%28inverse%29%2Ccurrent%2CinverseVerified%3Atrue%2C%0A%20%20%20%20boundary%3A%27Exact%20current-to-predecessor%20source%20conservation%20only%3B%20no%20frozen%20producer%20repin%2C%20predicate%20equivalence%20or%20native%20execution%20observation.%27%7D%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Serialized%20current-source%20receipts%20are%20checked%20against%20the%20complete%20recipe.%20%2A%2F%0Aexport%20function%20checkGlobalGrammarContextSourceReceipt%28file%2Csource%2Creceipt%29%20%7B%0A%20%20const%20actual%3DrestoreGlobalGrammarContextSource%28file%2Csource%29%3Bassert.equal%28actual.changed%2Ctrue%2C%27a%20successor%20receipt%20needs%20actual%20successor%20bytes%27%29%3B%0A%20%20assert.equal%28serializeProjectData%28receipt%2C%27receipt.lino%27%29%2CserializeProjectData%28actual.receipt%2C%27receipt.lino%27%29%2C%27complete%20current-source%20receipt%20conservation%27%29%3B%0A%20%20return%20structuredClone%28actual.receipt%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
