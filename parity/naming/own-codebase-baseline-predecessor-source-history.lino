7emitter%27%2C%7Bformat%3A%27Rust%27%2Cscope%3A%27formatted-module%27%2Csource%3Araw%7D%29.source%3B%0A%20%20const%20before%3DreadRustLibraryItems%28raw%29.items%2Cafter%3Dnew%20Map%28readRustLibraryItems%28replay%29.items.map%28item%3D%3E%5Bitem.name%2Citem%5D%29%29%3B%0A%20%20for%28const%20item%20of%20before%29%7B%0A%20%20%20%20const%20updated%3Dafter.get%28item.name%29%3Bassert.equal%28updated.kind%2Citem.kind%29%3B%0A%20%20%20%20if%28%21names.includes%28item.name%29%29%20%7B%0A%20%20%20%20%20%20assert.equal%28updated.source%2Citem.source%29%3Bcontinue%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20literals%3D%28source%2Ckind%29%3D%3Etokenize%28source%2C%27Rust%27%29.tokens.filter%28token%3D%3Etoken.kind%3D%3D%3Dkind%29.map%28token%3D%3Etoken.value%29%3B%0A%20%20%20%20assert.deepEqual%28literals%28updated.source%2C%27string%27%29%2Cliterals%28item.source%2C%27string%27%29%29%3B%0A%20%20%20%20%2F%2F%20Two%20guards%20returning%20the%20same%20reset%20code%20may%20share%20that%20return.%20Every%0A%20%20%20%20%2F%2F%20distinct%20scalar%20code%20and%20the%20complete%20ordered%20token%20comparisons%20remain.%0A%20%20%20%20assert.deepEqual%28%5B...new%20Set%28literals%28updated.source%2C%27number%27%29%29%5D.sort%28%29%2C%5B...new%20Set%28literals%28item.source%2C%27number%27%29%29%5D.sort%28%29%29%3B%0A%20%20%20%20assert.doesNotMatch%28updated.source%2C%2F%23%5C%5B%28%3F%3Aallow%7Cexpect%29%5C%28%2Fu%29%3B%0A%20%20%20%20if%28item.name%3D%3D%3D%27read_java_script_lexical_declaration_step%27%29%20%7B%0A%20%20%20%20%20%20assert.match%28updated.source%2C%2Fkind%3A%20%26str%2Fu%29%3Bassert.match%28updated.source%2C%2Fvalue%3A%20%26str%2Fu%29%3B%0A%20%20%20%20%20%20assert.doesNotMatch%28updated.source%2C%2F%5Cb%28%3F%3Akind%7Cvalue%29%5C.%28%3F%3Aclone%7Cto_owned%7Cto_vec%29%5C%28%2Fu%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%28item.name%3D%3D%3D%27read_java_script_field_substitution_plan%27%29%20%7B%0A%20%20%20%20%20%20for%28const%20name%20of%20%5B%27binding_name%27%2C%27subject%