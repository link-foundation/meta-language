et%20at%20%3D%200%3B%0A%20%20let%20depth%20%3D%200%3B%0A%20%20while%20%28at%20%3C%20values.length%20%26%26%20kinds%5Bat%5D%20%21%3D%3D%20%27eof%27%20%26%26%20%28depth%20%3E%200%20%7C%7C%20%28values%5Bat%5D%20%21%3D%3D%20%27%2C%27%20%26%26%20values%5Bat%5D%20%21%3D%3D%20%27%29%27%29%29%29%20%7B%0A%20%20%20%20const%20value%20%3D%20values%5Bat%5D%3B%0A%20%20%20%20if%20%28value%20%3D%3D%3D%20%27%28%27%20%7C%7C%20value%20%3D%3D%3D%20%27%5B%27%20%7C%7C%20value%20%3D%3D%3D%20%27%7B%27%29%20depth%20%2B%3D%201%3B%0A%20%20%20%20if%20%28value%20%3D%3D%3D%20%27%29%27%20%7C%7C%20value%20%3D%3D%3D%20%27%5D%27%20%7C%7C%20value%20%3D%3D%3D%20%27%7D%27%29%20depth%20-%3D%201%3B%0A%20%20%20%20if%20%28kinds%5Bat%5D%20%3D%3D%3D%20%27identifier%27%20%26%26%20%21%28at%20%3E%200%20%26%26%20values%5Bat%20-%201%5D%20%3D%3D%3D%20%27.%27%29%29%20%7B%0A%20%20%20%20%20%20let%20parameterIndex%20%3D%200%3B%0A%20%20%20%20%20%20while%20%28parameterIndex%20%3C%20parameters.length%29%20%7B%0A%20%20%20%20%20%20%20%20if%20%28parameters%5BparameterIndex%5D%20%3D%3D%3D%20value%29%20return%20at%3B%0A%20%20%20%20%20%20%20%20parameterIndex%20%2B%3D%201%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%20%20%20%20at%20%2B%3D%201%3B%0A%20%20%7D%0A%20%20return%20-1%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Whether%20a%20slash%20follows%20a%20token%20that%20starts%20an%20expression%20rather%20than%20one%0A%20%2A%20that%20ends%20it.%20Comments%20are%20removed%20before%20this%20decision.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%0A%20%2A%20%40param%20%7Bstring%7D%20value%0A%20%2A%20%40returns%20%7Bboolean%7D%0A%20%2A%2F%0Aexport%20function%20startRegularExpression%28kind%2C%20value%29%20%7B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27%27%29%20return%20true%3B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27identifier%27%29%20%7B%0A%20%20%20%20return%20value%20%3D%3D%3D%20%27return%27%20%7C%7C%20value%20%3D%3D%3D%20%27throw%27%20%7C%7C%20value%20%3D%3D%3D%20%27case%27%0A%20%20%20%20%20%20%7C%7C%20value%20%3D%3D%3D%20%27delete%27%20%7C%7C%2