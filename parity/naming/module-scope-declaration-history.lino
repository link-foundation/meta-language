(4715: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Normal%20automatic%20capture%3B%20never%20overwrites%20a%20runtime%20host%20or%20earlier%20recipe.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BcaptureGitArtifactCertificate%7D%20from%20%27.%2Fcapture-git-artifact-certificate.mjs%27%3B%0Aimport%20%7BcheckProjectData%2CwriteProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7BNATIVE_COMPILER_HOST_PREVIOUS%2CNATIVE_COMPILER_HOST_CURRENT%2CNATIVE_COMPILER_HOST_HISTORY%2CNATIVE_COMPILER_HOST_SOURCES%2CreadNativeCompilerHostSourceIdentity%2CverifyNativeCompilerHostSourceHistory%7D%20from%20%27.%2Fnative-compiler-host-source-history.mjs%27%3B%0Aimport%20%7BCRATE_FIXTURE_PACKAGE_SOURCE%2CCRATE_FIXTURE_PACKAGE_CHANGE%2CverifyCrateFixturePackageSourceHistory%7D%20from%20%27.%2Fcrate-fixture-package-source-history.mjs%27%3B%0Aexport%20function%20generateNativeCompilerHostSourceHistory%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%7B%0A%20const%20capture%3D%28revision%2Cfile%29%3D%3E%7Bconst%7Bblob%2Ccertificate%7D%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%3Bconst%20source%3Dblob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28source%29%2Cblob%29%3Breturn%7Bsource%2C...readNativeCompilerHostSourceIdentity%28source%29%2Ccertificate%7D%3B%7D%3B%0A%20const%20sources%3DNATIVE_COMPILER_HOST_SOURCES.map%28%28%7Bfile%2Cchanges%7D%29%3D%3E%28%7Bfile%2Cprevious%3Acapture%28NATIVE_COMPILER_HOST_PREVIOUS%2Cfile%29%2Ccurrent%3Acapture%28NATIVE_COMPILER_HOST_CURRENT%2Cfile%29%2Cchanges%7D%29%29%3B%0A%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27complete%20native%20compiler%20historical%20host%20sources%201%27%2CpreviousRevision%3ANATIVE_COMPILER_HOST_PREVIOUS%2CcurrentRevision%3ANATIVE_COMPILER_HOST_CURRENT%2Csources%2C%0A%20%20boundary%3A%27Complete%20independently%20certified%20old%2Fcurrent%20compiler-repair%20sources%20preserve%20every%20prior%20host%20and%20ABI%20artifact%20byte.%20The%20artifact%20retains%20every%20checked%20program%2C%20replay%20and%20interface%20field%3B%20only%20certified%20native%20source%20files%20differ.%20Exact%20source%20conservation%20is%20not%20semantic%20or%20native%20execution%20evidence.%20Current%20behavior%20keeps%20independent%20gates.%27%7D%3B%0A%20verifyNativeCompilerHostSourceHistory%28packet%29%3B%0A%20for%28const%20row%20of%20sources%29assert.equal%28readFileSync%28new%20URL%28%27..%2F..%2F%27%2Brow.file%2Cimport.meta.url%29%2C%27utf8%27%29%2Crow.current.source%2C%27unknown%20live%20compiler%20successor%20refuses%27%29%3B%0A%20const%20output%3Dnew%20URL%28%27..%2F..%2F%27%2BNATIVE_COMPILER_HOST_HISTORY%2Cimport.meta.url%29%3Bif%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3Breturn%20packet%3B%0A%7D%0Aexport%20function%20generateCrateFixturePackageSourceHistory%28options%29%7B%0A%20const%20check%3Doptions%3F.check%3F%3Ffalse%3B%0A%20const%20%7Bfile%2CpreviousRevision%2CcurrentRevision%2Chistory%7D%3DCRATE_FIXTURE_PACKAGE_SOURCE%3B%0A%20const%20capture%3Drevision%3D%3E%7Bconst%7Bblob%2Ccertificate%7D%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%2Csource%3Dblob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28source%29%2Cblob%29%3Breturn%7Bsource%2C...readNativeCompilerHostSourceIdentity%28source%29%2Ccertificate%7D%3B%7D%3B%0A%20const%20packet%3D%7BschemaVersion%3A1%2Cmodel%3A%27complete%20crate%20fixture%20package%20source%201%27%2Cfile%2CpreviousRevision%2CcurrentRevision%2C%0A%20%20previous%3Acapture%28previousRevision%29%2Ccurrent%3Acapture%28currentRevision%29%2Cchange%3ACRATE_FIXTURE_PACKAGE_CHANGE%2C%0A%20%20boundary%3A%27Complete%20independently%20certified%20crate%20manifests%20and%20exact%20inverse%20retain%20every%20original%20package%20input%20and%20add%20only%20the%20two%20generated%20crate-local%20fixture%20entries.%20Historical%20readers%20select%20their%20complete%20original%20source%3B%20current%20packaging%20and%20runtime%20checks%20remain%20separate.%20Source%20conservation%20is%20not%20execution%20evidence.%27%7D%3B%0A%20verifyCrateFixturePackageSourceHistory%28packet%29%3Bassert.equal%28readFileSync%28new%20URL%28%27..%2F..%2F%27%2Bfile%2Cimport.meta.url%29%2C%27utf8%27%29%2Cpacket.current.source%29%3B%0A%20const%20output%3Dnew%20URL%28%27..%2F..%2F%27%2Bhistory%2Cimport.meta.url%29%3Bif%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3Breturn%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7Bassert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3Bconst%20options%3D%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%3BgenerateNativeCompilerHostSourceHistory%28options%29%3BgenerateCrateFixturePackageSourceHistory%28options%29%3B%7D%0A) (lang: meta-language%20structured%20data)))
