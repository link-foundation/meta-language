efore%3DexecFileSync%28%27git%27%2C%5B%27show%27%2Cprevious.sourceCommit%2B%27%3A%27%2Bdependency%5D%2C%7Bcwd%3Aroot%7D%29%3B%0A%20const%20actual%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bdependency%2Cimport.meta.url%29%29%3B%0A%20assert.equal%28before.length%2C7249%29%3B%0A%20assert.equal%28createHash%28%27sha256%27%29.update%28before%29.digest%28%27hex%27%29%2C%27a5fa80c7683dc2a127b2500b464e049ccf23d29979ff596aa14999c369e5c554%27%29%3B%0A%20assert.deepEqual%28actual%2CexecFileSync%28%27git%27%2C%5B%27show%27%2Ccurrent.sourceCommit%2B%27%3A%27%2Bdependency%5D%2C%7Bcwd%3Aroot%7D%29%29%3B%0A%20assert.deepEqual%28actual.subarray%280%2Cbefore.length%29%2Cbefore%2C%27every%20previous%20callback%20function%20and%20byte%20remains%20exact%27%29%3B%0A%20assert.deepEqual%28%5B...actual.subarray%28before.length%29.toString%28%27utf8%27%29.matchAll%28%2F%5Eexport%20function%20%28%5Cw%2B%29%2Fgmu%29%5D.map%28match%3D%3Ematch%5B1%5D%29%2C%5B%27renderArrayCallbackReferenceExpression%27%5D%29%3B%0A%20const%20fixtureFile%3D%27parity%2Ffixtures%2Farray-callbacks.lino%27%3B%0A%20const%20originalBytes%3DexecFileSync%28%27git%27%2C%5B%27show%27%2Cprevious.sourceCommit%2B%27%3A%27%2BfixtureFile%5D%2C%7Bcwd%3Aroot%2CmaxBuffer%3A8%2A1024%2A1024%7D%29%3B%0A%20const%20original%3DreadStructuredDataLino%28originalBytes.toString%28%27utf8%27%29%29%3B%0A%20const%20fixture%3DreadProjectData%28new%20URL%28%27..%2F..%2F%27%2BfixtureFile%2Cimport.meta.url%29%29%2Cinverse%3DstructuredClone%28fixture%29%3B%0A%20assert.equal%28fixture.cases.length%2C18%29%3B%0A%20const%20rows%3Dinverse.cases.filter%28row%3D%3Erow.id%3D%3D%3D%27array-callback-flatMap-reference-value-parameters%27%29%3B%0A%20assert.equal%28rows.length%2C1%29%3Bassert.equal%28rows%5B0%5D.profiles.length%2C1%29%3Bassert.equal%28rows%5B0%5D.profiles%5B0%5D.referenceSemantics%2Ctrue%29%3B%0A%20const%20emission%3Drows%5B0%5D.profiles%5B0%5D.targets.Rust.emitted%3B%0A%20const%20old%3D%27ml_values1.iter%28%29.cloned%28%29.enumerate%28%29