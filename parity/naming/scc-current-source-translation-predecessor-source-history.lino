(26730: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20JavaScript%20frontend%20for%20the%20portable%20core.%20It%20reads%20the%20subset%20of%20modern%0A%2F%2F%20JavaScript%20the%20core%20can%20represent%20faithfully%3A%20Number%20and%20BigInt%20arithmetic%2C%0A%2F%2F%20strings%20and%20booleans%3B%20top-level%20functions%20and%20object-literal%20namespaces%20of%20methods%0A%2F%2F%20whose%20types%20come%20from%20JSDoc%20%28%60%40param%60%2C%20%60%40returns%60%2C%20and%20%60%40typedef%60%20unions%20of%0A%2F%2F%20%60%7B%20%24%3A%20%27tag%27%2C%20%E2%80%A6%20%7D%60%20object%20types%20for%20data%20types%29%20or%2C%20where%20JSDoc%20is%20silent%2C%0A%2F%2F%20are%20inferred%20from%20how%20the%20program%20uses%20them%3B%20bodies%20made%20of%20%60const%60%2C%0A%2F%2F%20%60if%60%2C%20%60return%60%2C%20%60throw%60%20and%20%60switch%60%20statements%3B%20and%20a%20top%20level%20of%0A%2F%2F%20%60console.log%60%2C%20%60const%60%20and%20%60node%3Aassert%60%20statements%2C%20which%20are%20the%0A%2F%2F%20program%27s%20effects.%20A%20function%20whose%20leading%20statements%20throw%20on%20a%20negative%0A%2F%2F%20argument%20takes%20a%20natural%20number.%20Everything%20else%20is%20rejected%20with%20a%20precise%0A%2F%2F%20obligation.%0A%0Aimport%20%7B%20TranslationError%2C%20typeError%2C%20unsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20findDocumentationParameterRange%2C%20findDefaultParameterReference%2C%20readArrayMethodForm%2C%20acceptArrayMethodArguments%2C%20readStringTestOperation%2C%20readStringMapOperation%2C%20readJavaScriptTemporalBindingRead%2C%20readJavaScriptLexicalDeclarationStep%2C%20readJavaScriptFieldSubstitutionPlan%2C%20acceptJavaScriptMutableArrayBinding%2C%20acceptJavaScriptMutableArrayBindingOwner%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0Aimport%20%7B%20inferJavaScriptTypes%20%7D%20from%20%27.%2Fjavascript-infer.js%27%3B%0Aimport%20%7B%20readJavaScriptTagOwnerPosition%2C%20readJavaScriptTagReceiverForm%2C%20readJavaScriptTagBindingStep%2C%20acceptJavaScriptTagHeaderFact%2C%20readJavaScriptTagDeclaredOwner%20%7D%20from%20%27.%2Fjavascript-tag-context-rules.js%27%3B%0Aimport%20%7B%20readCallableReferenceConstruct%2C%20readCallableReferenceObligation%2C%20readCallableSurfaceConstructor%20%7D%20from%20%27.%2Fcallable-source-rules.js%27%3B%0Aimport%20%7B%20imperative%2C%20lowerImperative%2C%20lowerTopLevel%2C%20statementUses%20%7D%20from%20%27.%2Fjavascript-lower.js%27%3B%0Aimport%20%7B%20TokenCursor%2C%20describe%2C%20tokenize%20%7D%20from%20%27.%2Flexer.js%27%3B%0Aimport%20%7B%20BOOL%2C%20FLOAT%2C%20INT%2C%20NAT%2C%20STRING%2C%20array%20%7D%20from%20%27.%2Ftypes.js%27%3B%0Aimport%20%7B%20arrayBindingNames%2C%20bindArrayElements%2C%20isLiteralBinding%2C%20readArrayBinding%2C%20readArrayBindingInitializer%2C%20readClosure%2C%20readCompositeType%2C%20validateClosureCaptures%20%7D%20from%20%27.%2Fjavascript-bindings.js%27%3B%0Aimport%20%7B%20hasStructuralIdentity%2C%20requiresReferenceSemantics%20%7D%20from%20%27.%2Freference-analysis.js%27%3B%0Aimport%20%7B%20acceptSurfaceRawMetadataField%2C%20selectSurfaceReferenceSemantics%20%7D%20from%20%27.%2Fsurface-raw-metadata-rules.js%27%3B%0Aimport%20%7B%20readOptionalLogicalMixingError%2C%20readOptionalSourceLiteral%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20acceptObjectFreezeOperand%2C%20acceptObjectPropertyDefinition%20%7D%20from%20%27.%2Fprimitive-value-rules.js%27%3B%0Aimport%20%7B%20validateJavaScriptProducts%20%7D%20from%20%27.%2Fjavascript-products.js%27%3B%0Aimport%20%7B%20readNamedJavaScriptRecordParameters%2C%20readNamedJavaScriptRecordParameterBody%20%7D%20from%20%27.%2Fjavascript-record-parameters.js%27%3B%0Aimport%20%7B%20acceptJavaScriptStandardBuiltinOwner%20%7D%20from%20%27.%2Fjavascript-record-parameter-rules.js%27%3B%0Aimport%20%7BacceptRustScalarLoopModel%7D%20from%20%27.%2Frust-scalar-loops.js%27%3B%0Aimport%20%7BisJavaScriptScalarLoop%2C%20readJavaScriptScalarLoop%2C%20finishJavaScriptScalarLoops%