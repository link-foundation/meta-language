r%2Cpacket.sourceOwner.sourceText%29%3B%0A%20%20%20%20assert.deepEqual%28relativeArrayFrontendPin%28cachedCurrentSource%29%2Cpolicy.sourceOwner.current%29%3B%0A%20%20%7D%0A%20%20return%20cachedCurrentSource%3B%0A%7D%0A%0A%2F%2A%2A%20The%20compact%20projection%20contains%20the%20complete%20old%20source%20and%20its%20original%0A%20%2A%20Git%20membership.%20Normal%20verification%20never%20reloads%20the%20large%20naming%20archive.%20%2A%2F%0Aexport%20function%20verifyRelativeArrayFrontendSourceHistory%28history%29%7B%0A%20%20exactKeys%28history%2C%5B%27schemaVersion%27%2C%27model%27%2C%27profile%27%2C%27sourceArchive%27%2C%27historical%27%2C%27currentAuthority%27%2C%27nullableInference%27%2C%27host%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28history.schemaVersion%2C2%29%3Bassert.equal%28history.model%2C%27relative%20array%20frontend%20descriptor%20historical%20source%202%27%29%3B%0A%20%20assert.equal%28history.profile%2CRELATIVE_ARRAY_FRONTEND_PROFILE%29%3B%0A%20%20const%20naming%3DreadOwnCodebaseHistoricalNamingPolicy%28%29%2Ccurrent%3DreadOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20assert.deepEqual%28history.sourceArchive%2C%7Brevision%3Anaming.revision%2C...naming.sourceArchive%7D%29%3B%0A%20%20exactKeys%28history.historical%2C%5B%27file%27%2C%27commit%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%5D%29%3B%0A%20%20const%20previous%3Dcurrent.artifactDescriptorPrevious%3B%0A%20%20assert.deepEqual%28%7Bfile%3Ahistory.historical.file%2Cbytes%3Ahistory.historical.bytes%2Csha256%3Ahistory.historical.sha256%7D%2Cprevious%29%3B%0A%20%20assert.equal%28history.historical.commit%2Cnaming.revision%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28history.historical.sourceText%29%2C%7Bbytes%3Aprevious.bytes%2Csha256%3Aprevious.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28history.historical.certificate%2CBuffer.from%28history.historical.sourceText%29%2C%7Brevision%3Anaming.revision%2Cpath%3Aprevious.file%7D%29%3B%0A%20%20assert.deepEqual%28history.currentAuthority%2C%7Brevision%3Acurrent.revision%2Cfile%3Acurrent.sourceFile%2C%0A%20%20%20%20predecessor%3Acurrent.sourceOwner.predecessor%2Ccurrent%3Acurrent.sourceOwner.current%7D%29%3B%0A%20%20const%20inference%3Dhistory.nullableInference%2CexpectedInference%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE%3B%0A%20%20exactKeys%28inference%2C%5B%27path%27%2C%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.equal%28inference.path%2CexpectedInference.path%29%3Bassert.equal%28inference.revision%2CexpectedInference.revision%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Ainference.bytes%2Csha256%3Ainference.sha256%7D%2CexpectedInference.previous%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28inference.sourceText%29%2CexpectedInference.previous%29%3B%0A%20%20verifyGitArtifactCertificate%28inference.certificate%2CBuffer.from%28inference.sourceText%29%2C%7Brevision%3AexpectedInference.revision%2Cpath%3AexpectedInference.path%7D%29%3B%0A%20%20const%20inferenceReplay%3DreplayRelativeArrayNullableInference%28inference.sourceText%29%3B%0A%20%20assert.deepEqual%28inference.current%2CexpectedInference.current%29%3Bassert.deepEqual%28inference.edits%2CinferenceReplay.edits%29%3B%0A%20%20exactKeys%28history.host%2C%5B%27path%27%2C%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C%27edits%27%5D%29%3B%0A%20%20assert.deepEqual%28%7Bpath%3Ahistory.host.path%2Crevision%3Ahistory.host.revision%2Cbytes%3Ahistory.host.bytes%2Csha256%3Ahistory.host.sha256%7D%2CRELATIVE_ARRAY_FRONTEND_HOST%29%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28history.host.sourceText%29%2C%7Bbytes%3ARELATIVE_ARRAY_FRONTEND_HOST.bytes%2Csha256%3ARELATIVE_ARRAY_FRONTEND_HOST.sha256%7D%29%3B%0A%20%20verifyGitArtifactCertificate%28history.host.certificate%2CBuffer.from%28history.host.sourceText%29%2C%7Brevision%3ARELATIVE_ARRAY_FRONTEND_HOST.revision%2Cpath%3ARELATIVE_ARRAY_FRONTEND_HOST.path%7D%29%3B%0A%20%20const%20replay%3DreplayRelativeArrayFrontendHost%28history.host.sourceText%29%3B%0A%20%20assert.deepEqual%28history.host.current%2CrelativeArrayFrontendPin%28replay.source%29%29%3Bassert.deepEqual%28history.host.edits%2Creplay.edits%29%3B%0A%20%20return%7Bsource%3Ahistory.historical.sourceText%2Chost%3Areplay.source%2CinferenceSource%3Ainference.sourceText%2CcurrentInference%3AinferenceReplay.source%7D%3B%0A%7D%0A%0Aexport%20function%20readRelativeArrayFrontendSourceHistory%28%29%7B%0A%20%20if%28%21cachedHistory%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28historyPath%2Croot%29%29%3Bassert.equal%28relativeArrayFrontendPin%28bytes%29.sha256%2ChistorySha256%29%3B%0A%20%20%20%20cachedHistory%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20const%20verified%3DverifyRelativeArrayFrontendSourceHistory%28cachedHistory%29%3B%0A%20%20%20%20assert.equal%28readFileSync%28new%20URL%28RELATIVE_ARRAY_FRONTEND_HOST.path%2Croot%29%2C%27utf8%27%29%2Cverified.host%2C%27only%20the%20exact%20two%20scoped%20host%20edits%20are%20admitted%27%29%3B%0A%20%20%20%20assert.equal%28readFileSync%28new%20URL%28RELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.path%2Croot%29%2C%27utf8%27%29%2Cverified.currentInference%2C%27the%20actual%20nullable-array%20successor%20retains%20its%20separate%20current%20runtime%20source%27%29%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28cachedHistory%29%3B%0A%7D%0A%0A%2F%2A%2A%20This%20function%20is%20called%20only%20by%20the%20historical%20relative-array%20generator.%0A%20%2A%20Other%20profiles%2Ffiles%20are%20identities%3B%20unknown%20selected%20successors%20refuse.%20%2A%2F%0Aexport%20function%20restoreRelativeArrayFrontendDescriptorSource%28source%2Cfile%2Cprofile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bassert.equal%28typeof%20profile%2C%27string%27%29%3B%0A%20%20const%20policy%3DreadOwnCodebaseRawDescriptorPolicy%28%29%3B%0A%20%20if%28profile%21%3D%3DRELATIVE_ARRAY_FRONTEND_PROFILE%29return%20source%3B%0A%20%20if%28file%3D%3D%3DRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.path%29%7B%0A%20%20%20%20const%20history%3DreadRelativeArrayFrontendSourceHistory%28%29%2Cprevious%3Dhistory.nullableInference.sourceText%3B%0A%20%20%20%20if%28source%3D%3D%3Dprevious%29return%20source%3B%0A%20%20%20%20assert.deepEqual%28relativeArrayFrontendPin%28source%29%2CRELATIVE_ARRAY_NULLABLE_INFERENCE_SOURCE.current%2C%27an%20unknown%20nullable-inference%20successor%20has%20no%20relative-array%20historical%20authority%27%29%3B%0A%20%20%20%20assert.equal%28source%2CreplayRelativeArrayNullableInference%28previous%29.source%2C%27the%20complete%20current%20nullable-inference%20source%20has%20one%20certified%20finite%20inverse%27%29%3B%0A%20%20%20%20return%20previous%3B%0A%20%20%7D%0A%20%20if%28file%21%3D%3Dpolicy.sourceFile%29return%20source%3B%0A%20%20const%20history%3DreadRelativeArrayFrontendSourceHistory%28%29%2Cprevious%3Dhistory.historical.sourceText%3B%0A%20%20if%28source%3D%3D%3Dprevious%29return%20source%3B%0A%20%20assert.deepEqual%28relativeArrayFrontendPin%28source%29%2Cpolicy.sourceOwner.current%2C%27an%20unknown%20frontend%20successor%20has%20no%20relative-array%20historical%20authority%27%29%3B%0A%20%20assert.equal%28source%2CreadAuthenticatedCurrentRelativeArrayFrontend%28%29%2C%27the%20actual%20complete%20current%20frontend%20is%20authenticated%20through%20its%20existing%20source%20receipt%27%29%3B%0A%20%20return%20previous%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
