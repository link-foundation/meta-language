tifactCertificate%28policy.revision%2Cfile%29%3Bassert.equal%28Buffer.from%28blob.toString%28%27utf8%27%29%29.equals%28blob%29%2Ctrue%29%3Breturn%7Bfile%2Ccommit%3Apolicy.revision%2C...pin%28blob%29%2CsourceText%3Ablob.toString%28%27utf8%27%29%2Ccertificate%2Ccurrent%3Anull%7D%3B%7D%3B%0A%20%20const%5Bartifact%2Cregister%2Cloan%5D%3D%5Bpolicy.artifactFile%2Cpolicy.registerFile%2Cpolicy.loanFile%5D.map%28capture%29%3B%0A%20%20const%20old%3DreadStructuredDataLino%28artifact.sourceText%29%2Cproof%3Dold.predecessor.proof.producerApplicability%3B%0A%20%20const%20sources%3Dpolicy.sourcePaths.map%28%28file%2Cindex%29%3D%3E%7B%0A%20%20%20%20const%20row%3Dcapture%28file%29%2CsourceText%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20%20%20const%20result%3D%7B...row%2Ccurrent%3A%7B...pin%28sourceText%29%2CsourceText%7D%2CartifactPrevious%3AstructuredClone%28old.decisionSources%5Bpolicy.decisionIndices%5Bindex%5D%5D%29%2Cedits%3Aintervals%28row.sourceText%2CsourceText%29%7D%3B%0A%20%20%20%20assert.equal%28result.artifactPrevious.file%2Cfile%29%3Bassert.notEqual%28result.current.sha256%2Cresult.artifactPrevious.sha256%2C%27each%20selected%20actual%20descriptor%20needs%20this%20edge%3A%20%27%2Bfile%29%3B%0A%20%20%20%20deriveCurrentOwnCodebaseRawDescriptorSource%28result%29%3Breturn%20result%3B%0A%20%20%7D%29%3B%0A%20%20const%20adapters%3Dpolicy.adapterPaths.map%28file%3D%3E%7Bconst%20row%3Dcapture%28file%29%2CsourceText%3DadapterSource%28file%2Crow.sourceText%29%3Breturn%7B...row%2Ccurrent%3A%7B...pin%28sourceText%29%2CsourceText%7D%2Cedits%3Aintervals%28row.sourceText%2CsourceText%29%7D%3B%7D%29%3B%0A%20%20const%20inferenceDescriptorAlias%3Dproof.sources.find%28row%3D%3Erow.file%3D%3D%3Dpolicy.sourcePaths%5B1%5D%29%3D%3D%3Dproof.sourceHistory.current%3B%0A%20%20const%20packet%3D%7BschemaVersion%3Apolicy.schemaVersion%2Cmodel%3Apolicy.model%2Crevision%3Apolicy.revision%2Cartifact%2Cregister%2Cloan%2Csources%2Cadapters%2CinferenceDescriptorAlias%2Cedge%3Anull%2C%0A%20%20%20%20boundary%3A%27One%20additive%20provenance%20edge%20updates%20three%20actual%20source%20descriptors%20and%20both%20logical%20inference-proof%20descriptor%20paths.%20Complete%20emitted%20definitions%2C%20archives%2C%20fixtures%2C%20mappings%2C%20prior%20receipts%20and%20policies%20retain%20exact%20whole-byte%20inverses.%20This%20supplies%20no%20semantic-equivalence%20or%20native-execution%20evidence.%27%7D%3B%0A%20%20const%20result%3DderiveCurrentOwnCodebaseRawDescriptorOutputs%28packet%29%3Bpacket.edge%3Dresult.edge%3B%0A%20%20for%28const%20row%20of%5Bartifact%2Cregister%2Cloan%5D%29row.current%3Dpin%28result.outputs.find%28output%3D%3Eoutput.file%3D%3D%3Drow.file%29.source%29%3B%0A%20%20verifyCurrentOwnCodebaseRawDescriptorPacket%28packet%29%3B%0A%20%20const%20writes%3D%5B...result.outputs.map%28row%3D%3E%28%7B...row%2Cprevious%3A%5Bartifact%2Cregister%2Cloan%5D.find%28input%3D%3Einput.file%3D%3D%3Drow.file%29.sourceText%7D%29%29%2C%0A%20%20%20%20...adapters.map%28row%3D%3E%28%7Bfile%3Arow.file%2Csource%3AderiveCurrentOwnCodebaseRawDescriptorSource%28row%29%2Cprevious%3Arow.sourceText%7D%29%29%5D%3B%0A%20%20%2F%2F%20Validate%20every%20input%20before%20the%20first%20write%2C%20and%20keep%20repeated%20authors%20exact.%0A%20%20for%28const%20row%20of%20writes%29%7Bconst%20actual%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%3Bassert.ok%28actual%3D%3D%3Drow.previous%7C%7Cactual%3D%3D%3Drow.source%2C%27unreviewed%20whole%20input%3A%20%27%2Brow.file%29%3Bif%28check%29assert.equal%28actual%2Crow.source%29%3B%7D%0A%20%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Csource%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2F%5Econst%20policySha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%24%2Fmu%3B%0A%20%20assert.equal%28source.split%28pattern%29.length%2C2%29%3B%0A%20%20if%28check%29checkProjectData%28new%20URL%28policy.output%2Croot%29%2Cpacket%29%3Belse%20writeProjectData%28new%20URL%28policy.output%2Croot%29%2Cpacket%29%3B%0A%20%20const%20expected%3Dsource.replace%28pattern%2C%22const%20policySha256%3D%27%22%2Bpin%28readFileSync%28new%20URL%28policy.output%2Croot%29%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%7Bfor%28const%20row%20of%20writes%29writeFileSync%28new%20URL%28row.file%2Croot%29%2Crow.source%29%3BwriteFileSync%28helperPath%2Cexpected%29%3B%7D%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28args.length%3C%3D1%26%26args.every%28arg%3D%3Earg%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateCurrentOwnCodebaseRawSourceDescriptors%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27One%20exact%20current%20raw%20source%20provenance%20edge%20authored%3B%20all%20whole%20predecessors%20retained%2C%20without%20compilation%20or%20native%20execution.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
