enceReplay.source%2C%27capture%20refuses%20unknown%20nullable-array%20source%20successors%27%29%3B%0A%20%20const%20captured%3DcaptureGitArtifactCertificate%28RELATIVE_ARRAY_FRONTEND_HOST.revision%2CRELATIVE_ARRAY_FRONTEND_HOST.path%29%3B%0A%20%20const%20sourceText%3Dcaptured.blob.toString%28%27utf8%27%29%3Bassert.deepEqual%28Buffer.from%28sourceText%29%2Ccaptured.blob%29%3B%0A%20%20const%20replay%3DreplayRelativeArrayFrontendHost%28sourceText%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3A2%2Cmodel%3A%27relative%20array%20frontend%20descriptor%20historical%20source%202%27%2Cprofile%3ARELATIVE_ARRAY_FRONTEND_PROFILE%2C%0A%20%20%20%20sourceArchive%3A%7Brevision%3Anaming.revision%2C...naming.sourceArchive%7D%2Chistorical%2C%0A%20%20%20%20currentAuthority%3A%7Brevision%3Apolicy.revision%2Cfile%3Apolicy.sourceFile%2Cpredecessor%3Apolicy.sourceOwner.predecessor%2Ccurrent%3Apolicy.sourceOwner.current%7D%2C%0A%20%20%20%20nullableInference%3A%7Bpath%3AinferenceOwner.path%2Crevision%3AinferenceOwner.revision%2C...relativeArrayFrontendPin%28inferenceSource%29%2C%0A%20%20%20%20%20%20sourceText%3AinferenceSource%2Ccertificate%3AinferenceCapture.certificate%2Ccurrent%3ArelativeArrayFrontendPin%28inferenceReplay.source%29%2Cedits%3AinferenceReplay.edits%7D%2C%0A%20%20%20%20host%3A%7Bpath%3ARELATIVE_ARRAY_FRONTEND_HOST.path%2Crevision%3ARELATIVE_ARRAY_FRONTEND_HOST.revision%2C%0A%20%20%20%20%20%20...relativeArrayFrontendPin%28sourceText%29%2CsourceText%2Ccertificate%3Acaptured.certificate%2Ccurrent%3ArelativeArrayFrontendPin%28replay.source%29%2Cedits%3Areplay.edits%7D%2C%0A%20%20%20%20boundary%3A%27One%20explicit%20historical%20descriptor%20view%20for%20the%20relative-array%20generator%20only.%20The%20complete%20original%20frontend%20retains%20its%20independently%20certified897bfc%20source%20context%3B%20the%20distinct%20current%20frontend%20is%20authenticated%20through%20the%20existing%20checked%20raw-source%20descriptor%20receipt.%20A%20second%20complete%20certified7881%20inference%20source%20has%20one%20finite%20nullable-array%20owner%20insertion%20whose%20inverse%20is%20used%20only%20in%20this%20same%20descriptor%20scope.%20The%20actual%20current%20inference%20fix%20remains%20independently%20exercised%3B%20no%20source%20behavior%20equivalence%20is%20inferred.%20Every%20original%20relative-array%20descriptor%2C%20receipt%2C%20native%20definition%2C24-source%20inventory%2C%20fixture%20and%20two-change%20assertion%20stays%20exact.%20Actual%20current%20parsing%2C%20emission%2C%20source%20descriptors%20and%20native%20CI%20remain%20independent.%27%7D%3B%0A%20%20verifyRelativeArrayFrontendSourceHistory%28history%29%3B%0A%20%20const%20host%3Dnew%20URL%28RELATIVE_ARRAY_FRONTEND_HOST.path%2Croot%29%2Cactual%3DreadFileSync%28host%2C%27utf8%27%29%3B%0A%20%20if%28check%29assert.equal%28actual%2Creplay.source%29%3Belse%20assert.ok%28actual%3D%3D%3DsourceText%7C%7Cactual%3D%3D%3Dreplay.source%2C%27unknown%20host%20source%20is%20never%20overwritten%27%29%3B%0A%20%20if%28check%29checkProjectData%28new%20URL%28output%2Croot%29%2Chistory%29%3Belse%20writeProjectData%28new%20URL%28output%2Croot%29%2Chistory%29%3B%0A%20%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Ccurrent%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2Fconst%20historySha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%3B%0A%20%20assert.equal%28current.split%28pattern%29.length%2C2%29%3B%0A%20%20const%20expected%3Dcurrent.replace%28pattern%2C%22const%20historySha256%3D%27%22%2BrelativeArrayFrontendPin%28readFileSync%28new%20URL%28output%2Croot%29%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28current%2Cexpected%29%3Belse%20writeFileSync%28helperPath%2Cexpected%29%3B%0A%20%20if%28apply%29writeFileSync%28host%2Creplay.source%29%3B%0A%20%20return%20history%3B%0A%7D) (lang: meta-language%20structured%20data)))
