ngth%20%3E%3D%2076%29%3B%0A%20%20assert.equal%28new%20Set%28baselines.map%28entry%20%3D%3E%20entry.logicalPath%29%29.size%2C%20baselines.length%29%3B%0A%20%20const%20revisions%20%3D%20readProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fstructured-data-migration-revisions.lino%27%2C%20import.meta.url%29%29%3B%0A%20%20const%20contract%20%3D%20readProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fproject-data-tooling-contract.lino%27%2C%20import.meta.url%29%29%3B%0A%20%20for%20%28const%20%7B%20logicalPath%2C%20decodedSha256%2C%20sourceSha256%20%7D%20of%20baselines%29%20%7B%0A%20%20%20%20const%20file%20%3D%20new%20URL%28logicalPath%2C%20root%29%3B%0A%20%20%20%20assert.equal%28existsSync%28file%29%2C%20false%2C%20%60%24%7BlogicalPath%7D%20has%20one%20authoritative%20Links%20representation%60%29%3B%0A%20%20%20%20assert.ok%28resolveProjectDataPath%28file%29.endsWith%28%27.lino%27%29%2C%20logicalPath%29%3B%0A%20%20%20%20let%20protectedValue%20%3D%20readProjectData%28file%29%3B%0A%20%20%20%20if%20%28logicalPath%20%3D%3D%3D%20%27parity%2Ffixtures%2Ftypescript-erasure.json%27%29%20%7B%0A%20%20%20%20%20%20const%20history%20%3D%20readProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Ftypescript-named-import-expectation-history.lino%27%2C%20import.meta.url%29%29%3B%0A%20%20%20%20%20%20assert.equal%28history.path%2C%20logicalPath.replace%28%2F%5C.json%24%2Fu%2C%20%27.lino%27%29%29%3B%0A%20%20%20%20%20%20assert.equal%28hash%28readFileSync%28resolveProjectDataPath%28file%29%29%29%2C%20history.currentSha256%2C%0A%20%20%20%20%20%20%20%20%27the%20complete%20current%20fixture%20must%20match%20its%20independently%20checked%20extension%27%29%3B%0A%20%20%20%20%20%20assert.equal%28history.originalCases.length%2C%2013%29%3B%0A%20%20%20%20%20%20assert.equal%28history.appended.length%2C%208%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28protectedValue.cases.map%28row%20%3D%3E%20row.id%29%2C%0A%20%20%20%20%20%20%20%20%5B...history.originalCases.map%28row%20%3D%3E%20row