inal%2Fmodule.js%22%29%27%29%29%3Bassert.ok%28linked.includes%28%27inert%3D%22import.meta.url%22%27%29%29%3B%0A%20assert.ok%28linked.includes%28%27from%20%22file%3A%2F%2F%2Foriginal%2Fexport.js%22%27%29%29%3Bassert.ok%28linked.includes%28%27from%5Cn%22.%2Finert.js%22%27%29%29%3Bassert.ok%28linked.includes%28%27object.import.meta.url%27%29%29%3Bassert.ok%28linked.includes%28%27import%28%22file%3A%2F%2F%2Foriginal%2Flazy.js%22%29%27%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27reviewed%20provider%20revisions%20preserve%20historical%20receipts%20and%20refuse%20every%20unreviewed%20byte%20change%27%2Casync%28%29%3D%3E%7B%0A%20const%20modules%3DreviewedOverlayProviderPolicy.revisions%5B0%5D.providers.map%28row%3D%3Erow.module%29%2CsourceRoot%3Dnew%20URL%28%27..%2F..%2Fjs%2Fsrc%2F%27%2Cimport.meta.url%29%3B%0A%20for%28const%20historical%20of%20reviewedOverlayProviderPolicy.historicalOverlays%29%7B%0A%20%20const%20file%3Dnew%20URL%28%27..%2F%27%2Bhistorical.experiment%2B%27%2Fdata%2Foverlays.lino%27%2Cimport.meta.url%29%2Cbefore%3DreadFileSync%28file%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28before%29.digest%28%27hex%27%29%2Chistorical.sourceSha256%29%3B%0A%20%20const%20selected%3DreadReviewedOverlayProviderSources%28%7Bexperiment%3Ahistorical.experiment%2Cmodules%7D%29%3B%0A%20%20assert.ok%28reviewedOverlayProviderPolicy.revisions.includes%28selected.revision%29%29%3B%0A%20%20for%28const%20changed%20of%20modules%29assert.throws%28%28%29%3D%3EreadReviewedOverlayProviderSources%28%7Bexperiment%3Ahistorical.experiment%2Cmodules%2C%0A%20%20%20readSource%3Amodule%3D%3EreadFileSync%28new%20URL%28module%2CsourceRoot%29%2C%27utf8%27%29%2B%28module%3D%3D%3Dchanged%3F%27%5Cn%27%3A%27%27%29%7D%29%2C%2Fno%20unique%20reviewed%20revision%2Fu%2Cchanged%29%3B%0A%20%20if%28selected.revision%21%3D%3DreviewedOverlayProviderPolicy.revisions%5B0%5D%29await%20assert.rejects%28createCheckedModuleOverlay%28%7Brecords%3AreadProjectData%28file%29%7D%29%2C%2Fexact%20overlay%20provid