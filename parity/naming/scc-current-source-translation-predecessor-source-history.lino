y%20%3D%20true%3B%5Cn%20%20%20%20%20%20%20%20this.usesStandardArray%20%3D%20true%3B%5Cn%20%20%20%20%20%20%20%20const%20key%20%3D%20e.k%20%3D%3D%3D%20%27set%27%20%3F%20e.type.element%20%3A%20e.type.key%3B%5Cn%20%20%20%20%20%20%20%20const%20values%20%3D%20this.expr%28e.k%20%3D%3D%3D%20%27set%27%20%3F%20e.items%20%3A%20e.entries%29%3B%5Cn%20%20%20%20%20%20%20%20return%20renderCollectionConstruction%28%27Rust%27%2C%20e.k%2C%20key.kind%2C%20values%2C%20%27%27%2C%20%27%27%2C%20%27%27%29%3B%5Cn%20%20%20%20%20%20%7D%5Cn%22%7D%2C%0A%20%7D%3B%0A%20const%20changed%3D%5B%5D%2CsourceRoot%3Dnew%20URL%28%27..%2F..%2Fjs%2Fsrc%2F%27%2Cimport.meta.url%29%3B%0A%20for%28const%5Bindex%2Crow%5Dof%20current.providers.entries%28%29%29%7B%0A%20%20const%20source%3DexecFileSync%28%27git%27%2C%5B%27show%27%2Ccurrent.sourceCommit%2B%27%3Ajs%2Fsrc%2F%27%2Brow.module%5D%2C%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%7D%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%2Crow.sourceSha256%29%3B%0A%20%20let%20restored%3Dsource%3B%0A%20%20if%28Object.hasOwn%28replacements%2Crow.module%29%29%7B%0A%20%20%20changed.push%28row.module%29%3B%0A%20%20%20const%20imported%3D%22import%20%7B%20renderCollectionConstruction%20%7D%20from%20%27.%2Fcollection-construction-rules.js%27%3B%5Cn%22%2Creplacement%3Dreplacements%5Brow.module%5D%3B%0A%20%20%20assert.equal%28restored.split%28imported%29.length%2C2%29%3Bassert.equal%28restored.split%28replacement.current%29.length%2C2%29%3B%0A%20%20%20restored%3Drestored.replace%28imported%2C%27%27%29.replace%28replacement.current%2Creplacement.original%29%3B%0A%20%20%7D%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28restored%29.digest%28%27hex%27%29%2Cprevious.providers%5Bindex%5D.sourceSha256%2C%0A%20%20%20row.module%2B%27%3A%20the%20exact%20contextual%20inverse%20restores%20the%20complete%20preceding%20source%27%29%3B%0A%20%7D%0A%20assert.deepEqual%28changed%2C%5B%27translation%2Femit-javascript.js%27%2C%27translation%2Femit-rust.js%27%5D%29%3B%0A%20%2F%2F%20The%20current%20providers%20additionally%20retain%20exact%20inverses%20to%20that%20complete%0A%20%2F%2F%20collection-renderer%20revision%3B%20no%20historical%20input%20or%20comparison%20is%20removed.%0A%20const%20reviewed%3DreviewedOverlayProviderPolicy.revisions.at%28-1%29%3B%0A%20assert.equal%28reviewed.sourceCommit%2C%27fdf6b2868d9804bc62eceb9209b8ebce9274b8ed%27%29%3B%0A%20assert.equal%28reviewed.inverse.length%2C3%29%3B%0A%20assert.deepEqual%28reviewed.providers.map%28row%3D%3Erow.module%29%2Ccurrent.providers.map%28row%3D%3Erow.module%29%29%3B%0A%20assert.deepEqual%28%5B...new%20Set%28reviewed.inverse.map%28row%3D%3Erow.module%29%29%5D%2C%5B%27typed-program-checked-projection.js%27%2C%27translation%2Femit-rust.js%27%5D%29%3B%0A%20for%28const%5Bindex%2Crow%5Dof%20reviewed.providers.entries%28%29%29%7B%0A%20%20const%20source%3DreadFileSync%28new%20URL%28row.module%2CsourceRoot%29%2C%27utf8%27%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%2Crow.sourceSha256%29%3B%0A%20%20let%20restored%3Dsource%3B%0A%20%20for%28const%20inverse%20of%20reviewed.inverse.filter%28inverse%3D%3Einverse.module%3D%3D%3Drow.module%29%29%7B%0A%20%20%20assert.equal%28restored.split%28inverse.from%29.length%2C2%2C%27each%20exact%20inverse%20has%20one%20complete%20contextual%20match%27%29%3B%0A%20%20%20restored%3Drestored.replace%28inverse.from%2Cinverse.to%29%3B%0A%20%20%7D%0A%20%20const%20bytes%3DexecFileSync%28%27git%27%2C%5B%27show%27%2Ccurrent.sourceCommit%2B%27%3Ajs%2Fsrc%2F%27%2Brow.module%5D%2C%7Bcwd%3Aroot%7D%29%3B%0A%20%20assert.deepEqual%28Buffer.from%28restored%29%2Cbytes%2C%27every%20byte%20of%20the%20original%20reviewed%20provider%20is%20restored%27%29%3B%0A%20%20assert.equal%28createHash%28%27sha256%27%29.update%28restored%29.digest%28%27hex%27%29%2Ccurrent.providers%5Bindex%5D.sourceSha256%29%3B%0A%20%7D%0A%20const%20actualPolicy%3DreadFileSync%28new%20URL%28%27.%2Freviewed-providers