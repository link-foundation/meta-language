(5077: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Extend%20the%20checked%20overlay%20chain%20without%20rewriting%20any%20historical%20provider.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%2CwriteFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BcaptureGitArtifactCertificate%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fcapture-git-artifact-certificate.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BwriteProjectData%2CcheckProjectData%2CserializeProjectData%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BreadStructuredDataLino%7D%20from%20%27..%2F..%2Fjs%2Fsrc%2Fstructured-data-links.js%27%3B%0Aimport%20%7BDecoratorSet%7D%20from%20%27..%2F..%2Fjs%2Fsrc%2Fdecorators.js%27%3B%0Aimport%20%7BreviewedOverlayProviderPolicy%7D%20from%20%27..%2Frust-text-certificate-adapter%2Freviewed-providers.mjs%27%3B%0Aimport%20%7BrestoreReviewedOverlayProviderSources%7D%20from%20%27..%2Frust-text-certificate-adapter%2Freviewed-providers.mjs%27%3B%0Aimport%20%7BrustTextCertificateOverlayRecords%7D%20from%20%27..%2Frust-text-certificate-adapter%2Fgenerate.mjs%27%3B%0Aimport%20%7BrawBindingCertificateOverlayRecords%7D%20from%20%27..%2Frust-raw-binding-certificate-adapter%2Fgenerate-overlay.mjs%27%3B%0A%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%2Crevision%3D%27478fb5873ddfd6ab7e4c4b6849654e2c2cef3fa8%27%3B%0Aconst%20predecessor%3D%279f867bfac32f59a3341dabf54e8c0c02fbd83314%27%3B%0Aconst%20file%3D%27parity%2Fself-translation%2Fprogram-string-overlay-provider-revision.lino%27%3B%0Aconst%20hash%3Dvalue%3D%3EcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0A%0A%2F%2A%2A%20Derive%20whole-source%20inverse%20actions%20from%20independently%20recorded%20Git%20objects.%20%2A%2F%0Aexport%20function%20generateProgramStringOverlayProviderRevision%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20previous%3DreviewedOverlayProviderPolicy.revisions.find%28row%3D%3Erow.sourceCommit%3D%3D%3Dpredecessor%29%3Bassert.ok%28previous%29%3B%0A%20%20const%20providers%3D%5B%5D%2Cinverse%3D%5B%5D%2Ccertificates%3D%5B%5D%3B%0A%20%20for%28const%20provider%20of%20previous.providers%29%7B%0A%20%20%20%20const%20path%3D%27js%2Fsrc%2F%27%2Bprovider.module%3B%0A%20%20%20%20const%20current%3DcaptureGitArtifactCertificate%28revision%2Cpath%29%2Cold%3DcaptureGitArtifactCertificate%28predecessor%2Cpath%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28current.certificate%2Ccurrent.blob%2C%7Brevision%2Cpath%7D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28old.certificate%2Cold.blob%2C%7Brevision%3Apredecessor%2Cpath%7D%29%3B%0A%20%20%20%20assert.equal%28hash%28old.blob%29%2Cprovider.sourceSha256%29%3Bassert.deepEqual%28readFileSync%28new%20URL%28path%2Croot%29%29%2Ccurrent.blob%29%3B%0A%20%20%20%20const%20source%3Dcurrent.blob.toString%28%29%2CpreviousSource%3Dold.blob.toString%28%29%3B%0A%20%20%20%20assert.deepEqual%28Buffer.from%28source%29%2Ccurrent.blob%29%3Bassert.deepEqual%28Buffer.from%28previousSource%29%2Cold.blob%29%3B%0A%20%20%20%20providers.push%28%7Bmodule%3Aprovider.module%2CsourceSha256%3Ahash%28current.blob%29%7D%29%3B%0A%20%20%20%20certificates.push%28%7Bmodule%3Aprovider.module%2Ccurrent%3A%7Brevision%2Csource%2Ccertificate%3Acurrent.certificate%7D%2C%0A%20%20%20%20%20%20previous%3A%7Brevision%3Apredecessor%2Csource%3ApreviousSource%2Ccertificate%3Aold.certificate%7D%7D%29%3B%0A%20%20%20%20if%28source%21%3D%3DpreviousSource%29inverse.push%28%7Bmodule%3Aprovider.module%2Cfrom%3Asource%2Cto%3ApreviousSource%7D%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28inverse.map%28row%3D%3Erow.module%29%2C%5B%27typed-program-links-validation.js%27%2C%27typed-program-checked-projection.js%27%5D%29%3B%0A%20%20const%20value%3D%7BsourceCommit%3Arevision%2CpreviousSourceCommit%3Apredecessor%2C%0A%20%20%20%20review%3A%27The%20actual%20checked-program%20validator%20now%20admits%20only%20absent%20or%20explicit%20Boolean%20utf16Strings%20metadata.%20Complete%20semantic%20rechecking%20retains%20that%20exact%20present%20flag%20before%20the%20unchanged%20whole-IR%20comparison.%20Every%20other%20provider%20byte%20remains%20unchanged.%20Both%20complete%20changed%20modules%20and%20all%20five%20independently%20certified%20current%20and%20preceding%20sources%20are%20retained%3B%20two%20exact%20whole-module%20inverse%20actions%20restore%20the%20original%20source%20profile.%20This%20is%20source%20conservation%20and%20an%20admitted-domain%20extension%2C%20not%20proof%20that%20changed%20operations%20have%20identical%20meaning%20or%20that%20native%20execution%20passed.%27%2C%0A%20%20%20%20providers%2Cinverse%2Ccertificates%7D%3B%0A%20%20const%20output%3Dnew%20URL%28file%2Croot%29%3Bif%28check%29checkProjectData%28output%2Cvalue%29%3Belse%20writeProjectData%28output%2Cvalue%29%3B%0A%20%20const%20helper%3Dnew%20URL%28%27.%2Foverlay-provider-revision.mjs%27%2Cimport.meta.url%29%2Csource%3DreadFileSync%28helper%2C%27utf8%27%29%3B%0A%20%20const%20expected%3Dsource.replace%28%2Fconst%20packetSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%2C%22const%20packetSha256%3D%27%22%2Bhash%28readFileSync%28output%29%29%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28helper%2Cexpected%29%3B%0A%20%20return%20value%3B%0A%7D%0A%0A%2F%2A%2A%20Refresh%20only%20current%20source-derived%20receipts.%20Historical%20overlay%20documents%2C%0A%20%2A%20every%20decorator%20action%20and%20all%20original%20behavior%20expectations%20stay%20exact.%20%2A%2F%0Aexport%20function%20generateProgramStringOverlayRecords%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20results%3D%5B%5D%3B%0A%20%20for%28const%20%5Bexperiment%2Cauthor%5Dof%20%5B%5B%27rust-text-certificate-adapter%27%2CrustTextCertificateOverlayRecords%5D%2C%0A%20%20%20%20%5B%27rust-raw-binding-certificate-adapter%27%2CrawBindingCertificateOverlayRecords%5D%5D%29%7B%0A%20%20%20%20const%20path%3D%27experiments%2F%27%2Bexperiment%2B%27%2Fdata%2Foverlays-current.lino%27%3B%0A%20%20%20%20const%20original%3DcaptureGitArtifactCertificate%28%27abde6ee604b914a895f23525946fab2234109e86%27%2Cpath%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28original.certificate%2Coriginal.blob%2C%7Brevision%3A%27abde6ee604b914a895f23525946fab2234109e86%27%2Cpath%7D%29%3B%0A%20%20%20%20const%20previous%3DreadStructuredDataLino%28original.blob.toString%28%29%29%2Ccurrent%3Dauthor%28%29%2Cinverse%3DstructuredClone%28current%29%3B%0A%20%20%20%20assert.equal%28current.length%2C5%29%3Bassert.equal%28previous.length%2C5%29%3B%0A%20%20%20%20const%20modules%3Dprevious.map%28row%3D%3Erow.module%29%3B%0A%20%20%20%20const%20oldSources%3DrestoreReviewedOverlayProviderSources%28%7Bexperiment%2Cmodules%2CsourceCommit%3Apredecessor%7D%29.sources%3B%0A%20%20%20%20for%28const%20%5Bindex%2Crow%5Dof%20current.entries%28%29%29%7B%0A%20%20%20%20%20%20const%20old%3Dprevious%5Bindex%5D%3Bassert.equal%28row.module%2Cold.module%29%3Bassert.equal%28old.providerRevision%2Cpredecessor%29%3B%0A%20%20%20%20%20%20assert.equal%28row.providerRevision%2Crevision%29%3Bassert.equal%28row.decorators%2Cold.decorators%29%3Bassert.equal%28row.changes%2Cold.changes%29%3B%0A%20%20%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28%27js%2Fsrc%2F%27%2Brow.module%2Croot%29%2C%27utf8%27%29%2Cbefore%3DoldSources.get%28row.module%29%3B%0A%20%20%20%20%20%20const%20decorate%3Dtext%3D%3EDecoratorSet.fromLino%28row.decorators%29.decorate%28%27translation-rule%27%2C%7Bmodule%3Arow.module%2Csource%3Atext%7D%29.source%3B%0A%20%20%20%20%20%20assert.equal%28hash%28source%29%2Crow.sourceSha256%29%3Bassert.equal%28hash%28decorate%28source%29%29%2Crow.overlaySha256%29%3B%0A%20%20%20%20%20%20assert.equal%28hash%28before%29%2Cold.sourceSha256%29%3Bassert.equal%28hash%28decorate%28before%29%29%2Cold.overlaySha256%29%3B%0A%20%20%20%20%20%20for%28const%20key%20of%20%5B%27sourceSha256%27%2C%27overlaySha256%27%2C%27providerRevision%27%5D%29inverse%5Bindex%5D%5Bkey%5D%3Dold%5Bkey%5D%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.deepEqual%28inverse%2Cprevious%29%3Bassert.equal%28serializeProjectData%28inverse%2Cpath%29%2Coriginal.blob.toString%28%29%29%3B%0A%20%20%20%20const%20output%3Dnew%20URL%28path%2Croot%29%3Bif%28check%29checkProjectData%28output%2Ccurrent%29%3Belse%20writeProjectData%28output%2Ccurrent%29%3B%0A%20%20%20%20results.push%28%7Bfile%3Apath%2Cproviders%3Acurrent.length%2CoriginalDecoratorActionsPreserved%3Atrue%7D%29%3B%0A%20%20%7D%0A%20%20const%20original%3DcaptureGitArtifactCertificate%28%27abde6ee604b914a895f23525946fab2234109e86%27%2C%27experiments%2Frust-text-certificate-adapter%2Fdata%2Fprovider-revisions.lino%27%29%3B%0A%20%20const%20policy%3DstructuredClone%28reviewedOverlayProviderPolicy%29%3Bassert.equal%28policy.revisions.pop%28%29.sourceCommit%2Crevision%29%3B%0A%20%20assert.deepEqual%28policy%2CreadStructuredDataLino%28original.blob.toString%28%29%29%2C%27all%20preceding%20provider%20policy%20fields%20and%20revisions%20remain%20exact%27%29%3B%0A%20%20return%20results%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20console.log%28%27Registered%20%27%2BgenerateProgramStringOverlayProviderRevision%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29.providers.length%2B%27%20complete%20current%20overlay%20providers.%27%29%3B%0A%20%20console.log%28generateProgramStringOverlayRecords%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
