TF8%20order%27%29%3B%0A%20%20const%20native%3DemitRust%28program%29%3B%0A%20%20assert.ok%28native.encodings.some%28row%3D%3Erow.id%3D%3D%3D%27utf16-strings%27%29%29%3B%0A%20%20for%28const%20method%20of%20%5B%27lt%27%2C%27le%27%2C%27gt%27%2C%27ge%27%5D%29assert.ok%28native.text.includes%28%27%3Ccrate%3A%3Aml_string%3A%3AText%20as%20std%3A%3Acmp%3A%3APartialOrd%3E%3A%3A%27%2Bmethod%2B%27%28%27%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27explicit%20string%20order%20models%20retain%20operand%20evaluation%20order%20and%20recheck%20through%20complete%20source%20free%20archives%27%2C%28%29%3D%3E%7B%0A%20%20const%20ordered%3D%22%2F%2A%2A%20%40returns%20%7Bstring%7D%20%2A%2Ffunction%20left%28%29%7Bconsole.log%28%27left%27%29%3Breturn%20%27A%27%3B%7D%2F%2A%2A%20%40returns%20%7Bstring%7D%20%2A%2Ffunction%20right%28%29%7Bconsole.log%28%27right%27%29%3Breturn%20%27B%27%3B%7Dconsole.log%28left%28%29%3Cright%28%29%29%3B%22%3B%0A%20%20for%28const%20text%20of%20%5Bordered%2CemitJavaScript%28checkProgram%28parseJavaScript%28ordered%29%29%29.text%5D%29%7B%0A%20%20%20%20const%20lines%3D%5B%5D%3BrunInNewContext%28text%2C%7Bconsole%3A%7Blog%3Avalue%3D%3Elines.push%28String%28value%29%29%7D%7D%29%3Bassert.deepEqual%28lines%2C%5B%27left%27%2C%27right%27%2C%27true%27%5D%29%3B%0A%20%20%7D%0A%20%20const%20packet%3DcreateTypedProgramLinks%28source%2C%27JavaScript%27%29%2Cnative%3DemitRust%28checkProgram%28parseJavaScript%28source%29%29%29.text%3B%0A%20%20for%28const%20network%20of%20%5BLinkNetwork.fromLino%28packet.network.toLino%28%29%29%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28packet.network%29%29%5D%29%7B%0A%20%20%20%20const%20restored%3DdecodeTypedProgramLinks%28network%2Cpacket.root%29%3BrecheckLinkedTypedProgram%28restored%2C%7BwholeProgram%3Atrue%7D%29%3B%0A%20%20%20%20assert.ok%28JSON.stringify%28restored.items%29.includes%28%27unicodeCodeUnitLessThan%27%29%29%3B%0A%20%20%20%20assert.equal%28emitTypedProgramLinks%28network%2Cpacket.root%2C%27Rust%27%29.code%2Cnative%29%3B%0A%20%20