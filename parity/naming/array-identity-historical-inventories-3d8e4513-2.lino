(93193: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20Pluggable%20storage%20backends%20for%20meta-language%20links.%0A%2F%2F%21%0A%2F%2F%21%20%5B%60LinkStore%60%5D%20is%20the%20storage%20boundary%20for%20the%20links%20network%3A%20reads%20use%0A%2F%2F%21%20%60%26self%60%2C%20writes%20use%20%60%26mut%20self%60%2C%20and%20the%20default%20implementation%20is%20the%0A%2F%2F%21%20existing%20in-memory%20%5B%60LinkNetwork%60%5D.%20The%20optional%0A%2F%2F%21%20%60doublets%60%20Cargo%20feature%20adds%20a%20file-mapped%20binary%20backend%20over%20the%0A%2F%2F%21%20%60doublets%60%20crate.%0A%0Ause%20std%3A%3Aerror%3A%3AError%3B%0Ause%20std%3A%3Afmt%3B%0Ause%20std%3A%3Async%3A%3AArc%3B%0A%0Ause%20crate%3A%3Aaccess%3A%3A%7BEngineNetwork%2C%20ReadOnlyNetwork%2C%20ReadOnlyViolation%7D%3B%0Ause%20crate%3A%3Aconfiguration%3A%3AAccessMode%3B%0Ause%20crate%3A%3Alink_network%3A%3A%7BLink%2C%20LinkId%2C%20LinkMetadata%2C%20LinkNetwork%2C%20LinkType%7D%3B%0A%0A%2F%2F%2F%20Storage-level%20errors%20returned%20by%20%5B%60LinkStore%60%5D%20implementations.%0A%23%5Bderive%28Debug%29%5D%0Apub%20enum%20StorageError%20%7B%0A%20%20%20%20%2F%2F%2F%20A%20write%20was%20attempted%20through%20a%20read-only%20storage%20handle.%0A%20%20%20%20ReadOnly%28ReadOnlyViolation%29%2C%0A%20%20%20%20%2F%2F%2F%20File%20I%2FO%20failed%20while%20opening%20or%20maintaining%20a%20file-backed%20store.%0A%20%20%20%20Io%28std%3A%3Aio%3A%3AError%29%2C%0A%20%20%20%20%2F%2F%2F%20The%20optional%20%60doublets%60%20backend%20returned%20an%20error.%0A%20%20%20%20Doublets%28String%29%2C%0A%20%20%20%20%2F%2F%2F%20Stored%20bytes%20do%20not%20match%20the%20meta-language%20storage%20schema.%0A%20%20%20%20Corrupt%28String%29%2C%0A%7D%0A%0Aimpl%20fmt%3A%3ADisplay%20for%20StorageError%20%7B%0A%20%20%20%20fn%20fmt%28%26self%2C%20formatter%3A%20%26mut%20fmt%3A%3AFormatter%3C%27_%3E%29%20-%3E%20fmt%3A%3AResult%20%7B%0A%20%20%20%20%20%20%20%20match%20self%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20Self%3A%3AReadOnly