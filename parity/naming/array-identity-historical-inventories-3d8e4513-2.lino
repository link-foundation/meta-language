0A%20releases.get%28%27fourth%27%29%28%29%3Breleases.get%28%27third%27%29%28%29%3Bawait%20running%3B%0A%20assert.deepEqual%28rows%2C%5B%27first%27%2C%27second%27%2C%27third%27%2C%27fourth%27%5D.map%28module%3D%3E%28%7Bmodule%2Csource%3Amodule%2B%27%20complete%20source%27%7D%29%29%29%3Bassert.deepEqual%28failures%2C%5B%5D%29%3Bassert.equal%28active.size%2C0%29%3B%0A%7D%29%3B%0Atest%28%27context%20and%20worker%20failures%20remain%20failures%20while%20all%20other%20complete%20measurements%20finish%27%2Casync%28%29%3D%3E%7B%0A%20for%28const%20count%20of%5B1%2C2%5D%29%7B%0A%20%20const%20rows%3D%5B%5D%2Cfailures%3D%5B%5D%2Ccalls%3D%5B%5D%3B%0A%20%20await%20measureReportModules%28%5B%27first%27%2C%27bad%20context%27%2C%27bad%20worker%27%2C%27bad%20synchronous%20worker%27%2C%27last%27%5D%2C%7B%0A%20%20%20workers%3AArray.from%28%7Blength%3Acount%7D%2C%28%29%3D%3Emodule%3D%3E%7Bcalls.push%28module%29%3Bif%28module%3D%3D%3D%27bad%20synchronous%20worker%27%29throw%20new%20Error%28module%29%3Breturn%20module%3D%3D%3D%27bad%20worker%27%3FPromise.reject%28new%20Error%28module%29%29%3APromise.resolve%28%7Bmodule%7D%29%3B%7D%29%2C%0A%20%20%20resolveContext%3Amodule%3D%3E%7Bif%28module%3D%3D%3D%27bad%20context%27%29throw%20new%20Error%28module%29%3Breturn%7B%7D%3B%7D%2Crecord%3A%28_%2Crow%29%3D%3Erows.push%28row.module%29%2Cfailure%3A%28module%2Cerror%29%3D%3Efailures.push%28%5Bmodule%2Cerror.message%5D%29%2C%0A%20%20%7D%29%3B%0A%20%20assert.deepEqual%28rows%2C%5B%27first%27%2C%27last%27%5D%29%3Bassert.deepEqual%28calls%2C%5B%27first%27%2C%27bad%20worker%27%2C%27bad%20synchronous%20worker%27%2C%27last%27%5D%29%3B%0A%20%20assert.deepEqual%28failures.sort%28%29%2C%5B%27bad%20context%27%2C%27bad%20worker%27%2C%27bad%20synchronous%20worker%27%5D.map%28module%3D%3E%5Bmodule%2Cmodule%5D%29.sort%28%29%29%3B%0A%20%7D%0A%7D%29%3B%0Atest%28%27invalid%20report%20worker%20counts%20and%20duplicate%20module%20inventories%20refuse%20before%20measurement%27%2Casync%28%29%3D%3E%7B%0A%20for%28const%20workers%20of%5B%5B%5D%2C%5B%28%29%3D%3E%7B%7D%2C%28%29%3D%3E%7B%7D%2C%28%29%3D%3E%7B%7D%5D%5D%29await%20assert.rejects%28measureReportModules%28%5B%27first%27%5D%2C%7Bworkers%7D%29%2Cassert.AssertionError%29%3B%0A%20await%20assert.rejects%28measureReportModules%28%5B%27first%27%2C%27first%27%5D%2C%7Bworkers%3A%5B%28%29%3D%3E%7Bthrow%20new%20Error%28%27must%20not%20run%27%29%3B%7D%5D%7D%29%2C%2Fexactly%20once%2Fu%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
