9%29%2C%20entry.surface%2C%20entry.id%29%3B%0A%20%20%20%20assert.deepEqual%28observed%28entry.javascript%2C%20entry.name%2C%20entry.inputs%29%2C%20entry.expected%2C%20entry.id%29%3B%0A%20%20%20%20assert.deepEqual%28observed%28entry.replayJavaScript%2C%20entry.name%2C%20entry.inputs%29%2C%20entry.expected%2C%20entry.id%29%3B%0A%20%20%20%20const%20archive%20%3D%20createTypedProgramLinks%28entry.source%2C%20%27Rust%27%29%3B%0A%20%20%20%20const%20network%20%3D%20LinkNetwork.fromLino%28archive.network.toLino%28%29%29%3B%0A%20%20%20%20assert.deepEqual%28observed%28emitTypedProgramLinks%28network%2C%20archive.root%2C%20%27JavaScript%27%29.code%2C%20entry.name%2C%20entry.inputs%29%2C%20entry.expected%2C%20entry.id%29%3B%0A%20%20%20%20const%20emitted%20%3D%20emitTypedProgramLinks%28network%2C%20archive.root%2C%20%27Rust%27%29.code%3B%0A%20%20%20%20assert.ok%28emitted.includes%28entry.rustDefinitions%29%2C%20entry.id%29%3B%0A%20%20%20%20const%20checkedReplay%20%3D%20checkProgram%28parseRust%28entry.rustDefinitions%20%2B%20%27%5Cnfn%20main%28%29%7B%7D%27%29%29%3B%0A%20%20%20%20assert.equal%28emitRust%28checkedReplay%29.definitions.join%28%27%5Cn%5Cn%27%29%2C%20entry.rustDefinitions%2C%20entry.id%29%3B%0A%20%20%20%20assert.deepEqual%28observed%28emitJavaScript%28checkedReplay%29.text%2C%20entry.name%2C%20entry.inputs%29%2C%20entry.expected%2C%20entry.id%29%3B%0A%20%20%7D%0A%7D%29%3B%0Atest%28%27array%20source%20ownership%2C%20unsupported%20borrowing%20and%20generic%20boundaries%20retain%20precise%20refusals%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20for%20%28const%20entry%20of%20fixture.invalid%29%20assert.throws%28%28%29%20%3D%3E%20checkProgram%28parseRust%28entry.source%29%29%2C%20error%20%3D%3E%20%7B%0A%20%20%20%20assert.equal%28error.kind%2C%20entry.kind%2C%20entry.id%29%3B%0A%20%20%20%20assert.equal%28error.reason%2C%20entry.reason%2C%20entry.id%29%3B%0A%20%20%20%20assert.deepEqual%28error.span%20%3F%3F%20null%2C%20entry.span%2C%20entry.id%29%3B%0A%20%20%20%20return%20true%3B%0A%20%20%7D%29%3B%0A%7D%29%3B%0Atest%28%27standard%20vector%20construction%20and%20borrowing%20preserve%20read-only%20observations%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20for%20%28const%20initializer%20of%20%5B%27vec%21%5B1f64%2C2f64%5D%27%2C%20%27Vec%3A%3A%3Cf64%3E%3A%3Anew%28%29%27%5D%29%20%7B%0A%20%20%20%20const%20source%20%3D%20%60fn%20empty%28values%3A%26%5Bf64%5D%29-%3Ebool%7Bvalues.is_empty%28%29%7D%20fn%20main%28%29%7Blet%20values%3AVec%3Cf64%3E%20%3D%20%24%7Binitializer%7D%3Bprintln%21%28%22%7B%7D%22%2Cempty%28%26values%29%29%3B%7D%60%3B%0A%20%20%20%20const%20output%20%3D%20%5B%5D%3B%0A%20%20%20%20vm.runInNewContext%28emitJavaScript%28checkProgram%28parseRust%28source%29%29%29.text%2C%20%7B%20console%3A%20%7B%20log%3A%20value%20%3D%3E%20output.push%28value%29%20%7D%20%7D%29%3B%0A%20%20%20%20assert.deepEqual%28output%2C%20%5Binitializer.includes%28%27new%27%29%20%3F%20%27true%27%20%3A%20%27false%27%5D%29%3B%0A%20%20%7D%0A%7D%29%3B%0Atest%28%27shared%20array%20decisions%20retain%20standard%20owners%2C%20direct%20elements%20and%20one-way%20slice%20coercion%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20for%20%28const%20owner%20of%20%5B%27Vec%27%2C%20%27std%3A%3Avec%3A%3AVec%27%5D%29%20%7B%0A%20%20%20%20assert.equal%28acceptRustSourceArrayOwner%28owner%2C%20false%29%2C%20true%29%3B%0A%20%20%20%20assert.equal%28acceptRustSourceArrayOwner%28owner%2C%20true%29%2C%20false%29%3B%0A%20%20%7D%0A%20%20for%20%28const%20owner%20of%20%5B%27Other%3A%3AVec%27%2C%20%27alloc%3A%3Avec%3A%3AVec%27%5D%29%20assert.equal%28acceptRustSourceArrayOwner%28owner%2C%20false%29%2C%20false%29%3B%0A%20%20for%20%28const%20kind%20of%20%5B%27bool%27%2C%20%27float%27%2C%20%27fixed%27%2C%20%27unit%27%2C%20%27string%27%5D%29%20%7B%0A%20%20%20%20assert.equal%28acceptRustSourceArrayElement%28kind%2C%20false%29%2C%20true%29%3B%0A%20%20%20%20assert.equal%28acceptRustSourceArrayElement%28kind%2C%20true%29%2C%20false%29%3B%0A%20%20%7D%0A%20%20for%20%28const%20kind%20of%20%5B%27array%27%2C%20%27record%27%2C%20%27n