(74852: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20The%20native%20executor%20of%20the%20grammar%20feature%20union%2C%20the%20Rust%20port%20of%0A%2F%2F%21%20%60js%2Fsrc%2Fgrammar-runtime.js%60.%0A%2F%2F%21%0A%2F%2F%21%20Compile%20a%20grammar%20once%2C%20then%20parse%20sources%20into%20lossless%20concrete%20syntax%0A%2F%2F%21%20trees.%20Loading%20%28%60load.rs%60%2C%20%60compile.rs%60%29%0A%2F%2F%21%20resolves%20imports%2C%20macros%20and%20parameterized%20rules%20and%20checks%20every%0A%2F%2F%21%20scanner%2C%20action%20and%20predicate%3B%20the%20executor%20%28%60executor.rs%60%2C%20%60rules.rs%60%29%0A%2F%2F%21%20runs%20it%20within%20explicit%20resource%20limits%3B%20%60tree.rs%60%20copies%20and%20renders%20the%0A%2F%2F%21%20result.%20docs%2Fgrammar%2Ffeature-union.md%20is%20the%20specification%20both%0A%2F%2F%21%20runtimes%20follow.%0A%0Amod%20attributes%3B%0Amod%20compile%3B%0Amod%20executor%3B%0Amod%20expectation_requests%3B%0Amod%20field_range_source%3B%0Amod%20forking%3B%0Amod%20grammar_selection%3B%0Amod%20joins%3B%0Amod%20keyword_lexing%3B%0Amod%20lexical_cache%3B%0Amod%20lexical_cache_memory%3B%0Amod%20lexical_election%3B%0Apub%28crate%29%20mod%20lexical_kernel%3B%0Amod%20lexical_plan%3B%0Amod%20lexing%3B%0Amod%20load%3B%0Amod%20mapped_tree_validation%3B%0Amod%20operations%3B%0Amod%20ordering%3B%0Amod%20parting%3B%0Amod%20precedence%3B%0Amod%20precedence_contexts%3B%0Amod%20program%3B%0Amod%20reducing%3B%0Amod%20repetition%3B%0Amod%20results%3B%0Amod%20roots%3B%0Amod%20rules%3B%0Amod%20selection_source_mapping%3B%0Amod%20separators%3B%0Amod%20text%3B%0Amod%20token_conflicts%3B%0Amod%20token_ranks%3B%0Amod%20tree%3B%0Amod%20walk%3B%0A%0Ause%20std%3A%3Acell%3A%3A%7BCell%2C%20RefCell%7D%3B%0Ause%20std%3A%3Acollections%3A%3AHashSet%3B%0Ause%20std%3A%3Afmt%3B%0Ause%20std%3A%3Arc%3A%3ARc%3B%0A%0Apub%20use%20grammar_selection%3A%3A%7BGrammarSelection%2C%20GrammarSelectionAlternative%7D%3B%0Apub%20use%20load%3A%3AGrammarRuntimeError%3B%0Apub%20use%20mapped_tree_validation%3A%3Acheck_grammar_selection_mapped_tree%3B%0Apub%20use%20operations%3A%3AOperationValue%3B%0Apub%20use%20tree%3A%3A%7BAmbiguity%2C%20LeafText%2C%20SyntaxAttributes%2C%20SyntaxTree%7D%3B%0A%0Ause%20super%3A%3AGrammar%3B%0Ause%20super%3A%3Adecorators%3A%3A%7Bdecorate_grammar%2C%20decorate_syntax_tree%7D%3B%0Ause%20crate%3A%3Adecorators%3A%3A%7BDecoratorError%2C%20DecoratorLevel%2C%20DecoratorSet%7D%3B%0Ause%20crate%3A%3Atranslation%3A%3Agrammar_selection_rules%3B%0Ause%20executor%3A%3AExecutor%3B%0Ause%20operations%3A%3AAbort%3B%0Ause%20program%3A%3A%7BCompiled%2C%20SettlingStep%7D%3B%0Ause%20results%3A%3A%7BExpectations%2C%20KeywordLexing%2C%20Outcome%2C%20Shared%2C%20TokenOrder%7D%3B%0A%0A%2F%2F%2F%20The%20default%20bound%20on%20nested%20rule%20calls.%0Aconst%20DEFAULT_MAX_DEPTH%3A%20usize%20%3D%201000%3B%0A%2F%2F%2F%20The%20default%20bound%20on%20memoized%20rule%20calls.%0Aconst%20DEFAULT_MEMO_LIMIT%3A%20usize%20%3D%201_000_000%3B%0A%2F%2F%2F%20The%20default%20memory%20budget%20of%20a%20parse%2C%20in%20memo%20cells.%0Aconst%20DEFAULT_MEMORY_LIMIT%3A%20usize%20%3D%202_000_000%3B%0A%2F%2F%2F%20The%20stack%20of%20the%20thread%20a%20parse%20runs%20on%3B%20the%20executor%27s%20frame%20bound%20keeps%0A%2F%2F%2F%20a%20parse%20well%20inside%20it.%0Aconst%20PARSE_STACK%3A%20usize%20%3D%20256%20%2A%201024%20%2A%201024%3B%0A%0A%2F%2F%2F%20The%20limits%20and%20policies%20of%20a%20parse.%20Every%20field%20left%20%60None%60%20keeps%20the%0A%2F%2F%2F%20value%20the%20parser%20was%20compiled%20with%2C%20and%20then%20the%20default.%0A%23%5Bderive%28Clone%2C%20Debug%2C%20Default%2C%20PartialEq%2C%20Eq%29%5D%0Apub%20struct%20FeatureParseOptions%20%7B%0A%20%20%20%20%2F%2F%2F%20Explicit%20root%20grammar%20identity%20for%20a%20stored%20qualified%20invocation.%0A%20%20%20%20pub%20grammar_name%3A%20Option%3CString%3E%2C%0A%20%20%20%20%2F%2F%2F%20Existing%20checked%20global%20concept%20space%2C%20including%20definitions%20and%20origins.%0A%20%20%20%20pub%20global_concept_space%3A%20Option%3Cserde_json%3A%3AValue%3E%2C%0A%20%20%20%20%2F%2F%2F%20The%20rule%20to%20parse%20from%20instead%20of%20the%20grammar%27s%20start%20rule.%0A%20%20%20%20pub%20start_rule%3A%20Option%3CString%3E%2C%0A%20%20%20%20%2F%2F%2F%20The%20bound%20on%20nested%20rule%20calls%20%28default%201000%29.%0A%20%20%20%20pub%20max_depth%3A%20Option%3Cusize%3E%2C%0A%20%20%20%20%2F%2F%2F%20The%20bound%20on%20evaluation%20steps%20%28default%20%60100000%20%2B%201000%20%2A%20input%20length%60%2C%0A%20%20%20%20%2F%2F%2F%20twice%20that%20with%20error%20recovery%29.%0A%20%20%20%20pub%20step_limit%3A%20Option%3Cusize%3E%2C%0A%20%20%20%20%2F%2F%2F%20The%20bound%20on%20memoized%20rule%20calls%20%28default%201000000%29.%0A%20%20%20%20pub%20memo_limit%3A%20Option%3Cusize%3E%2C%0A%20%20%20%20%2F%2F%2F%20The%20memory%20budget%20of%20the%20whole%20parse%2C%20its%20runs%2C%20repair%20rounds%20and%0A%20%20%20%20%2F%2F%2F%20embedded%20languages%20included%2C%20in%20memo%20cells%3A%20one%20per%20rule%20call%20recorded%0A%20%20%20%20%2F%2F%2F%20and%20one%20per%20result%20such%20a%20call%20keeps%2C%20counted%20and%20never%20released.%0A%20%20%20%20%2F%2F%2F%20Fixed%20lexical%20cache%20cells%20also%20count%20while%20retained%3B%20those%20optional%0A%20%20%20%20%2F%2F%2F%20entries%20may%20be%20discarded%20to%20free%20space%20%28default%202000000%29.%20A%20parse%0A%20%20%20%20%2F%2F%2F%20whose%20rule%20cells%20need%20more%20is%20rejected%20with%20%60memoryBudget%60.%0A%20%20%20%20pub%20memory_limit%3A%20Option%3Cusize%3E%2C%0A%20%20%20%20%2F%2F%2F%20Whether%20a%20reported%20ambiguity%20rejects%20the%20input%20%28default%20false%29.%0A%20%20%20%20pub%20reject_ambiguity%3A%20Option%3Cbool%3E%2C%0A%20%20%20%20%2F%2F%2F%20Whether%20a%20tree%20with%20ERROR%20or%20MISSING%20nodes%20is%20accepted%20%28default%20false%29.%0A%20%20%20%20pub%20accept_recovery%3A%20Option%3Cbool%3E%2C%0A%20%20%20%20%2F%2F%2F%20Whether%20a%20failed%20parse%20is%20repaired%20into%20a%20tree%20with%20ERROR%20or%20MISSING%0A%20%20%20%20%2F%2F%2F%20nodes%20instead%20of%20rejected%20without%20a%20tree%20%28default%20false%29.%0A%20%20%20%20pub%20error_recovery%3A%20Option%3Cbool%3E%2C%0A%20%20%20%20%2F%2F%2F%20The%20bound%20on%20repair%20points%20of%20automatic%20recovery%20%28default%2032%29.%0A%20%20%20%20pub%20max_repairs%3A%20Option%3Cusize%3E%2C%0A%20%20%20%20%2F%2F%2F%20Decorators%20of%20the%20%60grammar-rule%60%20level%2C%20applied%20to%20the%20grammar%20a%0A%20%20%20%20%2F%2F%2F%20parser%20is%20compiled%20from%2C%20and%20of%20the%20%60executor%60%20and%20%60recovery%60%20levels%2C%0A%20%20%20%20%2F%2F%2F%20applied%20to%20every%20tree%20%28see%20%5B%60decorate_syntax_tree%60%5D%29.%20An%20empty%20set%0A%20%20%20%20%2F%2F%2F%20keeps%20the%20decorators%20the%20parser%20was%20compiled%20with.%0A%20%20%20%20pub%20decorators%3A%20DecoratorSet%2C%0A%7D%0A%0Aimpl%20FeatureParseOptions%20%7B%0A%20%20%20%20fn%20over%28%26self%2C%20base%3A%20%26Self%29%20-%3E%20Self%20%7B%0A%20%20%20%20%20%20%20%20Self%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20grammar_name%3A%20self%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.grammar_name%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.clone%28%29%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.or_else%28%7C%7C%20base.grammar_name.clone%28%29%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20global_concept_space%3A%20self%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.global_concept_space%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.clone%28%29%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.or_else%28%7C%7C%20base.global_concept_space.clone%28%29%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20start_rule%3A%20self.start_rule.clone%28%29.or_else%28%7C%7C%20base.start_rule.clone%28%29%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20max_depth%3A%20self.max_depth.or%28base.max_depth%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20step_limit%3A%20self.step_limit.or%28base.step_limit%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20memo_limit%3A%20self.memo_limit.or%28base.memo_limit%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20memory_limit%3A%20self.memory_limit.or%28base.memory_limit%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20reject_ambiguity%3A%20self.reject_ambiguity.or%28base.reject_ambiguity%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20accept_recovery%3A%20self.accept_recovery.or%28base.accept_recovery%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20error_recovery%3A%20self.error_recovery.or%28base.error_recovery%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20max_repairs%3A%20self.max_repairs.or%28base.max_repairs%29%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20decorators%3A%20if%20self.decorators.is_empty%28%29%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20base.decorators.clone%28%29%0A%20%20%20%20%20%20%20%20%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20self.decorators.clone%28%29%0A%20%20%20%20%20%20%20%20%20%20%20%20%7D%2C%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%7D%0A%0A%2F%2F%2F%20Why%20a%20parse%20rejects%20its%20input%2C%20and%20where.%0A%23%5Bderive%28Clone%2C%20Debug%2C%20PartialEq%2C%20Eq%29%5D%0Apub%20struct%20ParseRejection%20%7B%0A%20%20%20%20%2F%2F%2F%20Precise%20unknown%2C%20unsupported%20mapping%2C%20origin%20or%20embedding-cycle%20records.%0A%20%20%20%20pub%20diagnostics%3A%20Option%3CVec%3Cserde_json%3A%3AValue%3E%3E%2C%0A%20%20%20%20%2F%2F%2F%20Mapped%20diagnostics%20cover%20source%20spellings%20rather%20than%20exact%20interior%20bytes.%0A%20%20%20%20pub%20offset_semantics%3A%20Option%3CString%3E%2C%0A%20%20%20%20%2F%2F%2F%20%60syntax%60%2C%20%60nestingDepth%60%2C%20%60stepLimit%60%2C%20%60memoryBudget%60%2C%20%60recovered%60%20or%0A%20%20%20%20%2F%2F%2F%20%60ambiguity%60.%0A%20%20%20%20pub%20reason%3A%20%26%27static%20str%2C%0A%20%20%20%20%2F%2F%2F%20The%20byte%20offset%2C%20for%20a%20positioned%20rejection.%0A%20%20%20%20pub%20offset%3A%20Option%3Cusize%3E%2C%0A%20%20%20%20%2F%2F%2F%20The%201-based%20line%20of%20the%20offset.%0A%20%20%20%