on%20restore%28source%2Cfile%2Cpacket%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bconst%20row%3D%5Bpacket.artifact%2Cpacket.register%2Cpacket.loan%5D.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28row%2C%27one%20exact%20artifact%20path%27%29%3B%0A%20%20if%28source%3D%3D%3Drow.sourceText%29return%20source%3B%0A%20%20assert.deepEqual%28pin%28source%29%2Crow.current%2C%27an%20unknown%20whole%20artifact%20cannot%20acquire%20historical%20authority%27%29%3B%0A%20%20const%20value%3DreadStructuredDataLino%28source%29%3B%0A%20%20if%28file%3D%3D%3DartifactFile%29%7Bassert.equal%28descriptorTargets%28value%29.alias%2Cpacket.inferenceDescriptorAlias%29%3Bapply%28value%2Cpacket.edge.changes%2C%27inverse%27%29%3B%7D%0A%20%20else%20if%28file%3D%3D%3DregisterFile%29%7Bassert.equal%28Object.keys%28value%29.at%28-1%29%2Cproperty%29%3Bassert.deepEqual%28value%5Bproperty%5D%2C%5Bpacket.edge%5D%29%3Bdelete%20value%5Bproperty%5D%3B%7D%0A%20%20else%7Bassert.deepEqual%28%7Bbytes%3Avalue.predecessor.bytes%2Csha256%3Avalue.predecessor.sha256%7D%2Cpacket.edge.current%29%3BObject.assign%28value.predecessor%2Cpacket.edge.previous%29%3B%7D%0A%20%20const%20previous%3DserializeProjectData%28value%2Cfile%29%3Bassert.equal%28previous%2Crow.sourceText%2C%27the%20exact%20whole%20certified%20predecessor%20is%20recovered%27%29%3Breturn%20previous%3B%0A%7D%0Aexport%20function%20restoreCurrentOwnCodebaseRawText%28source%2Cfile%29%7Breturn%20restore%28source%2Cfile%2Cload%28%29%29%3B%7D%0Aexport%20function%20restoreCurrentOwnCodebaseRawData%28value%2Cfile%29%7Breturn%20readStructuredDataLino%28restore%28serializeProjectData%28value%2Cfile%29%2Cfile%2Cload%28%29%29%29%3B%7D%0A%0A%2F%2A%2A%20One%20outer%20boundary%3B%20old%20APIs%2C%20policies%20and%20packets%20retain%20their%20identities.%20%2A%2F%0Aexport%20function%20restoreCurrentOwnCodebaseRawEdge%28artifact%2Cidentity%2Cregister%29%7B%0A%20%20if%28%21Object.hasOwn%28register%2Cproperty%29%29return%7Bartifact%2Cregister%7D%3