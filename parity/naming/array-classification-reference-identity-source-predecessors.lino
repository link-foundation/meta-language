27eb349133f29d2e5944ace3b96975d508a92d265231518ac2b99a604129c7b48a%27%7D%29%2C%0A%5D%29%3B%0Aexport%20const%20RAW_CONSUMING_SNAPSHOT_BOUNDARY%3D%27Five%20complete%20source%20identities%20serve%20only%20the%20frozen%20raw%20consuming%20artifact%20and%20its%20historical%20consumers.%20Three%20original%20source%20certificates%20are%20projected%20automatically%20from%20existing%20archives%3B%20only%20the%20missing%20consuming%20host%20and%20checker%20are%20captured%20once.%20Complete%20stored%20source%20certificates%20make%20later%20freshness%20independent%20of%20those%20archives.%20The%20current%20producer%20retains%20its%20physical%20source%20metadata%20separately%20and%20must%20reproduce%20every%20complete%20original%20semantic%20artifact%20field%20and%20both%20codecs%20before%20snapshot%20comparison.%20Source%20conservation%20is%20not%20general%20semantic%20equivalence%20or%20native%20execution%20evidence.%27%3B%0Aconst%20packetSha256%3D%27ef289a9e8a67d0deccb22cd943831ae0860053ea3b5267aaba9d208dc12e0b4f%27%3B%0Aexport%20const%20pinRawConsumingSnapshotSource%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20keys%3D%28value%2Cnames%29%3D%3Eassert.deepEqual%28Object.keys%28value%29.sort%28%29%2C%5B...names%5D.sort%28%29%29%3B%0Alet%20cached%3B%0A%0Afunction%20verifyPreviousSource%28row%2Cexpected%29%7B%0A%20%20keys%28row%2C%5B%27file%27%2C%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27certificate%27%5D%29%3B%0A%20%20assert.equal%28row.file%2Cexpected.file%29%3Bassert.equal%28typeof%20row.source%2C%27string%27%29%3B%0A%20%20assert.deepEqual%28pinRawConsumingSnapshotSource%28row.source%29%2C%7Bbytes%3Aexpected.bytes%2Csha256%3Aexpected.sha256%7D%29%3B%0A%20%20assert.deepEqual%28%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%2CpinRawConsumingSnapshotSource%28row.source%29%29%3B%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%3ARAW_CONSUMING_SNAPSHOT_REVISION%2Cpath%3Arow.file%7D%29%3B%0A%20%20return%20row%3B%0A%7D%0A%0A%2F%2A%2A%20First%20capture%20only%3A%20project%20three%20existing%20independently%20certified%20source%0A%20%2A%20rows.%20Their%20exact8d%20Git%20membership%20is%20authority%2C%20not%20archive%20freshness%20or%20an%0A%20%2A%20assumption%20about%20current%20provider%20behavior.%20Later%20checks%20need%20no%20archives.%20%2A%2F%0Aexport%20function%20readArchivedRawConsumingSnapshotSources%28%29%7B%0A%20%20const%20archive%3Dfile%3D%3E%7Bconst%20bytes%3DreadFileSync%28new%20URL%28file%2Croot%29%29%3Bassert.ok%28bytes.length%3C%3D16%2A1024%2A1024%29%3Breturn%20readBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%7D%3B%0A%20%20const%20providers%3Darchive%28%27parity%2Fself-translation%2Freviewed-overlay-provider-succession.lino%27%29%3B%0A%20%20const%20profiles%3Dproviders.profiles.filter%28row%3D%3Erow.sourceCommit%3D%3D%3DRAW_CONSUMING_SNAPSHOT_REVISION%29%3B%0A%20%20assert.equal%28profiles.length%2C1%29%3B%0A%20%20const%20owned%3Darchive%28%27parity%2Fself-translation%2Frelative-array-owned-rule-source-history.lino%27%29%3B%0A%20%20assert.equal%28owned.revision%2CRAW_CONSUMING_SNAPSHOT_REVISION%29%3B%0A%20%20return%20RAW_CONSUMING_SNAPSHOT_FILES.slice%282%29.map%28expected%3D%3E%7B%0A%20%20%20%20let%20source%2Ccertificate%3B%0A%20%20%20%20if%28expected.file%3D%3D%3Downed.source%29%7B%28%7Bsource%2Ccertificate%7D%3Downed.previous%29%3B%7D%0A%20%20%20%20else%7B%0A%20%20%20%20%20%20const%20entries%3Dprofiles%5B0%5D.certificates.filter%28row%3D%3E%27js%2Fsrc%2F%27%2Brow.module%3D%3D%3Dexpected.file%29%3Bassert.equal%28entries.length%2C1%29%3B%0A%20%20%20%20%20%20%28%7Bsource%2Ccertificate%7D%3Dentries%5B0%5D.current%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20return%20verifyPreviousSource%28%7Bfile%3Aexpected.file%2Csource%2C...pinRawConsumingSnapshotSource%28source%29%2Ccertificate%7D%2Cexpected%29%3B%0A%20%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20A%20finite%20automatically%20discovered%20complete-source%20interval.%20%2A%2F%0Aexport%20function%20deriveRawConsumingSnapshotSourceInterval%28previous%2Ccurrent%29%7B%0A%20%20const%20before%3D%5B...previous%5D%2Cafter%3D%5B...current%5D%3Blet%20start%3D0%2ColdEnd%3Dbefore.length%2Cend%3Dafter.length%3B%0A%20%20while%28start%3ColdEnd%26%26start%3Cend%26%26before%5Bstart%5D%3D%3D%3Dafter%5Bstart%5D%29start%2B%3D1%3B%0A%20%20while%28oldEnd%3Estart%26%26end%3Estart%26%26before%5BoldEnd-1%5D%3D%3D%3Dafter%5Bend-1%5D%29%7BoldEnd-%3D1%3Bend-%3D1%3B%7D%0A%20%20return%7Bstart%3Abefore.slice%280%2Cstart%29.join%28%27%27%29.length%2Cremoved%3Abefore.slice%28start%2ColdEnd%29.join%28%27%27%29%2Cinserted%3Aafter.slice%28start%2Cend%29.join%28%27%27%29%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Structure%2Fcertificates%20do%20not%20grant%20current%20packet%20identity.%20%2A%2F%0Aexport%20function%20verifyRawConsumingSnapshotSourceStructure%28packet%2C%7BbindCurrent%3Dtrue%7D%3D%7B%7D%29%7B%0A%20%20keys%28packet%2C%5B%27schemaVersion%27%2C%27model%27%2C%27revision%27%2C%27previous%27%2C%27sources%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27raw%20consuming%20snapshot%20source%20profile%201%27%29%3B%0A%20%20assert.equal%28packet.revision%2CRAW_CONSUMING_SNAPSHOT_REVISION%29%3Bassert.equal%28packet.boundary%2CRAW_CONSUMING_SNAPSHOT_BOUNDARY%29%3B%0A%20%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2CRAW_CONSUMING_SNAPSHOT_FILES.map%28row%3D%3Erow.file%29%29%3B%0A%20%20assert.deepEqual%28packet.previous.map%28row%3D%3Erow.file%29%2CRAW_CONSUMING_SNAPSHOT_FILES.map%28row%3D%3Erow.file%29%29%3B%0A%20%20const%20previous%3Dpacket.previous.map%28%28row%2Cindex%29%3D%3EverifyPreviousSource%28row%2CRAW_CONSUMING_SNAPSHOT_FILES%5Bindex%5D%29%29%3B%0A%20%20for%28const%5Bindex%2Crow%5Dof%20packet.sources.entries%28%29%29%7B%0A%20%20%20%20keys%28row%2C%5B%27file%27%2C%27source%27%2C%27bytes%27%2C%27sha256%27%2C%27coordinateUnit%27%2C%27edit%27%5D%29%3B%0A%20%20%20%20assert.equal%28typeof%20row.source%2C%27string%27%29%3Bassert.ok%28Buffer.byteLength%28row.source%29%3C%3D512%2A1024%29%3B%0A%20%20%20%20assert.deepEqual%28pinRawConsumingSnapshotSource%28row.source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20assert.equal%28row.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3Bkeys%28row.edit%2C%5B%27start%27%2C%27removed%27%2C%27inserted%27%5D%29%3B%0A%20%20%20%20const%20original%3Dprevious%5Bindex%5D.source%2Cedit%3Drow.edit%3B%0A%20%20%20%20assert.deepEqual%28edit%2CderiveRawConsumingSnapshotSourceInterval%28original%2Crow.source%29%29%3B%0A%20%20%20%20assert.equal%28original.slice%28edit.start%2Cedit.start%2Bedit.removed.length%29%2Cedit.removed%29%3B%0A%20%20%20%20assert.equal%28original.slice%280%2Cedit.start%29%2Bedit.inserted%2Boriginal.slice%28edit.start%2Bedit.removed.length%29%2Crow.source%29%3B%0A%20%20%20%20assert.equal%28row.source.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20assert.equal%28row.source.slice%280%2Cedit.start%29%2Bedit.removed%2Brow.source.slice%28edit.start%2Bedit.inserted.length%29%2Coriginal%2C%27every%20certified%20historical%20source%20byte%20survives%27%29%3B%0A%20%20%20%20if%28bindCurrent%29assert.equal%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.source%2C%27actual%20final-use%20decision%20sources%20changed%3A%20%27%2Brow.file%29%3B%0A%20%20%7D%0A%20%20return%20packet%3B%0A%7D%0A%0Afunction%20load%28bindCurrent%29%7B%0A%20%20if%28%21cached%29%7B%0A%20%20%20%20assert.match%28packetSha256%2C%2F%5E%5Ba-f0-9%5D%7B64%7D%24%2Fu%2C%27the%20normal%20source%20author%20must%20capture%20this%20profile%20first%27%29%3B%0A%20%20%20%20const%20file%3Dnew%20URL%28RAW_CONSUMING_SNAPSHOT_OUTPUT%2Croot%29%2Cbytes%3DreadFileSync%28file%29%3B%0A%20%20%20%20assert.equal%28pinRawConsumingSnapshotSource%28bytes%29.sha256%2CpacketSha256%2C%27the%20complete%20independently%20pinned%20source%20profile%20stays%20exact%27%29%3B%0A%20%20%20%20cached%3DverifyRawConsumingSnapshotSourceStructure%28readProjectData%28file%29%2C%7BbindCurrent%3Afalse%7D%29%3B%0A%20%20%7D%0A%20%20if%28bindCurrent%29for%28const%20row%20of%20cached.sources%29assert.equal%28readFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%2Crow.source%2C%27actual%20final-use%20decision%20sources%20changed%3A%20%27%2Brow.file%29%3B%0A%20%20return%20cached%3B%0A%7D%0Aexport%20function%20readRawConsumingSnapshotSourceProfile%28%29%7Breturn%20structuredClone%28load%28true%29%29%3B%7D%0Aexport%20function%20readCertifiedRawConsumingSnapshotSources%28%29%7Breturn%20structuredClone%28load%28false%29.previous%29%3B%7D%0A%0A%2F%2A%2A%20Only%20these%20five%20exact%20current%20files%20acquire%20their%20recorded%20snapshot%20source%3B%0A%20%2A%20all%20other%20paths%20are%20identities%2C%20and%20even%20one%20unknown%20selected%20byte%20refuses.%20%2A%2F%0Aexport%20function%20restoreRawConsumingSnapshotSource%28bytes%2Cfile%2CcurrentOnly%3Dfalse%29%7B%0A%20%20const%20index%3DRAW_CONSUMING_SNAPSHOT_FILES.findIndex%28row%3D%3Erow.file%3D%3D%3Dfile%29%3B%0A%20%20if%28index%3C0%29return%20bytes%3B%0A%20%20const%20packet%3Dload%28true%29%2Crow%3Dpacket.sources%5Bindex%5D%3B%0A%20%20assert.ok%28Buffer.isBuffer%28bytes%29%2C%27complete%20current%20source%20bytes%20are%20required%27%29%3B%0A%20%20if%28currentOnly%26%26bytes.toString%28%27utf8%27%29%21%3D%3Drow.source%29return%20bytes%3B%0A%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2Crow.source%2C%27actual%20final-use%20decision%20sources%20changed%3A%20%27%2Bfile%29%3B%0A%20%20assert.deepEqual%28pinRawConsumingSnapshotSource%28bytes%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20return%20Buffer.from%28packet.previous%5Bindex%5D.source%29%3B%0A%7D%0Aexport%20function%20rawConsumingSnapshotSourceReader%28read%29%7B%0A%20%20const%20selected%3Dnew%20Map%28RAW_CONSUMING_SNAPSHOT_FILES.map%28row%3D%3E%5BString%28new%20URL%28row.file%2Croot%