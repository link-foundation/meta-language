trols.%20The%20helper%20also%0A%20%20%2F%2F%20authenticates%20the%20complete%20historical%20Rust%20source%20and%20byte-exact%20corrected%0A%20%20%2F%2F%20test%20bodies%2C%20rather%20than%20using%20an%20instruction%20or%20a%20fixture%20label%20as%20proof.%0A%20%20const%20execution%20%3D%20runModernArrayParityAssertions%28%29%3B%0A%20%20assert.deepEqual%28execution.cases.filter%28row%20%3D%3E%20row.originalStdout%20%21%3D%3D%20undefined%29.map%28row%20%3D%3E%20row.id%29%2C%20%5B%0A%20%20%20%20%27original-array-corpus%27%2C%20%27original-empty-array-inference%27%2C%20%27original-data-array%27%2C%0A%20%20%20%20%27original-string-length%27%2C%20%27supplementary-string-length%27%2C%20%27observable-array-absence%27%2C%0A%20%20%5D%29%3B%0A%20%20assert.equal%28execution.cases.length%2C%2011%29%3B%0A%20%20assert.equal%28execution.metadata.admitted%2C%206%29%3B%0A%20%20assert.equal%28execution.metadata.refused%2C%205%29%3B%0A%20%20assert.equal%28execution.metadata.nodeVersion%2C%20process.versions.node%29%3B%0A%20%20for%20%28const%20row%20of%20execution.cases%29%20%7B%0A%20%20%20%20for%20%28const%20%7B%20descriptor%20%7D%20of%20row.targets%29%20%7B%0A%20%20%20%20%20%20if%20%28row.originalStdout%20%21%3D%3D%20undefined%29%20assert.equal%28descriptor.diagnostic%2C%20null%29%3B%0A%20%20%20%20%20%20else%20assert.ok%28descriptor.diagnostic%2C%20%27a%20corrected%20expectation%20never%20drops%20a%20genuine%20refusal%27%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%0A%20%20recordIssue195Observations%28%7B%0A%20%20%20%20requirementId%3A%20%27I195-ASSERTION-EVIDENCE-BASED-CORRECTION%27%2C%20runtime%3A%20%27tooling%27%2C%20suffix%3A%20%27behavior%27%2C%0A%20%20%20%20fixtureId%3A%20%27conversation-contract%3AcompactContributorInstructionsRequest%27%2C%0A%20%20%20%20fixtureFile%3A%20%27parity%2Fsources%2Fcompact-contributor-instructions-and-assertion-corrections-2026-10-16.txt%27%2C%0A%20%20%20%20assertions%3A%20%5B%27wrongAssertionCorrectionSupportedByEvidence%27%2C%20%27originalInputsAndCoverageRetained%27%2C%0A%20%20%20%20%20%20%27correctedApplicableAssertionsExecuted%27%5D%2C%0A%20%20%20%20testName%3A%20context.name%2C%0A%20%20%7D%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
