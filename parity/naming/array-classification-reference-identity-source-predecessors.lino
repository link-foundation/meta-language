orpus%27%2C%27original-empty-array-inference%27%2C%27original-data-array%27%2C%0A%20%27original-array-console-refusal%27%2C%27original-array-mutation-refusal%27%2C%27original-array-identity-refusal%27%2C%27original-string-length%27%2C%0A%20%27original-array-hole-refusal%27%2C%27original-for-in-refusal%27%2C%27supplementary-string-length%27%2C%27observable-array-absence%27%5D%29%3B%0Aexport%20const%20MODERN_ARRAY_IN_BOUNDS%3D%27the%20translation%20agrees%20with%20the%20source%20on%20executions%20whose%20array%20reads%20are%20in%20bounds%3B%20JavaScript%20reads%20undefined%20at%20an%20index%20outside%20an%20array%2C%20where%20the%20target%20aborts%27%3B%0Aconst%20digest%3Dvalue%3D%3EcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0Aconst%20literal%3Dnode%3D%3E%7Bassert.ok%28ts.isStringLiteral%28node%29%7C%7Cts.isNoSubstitutionTemplateLiteral%28node%29%2C%27an%20actual%20complete%20literal%20is%20required%27%29%3Breturn%20node.text%3B%7D%3B%0Afunction%20visit%28node%2Ccallback%29%7Bcallback%28node%29%3Bts.forEachChild%28node%2Cchild%3D%3Evisit%28child%2Ccallback%29%29%3B%7D%0Afunction%20originalBody%28source%29%7Bconst%20at%3Dsource.indexOf%28MODERN_ARRAY_APPEND_MARKER%29%3Bif%28at%3C0%29return%20source%3Bassert.equal%28source.split%28MODERN_ARRAY_APPEND_MARKER%29.length%2C2%29%3Breturn%20source.slice%280%2Cat%29%3B%7D%0Afunction%20readOriginalJavaScriptInputs%28source%29%7B%0A%20const%20tree%3Dts.createSourceFile%28%27translation-arrays.test.js%27%2Csource%2Cts.ScriptTarget.Latest%2Ctrue%2Cts.ScriptKind.JS%29%3B%0A%20assert.equal%28tree.parseDiagnostics.length%2C0%29%3B%0A%20const%20calls%3Dtree.statements.filter%28node%3D%3Ets.isExpressionStatement%28node%29%26%26ts.isCallExpression%28node.expression%29%0A%20%20%26%26ts.isIdentifier%28node.expression.expression%29%26%26node.expression.expression.text%3D%3D%3D%27test%27%29.map%28node%3D%3Enode.expression%29%3B%0A%20assert.equal%28calls.length%2C5%2C%27all%20five%20original%20callback%20bodies%20remain%27%29%3B%0A%20let%20arrays%3B%0A%20for%28const%20node%20of%20tree.statements%29if%28ts.isVariableStatement%28node%29%29for%28const%20declaration%20of%20node.declarationList.declarations%29%0A%20%20if%28ts.isIdentifier%28declaration.name%29%26%26declaration.name.text%3D%3D%3D%27ARRAYS%27%29arrays%3Dliteral%28declaration.initializer%29%3B%0A%20assert.equal%28typeof%20arrays%2C%27string%27%29%3B%0A%20const%20readLocalSource%3Dtitle%3D%3E%7B%0A%20%20const%20selected%3Dcalls.filter%28call%3D%3Eliteral%28call.arguments%5B0%5D%29%3D%3D%3Dtitle%29%3Bassert.equal%28selected.length%2C1%29%3B%0A%20%20const%20found%3D%5B%5D%3Bvisit%28selected%5B0%5D.arguments%5B1%5D%2Cnode%3D%3E%7Bif%28ts.isVariableDeclaration%28node%29%26%26ts.isIdentifier%28node.name%29%26%26node.name.text%3D%3D%3D%27source%27%29found.push%28literal%28node.initializer%29%29%3B%7D%29%3B%0A%20%20assert.equal%28found.length%2C1%29%3Breturn%20found%5B0%5D%3B%0A%20%7D%3B%0A%20const%20refusalCall%3Dcalls.find%28call%3D%3Eliteral%28call.arguments%5B0%5D%29%3D%3D%3D%27the%20array%20forms%20that%20are%20not%20kept%20are%20refused%20with%20a%20reason%27%29%3Bassert.ok%28refusalCall%29%3B%0A%20const%20refusals%3D%5B%5D%3Bvisit%28refusalCall.arguments%5B1%5D%2Cnode%3D%3E%7Bif%28ts.isCallExpression%28node%29%26%26ts.isIdentifier%28node.expression%29%26%26node.expression.text%3D%3D%3D%27refusal%27%29refusals.push%28literal%28node.arguments%5B0%5D%29%29%3B%7D%29%3B%0A%20const%20distinct%3D%5B...new%20Set%28refusals%29%5D%3Bassert.equal%28distinct.length%2C6%29%3B%0A%20return%20%5Barrays%2CreadLocalSource%28%27inference%20fixes%20the%20element%20type%20of%20an%20empty%20array%20from%20its%20later%20use%27%29%2C%0A%20%20readLocalSource%28%27a%20%40typedef%20field%20may%20hold%20an%20array%2C%20of%20data%20too%27%29%2C...distinct%5D%3B%0A%7D%0Afunction%20readNativeSourceLiteral%28source%2Cname%29%7B%0A%20const%20tokens%3Dtokenize%28source%2C%27Rust%27%29.tokens%3B%0A%20const%20positions%3Dtokens.flatMap%28%28token%2Cindex%29%3D%3Etoken.value%3D%3D%3D%27fn%27%26%26tokens%5Bindex%2B1%5D%3F.value%3D%3D%3Dname%3F%5Bindex%5D%3A%5B%5D%29%3Bassert.equal%28positions.length%2C1%29%3B%0A%20let%20open%3Dpositions%5B0%5D%3Bwhile%28tokens%5Bopen%5D%3F.value%21%3D%3D%27%7B%27%29open%2B%3D1%3B%0A%20let%20depth%3D1%2Cend%3Dopen%2B1%3Bfor%28%3Bend%3Ctokens.length%26%26depth%3Bend%2B%2B%29%7Bif%28tokens%5Bend%5D.kind%21%3D%3D%27punct%27%29continue%3Bif%28tokens%5Bend%5D.value%3D%3D%3D%27%7B%27%29depth%2B%2B%3Bif%28tokens%5Bend%5D.value%3D%3D%3D%27%7D%27%29depth--%3B%7D%0A%20assert.equal%28depth%2C0%29%3Bconst%20body%3Dtokens.slice%28open%2B1%2Cend-1%29%2Cfound%3D%5B%5D%3B%0A%20for%28let%20at%3D0%3Bat%3Cbody.length%3Bat%2B%2B%29if%28body%5Bat%5D.value%3D%3D%3D%27let%27%26%26body%5Bat%2B1%5D%3F.value%3D%3D%3D%27source%27%26%26body%5Bat%2B2%5D%3F.value%3D%3D%3D%27%3D%27%29%7B%0A%20%20assert.equal%28body%5Bat%2B3%5D%3F.kind%2C%27string%27%29%3Bfound.push%28body%5Bat%2B3%5D.value%29%3B%0A%20%7D%0A%20assert.equal%28found.length%2C1%29%3Breturn%20found%5B0%5D%3B%0A%7D%0Aexport%20function%20buildModernArrayParityFixture%28%7BhistoricalSource%7D%3D%7B%7D%29%7B%0A%20const%20target%3Dnew%20URL%28MODERN_ARRAY_FIXTURE_FILE%2Croot%29%3B%0A%20if%28historicalSource%3D%3D%3Dundefined%29%7Bassert.ok%28existsSync%28target%29%2C%27first%20authoring%20requires%20explicit%20Root-supplied%20historical%20source%27%29%3BhistoricalSource%3DreadProjectData%28target%29.historicalNative.source%3B%7D%0A%20assert.equal%28digest%28historicalSource%29%2ChistoricalSha256%2C%27the%20complete%20Root-authenticated%20historical%20source%20stays%20immutable%27%29%3B%0A%20assert.equal%28Buffer.byteLength%28historicalSource%29%2C5228%29%3B%0A%20const%20contract%3DreadFileSync%28new%20URL%28MODERN_ARRAY_CONTRACT_FILE%2Croot%29%29%3Bassert.equal%28digest%28contract%29%2CMODERN_ARRAY_CONTRACT_SHA256%29%3B%0A%20const%20bases%3DcurrentProfiles.map%28%28%5Bpath%2Csha256%5D%29%3D%3E%7Bconst%20source%3DoriginalBody%28readFileSync%28new%20URL%28path%2Croot%29%2C%27utf8%27%29%29%3Bassert.equal%28digest%28source%29%2Csha256%2C%27every%20original%20test%20body%20remains%20byte%20exact%27%29%3Breturn%20%7Bpath%2Csource%2Csha256%2Cbytes%3ABuffer.byteLength%28source%29%7D%3B%7D%29%3B%0A%20const%20originals%3DreadOriginalJavaScriptInputs%28bases%5B0%5D.source%29%3Bassert.equal%28originals.length%2C9%29%3Bassert.equal%28new%20Set%28originals%29.size%2C9%29%3B%0A%20const%20oldLiterals%3Dtokenize%28historicalSource%2C%27Rust%27%29.tokens.filter%28token%3D%3Etoken.kind%3D%3D%3D%27string%27%29.map%28token%3D%3Etoken.value%29%3B%0A%20for%28const%20source%20of%20originals%29assert.ok%28oldLiterals.includes%28source%29%2C%27the%20complete%20original%20input%20also%20occurs%20in%20the%20historical%20native%20test%27%29%3B%0A%20assert.ok%28historicalSource.includes%28%27assert%21%28contract.assumptions.contains%28%26IN_BOUNDS%29%27%29%29%3B%0A%20const%20oldStringDiagnostic%3D%27length%20of%20a%20string%3A%20String.prototype.length%20counts%20UTF-16%20code%20units%2C%20which%20the%20portable%20string%20types%20do%20not%20keep%20at%2028..36%27%3B%0A%20assert.ok%28oldLiterals.includes%28oldStringDiagnostic%29%29%3B%0A%20const%20sources%3D%5B...originals%2CreadNativeSourceLiteral%28bases%5B1%5D.source%2C%27utf16_string_length_retains_supplementary_characters_in_each_target%27%29%2C%0A%20%20readNativeSourceLiteral%28bases%5B1%5D.source%2C%27out_of_bounds_array_reads_retain_absence_instead_of_an_in_bounds_assumption%27%29%5D%3B%0A%20const%20expected%3D%5B%0A%20%20%7Boutcome%3A%27admitted%27%2Cstdout%3A%274%5Cn3n%5Cn%27%7D%2C%7Boutcome%3A%27admitted%27%2Cstdout%3A%273%5Cn%27%7D%2C%7Boutcome%3A%27admitted%27%2Cstdout%3A%272%5Cn%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27exact%27%2Cdiagnostic%3A%27text%20of%20an%20array%3A%20console.log%20lays%20an%20array%20out%20with%20util.inspect%20and%20String%20joins%20its%20elements%20with%20commas%2C%20which%20the%20translation%20does%20not%20reproduce%20yet%3B%20print%20the%20elements%20one%20by%20one%20at%2031..33%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27exact%27%2Cdiagnostic%3A%27reference%20mutation%3A%20this%20mutation%20requires%20its%20shared%20reference%20and%20slot%20operations%20to%20be%20represented%20at%2019..28%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27exact%27%2Cdiagnostic%3A%27comparison%20of%20arrays%3A%20%3D%3D%3D%20of%20two%20arrays%20compares%20which%20array%20each%20is%2C%20which%20a%20value%20translation%20does%20not%20keep%3B%20compare%20their%20elements%20at%2031..40%27%7D%2C%0A%20%20%7Boutcome%3A%27admitted%27%2Cstdout%3A%272%5Cn%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27prefix%27%2Cdiagnostic%3A%27array%20hole%27%7D%2C%0A%20%20%7Boutcome%3A%27refused%27%2Cmatch%3A%27prefix%27%2Cdiagnostic%3A%27for%E2%80%A6in%20loop%27%7D%2C%0A%20%20%7Boutcome%3A%27admitted%27%2Cstdout%3A%274%5Cn%27%7D%2C%7Boutcome%3A%27admitted%27%2Cstdout%3A%279%5Cn%27%7D%2C%0A%20%5D%3B%0A%20return%20%7BschemaVersion%3A1%2Cmodel%3A%27retained%20modern%20JavaScript%20array%20parity%201%27%2Ccontract%3A%7BfixtureId%3AMODERN_ARRAY_CONTRACT_ID%2Cpath%3AMODERN_ARRAY_CONTRACT_FILE%2Csha256%3AMODERN_ARRAY_CONTRACT_SHA256%7D%2C%0A%20%20historicalNative%3A%7Bpath%3A%27rust%2Ftests%2Funit%2Ftranslation_arrays.rs%27%2Crevision%3AhistoricalRevision%2Csource%3AhistoricalSource%2Cbytes%3A5228%2Csha256%3AhistoricalSha256%7D%2C%0A%20%20sourceProfiles%3Abases.map%28%28%7Bpath%2Csha256%2Cbytes%7D%29%3D%3E%28%7Bpath%2Csha256%2Cbytes%7D%29%29%2C%0A%20%20correction%3A%7Brevision%3A%2793c65ca1ada6c5001a56acc4430500e55062027a%27%2Cprevious%3A%7BinBoundsAssumptionRequired%3Atrue%2CstringLengthDiagnostic%3AoldStringDiagnostic%7D%2Ccurrent%3A%7BinBoundsAssumptionRequired%3Afalse%2CoriginalStringLengthAdmitted%3Atrue%7D%2C%0A%20%20%20basis%3A%27Correction%20of%20project%20expectations%2C%20not%20a%20dependency-version%20change.%20UTF-16%20length%20and%20absent%20numeric%20properties%20retain%20stable%20language%20semantics.%27%7D%2C%0A%20%20cases%3Asources.map%28%28source%2Cindex%29%3D%3E%28%7Bid%3AMODERN_ARRAY_CASE_IDS%5Bindex%5D%2Corigin%3Aindex%3C9%3F%27original%27%3A%27added%27%2Csource%2CsourceSha256%3Adigest%28source%29%2C%0A%20%20%20targets%3Aexpected%5Bindex%5D.outcome%3D%3D%3D%27refused%27%7C%7Cindex%3D%3D%3D1%3F%5B%27Rust%27%5D%3A%5B%27Rust%27%2C%27Lean%27%2C%27Rocq%27%5D%2Cexpected%3Aexpected%5Bindex%5D%7D%29%29%7D%3B%0A%7D%0Aexport%20function%20generateModernArrayParityFixtures%28%7Bcheck%3Dfalse%2ChistoricalSourcePath%7D%3D%7B%7D%29%7B%0A%20const%20fixture%3DbuildModernArrayParityFixture%28%7BhistoricalSource%3AhistoricalSourcePath%3D%3D%3Dundefined%3Fundefined%3AreadFileSync%28historicalSourcePath%2C%27utf8%27%29%7D%29%3B%0A%20if%28check%29checkProjectData%28new%20URL%28MODERN_ARRAY_FIXTURE_FILE%2Croot%29%2Cfixture%29%3Belse%20writeProjectData%28new%20URL%28MODERN_ARRAY_FIXTURE_FILE%2Croot%29%2Cfixture%29%3B%0A%20return%20fixture%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20const%20args%3Dprocess.argv.slice%282%29%3Blet%20check%3Dfalse%2ChistoricalSourcePath%3B%0A%20for%28let%20index%3D0%3Bindex%3Cargs.length%3Bindex%2B%2B%29%7B%0A%20%20if%28args%5Bindex%5D%3D%3D%3D%27--check%27%29%7Bassert.equal%28check%2Cfalse%29%3Bcheck%3Dtrue%3B%7D%0A%20%20else%20if%28args%5Bindex%5D%3D%3D%3D%27--historical-source%27%29%7Bassert.equal%28historicalSourcePath%2Cundefined%29%3BhistoricalSourcePath%3Dargs%5B%2B%2Bindex%5D%3Bassert.equal%28typeof%20historicalSourcePath%2C%27string%27%29%3B%7D%0A%20%20else%20throw%20new%20Error%28%27only%20--check%20and%20--historical-source%20PATH%20are%20accepted%27%29%3B%0A%20%7D%0A%20generateModernArrayParityFixtures%28%7Bcheck%2ChistoricalSourcePath%7D%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
