(103323: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20JavaScript%20frontend%20for%20the%20portable%20core.%20It%20reads%20the%20subset%20of%20modern%0A%2F%2F%20JavaScript%20the%20core%20can%20represent%20faithfully%3A%20Number%20and%20BigInt%20arithmetic%2C%0A%2F%2F%20strings%20and%20booleans%3B%20top-level%20functions%20and%20object-literal%20namespaces%20of%20methods%0A%2F%2F%20whose%20types%20come%20from%20JSDoc%20%28%60%40param%60%2C%20%60%40returns%60%2C%20and%20%60%40typedef%60%20unions%20of%0A%2F%2F%20%60%7B%20%24%3A%20%27tag%27%2C%20%E2%80%A6%20%7D%60%20object%20types%20for%20data%20types%29%20or%2C%20where%20JSDoc%20is%20silent%2C%0A%2F%2F%20are%20inferred%20from%20how%20the%20program%20uses%20them%3B%20bodies%20made%20of%20%60const%60%2C%0A%2F%2F%20%60if%60%2C%20%60return%60%2C%20%60throw%60%20and%20%60switch%60%20statements%3B%20and%20a%20top%20level%20of%0A%2F%2F%20%60console.log%60%2C%20%60const%60%20and%20%60node%3Aassert%60%20statements%2C%20which%20are%20the%0A%2F%2F%20program%27s%20effects.%20A%20function%20whose%20leading%20statements%20throw%20on%20a%20negative%0A%2F%2F%20argument%20takes%20a%20natural%20number.%20Everything%20else%20is%20rejected%20with%20a%20precise%0A%2F%2F%20obligation.%0A%0Aimport%20%7B%20TranslationError%2C%20typeError%2C%20unsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20findDocumentationParameterRange%2C%20findDefaultParameterReference%2C%20readArrayMethodForm%2C%20acceptArrayMethodArguments%2C%20readStringTestOperation%2C%20readStringMapOperation%2C%20readJavaScriptTemporalBindingRead%2C%20readJavaScriptLexicalDeclarationStep%2C%20readJavaScriptFieldSubstitutionPlan%2C%20acceptJavaScriptMutableArrayBinding%2C%20acceptJavaScriptMutableArrayBindingOwner%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0Aimport%20%7B%20inferJavaScriptTypes%20%7D%20from%20%27.%2Fjavascript-infer.js%27%3B%0Aimport%20%7B%20readJavaScriptTagOwnerPosition%2C%20readJavaScriptTagReceiverForm%2C%20readJavaScriptTagBindingStep%2C%20acceptJavaScriptTagHeaderFact%2C%20readJavaScriptTagDeclaredOwner%20%7D%20from%20%27.%2Fjavascript-tag-context-rules.js%27%3B%0Aimport%20%7B%20readCallableReferenceConstruct%2C%20readCallableReferenceObligation%2C%20readCallableSurfaceConstructor%20%7D%20from%20%27.%2Fcallable-source-rules.js%27%3B%0Aimport%20%7B%20imperative%2C%20lowerImperative%2C%20lowerTopLevel%2C%20statementUses%20%7D%20from%20%27.%2Fjavascript-lower.js%27%3B%0Aimport%20%7B%20TokenCursor%2C%20describe%2C%20tokenize%20%7D%20from%20%27.%2Flexer.js%27%3B%0Aimport%20%7B%20BOOL%2C%20FLOAT%2C%20INT%2C%20NAT%2C%20STRING%2C%20array%20%7D%20from%20%27.%2Ftypes.js%27%3B%0Aimport%20%7B%20arrayBindingNames%2C%20bindArrayElements%2C%20isLiteralBinding%2C%20readArrayBinding%2C%20readArrayBindingInitializer%2C%20readClosure%2C%20readCompositeType%2C%20validateClosureCaptures%20%7D%20from%20%27.%2Fjavascript-bindings.js%27%3B%0Aimport%20%7B%20hasStructuralIdentity%2C%20requiresReferenceSemantics%20%7D%20from%20%27.%2Freference-analysis.js%27%3B%0Aimport%20%7B%20acceptSurfaceRawMetadataField%2C%20selectSurfaceReferenceSemantics%20%7D%20from%20%27.%2Fsurface-raw-metadata-rules.js%27%3B%0Aimport%20%7B%20readOptionalLogicalMixingError%2C%20readOptionalSourceLiteral%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20acceptObjectFreezeOperand%2C%20acceptObjectPropertyDefinition%20%7D%20from%20%27.%2Fprimitive-value-rules.js%27%3B%0Aimport%20%7B%20validateJavaScriptProducts%20%7D%20from%20%27.%2Fjavascript-products.js%27%3B%0Aimport%20%7BacceptRustScalarLoopModel%7D%20from%20%27.%2Frust-scalar-loops.js%27%3B%0Aimport%20%7BisJavaScriptScalarLoop%2C%20readJavaScriptScalarLoop%2C%20finishJavaScriptScalarLoops%7D%20from%20%27.%2Fjavascript-scalar-loops.js%27%3B%0Aimport%20%7B%20findJavaScriptLineTerminator%20%7D%20from%20%27.%2Fjavascript-line-terminators.js%27%3B%0Aimport%20%7B%20lowerOwnedArrayAppends%2C%20readOwnedArrayReaderParameters%20%7D%20from%20%27.%2Fowned-array-append.js%27%3B%0Aimport%20%7B%20lowerGuardedPrivateArrayWrites%20%7D%20from%20%27.%2Fguarded-private-array-writes.js%27%3B%0Aimport%20%7B%20lowerConstructedGuardedArrayWrites%20%7D%20from%20%27.%2Fconstructed-guarded-array-writes.js%27%3B%0Aimport%20%7B%20acceptCompleteDeclarationSourceInterval%20%7D%20from%20%27..%2Fsource-span-rules.js%27%3B%0Aimport%20%7B%20acceptJavaScriptFunctionStart%2C%20acceptJavaScriptNamespaceMethod%2C%0A%20%20readJavaScriptCollectionConstruction%2C%20readJavaScriptConstructionObligation%2C%0A%20%20readJavaScriptDocumentationTypeForm%2C%20readJavaScriptValueCaseForm%2C%0A%20%20acceptJavaScriptValueSwitch%2C%20readJavaScriptValueSwitchInstruction%2C%0A%20%20readJavaScriptValueSwitchPosition%2C%20readJavaScriptObjectStatementForm%2C%0A%20%20readJavaScriptObjectPropertyForm%2C%20readJavaScriptObjectValueForm%2C%0A%20%20readJavaScriptArrayMethodSurfaceForm%2C%20acceptJavaScriptTerminalTagGuard%2C%0A%20%20acceptJavaScriptTagGuardSequence%20%7D%20from%20%27.%2Fjavascript-surface-rules.js%27%3B%0A%0A%2F%2F%20The%20string%20predicates%20of%20the%20portable%20core%3A%20each%20reads%20the%20whole%20string%2C%0A%2F%2F%20so%20it%20means%20the%20same%20over%20UTF-16%2C%20UTF-8%20and%20code%20points.%0A%2F%2F%20String-to-string%20maps%3A%20the%20Unicode%20case%20mappings%2C%20which%20Rust%27s%0A%2F%2F%20to_lowercase%2Fto_uppercase%20also%20follow%2C%20and%20trimming%20of%20the%20JavaScript%0A%2F%2F%20whitespace%20set.%0Aconst%20ROOT%20%3D%20%27crate%27%3B%0Aconst%20EQUALITY%20%3D%20%7B%20%27%3D%3D%3D%27%3A%20%27eq%27%2C%20%27%21%3D%3D%27%3A%20%27ne%27%20%7D%3B%0Aconst%20RELATIONAL%20%3D%20%7B%20%27%3C%27%3A%20%27lt%27%2C%20%27%3C%3D%27%3A%20%27le%27%2C%20%27%3E%27%3A%20%27gt%27%2C%20%27%3E%3D%27%3A%20%27ge%27%20%7D%3B%0Aconst%20MULTIPLICATIVE%20%3D%20%7B%20%27%2A%27%3A%20%27mul%27%2C%20%27%2F%27%3A%20%27div%27%2C%20%27%25%27%3A%20%27rem%27%20%7D%3B%0Aconst%20ASSIGNMENTS%20%3D%20new%20Set%28%5B%27%3D%27%2C%20%27%2B%3D%27%2C%20%27-%3D%27%2C%20%27%2A%3D%27%2C%20%