(97390: (meta: (t: semantic) (n: 1) (term: string%20value) (def: export%20function%20runModernArrayParityAssertions%28%7Bfixture%3DreadProjectData%28new%20URL%28MODERN_ARRAY_FIXTURE_FILE%2Croot%29%29%2Crecord%3Dfalse%2CtestName%3D%27retained%20modern%20JavaScript%20array%20contract%20executes%20every%20original%20input%27%7D%3D%7B%7D%29%7B%0A%20validateModernArrayFixture%28fixture%29%3B%0A%20const%20cases%3D%5B%5D%3Blet%20admitted%3D0%2Crefused%3D0%3B%0A%20for%28const%20row%20of%20fixture.cases%29%7B%0A%20%20assert.equal%28digest%28row.source%29%2Crow.sourceSha256%29%3B%0A%20%20const%20targets%3Drow.targets.map%28target%3D%3E%28%7Btarget%2Cdescriptor%3AtranslateProgram%28row.source%2C%27JavaScript%27%2Ctarget%29%7D%29%29%3B%0A%20%20if%28row.expected.outcome%3D%3D%3D%27refused%27%29%7B%0A%20%20%20assert.equal%28targets.length%2C1%29%3Bconst%20diagnostic%3Dtargets%5B0%5D.descriptor.diagnostic%3Bassert.ok%28diagnostic%29%3B%0A%20%20%20if%28row.expected.match%3D%3D%3D%27exact%27%29assert.equal%28diagnostic.message%2Crow.expected.diagnostic%2Crow.id%29%3B%0A%20%20%20else%20assert.ok%28diagnostic.message.startsWith%28row.expected.diagnostic%29%2Crow.id%2B%27%3A%20%27%2Bdiagnostic.message%29%3B%0A%20%20%20refused%2B%2B%3Bcases.push%28%7Bkind%3A%27case%27%2Cid%3Arow.id%2CsourceSha256%3Arow.sourceSha256%2Ctargets%7D%29%3Bcontinue%3B%0A%20%20%7D%0A%20%20const%20originalStdout%3Dexecute%28row.source%29%3Bassert.equal%28originalStdout%2Crow.expected.stdout%2Crow.id%2B%27%3A%20original%27%29%3B%0A%20%20const%20checkedJavaScript%3DemitJavaScript%28checkProgram%28parseJavaScript%28row.source%29%29%29.text%3B%0A%20%20const%20checkedJavaScriptStdout%3Dexecute%28checkedJavaScript%29%3Bassert.equal%28checkedJavaScriptStdout%2Crow.expected.stdout%2Crow.id%2B%27%3A%20checked%27%29%3B%0A%20%20for%28const%20%7Btarget%2Cdescriptor%7Dof%20targets%29%7B%0A%20%20%20assert.equal%28descriptor.diagnostic%2Cnull%2Crow.id%2B%27%3A%20%27%2Btarget%29%3Bassert.equal%28descriptor.contract.support%2C%27semantic-translation%27%29%3B%0A%20%20%20assert.equal%28descriptor.contract.assumptions.includes%28MODERN_ARRAY_IN_BOUNDS%29%2Cfalse%2Crow.id%2B%27%3A%20%27%2Btarget%29%3B%0A%20%20%7D%0A%20%20admitted%2B%2B%3Bcases.push%28%7Bkind%3A%27case%27%2Cid%3Arow.id%2CsourceSha256%3Arow.sourceSha256%2CoriginalStdout%2CcheckedJavaScript%2CcheckedJavaScriptStdout%2Ctargets%7D%29%3B%0A%20%7D%0A%20assert.equal%28admitted%2C6%29%3Bassert.equal%28refused%2C5%29%3B%0A%20assert.equal%28cases.find%28row%3D%3Erow.id%3D%3D%3D%27original-string-length%27%29.originalStdout%2C%272%5Cn%27%29%3B%0A%20assert.equal%28cases.find%28row%3D%3Erow.id%3D%3D%3D%27supplementary-string-length%27%29.originalStdout%2C%274%5Cn%27%29%3B%0A%20assert.equal%28cases.find%28row%3D%3Erow.id%3D%3D%3D%27observable-array-absence%27%29.originalStdout%2C%279%5Cn%27%29%3B%0A%20%2F%2F%20Execute%20tampering%20controls%20before%20recording%20any%20assertion%2C%20without%20changing%20premises.%0A%20for%28const%20change%20of%20%5Bvalue%3D%3E%7Bvalue.cases.pop%28%29%3B%7D%2Cvalue%3D%3E%7Bvalue.cases%5B0%5D.source%2B%3D%27%20%27%3B%7D%2Cvalue%3D%3E%7Bvalue.cases%5B0%5D.expected.stdout%3D%27wrong%27%3B%7D%2C%0A%20%20value%3D%3E%7Bvalue.historicalNative.source%2B%3D%27%20%27%3B%7D%2Cvalue%3D%3E%7Bvalue.contract.sha256%3D%270%27.repeat%2864%29%3B%7D%5D%29%7B%0A%20%20const%20altered%3DstructuredClone%28fixture%29%3Bchange%28altered%29%3Bassert.throws%28%28%29%3D%3EvalidateModernArrayFixture%28altered%29%29%3B%0A%20%7D%0A%20if%28record%29for%28const%20%5BfixtureId%2CfixtureFile%5Dof%20%5B%5BMODERN_ARRAY_CONTRACT_ID%2CMODERN_ARRAY_CONTRACT_FILE%5D%2C%5BMODERN_ARRAY_FIXTURE_ID%2CMODERN_ARRAY_FIXTURE_FILE%5D%5D%29%0A%20%20for%28const%20%5BrequirementId%2Cassertions%5Dof%20MODERN_ARRAY_REQUIREMENTS%29recordIssue195Observations%28%7BrequirementId%2Csuffix%3A%27behavior%27%2CfixtureId%2CfixtureFile%2Cassertions%2CtestName%7D%29%3B%0A%20return%20%7Bmetadata%3A%7Bkind%3A%27metadata%27%2CschemaVersion%3A1%2CfixtureDigest%3Adigest%28readF