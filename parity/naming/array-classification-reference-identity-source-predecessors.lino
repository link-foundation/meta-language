(31947: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BcaptureRustRuntimeShell%2CcheckRustRuntimeShellContainers%7D%20from%20%27.%2Frust-runtime-shell.js%27%3B%0Aimport%20%7B%20acceptOptionalAnnotationTypes%20%7D%20from%20%27.%2Foptional-inference.js%27%3B%0Aimport%20%7BcheckRustPureUnitCalls%7D%20from%20%27.%2Frust-pure-unit-calls.js%27%3B%0Aimport%20%7BcheckRustEmptyOptionProof%7D%20from%20%27.%2Frust-empty-options.js%27%3B%0A%2F%2F%20Resolves%20names%2C%20checks%20types%2C%20and%20fixes%20the%20exact%20operator%20semantics%20of%20a%0A%2F%2F%20surface%20program%20produced%20by%20one%20of%20the%20language%20frontends.%20The%20result%20is%0A%2F%2F%20the%20portable-core%20program%20the%20emitters%20consume%3A%20every%20expression%20carries%0A%2F%2F%20its%20type%20and%20every%20operator%20carries%20the%20source%20language%27s%20semantics%2C%20so%20a%0A%2F%2F%20target%20can%20never%20silently%20substitute%20its%20own%20%28for%20example%2C%20Lean%27s%20Euclidean%0A%2F%2F%20%60Int%60%20division%20for%20JavaScript%27s%20truncating%20BigInt%20division%29.%0A%0Aimport%20%7B%20typeError%2C%20unsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20checkCollectionConstruction%20%7D%20from%20%27.%2Fcollection-construction.js%27%3B%0Aimport%20%7B%20readArrayIterableForm%2C%20readReferenceMutationDiagnostic%2C%20selectOptionalArrayIndexNumber%2C%20selectOptionalArrayRead%20%7D%20from%20%27.%2Farray-value-rules.js%27%3B%0Aimport%20%7B%20readArrayFromArgumentError%2C%20readArrayFromMapCallbackError%2C%20readArrayFromReceiverError%20%7D%20from%20%27.%2Farray-from-rules.js%27%3B%0Aimport%20%7B%20readArrayFromExpectedElement%2C%20readArrayFromIterableType%2C%20readArrayFromMapCallback%20%7D%20from%20%27.%2Farray-from.js%27%3B%0Aimport%20%7B%20readArrayCallbackResultForm%2C%20readArrayCallbackSignatureError%2C%20readArrayCallbackParameterRole%2C%0A%20%20readArrayCallbackArgumentCountError%2C%20readArrayCallbackCheckedResultContext%2C%0A%20%20readAr