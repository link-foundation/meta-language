28%29%3D%3Eedit.after%29%3B%7D%0A%20%20assert.ok%28source%3D%3D%3Doriginal%7C%7Csource%3D%3D%3Dcurrent%2C%27only%20the%20complete%20original%20or%20reviewed%20inventory%20test%20source%20is%20admitted%27%29%3B%0A%20%20return%20original%3B%0A%7D%0A%0A%2F%2A%2A%20Check%20every%20current%20declaration%20and%20every%20old%20byte%20before%20removing%20appends.%20%2A%2F%0Aexport%20function%20verifyDependencyInventoryAppends%28inventory%2Cdeclarations%2Chistory%3DreadDependencyInventoryAppendHistory%28%29%29%20%7B%0A%20%20assert.equal%28digest%28structuredDataToLino%28history%29%29%2CpolicyHash%29%3B%0A%20%20for%28const%20%5Bcapture%2Crevision%2Cpath%5Dof%20%5B%5Bhistory.inventory%2CinventoryRevision%2C%27parity%2Fdependency-inventory.lino%27%5D%2C%0A%20%20%20%20%5Bhistory.test%2CtestRevision%2C%27js%2Ftests%2Fissue-195-evidence-node-dependency.test.js%27%5D%5D%29%7B%0A%20%20%20%20verifyGitArtifactCertificate%28capture.certificate%2CBuffer.from%28capture.source%29%2C%7Brevision%2Cpath%7D%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28checkInventory%28inventory%2Cdeclarations%29%2C%5B%5D%2C%27the%20actual%20complete%20current%20declaration%20corpus%20stays%20checked%27%29%3B%0A%20%20const%20before%3DreadStructuredDataLino%28history.inventory.source%29%3B%0A%20%20assert.equal%28before.items.length%2C745%29%3B%0A%20%20assert.ok%28inventory.items.length%3E%3Dbefore.items.length%29%3B%0A%20%20const%20prefix%3D%7B...inventory%2Citems%3Ainventory.items.slice%280%2Cbefore.items.length%29%7D%3B%0A%20%20assert.equal%28structuredDataToLino%28prefix%29%2Chistory.inventory.source%2C%27every%20complete%20original%20item%2C%20audit%20fact%2C%20order%20and%20alias%20stays%20exact%27%29%3B%0A%20%20const%20ids%3Dnew%20Set%28prefix.items.map%28row%3D%3Erow.id%29%29%3B%0A%20%20for%28const%20entry%20of%20inventory.items.slice%28before.items.length%29%29%7B%0A%20%20%20%20assert.equal%28ids.has%28entry.id%29%2Cfalse%2C%27appends%20cannot%20replace%20or%20repeat%20an%20original%20identity%27%29%3Bids.add%28entry.id%29%3B%0A%20%20%20%20assert.ok%28declarations.some%28row%3D%3Erow.id%3D%3D%3Dentry.id%29%2C%27each%20appended%20entry%20has%20an%20actual%20current%20declaration%27%29%3B%0A%20%20%7D%0A%20%20return%20prefix%3B%0A%7D%0A%0Aexport%20function%20readNodeDependencyInventoryOriginalView%28%29%20%7B%0A%20%20const%20root%3DfileURLToPath%28new%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%29%3B%0A%20%20return%20verifyDependencyInventoryAppends%28readProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fdependency-inventory.lino%27%2Cimport.meta.url%29%29%2CcollectDependencies%28root%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Keep%20the%20old%20source-placement%20meaning%20while%20current%20definitions%20stay%20separate.%20%2A%2F%0Aexport%20function%20restoreNodeDependencyInventoryNamingEntry%28entry%29%20%7B%0A%20%20const%20path%3D%27js%2Ftests%2Fissue-195-evidence-node-dependency.test.js%27%3B%0A%20%20if%28entry.inventory%21%3D%3D%27B70%20physical%20field%20source%20view%20names%20for%20js%2Ftests%2Fdependency-inventory-node-runtime.test.js%27%0A%20%20%20%20%7C%7Centry.files.length%21%3D%3D1%7C%7Centry.files%5B0%5D%21%3D%3Dpath%29return%20entry%3B%0A%20%20return%7B...entry%2Cextract%3A%28source%2Cfile%29%3D%3Eentry.extract%28restoreNodeDependencyInventoryTestSource%28source%29%2Cfile%29%7D%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
