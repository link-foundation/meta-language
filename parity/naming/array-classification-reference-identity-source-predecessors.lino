tionSizeProjectionSchemaPacket%28%29%3Anull%3B%0A%20const%20original%3Dfile%3D%3E%7B%0A%20%20if%28%21stored%29return%20captureGitArtifactCertificate%28policy.revision%2Cfile%29%3B%0A%20%20if%28policy.files.includes%28file%29%29%7B%0A%20%20%20const%20row%3Dstored.predecessor.certificates.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28row%29%3B%0A%20%20%20return%7Bblob%3ABuffer.from%28stored.predecessor.source%29%2Ccertificate%3Arow.certificate%7D%3B%0A%20%20%7D%0A%20%20const%20row%3Dstored.owners.find%28row%3D%3Erow.file%3D%3D%3Dfile%29%3Bassert.ok%28row%29%3B%0A%20%20return%7Bblob%3ABuffer.from%28row.source%29%2Ccertificate%3Arow.certificate%7D%3B%0A%20%7D%3B%0A%20const%20originals%3Dpolicy.files.map%28file%3D%3E%7Bconst%20row%3Doriginal%28file%29%3Bassert.deepEqual%28pin%28row.blob%29%2Cpolicy.predecessor%29%3Breturn%7Bfile%2C...row%7D%3B%7D%29%3B%0A%20assert.equal%28originals%5B0%5D.blob.equals%28originals%5B1%5D.blob%29%2Ctrue%29%3B%0A%20const%20predecessor%3Doriginals%5B0%5D.blob.toString%28%27utf8%27%29%2Csource%3DderiveCollectionSizeProjectionSchema%28predecessor%29%3B%0A%20const%20owners%3D%5B%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%2C%27js%2Fsrc%2Ftyped-program-expression-projection.js%27%2C%27rust%2Fsrc%2Ftyped_program_links%2Fprojection.rs%27%2C%27js%2Fscripts%2Fgenerate-typed-program-links-fixtures.mjs%27%2C%27js%2Fsrc%2Ftyped-program-links-validation.js%27%5D.map%28file%3D%3E%7B%0A%20%20const%20%7Bblob%2Ccertificate%7D%3Doriginal%28file%29%3B%0A%20%20const%20current%3Dfile%3D%3D%3D%27js%2Fscripts%2Fgenerate-typed-program-links-fixtures.mjs%27%3FderiveCollectionSizeProjectionFixtureSource%28blob.toString%28%27utf8%27%29%29%0A%20%20%20%3Afile%3D%3D%3D%27js%2Fsrc%2Ftyped-program-links-validation.js%27%3FderiveCollectionSizeProjectionValidationSource%28blob.toString%28%27utf8%27%29%29%3Ablob.toString%28%27utf8%27%29%3B%0A%20%20const%20physical%3DreadFileSync%28new%20URL%28file%2Croot%29%29%3B%0A%20%20const%20historical%3Dfile%3D%3D%3D%27js%2Fsrc%2Ftranslation%2Fcheck.js%27%3FrestoreTruthyProjectionHistoricalSource%28physical%2Cfile%29%3Aphysical.toString%28%27utf8%27%29%3B%0A%20%20assert.equal%28historical%2Ccurrent%2C%27actual%20complete%20existing%20owner%20or%20exact%20fixture%20append%20is%20required%3A%20%27%2Bfile%29%3B%0A%20%20return%7Bfile%2C...pin%28blob%29%2Csource%3Ablob.toString%28%27utf8%27%29%2Ccertificate%2Ccurrent%3Apin%28current%29%7D%3B%0A%20%7D%29%3B%0A%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%3Apolicy.revision%2Cpredecessor%3A%7B...policy.predecessor%2Csource%3Apredecessor%2C%0A%20%20certificates%3Aoriginals.map%28%28%7Bfile%2Ccertificate%7D%29%3D%3E%28%7Bfile%2Ccertificate%7D%29%29%7D%2Ccurrent%3Apin%28source%29%2Cextensions%3ACOLLECTION_SIZE_PROJECTION_SCHEMA_ENTRIES%2Cowners%2C%0A%20%20boundary%3A%27Exactly%20the%20existing%20checked%20map%2Fset%20size%20operation%20projects%20to%20the%20existing%20Surface%20field%20size%20through%20shared%20data.%20Earlier%20schema%20bytes%20and%20owner%20modules%20retain%20whole%20Git%20membership%20and%20exact%20inversion.%20No%20wider%20collection%20support%2C%20generic%20fallback%2C%20native%20execution%20or%20phase%20completion%20is%20claimed.%27%7D%3B%0A%20verifyCollectionSizeProjectionSchemaPacket%28packet%29%3B%0A%20for%28const%20file%20of%20policy.files%29%7Bconst%20physical%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3Bconst%20actual%3Dphysical%3D%3D%3Dpredecessor%3Fphysical%3ArestoreTruthyProjectionHistoricalSource%28Buffer.from%28physical%29%2Cfile%29%3Bassert.ok%28actual%3D%3D%3Dpredecessor%7C%7Cactual%3D%3D%3Dsource%2C%27unknown%20actual%20schema%20source%20refuses%3A%20%27%2Bfile%29%3Bif%28check%29assert.equal%28actual%2Csource%29%3B%7D%0A%20const%20helperPath%3Dnew%20URL%28helper%2Croot%29%2Cbefore%3DreadFileSync%28helperPath%2C%27utf8%27%29%2Cpattern%3D%2F%5Econst%20recipeSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%24%2Fmu%3Bassert.equal%28before.split%28pattern%29.length%2C2%29%3B%0A%20const%20output%3Dnew%20URL%28policy.recipe%2Croot%29%3Bif%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20const%20after%3Dbefore.replace%28pattern%2C%22const%20recipeSha256%3D%27%22%2Bpin%28readFileSync%28output%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20if%28check%29assert.equal%28before%2Cafter%29%3Belse%7Bfor%28const%20file%20of%20policy.files%29%7Bconst%20physical%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3Bif%28physical%3D%3D%3Dpredecessor%7C%7Cphysical%3D%3D%3Dsource%29writeFileSync%28new%20URL%28file%2Croot%29%2Csource%29%3Belse%20assert.equal%28restoreTruthyProjectionHistoricalSource%28Buffer.from%28physical%29%2Cfile%29%2Csource%2C%27a%20certified%20current%20successor%20is%20retained%20without%20an%20old-author%20overwrite%27%29%3B%7DwriteFileSync%28helperPath%2Cafter%29%3B%7D%0A%20return%20structuredClone%28packet%29%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20const%20args%3Dprocess.argv.slice%282%29%3Bassert.ok%28args.length%3C%3D1%26%26args.every%28arg%3D%3Earg%3D%3D%3D%27--check%27%29%29%3B%0A%20generateCollectionSizeProjectionSchema%28%7Bcheck%3Aargs.includes%28%27--check%27%29%7D%29%3Bconsole.log%28%27Exact%20shared%20collection%20size%20projection%20appended%3B%20classifiers%20and%20native%20compilation%20remain%20separate%20normal%20generation%20and%20CI%20steps.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
