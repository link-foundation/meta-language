(36370: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Frontend%20decisions%20expressed%20in%20JavaScript%20and%20translated%20into%20Rust%20by%0A%2F%2F%20js%2Fscripts%2Fgenerate-frontend-rules.mjs.%20Inputs%20use%20code%20units%20and%20token%0A%2F%2F%20records%20so%20both%20host%20runtimes%20can%20use%20the%20same%20decisions.%0A%0A%2F%2A%2A%20%40typedef%20%7B%7B%20%24%3A%20%27scalar%27%2C%20code%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27malformed%27%20%7D%20%7C%20%7B%20%24%3A%20%27unsupported%27%2C%20end%3A%20number%2C%20escapeLength%3A%20number%20%7D%7D%20UnicodeEscape%20%2A%2F%0A%0A%2F%2A%2A%0A%20%2A%20Read%20one%20Unicode%20or%20hexadecimal%20escape%20from%20at%20most%20twelve%20UTF-16%20code%20units%2C%20starting%0A%20%2A%20with%20its%20backslash.%20Offsets%20in%20the%20result%20are%20relative%20to%20that%20backslash.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%0A%20%2A%20%40param%20%7Bboolean%7D%20allowFixed%0A%20%2A%20%40returns%20%7BUnicodeEscape%7D%0A%20%2A%2F%0Aexport%20function%20decodeUnicodeEscape%28units%2C%20allowFixed%29%20%7B%0A%20%20if%20%28units.length%20%3C%202%20%7C%7C%20units%5B0%5D%20%21%3D%3D%2092%20%7C%7C%20%28units%5B1%5D%20%21%3D%3D%20117%20%26%26%20units%5B1%5D%20%21%3D%3D%20120%29%29%20return%20%7B%20%24%3A%20%27malformed%27%20%7D%3B%0A%20%20let%20fixed%20%3D%204%3B%0A%20%20if%20%28units%5B1%5D%20%3D%3D%3D%20120%29%20%7B%0A%20%20%20%20if%20%28%21allowFixed%29%20return%20%7B%20%24%3A%20%27malformed%27%20%7D%3B%0A%20%20%20%20fixed%20%3D%202%3B%0A%20%20%7D%0A%20%20let%20index%20%3D%202%3B%0A%20%20let%20code%20%3D%200%3B%0A%20%20let%20digits%20%3D%200%3B%0A%20%20let%20braced%20%3D%20false%3B%0A%20%20if%20%28fixed%20%3D%3D%3D%204%20%26%26%20units.length%20%3E%202%20%26%26%20units%5B2%5D%20%3D%3D%3D%20123%29%20%7B%0A%20%20%20%20braced%20%3D%20true%3B%0A%20%20%20%20index%20%3D%203%3B%0A%20%20%7D%20else%20if%20%28%21allowFixed%29%20return%20%7B%20%24%3A%20%27malformed%27%20%7D%3B%0A%20%20while%20%2