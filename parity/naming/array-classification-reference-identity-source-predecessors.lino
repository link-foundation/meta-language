(28824: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Complete%20current-source%20succession%20for%20one%20immutable%20historical%20descriptor.%0A%2F%2F%20This%20is%20a%20source-only%20view%3B%20current%20parsing%20always%20uses%20the%20actual%20frontend.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadBootstrapStructuredDataLino%7D%20from%20%27..%2F..%2Fscripts%2Flib%2Fstructured-data-bootstrap.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BreplayRequiredFieldNativeHostIntervals%7D%20from%20%27.%2Frequired-field-native-host-succession.mjs%27%3B%0A%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aexport%20const%20RELATIVE_ARRAY_CURRENT_FRONTEND%3D%27js%2Fsrc%2Ftranslation%2Fjavascript.js%27%3B%0Aexport%20const%20RELATIVE_ARRAY_CURRENT_FRONTEND_OUTPUT%3D%27parity%2Fself-translation%2Frelative-array-current-frontend-history.lino%27%3B%0Aexport%20const%20RELATIVE_ARRAY_CURRENT_FRONTEND_ANCHORS%3DObject.freeze%28%5B%0A%20%20Object.freeze%28%7Brevision%3A%27a8a789afb0ed569340d9079279f534f0bf7c4e72%27%2Cbytes%3A133770%2Csha256%3A%271ee38749dcf8723b27489dbd33f6e3f177a9e52c898a85cf215aecdcbdc31211%27%7D%29%2C%0A%20%20Object.freeze%28%7Brevision%3A%278d77e476d097448eb381ebe03e2aa173402bc03d%27%2Cbytes%3A136201%2Csha256%3A%27face5521fb69545cd5c06ff2eebed38878ccba559e69d1454cb7cc352efc43ed%27%7D%29%2C%0A%5D%29%3B%0Aexport%20const%20RELATIVE_ARRAY_CURRENT_FRONTEND_NAMING%3DObject.freeze%28%7B%0A%20%20path%3A%27parity%2Fnaming%2Fci-39526911132-record-parameter-predecessor-source-history.lino%27%2C%0A%20%20bytes%3A9382656%2Csha256%3A%279ecc79376cd2a778a2f07605ac394b5530439a2eb3cc2cba0ccb9bde2161e4f9%27%2C%0A%7D%29%3B%0Aconst%20legacy%3D%7Bbytes%3A130416%2Csha256%3A%2738d155ce765157039d2555c070e537e97a91f2c64587c70b6c6c578c5371ebe8%27%7D%3B%0Aconst%20packetSha256%3D%2785356f744d01326a84b08ff06f3793f42b04792dfe96bc376fe8b09189fc5d12%27%3B%0Alet%20cached%3B%0Aexport%20const%20pinRelativeArrayCurrentFrontend%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Aconst%20exactKeys%3D%28value%2Ckeys%29%3D%3E%7Bassert.ok%28value%26%26typeof%20value%3D%3D%3D%27object%27%26%26%21Array.isArray%28value%29%29%3Bassert.deepEqual%28Object.keys%28value%29.sort%28%29%2C%5B...keys%5D.sort%28%29%29%3B%7D%3B%0A%0A%2F%2A%2A%20Reuse%20the%20established%20exact%20interval%20replay%2Finverse.%20No%20source%20semantics%20are%20inferred.%20%2A%2F%0Aexport%20function%20deriveRelativeArrayFrontendIntervals%28previous%2Ccurrent%29%7B%0A%20%20assert.equal%28Buffer.from%28previous%29.toString%28%27utf8%27%29%2Cprevious%29%3B%0A%20%20assert.equal%28Buffer.from%28current%29.toString%28%27utf8%27%29%2Ccurrent%29%3B%0A%20%20const%20before%3D%5B...previous%5D%2Cafter%3D%5B...current%5D%3Blet%20start%3D0%2ColdEnd%3Dbefore.length%2Cend%3Dafter.length%3B%0A%20%20while%28start%3ColdEnd%26%26start%3Cend%26%26before%5Bstart%5D%3D%3D%3Dafter%5Bstart%5D%29start%2B%2B%3B%0A%20%20while%28oldEnd%3Estart%26%26end%3Estart%26%26before%5BoldEnd-1%5D%3D%3D%3Dafter%5Bend-1%5D%29%7BoldEnd--%3Bend--%3B%7D%0A%20%20const%20edits%3D%5B%7Bstart%3Abefore.slice%280%2Cstart%29.join%28%27%27%29.length%2Cremoved%3Abefore.slice%28start%2ColdEnd%29.join%28%27%27%29%2Cinserted%3Aafter.slice%28start%2Cend%29.join%28%27%27%29%7D%5D%3B%0A%20%20assert.equal%28replayRequiredFieldNativeHostIntervals%28previous%2Cedits%29%2Ccurrent%29%3B%0A%20%20return%20edits%3B%0A%7D%0A%0A%2F%2A%2A%20Current%20membership%20is%20the%20actual%20complete%20local%20file%3B%20original%20membership%0A%20%2A%20is%20independently%20certified%20at%20both%20immutable%20commits.%20No%20current%20Git%20claim.%20%2A%2F%0Aexport%20function%20verifyRelativeArrayCurrentFrontendHistory%28packet%29%7B%0A%20%20exactKeys%28packet%2C%5B%27schemaVersion%27%2C%27model%27%2C%27profile%27%2C%27file%27%2C%27sourceArchive%27%2C%27anchors%27%2C%27current%27%2C%27edges%27%2C%27boundary%27%5D%29%3B%0A%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.model%2C%27relative%20array%20complete%20current%20frontend%20succession%201%27%29%3B%0A%20%20assert.equal%28packet.profile%2C%27relative%20array%27%29%3Bassert.equal%28packet.file%2CRELATIVE_ARRAY_CURRENT_FRONTEND%29%3B%0A%20%20assert.deepEqual%28packet.sourceArchive%2CRELATIVE_ARRAY_CURRENT_FRONTEND_NAMING%29%3B%0A%20%20assert.ok%28Array.isArray%28packet.anchors%29%29%3Bassert.equal%28packet.anchors.length%2C2%29%3B%0A%20%20for%28const%5Bindex%2Crow%5Dof%20packet.anchors.entries%28%29%29%7B%0A%20%20%20%20exactKeys%28row%2C%5B%27revision%27%2C%27bytes%27%2C%27sha256%27%2C%27source%27%2C%27certificate%27%5D%29%3B%0A%20%20%20%20const%20expected%3DRELATIVE_ARRAY_CURRENT_FRONTEND_ANCHORS%5Bindex%5D%3B%0A%20%20%20%20assert.deepEqual%28%7Brevision%3Arow.revision%2Cbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%2Cexpected%29%3B%0A%20%20%20%20assert.deepEqual%28pinRelativeArrayCurrentFrontend%28row.source%29%2C%7Bbytes%3Aexpected.bytes%2Csha256%3Aexpected.sha256%7D%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%3Aexpected.revision%2Cpath%3Apacket.file%7D%29%3B%0A%20%20%7D%0A%20%20exactKeys%28packet.current%2C%5B%27bytes%27%2C%27sha256%27%2C%27source%27%5D%29%3B%0A%20%20assert.equal%28typeof%20packet.current.source%2C%27string%27%29%3B%0A%20%20assert.deepEqual%28pinRelativeArrayCurrentFrontend%28packet.current.source%29%2C%7Bbytes%3Apacket.current.bytes%2Csha256%3Apacket.current.sha256%7D%29%3B%0A%20%20assert.equal%28packet.current.source%2CreadFileSync%28new%20URL%28packet.file%2Croot%29%2C%27utf8%27%29%2C%27only%20the%20actual%20complete%20current%20frontend%20has%20this%20source%20view%27%29%3B%0A%20%20assert.ok%28Array.isArray%28packet.edges%29%29%3Bassert.equal%28packet.edges.length%2C2%29%3B%0A%20%20const%20sources%3D%5Bpacket.anchors%5B0%5D.source%2Cpacket.anchors%5B1%5D.source%2Cpacket.current.source%5D%3B%0A%20%20for%28const%5Bindex%2Cedge%5Dof%20packet.edges.entries%28%29%29%7B%0A%20%20%20%20exactKeys%28edge%2C%5B%27from%27%2C%27to%27%2C%27coordinateUnit%27%2C%27edits%27%5D%29%3B%0A%20%20%20%20assert.deepEqual%28edge.from%2CpinRelativeArrayCurrentFrontend%28sources%5Bindex%5D%29%29%3B%0A%20%20%20%20assert.deepEqual%28edge.to%2CpinRelativeArrayCurrentFrontend%28sources%5Bindex%2B1%5D%29%29%3B%0A%20%20%20%20assert.equal%28edge.coordinateUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20%20%20assert.deepEqual%28edge.edits%2CderiveRelativeArrayFrontendIntervals%28sources%5Bindex%5D%2Csources%5Bindex%2B1%5D%29%29%3B%0A%20%20%20%20assert.equal%28replayRequiredFieldNativeHostIntervals%28sources%5Bindex%5D%2Cedge.edits%29%2Csources%5Bindex%2B1%5D%29%3B%0A%20%20%20%20let%20inverse%3Dsources%5Bindex%2B1%5D%3B%0A%20%20%20%20for%28const%20edit%20of%20edge.edits.toReversed%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2Csources%5Bindex%5D%2C%27every%20original%20complete%20source%20byte%20remains%27%29%3B%0A%20%20%7D%0A%20%20return%20packet.anchors%5B0%5D.source%3B%0A%7D%0A%0Aexport%20function%20readRelativeArrayCurrentFrontendHistory%28%29%7B%0A%20%20if%28%21cached%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28RELATIVE_ARRAY_CURRENT_FRONTEND_OUTPUT%2Croot%29%29%3B%0A%20%20%20%20assert.equal%28pinRelativeArrayCurrentFrontend%28bytes%29.sha256%2CpacketSha256%29%3B%0A%20%20%20%20cached%3DreadBootstrapStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%0A%20%20%20%20verifyRelativeArrayCurrentFrontendHistory%28cached%29%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28cached%29%3B%0A%7D%0A%0A%2F%2A%2A%20The%20older%20certified897%20source%20is%20already%20historical%20and%20remains%20an%20identity.%0A%20%2A%20All%20unrelated%20profiles%2Fpaths%20are%20identities.%20Every%20unknown%20selected%20successor%20refuses.%20%2A%2F%0Aexport%20function%20restoreRelativeArrayCurrentFrontendSource%28source%2Cfile%2Cprofile%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.equal%28typeof%20file%2C%27string%27%29%3Bassert.equal%28typeof%20profile%2C%27string%27%29%3B%0A%20%20if%28profile%21%3D%3D%27relative%20array%27%7C%7Cfile%21%3D%3DRELATIVE_ARRAY_CURRENT_FRONTEND%29return%20source%3B%0A%20%20const%20actual%3DpinRelativeArrayCurrentFrontend%28source%29%3B%0A%20%20if%28actual.bytes%3D%3D%3Dlegacy.bytes%26%26actual.sha256%3D%3D%3Dlegacy.sha256%29return%20source%3B%0A%20%20const%20packet%3DreadRelativeArrayCurrentFrontendHistory%28%29%3B%0A%20%20for%28const%20row%20of%20%5B...packet.anchors%2Cpacket.current%5D%29%7B%0A%20%20%20%20if%28source%3D%3D%3Drow.source%29return%20packet.anchors%5B0%5D.source%3B%0A%20%20%7D%0A%20%20assert.fail%28%27an%20unknown%20complete%20frontend%20successor%20has%20no%20relative-array%20current-source%20authority%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
