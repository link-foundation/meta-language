.ok%28rust.includes%28%27let%20xs%20%3D%20vec%21%5B1f64%2C%202f64%5D%3B%27%29%2C%20rust%29%3B%0A%20%20assert.ok%28rust.includes%28%27match%20crate%3A%3Aml_array%3A%3Aoptional_at%28%26xs%2C%20crate%3A%3Aml_array%3A%3Anumber_index%281f64%29%29%20%7B%20Some%28ml_present%29%20%3D%3E%20ml_present%2C%20None%20%3D%3E%20f64%3A%3ANAN%20%7D%20%2B%20%28xs.len%28%29%20as%20f64%29%27%29%2C%20rust%29%3B%0A%20%20assert.ok%28rust.includes%28%27crate%3A%3Aml_array%3A%3Aappend%28vec%21%5Bcrate%3A%3Aml%3A%3ABig%3A%3Afrom_i128%281%29%5D%2C%20vec%21%5Bcrate%3A%3Aml%3A%3ABig%3A%3Afrom_i128%282%29%5D%29%27%29%2C%20rust%29%3B%0A%20%20const%20lean%20%3D%20translateProgram%28ARRAYS%2C%20%27JavaScript%27%2C%20%27Lean%27%29.code%3B%0A%20%20assert.ok%28lean.includes%28%27let%20xs%20%3A%3D%20%28%23%5B%281%20%3A%20Float%29%2C%20%282%20%3A%20Float%29%5D%20%3A%20%28Array%20Float%29%29%27%29%2C%20lean%29%3B%0A%20%20assert.ok%28lean.includes%28%27xs%5Bml_index.toUInt64.toNat%5D%3F%20else%20none%27%29%2C%20lean%29%3B%0A%20%20assert.ok%28lean.includes%28%27%7C%20none%20%3D%3E%20%280%20%2F%200%20%3A%20Float%29%29%20%2B%20%28Float.ofNat%20xs.size%29%27%29%2C%20lean%29%3B%0A%20%20assert.ok%28lean.includes%28%27%28%28%23%5B%281%20%3A%20Int%29%5D%20%3A%20%28Array%20Int%29%29%20%2B%2B%20%28%23%5B%282%20%3A%20Int%29%5D%20%3A%20%28Array%20Int%29%29%29%27%29%2C%20lean%29%3B%0A%20%20const%20rocq%20%3D%20translateProgram%28ARRAYS%2C%20%27JavaScript%27%2C%20%27Rocq%27%29.code%3B%0A%20%20assert.ok%28rocq.includes%28%27let%20xs%20%3A%3D%20%281%25float%20%3A%3A%202%25float%20%3A%3A%20%40nil%20float%29%20in%27%29%2C%20rocq%29%3B%0A%20%20assert.ok%28rocq.includes%28%27List.nth_error%20xs%20%28Z.to_nat%20ml_index%29%27%29%2C%20rocq%29%3B%0A%20%20assert.ok%28rocq.includes%28%27%7C%20None%20%3D%3E%20PrimFloat.nan%20end%29%27%29%2C%20rocq%29%3B%0A%20%20assert.ok%28rocq.includes%28%27%28List.app%20%281%25Z%20%3A%3A%20%40nil%20Z%29%20%282%25Z%20%3A%3A%20%40nil%20Z%29%29%27%29%2C%20rocq%29%3B%0A%7D%29%3B%0A%0Atest%28%27inference%20fixes%20the%20element%20type%20of%20an%20empty%20array%20from%20its%20later%20use%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20source%20%3D%20%27function%20range%28n%29%20%7B%5Cn%20%20let%20out%20%3D%20%5B%5D%3B%5Cn%20%20for%20%28let%20i%20%3D%200n%3B%20i%20%3C%20n%3B%20i%2B%2B%29%20out%20%3D%20%5B...out%2C%20i%5D%3B%5Cn%20%20return%20out%3B%5Cn%7D%5Cnconsole.log%28range%283n%29.length%29%3B%5Cn%27%3B%0A%20%20const%20rust%20%3D%20translateProgram%28source%2C%20%27JavaScript%27%2C%20%27Rust%27%29%3B%0A%20%20assert.equal%28rust.diagnostic%2C%20null%29%3B%0A%20%20assert.ok%28rust.code.includes%28%27Vec%3A%3A%3Ccrate%3A%3Aml%3A%3ABig%3E%3A%3Anew%28%29%27%29%2C%20rust.code%29%3B%0A%7D%29%3B%0A%0Atest%28%27a%20%40typedef%20field%20may%20hold%20an%20array%2C%20of%20data%20too%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20source%20%3D%20%22%2F%2A%2A%20%40typedef%20%7B%7B%20%24%3A%20%27leaf%27%2C%20items%3A%20bigint%5B%5D%20%7D%20%7C%20%7B%20%24%3A%20%27node%27%2C%20kids%3A%20Array%3CTree%3E%20%7D%7D%20Tree%20%2A%2F%5Cnfunction%20size%28t%29%20%7B%5Cn%20%20if%20%28t.%24%20%3D%3D%3D%20%27leaf%27%29%20return%20t.items.length%3B%5Cn%20%20let%20n%20%3D%200%3B%5Cn%20%20for%20%28const%20kid%20of%20t.kids%29%20n%20%2B%3D%20size%28kid%29%3B%5Cn%20%20return%20n%3B%5Cn%7D%5Cnconsole.log%28size%28%7B%20%24%3A%20%27node%27%2C%20kids%3A%20%5B%7B%20%24%3A%20%27leaf%27%2C%20items%3A%20%5B1n%2C%202n%5D%20%7D%5D%20%7D%29%29%3B%5Cn%22%3B%0A%20%20for%20%28const%20target%20of%20%5B%27Rust%27%2C%20%27Lean%27%2C%20%27Rocq%27%5D%29%20assert.equal%28translateProgram%28source%2C%20%27JavaScript%27%2C%20target%29.diagnostic%2C%20null%2C%20target%29%3B%0A%20%20%2F%2F%20Lean%20derives%20no%20DecidableEq%20through%20an%20Array%20of%20data%2C%20and%20Rocq%20would%20warn%20of%20every%20nested%20definition.%0A%20%20assert.ok%28translateProgram%28source%2C%20%27JavaScript%27%2C%20%27Lean%27%29.code.includes%28%27%20%20deriving%20Repr%2C%20Inhabited%27%29%29%3B%0A%20%20assert.ok%28translateProgram%28source%2C%20%27JavaScript%27%2C%20%27Rocq%27%29.code.includes%28%27%23%5Bwarnings%3D%22-register-all%22%5D%5CnInductive%20Tree%27%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20array%20forms%20that%20are%20not%20kept%20are%20refused%20with%20a%20reason%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20assert.equal%28refusal%28%27const%20xs%20%3D%20%5B1%2C%202%5D%3B%5Cnconsole.log%28xs%29%3B%5Cn%27%29%2C%20%27text%20of%20an%20array%3A%20console.log%20lays%20an%20array%20out%20with%20util.inspect%20and%20String%20joins%20its%20elements%20with%20commas%2C%20which%20the%20translation%20does%20not%20reproduce%20yet%3B%20print%20the%20elements%20one%20by%20one%20at%2031..33%27%29%3B%0A%20%20assert.equal%28refusal%28%27const%20xs%20%3D%20%5B1%2C%202%5D%3B%5Cnxs%5B0%5D%20%3D%203%3B%5Cn%27%29%2C%20%27reference%20mutation%3A%20this%20mutation%20requires%20its%20shared%20reference%20and%20slot%20operations%20to%20be%20represented%20at%2019..28%27%29%3B%0A%20%20assert.equal%28refusal%28%27const%20xs%20%3D%20%5B1%2C%202%5D%3B%5Cnconsole.log%28xs%20%3D%3D%3D%20xs%29%3B%5Cn%27%29%2C%20%27comparison%20of%20arrays%3A%20%3D%3D%3D%20of%20two%20arrays%20compares%20which%20array%20each%20is%2C%20which%20a%20value%20translation%20does%20not%20keep%3B%20compare%20their%20elements%20at%2031..40%27%29%3B%0A%20%20assert.equal%28refusal%28%22const%20s%20%3D%20%27ab%27%3B%5Cnconsole.log%28s.length%29%3B%5Cn%22%29%2C%20undefined%29%3B%0A%20%20assert.equal%28refusal%28%27const%20xs%20%3D%20%5B1%2C%20%2C%202%5D%3B%5Cn%27%29%2C%20refusal%28%27const%20xs%20%3D%20%5B1%2C%20%2C%202%5D%3B%5Cn%27%29%29%3B%0A%20%20assert.match%28refusal%28%27const%20xs%20%3D%20%5B1%2C%20%2C%202%5D%3B%5Cn%27%29%2C%20%2F%5Earray%20hole%2Fu%29%3B%0A%20%20assert.match%28refusal%28%27for%20%28const%20k%20in%20%7B%20a%3A%201%20%7D%29%20console.log%28k%29%3B%5Cn%27%29%2C%20%2F%5Efor%E2%80%A6in%20loop%2Fu%29%3B%0A%7D%29%3B%0A%0A%2F%2F%20BEGIN%20modern%20JavaScript%20array%20parity%20observations%0Atest%28%27retained%20modern%20JavaScript%20array