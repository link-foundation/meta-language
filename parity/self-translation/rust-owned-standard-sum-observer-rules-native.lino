%20%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20method%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumMethodCallbackArgument%28owner%2Cmethod%29%7B%0A%20if%28readRustStandardSumMethodArity%28owner%2Cmethod%29%3C0%29return%20-2%3B%0A%20if%28method%3D%3D%3D%27map%27%7C%7Cmethod%3D%3D%3D%27and_then%27%29return%200%3B%0A%20return%20method%3D%3D%3D%27unwrap_or_else%27%3F%28owner%3D%3D%3D%27std%3A%3Aoption%3A%3AOption%27%3F-1%3A1%29%3A-2%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20method%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumMethodResult%28owner%2Cmethod%29%7B%0A%20if%28readRustStandardSumMethodArity%28owner%2Cmethod%29%3C0%29return%20%27%27%3B%0A%20return%20method%3D%3D%3D%27map%27%3F%27mapped%20sum%27%3Amethod%3D%3D%3D%27and_then%27%3F%27bound%20sum%27%3Amethod%3D%3D%3D%27unwrap_or%27%7C%7Cmethod%3D%3D%3D%27unwrap_or_else%27%7C%7CtestRustOptionPanicConsumer%28method%29%3F%27payload%27%3A%27boolean%27%3B%0A%7D%0A%0A%2F%2A%2A%20Constructor%20roles%20are%20selected%20from%20actual%20standard%20field%20positions.%0A%20%2A%20Captures%20precede%20the%20match%3A%20even%20an%20unused%20eager%20default%2Ffactory%20evaluates.%0A%20%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20constructor%20%40param%20%7Bstring%7D%20method%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumMethodBranch%28owner%2Cconstructor%2Cmethod%29%7B%0A%20if%28readRustStandardSumMethodArity%28owner%2Cmethod%29%3C0%29return%20%27%27%3B%0A%20const%20argument%3DreadRustStandardSumSourceFieldArgument%28owner%2Cconstructor%29%3B%0A%20if%28argument%3D%3D%3D-2%29return%20%27%27%3B%0A%20const%20success%3Dargument%3D%3D%3D0%3B%0A%20if%28testRustOptionPanicConsumer%28method%29%29return%20success%3F%27payload%27%3A%27panic%27%3B%0A%20if%28method%3D%3D%3D%27is_some%27%7C%7Cmethod%3D%3D%3D%27is_ok%27%29return%20success%3F%27true%27%3A%