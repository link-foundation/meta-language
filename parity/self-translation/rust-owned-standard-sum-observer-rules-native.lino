(346: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadRustStandardSumMethodBranch%7D%20from%20%27.%2Frust-standard-sum-method-rules.js%27%3B%0A%2F%2A%2A%20The%20actual%20standard%20methods%20borrow%20%26self%3B%20they%20never%20consume%20their%20payload.%0A%20%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20method%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustOwnedStandardSumObserverArity%28owner%2Cmethod%29%7Breturn%20owner%3D%3D%3D%27std%3A%3Aoption%3A%3AOption%27%26%26%28method%3D%3D%3D%27is_some%27%7C%7Cmethod%3D%3D%3D%27is_none%27%29%7C%7Cowner%3D%3D%3D%27std%3A%3Aresult%3A%3AResult%27%26%26%28method%3D%3D%3D%27is_ok%27%7C%7Cmethod%3D%3D%3D%27is_err%27%29%3F0%3A-1%3B%7D%0A%2F%2A%2A%20Direct%20Copy%20sums%20keep%20the%20existing%20dispatcher.%20Referenced%20Copy%20sums%20can%0A%20%2A%20carry%20a%20transitive%20loan%20from%20an%20owned%20enclosing%20constructor.%0A%20%2A%20%40param%20%7Bstring%7D%20profile%20%40param%20%7Bnumber%7D%20layers%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustOwnedStandardSumObserverProfile%28profile%2Clayers%29%7Breturn%20profile%3D%3D%3D%27owned%27%7C%7Cprofile%3D%3D%3D%27copy%27%26%26Number.isInteger%28layers%29%26%26layers%3E0%3B%7D%0A%2F%2A%2A%20Facts%20come%20from%20the%20original%20expression%2C%20including%20its%20root%2Floan%20identities.%0A%20%2A%20A%20checked%20reference%20parameter%20can%20have%20elided%20lifetimes%20and%20no%20local%20owner%3B%0A%20%2A%20local%20references%20retain%20their%20existing%20root%2Floan%20state%20checks%20separately.%0A%20%2A%20%40param%20%7Bboolean%7D%20proven%20%40param%20%7Bnumber%7D%20layers%20%40param%20%7Bboolean%7D%20references%0A%20%2A%20%40param%20%7Bnumber%7D%20lifetimes%20%40param%20%7Bboolean%7D%20tracked%20%40param%20%7Bboolean%7D%20available%0A%20%2A%20%40param%20%7Bboolean%7D%20produced%20%40param%20%7Bboolean%7D%20borrowed%20%40param%20%7Bboolean%7D%20loans%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedStandardSumObserverSourceError%28proven%2Clayers%2Creferences%2Clifetimes%2Ctracked%2Cavailable%2Cproduced%2Cborrowed%2Cloans%29%7B%0A%20if%28%21proven%7C%7C%21tracked%7C%7C%21Number.isInteger%28layers%29%7C%7Clayers%3C0%29return%20%27an%20owned%20sum%20observer%20needs%20its%20actual%20checked%20ownership%20and%20source%20origin%27%3B%0A%20if%28layers%3E0%29return%20references%26%26lifetimes%3D%3D%3Dlayers%3F%27%27%3A%27an%20owned%20sum%20observer%20needs%20retained%20immutable%20reference%20and%20lifetime%20provenance%27%3B%0A%20if%28borrowed%29return%20loans%7C%7Cproduced%3F%27%27%3A%27an%20owned%20sum%20observer%20cannot%20inspect%20an%20unproven%20borrowed%20source%20place%27%3B%0A%20return%20available%7C%7Cproduced%3F%27%27%3A%27an%20owned%20sum%20observer%20needs%20an%20available%20source%20root%20or%20an%20actual%20owned%20producer%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20variant%20%40param%20%7Bstring%7D%20method%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedStandardSumObserverBranch%28owner%2Cvariant%2Cmethod%29%7Breturn%20readRustOwnedStandardSumObserverArity%28owner%2Cmethod%29%3C0%3F%27%27%3AreadRustStandardSumMethodBranch%28owner%2Cvariant%2Cmethod%29%3B%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20method%20%40param%20%7Bnumber%7D%20minor%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedStandardSumObserverVersionError%28owner%2Cmethod%2Cminor%29%7Breturn%20readRustOwnedStandardSumObserverArity%28owner%2Cmethod%29%3C0%7C%7CNumber.isInteger%28minor%29%26%26minor%3E%3D90%26%26minor%3C100%3F%27%27%3A%27owned%20standard%20sum%20observer%20source%20semantics%20are%20uncovered%20outside%20Rust%20%3E%3D1.90.0%20%3C1.100.0%27%3B%7D%0A) (lang: meta-language%20structured%20data)))
