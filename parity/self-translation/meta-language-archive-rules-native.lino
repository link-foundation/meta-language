(237: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Generated%20from%20complete%20js%2Fsrc%2Fmeta-language-archive-rules.js.%20Do%20not%20edit%20by%20hand.%0A%2F%2F%2F%20The%20Math%20functions%20that%20Rust%27s%20f64%20methods%20do%20not%20share%20with%20JavaScript.%0Apub%20mod%20ml_math%20%7B%0A%20%20%20%20%2F%2F%2F%20Math.round%3A%20the%20nearest%20integer%2C%20the%20one%20towards%20%2BInfinity%20on%20a%20tie%2C%0A%20%20%20%20%2F%2F%2F%20with%20the%20sign%20of%20a%20zero%20result%20from%20the%20argument.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20fn%20round%28x%3A%20f64%29%20-%3E%20f64%20%7B%0A%20%20%20%20%20%20%20%20if%20%21x.is_finite%28%29%20%7C%7C%20x%20%3D%3D%200.0%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20return%20x%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20if%20x%20%3E%200.0%20%26%26%20x%20%3C%200.5%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20return%200.0%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20if%20%28-0.5..0.0%29.contains%28%26x%29%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20return%20-0.0%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20let%20floor%20%3D%20x.floor%28%29%3B%0A%20%20%20%20%20%20%20%20if%20x%20-%20floor%20%3E%3D%200.5%20%7B%20floor%20%2B%201.0%20%7D%20else%20%7B%20floor%20%7D%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20Math.sign%2C%20which%20keeps%20-0%2C%200%20and%20NaN%2C%20where%20%60f64%3A%3Asignum%60%20does%20not.%0A%20%20%20%20%23%5Bmust_use%5D%0A%20%20%20%20pub%20fn%20sign%28x%3A%20f64%29%20-%3E%20f64%20%7B%0A%20%20%20%20%20%20%20%20if%20x%20%3E%200.0%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%201.0%0A%20%20%20%20%20%20%20%20%7D%20else%20if%20x%20%3C%200.0%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20-1.0%0A%20%20%20%20%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20x%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%0A%20%20%20%20%2F%2F%2F%20Math.max%20of%20two%20Numbers%3A%20NaN%20when%20either%20is%2C%20and%200%20above%20-0.%0A%20%20%2