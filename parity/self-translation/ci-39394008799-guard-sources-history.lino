(3699: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20test%20from%20%27node%3Atest%27%3B%0Aimport%20%7BparseWorkflow%7D%20from%20%27..%2F..%2Fscripts%2Fcheck-cache-policy.mjs%27%3B%0Aimport%20%7BreadProjectData%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BrestorePlatformTestDeadlineHistory%7D%20from%20%27.%2Fsupport%2Fplatform-test-deadline-history.js%27%3B%0A%0Aconst%20history%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fnaming%2Fplatform-test-deadline-source-history.lino%27%2Cimport.meta.url%29%29%3B%0Aconst%20read%3Dfile%3D%3EreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bfile%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%0Atest%28%27actual%20cold%20platform%20deadlines%20retain%20every%20complete%20test%20cell%20and%20checked%20compiler%20argument%27%2C%28%29%3D%3E%7B%0A%20%20for%28const%20row%20of%20history.sources%29%7B%0A%20%20%20%20assert.equal%28Buffer.byteLength%28row.sourceText%29%2Crow.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28row.sourceText%29.digest%28%27hex%27%29%2Crow.sha256%29%3B%0A%20%20%7D%0A%20%20assert.equal%28history.captures.length%2C3%29%3B%0A%20%20const%20windows%3Dhistory.captures.find%28row%3D%3Erow.job%3D%3D%3D118270931507%29%3B%0A%20%20assert.equal%28windows.jobRecord.conclusion%2C%27cancelled%27%29%3B%0A%20%20assert.ok%28windows.annotations.some%28row%3D%3Erow.message%3D%3D%3D%27The%20job%20has%20exceeded%20the%20maximum%20execution%20time%20of%2015m0s%27%29%29%3B%0A%20%20for%28const%20capture%20of%20history.captures%29%7B%0A%20%20%20%20assert.equal%28capture.run%2C39309745847%29%3B%0A%20%20%20%20assert.equal%28capture.testedCommit%2C%278e153ff84594dd43513f322dad04e2bb4255a863%27%29%3B%0A%20%20%20%20assert.ok%28capture.diagnosticLines.some%28line%3D%3Eline.includes%28%27Finished%20%60test%60%20profile%27%29%29%29%3B%0A%20%20%20%20assert.ok%28capture.diagnosticLines.some%28line%3D%3E%2Foperation%20was%20cancel%2Fiu.test%28line%29%29%29%3B%0A%20%20%7D%0A%20%20assert.equal%28history.deadlineMinutes%2C30%29%3B%0A%20%20for%28const%20change%20of%20history.changes%29%7B%0A%20%20%20%20const%20original%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3Dchange.file%29.sourceText%2Ccurrent%3Dread%28change.file%29%3B%0A%20%20%20%20assert.equal%28current%2Coriginal.replace%28change.before%2Cchange.after%29%2C%27only%20the%20complete%20recorded%20deadline%20block%20changes%27%29%3B%0A%20%20%20%20assert.equal%28restorePlatformTestDeadlineHistory%28current%29%2Coriginal%29%3B%0A%20%20%7D%0A%20%20const%20before%3DparseWorkflow%28history.sources%5B0%5D.sourceText%29%2Cafter%3DparseWorkflow%28read%28history.sources%5B0%5D.file%29%29%3B%0A%20%20assert.equal%28after.length%2Cbefore.length%29%3B%0A%20%20for%28let%20at%3D0%3Bat%3Cbefore.length%3Bat%2B%2B%29%7B%0A%20%20%20%20const%20old%3Dbefore%5Bat%5D%2Ccurrent%3Dafter%5Bat%5D%3Bassert.equal%28current.id%2Cold.id%29%3B%0A%20%20%20%20assert.deepEqual%28current.steps%2Cold.steps%2C%27every%20test%20command%2C%20filter%2C%20conditional%20and%20compiler%20safety%20flag%20remains%20exact%27%29%3B%0A%20%20%20%20if%28old.id%3D%3D%3D%27test%27%29%7B%0A%20%20%20%20%20%20assert.deepEqual%28%5B...current.header.matchAll%28%2F%5E%20%7B4%7Dtimeout-minutes%3A%20%28.%2B%29%24%2Fgmu%29%5D.map%28row%3D%3Erow%5B1%5D%29%2C%5B%2730%27%5D%29%3B%0A%20%20%20%20%20%20assert.equal%28current.header%2Cold.header.replace%28history.changes%5B0%5D.before%2Chistory.changes%5B0%5D.after%29%29%3B%0A%20%20%20%20%7Delse%20assert.equal%28current.header%2Cold.header%2C%27all%20other%20jobs%20and%20deadlines%20remain%20exact%27%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27platform%20deadline%20source%20controls%20retain%20every%20preceding%20guard%20and%20expose%20partial%20repeated%20and%20unrelated%20edits%27%2C%28%29%3D%3E%7B%0A%20%20for%28const%20change%20of%20history.changes%29%7B%0A%20%20%20%20const%20source%3Dread%28change.file%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestorePlatformTestDeadlineHistory%28source%2B%27%5Cn%27%2Bchange.after%29%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestorePlatformTestDeadlineHistory%28source%2B%27%5Cn%27%2Bchange.before%29%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestorePlatformTestDeadlineHistory%28source.replace%28change.after%2Cchange.after.replace%28%2730%27%2C%2731%27%29%29%29%29%3B%0A%20%20%20%20assert.equal%28restorePlatformTestDeadlineHistory%28source%2B%27%5Cn%2F%2F%20unrelated%20source%20edit%5Cn%27%29%2C%0A%20%20%20%20%20%20history.sources.find%28row%3D%3Erow.file%3D%3D%3Dchange.file%29.sourceText%2B%27%5Cn%2F%2F%20unrelated%20source%20edit%5Cn%27%29%3B%0A%20%20%7D%0A%20%20const%20testImport%3D%22%5Cnimport%20%7BrestorePlatformTestDeadlineHistory%7D%20from%20%27.%2Fsupport%2Fplatform-test-deadline-history.js%27%3B%5Cn%22%3B%0A%20%20const%20views%3D%5B%0A%20%20%20%20%7Bfile%3A%27js%2Ftests%2Fsupport%2Fci-node-runtime-history.js%27%2Cedits%3A%5B%5B%22%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%22%2C%22%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%5Cn%20%20source%3DrestorePlatformTestDeadlineHistory%28source%29%3B%22%5D%5D%2Caddition%3A%22%5Cnimport%20%7BrestorePlatformTestDeadlineHistory%7D%20from%20%27.%2Fplatform-test-deadline-history.js%27%3B%5Cn%22%7D%2C%0A%20%20%20%20%7Bfile%3A%27js%2Ftests%2Fsupport%2Fnative-test-profile-history.js%27%2Cedits%3A%5B%5B%22%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%22%2C%22%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%5Cn%20%20source%3DrestorePlatformTestDeadlineHistory%28source%29%3B%22%5D%5D%2Caddition%3A%22%5Cnimport%20%7BrestorePlatformTestDeadlineHistory%7D%20from%20%27.%2Fplatform-test-deadline-history.js%27%3B%5Cn%22%7D%2C%0A%20%20%20%20%7Bfile%3A%27js%2Ftests%2Fissue-195-evidence-ci-node-runtime.test.js%27%2Cedits%3A%5B%5B%22%20%20%20%20const%20c