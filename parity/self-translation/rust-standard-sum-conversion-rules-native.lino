2A%20Concrete%20datatype%20names%20never%20consume%20expression%2Fcompletion%20temporaries.%0A%20%2A%20%40param%20%7Bnumber%7D%20ordinal%20%40param%20%7Bnumber%7D%20collision%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceSpecializationName%28ordinal%2Ccollision%29%7B%0A%20if%28%21Number.isInteger%28ordinal%29%7C%7Cordinal%3C0%7C%7Cordinal%3E%3D256%7C%7C%21Number.isInteger%28collision%29%7C%7Ccollision%3C0%7C%7Ccollision%3E%3D4096%29return%20%27%27%3B%0A%20return%20%27ml_standard_sum_value%27%2BString%28ordinal%29%2B%27_%27%2BString%28collision%29%3B%0A%7D%0A%0A%2F%2A%2A%20Header%20inventory%20is%20private%20syntax%20context%2C%20never%20admitted%20Copy%20evidence.%0A%20%2A%20%40param%20%7Bboolean%7D%20header%20%40param%20%7Bboolean%7D%20complete%20%40param%20%7Bboolean%7D%20copies%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourcePhase%28header%2Ccomplete%2Ccopies%29%7B%0A%20return%20header%3F%27provisional%27%3Acomplete%26%26copies%3F%27admitted%27%3A%27refuse%27%3B%0A%7D%0A%0A%2F%2A%2A%20Complete%20concrete%20child%20depths%20include%20saved%20aliases%20and%20callable%2Fproducts.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20children%20%40param%20%7Bboolean%7D%20sum%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceDepth%28children%2Csum%29%7B%0A%20let%20depth%3D0%3B%0A%20for%28const%20child%20of%20children%29%7Bif%28%21Number.isInteger%28child%29%7C%7Cchild%3C0%7C%7Cchild%3E16%29return%20-1%3Bif%28child%3Edepth%29depth%3Dchild%3B%7D%0A%20const%20result%3Ddepth%2B%28sum%3F1%3A0%29%3Breturn%20result%3C%3D16%3Fresult%3A-1%3B%0A%7D%0A%0A%2F%2A%2A%20Charge%20complete%20source%20metadata%20before%20copying%20it.%20Units%20are%20UTF16%20code%0A%20%2A%20units%2C%20not%20encoded%20bytes.%20These%20finite%20bounds%20are%20independent%20of%20type%20depth.%0A%20%2A%20%40param%20%7Bnumber%7D%20nodes%20%40param%20%7Bnumber%7D%20units%20%40param%20%7Bnumber%7D%20additionalNodes%0A%20%2A%20%40param%20%7Bnumber%7D%20additionalUnits%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceMaterializationError%28nodes%2Cunits%2CadditionalNodes%2CadditionalUnits%29%7B%0A%20for%28const%20value%20of%20%5Bnodes%2Cunits%2CadditionalNodes%2CadditionalUnits%5D%29if%28%21Number.isInteger%28value%29%7C%7Cvalue%3C0%29return%20%27invalid%20standard%20sum%20source%20materialization%20count%27%3B%0A%20return%20nodes%3E1048576%7C%7Cunits%3E8388608%7C%7CadditionalNodes%3E1048576-nodes%7C%7CadditionalUnits%3E8388608-units%3F%27the%20complete%20standard%20sum%20source%20metadata%20exceeds%20its%20materialization%20budget%27%3A%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20owner%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceArgumentCount%28owner%29%7B%0A%20return%20owner%3D%3D%3D%27std%3A%3Aoption%3A%3AOption%27%3F1%3Aowner%3D%3D%3D%27std%3A%3Aresult%3A%3AResult%27%3F2%3A-1%3B%0A%7D%0A%0A%2F%2A%2A%20The%20argument%20identities%20come%20from%20complete%20checked%20origin%20structures%2C%20with%0A%20%2A%20separate%20entries%20even%20when%20their%20meaning%20agrees.%20A%20nested%20sum%20remains%20an%0A%20%2A%20actual%20child%20datatype%3B%20this%20function%20performs%20no%20identity%20construction.%0A%20%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%5B%5D%7D%20identities%0A%20%2A%20%40param%20%7Bboolean%5B%5D%7D%20directCopies%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustStandardSumSourceArguments%28owner%2Cidentities%2CdirectCopies%29%7B%0A%20const%20count%3DreadRustStandardSumSourceArgumentCount%28owner%29%3B%0A%20if%28count%3C0%7C%7Cidentities.length%21%3D%3Dcount%7C%7CdirectCopies.length%21%3D%3Dcount%29return%20false%3B%0A%20for%28let%20at%3D0%3Bat%3Ccount%3Bat%2B%3D1%29if%28%28identities%5Bat%5D%3F%3F%27%27%29%3D%3D%3D%27%27%7C%7CdirectCopies%5Bat%5D%21%3D%3Dtrue%29return%20false%3B%0A%20return%20true%3B%0A%7D%0A%0A%2F%2A%2A%20Exact%20original%20constructor%20order%20for%20the%20existing%20datatype%20declaration.%0A%20%2A%20Missing%2Fextra%20constructors%20must%20not%20be%20hidden%20by%20an%20optional-value%20encoding.%0A%20%2A%20%40param%20%7Bstring%7D%20owner%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceConstructors%28owner%29%7B%0A%20return%20owner%3D%3D%3D%27std%3A%3Aoption%3A%3AOption%27%3F%5B%27None%27%2C%27Some%27%5D%3Aowner%3D%3D%3D%27std%3A%3Aresult%3A%3AResult%27%3F%5B%27Ok%27%2C%27Err%27%5D%3A%5B%5D%3B%0A%7D%0A%0A%2F%2A%2A%20Zero-based%20actual%20type%20argument%20for%20the%20sole%20field%3B%20-1%20is%20a%20nullary%0A%20%2A%20constructor%20and%20-2%20refuses.%20The%20adapter%20retains%20actual%20constructor%20ownership%0A%20%2A%20separately%2C%20before%20passing%20its%20selected%20local%20variant%20name%20here.%0A%20%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20constructor%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceFieldArgument%28owner%2Cconstructor%29%7B%0A%20if%28owner%3D%3D%3D%27std%3A%3Aoption%3A%3AOption%27%29return%20constructor%3D%3D%3D%27None%27%3F-1%3Aconstructor%3D%3D%3D%27Some%27%3F0%3A-2%3B%0A%20if%28owner%3D%3D%3D%27std%3A%3Aresult%3A%3AResult%27%29return%20constructor%3D%3D%3D%27Ok%27%3F0%3Aconstructor%3D%3D%3D%27Err%27%3F1%3A-2%3B%0A%20return%20-2%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20constructor%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustStandardSumSourceConstructorArity%28owner%2Cconstructor%29%7B%0A%20const%20argument%3DreadRustStandardSumSourceFieldArgument%28owner%2Cconstructor%29%3B%0A%20return%20argument%3D%3D%3D-2%3F-1%3Aargument%3D%3D%3D-1%3F0%3A1%3B%0A%7D%0A%0A%2F%2A%2A%20Only%20this%20constructor%27s%20one%20actual%20payload%20determines%20every%20type%20argument.%0A%20%2A%20Other%20variants%20require%20an%20explicit%20or%20contextual%20complete%20sum%20type.%0A%20%2A%20%40param%20%