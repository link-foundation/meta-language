(4954: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20The%20checked%20portable%20core%3A%20every%20expression%20carries%20its%20type%20and%20every%0A%2F%2F%21%20operator%20its%20source%20semantics.%20Emitters%20consume%20it%3B%20the%20renaming%20passes%0A%2F%2F%21%20give%20each%20target%20unique%2C%20legal%20local%20names.%0A%2F%2F%21%0A%2F%2F%21%20The%20JSON%20form%20is%20the%20JavaScript%20runtime%27s%20checked%20program%2C%20except%20that%0A%2F%2F%21%20%60declarations%60%20is%20an%20array%20and%20%60items%60%20refer%20to%20declarations%20by%20name.%0A%0Ause%20std%3A%3Acollections%3A%3A%7BBTreeSet%2C%20HashMap%2C%20HashSet%7D%3B%0A%0Ause%20serde%3A%3A%7BDeserialize%2C%20Serialize%7D%3B%0A%0Ause%20super%3A%3Asurface%3A%3A%7BBinaryOp%2C%20External%2C%20Flavor%2C%20Guard%2C%20Rounding%2C%20SImport%2C%20UnaryOp%7D%3B%0Ause%20super%3A%3Atypes%3A%3AType%3B%0Ause%20super%3A%3A%7BLanguage%2C%20Span%7D%3B%0A%0Amod%20declarations%3B%0Amod%20record_entry%3B%0Amod%20reference_type%3B%0Amod%20rename%3B%0Apub%20use%20record_entry%3A%3ARecordEntry%3B%0Amod%20nodes%3B%0Apub%20use%20nodes%3A%3ANode%3B%0A%23%5Ballow%28clippy%3A%3Atrivially_copy_pass_by_ref%29%5D%20%2F%2F%20serde%20passes%20fields%20by%20reference%0Aconst%20fn%20is_false%28value%3A%20%26bool%29%20-%3E%20bool%20%7B%0A%20%20%20%20%21%2Avalue%0A%7D%0A%0Apub%20use%20self%3A%3Adeclarations%3A%3A%7B%0A%20%20%20%20Ctor%2C%20DataDecl%2C%20Decl%2C%20Field%2C%20FnDecl%2C%20LambdaParam%2C%20Param%2C%20TheoremDecl%2C%0A%7D%3B%0Apub%20use%20self%3A%3Arename%3A%3A%2A%3B%0A%0A%2F%2F%2F%20Arithmetic%20semantics%3A%20exact%20on%20unbounded%20integers%2C%20checked%20%28aborting%29%0A%2F%2F%2F%20machine%20arithmetic%2C%20truncated%20natural%20subtraction%2C%20or%20IEEE-754%20binary64%0A%2F%2F%2F%20arithmetic%20on%20JavaScript%20Numbers.%0A%23%5Bderive%28Clone%2C%20Copy%2C%20Debug%2C%20PartialEq%2C%20Eq%2C%20Serialize%2C%20Deserialize%29%5D%0A%23%5Bserde%28rename_all%20%3D%20%22camelCase%22%29%5D%0Apub%20enum%20Se