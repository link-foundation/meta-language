%20%20if%20%28program%20%26%26%20typeof%20program%20%3D%3D%3D%20%27object%27%20%26%26%20Object.hasOwn%28program%2C%20%27sourcePureUnitCalls%27%29%29%20checkRustPureUnitCalls%28program%29%3B%0A%20%20checkRustOwnedLocalStateRecordShapes%28program%29%3B%0A%20%20validateSourceSpans%28program%29%3B%0A%20%20if%20%28%21program%20%7C%7C%20program.schemaVersion%20%21%3D%3D%201%20%7C%7C%20%21%5B%27JavaScript%27%2C%20%27Rust%27%2C%20%27Lean%27%2C%20%27Rocq%27%5D.includes%28program.sourceLanguage%29%0A%20%20%20%20%7C%7C%20%21%28program.declarations%20instanceof%20Map%29%20%7C%7C%20%21Array.isArray%28program.items%29%29%20throw%20new%20TypeError%28%27the%20linked%20value%20is%20not%20a%20checked%20typed%20program%27%29%3B%0A%20%20if%20%28program.main%20%21%3D%20null%20%26%26%20%28typeof%20program.main%20%21%3D%3D%20%27object%27%20%7C%7C%20Array.isArray%28program.main%29%0A%20%20%20%20%7C%7C%20program.main.k%20%21%3D%3D%20undefined%20%7C%7C%20program.main.p%20%21%3D%3D%20undefined%20%7C%7C%20%21Array.isArray%28program.main.effects%29%29%29%20throw%20new%20TypeError%28%27a%20linked%20main%20has%20an%20invalid%20effect-container%20role%27%29%3B%0A%20%20if%20%28%21acceptProgramStringRepresentationFlag%28typeof%20program.utf16Strings%2C%20Object.hasOwn%28program%2C%20%27utf16Strings%27%29%29%29%20throw%20new%20TypeError%28%27a%20program%20string%20representation%20flag%20must%20be%20an%20explicit%20boolean%27%29%3B%0A%20%20const%20active%20%3D%20new%20Set%28%29%3B%0A%20%20const%20visited%20%3D%20new%20Set%28%29%3B%0A%20%20function%20targetOf%28node%2C%20role%29%20%7B%0A%20%20%20%20for%20%28const%20%5Blabel%2C%20target%5D%20of%20references.get%28node%29%20%3F%3F%20%5B%5D%29%20if%20%28readProgramReferenceRole%28label%29%20%3D%3D%3D%20role%29%20return%20target%3B%0A%20%20%20%20return%20undefined%3B%0A%20%20%7D%0A%20%20function%20bounded%28value%2C%20depth%20%3D%200%29%20%7B%0A%20%20%20%20if%20%28%21value%20%7C%7C%20typeof%20value%20%21%3D%3D%20%27object%27%29%20%7B%0A%20%20%20%20%20%20if%20%28typeof%20value%20%3D%3D%3D%20%27function%27%20%7C%7C%20typeof%20value%20%3D%3D%3D%20%27symbol%27%29%20throw%20new%20TypeError%28%27typed%20programs%20contain%20data%2C%20not%20host%20callbacks%27%29%3B%0A%20%20%20%20%20%20return%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28active.has%28value%29%29%20throw%20new%20TypeError%28%27the%20checked%20program%20contains%20a%20structural%20cycle%27%29%3B%0A%20%20%20%20if%20%28visited.has%28value%29%29%20return%3B%0A%20%20%20%20if%20%28depth%20%3E%20256%20%7C%7C%20visited.size%20%3E%3D%20100_000%29%20throw%20new%20TypeError%28%27the%20checked%20program%20exceeds%20its%20structural%20resource%20limit%27%29%3B%0A%20%20%20%20visited.add%28value%29%3B%20active.add%28value%29%3B%0A%20%20%20%20const%20values%20%3D%20value%20instanceof%20Map%20%3F%20%5B...value%5D.flat%28%29%20%3A%20Object.values%28value%29%3B%0A%20%20%20%20for%20%28const%20child%20of%20values%29%20bounded%28child%2C%20depth%20%2B%201%29%3B%0A%20%20%20%20active.delete%28value%29%3B%0A%20%20%7D%0A%20%20checkRustPureUnitCalls%28program%29%3B%0A%20%20bounded%28program%29%3B%0A%20%20checkRustUnitCloneDerivations%28program%29%3B%0A%20%20checkRustPrimitiveOwnerProof%28program%29%3B%0A%20%20checkRustConstFunctionProof%28program%29%3B%0A%20%20checkRustEmptyOptionProof%28program%29%3B%0A%20%20checkRustOwnedLocalStateProof%28program%29%3B%0A%20%20%2F%2F%20Shared%20records%20can%20describe%20exponentially%20many%20expression%20paths.%20Bound%0A%20%20%2F%2F%20the%20semantic%20walk%20as%20well%20as%20the%20number%20of%20unique%20structural%20records.%0A%20%20let%20semanticVisits%20%3D%200%3B%0A%20%20function%20visit%28%29%20%7B%0A%20%20%20%20if%20%28%2B%2BsemanticVisits%20%3E%20100_000%29%20throw%20new%20TypeError%28%27the%20linked%20program%20exceeds%20its%20semantic%20resource%20limit%27%29%3B%0A%20%20%7D%0A%20%20function%20type%28value%29%20%7B%0A%20%20%20%20visit%28%29%3B%0A%20%20%20%20if%20%28%21value%20%7C%7C%20typeof%20value%20%21%3D%3D%20%27object%27%20%7C%7C%20typeof%20value.kind%20%21%3D%3D%20%27string%27%29%20throw%20new%20TypeError%28%27the%20linked%20program%20contains%20a%20malformed%20type%27%29%3B%0A%20%20%20%20if%20%28primitives.has%28value.kind%29%29%20return%3B%0A%20%20%20%20if%20%28value.kind%20%3D%3D%3D%20%27fixed%27%29%20%7B%0A%20%20%20%20%20%20if%20%28%21acceptProgramIntegralMetadata%28value.kind%2C%20%27bits%27%2C%20value.bits%2C%20Object.is%28value.bits%2C%20-0%29%29%20%7C%7C%20typeof%20value.signed%20%21%3D%3D%20%27boolean%27%29%20throw%20new%20TypeError%28%27the%20linked%20program%20contains%20an%20invalid%20machine%20integer%20type%27%29%3B%0A%20%20%20%20%7D%20else%20if%20%28value.kind%20%3D%3D%3D%20%27data%27%29%20%7B%0A%20%20%20%20%20%20if%20%28typeof%20value.name%20%21%3D%3D%20%27string%27%20%7C%7C%20%21value.name%29%20throw%20new%20TypeError%28%27a%20linked%20data%20type%20has%20no%20name%27%29%3B%0A%20%20%20%20%20%20const%20declaration%20%3D%20declarations.get%28value.name%29%3B%0A%20%20%20%20%20%20if%20%28declaration%3F.k%20%21%3D%3D%20%27data%27%29%20throw%20new%20TypeError%28%27a%20linked%20data%20type%20does%20not%20target%20a%20datatype%20declaration%27%29%3B%0A%20%20%20%20%20%20const%20target%20%3D%20targetOf%28value%2C%20%27datatype%27%29%3B%0A%20%20%20%20%20%20if%20%28target%20%26%26%20target%20%21%3D%3D%20declaration%29%20throw%20new%20TypeError%28%27a%20linked%20data%20type%20targets%20a%20different%20datatype%20declaration%27%29%3B%0A%20%20%20%20%7D%20else%20if%20%28%5B%27array%27%2C%20%27set%27%2C%20%27option%27%2C%20%27cell%27%5D.includes%28value.kind%29%29%20%7B%0A%20%20%20%20%20%20type%28value.element%29%3B%0A%20%20%20%20%20%20if%20%28value.kind%20%3D%3D%3D%20%27option%27%20%26%26%20%21acceptProgramOptionalAbsence%28value.absence%20%3F%3F%20%27both%27%29%29%20throw%20new%20TypeError%28%27a%20linked%20optional%20type%20has%20an%20invalid%20absence%20policy%27%29%3B%0A%20%20%20%20%7D%20else%20if%20%28value.kind%20%3D%3D%3D%20%27tuple%27%29%20%7B%0A%20%20%20%20%20%20if%20%28%21Array.isArray%28value.elements%29%20%7C%7C%20Object.keys%28value%29.some%28field%20%3D%3E%20%21%5B%27kind%27%2C%20%27elements%27%5D.includes%28field%29%29%29%20throw%20new%20TypeError%28%27a%20linked%20tuple%20type%20has%20a%20malformed%20element%20layout%27%29%3B%0A%20%20%20%20%20%20value.elements.forEach%28type%29%3B%0A%20%20%20%20%7D%20else%20if%20%28value.kind%20%3D%3D%3D%20%27union%27%29%20%7B%0A%20%20%20%20%20%20if%20%28%21Array.isArray%28value.alternatives%29%20%7C%7C%20%21acceptUnionTypeCount%28value.alternatives.length%29%0A%20%20%20%20%20%20%20%20%7C%7C%20Object.keys%28value%29.some%28field%20%3D%3E%20%21acceptUnionTypeField%28field%29%29%29%20throw%20new%20TypeError%28%27a%20linked%20union%20type%20has%20a%20malformed%20ordered%20alternative%20layout%27%29%3B%0A%20%20%20%20%20%20for%20%28const%20alternative%20of%20value.alternatives%29%20type%28alternative%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20else%20if%20%28value.kind%20%3D%3D%3D%20%27record%27%29%20value.fields.forEach%28%28field%29%20%3D%3E%20type%28field.type%29%29%3B%0A%20%20%20%20else%20if%20%28value.kind%20%3D%3D%3D%20%27map%27%29%20%7B%20type%28value.key%29%3B%20type%28value.value%29%3B%20%7D%0A%20%20%20%20else%20if%20%28value.kind%20%3D%3D%3D%20%27function%27%29%20%7B%20value.params.forEach%28type%29%3B%20type%28value.ret%29%3B%20%7D%0A%20%20%20%20else%20throw%20new%20TypeError%28%60the%20linked%20program%20contains%20unsupported%20type%20%24%7Bvalue.kind%7D%60%29%3B%0A%20%20%7D%0A%20%20const%20declarations%3DcheckProgramDeclarationOwners%28program%2Cvisit%29%3B%0A%20%20const%20constructorOwners%20%3D%20new%20WeakMap%28%29%3B%0A%20%20const%20binderOwners%20%3D%20new%20WeakMap%28%29%3B%0A%20%20const%20patternOwners%20%3D%20new%20WeakMap%28%29%3B%0A%20%20function%20ownBinder%28binder%2C%20owner%2C%20slot%29%20%7B%0A%20%20%20%20const%20previous%20%3D%20binderOwners.get%28binder%29%3B%0A%20%20%20%20if%20%28previous%20%26%26%20%28previous.owner%20%21%3D%3D%20owner%20%7C%7C%20previous.slot%20%21%3D%3D%20slot%29%29%