nked%20logical%20operation%20has%20a%20nonboolean%20type%27%29%3B%0A%20%20%20%20%20%20%7D%20else%20if%20%28node.op%20%3D%3D%3D%20%27concat%27%29%20%7B%0A%20%20%20%20%20%20%20%20if%20%28node.left.type.kind%20%21%3D%3D%20%27string%27%20%7C%7C%20node.type.kind%20%21%3D%3D%20%27string%27%29%20throw%20new%20TypeError%28%27a%20linked%20concatenation%20has%20a%20nonstring%20type%27%29%3B%0A%20%20%20%20%20%20%7D%20else%20if%20%28%21comparison%29%20throw%20new%20TypeError%28%27a%20linked%20binary%20operation%20has%20no%20checked%20semantics%27%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28node.k%20%3D%3D%3D%20%27match%27%29%20%7B%0A%20%20%20%20%20%20expression%28node.scrutinee%2C%20environment%29%3B%0A%20%20%20%20%20%20if%20%28%21Array.isArray%28node.cases%29%20%7C%7C%20%21node.cases.length%29%20throw%20new%20TypeError%28%27a%20linked%20match%20has%20no%20cases%27%29%3B%0A%20%20%20%20%20%20for%20%28const%20kase%20of%20node.cases%29%20%7B%0A%20%20%20%20%20%20%20%20if%20%28%21kase%20%7C%7C%20%21kase.pattern%20%7C%7C%20%21kase.body%29%20throw%20new%20TypeError%28%27a%20linked%20match%20case%20is%20malformed%27%29%3B%0A%20%20%20%20%20%20%20%20const%20previous%20%3D%20patternScopes.get%28kase.pattern%29%3B%0A%20%20%20%20%20%20%20%20const%20scope%20%3D%20readLinkedPatternBindingScope%28graphPatterns%20%26%26%20previous%20%3F%20previous.graphPattern%20%3A%20kase.pattern%2C%0A%20%20%20%20%20%20%20%20%20%20node.scrutinee.type%2C%20declarations%2C%20%7B%20graph%3A%20graphPatterns%20%7D%29%3B%0A%20%20%20%20%20%20%20%20if%20%28scope.bindings.length%29%20%7B%0A%20%20%20%20%20%20%20%20%20%20const%20owner%20%3D%20patternOwners.get%28kase.pattern%29%3B%0A%20%20%20%20%20%20%20%20%20%20if%20%28owner%20%26%26%20owner%20%21%3D%3D%20kase%29%20throw%20new%20TypeError%28%27a%20linked%20pattern%20binding%20has%20multiple%20lexical%20owners%27%29%3B%0A%20%20%20%20%20%20%20%20%20%20patternOwners.set%28kase.pattern%2C%20kase%29%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20if%20%28kase.pa