forged%20cursor%20cannot%20skip%20unequal%20entries%20or%20invent%20already%20charged%20work.%0A%20const%20map%3DreadRustStandardCollectionKind%28resolveRustStandardCollectionOwner%28state.left.origin.resolvedOwner%2Ctrue%2Cfalse%29%29%3D%3D%3D%27map%27%3Blet%20work%3D0%3B%0A%20for%28let%20index%3D0%3Bindex%3Cstate.leftIndex%3Bindex%2B%2B%29%7B%0A%20%20const%20left%3Dstate.left.entries%5Bindex%5D%3Blet%20found%3Dfalse%3B%0A%20%20for%28const%20right%20of%20state.right.entries%29%7B%0A%20%20%20work%2B%3DreadRustStandardCollectionScalarEqualityWork%28left.key%2Cright.key%29%3B%0A%20%20%20if%28testRustStandardCollectionScalarEquality%28left.key%2Cright.key%29%29%7B%0A%20%20%20%20if%28map%29%7B%0A%20%20%20%20%20const%20leftValue%3Dleft.value%2CrightValue%3Dright.value%2Cinvalid%3D%27equality%20prefix%20retains%20actual%20equal%20owned%20values%27%3B%0A%20%20%20%20%20if%28leftValue%3D%3D%3Dundefined%29return%20invalid%3B%0A%20%20%20%20%20if%28rightValue%3D%3D%3Dundefined%29return%20invalid%3B%0A%20%20%20%20%20if%28%21testRustStandardCollectionScalarEquality%28leftValue%2CrightValue%29%29return%20invalid%3B%0A%20%20%20%20%20work%2B%3DreadRustStandardCollectionScalarEqualityWork%28leftValue%2CrightValue%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20found%3Dtrue%3Bbreak%3B%0A%20%20%20%7D%0A%20%20%7D%0A%20%20if%28%21found%29return%20%27equality%20prefix%20retains%20actual%20complete%20equal%20membership%27%3B%0A%20%7D%0A%20if%28state.leftIndex%3Cstate.left.entries.length%29%7Bconst%20left%3Dstate.left.entries%5Bstate.leftIndex%5D%3Bfor%28let%20index%3D0%3Bindex%3Cstate.rightIndex%3Bindex%2B%2B%29%7Bconst%20right%3Dstate.right.entries%5Bindex%5D%3Bif%28testRustStandardCollectionScalarEquality%28left.key%2Cright.key%29%29return%20%27equality%20search%20cursor%20cannot%20skip%20its%20actual%20matching%20key%27%3Bwork%2B%3DreadRustStandardCollectionScalarEqualityWork%28left.key%2Cright.key%29%3B%7Dif%28state.phase%3D%3D%3D%27value%27%29work%2B%3DreadRustStandardCollectionScalarEqualityWo