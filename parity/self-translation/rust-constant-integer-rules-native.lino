(111: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadRequiredTextFact%7D%20from%20%27.%2Ffact-column-rules.js%27%3B%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20value%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testRustIntegerRangeCanonicalDecimal%28value%29%7B%0A%20let%20digits%3Dvalue%3Bif%28digits.startsWith%28%27-%27%29%29digits%3Ddigits.slice%281%29%3B%0A%20if%28digits%3D%3D%3D%27%27%7C%7Cdigits.length%3E1%26%26digits.startsWith%28%270%27%29%7C%7Cvalue%3D%3D%3D%27-0%27%29return%20false%3B%0A%20for%28let%20at%3D0%3Bat%3Cdigits.length%3Bat%2B%3D1%29if%28%270123456789%27.indexOf%28digits.charAt%28at%29%29%3C0%29return%20false%3B%0A%20return%20true%3B%0A%7D%0A%2F%2A%2A%20Exact%20canonical%20decimal%20order%3B%20no%20host%20Number%20conversion.%0A%20%2A%20%40param%20%7Bstring%7D%20left%20%40param%20%7Bstring%7D%20right%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20compareRustIntegerRangeDecimals%28left%2Cright%29%7B%0A%20if%28%21testRustIntegerRangeCanonicalDecimal%28left%29%7C%7C%21testRustIntegerRangeCanonicalDecimal%28right%29%29return%202%3B%0A%20const%20negativeLeft%3Dleft.startsWith%28%27-%27%29%2CnegativeRight%3Dright.startsWith%28%27-%27%29%3B%0A%20if%28negativeLeft%21%3D%3DnegativeRight%29return%20negativeLeft%3F-1%3A1%3B%0A%20const%20a%3DnegativeLeft%3Fleft.slice%281%29%3Aleft%2Cb%3DnegativeRight%3Fright.slice%281%29%3Aright%3B%0A%20let%20order%3Da.length%3Cb.length%3F-1%3Aa.length%3Eb.length%3F1%3A0%3B%0A%20if%28order%3D%3D%3D0%29%7Bfor%28let%20at%3D0%3Bat%3Ca.length%3Bat%2B%3D1%29%7Bconst%20x%3D%270123456789%27.indexOf%28a.charAt%28at%29%29%2Cy%3D%270123456789%27.indexOf%28b.charAt%28at%29%29%3Bif%28x%3Cy%29%7Border%3D-1%3Bbreak%3B%7Dif%28x%3Ey%29%7Border%3D1%3Bbreak%3B%7D%7D%7D%0A%20if%28order%3D%3D%3D0%29return%200%3B%0A%20return%20negativeLeft%3F-order%3Aorder%3B%0A%7D%0A%2F%2A%2A%20Exact%20successor%2C%20including%20the%20boundary%20after%20u128%3A%3AMAX.%0A%20%2A%20%40param%20%7Bstring%7D%20value%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustIntegerRangeSuccessor%28value%29%7B%0A%20if%28%21testRustIntegerRangeCanonicalDecimal%28value%29%29return%20%27%27%3B%0A%20const%20negative%3Dvalue.startsWith%28%27-%27%29%2Cdigits%3Dnegative%3Fvalue.slice%281%29%3Avalue%3B%0A%20let%20result%3D%27%27%2Ccarry%3Dtrue%3B%0A%20for%28let%20at%3Ddigits.length-1%3Bat%3E%3D0%3Bat-%3D1%29%7B%0A%20%20let%20digit%3D%270123456789%27.indexOf%28digits.charAt%28at%29%29%3B%0A%20%20if%28carry%29%7Bif%28negative%29%7Bif%28digit%3D%3D%3D0%29digit%3D9%3Belse%7Bdigit-%3D1%3Bcarry%3Dfalse%3B%7D%7Delse%20if%28digit%3D%3D%3D9%29digit%3D0%3Belse%7Bdigit%2B%3D1%3Bcarry%3Dfalse%3B%7D%7D%0A%20%20result%3D%270123456789%27.charAt%28digit%29%2Bresult%3B%0A%20%7D%0A%20if%28negative%29%7Bif%28result.startsWith%28%270%27%29%26%26result.length%3E1%29result%3Dresult.slice%281%29%3Breturn%20result%3D%3D%3D%270%27%3F%270%27%3A%27-%27%2Bresult%3B%7D%0A%20return%20carry%3F%271%27%2Bresult%3Aresult%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bboolean%7D%20ordinary%20%40param%20%7Bstring%7D%20operation%20%40param%20%7Bboolean%7D%20lower%0A%20%2A%20%40param%20%7Bboolean%7D%20upper%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustIntegerRangeSourceError%28ordinary%2Coperation%2Clower%2Cupper%29%7B%0A%20if%28%21ordinary%29return%20%27ranges%20are%20outside%20the%20portable%20pattern%20language%27%3B%0A%20if%28operation%21%3D%3D%27..%27%26%26operation%21%3D%3D%27..%3D%27%29return%20%27a%20range%20pattern%20requires%20its%20actual%20range%20operator%27%3B%0A%20if%28%21lower%26%26%21upper%29return%20%27a%20range%20pattern%20needs%20at%20least%20one%20endpoint%27%3B%0A%20if%28operation%3D%3D%3D%27..%3D%27%26%26%21upper%29return%20%27an%20inclusive%20range%20pattern%20needs%20its%20upper%20endpoint%27%3B%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20lower%20%40param%20%7Bstring%7D%20upper%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustIntegerRangeBoundsError%28lower%2Cupper%29%7B%0A%20const%20order%3DcompareRustIntegerRangeDecimals%28lower%2Cupper%29%3B%0A%20return%20order%3D%3D%3D2%3F%27range%20endpoints%20require%20exact%20canonical%20integers%27%3Aorder%3E%3D0%3F%27a%20range%20pattern%20must%20contain%20at%20least%20one%20integer%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20Complete%20ordered%20half-open%20integer%20cells%2C%20independent%20of%20domain%20size.%0A%20%2A%20%40param%20%7Bstring%7D%20minimum%20%40param%20%7Bstring%7D%20maximum%20%40param%20%7Bstring%5B%5D%7D%20lowers%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20uppers%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%0Aexport%20function%20readRustIntegerRangeCuts%28minimum%2Cmaximum%2Clowers%2Cuppers%29%7B%0A%20if%28lowers.length%21%3D%3Duppers.length%7C%7CreadRustIntegerRangeBoundsError%28minimum%2Cmaximum%29%21%3D%3D%27%27%29return%20%5B%5D%3B%0A%20for%28let%20row%3D0%3Brow%3Clowers.length%3Brow%2B%3D1%29%7Bconst%20lower%3DreadRequiredTextFact%28lowers%2Crow%29%2Cupper%3DreadRequiredTextFact%28uppers%2Crow%29%3Bif%28lower%3D%3D%3D%27%27%26%26upper%3D%3D%3D%27%27%29continue%3Bif%28readRustIntegerRangeBoundsError%28lower%2Cupper%29%21%3D%3D%27%27%7C%7CcompareRustIntegerRangeDecimals%28lower%2Cminimum%29%3C0%7C%7CcompareRustIntegerRangeDecimals%28upper%2Cmaximum%29%3E0%29return%20%5B%5D%3B%7D%0A%20const%20result%3D%5Bminimum%5D%3Blet%20current%3Dminimum%3B%0A%20while%28current%21%3D%3Dmaximum%29%7B%0A%20%20let%20next%3Dmaximum%3B%0A%20%20for%28let%20row%3D0%3Brow%3Clowers.length%3Brow%2B%3D1%29%7Bconst%20lower%3DreadRequiredTextFact%28lowers%2Crow%29%2Cupper%3DreadRequiredTextFact%28uppers%2Crow%29%3Bif%28lower%21%3D%3D%27%27%26%26compareRustIntegerRangeDecimals%28lower%2Ccurrent%29%3E0%26%26compareRustIntegerRangeDecimals%28lower%2Cnext%29%3C0%29next%3Dlower%3Bif%28upper%21%3D%3D%27%27%26%26compareRustIntegerRangeDecimals%28upper%2Ccurrent%29%3E0%26%26compareRustIntegerRangeDecimals%28upper%2Cnext%29%3C0%29next%3Dupper%3B%7D%0A%20%20result.push%28next%29%3Bcurrent%3Dnext%3B%0A%20%7D%0A%20return%20result%3B%0A%7D%0A%2F%2A%2A%20Status%2C%20cell%20count%2C%20then%20each%20cell%27s%20count%20and%20source%20row%20indices.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20kinds%20%40param%20%7Bstring%5B%5D%7D%20lowers%20%40param%20%7Bstring%5B%5D%7D%20uppers%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20cuts%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20planRustIntegerRangeRows%28kinds%2Clowers%2Cuppers%2Ccuts%29%7B%0A%20if%28kinds.length%21%3D%3Dlowers.length%7C%7Ckinds.length%21%3D%3Duppers.length%7C%7Ccuts.length%3C2%29return%20%5B-1%5D%3B%0A%20for%28let%20cell%3D0%3Bcell%2B1%3Ccuts.length%3Bcell%2B%3D1%29if%28readRustIntegerRangeBoundsError%28readRequiredTextFact%28cuts%2Ccell%29%2CreadRequiredTextFact%28cuts%2Ccell%2B1%29%29%21%3D%3D%27%27%29return%20%5B-1%5D%3B%0A%20for%28let%20row%3D0%3Brow%3Ckinds.length%3Brow%2B%3D1%29%7B%0A%20%20const%20kind%3DreadRequiredTextFact%28kinds%2Crow%29%2Clower%3DreadRequiredTextFact%28lowers%2Crow%29%2Cupper%3DreadRequiredTextFact%28uppers%2Crow%29%3B%0A%20%20if%28kind%3D%3D%3D%27wild%27%7C%7Ckind%3D%3D%3D%27bind%27%29%7Bif%28lower%21%3D%3D%27%27%7C%7Cupper%21%3D%3D%27%27%29return%20%5B-1%5D%3B%7D%0A%20%20else%20if%28kind%3D%3D%3D%27lit%27%7C%7Ckind%3D%3D%3D%27interval%27%29%7Bif%28readRustIntegerRangeBoundsError%28lower%2Cupper%29%21%3D%3D%27%27%7C%7C%21cuts.includes%28lower%29%7C%7C%21cuts.includes%28upper%29%7C%7Ckind%3D%3D%3D%27lit%27%26%26readRustIntegerRangeSuccessor%28lower%29%21%3D%3Dupper%29return%20%5B-1%5D%3B%7D%0A%20%20else%20return%20%5B-1%5D%3B%0A%20%7D%0A%20const%20result%3D%5B0%2Ccuts.length-1%5D%3B%0A%20for%28let%20cell%3D0%3Bcell%2B1%3Ccuts.length%3Bcell%2B%3D1%29%7B%0A%20%20const%20lower%3DreadRequiredTextFact%28cuts%2Ccell%29%2Cupper%3DreadRequiredTextFact%28cuts%2Ccell%2B1%29%2Crows%3D%5B%5D%3B%0A%20%20for%28let%20row%3D0%3Brow%3Ckinds.length%3Brow%2B%3D1%29%7Bconst%20kind%3DreadRequiredTextFact%28kinds%2Crow%29%3Bif%28kind%3D%3D%3D%27wild%27%7C%7Ckind%3D%3D%3D%27bind%27%29rows.push%28row%29%3Belse%20if%28kind%3D%3D%3D%27lit%27%7C%7Ckind%3D%3D%3D%27interval%27%29%7Bif%28compareRustIntegerRangeDecimals%28readRequiredTextFact%28lowers%2Crow%29%2Clower%29%3C%3D0%26%26compareRustIntegerRangeDecimals%28readRequiredTextFact%28uppers%2Crow%29%2Cupper%29%3E%3D0%29rows.push%28row%29%3B%7Delse%20return%20%5B-1%5D%3B%7D%0A%20%20if%28rows.length%3D%3D%3D0%29return%20%5B-2%2Ccell%5D%3B%0A%20%20result.push%28rows.length%29%3Bfor%28const%20row%20of%20rows%29result.push%28row%29%3B%0A%20%7D%0A%20return%20result%3B%0A%7D%0A%0A%2F%2A%2A%20A%20rest%20token%20is%20complete%20only%20before%20its%20product%20delimiter.%0A%20%2A%20%40param%20%7Bstring%7D%20next%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testRustIntegerRangeRestFollower%28next%29%7Breturn%20next%3D%3D%3D%27%2C%27%7C%7Cnext%3D%3D%3D%27%29%27%3B%7D%0A) (lang: meta-language%20structured%20data)))
