(167: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadRustCheckedIntegerArity%7D%20from%20%27.%2Frust-checked-integer-rules.js%27%3B%0Aimport%20%7BacceptRustPrimitiveSelectionReceiver%7D%20from%20%27.%2Frust-primitive-selection-rules.js%27%3B%0A%2F%2A%2A%20Resolve%20only%20actual%20primitive%20paths%3B%20lexical%20resolution%20stays%20in%20the%20host.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20segments%20%40param%20%7Bboolean%7D%20ordinary%0A%20%2A%20%40param%20%7Bboolean%7D%20shadowed%20%40param%20%7Bboolean%7D%20absolute%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustPrimitiveAssociatedOwner%28segments%2Cordinary%2Cshadowed%2Cabsolute%29%7B%0A%20if%28%21ordinary%7C%7Cshadowed%29return%20%27%27%3B%0A%20let%20owner%3D%27%27%3B%0A%20if%28segments.length%3D%3D%3D2%26%26%21absolute%29owner%3Dsegments%5B0%5D%3F%3F%27%27%3B%0A%20else%20if%28segments.length%3D%3D%3D4%26%26%28segments%5B0%5D%3D%3D%3D%27std%27%7C%7Csegments%5B0%5D%3D%3D%3D%27core%27%29%26%26segments%5B1%5D%3D%3D%3D%27primitive%27%29owner%3Dsegments%5B2%5D%3F%3F%27%27%3B%0A%20return%20%5B%27bool%27%2C%27i8%27%2C%27u8%27%2C%27i16%27%2C%27u16%27%2C%27i32%27%2C%27u32%27%2C%27i64%27%2C%27u64%27%2C%27i128%27%2C%27u128%27%2C%27isize%27%2C%27usize%27%5D.includes%28owner%29%3Fowner%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20Full%20call%20arity%20includes%20the%20explicit%20receiver.%20The%20existing%20method%20rule%0A%20%2A%20remains%20responsible%20for%20its%20exact%20source%20interpretation.%0A%20%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20method%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustPrimitiveAssociatedArity%28owner%2Cmethod%29%7B%0A%20if%28%21%5B%27bool%27%2C%27i8%27%2C%27u8%27%2C%27i16%27%2C%27u16%27%2C%27i32%27%2C%27u32%27%2C%27i64%27%2C%27u64%27%2C%27i128%27%2C%27u128%27%2C%27isize%27%2C%27usize%27%5D.includes%28owner%29%29return%20-1%3B%0A%20if%28method%3D%3D%3D%27min%27%7C%7Cmethod%3D%3D%3D%27max%27%29return%202%3B%0A%20if%2