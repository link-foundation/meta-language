(113: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadRustOwnedRecordFieldIdentity%2CtestRustOwnedRecordFieldDescendant%7D%20from%20%27.%2Frust-owned-record-update-rules.js%27%3B%0Aimport%20%7BreadRustOwnedRecordPlaceTokenCount%7D%20from%20%27.%2Frust-owned-record-place-rules.js%27%3B%0A%2F%2A%2A%20%40param%20%7Bstring%5B%5D%7D%20forms%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustOwnedRecordStateAssignmentTokenCount%28forms%29%7Bconst%20count%3DreadRustOwnedRecordPlaceTokenCount%28forms.map%28form%3D%3Eform%3D%3D%3D%27%3D%27%3F%27%7D%27%3Aform%29%29%3Breturn%20count%3E%3D0%26%26forms%5Bcount%5D%3D%3D%3D%27%3D%27%26%26forms.slice%280%2Ccount%29.includes%28%27.%27%29%3Fcount%3A-1%3B%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bnumber%7D%20layers%20%40param%20%7Bstring%7D%20role%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedRecordStateStorageDisposition%28kind%2Clayers%2Crole%29%7Bif%28layers%21%3D%3D0%7C%7Crole%21%3D%3D%27copy%27%26%26role%21%3D%3D%27owned%27%7C%7Ckind%3D%3D%3D%27function%27%29return%20%27refuse%27%3Bif%28kind%3D%3D%3D%27named%27%7C%7Ckind%3D%3D%3D%27array%27%7C%7Ckind%3D%3D%3D%27tuple%27%29return%20%27children%27%3Breturn%20%5B%27string%27%2C%27unit%27%2C%27bool%27%2C%27fixed%27%2C%27int%27%2C%27nat%27%2C%27float%27%5D.includes%28kind%29%3F%27leaf%27%3A%27refuse%27%3B%7D%0A%2F%2A%2A%20Box%20can%20erase%20its%20payload%27s%20core%20type%2C%20so%20source%20owner%20is%20checked%20too.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bstring%7D%20path%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustOwnedRecordStateStorageOwner%28kind%2Cpath%29%7Breturn%20kind%21%3D%3D%27library%27%7C%7Cpath%21%3D%3D%27std%3A%3Aboxed%3A%3ABox%27%26%26path%21%3D%3D%27alloc%3A%3Aboxed%3A%3ABox%27%3B%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20nodes%20%40param%20%7Bnumber%7D%20depth%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedRecordStateStorageError%28nodes%2Cdepth%29%7Breturn%20Number.isInteger%28nodes%29%26%26nodes%3E%3D0%26%26nodes%3C%3D65536%26%26Number.isInteger%28depth%29%26%26depth%3E%3D0%26%26depth%3C%3D256%3F%27%27%3A%27the%20complete%20record%20state%20storage%20exceeds%20its%20finite%20source%20budget%27%3B%7D%0A%2F%2A%2A%20%40param%20%7Bboolean%7D%20ordinary%20%40param%20%7Bboolean%7D%20written%20%40param%20%7Bstring%7D%20profile%0A%20%2A%20%40param%20%7Bboolean%7D%20binding%20%40param%20%7Bboolean%7D%20lexical%20%40param%20%7Bnumber%7D%20layers%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedRecordMutableBindingError%28ordinary%2Cwritten%2Cprofile%2Cbinding%2Clexical%2Clayers%29%7Breturn%20ordinary%26%26written%26%26profile%3D%3D%3D%27owned%27%26%26binding%26%26lexical%26%26layers%3D%3D%3D0%3F%27%27%3A%27a%20mutable%20record%20needs%20its%20actual%20mutable%20declaration%20and%20complete%20destructor-free%20owned%20lexical%20root%27%3B%7D%0A%2F%2A%2A%20%40param%20%7Bboolean%7D%20mutable%20%40param%20%7Bboolean%7D%20callable%20%40param%20%7Bboolean%7D%20scope%0A%20%2A%20%40param%20%7Bstring%7D%20root%20%40param%20%7Bstring%7D%20field%20%40param%20%7Bboolean%7D%20type%0A%20%2A%20%40param%20%7Bboolean%7D%20loan%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedRecordStateWriteError%28mutable%2Ccallable%2Cscope%2Croot%2Cfield%2Ctype%2Cloan%29%7B%0A%20if%28%21mutable%29return%20%27record%20field%20assignment%20needs%20its%20actual%20mutable%20root%20binding%27%3B%0A%20if%28%21callable%29return%20%27a%20captured%20mutable%20record%20needs%20its%20separate%20callable%20environment%20state%20interpretation%27%3B%0A%20if%28%21scope%29return%20%27this%20expression%20needs%20an%20explicit%20record%20state%20result%20continuation%20before%20an%20outer%20place%20can%20be%20changed%27%3B%0A%20if%28root%21%3D%3D%27available%27%7C%7Cfield%21%3D%3D%27available%27%26%26field%21%3D%3D%27moved%27%26%26field%21%3D%3D%27possibly%20moved%27%29return%20%27field%20reinitialization%20needs%20its%20still%20initialized%20record%20root%20and%20exact%20available%20or%20moved%20field%27%3B%0A%20if%28%21type%29return%20%27field%20assignment%20must%20preserve%20its%20actual%20complete%20source%20type%20and%20owner%27%3B%0A%20return%20loan%3F%27field%20assignment%20overlaps%20an%20actual%20surviving%20whole%20or%20field%20loan%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20Scope-held%20field%20identities%20describe%20disjoint%20loans%20more%20precisely%20than%0A%20%2A%20the%20containing%20root%27s%20common%20lifetime.%20Unclassified%20contained%20loans%20remain%0A%20%2A%20conservative%20rather%20than%20disappear%20into%20a%20TYPE%20contract.%0A%20%2A%20%40param%20%7Bstring%7D%20root%20%40param%20%7Bstring%7D%20target%20%40param%20%7Bstring%5B%5D%7D%20loans%0A%20%2A%20%40param%20%7Bboolean%7D%20lexical%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testRustOwnedRecordStateLoanOverlap%28root%2Ctarget%2Cloans%2Clexical%29%7B%0A%20let%20precise%3Dfalse%3Bfor%28const%20loan%20of%20loans%29if%28testRustOwnedRecordFieldDescendant%28root%2Cloan%29%29%7Bprecise%3Dtrue%3Bif%28loan%3D%3D%3Dtarget%7C%7CtestRustOwnedRecordFieldDescendant%28target%2Cloan%29%7C%7CtestRustOwnedRecordFieldDescendant%28loan%2Ctarget%29%29return%20true%3B%7D%0A%20if%28precise%29return%20false%3B%0A%20return%20lexical%7C%7Cloans.includes%28root%29%3B%0A%7D%0A%2F%2A%2A%20Ordered%20packet%20positions%20are%20ordinary%20tuple%20terms%2C%20not%20source%20tuples%20and%0A%20%2A%20not%20opaque%20state.%20Position%20zero%20is%20the%20actual%20expression%20result.%0A%20%2A%20%40param%20%7Bnumber%7D%20roots%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20planRustOwnedRecordStatePacket%28roots%29%7Bif%28%21Number.isInteger%28roots%29%7C%7Croots%3C0%7C%7Croots%3E256%29return%20%5B%5D%3Bconst%20result%3D%5B0%5D%3Bfor%28let%20index%3D0%3Bindex%3Croots%3Bindex%2B%3D1%29result.push%28index%2B1%29%3Breturn%20result%3B%7D%0A%2F%2A%2A%20Assignment%20consumes%20RHS%20first%3B%20declaration-order%20reconstruction%20replaces%0A%20%2A%20only%20the%20actual%20selected%20child.%20Others%20retain%20their%20existing%20place%20state.%0A%20%2A%20%40param%20%7Bnumber%7D%20fields%20%40param%20%7Bnumber%7D%20selected%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20planRustOwnedRecordStateFields%28fields%2Cselected%29%7Bif%28%21Number.isInteger%28fields%29%7C%7Cfields%3C1%7C%7Cfields%3E1024%7C%7C%21Number.isInteger%28selected%29%7C%7Cselected%3C0%7C%7Cselected%3E%3Dfields%29return%20%5B%5D%3Bconst%20result%3D%5B%5D%3Bfor%28let%20index%3D0%3Bindex%3Cfields%3Bindex%2B%3D1%29result.push%28index%3D%3D%3Dselected%3F-1%3Aindex%29%3Breturn%20result%3B%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20root%20%40param%20%7Bnumber%5B%5D%7D%20fields%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedRecordStateFieldIdentity%28root%2Cfields%29%7Blet%20result%3Droot%3Bfor%28const%20index%20of%20fields%29%7Bresult%3DreadRustOwnedRecordFieldIdentity%28result%2Cindex%29%3Bif%28result%3D%3D%3D%27%27%29return%20%27%27%3B%7Dreturn%20result%3B%7D%0A) (lang: meta-language%20structured%20data)))
