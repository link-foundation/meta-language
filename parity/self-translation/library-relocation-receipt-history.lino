0%7D%0A%20assert.ok%28Array.isArray%28successors%29%29%3B%0A%20assert.equal%28successors.length%2C1%2C%27the%20reviewed%20finite%20chain%20has%20exactly%20one%20descriptor%20successor%27%29%3B%0A%20const%20edge%3Dsuccessors%5B0%5D%2C%7Bchanges%2C...metadata%7D%3Dedge%3B%0A%20assert.deepEqual%28metadata%2CdescriptorSuccessor%2C%27the%20whole%20descriptor%20edge%20and%20both%20source%20revisions%20are%20independently%20pinned%27%29%3B%0A%20const%20expected%3D%5B%5D%3B%0A%20for%28const%20%5Bindex%2Csource%5Dof%20descriptorSuccessor.sources.entries%28%29%29for%28const%20field%20of%20%5B%27bytes%27%2C%27sha256%27%5D%29%7B%0A%20%20expected.push%28%7Bpath%3A%5B%27decisionSources%27%2CString%28index%2B3%29%2Cfield%5D%2Cbefore%3Asource.previous%5Bfield%5D%2Cafter%3Asource.current%5Bfield%5D%7D%29%3B%0A%20%7D%0A%20assert.deepEqual%28changes%2Cexpected%2C%27only%20the%20two%20owned%20descriptor%20byte%20counts%20and%20hashes%20may%20change%27%29%3B%0A%20if%28identity%21%3D%3Dedge.identity%7C%7Cactual%21%3D%3Dedge.current.sha256%29%7B%0A%20%20assert.ok%28%5Bbase.previous.sha256%2Cbase.current.sha256%5D.includes%28actual%29%2C%27unknown%20artifacts%20cannot%20enter%20the%20descriptor%20chain%27%29%3B%0A%20%20return%20%7Bartifact%3AstructuredClone%28artifact%29%2Cbytes%7D%3B%0A%20%7D%0A%20assert.equal%28bytes.length%2Cedge.current.bytes%2C%27the%20entire%20descriptor%20successor%20byte%20count%20is%20exact%27%29%3B%0A%20const%20inverse%3DstructuredClone%28artifact%29%3B%0A%20for%28const%20%5Bindex%2Csource%5Dof%20edge.sources.entries%28%29%29%7B%0A%20%20const%20descriptor%3Dinverse.decisionSources%5Bindex%2B3%5D%3B%0A%20%20assert.deepEqual%28descriptor%2C%7Bfile%3Asource.file%2C...source.current%7D%2C%27each%20actual%20descriptor%20retains%20its%20exact%20file%20owner%20and%20fields%27%29%3B%0A%20%7D%0A%20for%28const%20change%20of%20changes%29%7B%0A%20%20const%20descriptor%3Dinverse.decisionSources%5BNumber%28change.path%5B1%5D%29%5D%2Cfield%3Dchange.path%5B2%5D%3B%0A%20%20assert.deepEqual%28descriptor%5Bfield%5D%2Cchange.after%29%3B%0A%20%20descriptor%5Bfield%5D%3Dchange.before%3B%0A%20%7D%0A%20const%20restored%3DBuffer.from%28structuredDataToLino%28inverse%29%29%3B%0A%20assert.equal%28restored.length%2Cedge.previous.bytes%2C%27the%20whole%20preceding%20current%20artifact%20byte%20count%20is%20recovered%27%29%3B%0A%20assert.equal%28digest%28restored%29%2Cedge.previous.sha256%2C%27only%20the%20reviewed%20descriptor%20fields%20changed%20in%20the%20complete%20artifact%27%29%3B%0A%20assert.equal%28edge.previous.sha256%2Cbase.current.sha256%2C%27the%20successor%20rejoins%20the%20unchanged%20original%20receipt%20current%20endpoint%27%29%3B%0A%20assert.equal%28edge.previous.bytes%2Cbase.current.bytes%29%3B%0A%20assert.equal%28edge.previous.file%2Cbase.current.file%29%3B%0A%20return%20%7Bartifact%3Ainverse%2Cbytes%3Arestored%7D%3B%0A%7D%0A%0A%2F%2F%20This%20second%20finite%20edge%20authenticates%20source%20descriptors%20only.%20It%20never%0A%2F%2F%20changes%20an%20emitted%20definition%2C%20archive%20premise%20or%20original%20receipt%20row.%0Aconst%20descriptorRefreshSuccessor%20%3D%20%7B%0A%20%20%22identity%22%3A%20%22raw%20consuming%22%2C%0A%20%20%22previous%22%3A%20%7B%0A%20%20%20%20%22file%22%3A%20%22experiments%2Foriginal-link-complete-table-projection%2Fdata%2Fraw-consuming-current-native-definitions.lino%22%2C%0A%20%20%20%20%22revision%22%3A%20%221a69d1b33be71ca7421eb8a7a2e4dba9b599ef26%22%2C%0A%20%20%20%20%22bytes%22%3A%201814953%2C%0A%20%20%20%20%22sha256%22%3A%20%220698669cdac848bfd661a1f87be629cdc81ddc3b4a2213bfb145d4c9de441644%22%0A%20%20%7D%2C%0A%20%20%22current%22%3A%20%7B%0A%20%20%20%20%22file%22%3A%20%22experiments%2Foriginal-link-complete-table-projection%2Fdata%2Fraw-consuming-current-native-definitions.lino%22%2C%0A%20%20%20%20%22sourceRevision%22%3A%20%22113a7747f799cbce5167167a783eb88427bd2825%22%2C%0A%20%20%20%20%22bytes%22%3A%201814953%2C%0A%20%20%20%20%22sha256%22%3A%20%2295032ee3af3c0de10c6486aa1d76e4b4d315e34379cb5d081a47a