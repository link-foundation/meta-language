ction.destination%2Cinstruction.target%2Cinstruction.key%2Cinstruction.attributes%5D%3B%0A%20%20%7D%0A%7D%0A%2F%2A%2A%20Preserve%20a%20real%20typed%20dependency%20on%20the%20shared%20semantic%20operand%20model.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptCallConstantError%28value%29%7Breturn%20readJavaScriptSemanticValueError%28value%29%3B%7D%0A%0A%2F%2A%2A%20Strict%20equality%20has%20the%20Number%20equality%20relation%20rather%20than%20SameValue%3A%0A%20%2A%20NaN%20is%20unequal%20to%20itself%2C%20and%20the%20signs%20of%20zero%20compare%20equal.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20left%20%40param%20%7BJavaScriptSemanticValue%7D%20right%0A%20%2A%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptCallStrictEqual%28left%2Cright%29%7B%0A%20if%28readJavaScriptSemanticValueError%28left%29%21%3D%3D%27%27%7C%7CreadJavaScriptSemanticValueError%28right%29%21%3D%3D%27%27%29throw%20new%20TypeError%28%27strict%20equality%20requires%20complete%20semantic%20operands%27%29%3B%0A%20if%28left.%24%3D%3D%3D%27number%27%29%7B%0A%20%20if%28right.%24%3D%3D%3D%27number%27%29return%20left.value%3D%3D%3Dright.value%3B%0A%20%20return%20false%3B%0A%20%7D%0A%20return%20testJavaScriptSemanticSameValue%28left%2Cright%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
