ccessor%27%2Cvalue%3A%7B%24%3A%27undefined%27%7D%2CwritablePresent%3Akind%20%21%3D%3D%20%27accessor%27%2Cwritable%3Afalse%2C%0A%20%20%20%20getterPresent%3Akind%20%3D%3D%3D%20%27accessor%27%2Cgetter%3A%7B%24%3A%27undefined%27%7D%2CsetterPresent%3Akind%20%3D%3D%3D%20%27accessor%27%2Csetter%3A%7B%24%3A%27undefined%27%7D%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Completion%20and%20field%20application%20are%20functional%2C%20so%20rejection%20never%20changes%0A%20%2A%20an%20existing%20descriptor%20or%20invokes%20a%20proposed%20accessor.%20A%20kind%20conversion%0A%20%2A%20resets%20only%20the%20inapplicable%20data%2Faccessor%20attributes.%0A%20%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20base%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20proposed%0A%20%2A%20%40returns%20%7BJavaScriptPropertyDescriptor%7D%20%2A%2F%0Aexport%20function%20applyJavaScriptPropertyDescriptorFields%28base%2C%20proposed%29%20%7B%0A%20%20return%20%7B%0A%20%20%20%20configurablePresent%3Atrue%2Cconfigurable%3Aproposed.configurablePresent%20%3F%20proposed.configurable%20%3A%20base.configurable%2C%0A%20%20%20%20enumerablePresent%3Atrue%2Cenumerable%3Aproposed.enumerablePresent%20%3F%20proposed.enumerable%20%3A%20base.enumerable%2C%0A%20%20%20%20valuePresent%3Abase.valuePresent%2Cvalue%3Abase.valuePresent%20%26%26%20proposed.valuePresent%20%3F%20proposed.value%20%3A%20base.value%2C%0A%20%20%20%20writablePresent%3Abase.writablePresent%2Cwritable%3Abase.writablePresent%20%26%26%20proposed.writablePresent%20%3F%20proposed.writable%20%3A%20base.writable%2C%0A%20%20%20%20getterPresent%3Abase.getterPresent%2Cgetter%3Abase.getterPresent%20%26%26%20proposed.getterPresent%20%3F%20proposed.getter%20%3A%20base.getter%2C%0A%20%20%20%20setterPresent%3Abase.setterPresent%2Csetter%3Abase.setterPresent%20%26%26%20proposed.setterPresent%20%3F%20proposed.setter%20%3A%20base.setter%2C%0A%20%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%0Aexport%20function%20readJavaScriptPropertyDescriptorWrites%28descriptor%29%20%7B%0A%20%20let%20writes%20%3D%20%5B%5D%3B%0A%20%20if%20%28descriptor.configurablePresent%29%20writes%20%3D%20writes.concat%28%5B%27configurable%27%5D%29%3B%0A%20%20if%20%28descriptor.enumerablePresent%29%20writes%20%3D%20writes.concat%28%5B%27enumerable%27%5D%29%3B%0A%20%20if%20%28descriptor.valuePresent%29%20writes%20%3D%20writes.concat%28%5B%27value%27%5D%29%3B%0A%20%20if%20%28descriptor.writablePresent%29%20writes%20%3D%20writes.concat%28%5B%27writable%27%5D%29%3B%0A%20%20if%20%28descriptor.getterPresent%29%20writes%20%3D%20writes.concat%28%5B%27get%27%5D%29%3B%0A%20%20if%20%28descriptor.setterPresent%29%20writes%20%3D%20writes.concat%28%5B%27set%27%5D%29%3B%0A%20%20return%20writes%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20disposition%20%40param%20%7Bstring%7D%20error%0A%20%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40param%20%7Bstring%5B%5D%7D%20writes%0A%20%2A%20%40returns%20%7B%7Bdisposition%3Astring%2Cerror%3Astring%2Cdescriptor%3AJavaScriptPropertyDescriptor%2Cwrites%3Astring%5B%5D%7D%7D%20%2A%2F%0Aexport%20function%20createJavaScriptPropertyTransition%28disposition%2C%20error%2C%20descriptor%2C%20writes%29%20%7B%0A%20%20return%20%7Bdisposition%2Cerror%2Cdescriptor%2Cwrites%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Ordinary%20ValidateAndApplyPropertyDescriptor%20as%20an%20inspectable%20transition.%0A%20%2A%20%60keep%60%20is%20a%20real%20no-write%20operation%3A%20an%20accepted%20SameValue%20comparison%20on%20a%0A%20%2A%20nonconfigurable%2Fnonwritable%20property%20must%20not%20rewrite%20its%20NaN%20payload.%0A%20%2A%20%60reject%60%20with%20empty%20error%20is%20incompatibility%2C%20distinct%20from%20invalid%20inputs.%0A%20%2A%20The%20heap%20adapter%20performs%20only%20the%20selected%20create%2Fconvert%2Fupdate%2Fkeep%0A%20%2A%20operation%20and%20listed%20attribute%20writes.%20Unlisted%20values%20retain%20their%20exact%0A%20%2A%20original%20storage%2C%20including%20NaN%20payloads%20absent%20from%20a%20generic%20proposal.%0A%20%2A%20This%20kernel%20neither%20executes%20descriptor%20getters%20nor%20claims%20a%20full%20heap%20model.%0A%20%2A%20%40param%20%7Bboolean%7D%20exists%20%40param%20%7Bboolean%7D%20extensible%0A%20%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20current%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20proposed%0A%20%2A%20%40returns%20%7B%7Bdisposition%3Astring%2Cerror%3Astring%2Cdescriptor%3AJavaScriptPropertyDescriptor%2Cwrites%3Astring%5B%5D%7D%7D%20%2A%2F%0Aexport%20function%20planJavaScriptPropertyDefinition%28exists%2C%20extensible%2C%20current%2C%20proposed%29%20%7B%0A%20%20const%20error%20%3D%20readJavaScriptPropertyDescriptorError%28proposed%29%3B%0A%20%20if%20%28error%20%21%3D%3D%20%27%27%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20error%2C%20current%2C%20%5B%5D%29%3B%0A%20%20if%20%28exists%20%26%26%20%21testCompleteJavaScriptPropertyDescriptor%28current%29%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27InvalidCurrentDescriptor%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20const%20kind%20%3D%20readJavaScriptPropertyDescriptorKind%28proposed%29%3B%0A%20%20if%20%28%21exists%29%20%7B%0A%20%20%20%20if%20%28%21extensible%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20const%20base%20%3D%20createJavaScriptPropertyDescriptor%28kind%2C%20false%2C%20false%29%3B%0A%20%20%20%20const%20descriptor%20%3D%20applyJavaScriptPropertyDescriptorFields%28base%2C%20proposed%29%3B%0A%20%20%20%20return%20createJavaScriptPropertyTransition%28%27create%27%2C%20%27%27%2C%20descriptor%2C%20readJavaScriptPropertyDescriptorWrites%28descriptor%29%29%3B%0A%20%20%7D%0A%20%20if%20%28%21proposed.configurablePresent%20%26%26%20%21proposed.enumerablePresent%20%26%26%20%21proposed.valuePresent%0A%20%20%20%20%26%26%20%21proposed.writablePresent%20%26%26%20%21proposed.getterPresent%20%26%26%20%21proposed.setterPresent%29%0A%20%20%20%20return%20createJavaScriptPropertyTransition%28%27keep%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20const%20original%20%3D%20readJavaScriptPropertyDescriptorKind%28current%29%3B%0A%20%20if%20%28%21current.configurable%29%20%7B%0A%20%20%20%20if%20%28proposed.configurablePresent%20%26%26%20proposed.configurable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28proposed.enumerablePresent%20%26%26%20proposed.enumerable%20%21%3D%3D%20current.enumerable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28kind%20%21%3D%3D%20%27generic%27%20%26%26%20kind%20%21%3D%3D%20original%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20if%20%28original%20%3D%3D%3D%20%27accessor%27%29%20%7B%0A%20%20%20%20%20%20if%20%28proposed.getterPresent%20%26%26%20%21testJavaScriptSemanticSameValue%28proposed.getter%2C%20current.getter%29%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%20%20if%20%28proposed.setterPresent%20%26%26%20%21testJavaScriptSemanticSameValue%28proposed.setter%2C%20current.setter%29%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%7D%20else%20if%20%28%21current.writable%29%20%7B%0A%20%20%20%20%20%20if%20%28proposed.writablePresent%20%26%26%20proposed.writable%29%20return%20createJavaScriptPropertyTransition%28%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%20%20if%20%28proposed.valuePresent%29%20return%20createJavaScriptPropertyTransition%28testJavaScriptSemanticSameValue%28proposed.value%2C%20current.value%29%20%3F%20%27keep%27%20%3A%20%27reject%27%2C%20%27%27%2C%20current%2C%20%5B%5D%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20base%20%3D%20kin