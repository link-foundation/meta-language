Present%3Aindex%3D%3D%3D5%3Fdescriptor.setterPresent%3Afalse%3B%0A%7D%0A%0A%2F%2A%2A%20Prefix%20states%20may%20temporarily%20contain%20both%20data%2Faccessor%20attributes.%20The%0A%20%2A%20specification%20rejects%20that%20combination%20only%20after%20all%20required%20Get%20steps.%0A%20%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptDescriptorConversionState%7D%20state%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptDescriptorConversionStateError%28heap%2Cstate%29%7B%0A%20%20const%20heapError%3DreadJavaScriptOrdinaryHeapError%28heap%29%3Bif%28heapError%21%3D%3D%27%27%29return%20heapError%3B%0A%20%20if%28state.receiver.%24%21%3D%3D%27object%27%29return%20%27descriptor%20conversion%20retains%20its%20actual%20Object%20receiver%27%3B%0A%20%20const%20receiverError%3DreadJavaScriptOrdinaryValueError%28heap%2Cstate.receiver%29%3Bif%28receiverError%21%3D%3D%27%27%29return%20receiverError%3B%0A%20%20if%28%21Number.isSafeInteger%28state.next%29%7C%7Cstate.next%3C0%7C%7Cstate.next%3E6%7C%7Cstate.next%3D%3D%3D0%26%261%2Fstate.next%3C0%7C%7Cstate.pending%26%26state.next%3D%3D%3D6%29return%20%27descriptor%20conversion%20needs%20its%20exact%20ordered%20field%20continuation%27%3B%0A%20%20for%28let%20index%3Dstate.next%3Bindex%3C6%3Bindex%2B%3D1%29if%28testJavaScriptDescriptorFieldPresence%28state.descriptor%2Cindex%29%29return%20%27unprocessed%20descriptor%20attributes%20cannot%20be%20fabricated%20in%20a%20continuation%27%3B%0A%20%20const%20descriptor%3Dstate.descriptor%3B%0A%20%20if%28descriptor.valuePresent%26%26readJavaScriptOrdinaryValueError%28heap%2Cdescriptor.value%29%21%3D%3D%27%27%29return%20%27descriptor%20values%20belong%20to%20the%20actual%20latest%20global%20context%27%3B%0A%20%20if%28descriptor.getterPresent%26%26%28readJavaScriptOrdinaryValueError%28heap%2Cdescriptor.getter%29%21%3D%3D%27%27%7C%7C%21testJavaScriptSemanticAccessor%28descriptor.getter%29%29%29return%20%27a%20processed%20descriptor%20getter%20retains%20actual%20intrinsic%20callability%27%3B%0A%20%20if%28descriptor.setterPresent%26%26%28readJavaScriptOrdinaryValueError%28heap%2Cdescriptor.setter%29%21%3D%3D%27%27%7C%7C%21testJavaScriptSemanticAccessor%28descriptor.setter%29%29%29return%20%27a%20processed%20descriptor%20setter%20retains%20actual%20intrinsic%20callability%27%3B%0A%20%20return%20%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20Apply%20exactly%20one%20already%20resolved%20Get%20result.%20Callable%20validation%20happens%0A%20%2A%20immediately%20for%20get%2Fset%3B%20mixed%20descriptor-kind%20validation%20happens%20at%20the%20end.%0A%20%2A%20Intrinsic%20errors%20are%20explicit%20evaluator%20obligations%2C%20preserving%20their%20realm%0A%20%2A%20and%20actual%20Error%20allocation%20rather%20than%20throwing%20a%20substitute%20host%20object.%0A%20%2A%20%40param%20%7BJavaScriptDescriptorConversionState%7D%20state%20%40param%20%7BJavaScriptSemanticValue%7D%20value%0A%20%2A%20%40returns%20%7BJavaScriptDescriptorConversionTransition%7D%20%2A%2F%0Aexport%20function%20applyJavaScriptDescriptorField%28state%2Cvalue%29%7B%0A%20%20if%28%28state.next%3D%3D%3D4%7C%7Cstate.next%3D%3D%3D5%29%26%26%21testJavaScriptSemanticAccessor%28value%29%29%0A%20%20%20%20return%20%7B%24%3A%27descriptorIntrinsicError%27%2CerrorClass%3A%27TypeError%27%2Creason%3A%27a%20descriptor%20accessor%20must%20be%20callable%20or%20undefined%27%7D%3B%0A%20%20const%20before%3Dstate.descriptor%3B%0A%20%20const%20descriptor%3Dstate.next%3D%3D%3D0%3F%7B...before%2CenumerablePresent%3Atrue%2Cenumerable%3AconvertJavaScriptSemanticBoolean%28value%29%7D%3A%0A%20%20%20%20state.next%3D%3D%3D1%3F%7B...before%2CconfigurablePresent%3Atrue%2Cconfigurable%3AconvertJavaScriptSemanticBoolean%28value%29%7D%3A%0A%20%20%20%20state.next%3D%3D%3D2%3F%7B...before%2CvaluePresent%3Atrue%2Cvalue%7D%3A%0A%20%20%20%20state.next%3D%3D%3D3%3F%7B...before%2CwritablePresent%3Atrue%2Cwritable%3AconvertJavaScriptSemanticBoolean%28value%29%7D%3A%0A%20%20%20%20state.next%3D%3D%3D4%3F%7B...before%