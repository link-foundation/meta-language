(17438: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadJavaScriptSemanticValueError%2CtestJavaScriptSemanticSameValue%2CtestJavaScriptSemanticAccessor%7D%20from%20%27.%2Fjavascript-semantic-values.js%27%3B%0A%0A%2F%2A%2A%20A%20normalized%20Property%20Descriptor%20keeps%20field%20presence%20independent%20of%20value.%0A%20%2A%20Its%20values%20belong%20to%20one%20checked%20semantic-value%2Fglobal-identity%20context.%0A%20%2A%20%40typedef%20%7B%7B%20configurablePresent%3Aboolean%2C%20configurable%3Aboolean%2C%0A%20%2A%20enumerablePresent%3Aboolean%2C%20enumerable%3Aboolean%2C%20valuePresent%3Aboolean%2C%0A%20%2A%20value%3AJavaScriptSemanticValue%2C%20writablePresent%3Aboolean%2C%20writable%3Aboolean%2C%0A%20%2A%20getterPresent%3Aboolean%2C%20getter%3AJavaScriptSemanticValue%2C%0A%20%2A%20setterPresent%3Aboolean%2C%20setter%3AJavaScriptSemanticValue%20%7D%7D%20JavaScriptPropertyDescriptor%0A%20%2A%2F%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptPropertyDescriptorKind%28descriptor%29%20%7B%0A%20%20const%20data%20%3D%20descriptor.valuePresent%20%7C%7C%20descriptor.writablePresent%3B%0A%20%20const%20accessor%20%3D%20descriptor.getterPresent%20%7C%7C%20descriptor.setterPresent%3B%0A%20%20return%20data%20%26%26%20accessor%20%3F%20%27invalid%27%20%3A%20data%20%3F%20%27data%27%20%3A%20accessor%20%3F%20%27accessor%27%20%3A%20%27generic%27%3B%0A%7D%0A%0A%2F%2A%2A%20Validate%20only%20fields%20actually%20present%3B%20absent%20payloads%20carry%20no%20meaning.%0A%20%2A%20Descriptor%20conversion%2C%20getters%20on%20the%20descriptor%20object%2C%20exotic%20receivers%2C%0A%20%2A%20proxy%20traps%20and%20heap%20ownership%20are%20separate%20explicit%20source%20operations.%0A%20%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptPropertyDescriptorError%28descriptor%29%20%7B%0A%20%20if%20%28readJavaScriptPropertyDescriptorKind%28descriptor%29%20%3D%3D%3D%20%27invalid%27%29%20return%20%27TypeError%27%3B%0A%20%20if%20%28descriptor.valuePresent%20%26%26%20readJavaScriptSemanticValueError%28descriptor.value%29%20%21%3D%3D%20%27%27%29%20return%20%27InvalidSemanticValue%27%3B%0A%20%20if%20%28descriptor.getterPresent%20%26%26%20%28readJavaScriptSemanticValueError%28descriptor.getter%29%20%21%3D%3D%20%27%27%20%7C%7C%20%21testJavaScriptSemanticAccessor%28descriptor.getter%29%29%29%20return%20%27TypeError%27%3B%0A%20%20if%20%28descriptor.setterPresent%20%26%26%20%28readJavaScriptSemanticValueError%28descriptor.setter%29%20%21%3D%3D%20%27%27%20%7C%7C%20%21testJavaScriptSemanticAccessor%28descriptor.setter%29%29%29%20return%20%27TypeError%27%3B%0A%20%20return%20%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testCompleteJavaScriptPropertyDescriptor%28descriptor%29%20%7B%0A%20%20if%20%28%21descriptor.configurablePresent%20%7C%7C%20%21descriptor.enumerablePresent%20%7C%7C%20readJavaScriptPropertyDescriptorError%28descriptor%29%20%21%3D%3D%20%27%27%29%20return%20false%3B%0A%20%20const%20kind%20%3D%20readJavaScriptPropertyDescriptorKind%28descriptor%29%3B%0A%20%20return%20kind%20%3D%3D%3D%20%27data%27%20%3F%20descriptor.valuePresent%20%26%26%20descriptor.writablePresent%0A%20%20%20%20%3A%20kind%20%3D%3D%3D%20%27accessor%27%20%26%26%20descriptor.getterPresent%20%26%26%20descriptor.setterPresent%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20configurable%20%40param%20%7Bboolean%7D%20enumerable%0A%20%2A%20%40returns%20%7BJavaScriptPropertyDescriptor%7D%20%2A%2F%0Aexport%20function%20createJavaScriptPropertyDescriptor%28kind%2C%20configurable%2C%20enumerable%29%20%7B%0A%20%20return%20%7BconfigurablePresent%3Atrue%2Cconfigurable%2CenumerablePresent%3Atrue%2Cenumerable%2C%0A%20%20%20%20valuePresent%3Akind%20%21%3D%3D%20%27accessor%27%2Cvalue%3A%7B%24%3A%27undefined%27%7D%2CwritablePresent%3Akind%20%21%3D%3D%20%27accessor%27%2Cwritable%3Afalse%2C%0A%20%20%20%20getterPresent%3Akind%20%3D%3D%3D%20%27accessor%27%2Cgetter%3A%7B%24%3A%27undefined%27%7D%2CsetterPresent%3Akind%20%3D%3D%3D%20%27accessor%27%2Csetter%3A%7B%24%3A%27undefined%27%7D%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Completion%20and%20field%20application%20are%20functional%2C%20so%20rejection%20never%20changes%0A%20%2A%20an%20existing%20descriptor%20or%20invokes%20a%20proposed%20accessor.%20A%20kind%20conversion%0A%20%2A%20resets%20only%20the%20inapplicable%20data%2Faccessor%20attributes.%0A%20%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20base%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20proposed%0A%20%2A%20%40returns%20%7BJavaScriptPropertyDescriptor%7D%20%2A%2F%0Aexport%20function%20applyJavaScriptPropertyDescriptorFields%28base%2C%20proposed%29%20%7B%0A%20%20return%20%7B%0A%20%20%20%20configurablePresent%3Atrue%2Cconfigurable%3Aproposed.configurablePresent%20%3F%20proposed.configurable%20%3A%20base.configurable%2C%0A%20%20%20%20enumerablePresent%3Atrue%2Cenumerable%3Aproposed.enumerablePresent%20%3F%20proposed.enumerable%20%3A%20base.enumerable%2C%0A%20%20%20%20valuePresent%3Abase.valuePresent%2Cvalue%3Abase.valuePresent%20%26%26%20proposed.valuePresent%20%3F%20proposed.value%20%3A%20base.value%2C%0A%20%20%20%20writablePresent%3Abase.writablePresent%2Cwritable%3Abase.writablePresent%20%26%26%20proposed.writablePresent%20%3F%20proposed.writable%20%3A%20base.writable%2C%0A%20%20%20%20getterPresent%3Abase.getterPresent%2Cgetter%3Abase.getterPresent%20%26%26%20proposed.getterPresent%20%3F%20proposed.getter%20%3A%20base.getter%2C%0A%20%20%20%20setterPresent%3Abase.setterPresent%2Csetter%3Abase.setterPresent%20%26%26%20proposed.setterPresent%20%3F%20proposed.setter%20%3A%20base.setter%2C%0A%20%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%