(27913: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20StringNumericLiteral%20conversion.%20Hosts%20supply%20actual%20UTF-16%20units.%0A%2F%2F%20Integer%20division%20chooses%20the%20final%20binary64%20mantissa%20with%20ties%20to%20even%3B%0A%2F%2F%20there%20is%20no%20host%20decimal%20parser%2C%20Number%28string%29%20or%20intermediate%20rounding.%0Aimport%20%7B%20acceptJavaScriptWhitespaceUnit%20%7D%20from%20%27.%2Fjavascript-whitespace-rules.js%27%3B%0Aimport%20%7BreadJavaScriptNumericDigitUnit%7D%20from%20%27.%2Fnumeric-digit-rules.js%27%3B%0Aimport%20%7BreadJavaScriptUtf8StringUnits%7D%20from%20%27.%2Futf8-string-unit-rules.js%27%3B%0A%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20unit%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readStringNumberDigit%28unit%29%20%7B%0A%20%20return%20readJavaScriptNumericDigitUnit%28unit%29%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20exponent%20%40returns%20%7Bbigint%7D%20%2A%2F%0Afunction%20readStringNumberDecimalPower%28exponent%29%20%7B%0A%20%20let%20value%3D1n%2Cbase%3D10n%3B%0A%20%20while%28exponent%3E0%29%7B%0A%20%20%20%20if%28exponent%252%3D%3D%3D1%29value%2A%3Dbase%3B%0A%20%20%20%20exponent%3DMath.floor%28exponent%2F2%29%3B%0A%20%20%20%20if%28exponent%3E0%29base%2A%3Dbase%3B%0A%20%20%7D%0A%20%20return%20value%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bbigint%7D%20value%20%40returns%20%7Bnumber%7D%20%2A%2F%0Afunction%20readStringNumberExactMantissa%28value%29%20%7B%0A%20%20let%20result%3D0%2Cscale%3D1%3B%0A%20%20while%28value%3E0n%29%7B%0A%20%20%20%20if%28value%252n%3D%3D%3D1n%29result%2B%3Dscale%3B%0A%20%20%20%20value%2F%3D2n%3Bscale%2A%3D2%3B%0A%20%20%7D%0A%20%20return%20result%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20exponent%20%40returns%20%7Bnumber%7D%20%2A%2F%0Afunction%20readStringNumberBinaryPower%28exponent%29%20%7B%0A%20%20let%20result%3D1%3B%0A%20%20while%28exponent%3E0%29%7Bresult%2A%3D2%3Bexponent-%3D1%3B%7D%0A%20%20while%28exponent%3C0%29%7Bresult%2F%3D2%3Bexponent%2B%