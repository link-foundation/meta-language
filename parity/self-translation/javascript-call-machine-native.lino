0must%20remain%20in%20the%20actual%20global%20heap%27%3B%0A%20const%20property%3Dobject.properties%5BfindJavaScriptHeapDirectoryProperty%28object.properties%2C%7B%24%3A%27text%27%2Cunits%3A%5B112%2C114%2C111%2C116%2C111%2C116%2C121%2C112%2C101%5D%7D%29%5D%3B%0A%20if%28property%3D%3D%3Dundefined%7C%7C%21property.descriptor.valuePresent%7C%7C%21testJavaScriptSemanticSameValue%28property.descriptor.value%2Cprototype%29%29return%20%27this%20profile%20needs%20the%20actual%20newTarget%20own%20data%20prototype%20rather%20than%20an%20invented%20descriptor%20or%20getter%27%3B%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20Validate%20freshness%2Fprototype%20consistency%20only.%20This%20never%20certifies%20Error%0A%20%2A%20internal%20slots%20or%20host%20stack%20authority%20from%20ordinary%20property%20spellings.%0A%20%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptSemanticValue%7D%20value%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20prototype%20%40param%20%7BJavaScriptErrorAllocationDirectory%7D%20before%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptErrorAllocationResultError%28heap%2Cvalue%2Cprototype%2Cbefore%29%7B%0A%20const%20prior%3DreadJavaScriptErrorPriorDirectoryError%28heap%2Cbefore%29%3Bif%28prior%21%3D%3D%27%27%29return%20prior%3B%0A%20const%20error%3DreadJavaScriptHeapDirectoryValueError%28heap%2Cvalue%29%3Bif%28error%21%3D%3D%27%27%29return%20error%3B%0A%20const%20invalidResult%3D%27an%20intrinsic%20Error%20result%20requires%20its%20actual%20fresh%20noncallable%20global%20Object%20identity%27%3B%0A%20if%28value.%24%21%3D%3D%27object%27%29return%20invalidResult%3B%0A%20if%28value.callable%7C%7Cbefore.objects.some%28row%3D%3Erow.identity%3D%3D%3Dvalue.identity%29%7C%7Cbefore.symbols.includes%28value.identity%29%29return%20invalidResult%3B%0A%20const%20object%3Dheap.objects%5BfindJavaScriptHeapDirectoryObject%28heap.objects%2Cvalue.identity%29%5D%3B%0A%20const%20invalidResultPrototype%3D%27the%20intrinsi