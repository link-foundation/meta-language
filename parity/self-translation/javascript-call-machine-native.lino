(8236: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %0A%0A%0A%0A%0A%2F%2A%2A%20%40typedef%20%7B%7B%24%3A%27descriptorConversion%27%2Creceiver%3AJavaScriptSemanticValue%2Cnext%3Anumber%2C%0A%20%2A%20descriptor%3AJavaScriptPropertyDescriptor%2Cpending%3Aboolean%7D%7D%20JavaScriptDescriptorConversionState%0A%20%2A%2F%0A%2F%2A%2A%20%40typedef%20%7B%7B%24%3A%27normalCompletion%27%2Cvalue%3AJavaScriptSemanticValue%7D%20%7C%0A%20%2A%20%7B%24%3A%27throwCompletion%27%2Cvalue%3AJavaScriptSemanticValue%7D%7D%20JavaScriptSemanticCompletion%0A%20%2A%2F%0A%2F%2A%2A%20%40typedef%20%7B%7B%24%3A%27descriptorContinuation%27%2Cstate%3AJavaScriptDescriptorConversionState%7D%20%7C%0A%20%2A%20%7B%24%3A%27descriptorCall%27%2Cstate%3AJavaScriptDescriptorConversionState%2Ccallee%3AJavaScriptSemanticValue%2C%0A%20%2A%20receiver%3AJavaScriptSemanticValue%2Carguments%3AJavaScriptSemanticValue%5B%5D%7D%20%7C%0A%20%2A%20%7B%24%3A%27descriptorCompleted%27%2Cdescriptor%3AJavaScriptPropertyDescriptor%7D%20%7C%0A%20%2A%20%7B%24%3A%27descriptorThrow%27%2Cvalue%3AJavaScriptSemanticValue%7D%20%7C%0A%20%2A%20%7B%24%3A%27descriptorIntrinsicError%27%2CerrorClass%3Astring%2Creason%3Astring%7D%20%7C%0A%20%2A%20%7B%24%3A%27descriptorInvalid%27%2Creason%3Astring%7D%7D%20JavaScriptDescriptorConversionTransition%0A%20%2A%2F%0A%0A%2F%2A%2A%20ToBoolean%20for%20represented%20ordinary%20values.%20Host%20HTMLDDA%20and%20other%20exotic%0A%20%2A%20object%20behavior%20is%20a%20distinct%20semantic%20domain%2C%20never%20inferred%20here.%0A%20%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20convertJavaScriptSemanticBoolean%28value%29%20%7B%0A%20%20if%28readJavaScriptSemanticValueError%28value%29%21%3D%3D%27%27%29throw%20new%20TypeError%28%27ToBoolean%20requires%20a%20complete%20semantic%20value%27%29%3B%0A%20%20switch%28value.%24%29%7B%0A%20%20%20%20case%20%27undefined%27%3Areturn%20false%3B%0A%20%20%20%20case%20%27null%27%3Areturn%20false%3B%0A%20%20%20%20case%20%27boolean%27%3Areturn%20value.value%3B%0A%20%20%20%20case%20%27number%27%3Areturn%20value.value%21%3D%3D0%26%26%21Number.isNaN%28value.value%29%3B%0A%20%20%20%20case%20%27integer%27%3Areturn%20value.value%21%3D%3D0n%3B%0A%20%20%20%20case%20%27text%27%3Areturn%20value.units.length%21%3D%3D0%3B%0A%20%20%20%20case%20%27sourceText%27%3Areturn%20value.text.length%21%3D%3D0%3B%0A%20%20%20%20case%20%27symbol%27%3Areturn%20true%3B%0A%20%20%20%20case%20%27object%27%3Areturn%20true%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20%40returns%20%7BJavaScriptPropertyDescriptor%7D%20%2A%2F%0Aexport%20function%20createJavaScriptEmptyDescriptor%28%29%7B%0A%20%20return%20%7BconfigurablePresent%3Afalse%2Cconfigurable%3Afalse%2CenumerablePresent%3Afalse%2Cenumerable%3Afalse%2C%0A%20%20%20%20valuePresent%3Afalse%2Cvalue%3A%7B%24%3A%27undefined%27%7D%2CwritablePresent%3Afalse%2Cwritable%3Afalse%2C%0A%20%20%20%20getterPresent%3Afalse%2Cgetter%3A%7B%24%3A%27undefined%27%7D%2CsetterPresent%3Afalse%2Csetter%3A%7B%24%3A%27undefined%27%7D%7D%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40param%20%7Bnumber%7D%20index%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testJavaScriptDescriptorFieldPresence%28descriptor%2Cindex%29%7B%0A%20%20return%20index%3D%3D%3D0%3Fdescriptor.enumerablePresent%3Aindex%3D%3D%3D1%3Fdescriptor.configurablePresent%3Aindex%3D%3D%3D2%3Fdescriptor.valuePresent%3A%0A%20%20%20%20index%3D%3D%3D3%3Fdescriptor.writablePresent%3Aindex%3D%3D%3D4%3Fdescriptor.getterPresent%3Aindex%3D%3D%3D5%3Fdescriptor.setterPresent%3Afalse%3B%0A%7D%0A%0A%2F%2A%2A%20Prefix%20states%20may%20temporarily%20contain%20both%20data%2Faccessor%20attributes.%20The%0A%20%2A%20specification%20rejects%20that%20combination%20only%20after%20all%20required%20Get%20steps.%0A%20%2A%20%40param%20%7BJavaScriptOrdinaryHeap%7D%20heap%20%40param%20%7BJavaScriptDescriptorConversionState%7D%20state%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function