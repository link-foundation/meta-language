e%2Croot%29%2C%27utf8%27%29%2Cinput.sourceText%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28input.sourceText%29%2C%7Bbytes%3Ainput.bytes%2Csha256%3Ainput.sha256%7D%29%3B%0A%20%20%20%20for%28const%20row%20of%20input.pieces%3F%3Finput.helpers%29assert.equal%28input.sourceText.slice%28row.start%2Crow.end%29%2Crow.sourceText%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28value.author.file%2Croot%29%29%29%2C%7Bbytes%3Avalue.author.bytes%2Csha256%3Avalue.author.sha256%7D%29%3B%0A%20%20assert.equal%28value.sourceInventory.declarations.length%2C9%29%3Bassert.equal%28value.sourceInventory.pins.length%2C13%29%3B%0A%20%20for%28const%20row%20of%20value.outputs%29assert.deepEqual%28pin%28readFileSync%28new%20URL%28row.file%2Croot%29%29%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20assert.deepEqual%28pin%28format%28value.rawModel%29%29%2C%7Bbytes%3Avalue.outputs%5B0%5D.bytes%2Csha256%3Avalue.outputs%5B0%5D.sha256%7D%29%3B%0A%20%20assert.deepEqual%28pin%28format%28value.relocation.source%29%29%2C%7Bbytes%3Avalue.outputs%5B1%5D.bytes%2Csha256%3Avalue.outputs%5B1%5D.sha256%7D%29%3B%0A%20%20const%20styles%3DDecoratorSet.fromLino%28readFileSync%28new%20URL%28%27parity%2Fself-translation%2Foriginal-native-number-observation-decorators.lino%27%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20assert.equal%28styles.decorate%28%27emitter%27%2C%7Bformat%3A%27Rust%27%2Ccomponent%3A%27visitors%27%2Csource%3Avalue.originalVisitors%7D%29.source%2Cvalue.relocation.source%29%3B%0A%20%20const%20counter%3Dstyles.decorate%28%27emitter%27%2C%7Bformat%3A%27Rust%27%2Ccomponent%3A%27counters%27%2Csource%3Avalue.inputs.sink.originalCounter%7D%29.source%3B%0A%20%20assert.ok%28value.rawModel.includes%28counter%29%29%3B%0A%20%20assert.equal%28value.inputs.sink.pieces.map%28row%3D%3Erow.sourceText%29.join%28%27%5Cn%5Cn%27%29%2Cvalue.inputs.sink.originalCounter%29%3B%0A%7D%0A%0Atest%28%27original%20native%20number%20source%20generation%20retains%20every%20complete%20declaration%20counter%20and%20numeric%20validator%27%2C%28%29%3D%3E%7B%0A%20%20const%20generated%3DgenerateOriginalNativeNumberObservations%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20assert.deepEqual%28generated.receipt%2Creceipt%29%3BcheckOriginalNumberSourceConservation%28receipt%29%3B%0A%20%20assert.deepEqual%28receipt.inputs.parent.helpers.map%28row%3D%3Erow.name%29%2C%5B%27fail%27%2C%27write_number%27%5D%29%3B%0A%20%20assert.ok%28receipt.inputs.parent.exactNumberHelper.includes%28%27if%20represented%20%21%3D%20i128%3A%3Afrom%28integer%29%27%29%29%3B%0A%20%20assert.ok%28receipt.inputs.parent.numberArm.includes%28%27StructuredDataValue%3A%3ANumber%28value%29%27%29%29%3B%0A%20%20assert.equal%28receipt.inputs.sink.pieces.length%2C5%29%3B%0A%20%20assert.equal%28receipt.sourceInventory.declarations.filter%28row%3D%3Erow.name%3D%3D%3D%27SyntaxTree%27%29%5B0%5D.variants.length%2C5%29%3B%0A%20%20assert.ok%28generated.outputs.every%28row%3D%3Erow.source.split%28%27%5Cn%27%29.length%3C1000%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27original%20JSON%20routing%20is%20distinct%20from%20host%20integer%20conversion%20and%20accessors%20precede%20unchanged%20validation%27%2C%28%29%3D%3E%7B%0A%20%20const%20original%3Dreceipt.originalVisitors%2Cderived%3Dreceipt.relocation.source%3B%0A%20%20assert.equal%28original.split%28%27serde_json%3A%3AValue%3A%3ANumber%28value%29%20%3D%3E%20sink.json_number%28value%2C%20depth%29%2C%27%29.length%2C2%29%3B%0A%20%20assert.equal%28derived.split%28%27serde_json%3A%3AValue%3A%3ANumber%28value%29%20%3D%3E%20sink.native_json_number%28value%2C%20depth%29%2C%27%29.length%2C2%29%3B%0A%20%20assert.equal%28receipt.jsonVisitor.after.replace%28%27sink.native_json_number%28value%2C%20depth%29%27%2C%27sink.json_number%28value%2C%20depth%29%27%29%2Creceipt.jsonVisitor.before%29%3B%0A%20%20assert.equal%28original.replace%28receipt.trait.before%2Creceipt.trait.after%29.replace%28receipt.jsonVisitor.before%2Creceipt.jsonVisitor.after%29.replace%28receipt.callback.before%2Creceipt