cked%20program%27%2C%27original%20checked%20program%27%2C%0A%20%20%20%20%27original%20checked%20program%27%2C%27edited%20checked%20program%27%2C%27edited%20checked%20program%27%5D%29%3B%0A%20%20for%28const%20row%20of%20manifest.cases%29%7B%0A%20%20%20%20const%20source%3Dread%28row.path%29%2Cnetwork%3DLinkNetwork.fromLino%28source%29%2Croot%3DLinkId.fromU64%28Number%28row.root%29%29%3B%0A%20%20%20%20assert.equal%28network.toLino%28%29%2Csource%29%3B%0A%20%20%20%20assert.equal%28network.fieldRelations%28%29.filter%28field%3D%3Efield.label%3D%3D%3D%27concrete%20syntax%27%29.length%2Crow.language%3D%3D%3D%27TypeScript%27%3F2%3A1%29%3B%0A%20%20%20%20const%20lines%3D%5B%5D%3B%0A%20%20%20%20vm.runInNewContext%28emitTypedProgramLinks%28network%2Croot%2C%27JavaScript%27%29.code%2C%0A%20%20%20%20%20%20%7Bconsole%3A%7Blog%3A%28...values%29%3D%3Elines.push%28values.map%28String%29.join%28%27%20%27%29%29%7D%2Cprocess%3A%7Bargv%3A%5B%5D%7D%7D%2C%20%7Btimeout%3A1000%7D%29%3B%0A%20%20%20%20assert.deepEqual%28lines%2Crow.expectedLines%29%3B%0A%20%20%20%20assert.match%28emitTypedProgramLinks%28network%2Croot%2C%27Rust%27%29.code%2C%2Ffn%20main%2Fu%29%3B%0A%20%20%7D%0A%20%20assert.match%28read%28%27rust%2Ftests%2Funit%2Fmod.rs%27%29%2C%2F%5Emod%20translation_concrete_program_graphs%3B%24%2Fmu%29%3B%0A%20%20const%20rust%3Dread%28%27rust%2Ftests%2Funit%2Ftranslation_concrete_program_graphs.rs%27%29%3B%0A%20%20assert.deepEqual%28%5B...rust.matchAll%28%2Fcheck_concrete_program_graph%5C%28%28%5B0-9%5D%2B%29%5C%29%3B%2Fgu%29%5D.map%28%28%5B%2Cvalue%5D%29%3D%3ENumber%28value%29%29%2C%5B0%2C1%2C2%2C3%2C4%5D%29%3B%0A%7D%29%3B%0A%0Atest%28%27generated%20native%20consumer%20bodies%20invert%20to%20their%20complete%20certified%20original%20templates%27%2C%28%29%3D%3E%7B%0A%20%20const%20template%3DgenerateConcreteProgramNativeTemplate%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20originalRust%3Dtemplate.sources.find%28row%3D%3Erow.file.endsWith%28%27.rs%27%29%29.sourceText%3B%0A%20%20const%20rust%3Dread%28%27rust%2Ftests%2Funit%2Ftranslation_concrete_program_graphs.rs%27%29%2Cmarker%3D%27%5Cn%23%5Btest%5D%5Cn%27%3B%0A%20%20const%20invert%3Dchanges%3D%3Echanges.toReversed%28%29.map%28row%3D%3E%28%7Bbefore%3Arow.after%2Cafter%3Arow.before%2Coccurrences%3Arow.occurrences%7D%29%29%3B%0A%20%20const%20helper%3DapplyNativeConsumerChanges%28rust.slice%280%2Crust.indexOf%28marker%29%29%2Cinvert%28template.rustChanges%29%29%3B%0A%20%20assert.equal%28helper%2BoriginalRust.slice%28originalRust.indexOf%28marker%29%29%2CoriginalRust%29%3B%0A%20%20const%20javascript%3Dread%28%27experiments%2Fconcrete-program-graphs%2Frun-rust-emissions.mjs%27%29%3B%0A%20%20assert.equal%28applyNativeConsumerChanges%28javascript%2Cinvert%28template.javascriptChanges%29%29%2Ctemplate.sources.find%28row%3D%3Erow.file.endsWith%28%27.mjs%27%29%29.sourceText%29%3B%0A%20%20assert.throws%28%28%29%3D%3EapplyNativeConsumerChanges%28%27unknown%20source%27%2Ctemplate.javascriptChanges%29%2Cassert.AssertionError%29%3B%0A%7D%29%3B%0A%0Atest%28%27native%20graph%20registration%20preserves%20every%20original%20source%20guard%20and%20exposes%20unknown%20source%20edits%27%2C%28%29%3D%3E%7B%0A%20%20generateNativeGraphSourceHistory%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20history%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fself-translation%2Fconcrete-program-native-source-sources-history.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20assert.equal%28history.sources.length%2C4%29%3B%0A%20%20for%28const%20row%20of%20history.sources%29%7B%0A%20%20%20%20const%20actual%3Dread%28row.file%29%3Bassert.equal%28Buffer.byteLength%28actual%29%2Crow.current.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28actual%29.digest%28%27hex%27%29%2Crow.current.sha256%29%3B%0A%20%20%20%20assert.equal%28restoreNativeGraphSourceHistory%28row.file%2Cactual%29%2Crow.sourceText%29%3B%0A%20%20%20%20assert.equal%28restoreNativeGraphSourceHistory%28row.file%2Crow.sourceText%29%2Crow.sourceText%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreNativeGraphSourceHistory%28row.file%2Cactual%2B%27%5Cn%23%20unknown%20edit%5Cn%27%29%2Cassert.AssertionError%29%3B%0A%20%20%7D%0A%20%20assert.equal%28restoreNativeGraphSourceHistory%28%27unknown%2Fsource.js%27%2C%27visible%20source%27%29%2C%27visible%20source%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20generated%20native%20transport%20refuses%20local%20execution%20before%20resolving%20a%20compiler%20or%20creating%20outputs%27%2C%28t%29%3D%3E%7B%0A%20%20const%20directory%3DmkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-concrete-native-guard-%27%29%29%3B%0A%20%20t.after%28%28%29%3D%3ErmSync%28directory%2C%7Brecursive%3Atrue%7D%29%29%3B%0A%20%20const%20output%3Dnew%20URL%28%27..%2F..%2Fissue-195-artifacts%2Ftypescript-typed-graph-native%2Fconcrete-program-graphs%27%2Cimport.meta.url%29%3B%0A%20%20const%20existed%3DexistsSync%28output%29%3B%0A%20%20const%20result%3DspawnSync%28process.execPath%2C%5Bnew%20URL%28%27..%2F..%2Fexperiments%2Fconcrete-program-graphs%2Frun-rust-emissions.mjs%27%2Cimport.meta.url%29.pathname%2C%0A%20%20%20%20%27--case%27%2C%270%27%2C%27--results-dir%27%2C%27issue-195-results%27%5D%2C%7Bcwd%3Adirectory%2Cenv%3A%7B...process.env%2CCI%3A%27false%27%2CGITHUB_ACTIONS%3A%27false%27%2CPATH%3A%27%27%7D%2Cencoding%3A%27utf8%27%7D%29%3B%0A%20%20assert.equal%28result.status%2C1%29%3Bassert.match%28result.stderr%2C%2FGitHub%20CI-only%2Fu%29%3B%0A%20%20assert.equal%28existsSync%28join%28directory%2C%27issue-195-results%27%29%29%2Cfalse%29%3Bassert.equal%28existsSync%28output%29%2Cexisted%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
