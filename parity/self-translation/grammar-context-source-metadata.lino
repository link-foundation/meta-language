inherit%28currentPlan%2Cplan%29%3Breturn%20plan%3B%27%29%29%3B%0A%20%20const%20second%3D%27%20%20checkedPlans.add%28plan%29%3Breturn%20plan%3B%5Cn%7D%5Cn%5Cnfunction%20parseObservations%27%3B%0A%20%20replace%28second%2Csecond.replace%28%27checkedPlans.add%28plan%29%3Breturn%20plan%3B%27%2C%27checkedPlans.add%28plan%29%3BsuccessorSourceArchives.inherit%28consumingPlan%2Cplan%29%3Breturn%20plan%3B%27%29%29%3B%0A%20%20let%20inverse%3Dsource%3Bfor%28const%20action%20of%20actions.toReversed%28%29%29%7Bassert.equal%28inverse.split%28action.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28action.after%2Caction.before%29%3B%7Dassert.equal%28inverse%2Coriginal%29%3B%0A%20%20const%20actual%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3Bassert.ok%28actual%3D%3D%3Doriginal%7C%7Cactual%3D%3D%3Dsource%2C%27unknown%20producer%20edits%20refuse%27%29%3B%0A%20%20const%20packet%3D%7BschemaVersion%3A1%2Crevision%2Csources%3A%5B%7Bfile%2Ccommit%3Arevision%2CsourceText%3Aoriginal%2C...pin%28blob%29%2Ccertificate%2Cactions%2Cproposed%3A%7B...pin%28source%29%2Csource%7D%7D%5D%2C%0A%20%20%20%20boundary%3A%27Every%20full%20current%2C%20consuming%20and%20borrowed-consumer%20source%20still%20parses%20without%20recovery%20and%20replays%20both%20original%20archive%20formats%20at%20unchanged%20limits.%20All%20three%20finish%20before%20the%20complete%20unchanged%20observation%20matrix%20is%20retained.%20Only%20compact%20private%20replay%20receipts%20survive%3B%20all%20original%20fixture%20identities%2C%20input%2Fresult%20bits%2C%20carrier%20objects%2C%20process%20checks%2C%20source%20interfaces%20and%20observation%20counts%20remain%20mandatory.%20Complete%20workload%20resource%20fit%20and%20native%20execution%20require%20CI.%27%7D%3B%0A%20%20if%28check%29checkProjectData%28output%2Cpacket%29%3Belse%20writeProjectData%28output%2Cpacket%29%3B%0A%20%20if%28apply%29writeFileSync%28new%20URL%28file%2Croot%29%2Csource%29%3B%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3