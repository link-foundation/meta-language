(25880: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Derive%20inverse%20instructions%20from%20complete%20authenticated%20source%20types%20and%20wire%20rules.%0A%2F%2F%20It%20does%20not%20reconstruct%20a%20value%20or%20supply%20native%20execution%20evidence.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BcaptureNativeOutcomeTypeInventory%7D%20from%20%27..%2Ftypes%2Finventory.mjs%27%3B%0Aimport%20%7BbuildOrderedWirePlan%7D%20from%20%27..%2Fwire%2Fgenerate.mjs%27%3B%0Aimport%20%7BserializeProjectData%2CwriteProjectData%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fproject-data.mjs%27%3B%0A%0Aconst%20repository%3DfileURLToPath%28new%20URL%28%27..%2F..%2F..%2F..%2F%27%2Cimport.meta.url%29%29%3B%0Aconst%20copy%3Dvalue%3D%3EstructuredClone%28value%29%3B%0Aconst%20digest%3Dvalue%3D%3EcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0Aconst%20authorities%3Dnew%20WeakMap%28%29%3B%0Aconst%20canonical%3Dvalue%3D%3EserializeProjectData%28value%2C%27ordinary-inverse-plan.lino%27%29%3B%0Aconst%20memberIdentity%3D%28owner%2Cmember%29%3D%3Eowner%2B%27%40%27%2Bmember.span.start%2B%27%3A%27%2Bmember.span.end%2B%27%23%27%2Bmember.sourceSha256%3B%0A%0A%2F%2A%2A%20Read%20the%20actual%20fixed%20source%20corpus%3B%20never%20authenticate%20a%20caller%27s%20inventory.%20%2A%2F%0Aexport%20function%20captureOrdinaryInversePlan%28root%3Drepository%29%20%7B%0A%20%20const%20capture%3DcaptureNativeOutcomeTypeInventory%28root%29%2Cgraph%3Dcapture.derive%28%29%3B%0A%20%20const%20wirePlan%3DbuildOrderedWirePlan%28capture.sourceInventory%29%3B%0A%20%20const%20byIdentity%3Dnew%20Map%28graph.nodes.map%28node%3D%3E%5Bnode.identity%2Cnode%5D%29%29%3B%0A%20%20const%20declarations%3Dgraph.roots.map%28identity%3D%3EbyIdentity.get%28identity%29%29%3B%0A%20%20assert.equal%28declarations.length%2C9%2C%27all%20original%20declarations%20remain%20present%27%29%3B%0A%20%20assert.equal%28graph.sourceInventory.pins.length%2C13%2C%27all%20original%20producer%2Fsource-owner%20pins%20remain%20present%27%29%3B%0A%20%20const%20exactDeclaration%3Dname%3D%3E%7B%0A%20%20%20%20%2F%2F%20The%20matching%20name%20is%20only%20a%20locator%20inside%20the%20already%20authenticated%0A%20%20%20%20%2F%2F%20corpus.%20Its%20qualified%20identity%20and%20complete%20declaration%20bytes%20are%20kept.%0A%20%20%20%20const%20matches%3Ddeclarations.filter%28node%3D%3Enode.name%3D%3D%3Dname%29%3B%0A%20%20%20%20assert.equal%28matches.length%2C1%2C%27wire%20name%20has%20exactly%20one%20authenticated%20declaration%20owner%27%29%3B%0A%20%20%20%20return%20matches%5B0%5D%3B%0A%20%20%7D%3B%0A%20%20const%20field%3D%28owner%2Csource%29%3D%3E%28%7B%0A%20%20%20%20identity%3AmemberIdentity%28owner%2Csource%29%2CnativeName%3Asource.name%3F%3Fnull%2C%0A%20%20%20%20typeReference%3Asource.typeReference%2Csource%3Acopy%28source%29%0A%20%20%7D%29%3B%0A%20%20const%20entries%3D%28owner%2CsourceFields%2Crows%29%3D%3E%7B%0A%20%20%20%20const%20fields%3DsourceFields.map%28source%3D%3Efield%28owner%2Csource%29%29%3B%0A%20%20%20%20const%20members%3Drows.filter%28row%3D%3E%21row.literal%29.map%28row%3D%3Erow.native%29%3B%0A%20%20%20%20assert.equal%28new%20Set%28members%29.size%2Cmembers.length%2C%27each%20source%20member%20has%20exactly%20one%20wire%20instruction%27%29%3B%0A%20%20%20%20assert.deepEqual%28%5B...members%5D.sort%28%29%2CsourceFields.map%28item%3D%3Eitem.name%29.sort%28%29%2C%27complete%20member%20conservation%27%29%3B%0A%20%20%20%20return%20%7Bfields%2Cwire%3Arows.map%28row%3D%3Erow.literal%3Fcopy%28row%29%3A%7B%0A%20%20%20%20%20%20...copy%28row%29%2CfieldReference%3Afields.find%28item%3D%3Eitem.nativeName%3D%3D%3Drow.native%29.identity%2C%0A%20%20%20%20%20%20typeReference%3Afields.find%28item%3D%3Eitem.nativeName%3D%3D%3Drow.native%29.typeReference%0A%20%20%20%20%7D%29%7D%3B%0A%20%20%7D%3B%0A%20%20const%20bindings%3DwirePlan.shapes.map%28shape%3D%3E%7B%0A%20%20%20%20const%20owner%3DexactDeclaration%28shape.native%29%3B%0A%20%20%20%20if%28shape.entries%29%20return%20%7B%0A%20%20%20%20%20%20declarationReference%3Aowner.identity%2C...entries%28owner.identity%2Cowner.fields%2Cshape.entries%29%0A%20%20%20%20%7D%3B%0A%20%20%20%20assert.equal%28shape.variants.length%2Cowner.variants.length%2C%27every%20actual%20variant%20is%20retained%27%29%3B%0A%20%20%20%20return%20%7BdeclarationReference%3Aowner.identity%2Cvariants%3Ashape.variants.map%28row%3D%3E%7B%0A%20%20%20%20%20%20const%20variants%3Downer.variants.filter%28item%3D%3Eitem.name%3D%3D%3Drow.name%29%3B%0A%20%20%20%20%20%20assert.equal%28variants.length%2C1%2C%27wire%20variant%20has%20one%20complete%20actual%20source%20owner%27%29%3B%0A%20%20%20%20%20%20const%20source%3Dvariants%5B0%5D%2Cidentity%3DmemberIdentity%28owner.identity%2Csource%29%3B%0A%20%20%20%20%20%20return%20%7Bidentity%2CnativeName%3Asource.name%2Csource%3Acopy%28source%29%2C%0A%20%20%20%20%20%20%20%20...%28row.entries%3Fentries%28identity%2Csource.fields%2Crow.entries%29%3A%7B%0A%20%20%20%20%20%20%20%20%20%20tuple%3Asource.tuple.map%28item%3D%3Efield%28identity%2Citem%29%29%2Cwire%3Acopy%28row%29%0A%20%20%20%20%20%20%20%20%7D%29%7D%3B%0A%20%20%20%20%7D%29%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20syntaxTree%3DexactDeclaration%28%27SyntaxTree%27%29%3B%0A%20%20const%20syntaxBinding%3Dbindings.find%28item%3D%3Eitem.declarationReference%3D%3D%3DsyntaxTree.identity%29%3B%0A%20%20const%20admittedNames%3D%5B%27Node%27%2C%27Token%27%2C%27Error%27%2C%27Missing%27%5D%3B%0A%20%20const%20ordinaryVariants%3DsyntaxBinding.variants.filter%28item%3D%3EadmittedNames.includes%28item.nativeName%29%29.map%28item%3D%3Eitem.identity%29%3B%0A%20%20assert.equal%28ordinaryVariants.length%2CadmittedNames.length%2C%27finite%20ordinary%20profile%20binds%20all%20four%20actual%20variants%27%29%3B%0A%20%20const%20refusedVariants%3DsyntaxBinding.variants.filter%28item%3D%3E%21ordinaryVariants.includes%28item.identity%29%29.map%28item%3D%3Eitem.identity%29%3B%0A%20%20assert.equal%28refusedVariants.length%2C1%2C%27current%20finite%20profile%20explicitly%20excludes%20one%20source-qualified%20variant%27%29%3B%0A%20%20assert.equal%28syntaxBinding.variants.find%28item%3D%3ErefusedVariants.includes%28item.identity%29%29.nativeName%2C%27Embed%27%29%3B%0A%20%20const%20plan%3D%7BschemaVersion%3A1%2Cprofile%3A%27ordinary%20owned%20raw%20outcome%201%27%2C%0A%20%20%20%20rootReference%3AexactDeclaration%28wirePlan.root%29.identity%2C%0A%20%20%20%20graph%2CwirePlan%2Cbindings%2C%0A%20%20%20%20admission%3A%7BordinaryVariants%2CrefusedVariants%2CopaqueJson%3A%27null%20only%27%2C%0A%20%20%20%20%20%20targetUsizeWidths%3A%5B32%2C64%5D%2CmaximumDepth%3A256%2CnumberFacts%3A%27exactly%20empty%27%2C%0A%20%20%20%20%20%20physicalOwnership%3A%27unproved%27%2CnativeDtoReconstruction%3A%27not%20supplied%27%2C%0A%20%20%20%20%20%20staticReferences%3A%27owned%20text%20plus%20the%20exact%20unresolved%20borrowed-static%20descriptor%27%7D%0A%20%20%7D%3B%0A%20%20const%20text%3Dcanonical%28plan%29%2Csha256%3Ddigest%28text%29%3B%0A%20%20const%20authority%3DObject.freeze%28%7Bsha256%2Cplan%3A%28%29%3D%3Ecopy%28plan%29%7D%29%3B%0A%20%20authorities.set%28authority%2C%7Btext%2Cplan%3Acopy%28plan%29%7D%29%3B%0A%20%20return%20authority%3B%0A%7D%0A%0A%2F%2A%2A%20A%20valid%20authority%20cannot%20be%20fabricated%20by%20a%20caller-supplied%20verifier.%20%2A%2F%0Aexport%20function%20authenticateOrdinaryInversePlan%28authority%2Ccandidate%29%20%7B%0A%20%20const%20trusted%3Dauthorities.get%28authority%29%3B%0A%20%20assert.ok%28trusted%2C%27plan%20authority%20must%20come%20from%20an%20actual%20source%20capture%27%29%3B%0A%20%20assert.equal%28canonical%28candidate%29%2Ctrusted.text%2C%27complete%20generated%20shared%20Links%20plan%20conservation%27%29%3B%0A%20%20return%20copy%28trusted.plan%29%3B%0A%7D%0A%0A%2F%2A%2A%20Read%20a%20captured%20plan%20without%20invoking%20a%20caller-supplied%20method.%20%2A%2F%0Aexport%20function%20readOrdinaryInversePlan%28authority%29%20%7B%0A%20%20const%20trusted%3Dauthorities.get%28authority%29%3B%0A%20%20assert.ok%28trusted%2C%27plan%20authority%20must%20come%20from%20an%20actual%20source%20capture%27%29%3B%0A%20%20return%20copy%28trusted.plan%29%3B%0A%7D%0A%0A%2F%2A%2A%20Expand%20projection%20coverage%20without%20claiming%20that%20erased%20native%20facts%20exist.%20%2A%2F%0Aexport%20function%20extendRecursiveInversePlan%28authority%29%20%7B%0A%20%20const%20plan%3DreadOrdinaryInversePlan%28authority%29%3B%0A%20%20assert.equal%28plan.profile%2C%27ordinary%20owned%20raw%20outcome%201%27%2C%27extension%20starts%20at%20the%20authenticated%20ordinary%20profile%27%29%3B%0A%20%20plan.profile%3D%27recursive%20owned%20raw%20outcome%20projection%201%27%3B%0A%20%20plan.admission.refusedVariants%3D%5B%5D%3B%0A%20%20plan.admission.opaqueJson%3D%27recursive%20owned%20projection%20with%20unresolved%20native%20number%20representation%27%3B%0A%20%20plan.admission.containerAliases%3D%27preserve%20JSON%20projection%20aliases%20as%20checked%20occurrence%20links%3B%20other%20owned%20containers%20remain%20distinct%27%3B%0A%20%20const%20text%3Dcanonical%28plan%29%2Csha256%3Ddigest%28text%29%3B%0A%20%20const%20extended%3DObject.freeze%28%7Bsha256%2Cplan%3A%28%29%3D%3Ecopy%28plan%29%7D%29%3B%0A%20%20authorities.set%28extended%2C%7Btext%2Cplan%3Acopy%28plan%29%7D%29%3B%0A%20%20return%20extended%3B%0A%7D%0A%0A%2F%2A%2A%20Explicit%20shared%20Links%20output%20only%3B%20importing%20this%20module%20never%20writes%20a%20file.%20%2A%2F%0Aexport%20function%20writeOrdinaryInversePlan%28authority%2Coutput%29%20%7B%0A%20%20assert.equal%28typeof%20output%2C%27string%27%29%3Bassert.ok%28output.endsWith%28%27.lino%27%29%2C%27inverse%20plans%20use%20Links%20Notation%27%29%3B%0A%20%20const%20plan%3DreadOrdinaryInversePlan%28authority%29%3B%0A%20%20writeProjectData%28output%2Cplan%29%3B%0A%20%20return%20%7Bsha256%3Aauthority.sha256%2Coutput%7D%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
