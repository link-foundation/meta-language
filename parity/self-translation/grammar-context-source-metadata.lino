es.map%28shape%3D%3E%7B%0A%20%20%20%20const%20owner%3DexactDeclaration%28shape.native%29%3B%0A%20%20%20%20if%28shape.entries%29%20return%20%7B%0A%20%20%20%20%20%20declarationReference%3Aowner.identity%2C...entries%28owner.identity%2Cowner.fields%2Cshape.entries%29%0A%20%20%20%20%7D%3B%0A%20%20%20%20assert.equal%28shape.variants.length%2Cowner.variants.length%2C%27every%20actual%20variant%20is%20retained%27%29%3B%0A%20%20%20%20return%20%7BdeclarationReference%3Aowner.identity%2Cvariants%3Ashape.variants.map%28row%3D%3E%7B%0A%20%20%20%20%20%20const%20variants%3Downer.variants.filter%28item%3D%3Eitem.name%3D%3D%3Drow.name%29%3B%0A%20%20%20%20%20%20assert.equal%28variants.length%2C1%2C%27wire%20variant%20has%20one%20complete%20actual%20source%20owner%27%29%3B%0A%20%20%20%20%20%20const%20source%3Dvariants%5B0%5D%2Cidentity%3DmemberIdentity%28owner.identity%2Csource%29%3B%0A%20%20%20%20%20%20return%20%7Bidentity%2CnativeName%3Asource.name%2Csource%3Acopy%28source%29%2C%0A%20%20%20%20%20%20%20%20...%28row.entries%3Fentries%28identity%2Csource.fields%2Crow.entries%29%3A%7B%0A%20%20%20%20%20%20%20%20%20%20tuple%3Asource.tuple.map%28item%3D%3Efield%28identity%2Citem%29%29%2Cwire%3Acopy%28row%29%0A%20%20%20%20%20%20%20%20%7D%29%7D%3B%0A%20%20%20%20%7D%29%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20syntaxTree%3DexactDeclaration%28%27SyntaxTree%27%29%3B%0A%20%20const%20syntaxBinding%3Dbindings.find%28item%3D%3Eitem.declarationReference%3D%3D%3DsyntaxTree.identity%29%3B%0A%20%20const%20admittedNames%3D%5B%27Node%27%2C%27Token%27%2C%27Error%27%2C%27Missing%27%5D%3B%0A%20%20const%20ordinaryVariants%3DsyntaxBinding.variants.filter%28item%3D%3EadmittedNames.includes%28item.nativeName%29%29.map%28item%3D%3Eitem.identity%29%3B%0A%20%20assert.equal%28ordinaryVariants.length%2CadmittedNames.length%2C%27finite%20ordinary%20profile%20binds%20all%20four%20actual%20variants%27%29%3B%0A%20%20const%20refusedVariants%3DsyntaxBinding.variants.filter%28item%3D%3E%21ordinaryVariants.includes%28item.identity%29%29.map%28item%3D%3Eitem.identity%29%3B%0A%20%20assert.equal%28refusedVariants.length%2C1%2C%27current%20finite%20profile%20explicitly%20excludes%20one%20source-qualified%20variant%27%29%3B%0A%20%20assert.equal%28syntaxBinding.variants.find%28item%3D%3ErefusedVariants.includes%28item.identity%29%29.nativeName%2C%27Embed%27%29%3B%0A%20%20const%20plan%3D%7BschemaVersion%3A1%2Cprofile%3A%27ordinary%20owned%20raw%20outcome%201%27%2C%0A%20%20%20%20rootReference%3AexactDeclaration%28wirePlan.root%29.identity%2C%0A%20%20%20%20graph%2CwirePlan%2Cbindings%2C%0A%20%20%20%20admission%3A%7BordinaryVariants%2CrefusedVariants%2CopaqueJson%3A%27null%20only%27%2C%0A%20%20%20%20%20%20targetUsizeWidths%3A%5B32%2C64%5D%2CmaximumDepth%3A256%2CnumberFacts%3A%27exactly%20empty%27%2C%0A%20%20%20%20%20%20physicalOwnership%3A%27unproved%27%2CnativeDtoReconstruction%3A%27not%20supplied%27%2C%0A%20%20%20%20%20%20staticReferences%3A%27owned%20text%20plus%20the%20exact%20unresolved%20borrowed-static%20descriptor%27%7D%0A%20%20%7D%3B%0A%20%20const%20text%3Dcanonical%28plan%29%2Csha256%3Ddigest%28text%29%3B%0A%20%20const%20authority%3DObject.freeze%28%7Bsha256%2Cplan%3A%28%29%3D%3Ecopy%28plan%29%7D%29%3B%0A%20%20authorities.set%28authority%2C%7Btext%2Cplan%3Acopy%28plan%29%7D%29%3B%0A%20%20return%20authority%3B%0A%7D%0A%0A%2F%2A%2A%20A%20valid%20authority%20cannot%20be%20fabricated%20by%20a%20caller-supplied%20verifier.%20%2A%2F%0Aexport%20function%20authenticateOrdinaryInversePlan%28authority%2Ccandidate%29%20%7B%0A%20%20const%20trusted%3Dauthorities.get%28authority%29%3B%0A%20%20assert.ok%28trusted%2C%27plan%20authority%20must%20come%20from%20an%20actual%20source%20capture%27%29%3B%0A%20%20assert.equal%28canonical%28candidate%29%2Ctrusted.text%2C%27complete%20generated%20shared%20Links%20plan%20conservation%27%29%3B%0A%20%20return%20copy%28trusted.plan%29%3B%0A%7D%0A%0A%2F%2A%2A%20Read%20a%20captured%20plan%20without%20invoking%20a%20caller-supplied%20method.%20%2A%2F%0Aexport%20functi