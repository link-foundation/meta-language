ted.edge%5D%2C%27only%20the%20exact%20reviewed%20source%20descriptor%20successor%20is%20admitted%27%29%3B%0A%20%20const%20registerBytes%3DBuffer.from%28structuredDataToLino%28previousRegister%29%29%3B%0A%20%20assert.equal%28registerBytes.length%2Cselected.previousRegister.bytes%29%3B%0A%20%20assert.equal%28hash%28registerBytes%29%2Cselected.previousRegister.sha256%2C%27every%20complete%20previous%20receipt%20and%20field%20remains%20unchanged%27%29%3B%0A%20%20const%20bytes%3DBuffer.from%28structuredDataToLino%28artifact%29%29%3B%0A%20%20if%28identity%21%3D%3Dselected.edge.identity%7C%7Chash%28bytes%29%21%3D%3Dselected.edge.current.sha256%29%7B%0A%20%20%20%20return%7Bartifact%2Cregister%3ApreviousRegister%7D%3B%0A%20%20%7D%0A%20%20assert.equal%28bytes.length%2Cselected.edge.current.bytes%29%3B%0A%20%20const%20inverse%3DstructuredClone%28artifact%29%3B%0A%20%20for%28const%20change%20of%20selected.edge.changes%29%7B%0A%20%20%20%20assert.ok%28change.path.length%3E1%26%26change.path.every%28key%3D%3Etypeof%20key%3D%3D%3D%27string%27%26%26%21%5B%27__proto__%27%2C%27prototype%27%2C%27constructor%27%5D.includes%28key%29%29%29%3B%0A%20%20%20%20let%20owner%3Dinverse%3B%0A%20%20%20%20for%28const%20key%20of%20change.path.slice%280%2C-1%29%29%7Bassert.ok%28Object.hasOwn%28owner%2Ckey%29%29%3Bowner%3Downer%5Bkey%5D%3B%7D%0A%20%20%20%20const%20key%3Dchange.path.at%28-1%29%3B%0A%20%20%20%20assert.deepEqual%28owner%5Bkey%5D%2Cchange.after%29%3B%0A%20%20%20%20if%28change.kind%3D%3D%3D%27source%20history%27%29%7B%0A%20%20%20%20%20%20assert.equal%28key%2C%27sourceHistory%27%29%3Bassert.equal%28change.before%2C%27absent%27%29%3Bassert.equal%28delete%20owner%5Bkey%5D%2Ctrue%29%3B%0A%20%20%20%20%7Delse%7B%0A%20%20%20%20%20%20assert.equal%28change.kind%2C%27source%20descriptor%27%29%3Bassert.ok%28%5B%27bytes%27%2C%27sha256%27%5D.includes%28key%29%29%3Bowner%5Bkey%5D%3Dchange.before%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20const%20restored%3DBuffer.from%28structuredDataToLino%28inverse%29%29%3B%0A%20%20assert.equal%28restored.length%2Cselected.edge.previous.bytes%29%3B%0A%20%20assert.equal%28hash%28restored%29%2Cselected.edge.previous.sha256%2C%27only%20recorded%20provenance%20changes%20may%20differ%20in%20the%20entire%20previous%20artifact%27%29%3B%0A%20%20return%7Bartifact%3Ainverse%2Cregister%3ApreviousRegister%7D%3B%0A%7D%0A%0Aexport%20function%20readHistoricalTranslationSourceDescriptorRegister%28%29%7B%0A%20%20return%20restoreCurrentTranslationSourceDescriptors%28null%2C%27historical%20register%27%2CreadProjectData%28registerFile%29%29.register%3B%0A%7D%0A%0Aexport%20function%20projectHistoricalTranslationSourceDescriptorArtifact%28artifact%29%7B%0A%20%20const%20selected%3DreadSourceDescriptorPolicy%28%29%2Cbytes%3DBuffer.from%28structuredDataToLino%28artifact%29%29%3B%0A%20%20assert.ok%28%5Bselected.edge.current.sha256%2Cselected.edge.previous.sha256%5D.includes%28hash%28bytes%29%29%2C%0A%20%20%20%20%27a%20historical%20descriptor%20view%20requires%20one%20complete%20registered%20artifact%27%29%3B%0A%20%20return%20restoreCurrentTranslationSourceDescriptors%28artifact%2Cselected.edge.identity%2CreadProjectData%28registerFile%29%29.artifact%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
