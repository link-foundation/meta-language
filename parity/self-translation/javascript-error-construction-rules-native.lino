ion%2C%20getters%20on%20the%20descriptor%20object%2C%20exotic%20receivers%2C%0A%20%2A%20proxy%20traps%20and%20heap%20ownership%20are%20separate%20explicit%20source%20operations.%0A%20%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptPropertyDescriptorError%28descriptor%29%20%7B%0A%20%20if%20%28readJavaScriptPropertyDescriptorKind%28descriptor%29%20%3D%3D%3D%20%27invalid%27%29%20return%20%27TypeError%27%3B%0A%20%20if%20%28descriptor.valuePresent%20%26%26%20readJavaScriptSemanticValueError%28descriptor.value%29%20%21%3D%3D%20%27%27%29%20return%20%27InvalidSemanticValue%27%3B%0A%20%20if%20%28descriptor.getterPresent%20%26%26%20%28readJavaScriptSemanticValueError%28descriptor.getter%29%20%21%3D%3D%20%27%27%20%7C%7C%20%21testJavaScriptSemanticAccessor%28descriptor.getter%29%29%29%20return%20%27TypeError%27%3B%0A%20%20if%20%28descriptor.setterPresent%20%26%26%20%28readJavaScriptSemanticValueError%28descriptor.setter%29%20%21%3D%3D%20%27%27%20%7C%7C%20%21testJavaScriptSemanticAccessor%28descriptor.setter%29%29%29%20return%20%27TypeError%27%3B%0A%20%20return%20%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testCompleteJavaScriptPropertyDescriptor%28descriptor%29%20%7B%0A%20%20if%20%28%21descriptor.configurablePresent%20%7C%7C%20%21descriptor.enumerablePresent%20%7C%7C%20readJavaScriptPropertyDescriptorError%28descriptor%29%20%21%3D%3D%20%27%27%29%20return%20false%3B%0A%20%20const%20kind%20%3D%20readJavaScriptPropertyDescriptorKind%28descriptor%29%3B%0A%20%20return%20kind%20%3D%3D%3D%20%27data%27%20%3F%20descriptor.valuePresent%20%26%26%20descriptor.writablePresent%0A%20%20%20%20%3A%20kind%20%3D%3D%3D%20%27accessor%27%20%26%26%20descriptor.getterPresent%20%26%26%20descriptor.setterPresent%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20configurable