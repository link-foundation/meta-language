8two%29%3Bright%2B%3D1%3B%7D%0A%20%20else%20if%28right%3E%3Dsecond.length%29%7Bresult.push%28one%29%3Bleft%2B%3D1%3B%7D%0A%20%20else%20if%28one%3Ctwo%29%7Bresult.push%28one%29%3Bleft%2B%3D1%3B%7D%0A%20%20else%20if%28one%3Etwo%29%7Bresult.push%28two%29%3Bright%2B%3D1%3B%7D%0A%20%20else%7Bresult.push%28one%29%3Bleft%2B%3D1%3Bright%2B%3D1%3B%7D%0A%20%7D%0A%20return%20result%3B%0A%7D%0A%0A%2F%2A%2A%20Success%20%5B0%2C...triples%5D%3A%200%20literal%5Bstart%2Cend%5D%2C1%20actual%20positional%5Bindex%2C0%5D%2C%0A%20%2A%202%20actual%20captured%20source%20identifier%5Bstart%2Cend%5D.%20Named%20admission%2Fnormalization%0A%20%2A%20uses%20the%20same%20actual%20source%20identifier%20grammar%20as%20ordinary%20bindings.%0A%20%2A%20Errors%20%5Bcode%2Cstart%2Cend%5D%3A%20-1%20unmatched%20close%2C-2%20unclosed%20open%2C-3%20format%20spec%2C%0A%20%2A%20-5%20missing%20implicit%2C-6%20missing%20explicit%2C-7%20unused%20operand%2C-8%20malformed%20facts.%0A%20%2A%20Explicit%20positions%20never%20advance%20the%20independent%20implicit%20cursor.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bnumber%7D%20count%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20planRustFormattingFieldTerms%28units%2Ccount%29%7B%0A%20if%28%21Number.isSafeInteger%28count%29%7C%7Ccount%3C0%29return%20%5B-8%2C0%2C0%5D%3B%0A%20for%28let%20index%3D0%3Bindex%3Cunits.length%3Bindex%2B%3D1%29%7Bconst%20unit%3Dunits%5Bindex%5D%3F%3F%20-1%3Bif%28%21Number.isSafeInteger%28unit%29%7C%7Cunit%3C0%7C%7Cunit%3E65535%29return%20%5B-8%2Cindex%2Cindex%2B1%5D%3B%7D%0A%20const%20plan%3D%5B0%5D%3B%0A%20let%20at%3D0%2CtextStart%3D0%2Cnext%3D0%3B%0A%20while%28at%3Cunits.length%29%7B%0A%20%20const%20unit%3Dunits%5Bat%5D%3F%3F0%2Cfollowing%3Dunits%5Bat%2B1%5D%3F%3F%20-1%3B%0A%20%20if%28%28unit%3D%3D%3D123%26%26following%3D%3D%3D123%29%7C%7C%28unit%3D%3D%3D125%26%26following%3D%3D%3D125%29%29%7B%0A%20%20%20if%28textStart%3Cat%29%7Bplan.push%280%29%3Bplan.push%28textStart%29%3Bplan.push%28at%29%3B%7D%0A%2