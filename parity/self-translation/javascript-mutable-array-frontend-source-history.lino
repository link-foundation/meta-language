(2056: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Frontend%20decisions%20expressed%20in%20JavaScript%20and%20translated%20into%20Rust%20by%0A%2F%2F%20js%2Fscripts%2Fgenerate-frontend-rules.mjs.%20Inputs%20use%20code%20units%20and%20token%0A%2F%2F%20records%20so%20both%20host%20runtimes%20can%20use%20the%20same%20decisions.%0A%0A%2F%2A%2A%20%40typedef%20%7B%7B%20%24%3A%20%27scalar%27%2C%20code%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27malformed%27%20%7D%20%7C%20%7B%20%24%3A%20%27unsupported%27%2C%20end%3A%20number%2C%20escapeLength%3A%20number%20%7D%7D%20UnicodeEscape%20%2A%2F%0A%0A%2F%2A%2A%0A%20%2A%20Read%20one%20Unicode%20or%20hexadecimal%20escape%20from%20at%20most%20twelve%20UTF-16%20code%20units%2C%20starting%0A%20%2A%20with%20its%20backslash.%20Offsets%20in%20the%20result%20are%20relative%20to%20that%20backslash.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%0A%20%2A%20%40param%20%7Bboolean%7D%20allowFixed%0A%20%2A%20%40returns%20%7BUnicodeEscape%7D%0A%20%2A%2F%0Aexport%20function%20decodeUnicodeEscape%28units%2C%20allowFixed%29%20%7B%0A%20%20if%20%28units.length%20%3C%202%20%7C%7C%20units%5B0%5D%20%21%3D%3D%2092%20%7C%7C%20%28units%5B1%5D%20%21%3D%3D%20117%20%26%26%20units%5B1%5D%20%21%3D%3D%20120%29%29%20return%20%7B%20%24%3A%20%27malformed%27%20%7D%3B%0A%20%20let%20fixed%20%3D%204%3B%0A%20%20if%20%28units%5B1%5D%20%3D%3D%3D%20120%29%20%7B%0A%20%20%20%20if%20%28%21allowFixed%29%20return%20%7B%20%24%3A%20%27malformed%27%20%7D%3B%0A%20%20%20%20fixed%20%3D%202%3B%0A%20%20%7D%0A%20%20let%20index%20%3D%202%3B%0A%20%20let%20code%20%3D%200%3B%0A%20%20let%20digits%20%3D%200%3B%0A%20%20let%20braced%20%3D%20false%3B%0A%20%20if%20%28fixed%20%3D%3D%3D%204%20%26%26%20units.length%20%3E%202%20%26%26%20units%5B2%5D%20%3D%3D%3D%20123%29%20%7B%0A%20%20%20%20braced%20%3D%20true%3B%0A%20%20%20%20index%20%3D%203%3B%0A%20%20%7D%20else%20if%20%28%21allowFixed%29%20return%20%7B%20%24%3A%20%27malformed%27%20%7D%3B%0A%20%20while%20%28index%20%3C%20units.length%20%26%26%20digits%20%3C%20%28braced%20%3F%206%20%3A%20fixed%29%29%20%7B%0A%20%20%20%20const%20unit%20%3D%20units%5Bindex%5D%3B%0A%20%20%20%20let%20digit%20%3D%20-1%3B%0A%20%20%20%20if%20%28unit%20%3E%3D%2048%20%26%26%20unit%20%3C%3D%2057%29%20digit%20%3D%20unit%20-%2048%3B%0A%20%20%20%20else%20if%20%28unit%20%3E%3D%2065%20%26%26%20unit%20%3C%3D%2070%29%20digit%20%3D%20unit%20-%2055%3B%0A%20%20%20%20else%20if%20%28unit%20%3E%3D%2097%20%26%26%20unit%20%3C%3D%20102%29%20digit%20%3D%20unit%20-%2087%3B%0A%20%20%20%20if%20%28digit%20%3C%200%29%20break%3B%0A%20%20%20%20code%20%3D%20code%20%2A%2016%20%2B%20digit%3B%0A%20%20%20%20digits%20%2B%3D%201%3B%0A%20%20%20%20index%20%2B%3D%201%3B%0A%20%20%7D%0A%20%20if%20%28braced%29%20%7B%0A%20%20%20%20if%20%28digits%20%3D%3D%3D%200%20%7C%7C%20index%20%3E%3D%20units.length%20%7C%7C%20units%5Bindex%5D%20%21%3D%3D%20125%29%20return%20%7B%20%24%3A%20%27malformed%27%20%7D%3B%0A%20%20%20%20index%20%2B%3D%201%3B%0A%20%20%7D%20else%20if%20%28digits%20%21%3D%3D%20fixed%29%20return%20%7B%20%24%3A%20%27malformed%27%20%7D%3B%0A%20%20const%20escapeLength%20%3D%20index%3B%0A%20%20if%20%28%21braced%20%26%26%20code%20%3E%3D%2055296%20%26%26%20code%20%3C%3D%2056319%20%26%26%20units.length%20%3E%3D%20index%20%2B%206%20%26%26%20units%5Bindex%5D%20%3D%3D%3D%2092%20%26%26%20units%5Bindex%20%2B%201%5D%20%3D%3D%3D%20117%29%20%7B%0A%20%20%20%20let%20low%20%3D%200%3B%0A%20%20%20%20let%20offset%20%3D%202%3B%0A%20%20%20%20while%20%28offset%20%3C%206%29%20%7B%0A%20%20%20%20%20%20const%20unit%20%3D%20units%5Bindex%20%2B%20offset%5D%3B%0A%20%20%20%20%20%20let%20digit%20%3D%20-1%3B%0A%20%20%20%20%20%20if%20%28unit%20%3E%3D%2048%20%26%26%20unit%20%3C%3D%2057%29%20digit%20%3D%20unit%20-%2048%3B%0A%20%20%20%20%20%20else%20if%20%28unit%20%3E%3D%2065%20%26%26%20unit%20%3C%3D%2070%29%20digit%20%3D%20unit%20-%2055%3B%0A%20%20%20%20%20%20else%20if%20%28unit%20%3E%3D%2097%20%26%26%20unit%20%3C%3D%20102%29%20digit%20%3D%20unit%20-%2087%3B%0A%20%20%20%20%20%20if%20%28digit%20%3C%200%29%20break%3B%0A%20%20%20%20%20%20low%20%3D%20low%20%2A%2016%20%2B%20digit%3B%0A%20%20%20%20%20%20offset%20%2B%3D%201%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28offset%20%3D%3D%3D%206%20%26%26%20low%20%3E%3D%2056320%20%26%26%20low%20%3C%3D%2057343%29%20%7B%0A%20%20%20%20%20%20code%20%3D%2065536%20%2B%20%28code%20-%2055296%29%20%2A%201024%20%2B%20low%20-%2056320%3B%0A%20%20%20%20%20%20index%20%2B%3D%206%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20if%20%28code%20%3E%201114111%20%7C%7C%20%28code%20%3E%3D%2055296%20%26%26%20code%20%3C%3D%2057343%29%29%20return%20%7B%20%24%3A%20%27unsupported%27%2C%20end%3A%20index%2C%20escapeLength%20%7D%3B%0A%20%20return%20%7B%20%24%3A%20%27scalar%27%2C%20code%2C%20end%3A%20index%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Whether%20every%20omitted%20argument%20has%20a%20trailing%20default.%0A%20%2A%20%40param%20%7Bboolean%5B%5D%7D%20defaults%0A%20%2A%20%40param%20%7Bnumber%7D%20count%0A%20%2A%20%40returns%20%7Bboolean%7D%0A%20%2A%2F%0Aexport%20function%20acceptArgumentCount%28defaults%2C%20count%29%20%7B%0A%20%20if%20%28count%20%3E%20defaults.length%29%20return%20false%3B%0A%20%20let%20index%20%3D%20count%3B%0A%20%20while%20%28index%20%3C%20defaults.length%29%20%7B%0A%20%20%20%20if%20%28%21defaults%5Bindex%5D%29%20return%20false%3B%0A%20%20%20%20index%20%2B%3D%201%3B%0A%20%20%7D%0A%20%20return%20true%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Find%20a%20reference%20to%20an%20earlier%20parameter%20in%20a%20default%20expression.%20Member%0A%20%2A%20names%20after%20a%20dot%20are%20not%20references%2C%20and%20nested%20delimiters%20keep%20commas%0A%20%2A%20and%20closing%20parentheses%20inside%20the%20expression.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20kinds%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20values%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20parameters%0A%20%2A%20%40returns%20%7Bnumber%7D%0A%20%2A%2F%0Aexport%20function%20findDefaultParameterReference%28kinds%2C%20values%2C%20parameters%29%20%7B%0A%20%20le