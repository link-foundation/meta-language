s%20without%20parser%20state%27%2C%28%29%3D%3E%7B%0A%20%20generateConcreteProgramOriginFixtures%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20%7Bfixture%7D%3DgenerateConcreteProgramGraphFixtures%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20for%28const%20row%20of%20fixture.cases%29%7B%0A%20%20%20%20const%20packet%3DcreateConcreteProgramLinks%28row.source%2Crow.language%2C%7Butf16Strings%3Atrue%7D%29%3B%0A%20%20%20%20for%28const%20network%20of%20%5BLinkNetwork.fromLino%28packet.network.toLino%28%29%29%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28packet.network%29%29%5D%29%7B%0A%20%20%20%20%20%20const%20before%3Dnetwork.toLino%28%29%2Corigin%3DreadConcreteProgramOriginText%28network%2Cpacket.root%29%3B%0A%20%20%20%20%20%20assert.equal%28origin.language%2Crow.language%29%3Bassert.equal%28origin.plane%2C%27source%27%29%3Bassert.equal%28origin.text%2Crow.source%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28Buffer.from%28origin.bytes%29%2CBuffer.from%28row.source%29%29%3Bassert.equal%28network.toLino%28%29%2Cbefore%29%3B%0A%20%20%20%20%20%20if%28row.language%3D%3D%3D%27TypeScript%27%29%7B%0A%20%20%20%20%20%20%20%20const%20lowered%3DreadConcreteProgramOriginText%28network%2Cpacket.root%2C%7Bplane%3A%27lowered%27%7D%29%3B%0A%20%20%20%20%20%20%20%20assert.equal%28lowered.language%2C%27JavaScript%27%29%3Bassert.ok%28lowered.text.includes%28%27%40param%27%29%29%3B%0A%20%20%20%20%20%20%20%20assert.equal%28lowered.text.includes%28%27value%3A%20string%27%29%2Cfalse%29%3B%0A%20%20%20%20%20%20%7Delse%20assert.throws%28%28%29%3D%3EreadConcreteProgramOrigin%28network%2Cpacket.root%2C%7Bplane%3A%27lowered%27%7D%29%2C%2Fmissing%20lowering%2Fu%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27origin%20reads%20keep%20the%20stored%20source%20after%20semantic%20edits%20and%20nested%20selected%20Rust%20models%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DoriginalPacket%28%29%2Cnetwork%3DLinkNetwork.fromLino%28packet.network.toLino%28%29%29%3B%0A%20%20const%20operation%3Dnetwork.fieldRelations%28%29.find%28row%3D%3Erow.label%3D%3D%3Dschema.fields.op%0A%20%20%20%20%26%26network.link%28row.child%29.metadata%28%29.definition%3D%3D%3D%27add%27%29%3Bassert.ok%28operation%29%3B%0A%20%20const%20link%3Dnetwork.link%28operation.child%29%3Blink.setMetadata%28link.metadata%28%29.withDefinition%28%27mul%27%29%29%3B%0A%20%20assert.equal%28readConcreteProgramOriginText%28network%2Cpacket.root%29.text%2Cpacket.source%29%3B%0A%20%20const%20%7Bfixture%7D%3DgenerateConcreteProgramGraphFixtures%28%7Bcheck%3Atrue%7D%29%2Crow%3Dfixture.cases.find%28row%3D%3Erow.language%3D%3D%3D%27Rust%27%29%3B%0A%20%20const%20%7BarrayResultModel%7D%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Frust-array-results.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20const%20rust%3DcreateConcreteProgramLinks%28row.source%2C%27Rust%27%2C%7BrustArrayResultModel%3AarrayResultModel%7D%29%3B%0A%20%20assert.equal%28readConcreteProgramOriginText%28LinkNetwork.fromLino%28rust.network.toLino%28%29%29%2Crust.root%29.text%2Crow.source%29%3B%0A%7D%29%3B%0A%0Atest%28%27origin%20decoding%20refuses%20inconsistent%20spans%20duplicate%20fields%20cycles%20unknown%20profiles%20and%20invalid%20resources%27%2C%28%29%3D%3E%7B%0A%20%20for%28const%20edit%20of%20%5B%27span%27%2C%27number%27%2C%27duplicate%27%2C%27cycle%27%2C%27profile%27%5D%29%7B%0A%20%20%20%20const%20packet%3DoriginalPacket%28%29%2Cnetwork%3DLinkNetwork.fromLino%28packet.network.toLino%28%29%29%2Ctoken%3DfirstToken%28network%29%3Bassert.ok%28token%29%3B%0A%20%20%20%20if%28edit%3D%3D%3D%27span%27%29%7Bconst%20link%3Dnetwork.link%28field%28network%2Ctoken%2C%27start%27%29%29%3Blink.setMetadata%28link.metadata%28%29.withDefinition%28%271%27%29%29%3B%7D%0A%20%20%20%20if%28edit%3D%3D%3D%27number%27%29%7Bconst%20link%3Dnetwork.link%28field%28network%2Ctoken%2C%27start%27%29%29%3Blink.setMetadata%28link.metadata%28%29.withDefinition%28%27%27%29%29%3B%7D%0A%20%20%20%20if%28edit%3D%3D%3D%27duplicate%27%29network.insertFieldRelation%28token%2