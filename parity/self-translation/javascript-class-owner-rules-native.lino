%20%3D%20readRecordFieldWriteOperator%28operation%29%3B%0A%20%20return%20operator%20%3D%3D%3D%20%27%27%20%3F%20%27%27%20%3A%20operation.slice%2817%20%2B%20operator.length%29%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operator%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRecordFieldWriteArgumentCount%28operator%29%20%7B%0A%20%20return%20operator%20%3D%3D%3D%20%27%2B%2B%27%20%7C%7C%20operator%20%3D%3D%3D%20%27--%27%20%3F%200%20%3A%201%3B%0A%7D%0A%2F%2A%2A%20Conservative%20text%20reservation%20also%20protects%20nested%20generated%20operands.%0A%20%2A%20%40param%20%7Bnumber%7D%20initial%20%40param%20%7Bstring%7D%20receiver%20%40param%20%7Bstring%5B%5D%7D%20arguments_%0A%20%2A%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRecordFieldWriteSuffix%28initial%2C%20receiver%2C%20arguments_%29%20%7B%0A%20%20const%20text%20%3D%20receiver%20%2B%20%27%20%27%20%2B%20arguments_.join%28%27%20%27%29%3B%0A%20%20let%20suffix%20%3D%20initial%3B%0A%20%20while%20%28text.includes%28%27ml_field_owner%27%20%2B%20suffix%29%20%7C%7C%20text.includes%28%27ml_field_value%27%20%2B%20suffix%29%0A%20%20%20%20%7C%7C%20text.includes%28%27ml_field_previous%27%20%2B%20suffix%29%29%20suffix%20%2B%3D%201%3B%0A%20%20return%20suffix%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20expression%20%40param%20%7Bstring%7D%20operation%20%40param%20%7Bstring%7D%20kind%0A%20%2A%20%40param%20%7Bboolean%7D%20reference%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptLinkedRecordFieldWrite%28expression%2C%20operation%2C%20kind%2C%20reference%29%20%7B%0A%20%20return%20expression%20%3D%3D%3D%20%27method%27%20%26%26%20kind%20%3D%3D%3D%20%27record%27%20%26%26%20reference%20%26%26%20readRecordFieldWriteOperator%28operation%29%20%21%3D%3D%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20operator%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20reference%0A%20%2A%20%40param%20%7Bboolean%7D%20open%20%40param%20%7Bboolean%7D%20field%20%40param%20%7Bstring%7D%20valueKind%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRecordFieldWriteRefusal%28operator%2C%20kind%2C%20reference%2C%20open%2C%20field%2C%20valueKind%29%20%7B%0A%20%20if%20%28%21acceptRecordFieldAssignmentOperator%28operator%29%29%20return%20%27this%20assignment%20operator%20needs%20its%20complete%20state%20operation%27%3B%0A%20%20if%20%28kind%20%21%3D%3D%20%27record%27%20%7C%7C%20%21reference%20%7C%7C%20open%29%20return%20%27a%20field%20write%20needs%20a%20closed%20shared%20record%20with%20explicit%20own%20fields%27%3B%0A%20%20if%20%28%21field%29%20return%20%27creating%20a%20field%20needs%20a%20dynamic%20property%20and%20descriptor%20representation%27%3B%0A%20%20if%20%28operator%20%21%3D%3D%20%27%3D%27%20%26%26%20valueKind%20%21%3D%3D%20%27float%27%29%20return%20%27this%20compound%20field%20assignment%20needs%20its%20actual%20coercion%20and%20value%20domain%27%3B%0A%20%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20Additional%20JavaScript%20domains%20normalize%20through%20the%20ordinary%20checked%20binary%20operation.%0A%20%2A%20The%20original%20refusal%20remains%20the%20contract%20of%20the%20direct%20Number%20write%20renderer.%0A%20%2A%20%40param%20%7Bstring%7D%20language%20%40param%20%7Bstring%7D%20operator%20%40param%20%7Bstring%7D%20kind%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRecordCompoundBinaryOperation%28language%2C%20operator%2C%20kind%29%20%7B%0A%20%20if%20%28language%20%21%3D%3D%20%27JavaScript%27%20%7C%7C%20%28kind%20%21%3D%3D%20%27int%27%20%26%26%20kind%20%21%3D%3D%20%27string%27%29%29%20return%20%27%27%3B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27string%27%29%20return%20operator%20%3D%3D%3D%20%27%2B%3D%27%20%3F%20%27plus%27%20%3A%20%27%27%3B%0A%20%20if%20%28operator%20%3D%3D%3D%20%27%2B%3D%27%20%7C%7C%20operator%20%3D%3D%3D%20%27%2B%2B%27%29%20return%20%27plus%27%3B%0A%20%20if%20%28operator%20%3D%3D%3D%20%27-%3D%27%20%7C%7C%20operator%20%3D%3D%3D%20%27--%27%29%20return%20%27sub%27%3B%0A%20%20if%20%28operator