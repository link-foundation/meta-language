0%20if%20%28program%20%26%26%20typeof%20program%20%3D%3D%3D%20%27object%27%20%26%26%20Object.hasOwn%28program%2C%20%27sourcePureUnitCalls%27%29%29%20checkRustPureUnitCalls%28program%29%3B%0A%20%20checkRustOwnedLocalStateRecordShapes%28program%29%3B%0A%20%20validateSourceSpans%28program%29%3B%0A%20%20if%20%28%21program%20%7C%7C%20program.schemaVersion%20%21%3D%3D%201%20%7C%7C%20%21%5B%27JavaScript%27%2C%20%27Rust%27%2C%20%27Lean%27%2C%20%27Rocq%27%5D.includes%28program.sourceLanguage%29%0A%20%20%20%20%7C%7C%20%21%28program.declarations%20instanceof%20Map%29%20%7C%7C%20%21Array.isArray%28program.items%29%29%20throw%20new%20TypeError%28%27the%20linked%20value%20is%20not%20a%20checked%20typed%20program%27%29%3B%0A%20%20if%20%28program.main%20%21%3D%20null%20%26%26%20%28typeof%20program.main%20%21%3D%3D%20%27object%27%20%7C%7C%20Array.isArray%28program.main%29%0A%20%20%20%20%7C%7C%20program.main.k%20%21%3D%3D%20undefined%20%7C%7C%20program.main.p%20%21%3D%3D%20undefined%20%7C%7C%20%21Array.isArray%28program.main.effects%29%29%29%20throw%20new%20TypeError%28%27a%20linked%20main%20has%20an%20invalid%20effect-container%20role%27%29%3B%0A%20%20if%20%28%21acceptProgramStringRepresentationFlag%28typeof%20program.utf16Strings%2C%20Object.hasOwn%28program%2C%20%27utf16Strings%27%29%29%29%20throw%20new%20TypeError%28%27a%20program%20string%20representation%20flag%20must%20be%20an%20explicit%20boolean%27%29%3B%0A%20%20const%20active%20%3D%20new%20Set%28%29%3B%0A%20%20const%20visited%20%3D%20new%20Set%28%29%3B%0A%20%20function%20targetOf%28node%2C%20role%29%20%7B%0A%20%20%20%20for%20%28const%20%5Blabel%2C%20target%5D%20of%20references.get%28node%29%20%3F%3F%20%5B%5D%29%20if%20%28readProgramReferenceRole%28label%29%20%3D%3D%3D%20role%29%20return%20target%3B%0A%20%20%20%20return%20undefined%3B%0A%20%20%7D%0A%20%20function%20bounded%28value%2C%20depth%20%3D%200%29%20%7B%0A%20%20%20%20if%20%28%21value%20%7C%7C%20typeof%20value%20%21%3D%3D%20%27object%27%29%20%7B%0A%20%20%20%20%20%20if%