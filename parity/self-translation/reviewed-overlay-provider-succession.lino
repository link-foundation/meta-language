(10282: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BcheckRustRuntimeShell%2CrecordRustRuntimeShellAssumptions%2CrefuseRustRuntimeShellComposition%7D%20from%20%27.%2Frust-runtime-shell.js%27%3B%0Aimport%20%7B%20renderStringMapExpression%2C%20renderStringTestExpression%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0Aimport%20%7BrequireStringOrderUnits%2CrenderStringOrderExpression%7D%20from%20%27.%2Fstring-order-rules.js%27%3B%0A%2F%2F%20JavaScript%20emitter.%20Every%20portable%20integer%20is%20a%20BigInt%2C%20so%20naturals%20and%0A%2F%2F%20integers%20stay%20unbounded%20and%20machine%20integers%20are%20range-checked%20exactly%20as%0A%2F%2F%20Rust%20checks%20them%3B%20a%20Number%20stays%20a%20Number.%20Data%20values%20are%20plain%20objects%20whose%20%60%24%60%20property%20names%0A%2F%2F%20the%20constructor.%20Modules%20become%20object%20literals%20referenced%20by%20qualified%0A%2F%2F%20names.%20Theorems%20cannot%20be%20proved%20in%20JavaScript%3A%20each%20becomes%20an%20executable%0A%2F%2F%20property%2C%20checked%20over%20a%20bounded%20domain%20by%20%60--ml-check-theorems%60%2C%20while%20the%0A%2F%2F%20proof%20obligation%20stays%20discharged%20by%20the%20source%20language%27s%20kernel.%0A%0Aimport%20%7B%20castMessage%2C%20overflowMessage%2C%20zeroDivisorMessage%20%7D%20from%20%27.%2Faborts.js%27%3B%0Aimport%20%7B%20renderCollectionConstruction%20%7D%20from%20%27.%2Fcollection-construction-rules.js%27%3B%0Aimport%20%7B%20renderSurfaceReferenceOperation%20%7D%20from%20%27.%2Fsurface-reference-analysis-rules.js%27%3B%0Aimport%20%7B%20renderCollectionIteration%2C%20renderOptionalArrayRead%2C%20renderStringPointIteration%20%7D%20from%20%27.%2Farray-value-rules.js%27%3B%0Aimport%20%7B%20renderArrayFromMapping%20%7D%20from%20%27.%2Farray-from-rules.js%27%3B%0Aimport%20%7B%20renderPrimitiveMethodArgument%2C%20renderPrimitiveMethodExpression%20%7D%20from%20%27.%2Fprimitive-method-rules.js%27%3B%0Aimport%20%7B%20renderRecordField%2C%20renderRecordValue%2