ordinals%5Bindex%5D%20%3F%3F%20-1%3B%0A%20%20%20%20if%20%28%21Number.isSafeInteger%28ordinal%29%20%7C%7C%20ordinal%20%3C%201%20%7C%7C%20ordinal%20%3C%20previous%29%0A%20%20%20%20%20%20throw%20new%20Error%28%27source%20identifier%20ordinals%20need%20a%20sorted%20positive%20integer%20column%27%29%3B%0A%20%20%20%20previous%20%3D%20ordinal%3B%0A%20%20%20%20if%20%28ordinal%20%3D%3D%3D%20next%29%20next%20%2B%3D%201%3B%0A%20%20%7D%0A%20%20return%20%27ml_source%27%20%2B%20next%20%2B%20%27_%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20name%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20renderSourceTargetIdentifier%28name%29%20%7B%0A%20%20return%20acceptSourcePrivateIdentifier%28name%29%20%3F%20%27source_%27%20%2B%20name%20%3A%20name%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20prefix%20%40param%20%7Bstring%7D%20role%20%40param%20%7Bnumber%7D%20ordinal%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20renderSourceGeneratedIdentifier%28prefix%2C%20role%2C%20ordinal%29%20%7B%0A%20%20if%20%28%21Number.isSafeInteger%28ordinal%29%20%7C%7C%20ordinal%20%3C%200%29%20throw%20new%20Error%28%27source%20identifier%20generation%20ordinal%20exceeds%20its%20exact%20range%27%29%3B%0A%20%20return%20prefix%20%2B%20%28role.startsWith%28%27ml_%27%29%20%3F%20role.slice%283%29%20%3A%20role%29%20%2B%20ordinal%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20prefix%20%40param%20%7Bstring%7D%20name%20%40param%20%7Bboolean%7D%20reference%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20renderSourceCellParameter%28prefix%2C%20name%2C%20reference%29%20%7B%0A%20%20return%20reference%20%3F%20prefix%20%2B%20%27cell_%27%20%2B%20name%20%3A%20name%3B%0A%7D%0A%0A%2F%2A%2A%20Ordinary%20BoundName%20admission%20after%20the%20actual%20token%27s%20lexical%20role%20check.%0A%20%2A%20Closed%20historical%20profiles%20remain%20separate%20operations.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bstring%7D%20name%20%40param%20%7Bboolean%7D%20duplicate%0A%20%2A%20%40pa