er%28kind%2Cbits%2Csigned%2Cowner%2Cpath%2Cchildren%2Cproven%2Clayers%29%7Breturn%20%28kind%3D%3D%3D%27fixed%27%7C%7Ckind%3D%3D%3D%27bool%27%29%26%26owner%3D%3D%3D%27primitive%27%26%26children%3D%3D%3D0%26%26proven%26%26layers%3D%3D%3D0%26%26acceptRustSourceSignaturePrimitive%28kind%2Cpath%2Cbits%2Csigned%29%3B%7D%0A%2F%2A%2A%20Untyped%20integer%20syntax%20gets%20the%20actual%20primitive%20receiver%27s%20context.%20All%0A%20%2A%20other%20expressions%20require%20their%20complete%20independent%20matching%20source%20owner.%0A%20%2A%20%40param%20%7Bstring%7D%20expected%20%40param%20%7Bstring%7D%20bits%20%40param%20%7Bboolean%7D%20signed%0A%20%2A%20%40param%20%7Bstring%7D%20owner%20%40param%20%7Bstring%7D%20actual%20%40param%20%7Bstring%7D%20actualBits%0A%20%2A%20%40param%20%7Bboolean%7D%20actualSigned%20%40param%20%7Bstring%7D%20actualOwner%0A%20%2A%20%40param%20%7Bnumber%7D%20layers%20%40param%20%7Bboolean%7D%20proven%20%40param%20%7Bboolean%7D%20known%0A%20%2A%20%40param%20%7Bboolean%7D%20literal%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustPrimitiveSelectionArgument%28expected%2Cbits%2Csigned%2Cowner%2Cactual%2CactualBits%2CactualSigned%2CactualOwner%2Clayers%2Cproven%2Cknown%2Cliteral%29%7B%0A%20if%28layers%21%3D%3D0%29return%20false%3B%0A%20if%28literal%26%26expected%3D%3D%3D%27fixed%27%26%26actual%3D%3D%3D%27%27%26%26actualOwner%3D%3D%3D%27%27%29return%20true%3B%0A%20return%20known%26%26proven%26%26expected%3D%3D%3Dactual%26%26bits%3D%3D%3DactualBits%26%26signed%3D%3D%3DactualSigned%26%26owner%3D%3D%3DactualOwner%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
