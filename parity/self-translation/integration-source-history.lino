xport%20function%20array%28element%2C%20reference%20%3D%20false%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27array%27%2C%20element%2C%20...%28reference%20%26%26%20%7B%20reference%3A%20true%20%7D%29%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20A%20mutable%20binding%20keeps%20its%20identity%20separately%20from%20its%20current%20value.%20%2A%2F%0Aexport%20function%20cell%28element%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27cell%27%2C%20element%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20Absence%20keeps%20the%20distinction%20between%20JavaScript%20null%20and%20undefined.%20%2A%2F%0Aexport%20function%20option%28element%2C%20absence%20%3D%20%27both%27%29%20%7B%0A%20%20if%20%28element.kind%20%3D%3D%3D%20%27option%27%29%20%7B%0A%20%20%20%20return%20option%28element.element%2C%20mergeOptionalAbsence%28element.absence%20%3F%3F%20%27both%27%2C%20absence%29%29%3B%0A%20%20%7D%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27option%27%2C%20element%2C%20absence%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20tuple%28elements%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27tuple%27%2C%20elements%3A%20Object.freeze%28%5B...elements%5D%29%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20Whether%20a%20type%20belongs%20to%20the%20admitted%20immutable%20Copy%20product%20model.%20%2A%2F%0Aexport%20function%20immutableProductType%28type%29%20%7B%0A%20%20return%20Boolean%28type%20%26%26%20acceptImmutableProductKind%28type.kind%29%29%0A%20%20%20%20%26%26%20%28type.kind%20%21%3D%3D%20%27tuple%27%20%7C%7C%20type.elements.every%28immutableProductType%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Fields%20are%20named%3B%20their%20declaration%20order%20is%20not%20part%20of%20a%20record%27s%20shape.%20%2A%2F%0Aexport%20function%20record%28fields%2C%20open%20%3D%20false%2C%20reference%20%3D%20false%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27record%27%2C%20fields%3A%20Object.freeze%28fields.map%28%28field%29%20%3D%3E%20Object.freeze%28%7B%20...field%20%7D%29%29%29%2C%20...%28open%20%26%26%20%7B%20open%20%7D%29%2C%20...%28reference%20%26%26%20%7B%20reference%3A%20true%20%7D%29%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20map%28key%2C%20value%2C%20reference%20%3D%20false%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27map%27%2C%20key%2C%20value%2C%20...%28reference%20%26%26%20%7B%20reference%3A%20true%20%7D%29%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20set%28element%2C%20reference%20%3D%20false%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27set%27%2C%20element%2C%20...%28reference%20%26%26%20%7B%20reference%3A%20true%20%7D%29%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20callable%28params%2C%20ret%29%20%7B%0A%20%20return%20Object.freeze%28%7B%20kind%3A%20%27function%27%2C%20params%3A%20Object.freeze%28%5B...params%5D%29%2C%20ret%20%7D%29%3B%0A%7D%0A%0Aexport%20function%20typeKey%28type%29%20%7B%0A%20%20return%20wrapPortableReferenceIdentity%28ordinaryTypeKey%28type%29%2C%20Boolean%28type.reference%29%20%26%26%20%5B%27array%27%2C%20%27record%27%2C%20%27map%27%2C%20%27set%27%5D.includes%28type.kind%29%29%3B%0A%7D%0A%0Afunction%20ordinaryTypeKey%28type%29%20%7B%0A%20%20switch%20%28type.kind%29%20%7B%0A%20%20%20%20case%20%27var%27%3A%0A%20%20%20%20%20%20return%20renderPortableTypeIdentity%28type.kind%2C%20String%28type.id%29%2C%20%5B%5D%29%3B%0A%20%20%20%20case%20%27fixed%27%3A%0A%20%20%20%20%20%20return%20renderPortableTypeIdentity%28type.kind%2C%20%60%24%7Btype.signed%20%3F%20%27i%27%20%3A%20%27u%27%7D%24%7Btype.bits%7D%60%2C%20%5B%5D%29%3B%0A%20%20%20%20case%20%27data%27%3A%0A%20%20%20%20%20%20return%20renderPortableTypeIdentity%28type.kind%2C%20type.name%2C%20%5B%5D%29%3B%0A%20%20%20%20case%20%27array%27%3A%0A%20%20%20%20case%20%27cell%27%3A%0A%20%20%20%20%20%20return%20renderPortableTypeIdentity%28type.kind%2C%20%27%27%2C%20%5BtypeKey%28type.element%29%5D%29%3B%0A%20%20%20%20case%20%27option%27%3A%20%7B%0A%20%20%20%20%20%20const%20normalized%20%3D%20option%28type.element%2C%20type.absence%20%3F%3F%20%27both%27%29%3B%0A%20%