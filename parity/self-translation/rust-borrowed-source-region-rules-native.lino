nedBindingState%28state%29%7Breturn%20state%3D%3D%3D%27available%27%3F%27moved%27%3Astate%3B%7D%0A%2F%2A%2A%20Only%20real%20returning%20paths%20reach%20a%20later%20use%3B%20absent%20arm-local%20identities%0A%20%2A%20cannot%20name%20an%20outer%20binding.%20%40param%20%7Bstring%7D%20left%20%40param%20%7Bstring%7D%20right%0A%20%2A%20%40param%20%7Bboolean%7D%20leftReturns%20%40param%20%7Bboolean%7D%20rightReturns%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20mergeRustOwnedBindingStates%28left%2Cright%2CleftReturns%2CrightReturns%29%7B%0A%20if%28%21leftReturns%26%26%21rightReturns%29return%20%27unreachable%27%3B%0A%20if%28%21leftReturns%7C%7Cleft%3D%3D%3D%27absent%27%29return%20right%3B%0A%20if%28%21rightReturns%7C%7Cright%3D%3D%3D%27absent%27%29return%20left%3B%0A%20if%28left%3D%3D%3Dright%29return%20left%3B%0A%20return%20%27possibly%20moved%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%5B%5D%7D%20before%20%40param%20%7Bstring%5B%5D%7D%20after%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustOwnedBindingGuard%28before%2Cafter%29%7Bif%28before.length%21%3D%3Dafter.length%29return%20false%3Bfor%28let%20index%3D0%3Bindex%3Cbefore.length%3Bindex%2B%3D1%29if%28before%5Bindex%5D%21%3D%3Dafter%5Bindex%5D%29return%20false%3Breturn%20true%3B%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20state%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20expireRustOwnedBindingState%28state%29%7Breturn%20state%3D%3D%3D%27available%27%7C%7Cstate%3D%3D%3D%27possibly%20moved%27%3F%27dropped%27%3Astate%3B%7D%0A%0A%2F%2A%2A%20A%20result%20must%20be%20a%20tracked%20available%20owner%20or%20a%20constructed%2Fpreviously%0A%20%2A%20transferred%20temporary.%20%40param%20%7Bboolean%7D%20binding%20%40param%20%7Bboolean%7D%20available%0A%20%2A%20%40param%20%7Bboolean%7D%20transferred%20%40param%20%7Bboolean%7D%20fresh%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustOwnedResultTransfer%28binding%2Cavailable%2Ctransferred%2Cfresh%29%7Breturn%20binding%3Favailable%3Atransferred%7C%7Cfresh%3B%7D%0A%0A%2F%2A%2A%20Legacy%20boundary%20when%20no%20explicit%20loan-union%20provenance%20is%20supplied.%0A%20%2A%20%40param%20%7Bboolean%7D%20tracked%20%40param%20%7Bboolean%7D%20borrowed%20%40param%20%7Bboolean%7D%20named%0A%20%2A%20%40param%20%7Bboolean%7D%20same%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedBorrowJoinError%28tracked%2Cborrowed%2Cnamed%2Csame%29%7Breturn%20tracked%26%26borrowed%26%26named%26%26%21same%3F%27alternative%20borrowed%20owners%20need%20their%20complete%20loan%20union%20proof%27%3A%27%27%3B%7D%0A%0A%2F%2A%2A%20Canonical%20loan%20identities%20are%20actual%20source%20bindings%2C%20never%20type%20names.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20left%20%40param%20%7Bstring%5B%5D%7D%20right%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%0Aexport%20function%20mergeRustOwnedLoanBindings%28left%2Cright%29%7B%0A%20let%20result%3Dleft.slice%280%2C0%29%3B%0A%20for%28const%20identity%20of%20left%29if%28%21result.includes%28identity%29%29result%3D%5B...result%2Cidentity%5D%3B%0A%20for%28const%20identity%20of%20right%29if%28%21result.includes%28identity%29%29result%3D%5B...result%2Cidentity%5D%3B%0A%20return%20result%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20identity%20%40param%20%7Bstring%5B%5D%7D%20loans%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%0Aexport%20function%20projectRustOwnedLoanBindings%28identity%2Cloans%29%7Breturn%20mergeRustOwnedLoanBindings%28identity%3D%3D%3D%27%27%3F%5B%5D%3A%5Bidentity%5D%2Cloans%29%3B%7D%0A%2F%2A%2A%20Error%20precedence%20is%20independent%20of%20host%20map%2Fparameter%20enumeration%20order.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20states%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedLoanReadError%28states%29%7B%0A%20if%28states.includes%28%27dropped%27%29%29return%20readRustOwnedBindingReadError%28%27dropped%27%29%3B%0A%20if%28states.includes%28%27moved%27%29%29return%20readRustOwnedBindingReadError%28%27moved%27%29%3B%0A%20if%28states.includes%28%27possibly%20moved%27%29%29return%20readRustOwnedBindingReadError%28%27possibly%20moved%27%29%3B%0A%20for%28const%20state%20of%20states%29if%28state%21%3D%3D%27available%27%29return%20readRustOwnedBindingReadError%28%27%27%29%3B%0A%20return%20%27%27%3B%0A%7D%0A%0A%2F%2A%2A%20The%20represented%20standard%20String%20From%20cases%20preserve%20actual%20source%20storage.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bstring%7D%20storage%20%40param%20%7Bnumber%7D%20layers%0A%20%2A%20%40param%20%7Bboolean%7D%20known%20%40param%20%7Bboolean%7D%20references%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedStringConstructionError%28kind%2Cstorage%2Clayers%2Cknown%2Creferences%29%7Breturn%20known%26%26kind%3D%3D%3D%27string%27%26%26%28storage%3D%3D%3D%27owned%20string%27%26%26layers%3D%3D%3D0%7C%7C%28storage%3D%3D%3D%27owned%20string%27%7C%7Cstorage%3D%3D%3D%27string%20slice%27%29%26%26layers%3D%3D%3D1%26%26references%29%3F%27%27%3A%27standard%20String%20construction%20needs%20an%20actual%20owned%20String%20or%20one%20immutable%20String%2Fstr%20reference%27%3B%7D%0A%0A%2F%2A%2A%20Container%20elements%20move%20before%20the%20next%20source%20macro%20argument%20is%20evaluated.%0A%20%2A%20%40param%20%7Bstring%7D%20macro%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustOwnedMacroArgumentTransfer%28macro%29%7Breturn%20macro%3D%3D%3D%27vec%27%3B%7D%0A%0A%2F%2A%2A%20str%20itself%20is%20unsized%3B%20cloning%20its%20single%20shared%20reference%20keeps%20that%20loan.%0A%20%2A%20%40param%20%7Bstring%7D%20method%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bstring%7D%20storage%0A%20%2A%20%40param%20%7Bnumber%7D%20layers%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustStringSliceCloneReference%28method%2Ckind%2Cstorage%2Clayers%29%7Breturn%20method%3D%3D%3D%27clone%27%26%26kind%3D%3D%3D%27string%27%26%26storage%3D%3D%3D%27string%20slice%27%26%26layers%3D%3D%3D1%3B%7D%0A%0A%2F%2A%2A%20Full-expression%20frames%20preserve%20enclosing%20temporaries%3B%20extending%20initializer%0A%20%2A%20borrows%20move%20their%20drop%20scope%2C%20while%20owned%20results%20move%20out%20as%20values.%0A%20%2A%20%40param%20%7Bboolean%7D%20framed%20%40param%20%7Bboolean%7D%20extended%20%40param%20%7Bboolean%7D%20escaping%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedTemporaryDisposition%28framed%2Cextended%2Cescaping%29%7Breturn%20framed%7C%7Cescaping%3F%27leave%27%3Aextended%3F%27extend%27%3A%27expire%27%3B%7D%0A%0A%2F%2A%2A%20Value%20context%20cannot%20move%20an%20owned%20payload%20out%20of%20a%20shared%20reference.%0A%20%2A%20Copy%20projection%20and%20explicit%20clone%2Fborrow%20contexts%20remain%20distinct.%0A%20%2A%20%40param%20%7Bboolean%7D%20tracked%20%40param%20%7Bboolean%7D%20borrowed%20%40param%20%7Bboolean%7D%20owned%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustOwnedPlaceMoveError%28tracked%2Cborrowed%2Cowned%29%7Breturn%20tracked%26%26borrowed%26%26owned%3F%27an%20owned%20source%20value%20cannot%20move%20out%20of%20a%20borrowed%20place%27%3A%27%27%3B%7D%0A) (lang: meta-language%20structured%20data)))
