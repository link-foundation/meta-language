28edit.start%2Cedit.start%2Bedit.to.length%29%2Cedit.to%29%3Bsource%3Dsource.slice%280%2Cedit.start%29%2Bedit.from%2Bsource.slice%28edit.start%2Bedit.to.length%29%3B%7D%0A%20%20assert.equal%28source%2Cmodule.sourceText%29%3B%0A%7D%29%3B%0A%0Atest%28%27actual%20packaging%20descriptors%20remain%20distinct%20while%20every%20complete%20historical%20gate%20still%20executes%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DgenerateLibraryRelocationHistory%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20for%28const%20row%20of%20history.sources%29%7B%0A%20%20%20%20const%20current%3DreadProjectData%28new%20URL%28row.file%2Croot%29%29%2Crestored%3DrestoreNativeLibraryReceipt%28current%2Crow.identity%29%3B%0A%20%20%20%20assert.equal%28serializeProjectData%28restored%2Crow.file%29%2Crow.sourceText%29%3B%0A%20%20%20%20assert.deepEqual%28readNativeLibraryReceiptProfile%28row.identity%29%2C%7Bfile%3Arow.file%2C...row.current%7D%29%3B%0A%20%20%20%20assert.notEqual%28row.current.sha256%2Crow.sha256%29%3B%0A%20%20%20%20const%20original%3DrestoreCompleteDeclarationReceipt%28restored%2Crow.identity%29%3B%0A%20%20%20%20assert.deepEqual%28restoreCompleteDeclarationReceipt%28current%2Crow.identity%29%2Coriginal%29%3B%0A%20%20%20%20assert.equal%28serializeProjectData%28current%2Crow.file%29%2CreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27changed%20algorithms%20unknown%20fields%20incomplete%20descriptors%20and%20unrelated%20native%20owners%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DgenerateLibraryRelocationHistory%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20for%28const%20row%20of%20history.sources%29for%28const%20mutate%20of%5B%0A%20%20%20%20value%3D%3E%7Bvalue.extra%3D%27unknown%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sourceSha256%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bif%28value.completeRust%29value.completeRust%2B%3D%27%20%27%3Belse%20value.emitted.text%2B%3D%27%20%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bif%28value.library%29value.library.files%5B0%5D.bytes%2B%3D1%3Belse%20value.predecessor.proof.producerApplicability.sources.reverse%28%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bdelete%20value.archive%3B%7D%2C%0A%20%20%5D%29%7B%0A%20%20%20%20const%20current%3DreadProjectData%28new%20URL%28row.file%2Croot%29%29%3Bmutate%28current%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreCompleteDeclarationReceipt%28current%2Crow.identity%29%2Cassert.AssertionError%29%3B%0A%20%20%7D%0A%20%20assert.throws%28%28%29%3D%3EreadNativeLibraryReceiptProfile%28%27unregistered%20packaging%27%29%2C%2Fexact%20native%20packaging%20identity%2Fu%29%3B%0A%7D%29%3B%0A%0Atest%28%27complete%20current%20source%20adapters%20preserve%20every%20original%20historical%20assertion%20and%20reject%20unreviewed%20edits%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DgenerateLibraryRelocationHistory%28%7Bcheck%3Atrue%7D%29%3Bassert.equal%28history.sourceAdapters.length%2C2%29%3B%0A%20%20for%28const%20row%20of%20history.sourceAdapters%29%7B%0A%20%20%20%20const%20current%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%3Bassert.equal%28restoreNativeLibrarySource%28current%2Crow.file%29%2Crow.sourceText%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.sourceText%29%2C%7Brevision%3Arow.commit%2Cpath%3Arow.file%7D%29%3B%0A%20%20%7D%0A%20%20const%20file%3D%27js%2Fscripts%2Fcomplete-declaration-receipts.mjs%27%2Csource%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%2Crevision%3D%279f867bfac32f59a3341dabf54e8c0c02fbd83314%27%3B%0A%20%20assert.doesNotThrow%28%28%29%3D%3ErestoreTranslationSourceHistory%28source%2Cfile%2Crevision%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErestoreTranslationSourceHistory%28source%2B%27%20%27%2Cfile%2Crevision%29%2C%2Funreviewed%20current%20source%7Ccomplete%20current%20source%2Fu%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
