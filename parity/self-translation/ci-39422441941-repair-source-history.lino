8row.edit.offsetUnit%2C%27UTF-16%20code%20units%27%29%3B%0A%20%20assert.equal%28source.slice%28row.edit.start%2Crow.edit.start%2Brow.edit.inserted.length%29%2Crow.edit.inserted%29%3B%0A%20%20const%20restored%3Dsource.slice%280%2Crow.edit.start%29%2Brow.edit.removed%2Bsource.slice%28row.edit.start%2Brow.edit.inserted.length%29%3B%0A%20%20assert.equal%28restored%2Crow.sourceText%29%3Bassert.deepEqual%28pin%28restored%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3Breturn%20restored%3B%0A%7D%0A%0A%2F%2A%2A%20Invert%20only%20reviewed%20packaging%20descriptors%20before%20the%20existing%20complete%20gate.%20%2A%2F%0Aexport%20function%20restoreNativeLibraryReceipt%28artifact%2Cidentity%29%20%7B%0A%20%20if%28%21%5B%27collection%20construction%27%2C%27raw%20consuming%27%5D.includes%28identity%29%29return%20artifact%3B%0A%20%20const%20history%3DreadNativeLibraryHistory%28%29%2Crow%3Dhistory.sources.find%28row%3D%3Erow.identity%3D%3D%3Didentity%29%3Bassert.ok%28row%29%3B%0A%20%20const%20bytes%3DBuffer.from%28serializeProjectData%28artifact%2Crow.file%29%29%3B%0A%20%20if%28pin%28bytes%29.sha256%21%3D%3Drow.current.sha256%29return%20artifact%3B%0A%20%20assert.equal%28bytes.length%2Crow.current.bytes%29%3B%0A%20%20for%28const%20module%20of%20history.modules%29%7B%0A%20%20%20%20verifyGitArtifactCertificate%28module.certificate%2CBuffer.from%28module.sourceText%29%2C%7Brevision%3Amodule.commit%2Cpath%3Amodule.file%7D%29%3B%0A%20%20%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28module.file%2Croot%29%29%29%2Cmodule.current%2C%27the%20actual%20corrected%20native%20module%20remains%20exact%27%29%3B%0A%20%20%7D%0A%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.sourceText%29%2C%7Brevision%3Arow.commit%2Cpath%3Arow.file%7D%29%3B%0A%20%20const%20restored%3DstructuredClone%28artifact%29%3B%0A%20%20for%28const%20change%20of%20row.changes%29%7B%0A%20%20%20%20assert.ok%28change.path.every%28key%3D%3Etypeof%20key%3D%3D%3D%27string%27%26%26%21%5B%27__proto__%27%2C%27constructor%27%2C%27prototype%27%5D.includes%28key%29%29%29%3B%0A%20%20%20%20assert.ok%28change.path%5B0%5D%3D%3D%3D%27library%27%26%26change.path%5B1%5D%3D%3D%3D%27files%27%26%26change.path.length%3D%3D%3D4%0A%20%20%20%20%20%20%7C%7Cchange.path.slice%280%2C4%29.join%28%27.%27%29%3D%3D%3D%27predecessor.proof.producerApplicability.sources%27%26%26change.path.length%3D%3D%3D6%29%3B%0A%20%20%20%20assert.ok%28%5B%27bytes%27%2C%27sourceSha256%27%2C%27sha256%27%5D.includes%28change.path.at%28-1%29%29%29%3B%0A%20%20%20%20let%20parent%3Drestored%3Bfor%28const%20key%20of%20change.path.slice%280%2C-1%29%29%7Bassert.ok%28Object.hasOwn%28parent%2Ckey%29%29%3Bparent%3Dparent%5Bkey%5D%3B%7D%0A%20%20%20%20const%20key%3Dchange.path.at%28-1%29%3Bassert.deepEqual%28parent%5Bkey%5D%2Cchange.after%29%3Bparent%5Bkey%5D%3Dchange.before%3B%0A%20%20%7D%0A%20%20const%20original%3DBuffer.from%28serializeProjectData%28restored%2Crow.file%29%29%3B%0A%20%20assert.deepEqual%28pin%28original%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20assert.equal%28original.toString%28%27utf8%27%29%2Crow.sourceText%2C%27every%20complete%20predecessor%20receipt%20byte%20is%20restored%27%29%3B%0A%20%20return%20restored%3B%0A%7D%0A%60%3B%0A%0A%2F%2A%2A%20Preserve%20all%20emitted%20algorithms%20while%20recording%20the%20corrected%20library%20bytes.%20%2A%2F%0Aexport%20function%20generateLibraryRelocationHistory%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20before%3Doriginal%28libraryFile%2ClibraryRevision%29%2Cold%3DreadProjectDataFromSource%28before.sourceText%29%3B%0A%20%20const%20current%3DreadProjectData%28new%20URL%28libraryFile%2Croot%29%29%2Cchanges%3D%5B%5D%2Cmodules%3D%5B%5D%3B%0A%20%20assert.equal%28old.library.files.length%2Ccurrent.library.files.length%29%3B%0A%20%20const%20inverse%3DstructuredClone%28current%29%3B%0A%20%20for%28const%20%5Bindex%2Centry%5Dof%20current.library.files.entries%28%29%29%7B%0A%20%20%20%20const%20previous%3Dold.library.files%5Bindex%5D%3Bassert.equal%28entry.path%2Cprevious.path%29%3B%0A%20%20%20%20const%20file%3D%27rust%2Fsrc%2Ftranslation%2F%27%2Bentry.path%3B%0A%20%20%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28file%2Croot%29%29%29%2C%7Bbytes%3Aentry.bytes%2Csha256%3Aentry.sourceSha256%7D%29%3B%0A%20%20%20%20if%28JSON.stringify%28entry%29%3D%3D%3DJSON.stringify%28previous%29%29continue%3B%0A%20%20%20%20const%20module%3Doriginal%28file%2ClibraryRevision%29%2Cactual%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20%20%20assert.deepEqual%28%7Bbytes%3Amodule.bytes%2Csha256%3Amodule.sha256%7D%2C%7Bbytes%3Aprevious.bytes%2Csha256%3Aprevious.sourceSha256%7D%29%3B%0A%20%20%20%20const%20edits%3Dtokenize%28module.sourceText%2C%27Rust%27%29.tokens.filter%28token%3D%3Etoken.kind%3D%3D%3D%27string%27%26%26token.raw.includes%28%27self%3A%3Aml_array%3A%3A%27%29%29%0A%20%20%20%20%20%20.map%28token%3D%3E%28%7Bstart%3Atoken.start%2Cend%3Atoken.end%2Cfrom%3Atoken.raw%2Cto%3Atoken.raw.replaceAll%28%27self%3A%3Aml_array%3A%3A%27%2C%27crate%3A%3Aml_array%3A%3A%27%29%7D%29%29%3B%0A%20%20%20%20assert.equal%28edits.length%2C1%2C%27the%20one%20known%20source-producing%20library%20literal%20is%20corrected%27%29%3B%0A%20%20%20%20let%20derived%3Dmodule.sourceText%3Bfor%28const%20edit%20of%20%5B...edits%5D.reverse%28%29%29derived%3Dderived.slice%280%2Cedit.start%29%2Bedit.to%2Bderived.slice%28edit.end%29%3B%0A%20%20%20%20assert.equal%28derived%2Cactual%2C%27every%20other%20complete%20native%20module%20byte%20remains%20unchanged%27%29%3B%0A%20%20%20%20modules.push%28%7B...module%2Ccurrent%3Apin%28actual%29%2CoffsetUnit%3A%27UTF-16%20code%20units%27%2Cedits%7D%29%3B%0A%20%20%20%20for%28const%20field%20of%20%5B%27bytes%27%2C%27sourceSha256%27%5D%29if%28entry%5Bfield%5D%21%3D%3Dprevious%5Bfield%5D%29%7B%0A%20%20%20%20%20%20changes.push%28%7Bpath%3A%5B%27library%27%2C%27files%27%2CString%28index%29%2Cfield%5D%2Cbefore%3Aprevious%5Bfield%5D%2Cafter%3Aentry%5Bfield%5D%7D%29%3B%0A%20%20%20%20%