%3Dnode%3D%3Enode.children.filter%28child%3D%3Echild.node.named%26%26%21child.node.isExtra%29.map%28child%3D%3Echild.node%29%3B%0Aconst%20field%3D%28node%2Cname%29%3D%3E%7Bconst%20found%3Dnode.children.filter%28child%3D%3Echild.field%3D%3D%3Dname%29%3Bassert.equal%28found.length%2C1%2C%27one%20complete%20actual%20%27%2Bname%2B%27%20field%27%29%3Breturn%20found%5B0%5D.node%3B%7D%3B%0Aconst%20optionalField%3D%28node%2Cname%29%3D%3E%7Bconst%20found%3Dnode.children.filter%28child%3D%3Echild.field%3D%3D%3Dname%29%3Bassert.ok%28found.length%3C%3D1%29%3Breturn%20found%5B0%5D%3F.node%3B%7D%3B%0Aconst%20canonical%3Dvalue%3D%3EserializeProjectData%28value%2C%27diagnostic-order.lino%27%29%3B%0Aconst%20sameKeys%3D%28left%2Cright%29%3D%3Eassert.deepEqual%28%5B...left%5D.sort%28%29%2C%5B...right%5D.sort%28%29%2C%27exact%20key%20membership%20is%20preserved%27%29%3B%0A%2F%2F%20There%20is%20exactly%20one%20admitted%20frozen%20source%20pair.%20A%20private%20copy%20avoids%0A%2F%2F%20reparsing%20it%20for%20each%20inverse%2Ftamper%20control%20without%20trusting%20caller%20objects.%0Alet%20frozenDerivation%3B%0Afunction%20visit%28node%2Cancestors%2Coperation%29%7Boperation%28node%2Cancestors%29%3Bfor%28const%20child%20of%20node.children%29visit%28child.node%2C%5B...ancestors%2Cnode%5D%2Coperation%29%3B%7D%0A%0Afunction%20actualSource%28source%2Clanguage%2Cpath%29%20%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%0A%20%20const%20bytes%3DBuffer.from%28source%29%3Bassert.ok%28bytes.length%3E0%26%26bytes.length%3C%3D131072%2C%27bounded%20complete%20source%20owner%27%29%3B%0A%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2Csource%2C%27complete%20source%20must%20be%20valid%20Unicode%27%29%3B%0A%20%20const%20tree%3DparseNative%28language%2Csource%29%3B%0A%20%20assert.equal%28tree.term%2Clanguage%3D%3D%3D%27native-javascript%27%3F%27program%27%3A%27source_file%27%29%3B%0A%20%20assert.equal%28tree.hasError%2Cfalse%2C%27actual%20source%20CST%20has%20no%20error%20or%20missing%2