ative.productionPredecessor.sha256%29%3B%0A%20%20assert.equal%28packet.frozenOverlay.original.sha256%2Cnative.historical.sha256%29%3B%0A%20%20assert.equal%28packet.frozenOverlay.receipt.role%2C%27frozen%20CI%20overlay%27%29%3B%0A%20%20for%28const%20row%20of%20packet.sources%29assert.equal%28Object.hasOwn%28row%2C%27observations%27%29%2Cfalse%29%3B%0A%20%20for%28const%20row%20of%20native.proof.declarations%29%7B%0A%20%20%20%20const%20bytes%3DreadFileSync%28new%20URL%28native.file%2Croot%29%29%3Bassert.equal%28bytes.subarray%28row.start%2Crow.end%29.toString%28%29%2Crow.source%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28checkGlobalGrammarContextSourceProfiles%28packet%29%2Cpacket%29%3B%0A%7D%29%3B%0A%0Atest%28%27candidate%20context%20source%20proofs%20survive%20exact%20Links%20text%20and%20binary%20reload%20without%20shared%20caller%20objects%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DbuildGlobalGrammarContextSourceProfiles%28%29%2Cencoded%3DencodeStructuredDataLinks%28packet%29%3B%0A%20%20const%20text%3DstructuredDataToLino%28packet%29%3Bassert.equal%28typeof%20text%2C%27string%27%29%3B%0A%20%20const%20network%3DLinkNetwork.fromLino%28text%29%3B%0A%20%20for%28const%20graph%20of%20%5Bnetwork%2CdecodeLinkNetworkBinary%28encodeLinkNetworkBinary%28network%29%29%5D%29%7B%0A%20%20%20%20const%20value%3DdecodeStructuredDataLinks%28graph%2Cencoded.root%29%3Bassert.deepEqual%28value%2Cpacket%29%3B%0A%20%20%20%20assert.deepEqual%28checkGlobalGrammarContextSourceProfiles%28value%29%2Cpacket%29%3B%0A%20%20%7D%0A%20%20const%20returned%3DcheckGlobalGrammarContextSourceProfiles%28packet%29%3Breturned.sources%5B1%5D.proof.declarations%5B0%5D.source%2B%3D%27changed%27%3B%0A%20%20assert.deepEqual%28buildGlobalGrammarContextSourceProfiles%28%29%2Cpacket%29%3B%0A%20%20assert.deepEqual%28checkGlobalGrammarContextSourceProfiles%28packet%29%2Cpacket%29%3B%0A%20%20assert.throws%28%28%29%3D%3EcheckGlobalGrammarContextSourceProfiles%28returned%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27mixed%20frozen%20current%20and%20proposed%20identities%20changed%20owners%20missing%20sources%20and%20altered%20inverse%20order%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20packet%3DbuildGlobalGrammarContextSourceProfiles%28%29%3B%0A%20%20for%28const%20mutate%20of%20%5B%0A%20%20%20%20value%3D%3E%7Bvalue.historicalPins%5Bvalue.sources%5B0%5D.file%5D%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B1%5D.proposed.sha256%3Dvalue.sources%5B1%5D.productionPredecessor.sha256%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B0%5D.proposed.bytes%2B%2B%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.frozenOverlay.output.sha256%3Dvalue.sources%5B1%5D.proposed.sha256%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.frozenOverlay.receipt.role%3D%27production%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B1%5D.proof.imports%5B0%5D.source%2B%3D%27changed%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B1%5D.proof.declarations%5B0%5D.source%2B%3D%27changed%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B1%5D.proof.declarations%5B0%5D.start%2B%2B%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B0%5D.proof%5B0%5D.source%2B%3D%27changed%27%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B0%5D.proof%5B0%5D.currentCall.sha256%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources%5B1%5D.inverseSteps.reverse%28%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.sources.pop%28%29%3B%7D%2C%0A%20%20%20%20value%3D%3E%7Bvalue.proposal.sha256%3D%270%27.repeat%2864%29%3B%7D%2C%0A%20%20%5D%29%7B%0A%20%20%20%20const%20value%3DstructuredClone%28packet%29%3Bmutate%28value%29%3Bassert.throws%28%28%29%3D%3EcheckGlobalGrammarContextSourceProfiles%28value%29%29%3B%0A%20%20%7D%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
