5Bstart%5D%3D%3D%3Dcurrent%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20while%28end%3Estart%26%26finish%3Estart%26%26sourceText%5Bend-1%5D%3D%3D%3Dcurrent%5Bfinish-1%5D%29%7Bend--%3Bfinish--%3B%7D%0A%20%20%20%20const%20edit%3D%7Bstart%3ABuffer.byteLength%28current.slice%280%2Cstart%29%29%2Cend%3ABuffer.byteLength%28current.slice%280%2Cfinish%29%29%2CcurrentText%3Acurrent.slice%28start%2Cfinish%29%2CpreviousText%3AsourceText.slice%28start%2Cend%29%7D%3B%0A%20%20%20%20const%20bytes%3DBuffer.from%28current%29%2Crestored%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.previousText%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20assert.equal%28restored.toString%28%29%2CsourceText%29%3Bassert.deepEqual%28pin%28restored%29%2Cpin%28sourceText%29%29%3B%0A%20%20%20%20return%7Bfile%2Ccommit%3Arevision%2C...pin%28sourceText%29%2CsourceText%2Ccertificate%2Ccurrent%3Apin%28current%29%2Cedit%2Crole%3Adescriptors.includes%28file%29%3F%27historical%20descriptor%27%3A%27historical%20source%27%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3A1%2Crevision%2Csources%2CdescriptorChanges%3Achanges%2C%0A%20%20%20%20assertionCorrection%3A%7Bfile%3A%27js%2Ftests%2Ftranslation-string-relative-character.test.js%27%2Cinput%3A%27%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20values%20%40returns%20%7Bnumber%7Cundefined%7D%20%2A%2Ffunction%20last%28values%29%7Breturn%20values.at%28-1%29%3B%7D%27%2C%0A%20%20%20%20%20%20authority%3A%27https%3A%2F%2Ftc39.es%2Fecma262%2Fmultipage%2Findexed-collections.html%23sec-array.prototype.at%27%2ClanguageVersions%3A%7Bminimum%3A%272022%27%2CmaximumExclusive%3A%272027%27%7D%2C%0A%20%20%20%20%20%20reason%3A%27The%20complete%20relative%20array%20lambda%20now%20executes%20the%20original%20standard%20operation.%20Keep%20the%20original%20input%20and%20predecessor%20source%3B%20require%20its%20independently%20observed%20present%20and%20absent%20results.%27%7D%2C%0A%20%20%20%20boundary%3A%27Whole%20predecessor%20sources%20and%20descriptors%20only.%20Every%20recorded%20native%20definition%20ABI%20owner%20replay%20archive%20and%20original%20assertion%20remains.%20Current%20execution%20and%20descriptor%20gates%20read%20current%20data%3B%20historical%20views%20invert%20only%20complete%20authenticated%20inputs.%20No%20native%20execution%20or%20global%20equivalence%20claim.%27%7D%3B%0A%20%20const%20file%3Dnew%20URL%28%27parity%2Fself-translation%2Farray-relative-element-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28file%2Chistory%29%3Belse%20writeProjectData%28file%2Chistory%29%3B%0A%20%20const%20adapter%3Dnew%20URL%28%27js%2Fscripts%2Farray-relative-element-history.mjs%27%2Croot%29%2Ctext%3DreadFileSync%28adapter%2C%27utf8%27%29%3B%0A%20%20const%20pinned%3Dtext.replace%28%2Fconst%20historyHash%3D%27%5Ba-f0-9%5D%7B64%7D%27%3B%2Fu%2C%22const%20historyHash%3D%27%22%2Bdigest%28readFileSync%28file%29%29%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28text%2Cpinned%29%3Belse%20writeFileSync%28adapter%2Cpinned%29%3B%0A%20%20return%20history%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20history%3DgenerateArrayRelativeElementHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Retained%20%27%2Bhistory.sources.length%2B%27%20complete%20original%20files%20and%20all%20native%20definitions%3B%20two%20checker%20provenance%20fields%20refreshed.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
