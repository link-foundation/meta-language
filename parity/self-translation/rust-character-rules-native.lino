(115: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Shared%20bounded%20Rust%20character%20and%20byte-character%20lexical%20decisions.%0A%2F%2F%20The%20generator%20retains%20every%20actual%20dependency%3B%20typed%20character%20semantics%20stay%20refused.%0Aimport%20%7B%20readSourceTextScalar%20%7D%20from%20%27.%2Fsource-text-byte-rules.js%27%3B%0Aimport%20%7B%20acceptRustCookedStringEscapePrefix%2C%20readRustAsciiEscapeDigit%2C%20readRustAsciiEscapeValue%20%7D%20from%20%27.%2Frust-cooked-string-rules.js%27%3B%0Aimport%20%7B%20decodeRustUnicodeEscape%20%7D%20from%20%27.%2Frust-unicode-escape-rules.js%27%3B%0Aimport%20%7B%20acceptRustSourceHeaderLifetimeCharacter%20%7D%20from%20%27.%2Frust-source-header-emission-rules.js%27%3B%0Aimport%20%7B%20acceptRustSourceWhitespace%20%7D%20from%20%27.%2Frust-source-whitespace-rules.js%27%3B%0A%0A%2F%2A%2A%20%40typedef%20%7B%7B%20%24%3A%20%27notCharacter%27%20%7D%20%7C%20%7B%20%24%3A%20%27char%27%2C%20value%3A%20number%2C%20contentStart%3A%20number%2C%20contentEnd%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27byteChar%27%2C%20value%3A%20number%2C%20contentStart%3A%20number%2C%20contentEnd%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27malformed%27%2C%20at%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27unterminated%27%2C%20at%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27nonScalar%27%2C%20at%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27nonAscii%27%2C%20at%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27unicodeByteEscape%27%2C%20at%3A%20number%2C%20end%3A%20number%20%7D%20%7C%20%7B%20%24%3A%20%27unsupportedSuffix%27%2C%20at%3A%20number%2C%20end%3A%20number%20%7D%7D%20RustCharacterLiteral%20%2A%2F%0A%0A%2F%2F%20The%20existing%20digit%20classifier%20is%20canonical.%20Unlike%20the%20existing%20cooked%0A%2F%2F%20character%2Fstring%20ASCII%20helper%2C%20this%20byte%20operation%20permits%20both%20digits%200..15.%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20highUnit%20%40param%20%7Bnumber%7D%20lowUnit%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustCharacterByteEscapeValue%28highUnit%2C%20lowUnit%29%20%7B%0A%20%20const%20high%20%3D%20readRustAsciiEscapeDigit%28highUnit%29%3B%0A%20%20const%20low%20%3D%20readRustAsciiEscapeDigit%28lowUnit%29%3B%0A%20%20if%20%28high%20%3C%200%20%7C%7C%20low%20%3C%200%29%20return%20-1%3B%0A%20%20return%20high%20%2A%2016%20%2B%20low%3B%0A%7D%0A%0A%2F%2F%20Finite%20value%20mapping%20corresponding%20to%20the%20existing%20cooked-string%20prefix%0A%2F%2F%20policy%20and%20stringToken%27s%20simple-value%20table.%20No%20second%20hex%2Fscalar%20decoder.%0A%2F%2A%2A%20%40param%20%7Bnumber%7D%20unit%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustCharacterSimpleEscapeValue%28unit%29%20%7B%0A%20%20if%20%28unit%20%3D%3D%3D%20110%29%20return%2010%3B%0A%20%20if%20%28unit%20%3D%3D%3D%20114%29%20return%2013%3B%0A%20%20if%20%28unit%20%3D%3D%3D%20116%29%20return%209%3B%0A%20%20if%20%28unit%20%3D%3D%3D%2048%29%20return%200%3B%0A%20%20if%20%28unit%20%3D%3D%3D%2092%20%7C%7C%20unit%20%3D%3D%3D%2039%20%7C%7C%20unit%20%3D%3D%3D%2034%29%20return%20unit%3B%0A%20%20return%20-1%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bboolean%7D%20byte%20%40param%20%7Bnumber%7D%20value%20%40param%20%7Bnumber%7D%20contentStart%20%40param%20%7Bnumber%7D%20contentEnd%20%40returns%20%7BRustCharacterLiteral%7D%20%2A%2F%0Aexport%20function%20finishRustCharacterLiteral%28units%2C%20byte%2C%20value%2C%20contentStart%2C%20contentEnd%29%20%7B%0A%20%20if%20%28contentEnd%20%3E%3D%20units.length%29%20return%20%7B%20%24%3A%20%27unterminated%27%2C%20at%3A%20contentStart%2C%20end%3A%20units.length%20%7D%3B%0A%20%20if%20%28units%5BcontentEnd%5D%20%21%3D%3D%2039%29%20return%20%7B%20%24%3A%20%27malformed%27%2C%20at%3A%20contentEnd%2C%20end%3A%20contentEnd%20%2B%201%20%7D%3B%0A%20%20const%20end%20%3D%20contentEnd%20%2B%201%3B%0A%20%20%2F%2F%20The%20bounded%20draft%20recognizes%20unsuffixed%20literal%20tokens.%20Rust%20token%20syntax%0A%20%20%2F%2F%20permits%20identifier%20suffixes%20even%20on%20chars%2Fbytes%3B%20those%20are%20NOT%20declared%0A%20%20%2F%2F%20malformed.%20Current%20source%20identifiers%20are%20ASCII%2C%20so%20known%20ASCII%20starts%20and%0A%20%20%2F%2F%20any%20unproved%20non-ASCII%20suffix-looking%20continuation%20refuse%20explicitly.%0A%20%20const%20following%20%3D%20units%5Bend%5D%20%3F%3F%20-1%3B%0A%20%20if%20%28acceptRustSourceHeaderLifetimeCharacter%28following%2C%20true%29%29%20%7B%0A%20%20%20%20return%20%7B%20%24%3A%20%27unsupportedSuffix%27%2C%20at%3A%20end%2C%20end%3A%20end%20%2B%201%20%7D%3B%0A%20%20%7D%0A%20%20if%20%28following%20%3E%3D%20128%20%26%26%20%21acceptRustSourceWhitespace%28following%29%29%20%7B%0A%20%20%20%20const%20scalar%20%3D%20readSourceTextScalar%28units%2C%20end%29%3B%0A%20%20%20%20if%20%28scalar%20%3C%200%29%20return%20%7B%20%24%3A%20%27nonScalar%27%2C%20at%3A%20end%2C%20end%3A%20end%20%2B%201%20%7D%3B%0A%20%20%20%20return%20%7B%20%24%3A%20%27unsupportedSuffix%27%2C%20at%3A%20end%2C%20end%3A%20end%20%2B%20%28scalar%20%3E%3D%2065536%20%3F%202%20%3A%201%29%20%7D%3B%0A%20%20%7D%0A%20%20if%20%28byte%29%20return%20%7B%20%24%3A%20%27byteChar%27%2C%20value%2C%20contentStart%2C%20contentEnd%2C%20end%20%7D%3B%0A%20%20return%20%7B%20%24%3A%20%27char%27%2C%20value%2C%20contentStart%2C%20contentEnd%2C%20end%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Read%20one%20unsuffixed%20character%2Fbyte-character%20token%20at%20its%20absolute%20start.%0A%20%2A%20A%20plain%20apostrophe%20without%20exactly%20one%20scalar%20and%20a%20closing%20apostrophe%0A%20%2A%20returns%20notCharacter%2C%20preserving%20the%20existing%20lifetime%2Flabel%20token%20path.%0A%20%2A%20It%20does%20not%20authenticate%20that%20the%20remaining%20source%20is%20a%20valid%20lifetime.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20units%20%40param%20%7Bnumber%7D%20start%20%40returns%20%7BRustCharacterLiteral%7D%0A%20%2A%2F%0Aexport%20function%20decodeRustCharacterLiteral%28units%2C%20start%29%20%7B%0A%20%20if%20%28%21Number.isInteger%28start%29%20%7C%7C%20start%20%3C%200%20%7C%7C%20start%20%3E%3D%20units.length%29%20return%20%7B%20%24%3A%20%27notCharacter%27%20%7D%3B%0A%20%20const%20byte%20%3D%20units%5Bstart%5D%20%3D%3D%3D%2098%20%26%26%20units%5Bstart%20%2B%201%5D%20%3D%3D%3D%2039%3B%0A%20%20if%20%28%21byte%20%26%26%20units%5Bstart%5D%20%21%3D%3D%2039%29%20return%20%7B%20%24%3A%20%27notCharacter%27%20%7D%3B%0A%20%20const%20contentStart%20%3D%20start%20%2B%20%28byte%20%3F%202%20%3A%201%29%3B%0A%20%20if%20%28contentStart%20%3E%3D%20units.length%29%20return%20%7B%20%24%3A%20%27unterminated%27%2C%20at%3A%20start%2C%20end%3A%20units.length%20%7D%3B%0A%20%20const%20first%20%3D%20units%5BcontentStart%5D%20%3F%3F%20-1%3B%0A%20%20if%20%28first%20%3D%3D%3D%2039%20%7C%7C%20first%20%3D%3D%3D%209%20%7C%7C%20first%20%3D%3D%3D%2010%20%7C%7C%20first%20%3D%3D%3D%2013%29%20%7B%0A%20%20%20%20return%20%7B%20%24%3A%20%27malformed%27%2C%20at%3A%20contentStart%2C%20end%3A%20contentStart%20%2B%201%20%7D%3B%0A%20%20%7D%0A%20%20if%20%28first%20%21%3D%3D%2092%29%20%7B%0A%20%20%20%20const%20scalar%20%3D%20readSourceTextScalar%28units%2C%20contentStart%29%3B%0A%20%20%20%20if%20%28scalar%20%3C%200%29%20return%20%7B%20%24%3A%20%27nonScalar%27%2C%20at%3A%20contentStart%2C%20end%3A%20contentStart%20%2B%201%20%7D%3B%0A%20%20%20%20const%20contentEnd%20%3D%20contentStart%20%2B%20%28scalar%20%3E%3D%2065536%20%3F%202%20%3A%201%29%3B%0A%20%20%20%20%2F%2F%20Preserve%20every%20nonliteral%20apostrophe%20path%2C%20including%20Unicode%20spellings%0A%20%20%20%20%2F%2F%20outside%20today%27s%20identifier%20profile.%20This%20branch%20consumes%20nothing.%0A%20%20%20%20if%20%28%21byte%20%26%26%20units%5BcontentEnd%5D%20%21%3D%3D%2039%29%20return%20%7B%20%24%3A%20%27notCharacter%27%20%7D%3B%0A%20%20%20%20if%20%28byte%20%26%26%20scalar%20%3E%20127%29%20return%20%7B%20%24%3A%20%27nonAscii%27%2C%20at%3A%20contentStart%2C%20end%3A%20contentEnd%20%7D%3B%0A%20%20%20%20return%20finishRustCharacterLiteral%28units%2C%20byte%2C%20scalar%2C%20contentStart%2C%20contentEnd%29%3B%0A%20%20%7D%0A%20%20const%20escaped%20%3D%20units%5BcontentStart%20%2B%201%5D%20%3F%3F%20-1%3B%0A%20%20if%20%28%21acceptRustCookedStringEscapePrefix%28escaped%29%29%20%7B%0A%20%20%20%20return%20%7B%20%24%3A%20%27malformed%27%2C%20at%3A%20contentStart%2C%20end%3A%20Math.min%28contentStart%20%2B%202%2C%20units.length%29%20%7D%3B%0A%20%20%7D%0A%20%20if%20%28escaped%20%3D%3D%3D%20120%29%20%7B%0A%20%20%20%20const%20high%20%3D%20units%5BcontentStart%20%2B%202%5D%20%3F%3F%20-1%3B%0A%20%20%20%20const%20low%20%3D%20units%5BcontentStart%20%2B%203%5D%20%3F%3F%20-1%3B%0A%20%20%20%20const%20value%20%3D%20byte%20%3F%20readRustCharacterByteEscapeValue%28high%2C%20low%29%20%3A%20readRustAsciiEscapeValue%28high%2C%20low%29%3B%0A%20%20%20%20if%20%28value%20%3C%200%29%20return%20%7B%20%24%3A%20%27malformed%27%2C%20at%3A%20contentStart%2C%20end%3A%20Math.min%28contentStart%20%2B%204%2C%20units.length%29%20%7D%3B%0A%20%20%20%20return%20finishRustCharacterLiteral%28units%2C%20byte%2C%20value%2C%20contentStart%2C%20contentStart%20%2B%204%29%3B%0A%20%20%7D%0A%20%20if%20%28escaped%20%3D%3D%3D%20117%29%20%7B%0A%20%20%20%20if%20%28byte%29%20return%20%7B%20%24%3A%20%27unicodeByteEscape%27%2C%20at%3A%20contentStart%2C%20end%3A%20Math.min%28contentStart%20%2B%202%2C%20units.length%29%20%7D%3B%0A%20%20%20%20const%20scalar%20%3D%20decodeRustUnicodeEscape%28units%2C%20contentStart%29%3B%0A%20%20%20%20if%20%28scalar.%24%20%3D%3D%3D%20%27malformed%27%29%20return%20%7B%20%24%3A%20%27malformed%27%2C%20at%3A%20contentStart%2C%20end%3A%20Math.min%28contentStart%20%2B%202%2C%20units.length%29%20%7D%3B%0A%20%20%20%20if%20%28scalar.%24%20%3D%3D%3D%20%27unsupported%27%29%20return%20%7B%20%24%3A%20%27nonScalar%27%2C%20at%3A%20contentStart%2C%20end%3A%20contentStart%20%2B%20scalar.end%20%7D%3B%0A%20%20%20%20return%20finishRustCharacterLiteral%28units%2C%20false%2C%