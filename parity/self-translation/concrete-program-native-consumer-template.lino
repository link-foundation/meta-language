%20Error%28%27native%20TypeScript%20graph%20execution%20is%20GitHub%20CI-only%27%29%3B%0A%20%20%7D%0A%20%20const%20manifest%3DreadNativeControlData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Ftypescript-typed-graph%2Fmanifest.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20assert.ok%28Number.isSafeInteger%28index%29%26%26index%3E%3D0%26%26index%3Cmanifest.cases.length%29%3B%0A%20%20const%20row%3Dmanifest.cases%5Bindex%5D%2Cresults%3Dresolve%28root%2CresultsDirectory%29%3B%0A%20%20assert.equal%28results%2Cresolve%28root%2C%27issue-195-results%27%29%29%3B%0A%20%20const%20artifacts%3Djoin%28root%2C%27issue-195-artifacts%27%2C%27typescript-typed-graph-native%27%29%3B%0A%20%20const%20expected%3DBuffer.from%28row.expectedLines.map%28line%3D%3Eline%2B%27%5Cn%27%29.join%28%27%27%29%29%3B%0A%20%20const%20graph%3DreadFileSync%28resolve%28root%2Crow.path%29%29%3Bassert.deepEqual%28pin%28graph%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20mkdirSync%28artifacts%2C%7Brecursive%3Atrue%7D%29%3BmkdirSync%28join%28results%2C%27work%27%29%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20const%20work%3DmkdtempSync%28join%28results%2C%27work%27%2C%27typescript-rust-runtime-%27%29%29%3B%0A%20%20const%20git%3DspawnSync%28%27git%27%2C%5B%27rev-parse%27%2C%27HEAD%27%5D%2C%7Bcwd%3Aroot%2Ctimeout%3A10_000%2CmaxBuffer%3A1024%2A1024%7D%29%3B%0A%20%20const%20report%3D%7Bcase%3Aindex%2CsourceGraph%3Arow%2Ccompiler%3AprocessObservation%28spawnSync%28%27rustc%27%2C%5B%27-vV%27%5D%2C%0A%20%20%20%20%7Bcwd%3Aroot%2Ctimeout%3A10_000%2CmaxBuffer%3A1024%2A1024%7D%29%29%2CnodeVersion%3Aprocess.version%2C%0A%20%20%20%20commit%3Agit.status%3D%3D%3D0%3Fgit.stdout.toString%28%27utf8%27%29.trim%28%29%3Anull%2Cgit%3AprocessObservation%28git%29%2C%0A%20%20%20%20run%3Aprocess.env.GITHUB_RUN_ID%3F%3Fnull%2Cattempt%3Aprocess.env.GITHUB_RUN_ATTEMPT%3F%3Fnull%2C%0A%20%20%20%20platform%3Aprocess.platform%2Cobservations%3A%5B%5D%2Cfailures%3A%5B%5D%7D%3B%0A%20%20try%7B%0A%20%20%20%20if%28git.status%21%3D%3D0%7C%7C%21%2F%5E%5B0-9a-f%5D%7B40%7D%24%2Fu.test%28report.commit%3F%3F%27%27%29%7C%7Creport.compiler.exitCode%21%3D%3D0%29%7B%0A%20%20%20%20%20%20report.failures.push%28%7Bprovenance%3A%27native%20compiler%20and%20exact%20checkout%20identities%20are%20required%27%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20for%28const%20target%20of%20%5B%27Rust%27%2C%27JavaScript%27%5D%29%7B%0A%20%20%20%20%20%20try%7B%0A%20%20%20%20%20%20%20%20const%20path%3Djoin%28artifacts%2C%27rust-runtime-case-%27%2Bindex%2B%28target%3D%3D%3D%27Rust%27%3F%27.rs%27%3A%27.js%27%29%29%3B%0A%20%20%20%20%20%20%20%20const%20bytes%3DreadFileSync%28path%29%2Cbinary%3Djoin%28work%2Cprocess.platform%3D%3D%3D%27win32%27%3F%27program.exe%27%3A%27program%27%29%3B%0A%20%20%20%20%20%20%20%20const%20compilation%3Dtarget%3D%3D%3D%27Rust%27%3FspawnSync%28%27rustc%27%2C%5B%27--edition%3D2024%27%2Cpath%2C%27-o%27%2Cbinary%5D%2C%0A%20%20%20%20%20%20%20%20%20%20%7Bcwd%3Aroot%2Ctimeout%3A60_000%2CmaxBuffer%3A1024%2A1024%7D%29%3Anull%3B%0A%20%20%20%20%20%20%20%20const%20execution%3Dtarget%3D%3D%3D%27JavaScript%27%3FspawnSync%28process.execPath%2C%5Bpath%5D%2C%7Bcwd%3Aroot%2Ctimeout%3A1000%2CmaxBuffer%3A1024%2A1024%7D%29%0A%20%20%20%20%20%20%20%20%20%20%3Acompilation.status%3D%3D%3D0%3FspawnSync%28binary%2C%5B%5D%2C%7Bcwd%3Aroot%2Ctimeout%3A1000%2CmaxBuffer%3A1024%2A1024%7D%29%3Anull%3B%0A%20%20%20%20%20%20%20%20assert.deepEqual%28readFileSync%28path%29%2Cbytes%2C%27the%20entire%20actual%20compiler%2Finterpreter%20source%20remains%20unchanged%27%29%3B%0A%20%20%20%20%20%20%20%20const%20observation%3D%7Btarget%2Csource%3A%7Bpath%2C...pin%28bytes%29%7D%2Ccompilation%3Acompilation%3FprocessObservation%28compilation%29%3Anull%2C%0A%20%20%20%20%20%20%20%20%20%20execution%3Aexecution%3FprocessObservation%28execution%29%3Anull%2CexpectedStdoutHex%3Aexpected.toString%28%27hex%27%29%7D%3B%0A%20%20%20%20%20%20%20%20report.observations.push%28observation%29%3B%0A%20%20%20%20%20%20%20%20if%28compilation%26%26compilation.status%21%3D%3D0%7C%