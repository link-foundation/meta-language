%20%20%20%20%20%20%28Z.shiftl%20%2810%20%5E%20Z.max%20q%200%29%20%28Z.max%20%28-%20sh%29%200%29%29.%0A%28%2A%20With%20p%20significant%20digits%3A%20the%20candidate%20in%20the%20rounding%20interval%20nearest%0A%20%20%20to%20the%20value%20%28the%20even%20one%20on%20a%20tie%29%2C%20as%20%28digits%2C%20exponent%29.%20%2A%29%0ADefinition%20ml_js_candidate%20%28p%20e10%20v%20lo%20hi%20sh%20%3A%20Z%29%20%28inclusive%20%3A%20bool%29%20%3A%20option%20%28Z%20%2A%20Z%29%20%3A%3D%0A%20%20let%20q%20%3A%3D%20%28e10%20-%20p%20%2B%201%29%25Z%20in%0A%20%20let%20c%20%3A%3D%20ml_js_floor%20v%20q%20sh%20in%0A%20%20let%20inside%20%28c%20%3A%20Z%29%20%3A%3D%0A%20%20%20%20andb%20%28match%20ml_js_cmp%20c%20q%20lo%20sh%20with%20Gt%20%3D%3E%20true%20%7C%20Eq%20%3D%3E%20inclusive%20%7C%20Lt%20%3D%3E%20false%20end%29%0A%20%20%20%20%20%20%20%20%20%28match%20ml_js_cmp%20c%20q%20hi%20sh%20with%20Lt%20%3D%3E%20true%20%7C%20Eq%20%3D%3E%20inclusive%20%7C%20Gt%20%3D%3E%20false%20end%29%20in%0A%20%20let%20low%20%3A%3D%20inside%20c%20in%0A%20%20let%20high%20%3A%3D%20inside%20%28c%20%2B%201%29%25Z%20in%0A%20%20if%20andb%20low%20high%20then%0A%20%20%20%20match%20ml_js_cmp%20%282%20%2A%20c%20%2B%201%29%20q%20%282%20%2A%20v%29%20sh%20with%0A%20%20%20%20%7C%20Gt%20%3D%3E%20Some%20%28c%2C%20q%29%20%7C%20Lt%20%3D%3E%20Some%20%28%28c%20%2B%201%29%25Z%2C%20q%29%20%7C%20Eq%20%3D%3E%20Some%20%28if%20Z.even%20c%20then%20c%20else%20%28c%20%2B%201%29%25Z%2C%20q%29%0A%20%20%20%20end%0A%20%20else%20if%20low%20then%20Some%20%28c%2C%20q%29%20else%20if%20high%20then%20Some%20%28%28c%20%2B%201%29%25Z%2C%20q%29%20else%20None.%0A%28%2A%20A%20candidate%20with%20p%20digits%20is%20one%20with%20p%20%2B%201%20digits%20too%2C%20so%20the%20fewest%0A%20%20%20digits%20are%20found%20by%20bisection%20over%20%5Bfirst%2C%20last%5D%3B%2017%20always%20suffice.%20%2A%29%0AFixpoint%20ml_js_fewest%20%28fuel%20%3A%20nat%29%20%28first%20last%20e10%20v%20lo%20hi%20sh%20%3A%20Z%29%20%28inclusive%20%3A%20bool%29%20%3A%20Z%20%2A%20Z%20%3A%3D%0A%20