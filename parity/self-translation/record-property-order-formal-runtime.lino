(19: (meta: (t: semantic) (n: 1) (term: string%20value) (def: --%20Translated%20from%20JavaScript%20by%20meta-language%3A%20portable%20core%2C%20Lean%20target.%0A--%20Source%20binders%20are%20kept%20even%20where%20unused%20or%20named%20like%20a%20constructor%2C%20and%20proof%20hints%20are%20shared%20by%20every%20closing%20tactic.%0Aset_option%20linter.unusedVariables%20false%0Aset_option%20linter.unusedSimpArgs%20false%0Aset_option%20linter.constructorNameAsVariable%20false%0A%0A%2F--%20ECMAScript%20Number%3A%3AtoString%3A%20the%20shortest%20decimal%20that%20reads%20back%20as%20the%0Avalue%2C%20the%20nearer%20one%20and%20then%20the%20even%20one%20on%20a%20tie%2C%20laid%20out%20as%20JavaScript%0Aprints%20it%3B%20exact%20Nat%20arithmetic%20on%20the%20bits.%20-%2F%0Adef%20ml_js_layout%20%28digits%20%3A%20List%20Char%29%20%28n%20%3A%20Int%29%20%3A%20String%20%3A%3D%0A%20%20let%20k%20%3A%20Int%20%3A%3D%20digits.length%0A%20%20let%20text%20%3A%3D%20String.ofList%0A%20%20let%20zeros%20%28count%20%3A%20Int%29%20%3A%3D%20List.replicate%20count.toNat%20%270%27%0A%20%20if%20k%20%E2%89%A4%20n%20%E2%88%A7%20n%20%E2%89%A4%2021%20then%20text%20%28digits%20%2B%2B%20zeros%20%28n%20-%20k%29%29%0A%20%20else%20if%200%20%3C%20n%20%E2%88%A7%20n%20%E2%89%A4%2021%20then%20text%20%28digits.take%20n.toNat%20%2B%2B%20%27.%27%20%3A%3A%20digits.drop%20n.toNat%29%0A%20%20else%20if%20-6%20%3C%20n%20%E2%88%A7%20n%20%E2%89%A4%200%20then%20text%20%28%270%27%20%3A%3A%20%27.%27%20%3A%3A%20zeros%20%28-n%29%20%2B%2B%20digits%29%0A%20%20else%0A%20%20%20%20let%20e%20%3A%3D%20n%20-%201%0A%20%20%20%20let%20exp%20%3A%3D%20%28if%20e%20%3C%200%20then%20%22e-%22%20else%20%22e%2B%22%29%20%2B%2B%20toString%20e.natAbs%0A%20%20%20%20if%20k%20%3D%3D%201%20then%20text%20digits%20%2B%2B%20exp%0A%20%20%20%20else%20text%20%28digits.take%201%20%2B%2B%20%27.%27%20%3A%3A%20digits.drop%201%29%20%2B%2B%20exp%0A%0A%2F--%20%60c%20%C2%B7%2010%5Eq%60%20compared%20with%20%60x%20%C2%B7%20s%20%2F%20d%60.%20-%2F%0Adef%20ml_js_cmp%20%28c%20%3A%20Nat%29%20%28q%20%3A%20Int%29%20%28x%20s%20d%20%3A%20Nat%29%20%3A%20Ordering%20%3A%3D%0A%20%20if%200%20%E2%89%A4%20q%20then%20compare%20%28c%20%2A%2010%20%5E%20q.toNat%20%2A%20d%29%20%28x%20%2A%20s%29%0A%20%20else%20compare%20%28c%20%2A%20d%29%20%28x%20%2A%20s%20%2A%2010%20%5E%20%28-q%29.toNat%29%0A%0Adef%20ml_js_shortest%20%28m%20%3A%20Nat%29%20%28e%20%3A%20Int%29%20%28lowerCloser%20%3A%20Bool%29%20%3A%20String%20%3A%3D%0A%20%20--%20The%20value%20is%204m%20and%20the%20rounding%20interval%20%5Blo%2C%20hi%5D%2C%20in%20units%20of%202%5E%28e-2%29%20%3D%20s%20%2F%20d.%0A%20%20let%20s%20%3A%3D%202%20%5E%20%28e%20-%202%29.toNat%0A%20%20let%20d%20%3A%3D%202%20%5E%20%282%20-%20e%29.toNat%0A%20%20let%20v%20%3A%3D%204%20%2A%20m%0A%20%20let%20lo%20%3A%3D%20if%20lowerCloser%20then%20v%20-%201%20else%20v%20-%202%0A%20%20let%20hi%20%3A%3D%20v%20%2B%202%0A%20%20let%20inclusive%20%3A%3D%20m%20%25%202%20%3D%3D%200%0A%20%20let%20above%20%28c%20%3A%20Nat%29%20%28q%20%3A%20Int%29%20%3A%20Bool%20%3A%3D%0A%20%20%20%20match%20ml_js_cmp%20c%20q%20lo%20s%20d%20with%0A%20%20%20%20%7C%20.gt%20%3D%3E%20true%20%7C%20.eq%20%3D%3E%20inclusive%20%7C%20.lt%20%3D%3E%20false%0A%20%20let%20below%20%28c%20%3A%20Nat%29%20%28q%20%3A%20Int%29%20%3A%20Bool%20%3A%3D%0A%20%20%20%20match%20ml_js_cmp%20c%20q%20hi%20s%20d%20with%0A%20%20%20%20%7C%20.lt%20%3D%3E%20true%20%7C%20.eq%20%3D%3E%20inclusive%20%7C%20.gt%20%3D%3E%20false%0A%20%20--%20floor%20%28log10%20value%29%20from%20the%20bit%20length%2C%20then%20corrected%20exactly%0A%20%20let%20bits%20%3A%20Int%20%3A%3D%20%28Nat.log2%20m%20%3A%20Int%29%20%2B%201%20%2B%20e%0A%20%20let%20guess%20%3A%20Int%20%3A%3D%20Int.fdiv%20%28%28bits%20-%201%29%20%2A%2078913%29%20262144%0A%20%20let%20e10%20%3A%3D%0A%20%20%20%20if%20ml_js_cmp%201%20%28guess%20%2B%201%29%20v%20s%20d%20%21%3D%20.gt%20then%20guess%20%2B%201%0A%20%20%20%20else%20if%20ml_js_cmp%201%20guess%20v%20s%20d%20%3D%3D%20.gt%20then%20guess%20-%201%0A%20%20%20%20else%20guess%0A%20%20let%20rec%20search%20%28fuel%20%3A%20Nat%29%20%28p%20%3A%20Nat%29%20%3A%20String%20%3A%3D%0A%20%20%20%20match%20fuel%20with%0A%20%20%20%20%7C%200%20%3D%3E%20%22%22%0A%20%20%20%20%7C%20fuel%20%2B%201%20%3D%3E%0A%20%20%20%20%20%20let%20q%20%3A%20Int%20%3A%3D%20e10%20-%20p%20%2B%201%0A%20%20%20%20%20%20let%20c%20%3A%3D%0A%20%20%20%20%20%20%20%20if%200%20%E2%89%A4%20q%20then%20v%20%2A%20s%20%2F%20%28d%20%2A%2010%20%5E%20q.toNat%29%0A%20%20%20%20%20%20%20%20else%20v%20%2A%20s%20%2A%2010%20%5E%20%28-q%29.toNat%20%2F%20d%0A%20%20%20%20%20%20let%20lowOk%20%3A%3D%20above%20c%20q%20%E2%88%A7%20below%20c%20q%0A%20%20%20%20%20%20let%20highOk%20%3A%3D%20above%20%28c%20%2B%201%29%20q%20%E2%88%A7%20below%20%28c%20%2B%201%29%20q%0A%20%20%20%20%20%20if%20lowOk%20%E2%88%A8%20highOk%20then%0A%20%20%20%20%20%20%20%20let%20pick%20%3A%3D%0A%20%20%20%20%20%20%20%20%20%20if%20lowOk%20%E2%88%A7%20highOk%20then%0A%20%20%20%20%20%20%20%20%20%20%20%20match%20ml_js_cmp%20%282%20%2A%20c%20%2B%201%29%20q%20%282%20%2A%20v%29%20s%20d%20with%0A%20%20%20%20%20%20%20%20%20%20%20%20%7C%20.gt%20%3D%3E%20c%20%7C%20.lt%20%3D%3E%20c%20%2B%201%20%7C%20.eq%20%3D%3E%20if%20c%20%25%202%20%3D%3D%200%20then%20c%20else%20c%20%2B%201%0A%20%20%20%20%20%20%20%20%20%20else%20if%20lowOk%20then%20c%20else%20c%20%2B%201%0A%20%20%20%20%20%20%20%20let%20text%20%3A%3D%20%28toString%20pick%29.toList%0A%20%20%20%20%20%20%20%20let%20n%20%3A%20Int%20%3A%3D%20q%20%2B%20text.length%0A%20%20%20%20%20%20%20%20ml_js_layout%20%28text.reverse.dropWhile%20%28%C2%B7%20%3D%3D%20%270%27%29%29.reverse%20n%0A%20%20%20%20%20%20else%20search%20fuel%20%28p%20%2B%201%29%0A%20%20search%2017%201%0A%0Adef%20ml_js_number%20%28x%20%3A%20Float%29%20%3A%20String%20%3A%3D%0A%20%20let%20bits%20%3A%20Nat%20%3A%3D%20x.toBits.toNat%0A%20%20let%20negative%20%3A%3D%20bits%20%E2%89%A5%202%20%5E%2063%0A%20%20let%20exponent%20%3A%20Nat%20%3A%3D%20%28bits%20%2F%202%20%5E%2052%29%20%25%202048%0A%20%20let%20fraction%20%3A%20Nat%20%3A%3D%20bits%20%25%202%20%5E%2052%0A%20%20if%20exponent%20%3D%3D%202047%20then%0A%20%20%20%20if%20fraction%20%21%3D%200%20then%20%22NaN%22%20else%20if%20negative%20then%20%22-Infinity%22%20else%20%22Infinity%22%0A%20%20else%20if%20exponent%20%3D%3D%200%20%E2%88%A7%20fraction%20%3D%3D%200%20then%20%220%22%0A%20%20else%0A%20%20%20%20let%20body%20%3A%3D%0A%20%20%20%20%20%20if%20exponent%20%3D%3D%200%20then%20ml_js_shortest%20fraction%20%28-1074%29%20false%0A%20%20%20%20%20%20else%20ml_js_shortest%20%28fraction%20%2B%202%20%5E%2052%29%20%28%28exponent%20%3A%20Int%29%20-%201075%29%20%28fraction%20%3D%3D%200%20%E2%88%A7%20exponent%20%3E%201%29%0A%20%20%20%20if%20negative%20then%20%22-%22%20%2B%2B%20body%20else%20body%0A%0A%2F--%20ECMAScript%20%60%25%60%20on%20binary64%20%28C%20fmod%29%3A%20the%20exact%20remainder%2C%20truncated%2C%20with%0Athe%20sign%20of%20the%20dividend%3B%20computed%20on%20the%20bits%2C%20so%20it%20is%20exact.%20-%2F%0Adef%20ml_float_rem%20%28x%20y%20%3A%20Float%29%20%3A%20Float%20%3A%3D%0A%20%20let%20decompose%20%28f%20%3A%20Float%29%20%3A%20Nat%20%C3%97%20Int%20%3A%3D%0A%20%20%20%20let%20b%20%3A%20Nat%20%3A%3D%20f.toBits.toNat%0A%20%20%20%20let%20exponent%20%3A%20Nat%20%3A%3D%20%28b%20%2F%202%20%5E%2052%29%20%25%202048%0A%20%20%20%20let%20fraction%20%3A%20Nat%20%3A%3D%20b%20%25%202%20%5E%2052%0A%20%20%20%20if%20exponent%20%3D%3D%200%20then%20%28fraction%2C%20-1074%29%20else%20%28fraction%20%2B%202%20%5E%2052%2C%20%28exponent%20%3A%20Int%29%20-%201075%29%0A%20%20if%20x.isNaN%20%7C%7C%20y.isNaN%20%7C%7C%20x.isInf%20%7C%7C%20y%20%3D%3D%200%20then%200%20%2F%200%0A%20%20else%20if%20y.isInf%20%7C%7C%20x%20%3D%3D%200%20then%20x%0A%20%20else%0A%20%20%20%20let%20%28mx%2C%20ex%29%20%3A%3D%20decompose%20x%0A%20%20%20%20let%20%28my%2C%20ey%29%20%3A%3D%20decompose%20y%0A%20%20%20%20let%20e%20%3A%3D%20min%20ex%20ey%0A%20%20%20%20let%20r%20%3A%3D%20%28mx%20%2A%202%20%5E%20%28ex%20-%20e%29.toNat%29%20%25%20%28my%20%2A%202%20%5E%20%28ey%20-%20e%29.toNat%29%0A%20%20%20%20let%20magnitude%20%3A%3D%20Float.scaleB%20%2