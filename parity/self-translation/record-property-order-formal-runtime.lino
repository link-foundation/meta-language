xponent%20%3D%3D%202047%20then%0A%20%20%20%20if%20fraction%20%21%3D%200%20then%20%22NaN%22%20else%20if%20negative%20then%20%22-Infinity%22%20else%20%22Infinity%22%0A%20%20else%20if%20exponent%20%3D%3D%200%20%E2%88%A7%20fraction%20%3D%3D%200%20then%20%220%22%0A%20%20else%0A%20%20%20%20let%20body%20%3A%3D%0A%20%20%20%20%20%20if%20exponent%20%3D%3D%200%20then%20ml_js_shortest%20fraction%20%28-1074%29%20false%0A%20%20%20%20%20%20else%20ml_js_shortest%20%28fraction%20%2B%202%20%5E%2052%29%20%28%28exponent%20%3A%20Int%29%20-%201075%29%20%28fraction%20%3D%3D%200%20%E2%88%A7%20exponent%20%3E%201%29%0A%20%20%20%20if%20negative%20then%20%22-%22%20%2B%2B%20body%20else%20body%0A%0A%2F--%20ECMAScript%20%60%25%60%20on%20binary64%20%28C%20fmod%29%3A%20the%20exact%20remainder%2C%20truncated%2C%20with%0Athe%20sign%20of%20the%20dividend%3B%20computed%20on%20the%20bits%2C%20so%20it%20is%20exact.%20-%2F%0Adef%20ml_float_rem%20%28x%20y%20%3A%20Float%29%20%3A%20Float%20%3A%3D%0A%20%20let%20decompose%20%28f%20%3A%20Float%29%20%3A%20Nat%20%C3%97%20Int%20%3A%3D%0A%20%20%20%20let%20b%20%3A%20Nat%20%3A%3D%20f.toBits.toNat%0A%20%20%20%20let%20exponent%20%3A%20Nat%20%3A%3D%20%28b%20%2F%202%20%5E%2052%29%20%25%202048%0A%20%20%20%20let%20fraction%20%3A%20Nat%20%3A%3D%20b%20%25%202%20%5E%2052%0A%20%20%20%20if%20exponent%20%3D%3D%200%20then%20%28fraction%2C%20-1074%29%20else%20%28fraction%20%2B%202%20%5E%2052%2C%20%28exponent%20%3A%20Int%29%20-%201075%29%0A%20%20if%20x.isNaN%20%7C%7C%20y.isNaN%20%7C%7C%20x.isInf%20%7C%7C%20y%20%3D%3D%200%20then%200%20%2F%200%0A%20%20else%20if%20y.isInf%20%7C%7C%20x%20%3D%3D%200%20then%20x%0A%20%20else%0A%20%20%20%20let%20%28mx%2C%20ex%29%20%3A%3D%20decompose%20x%0A%20%20%20%20let%20%28my%2C%20ey%29%20%3A%3D%20decompose%20y%0A%20%20%20%20let%20e%20%3A%3D%20min%20ex%20ey%0A%20%20%20%20let%20r%20%3A%3D%20%28mx%20%2A%202%20%5E%20%28ex%20-%20e%29.toNat%29%20%25%20%28my%20%2A%202%20%5E%20%28ey%20-%20e%29.toNat%29%0A%20%20%20%20let%20magnitude%20%3A%3D%20Float.scaleB%20%2