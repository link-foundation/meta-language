(1577: (meta: (t: semantic) (n: 1) (term: string%20value) (def: From%20Stdlib%20Require%20Import%20NArith%20ZArith%20Lia%20Recdef%20String%20List%20Ascii%20Floats.%0AFrom%20Stdlib%20Require%20Import%20NArith%20ZArith%20Lia%20Recdef%20String%20List%20Ascii%20Floats.%0AModule%20MLRecordPropertyOrder.%0A%28%2A%20Translated%20from%20JavaScript%20by%20meta-language%3A%20portable%20core%2C%20Rocq%20target.%20%2A%29%0ASet%20Warnings%20%22-inexact-float%22.%0A%0AFixpoint%20ml_digits%20%28fuel%20%3A%20nat%29%20%28n%20%3A%20N%29%20%28acc%20%3A%20string%29%20%3A%20string%20%3A%3D%0A%20%20match%20fuel%20with%0A%20%20%7C%20O%20%3D%3E%20acc%0A%20%20%7C%20S%20rest%20%3D%3E%0A%20%20%20%20%20%20let%20acc%27%20%3A%3D%20String%20%28ascii_of_N%20%2848%20%2B%20N.modulo%20n%2010%29%29%20acc%20in%0A%20%20%20%20%20%20if%20N.ltb%20n%2010%20then%20acc%27%20else%20ml_digits%20rest%20%28N.div%20n%2010%29%20acc%27%0A%20%20end.%0ADefinition%20ml_N_to_string%20%28n%20%3A%20N%29%20%3A%20string%20%3A%3D%20ml_digits%20%28S%20%28N.size_nat%20n%29%29%20n%20EmptyString.%0A%0A%28%2A%20ECMAScript%20Number%3A%3AtoString%20for%20binary64%3A%20the%20shortest%20decimal%20that%20rounds%0A%20%20%20back%20to%20the%20value%20%28the%20nearest%20one%2C%20the%20even%20one%20on%20a%20tie%29%2C%20laid%20out%20as%0A%20%20%20JavaScript%20prints%20it.%20Exact%20Z%20arithmetic%20on%20the%20decomposed%20float.%20%2A%29%0AFixpoint%20ml_js_zeros%20%28n%20%3A%20nat%29%20%3A%20string%20%3A%3D%0A%20%20match%20n%20with%20O%20%3D%3E%20EmptyString%20%7C%20S%20k%20%3D%3E%20String%20%220%22%25char%20%28ml_js_zeros%20k%29%20end.%0AFixpoint%20ml_js_trim%20%28s%20%3A%20string%29%20%3A%20string%20%3A%3D%0A%20%20match%20s%20with%0A%20%20%7C%20EmptyString%20%3D%3E%20EmptyString%0A%20%20%7C%20String%20c%20rest%20%3D%3E%0A%20%20%20%20%20%20let%20r%20%3A%3D%20ml_js_trim%20rest%20in%0A%20%20%20%20%20%20if%20andb%20%28Ascii.eqb%20c%20%220%22%25char%29%20%28String.eqb%20r%20EmptyString%29%20then%20EmptyString%20else%20String%20c%20r%0A%20%20en