ys%28value%29.sort%28%29%2Ckeys.slice%28%29.sort%28%29%29%3B%7D%3B%0Alet%20cached%3B%0A%0A%2F%2A%2A%20Detached%20exact%20source%20anchors%3B%20no%20identity%20is%20inferred%20from%20equal%20names%20or%20samples.%20%2A%2F%0Aexport%20function%20readOwnCodebaseRawDescriptorPolicy%28%29%7Breturn%7B...structuredClone%28policy%29%2Cboundary%7D%3B%7D%0A%0A%2F%2A%2A%20Apply%20and%20invert%20the%20one%20finite%20whole-source%20interval%2C%20preserving%20every%20byte.%20%2A%2F%0Aexport%20function%20deriveOwnCodebaseRawDescriptorSource%28row%2Csource%29%7B%0A%20%20assert.equal%28typeof%20source%2C%27string%27%29%3Bassert.deepEqual%28pin%28source%29%2Crow.predecessor%29%3B%0A%20%20let%20current%3DBuffer.from%28source%29%3B%0A%20%20for%28const%20edit%20of%20row.edits.toReversed%28%29%29%7B%0A%20%20%20%20assert.equal%28current.subarray%28edit.start%2Cedit.end%29.toString%28%27utf8%27%29%2Cedit.previousText%29%3B%0A%20%20%20%20current%3DBuffer.concat%28%5Bcurrent.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.currentText%29%2Ccurrent.subarray%28edit.end%29%5D%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28pin%28current%29%2Crow.current%29%3B%0A%20%20let%20inverse%3Dcurrent%3B%0A%20%20for%28const%20edit%20of%20row.edits.toReversed%28%29%29%7B%0A%20%20%20%20assert.equal%28inverse.subarray%28edit.currentStart%2Cedit.currentEnd%29.toString%28%27utf8%27%29%2Cedit.currentText%29%3B%0A%20%20%20%20inverse%3DBuffer.concat%28%5Binverse.subarray%280%2Cedit.currentStart%29%2CBuffer.from%28edit.previousText%29%2Cinverse.subarray%28edit.currentEnd%29%5D%29%3B%0A%20%20%7D%0A%20%20assert.equal%28inverse.toString%28%27utf8%27%29%2Csource%2C%27every%20original%20source%20byte%20and%20historical%20assertion%20is%20retained%27%29%3B%0A%20%20return%20current.toString%28%27utf8%27%29%3B%0A%7D%0A%0Afunction%20capture%28row%2Cexpected%2Cextra%3D%5B%5D%29%7B%0A%20%20exactKeys%28row%2C%5B%27file%27%2C%27commit%27%2C%27bytes%27%2C%27sha256%27%2C%27sourceText%27%2C%27certificate%27%2C%27current%27%2C...extr