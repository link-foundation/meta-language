(154: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadJavaScriptSemanticValueError%2CtestJavaScriptSemanticSameValue%7D%20from%20%27.%2Fjavascript-semantic-values.js%27%3B%0Aimport%20%7BcreateJavaScriptPropertyDescriptor%2CtestCompleteJavaScriptPropertyDescriptor%2CplanJavaScriptPropertyDefinition%7D%20from%20%27.%2Fjavascript-property-descriptors.js%27%3B%0Aimport%20%7BreadJavaScriptLiteralPropertyIndex%7D%20from%20%27.%2Fjavascript-literal-property-rules.js%27%3B%0A%0A%2F%2A%2A%20An%20ordered%20property%20list%20preserves%20creation%20order%20independently%20of%20lookup.%0A%20%2A%20Keys%20are%20actual%20UTF16%20text%20or%20globally%20identified%20Symbols%2C%20never%20coerced%20here.%0A%20%2A%20%40typedef%20%7B%7B%24%3A%27ordinaryProperty%27%2Ckey%3AJavaScriptSemanticValue%2Cdescriptor%3AJavaScriptPropertyDescriptor%7D%7D%20JavaScriptOrdinaryProperty%0A%20%2A%2F%0A%2F%2A%2A%20%40typedef%20%7B%7B%24%3A%27ordinaryObject%27%2Cidentity%3Abigint%2Cprototype%3AJavaScriptSemanticValue%2Cextensible%3Aboolean%2C%0A%20%2A%20callable%3Aboolean%2Cproperties%3AJavaScriptOrdinaryProperty%5B%5D%7D%7D%20JavaScriptOrdinaryObject%0A%20%2A%2F%0A%2F%2A%2A%20Objects%20and%20Symbols%20share%20one%20strictly%20ordered%20unsigned64%20identity%20space.%0A%20%2A%20Functional%20snapshots%20are%20semantic%20states.%20A%20frontend%20must%20keep%20the%20selected%0A%20%2A%20state%20in%20one%20shared%20cell%20so%20all%20aliases%20observe%20the%20same%20transition.%0A%20%2A%20Nominal%20definitions%20keep%20recursive%20source%20types%20shared%20rather%20than%20repeatedly%0A%20%2A%20expanding%20structural%20records%20along%20every%20typed%20expression%20occurrence.%0A%20%2A%20%40typedef%20%7B%7B%24%3A%27ordinaryHeap%27%2Cobjects%3AJavaScriptOrdinaryObject%5B%5D%2Csymbols%3Abigint%5B%5D%7D%7D%20JavaScriptOrdinaryHeap%0A%20%2A%2F%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptOrdinaryObject%5B%5D%7D%20objects%20%40param%20%7Bbigint%7D%20identity%20%40returns%20%7Bnumber%7D%20%2A%2F%