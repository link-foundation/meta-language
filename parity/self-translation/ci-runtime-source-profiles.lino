(204: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20check-only%20source%20adapters%20for%20immutable%20schema%20authoring%20commands.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0A%0Aexport%20const%20SCHEMA_COMMAND_SOURCE_PROFILE%3DObject.freeze%28%7B%0A%20%20revision%3A%2790636f9fb52b1b9095defbac041c8089608b8576%27%2C%0A%20%20archive%3A%27parity%2Fself-translation%2Fschema-command-source-profile.lino%27%2C%0A%20%20sourceGate%3A%27js%2Fscripts%2Fcheck-bulk-translation-rules.mjs%27%2C%0A%20%20files%3AObject.freeze%28%5B%27js%2Fscripts%2Fextend-typed-program-schema-second-stage.mjs%27%2C%27js%2Fscripts%2Fextend-typed-program-schema-sixth-stage.mjs%27%5D%29%2C%0A%20%20nodeRange%3A%27%3E%3D24.0.0%20%3C25.0.0%27%2C%0A%7D%29%3B%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20pin%3Dvalue%3D%3E%28%7Bbytes%3ABuffer.byteLength%28value%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%7D%29%3B%0Alet%20sources%3B%0A%0A%2F%2A%2A%20The%20complete%20original%20scripts%20remain%20independently%20pinned%20Git%20objects.%20%2A%2F%0Aexport%20function%20readSchemaCommandSourceProfile%28file%29%20%7B%0A%20%20const%20specification%3DSCHEMA_COMMAND_SOURCE_PROFILE%3Bassert.ok%28specification.files.includes%28file%29%2C%27registered%20schema%20command%20source%20required%27%29%3B%0A%20%20if%28%21sources%29%7B%0A%20%20%20%20const%20packet%3DreadProjectData%28new%20URL%28specification.archive%2Croot%29%29%3B%0A%20%20%20%20assert.equal%28packet.schemaVersion%2C1%29%3Bassert.equal%28packet.revision%2Cspecification.revision%29%3B%0A%20%20%20%20assert.deepEqual%28packet.sources.map%28row%3D%3Erow.file%29%2Cspecification.files%29%3B%0A%20%20%20%20const%20checked%3Dnew%20Map%28%29%3B%0A%20%20%20%20for%28const%20row%20of%20packet.sources%29%7B%0A%20%20%20%20%20%20const%20bytes%3DBuffer.from%28row.source%29%3Bassert.ok%28bytes.length%3C%3D131072%29%3B%0A%20%20%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2Cbytes%2C%7Brevision%3Aspecification.revision%2Cpath%3Arow.file%7D%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28bytes%29%2Crow.original%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28row.view%2CderiveSchemaCommandSourceView%28row.file%2Crow.source%2Crow.certificate%29.receipt%29%3B%0A%20%20%20%20%20%20checked.set%28row.file%2Crow%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20sources%3Dchecked%3B%0A%20%20%7D%0A%20%20return%20structuredClone%28sources.get%28file%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Only%20the%20schema%20read%20and%20its%20explicit%20validating%20import%20change.%20Every%20other%0A%20%2A%20original%20source%20byte%2C%20assertion%2C%20immutable%20source%20owner%20and%20refusal%20remains.%20%2A%2F%0Aexport%20function%20deriveSchemaCommandSourceView%28file%2Csource%2Ccertificate%29%20%7B%0A%20%20assert.ok%28SCHEMA_COMMAND_SOURCE_PROFILE.files.includes%28file%29%29%3Bassert.equal%28typeof%20source%2C%27string%27%29%3Bassert.ok%28Buffer.byteLength%28source%29%3C%3D131072%29%3B%0A%20%20verifyGitArtifactCertificate%28certificate%2CBuffer.from%28source%29%2C%7Brevision%3ASCHEMA_COMMAND_SOURCE_PROFILE.revision%2Cpath%3Afile%7D%29%3B%0A%20%20const%20anchor%3D%22import%20%7BreadStructuredDataLino%7D%20from%20%27..%2Fsrc%2Fstructured-data-links.js%27%3B%5Cn%22%3B%0A%20%20const%20addition%3D%22import%20%7BreadStringOrderSchemaPredecessor%7D%20from%20%27.%2Fcheck-typed-program-schema-history.mjs%27%3B%5Cn%22%3B%0A%20%20const%20second%3Dfile%3D%3D%3DSCHEMA_COMMAND_SOURCE_PROFILE.files%5B0%5D%3B%0A%20%20const%20actions%3D%5B%7Bbefore%3Aanchor%2Cafter%3Aanchor%2Baddition%7D%2Csecond%3F%0A%20%20%20%20%7Bbefore%3A%27let%20actualBytes%20%3D%20readFileSync%28schemaFile%29%3B%27%2Cafter%3A%27let%20actualBytes%20%3D%20readStringOrderSchemaPredecessor%28%29%3B%27%7D%3A%0A%20%20%20%20%7Bbefore%3A%22const%20actualBytes%3DreadFileSync%28schemaFile%29%2Coracle%3DreadFileSync%28oracleFile%2C%27utf8%27%29%3B%22%2Cafter%3A%22const%20actualBytes%3DreadStringOrderSchemaPredecessor%28%29%2Coracle%3DreadFileSync%28oracleFile%2C%27utf8%27%29%3B%22%7D%5D%3B%0A%20%20let%20current%3Dsource%3B%0A%20%20for%28const%20action%20of%20actions%29%7Bassert.equal%28current.split%28action.before%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28action.before%2Caction.after%29%3B%7D%0A%20%20let%20inverse%3Dcurrent%3Bfor%28const%20action%20of%20actions.toReversed%28%29%29%7Bassert.equal%28inverse.split%28action.after%29.length%2C2%29%3Binverse%3Dinverse.replace%28action.after%2Caction.before%29%3B%7D%0A%20%20assert.equal%28inverse%2Csource%2C%27whole%20immutable%20schema%20command%20byte%20inverse%27%29%3B%0A%20%20return%7Bfile%2Csource%3Acurrent%2Creceipt%3A%7BschemaVersion%3A1%2Cprofile%3A%27authenticated%20predecessor%20schema%20command%20view%201%27%2Cfile%2C%0A%20%20%20%20revision%3ASCHEMA_COMMAND_SOURCE_PROFILE.revision%2CnodeRange%3ASCHEMA_COMMAND_SOURCE_PROFILE.nodeRange%2Coriginal%3Apin%28source%29%2Cexecuted%3Apin%28current%29%2Cactions%2C%0A%20%20%20%20input%3A%27The%20complete%20current%20JavaScript%20and%20Rust%20schemas%2C%20string-order%20model%2C%20generated%20declarations%20and%20fixtures%20pass%20the%20existing%20string-order%20generator%20before%20the%20original%20sixth%20schema%20bytes%20are%20supplied.%27%2C%0A%20%20%20%20inverseVerified%3Atrue%2Cboundary%3A%27Check-only%20source%20adaptation.%20Original%20command%20files%2C%20all%20receipts%2C%20schema%20bytes%20and%20assertions%20stay%20exact.%20No%20native%20compilation%20or%20execution%20evidence.%27%7D%7D%3B%0A%7D%0A%0Aexport%20function%20renderSchemaCommandSourceView%28file%2Csource%29%20%7B%0A%20%20const%20original%3DreadSchemaCommandSourceProfile%28file%29%3Bassert.equal%28source%2Coriginal.source%2C%27unknown%20immutable%20schema%20command%20edits%20refuse%27%29%3B%0A%20%20const%20result%3DderiveSchemaCommandSourceView%28file%2Csource%2Coriginal.certificate%29%3Bassert.deepEqual%28result.receipt%2Coriginal.view%29%3B%0A%20%20return%20result%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
