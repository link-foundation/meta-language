%20action%20of%20row.view.actions.toReversed%28%29%29inverse%3Dinverse.replace%28action.after%2Caction.before%29%3B%0A%20%20%20%20assert.equal%28inverse%2Crow.source%29%3Bassert.equal%28row.view.actions.length%2C2%29%3B%0A%20%20%20%20assert.deepEqual%28generated.source.match%28%2F%5Cbassert%5C.%5BA-Za-z%5D%2B%5C%28%2Fgu%29%2Crow.source.match%28%2F%5Cbassert%5C.%5BA-Za-z%5D%2B%5C%28%2Fgu%29%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErenderSchemaCommandSourceView%28row.file%2Crow.source%2B%27%5Cn%27%29%29%3B%0A%20%20%20%20const%20forged%3DstructuredClone%28row.certificate%29%3Bforged.path%3D%27js%2Fscripts%2Fcounterfeit.mjs%27%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EderiveSchemaCommandSourceView%28row.file%2Crow.source%2Cforged%29%29%3B%0A%20%20%20%20const%20returned%3DreadSchemaCommandSourceProfile%28row.file%29%3Breturned.view.actions%5B0%5D.after%2B%3D%27%20changed%27%3B%0A%20%20%20%20assert.deepEqual%28readSchemaCommandSourceProfile%28row.file%29%2Crow%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27the%20exact%20two%20original%20freshness%20commands%20pass%20with%20authenticated%20schema%20input%20views%20and%20preserve%20every%20source%20schema%20receipt%20and%20gate%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20checks%3DBULK_TRANSLATION_RULE_CHECKS.filter%28row%3D%3ESCHEMA_COMMAND_SOURCE_PROFILE.files.includes%28row.script%29%29%3B%0A%20%20assert.equal%28checks.length%2C2%29%3Bassert.equal%28BULK_TRANSLATION_RULE_CHECKS.length%2C35%29%3B%0A%20%20const%20files%3D%5B...SCHEMA_COMMAND_SOURCE_PROFILE.files%2C%27js%2Fsrc%2Fdata%2Ftyped-program-links-schema.lino%27%2C%27rust%2Fsrc%2Fdata%2Ftyped-program-links-schema.lino%27%2C%0A%20%20%20%20%27experiments%2Foriginal-link-complete-table-projection%2Fraw-native-observations.mjs%27%2C%0A%20%20%20%20...%5B%27source%27%2C%27extension%27%2C%27second-extension%27%2C%27third-extension%27%2C%27fourth-extension%27%2C%27fifth-extension%27%2C%27sixth-extension%27%5D.map%28stage%3D%3E%27experiments%2Foriginal-link-complete-table-projection%2Fdata%2Fraw-schema-%27%2B%28stage%3D%3D%3D%27source%27%3F%27source-closure%27%3Astage%3D%3D%3D%27extension%27%3F%27extension-closure%27%3Astage%2B%27-closure%27%29%2B%27.lino%27%29%5D%3B%0A%20%20const%20before%3Dfiles.map%28file%3D%3Epin%28readFileSync%28new%20URL%28file%2Cnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%29%29%29%29%2Ccalls%3D%5B%5D%3B%0A%20%20const%20result%3Dawait%20runBulkTranslationRuleChecks%28%7Bchecks%2Croot%2Creport%3A%28%29%3D%3E%7B%7D%2Cinvoke%3Aasync%28command%2Cargs%2Coptions%29%3D%3E%7B%0A%20%20%20%20calls.push%28%7Bcommand%2Cargs%2Coptions%7D%29%3B%0A%20%20%20%20const%20child%3DspawnSync%28command%2C%5B%27--max-old-space-size%3D288%27%2C%27--max-semi-space-size%3D4%27%2C...args%5D%2C%7B...options%2Cencoding%3A%27utf8%27%2Ctimeout%3A45000%2CmaxBuffer%3A262144%7D%29%3B%0A%20%20%20%20assert.equal%28child.error%2Cundefined%29%3Bassert.equal%28child.signal%2Cnull%29%3Bassert.equal%28child.status%2C0%2Cchild.stderr%2B%27%5Cn%27%2Bchild.stdout%29%3B%0A%20%20%20%20assert.match%28child.stderr%2C%2Fauthenticated%20current%20string-order%20model%20with%20original%20command%2Fu%29%3B%0A%20%20%20%20return%7BexitCode%3Achild.status%2Csignal%3Achild.signal%7D%3B%0A%20%20%7D%7D%29%3B%0A%20%20assert.deepEqual%28result%2C%7Bchecks%3A2%2Cfailures%3A%5B%5D%7D%29%3Bassert.equal%28calls.length%2C2%29%3B%0A%20%20for%28let%20index%3D0%3Bindex%3Ccalls.length%3Bindex%2B%2B%29%7B%0A%20%20%20%20assert.equal%28calls%5Bindex%5D.command%2Cprocess.execPath%29%3B%0A%20%20%20%20assert.equal%28calls%5Bindex%5D.args%5B0%5D%2CfileURLToPath%28new%20URL%28checks%5Bindex%5D.script%2Cnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%29%29%29%3B%0A%20%20%20%20assert.deepEqual%28calls%5Bindex%5D.args.slice%281%29%2C%5B%27--check%27%5D%29%3Bassert.match%28calls%5Bindex%5D.options.env.NODE_OPTIONS%2C%2Fschema-command-source-loader%5C.mjs%2Fu%29%3B%0A%20%20%7D%0A%20%20assert.deepEqual%28files.map%28file%3D%3Epin%28readFileSync%28new%20URL%28file%2Cnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%29%29%29%29%2Cbefore%29%3B%0A%7D%29%3B%0A%0Atest%28%27standalone%20immutable%20commands%20retain%20their%20strict%20live-successor%20refusals%20and%20the%20source%20loader%20refuses%20update%20arguments%27%2C%28%29%3D%3E%7B%0A%20%20for%28const%20file%20of%20SCHEMA_COMMAND_SOURCE_PROFILE.files%29%7B%0A%20%20%20%20const%20original%3DspawnSync%28process.execPath%2C%5B%27--max-old-space-size%3D288%27%2Cfile%2C%27--check%27%5D%2C%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2Ctimeout%3A15000%2CmaxBuffer%3A262144%7D%29%3B%0A%20%20%20%20assert.equal%28original.error%2Cundefined%29%3Bassert.equal%28original.signal%2Cnull%29%3Bassert.equal%28original.status%2C1%29%3Bassert.match%28original.stderr%2C%2F145652%20%21%3D%3D%20153938%2Fu%29%3B%0A%20%20%20%20const%20refused%3DspawnSync%28process.execPath%2C%5B%27--import%27%2CfileURLToPath%28new%20URL%28%27..%2Fscripts%2Fschema-command-source-loader.mjs%27%2Cimport.meta.url%29%29%2Cfile%2C%27--write%27%5D%2C%0A%20%20%20%20%20%20%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2Ctimeout%3A10000%2CmaxBuffer%3A262144%7D%29%3B%0A%20%20%20%20assert.equal%28refused.error%2Cundefined%29%3Bassert.equal%28refused.signal%2Cnull%29%3Bassert.equal%28refused.status%2C1%29%3Bassert.match%28refused.stderr%2C%2Fcheck-only%2Fu%29%3B%0A%20%20%7D%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
