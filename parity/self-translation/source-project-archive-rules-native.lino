(84: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadRequiredTextFact%2CreadRequiredNumberFact%7D%20from%20%27.%2Ftranslation%2Ffact-column-rules.js%27%3B%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20role%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readSourceProjectArchiveVocabulary%28role%29%7B%0A%20if%28role%3D%3D%3D%27model%27%29return%20%27complete%20source%20project%20concrete%20graphs%201%27%3B%0A%20if%28role%3D%3D%3D%27directory%27%29return%20%27meta-language%2Fsource-project%2Fdirectory%27%3B%0A%20if%28role%3D%3D%3D%27sourcePrefix%27%29return%20%27meta-language%2Fsource-project%2Fsource%2F%27%3B%0A%20if%28role%3D%3D%3D%27root%27%29return%20%27complete%20original%20source%20concrete%20roots%27%3B%0A%20return%20role%3D%3D%3D%27language%27%3F%27meta-language%20source%20project%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20Project-relative%20source%20identities%20are%20independent%20of%20host%20path%20syntax.%0A%20%2A%20%40param%20%7Bstring%7D%20path%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptSourceProjectPath%28path%29%7B%0A%20if%28path%3D%3D%3D%27%27%7C%7Cpath.startsWith%28%27%2F%27%29%7C%7Cpath.includes%28%27%5C%5C%27%29%7C%7Cpath.includes%28%27%5C0%27%29%7C%7Cpath.includes%28%27%3A%27%29%29return%20false%3B%0A%20for%28const%20part%20of%20path.split%28%27%2F%27%29%29if%28part%3D%3D%3D%27%27%7C%7Cpart%3D%3D%3D%27.%27%7C%7Cpart%3D%3D%3D%27..%27%29return%20false%3B%0A%20return%20true%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20projection%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptSourceProjectSyntaxProjection%28projection%29%7Breturn%20projection%3D%3D%3D%27ConcreteSyntax%27%7C%7Cprojection%3D%3D%3D%27AbstractSyntax%27%3B%7D%0A%2F%2A%2A%20Source%20roots%20are%20all%20actual%20Syntax%20nodes%20without%20an%20enclosing%20Syntax%20node.%0A%20%2A%20The%20archive%20retains%20every%20other%20node%2C%20including%20error%20and%20missing%20nodes.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20kinds%20%40param%20%7Bnumber%5B%5D%7D%20identifiers%20%40param%20%7Bnumber%5B%5D%7D%20firsts%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20counts%20%40param%20%7Bnumber%5B%5D%7D%20targets%20%40returns%20%7Bnumber%5B%5D%7D%20%2A%2F%0Aexport%20function%20selectSourceProjectSyntaxRootPositions%28kinds%2Cidentifiers%2Cfirsts%2Ccounts%2Ctargets%29%7B%0A%20if%28kinds.length%21%3D%3Didentifiers.length%7C%7Ckinds.length%21%3D%3Dfirsts.length%7C%7Ckinds.length%21%3D%3Dcounts.length%29throw%20new%20TypeError%28%27unaligned%20source%20project%20graph%20columns%27%29%3B%0A%20const%20nested%3D%5B%5D%3B%0A%20for%28let%20position%3D0%3Bposition%3Ckinds.length%3Bposition%2B%3D1%29%7B%0A%20%20if%28readRequiredTextFact%28kinds%2Cposition%29%21%3D%3D%27syntax%27%29continue%3B%0A%20%20const%20first%3DreadRequiredNumberFact%28firsts%2Cposition%29%2Ccount%3DreadRequiredNumberFact%28counts%2Cposition%29%3B%0A%20%20if%28%21Number.isSafeInteger%28first%29%7C%7C%21Number.isSafeInteger%28count%29%7C%7Cfirst%3C0%7C%7Ccount%3C0%7C%7Cfirst%2Bcount%3Etargets.length%29throw%20new%20TypeError%28%27invalid%20source%20project%20reference%20interval%27%29%3B%0A%20%20for%28let%20child%3D0%3Bchild%3Ccount%3Bchild%2B%3D1%29nested.push%28readRequiredNumberFact%28targets%2Cfirst%2Bchild%29%29%3B%0A%20%7D%0A%20const%20children%3Dnew%20Set%28nested%29%2Croots%3D%5B%5D%3B%0A%20for%28let%20position%3D0%3Bposition%3Ckinds.length%3Bposition%2B%3D1%29if%28readRequiredTextFact%28kinds%2Cposition%29%3D%3D%3D%27syntax%27%26%26%21children.has%28readRequiredNumberFact%28identifiers%2Cposition%29%29%29roots.push%28position%29%3B%0A%20return%20roots%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20value%20%40returns%20%7Bboolean%7D%20%2A%2F%0Afunction%20acceptSourceProjectDigest%28value%29%7B%0A%20if%28value.length%21%3D%3D64%29return%20false%3B%0A%20for%28let%20index%3D0%3Bindex%3Cvalue.length%3Bindex%2B%3D1%29if%28%21%270123456789abcdef%27.includes%28value.slice%28index%2Cindex%2B1%29%29%29return%20false%3B%0A%20return%20true%3B%0A%7D%0A%2F%2A%2A%20Complete%20supported%20directory%20admission%2C%20independent%20of%20a%20current%20catalog.%0A%20%2A%20Old%20archives%20retain%20their%20actual%20grammar%20provenance%20instead%20of%20redispatching.%0A%20%2A%20%40param%20%7Bstring%7D%20model%20%40param%20%7Bnumber%7D%20version%20%40param%20%7Bstring%7D%20projection%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20paths%20%40param%20%7Bstring%5B%5D%7D%20languages%20%40param%20%7Bstring%5B%5D%7D%20identifiers%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20bytes%20%40param%20%7Bstring%5B%5D%7D%20digests%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readSourceProjectDirectoryError%28model%2Cversion%2Cprojection%2Cpaths%2Clanguages%2Cidentifiers%2Cbytes%2Cdigests%29%7B%0A%20if%28model%21%3D%3DreadSourceProjectArchiveVocabulary%28%27model%27%29%7C%7Cversion%21%3D%3D1%7C%7C%21acceptSourceProjectSyntaxProjection%28projection%29%29return%20%27unknown%20source%20project%20directory%20model%27%3B%0A%20if%28paths.length%3D%3D%3D0%7C%7Clanguages.length%21%3D%3Dpaths.length%7C%7Cidentifiers.length%21%3D%3Dpaths.length%7C%7Cbytes.length%21%3D%3Dpaths.length%7C%7Cdigests.length%21%3D%3Dpaths.length%29return%20%27unaligned%20source%20project%20directory%27%3B%0A%20const%20names%3Dnew%20Set%28paths%29%3Bif%28names.size%21%3D%3Dpaths.length%29return%20%27duplicate%20source%20project%20path%27%3B%0A%20for%28let%20index%3D0%3Bindex%3Cpaths.length%3Bindex%2B%3D1%29%7B%0A%20%20const%20size%3DreadRequiredNumberFact%28bytes%2Cindex%29%2Cpath%3DreadRequiredTextFact%28paths%2Cindex%29%3B%0A%20%20if%28%21acceptSourceProjectPath%28path%29%7C%7CreadRequiredTextFact%28languages%2Cindex%29%3D%3D%3D%27%27%7C%7CreadRequiredTextFact%28identifiers%2Cindex%29%21%3D%3DreadSourceProjectArchiveVocabulary%28%27sourcePrefix%27%29%2Bpath%7C%7C%21Number.isSafeInteger%28size%29%7C%7Csize%3C0%7C%7C%21acceptSourceProjectDigest%28readRequiredTextFact%28digests%2Cindex%29%29%29return%20%27invalid%20source%20project%20directory%20entry%27%3B%0A%20%7D%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20Appending%20cannot%20silently%20replace%20an%20older%20source%20interpretation.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20existing%20%40param%20%7Bstring%5B%5D%7D%20added%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readSourceProjectExtensionError%28existing%2Cadded%29%7B%0A%20if%28added.length%3D%3D%3D0%29return%20%27expected%20a%20bounded%20nonempty%20source%20inventory%27%3B%0A%20const%20prior%3Dnew%20Set%28existing%29%2Cincoming%3Dnew%20Set%28added%29%3B%0A%20if%28incoming.size%21%3D%3Dadded.length%29return%20%27duplicate%20source%20project%20path%27%3B%0A%20for%28const%20path%20of%20added%29%7Bif%28%21acceptSourceProjectPath%28path%29%29return%20%27invalid%20original%20source%20input%27%3Bif%28prior.has%28path%29%29return%20%27source%20project%20extension%20cannot%20replace%20an%20existing%20source%27%3B%7D%0A%20return%20%27%27%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
