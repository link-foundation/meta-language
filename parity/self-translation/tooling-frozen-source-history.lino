(2975: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %20%20...rows%28%27automationFirstOwnCodebaseBaselineRequest%27%2C%20%27parity%2Fsources%2Fautomation-first-own-codebase-baseline-2026-10-21.txt%27%2C%20%27critical-conversation-requirements%27%2C%20%27workflow-contract%27%2C%20%5B%0A%20%20%20%20%5B%27I195-WORKFLOW-AUTOMATION-FIRST-COVERAGE%27%2C%20%27automated%20high%20coverage%20development%20with%20few%20actions%27%2C%0A%20%20%20%20%20%20%27Use%20as%20much%20automation%20as%20possible%20and%20prioritize%20general%20changes%20that%20cover%20many%20requirements%20and%20actual%20source%20constructs%20with%20the%20least%20actions%20and%20resources%2C%20targeting%20twenty%20percent%20effort%20for%20eighty%20percent%20results.%20Reuse%20existing%20source%20inventories%2C%20checked%20contexts%2C%20translation%20workers%20and%20reports.%20Retain%20every%20individual%20failure%2C%20source%20range%20and%20unresolved%20obligation%3B%20measured%20coverage%20and%20resource%20observations%20are%20required%20before%20claiming%20the%20target%20ratio.%27%2C%0A%20%20%20%20%20%20%5B%27existingAutomationReused%27%2C%20%27actualSourceFailuresGroupedWithoutLoss%27%2C%20%27highCoverageChangesPrioritized%27%2C%20%27resourceAndCoverageClaimsRequireObservations%27%5D%5D%2C%0A%20%20%20%20%5B%27I195-WORKFLOW-THREE-SUBAGENT-CURRENT-PHASE%27%2C%20%27up%20to%20three%20subagents%20for%20the%20current%20parallel%20implementation%20phase%27%2C%0A%20%20%20%20%20%20%27The%20current%20user%20instruction%20authorizes%20at%20most%20three%20subagents%20to%20speed%20useful%20independent%20work%20after%20the%20historical%20coordinator-only%20phase.%20Preserve%20clear%20source%20ownership%2C%20contributor%20commits%2C%20bounded%20resource%20use%20and%20one%20push%20coordinator%3B%20resource-heavy%20local%20checks%20and%20Git%20index%20writes%20remain%20serialized.%20Earlier%20phase%20instructions%20and%20all%20project%20obligations%20remain%20recorded.%27%2C%0A%20%20%20%20%20%20%5B%27activeSubagentCountAtMostThree%27%2C%20%27independentSourceOwnershipPreserved%27%2C%20%27contributorCommitsAndSinglePushRetained%27%2C%20%27localHeavyChecksSerialized%27%5D%5D%2C%0A%20%20%5D%2C%20true%29%2C%0A%20%20...rows%28%27automationFirstOwnCodebaseBaselineRequest%27%2C%20%27parity%2Fsources%2Fautomation-first-own-codebase-baseline-2026-10-21.txt%27%2C%20%27critical-conversation-requirements%27%2C%20%27translation-priority%27%2C%20%5B%0A%20%20%20%20%5B%27I195-TRANSLATION-OWN-CODEBASE-BASELINE%27%2C%20%27complete%20JavaScript%20Rust%20parsing%20emission%20and%20bidirectional%20translation%20as%20the%20first%20own-codebase%20baseline%27%2C%0A%20%20%20%20%20%20%27Deliver%20full%20JavaScript%20and%20Rust%20parsing%20and%20source%20emission%2C%20with%20complete%20concrete%20syntax%20by%20default%2C%20and%20translation%20between%20both%20languages%20for%20the%20real%20project%20codebase%20as%20the%20most%20critical%20end-to-end%20baseline.%20Validate%20complete%20source%20inventories%2C%20lossless%20source%20reconstruction%20and%20executable%20semantics%20independently%3B%20carried%20original%20source%2C%20registration%20or%20declarations%20do%20not%20establish%20semantic%20translation.%20Complete%20the%20remaining%20languages%20and%20capabilities%20after%20this%20baseline%20while%20preserving%20every%20inherited%20requirement.%27%2C%0A%20%20%20%20%20%20%5B%27javascriptRustCompleteParsingAndEmissionPrioritized%27%2C%20%27realOwnSourceInventoryExercised%27%2C%20%27bidirectionalExecutableTranslationChecked%27%2C%20%27defaultConcreteSyntaxAndLosslessSourceRetained%27%2C%20%27remainingScopePreserved%27%5D%5D%2C%0A%20%20%5D%29%2C%0A) (lang: meta-language%20structured%20data)))
