rs%20operands%20in%20their%20actual%20source%20domain%20and%20uses%20a%20guarded%0A%20%2A%20unsigned%20modular%20subtraction%3B%20its%20result%20always%20fits%20the%20complete%20uN%20range.%0A%20%2A%20No%20signed%20minimum%20is%20negated%20and%20no%20wider%20source%2Fhost%20integer%20is%20needed.%0A%20%2A%20%40param%20%7Bstring%7D%20method%20%40returns%20%7Bstring%5B%5D%7D%20%2A%2F%0Aexport%20function%20planRustIntegerMagnitude%28method%29%7B%0A%20if%28method%3D%3D%3D%27unsigned_abs%27%29return%20%5B%27operand%27%2C%27zero%27%2C%27lt%27%2C%27operand%27%2C%27positive%20unit%27%2C%27add%27%2C%27neg%27%2C%27unsigned%20cast%27%2C%27unsigned%20unit%27%2C%27add%27%2C%27operand%27%2C%27unsigned%20cast%27%2C%27if%27%5D%3B%0A%20if%28method%21%3D%3D%27abs_diff%27%29return%20%5B%5D%3B%0A%20const%20forward%3D%5B%27unsigned%20operand%27%2C%27unsigned%20right%27%2C%27lt%27%2C%27unsigned%20maximum%27%2C%27unsigned%20right%27%2C%27unsigned%20operand%27%2C%27sub%27%2C%27sub%27%2C%27unsigned%20unit%27%2C%27add%27%2C%27unsigned%20operand%27%2C%27unsigned%20right%27%2C%27sub%27%2C%27if%27%5D%3B%0A%20const%20backward%3D%5B%27unsigned%20right%27%2C%27unsigned%20operand%27%2C%27lt%27%2C%27unsigned%20maximum%27%2C%27unsigned%20operand%27%2C%27unsigned%20right%27%2C%27sub%27%2C%27sub%27%2C%27unsigned%20unit%27%2C%27add%27%2C%27unsigned%20right%27%2C%27unsigned%20operand%27%2C%27sub%27%2C%27if%27%5D%3B%0A%20return%20%5B%27operand%27%2C%27right%27%2C%27ge%27%5D.concat%28forward%2Cbackward%2C%5B%27if%27%5D%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
