(366: (meta: (t: semantic) (n: 1) (term: string%20value) (def: name%3A%20Rust%0A%0A%23%20.github%2Fworkflows%2Fci.yml%20calls%20this%20workflow%20on%20pushes%20to%20main%20and%20on%20pull%0A%23%20requests%20after%20the%20JavaScript%20workflow%20passes%2C%20so%20a%20JavaScript%20failure%20shows%0A%23%20every%20Rust%20job%20as%20skipped.%20A%20manual%20dispatch%20runs%20it%20standalone%20for%20releases.%0A%23%20The%20dispatch%20inputs%20are%20absent%20when%20called%3B%20the%20jobs%20that%20read%20them%20run%20only%0A%23%20on%20workflow_dispatch.%0Aon%3A%0A%20%20workflow_call%3A%0A%20%20%20%20inputs%3A%0A%20%20%20%20%20%20native_test_inputs_changed%3A%0A%20%20%20%20%20%20%20%20description%3A%20%27Registered%20native%20experiment%20or%20Links%20data%20changed%27%0A%20%20%20%20%20%20%20%20type%3A%20boolean%0A%20%20%20%20%20%20%20%20required%3A%20false%0A%20%20%20%20%20%20%20%20default%3A%20false%0A%20%20workflow_dispatch%3A%0A%20%20%20%20inputs%3A%0A%20%20%20%20%20%20release_mode%3A%0A%20%20%20%20%20%20%20%20description%3A%20%27Manual%20release%20mode%27%0A%20%20%20%20%20%20%20%20required%3A%20true%0A%20%20%20%20%20%20%20%20type%3A%20choice%0A%20%20%20%20%20%20%20%20default%3A%20%27instant%27%0A%20%20%20%20%20%20%20%20options%3A%0A%20%20%20%20%20%20%20%20%20%20-%20instant%0A%20%20%20%20%20%20%20%20%20%20-%20changelog-pr%0A%20%20%20%20%20%20bump_type%3A%0A%20%20%20%20%20%20%20%20description%3A%20%27Version%20bump%20type%27%0A%20%20%20%20%20%20%20%20required%3A%20true%0A%20%20%20%20%20%20%20%20type%3A%20choice%0A%20%20%20%20%20%20%20%20options%3A%0A%20%20%20%20%20%20%20%20%20%20-%20patch%0A%20%20%20%20%20%20%20%20%20%20-%20minor%0A%20%20%20%20%20%20%20%20%20%20-%20major%0A%20%20%20%20%20%20description%3A%0A%20%20%20%20%20%20%20%20description%3A%20%27Release%20description%20%28optional%29%27%0A%20%20%20%20%20%20%20%20required%3A%20false%0A%20%20%20%20%20%20%20%20type%3A%20string%0A%0A%23%20Least-privilege%20default%20for%20every%20job%3B%20jobs%20that%20need%20more%20escalate%20explicitly.%0Apermissions%3A%0A%20%20contents%3A%20read%0A%0A%23%20Pull%20request%20numbers%20identify%20update%20queues%2C%20including%20a%20late%20merged%20run.%20Push%2C%0A%23%20release%20and%20dispatch%20runs%20are%20grouped%20by%20their%20own%20run%20id%2C%20so%20they%20never%0A%23%20cancel%20each%20other%3B%20their%20write%20jobs%20queue%20in%20the%20release%20write%20group.%20The%0A%23%20group%20has%20its%20own%20literal%20prefix%3A%20called%20from%20ci.yml%2C%20github.workflow%20names%0A%23%20the%20caller%2C%20and%20a%20group%20equal%20to%20the%20caller%27s%20would%20deadlock%20with%20it.%0Aconcurrency%3A%0A%20%20group%3A%20rust-%24%7B%7B%20github.event_name%20%3D%3D%20%27pull_request%27%20%26%26%20format%28%27pull-%7B0%7D%27%2C%20github.event.pull_request.number%29%20%7C%7C%20github.run_id%20%7D%7D%0A%20%20cancel-in-progress%3A%20true%0A%0Aenv%3A%0A%20%20CARGO_TERM_COLOR%3A%20always%0A%20%20RUSTFLAGS%3A%20-Dwarnings%0A%20%20GIT_CONFIG_COUNT%3A%20%271%27%0A%20%20GIT_CONFIG_KEY_0%3A%20init.defaultBranch%0A%20%20GIT_CONFIG_VALUE_0%3A%20main%0A%20%20CARGO_NET_RETRY%3A%20%2710%27%0A%20%20CARGO_HTTP_MULTIPLEXING%3A%20%27false%27%0A%20%20%23%20Support%20both%20CARGO_REGISTRY_TOKEN%20%28cargo%27s%20native%20env%20var%29%20and%20CARGO_TOKEN%20%28for%20backwards%20compatibility%29%0A%20%20CARGO_REGISTRY_TOKEN%3A%20%24%7B%7B%20secrets.CARGO_REGISTRY_TOKEN%20%7C%7C%20secrets.CARGO_TOKEN%20%7D%7D%0A%20%20CARGO_TOKEN%3A%20%24%7B%7B%20secrets.CARGO_TOKEN%20%7D%7D%0A%20%20%23%20Optional%3A%20set%20repository%20variable%20DOCKERHUB_IMAGE%20to%20namespace%2Fimage%20to%20publish%20Docker%20Hub%20releases.%0A%20%20DOCKERHUB_IMAGE%3A%20%24%7B%7B%20vars.DOCKERHUB_IMAGE%20%7D%7D%0A%0Ajobs%3A%0A%20%20%23%20%3D%3D%3D%20DETECT%20CHANGES%20-%20determines%20which%20jobs%20should%20run%20%3D%3D%3D%0A%20%20detect-changes%3A%0A%20%20%20%20name%3A%20Detect%20Changes%0A%20%20%20%20runs-on%3A%20ubuntu-latest%0A%20%20%20%20timeout-minutes%3A%205%0A%20%20%20%20concurrency%3A%0A%20%20%20%