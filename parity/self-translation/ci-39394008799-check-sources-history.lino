%28history.original.path%2Cpath%29%3B%0A%20%20const%20certificate%3DreadProjectData%28new%20URL%28%27..%2F..%2F%27%2Bhistory.certificateFile%2Cimport.meta.url%29%29%3B%0A%20%20const%20stored%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bhistory.blobFile%2Cimport.meta.url%29%29%3B%0A%20%20const%20verified%3DverifyGitArtifactCertificate%28certificate%2Cstored%2C%7Brevision%2Cpath%7D%29%3B%0A%20%20assert.equal%28verified.length%2C136210%29%3Bassert.equal%28certificate.blob.objectId%2C%27015016c653d0c9d9ad322cbd0a8fb41e66bc3c5a%27%29%3B%0A%20%20assert.deepEqual%28verified%2Cstored%29%3B%0A%20%20const%20original%3DreadStructuredDataLino%28verified.toString%28%27utf8%27%29%29%3B%0A%20%20assert.equal%28original.definitionCount%2C106%29%3Bassert.equal%28original.styles.length%2C59%29%3B%0A%20%20assert.deepEqual%28original.cloneCalls%2C%7Bbefore%3A746%2Cafter%3A396%7D%29%3B%0A%20%20const%20oldRead%3D%22%20%20const%20previousBytes%3DexecFileSync%28%27git%27%2C%5B%27show%27%2C%2718a8e0a04bab43f6572be311ceb75c6596fdc147%3A%27%2Bfile%5D%2C%5Cn%20%20%20%20%7Bcwd%3Anew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%2CmaxBuffer%3A2%2A1024%2A1024%7D%29%3B%22%3B%0A%20%20const%20newRead%3D%22%20%20const%20previousBytes%3DverifyGitArtifactCertificate%28%5Cn%20%20%20%20readProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fhistorical%2Fgit-raw-borrowed-18a8e0a0-proof.lino%27%2Cimport.meta.url%29%29%2C%5Cn%20%20%20%20readFileSync%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fhistorical%2Fgit-raw-borrowed-18a8e0a0.lino%27%2Cimport.meta.url%29%29%2C%5Cn%20%20%20%20%7Brevision%3A%2718a8e0a04bab43f6572be311ceb75c6596fdc147%27%2Cpath%3Afile%7D%29%3B%22%3B%0A%20%20const%20addition%3D%22%5Cnimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fgit-object-certificate.mjs%27%3B%5Cn%22%3B%0A%20%20assert.equal%28before.sourceText.split%28oldRead%29.length%2C2%29%3B%0A%20%20const%20current%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bbefore.file%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20assert.equal%28current%2Cbefore.sourceText.replace%28oldRead%2CnewRead%29%2Baddition%2C%27every%20original%20input%2C%20complete%20predecessor%20comparison%20and%20native%20planning%20refusal%20remains%20byte%20exact%27%29%3B%0A%20%20assert.equal%28current.slice%280%2C-addition.length%29.replace%28newRead%2ColdRead%29%2Cbefore.sourceText%29%3B%0A%20%20const%20changed%3DBuffer.from%28stored%29%3Bchanged%5B0%5D%5E%3D1%3B%0A%20%20assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28certificate%2Cchanged%2C%7Brevision%2Cpath%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28certificate%2Cstored%2C%7Brevision%3A%270%27.repeat%2840%29%2Cpath%7D%29%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
