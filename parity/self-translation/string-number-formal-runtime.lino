(19: (meta: (t: semantic) (n: 1) (term: string%20value) (def: --%20Translated%20from%20JavaScript%20by%20meta-language%3A%20portable%20core%2C%20Lean%20target.%0A--%20Source%20binders%20are%20kept%20even%20where%20unused%20or%20named%20like%20a%20constructor%2C%20and%20proof%20hints%20are%20shared%20by%20every%20closing%20tactic.%0Aset_option%20linter.unusedVariables%20false%0Aset_option%20linter.unusedSimpArgs%20false%0Aset_option%20linter.constructorNameAsVariable%20false%0A%0A%2F--%20ECMAScript%20%60%25%60%20on%20binary64%20%28C%20fmod%29%3A%20the%20exact%20remainder%2C%20truncated%2C%20with%0Athe%20sign%20of%20the%20dividend%3B%20computed%20on%20the%20bits%2C%20so%20it%20is%20exact.%20-%2F%0Adef%20ml_float_rem%20%28x%20y%20%3A%20Float%29%20%3A%20Float%20%3A%3D%0A%20%20let%20decompose%20%28f%20%3A%20Float%29%20%3A%20Nat%20%C3%97%20Int%20%3A%3D%0A%20%20%20%20let%20b%20%3A%20Nat%20%3A%3D%20f.toBits.toNat%0A%20%20%20%20let%20exponent%20%3A%20Nat%20%3A%3D%20%28b%20%2F%202%20%5E%2052%29%20%25%202048%0A%20%20%20%20let%20fraction%20%3A%20Nat%20%3A%3D%20b%20%25%202%20%5E%2052%0A%20%20%20%20if%20exponent%20%3D%3D%200%20then%20%28fraction%2C%20-1074%29%20else%20%28fraction%20%2B%202%20%5E%2052%2C%20%28exponent%20%3A%20Int%29%20-%201075%29%0A%20%20if%20x.isNaN%20%7C%7C%20y.isNaN%20%7C%7C%20x.isInf%20%7C%7C%20y%20%3D%3D%200%20then%200%20%2F%200%0A%20%20else%20if%20y.isInf%20%7C%7C%20x%20%3D%3D%200%20then%20x%0A%20%20else%0A%20%20%20%20let%20%28mx%2C%20ex%29%20%3A%3D%20decompose%20x%0A%20%20%20%20let%20%28my%2C%20ey%29%20%3A%3D%20decompose%20y%0A%20%20%20%20let%20e%20%3A%3D%20min%20ex%20ey%0A%20%20%20%20let%20r%20%3A%3D%20%28mx%20%2A%202%20%5E%20%28ex%20-%20e%29.toNat%29%20%25%20%28my%20%2A%202%20%5E%20%28ey%20-%20e%29.toNat%29%0A%20%20%20%20let%20magnitude%20%3A%3D%20Float.scaleB%20%28Float.ofNat%20r%29%20e%0A%20%20%20%20if%20x.toBits.toNat%20%E2%89%A5%202%20%5E%2063%20then%20-magnitude%20else%20magnitude%0A%0A%2F--%20Math.trunc%3A%20towards%20zero%2C%20a%20zero%20result%20keeping%20the%20sign%20of%20the%20argument.%20-%2F%0Adef%20ml_trunc%20%28x%20%3A%20Float%29%20%3A%20Float%20%3A%3D%20if%20x%20%3C%200%20then%20x.ceil%20else%20x.floor%0A%2F--%20Math.round%3A%20the%20nearest%20integer%2C%20the%20one%20towards%20%2BInfinity%20on%20a%20tie%2C%20and%20-0%20from%20-0.5%20up%20to%200.%20-%2F%0Adef%20ml_round%20%28x%20%3A%20Float%29%20%3A%20Float%20%3A%3D%0A%20%20if%20x.isNaN%20%7C%7C%20x.isInf%20%7C%7C%20x%20%3D%3D%200%20then%20x%0A%20%20else%20if%20x%20%3E%200%20%E2%88%A7%20x%20%3C%200.5%20then%200%0A%20%20else%20if%20x%20%3C%200%20%E2%88%A7%20x%20%E2%89%A5%20-0.5%20then%20-0.0%0A%20%20else%20if%20x%20-%20x.floor%20%E2%89%A5%200.5%20then%20x.floor%20%2B%201%20else%20x.floor%0A%2F--%20Math.sign%3A%201%20or%20-1%2C%20and%20-0%2C%200%20and%20NaN%20as%20they%20are.%20-%2F%0Adef%20ml_sign%20%28x%20%3A%20Float%29%20%3A%20Float%20%3A%3D%20if%20x%20%3E%200%20then%201%20else%20if%20x%20%3C%200%20then%20-1%20else%20x%0A%2F--%20Math.max%20of%20two%20Numbers%3A%20NaN%20when%20either%20is%2C%20and%200%20above%20-0.%20-%2F%0Adef%20ml_max%20%28a%20b%20%3A%20Float%29%20%3A%20Float%20%3A%3D%0A%20%20if%20a%20%3E%20b%20then%20a%20else%20if%20b%20%3E%20a%20then%20b%20else%20if%20a%20%3D%3D%20b%20then%20%28if%201%20%2F%20a%20%3C%200%20then%20b%20else%20a%29%20else%200.0%20%2F%200.0%0A%2F--%20Math.min%20of%20two%20Numbers%3A%20NaN%20when%20either%20is%2C%20and%20-0%20below%200.%20-%2F%0Adef%20ml_min%20%28a%20b%20%3A%20Float%29%20%3A%20Float%20%3A%3D%0A%20%20if%20a%20%3C%20b%20then%20a%20else%20if%20b%20%3C%20a%20then%20b%20else%20if%20a%20%3D%3D%20b%20then%20%28if%201%20%2F%20a%20%3C%200%20then%20a%20else%20b%29%20else%200.0%20%2F%200.0%0Adef%20ml_is_integer%20%28x%20%3A%20Float%29%20%3A%20Bool%20%3A%3D%20x.isFinite%20%26%26%20ml_trunc%20x%20%3D%3D%20x%0Adef%20ml_is_safe_integer%20%28x%20%3A%20Float%29%20%3A%20Bool%20%3A%3D%20ml_is_integer%20x%20%26%26%20decide%20%28x.abs%20%E2%89%A4%209007199254740991%29%0A%0Adef%20acceptJavaScriptWhitespaceUnit%20%28unit%20%