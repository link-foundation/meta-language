t%20packet%3D%7BschemaVersion%3A1%2Crevision%2Csources%3Arows%2C%0A%20%20%20%20boundary%3A%27Current%20metadata%20records%20actual%20current%20producers.%20Every%20complete%20predecessor%20retains%20independent%20Git%20membership%20and%20an%20exact%20byte%20inverse.%20Original%20parser%20expectations%2C%20selected%20native%20definitions%2C%20constructor%20bodies%2C%20numeric%20validation%2C%20outputs%20and%20all%20refusal%20assertions%20remain%20required.%20Source%20conservation%20supplies%20no%20native%20execution%20or%20semantic%20equivalence%20evidence.%27%7D%3B%0A%20%20const%20target%3Dnew%20URL%28output%2Croot%29%3Bif%28check%29checkProjectData%28target%2Cpacket%29%3Belse%20writeProjectData%28target%2Cpacket%29%3B%0A%20%20const%20path%3Dnew%20URL%28helper%2Croot%29%2Csource%3DreadFileSync%28path%2C%27utf8%27%29%3B%0A%20%20const%20expected%3Dsource.replace%28%2Fconst%20archiveSha256%3D%27%28%3F%3APENDING%7C%5Ba-f0-9%5D%7B64%7D%29%27%3B%2Fu%2C%22const%20archiveSha256%3D%27%22%2Bpin%28readFileSync%28target%29%29.sha256%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28source%2Cexpected%29%3Belse%20writeFileSync%28path%2Cexpected%29%3B%0A%20%20return%20packet%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20const%20packet%3DgenerateGrammarContextSourceMetadata%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Retained%20%27%2Bpacket.sources.length%2B%27%20complete%20original%20sources%20and%20metadata%20with%20unchanged%20expected%20behavior.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
