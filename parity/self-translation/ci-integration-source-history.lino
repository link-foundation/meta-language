0npm%20credential%20resolution.%0A%20%20%20%20%20%20%20%20%20%20NPM_AUTH_DEBUG%3A%20%24%7B%7B%20vars.NPM_AUTH_DEBUG%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20node%20scripts%2Fprepare-npm-auth.mjs%0A%20%20%20%20%20%20%20%20working-directory%3A%20js%0A%0A%20%20%20%20%20%20%23%20npm%20treats%20a%20refused%20trusted-publisher%20exchange%20as%20%22no%20credential%22%20and%0A%20%20%20%20%20%20%23%20reports%20only%20ENEEDAUTH.%20Perform%20the%20same%20exchange%20first%20so%20the%20log%20shows%0A%20%20%20%20%20%20%23%20the%20registry%27s%20answer%2C%20the%20OIDC%20claims%20it%20compared%2C%20and%20the%20exact%0A%20%20%20%20%20%20%23%20settings%20docs%2Fci-cd%2Fnpm-trusted-publishing.md%20asks%20for.%0A%20%20%20%20%20%20-%20name%3A%20Verify%20the%20trusted-publisher%20exchange%0A%20%20%20%20%20%20%20%20if%3A%20steps.npm.outputs.already_published%20%21%3D%20%27true%27%20%26%26%20steps.npm_auth.outputs.auth_mode%20%3D%3D%20%27oidc%27%0A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20PACKAGE_NAME%3A%20meta-language%0A%20%20%20%20%20%20%20%20%20%20PUBLISH_WORKFLOW_FILE%3A%20.github%2Fworkflows%2Fjs.yml%0A%20%20%20%20%20%20%20%20run%3A%20node%20scripts%2Fprepare-npm-auth.mjs%20--verify-exchange%0A%20%20%20%20%20%20%20%20working-directory%3A%20js%0A%0A%20%20%20%20%20%20-%20name%3A%20Publish%20to%20npm%0A%20%20%20%20%20%20%20%20if%3A%20steps.npm.outputs.already_published%20%21%3D%20%27true%27%0A%20%20%20%20%20%20%20%20%23%20Optional%20NPM_TOKEN%20bootstrap%20fallback.%20OIDC%20trusted%20publishing%20is%20the%0A%20%20%20%20%20%20%20%20%23%20steady-state%20mechanism%3B%20the%20token%20path%20only%20matters%20until%20a%20trusted%0A%20%20%20%20%20%20%20%20%23%20publisher%20is%20configured%20for%20the%20package%20on%20npmjs.com.%0A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20NODE_AUTH_TOKEN%3A%20%24%7B%7B%20secrets.NPM_TOKEN%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20npm%20publish%20--provenance%0A%20%20%20%20%20%20%20%20working-directory%3A%20js%0A%0