(23186: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20The%20dependency%20inventory%20of%20docs%2Fvision.md%23dependencies%3A%20every%20retained%0A%2F%2F%20runtime%2C%20development%2C%20build%20and%20optional%20dependency%2C%20lockfile%20resolution%2C%0A%2F%2F%20downloaded%20grammar%20asset%2C%20generator%2C%20toolchain%2C%20workflow%20action%2C%20build%20image%0A%2F%2F%20and%20published%20artifact%20entry%2C%20each%20with%20its%20current%20stable%20release%20on%20the%0A%2F%2F%20recorded%20audit%20date%20%28requirement%20I195-DEPENDENCY-INVENTORY%29.%0A%2F%2F%0A%2F%2F%20collectDependencies%28%29%20reads%20the%20pins%20from%20the%20repository%20offline.%0A%2F%2F%20parity%2Fdependency-inventory.json%20stores%20them%20with%20the%20current%20stable%20release%0A%2F%2F%20and%2C%20for%20an%20item%20that%20is%20behind%20it%2C%20the%20recorded%20compatibility%20reason%3B%0A%2F%2F%20refreshInventory%28%29%20queries%20the%20registries%20to%20rewrite%20it%2C%20and%0A%2F%2F%20checkInventory%28%29%20fails%20when%20the%20stored%20inventory%20no%20longer%20matches%20the%0A%2F%2F%20repository%20or%20when%20a%20retained%20item%20is%20behind%20without%20a%20reason.%0A%2F%2F%20docs%2Fdependency-audit.md%20is%20rendered%20from%20the%20inventory.%0Aimport%20%7B%20existsSync%2C%20readdirSync%2C%20readFileSync%20%7D%20from%20%27node%3Afs%27%3B%0Aimport%20path%20from%20%27node%3Apath%27%3B%0A%0Aimport%20%7B%20compareVersions%2C%20isPrerelease%2C%20newestStable%2C%20satisfies%2C%20versionParts%20%7D%20from%20%27.%2Fsemver-range.mjs%27%3B%0Aimport%20%7B%20grammarFile%20%7D%20from%20%27.%2Fgrammar-files.mjs%27%3B%0Aimport%20%7B%20readProjectData%2C%20resolveProjectDataPath%20%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7B%20collectGrammarAssetDependencies%2C%20relocatedGrammarDependency%20%7D%20from%20%27.%2Fdependency-grammar-assets.mjs%27%3B%0A%0Aexport%20const%20INVENTORY_FILE%20%3D%20%27parity%2Fdependency-inventory.json%27%3B%0Aexport%20const%20AUDIT_DOCUMENT%20%3D%20%27docs%2Fdependency-audit.md%27%3B%0A%0A%2F%2A%2A%20The%20categories%20in%20the%20order%20the%20audit%20document%20lists%20them.%20%2A%2F%0Aexport%20const%20CATEGORIES%20%3D%20%5B%0A%20%20%7B%20id%3A%20%27engine%27%2C%20title%3A%20%27JavaScript%20engines%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27npm%27%2C%20title%3A%20%27npm%20packages%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27setting%27%2C%20title%3A%20%27Rust%20package%20settings%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27crate%27%2C%20title%3A%20%27Rust%20crates%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27experiment%27%2C%20title%3A%20%27Experiment%20manifests%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27downloaded-parser%27%2C%20title%3A%20%27Downloaded%20generated%20parser%20sources%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27vendored-runtime%27%2C%20title%3A%20%27Vendored%20runtime%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27downloaded-grammar%27%2C%20title%3A%20%27Downloaded%20WebAssembly%20grammars%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27generator%27%2C%20title%3A%20%27Generators%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27toolchain%27%2C%20title%3A%20%27Toolchains%20and%20tools%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27action%27%2C%20title%3A%20%27GitHub%20Actions%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27image%27%2C%20title%3A%20%27Build%20images%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27runner%27%2C%20title%3A%20%27Runners%27%20%7D%2C%0A%20%20%7B%20id%3A%20%27published%27%2C%20title%3A%20%27Published%20artifact%20contents%27%20%7D%2C%0A%5D%3B%0A%0A%2F%2A%2A%0A%20%2A%20How%20an%20item%27s%20pin%20is%20compared%20with%20its%20current%20stable%20release%3A%0A%20%2A%20%60version%60%20%28the%20pin%20is%20at%20least%20the%20release%29%2C%20%60major%60%20and%20%60minor%60%20%28a%20moving%0A%20%2A%20tag%20such%20as%20%60v7%60%20or%20%605.4%60%20that%20follows%20the%20newest%20release%20of%20that%20line%29%2C%0A%20%2A%20%60floor%60%20%28a%20supported%20minimum%20that%20must%20not%20admit%20an%20unmaintained%20or%0A%20%2A%20insufficient%20release%29%2C%20%60revision%60%20%28