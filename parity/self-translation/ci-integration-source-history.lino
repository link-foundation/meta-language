items.map%28row%3D%3Erow.id%29%2C%0A%20%20%20%20boundary%3A%27Identity-based%20order%20repair%20preserves%20all%20745%20original%20and%20773%20preceding%20complete%20records%2C%20original%20audit%20date%2C%20every%20current%20declaration%20and%20both%20exact%20certified%20source%20inverses.%20Newly%20declared%20identities%20append.%20This%20is%20no%20live%20registry%20audit%20or%20native%20execution%20evidence.%27%7D%3B%0A%20%20assert.equal%28ordered.items.filter%28row%3D%3EoldIds.has%28row.id%29%29.length%2C773%29%3B%0A%20%20if%28check%29checkProjectData%28new%20URL%28path%2Croot%29%2Cordered%29%3Belse%20writeProjectData%28new%20URL%28path%2Croot%29%2Cordered%29%3B%0A%20%20const%20document%3Dnew%20URL%28%27docs%2Fdependency-audit.md%27%2Croot%29%2Crendered%3DrenderAuditDocument%28ordered%29%3B%0A%20%20if%28check%29assert.equal%28readFileSync%28document%2C%27utf8%27%29%2Crendered%29%3Belse%20writeFileSync%28document%2Crendered%29%3B%0A%20%20const%20history%3Dnew%20URL%28%27parity%2Ffixtures%2Fdependency-inventory-order-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28history%2Cvalue%29%3Belse%20writeProjectData%28history%2Cvalue%29%3B%0A%20%20return%20value%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateDependencyInventoryOrderHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
