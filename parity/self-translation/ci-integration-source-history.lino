%3E%7B%7D%29%29%3B%0A%20%20runner.test%28name%2C%28%29%3D%3E%7B%7D%29%3Bassert.throws%28%28%29%3D%3Erunner.test%28name%2C%28%29%3D%3E%7B%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3Erunner.test%28fixture.tests.find%28row%3D%3Erow.partition%3D%3D%3D%27native%27%29.name%2C%28%29%3D%3E%7B%7D%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20entire%20current%20test%20source%20retains%20every%20original%20call%20body%20hash%20and%20a%20complete%20certified%20inverse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bfixture%2Chistory%7D%3DgenerateRawOracleContractPartitions%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20source%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bfixture.testPath%2Cimport.meta.url%29%2C%27utf8%27%29%2Cbytes%3DBuffer.from%28source%29%3B%0A%20%20const%20tree%3DparseNative%28%27native-javascript%27%2Csource%29%3Bassert.equal%28tree.hasError%2Cfalse%29%3B%0A%20%20const%20nodes%3D%5Btree%5D%2Cactual%3D%5B%5D%3B%0A%20%20for%28let%20at%3D0%3Bat%3Cnodes.length%3Bat%2B%3D1%29%7B%0A%20%20%20%20const%20node%3Dnodes%5Bat%5D%3Bnodes.push%28...node.children.map%28row%3D%3Erow.node%29%29%3B%0A%20%20%20%20if%28node.term%21%3D%3D%27call_expression%27%29continue%3B%0A%20%20%20%20const%20fn%3Dnode.children.find%28row%3D%3Erow.field%3D%3D%3D%27function%27%29%3F.node%3B%0A%20%20%20%20if%28%21fn%7C%7Cbytes.subarray%28fn.start%2Cfn.end%29.toString%28%29%21%3D%3D%27test%27%29continue%3B%0A%20%20%20%20const%20args%3Dnode.children.find%28row%3D%3Erow.field%3D%3D%3D%27arguments%27%29%3F.node%3B%0A%20%20%20%20const%20name%3Dargs.children.find%28row%3D%3Erow.node.term%3D%3D%3D%27string%27%29%3F.node%3Bassert.ok%28name%29%3B%0A%20%20%20%20actual.push%28%7Bname%3Atokenize%28bytes.subarray%28name.start%2Cname.end%29.toString%28%29%2C%27JavaScript%27%29.tokens%5B0%5D.value%2C%0A%20%20%20%20%20%20start%3Anode.start%2Csha256%3AcreateHash%28%27sha256%27%29.update%28bytes.subarray%28node.start%2Cnode.end%29%29.digest%28%27hex%27%29%7D%29%3B%0A%20%20%7D%0A%20%20actual.sort%28%28first%2Csecond%29%3D%3