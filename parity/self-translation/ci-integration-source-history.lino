20%20%20%202.%20Merge%20this%20PR%20to%20main%0A%20%20%20%20%20%20%20%20%20%20%20%203.%20The%20automated%20release%20workflow%20will%20publish%20to%20crates.io%20and%20create%20a%20GitHub%20release%0A%0A%20%20%23%20%3D%3D%3D%20DEPLOY%20WEBSITE%20%3D%3D%3D%0A%20%20%23%20Deploy%20the%20project%20website%20to%20GitHub%20Pages%20after%20a%20successful%20package%20build.%0A%20%20%23%20The%20website%20is%20assembled%20by%20rust%2Fscripts%2Fbuild-site.rs%20into%20the%20%60_site%2F%60%20tree.%0A%20%20%23%20%20%20%2F%20%20%20%20%20%20%20%20%20%20-%3E%20landing%20page%20%28description%20%2B%20interactive%20demo%20%2B%20docs%20links%29%0A%20%20%23%20%20%20%2Fdemo%2Fpkg%2F%20-%3E%20WebAssembly%20demo%20built%20from%20the%20rust%2Fweb%2F%20crate%0A%20%20%23%20%20%20%2Fapi%2F%20%20%20%20%20%20-%3E%20rustdoc%2C%20with%20a%20root%20redirect%20index.html%0A%20%20%23%0A%20%20%23%20Deploying%20the%20assembled%20%60_site%2F%60%20%28instead%20of%20raw%20%60target%2Fdoc%60%29%20fixes%20issue%0A%20%20%23%20%2390%3A%20%60cargo%20doc%60%20writes%20%60target%2Fdoc%2F%3Ccrate%3E%2Findex.html%60%20but%20never%20a%20root%0A%20%20%23%20%60target%2Fdoc%2Findex.html%60%2C%20so%20deploying%20%60target%2Fdoc%60%20directly%20made%20the%20Pages%0A%20%20%23%20root%20URL%20return%20HTTP%20404.%20The%20landing%20page%20now%20lives%20at%20the%20root.%0A%20%20%23%0A%20%20%23%20Keep%20this%20independent%20from%20package%2FGitHub%20release%20publication%20so%20the%20website%0A%20%20%23%20still%20updates%20when%20the%20release%20path%20fails.%20Use%20the%20official%20Pages%20artifact%0A%20%20%23%20deployment%20path%20so%20repositories%20configured%20with%20%22GitHub%20Actions%22%20as%20their%0A%20%20%23%20Pages%20source%20fail%20this%20job%20if%20Pages%20cannot%20deploy.%0A%20%20%23%0A%20%20%23%20One-time%20setup%3A%20in%20the%20repository%27s%20Settings%20-%3E%20Pages%2C%20set%20Source%20to%0A%20%20%23%20%22GitHub%20Actions%22.%20Without%20this%2C%20the%20first%20run%20fails%20on%20actions%2Fdeploy-pages%0A%20%20%23%20with%20%22Get%20Pages%20site%20failed%22%20%2F%20%22Failed%20to%20create%20deployment%22.%20This%20cannot%20be%0A%20%20%23%20configured%20from%20a%20workflow.%20See%20README.md%20%22Deploying%20the%20website%22.%0A%20%20deploy-docs%3A%0A%20%20%20%20name%3A%20Deploy%20Website%0A%20%20%20%20needs%3A%20%5Bbuild%5D%0A%20%20%20%20if%3A%20%7C%0A%20%20%20%20%20%20%21cancelled%28%29%20%26%26%0A%20%20%20%20%20%20needs.build.result%20%3D%3D%20%27success%27%20%26%26%20%28%0A%20%20%20%20%20%20%20%20%28github.event_name%20%3D%3D%20%27push%27%20%26%26%20github.ref%20%3D%3D%20%27refs%2Fheads%2Fmain%27%29%20%7C%7C%0A%20%20%20%20%20%20%20%20%28github.event_name%20%3D%3D%20%27workflow_dispatch%27%20%26%26%20github.event.inputs.release_mode%20%3D%3D%20%27instant%27%29%0A%20%20%20%20%20%20%29%0A%20%20%20%20runs-on%3A%20ubuntu-latest%0A%20%20%20%20timeout-minutes%3A%2020%0A%20%20%20%20concurrency%3A%0A%20%20%20%20%20%20group%3A%20release-%24%7B%7B%20github.repository%20%7D%7D-main-write%0A%20%20%20%20%20%20cancel-in-progress%3A%20false%0A%20%20%20%20permissions%3A%0A%20%20%20%20%20%20contents%3A%20read%0A%20%20%20%20%20%20pages%3A%20write%0A%20%20%20%20%20%20id-token%3A%20write%0A%20%20%20%20environment%3A%0A%20%20%20%20%20%20name%3A%20github-pages%0A%20%20%20%20%20%20url%3A%20%24%7B%7B%20steps.deployment.outputs.page_url%20%7D%7D%0A%20%20%20%20steps%3A%0A%20%20%20%20%20%20-%20uses%3A%20actions%2Fcheckout%40v7%0A%20%20%20%20%20%20%20%20with%3A%0A%20%20%20%20%20%20%20%20%20%20ref%3A%20main%0A%0A%20%20%20%20%20%20-%20name%3A%20Setup%20Rust%0A%20%20%20%20%20%20%20%20uses%3A%20dtolnay%2Frust-toolchain%40stable%0A%20%20%20%20%20%20%20%20with%3A%0A%20%20%20%20%20%20%20%20%20%20targets%3A%20wasm32-unknown-unknown%0A%0A%20%20%20%20%20%20-%20name%3A%20Install%20rust-script%0A%20%20%20%20%20%20%20%20run%3A%20.%2Frust%2Fscripts%2Finstall-rust-script.sh%0A%0A%20%20%20%20%20%20-%20name%3A%20Install%20wasm-pack%0A%20%20%20%20%20%20%20%20uses%3A%20taiki-e%2Finstall-action%40v2%0A%20%20%20%20%20%20%20%20with%3A%0A%20%20%20%20%20%20%20%20%20%20tool%3A%20wasm-pack%0A%0A%20%20%20%20%20%20-%20name%3A%20Build%20documentation%0A%20%20%20%20%20%20%20%20working-directory%3A%20rust%0A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20RUSTDOCFLAGS%3A%20-D%20warnings%0A%20%20%20%20%20%20%20%20run%3A%20cargo%20doc%20--no-deps%20--all-features%0A%0A%20%20%20%20%20%20-%20name%3A%20Build%20WebAssembly%20demo%0A%20%20%20%20%20%20%20%20working-directory%3A%20rust%2Fweb%0A%20%20%20%20%20%20%20%20run%3A%20node%20..%2F..%2Fscripts%2Fwith-cache-cleanup.mjs%20--event%20build%20--protect%20pkg%20--%20wasm-pack%20build%20--release%20--target%20web%20--out-dir%20pkg%0A%0A%20%20%20%20%20%20-%20name%3A%20Assemble%20website%0A%20%20%20%20%20%20%20%20working-directory%3A%20rust%0A%20%20%20%20%20%20%20%20run%3A%20rust-script%20scripts%2Fbuild-site.rs%20--assemble-only%0A%0A%20%20%20%20%20%20-%20name%3A%20List%20built%20site%0A%20%20%20%20%20%20%20%20run%3A%20find%20_site%20-maxdepth%202%20-print%0A%0A%20%20%20%20%20%20-%20name%3A%20Configure%20GitHub%20Pages%0A%20%20%20%20%20%20%20%20uses%3A%20actions%2Fconfigure-pages%40v6%0A%0A%20%20%20%20%20%20-%20name%3A%20Upload%20GitHub%20Pages%20artifact%0A%20%20%20%20%20%20%20%20uses%3A%20actions%2Fupload-pages-artifact%40v5%0A%20%20%20%20%20%20%20%20with%3A%0A%20%20%20%20%20%20%20%20%20%20path%3A%20_site%0A%0A%20%20%20%20%20%20-%20name%3A%20Deploy%20to%20GitHub%20Pages%0A%20%20%20%20%20%20%20%20id%3A%20deployment%0A%20%20%20%20%20%20%20%20uses%3A%20actions%2Fdeploy-pages%40v5%0A%0A%20%20%20%20%20%20-%20name%3A%20Clean%20regenerable%20caches%0A%20%20%20%20%20%20%20%20if%3A%20%24%7B%7B%20%21cancelled%28%29%20%26%26%20hashFiles%28%27scripts%2Fclean-caches.mjs%27%29%20%21%3D%20%27%27%20%7D%7D%0A%20%20%20%20%20%20%20%20working-directory%3A%20%24%7B%7B%20github.workspace%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20node%20scripts%2Fclean-caches.mjs%20--event%20ci-teardown%0A) (lang: meta-language%20structured%20data)))
