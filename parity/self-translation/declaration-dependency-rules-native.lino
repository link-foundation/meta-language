d%29%20return%20true%3B%0A%20%20for%20%28const%20form%20of%20forms%29%20%7B%0A%20%20%20%20if%20%28form%20%21%3D%3D%20%27comment%27%20%26%26%20form%20%21%3D%3D%20%27named%20function%20declaration%27%0A%20%20%20%20%20%20%26%26%20form%20%21%3D%3D%20%27named%20import%27%20%26%26%20form%20%21%3D%3D%20%27primitive%20literal%20binding%27%0A%20%20%20%20%20%20%26%26%20form%20%21%3D%3D%20%27empty%20class%20declaration%27%29%20return%20false%3B%0A%20%20%7D%0A%20%20return%20true%3B%0A%7D%0A%0A%2F%2A%2A%20A%20signature%20describes%20a%20binding%20only%20after%20the%20actual%20module%20surface%20is%0A%20%2A%20certified%20and%20that%20original%20name%20has%20exactly%20one%20actual%20declaration%2Fimport%0A%20%2A%20owner.%20An%20isolated%20checked%20body%20alone%20cannot%20supply%20module%20ownership.%0A%20%2A%20%40param%20%7Bboolean%7D%20scopeKnown%20%40param%20%7Bnumber%7D%20ownerCount%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptDeclarationSignatureBinding%28scopeKnown%2C%20ownerCount%29%20%7B%0A%20%20return%20scopeKnown%20%26%26%20ownerCount%20%3D%3D%3D%201%3B%0A%7D%0A%0A%2F%2F%20Ownership%20and%20publication%20of%20complete%20actual%20source-generated%20helpers.%0A%2F%2F%20The%20existing%20fact-column%20import%20and%20six%20decisions%20remain%20byte-exact.%0A%2F%2F%20No%20code%20name%20or%20generated%3Atrue%20marker%20is%20an%20ownership%20proof.%0A%0A%2F%2A%2A%20Actual%20roots%20own%20disjoint%20complete%20original%20UTF16%20intervals.%20Roles%20are%0A%20%2A%200%3Dthe%20original%20named%20fn%2C%201%3Dgenerated%20fn%2C%202%3Dgenerated%20non-output%20data.%0A%20%2A%20Unknown%20kinds%2C%20module%20paths%2C%20absent%20spans%20or%20output%20carriers%20map%20to%20-1.%0A%20%2A%20A%20refusal%20returns%20%5B%5D%3B%20success%20returns%20one%20original%20owner%20per%20declaration.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20rootStarts%20%40param%20%7Bnumber%5B%5D%7D%20rootEnds%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20declarationStarts%20%40param%20%7Bnumber%5B%5D%7