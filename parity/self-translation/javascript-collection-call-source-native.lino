(25199: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadJavaScriptSourceTextProfileError%7D%20from%20%27.%2Fjavascript-source-text-rules.js%27%3B%0A%2F%2A%2A%20Explicit%20semantic%20operands%20for%20ordinary%20object%20operations.%20Reference%20IDs%0A%20%2A%20belong%20to%20the%20caller%27s%20checked%20global%20link%20space%3B%20callability%20is%20an%20intrinsic%0A%20%2A%20fact%20of%20that%20object%20model%2C%20not%20a%20host%20callback%20or%20an%20inferred%20property%20name.%0A%20%2A%20Text%20retains%20UTF-16%20units.%20Integer%20values%20and%20reference%20identities%20remain%0A%20%2A%20separate%20domains%2C%20even%20when%20their%20numerical%20encodings%20happen%20to%20agree.%0A%20%2A%20%40typedef%20%7B%7B%20%24%3A%27undefined%27%20%7D%20%7C%20%7B%20%24%3A%27null%27%20%7D%20%7C%20%7B%20%24%3A%27boolean%27%2C%20value%3Aboolean%20%7D%0A%20%2A%20%7C%20%7B%20%24%3A%27number%27%2C%20value%3Anumber%20%7D%20%7C%20%7B%20%24%3A%27integer%27%2C%20value%3Abigint%20%7D%0A%20%2A%20%7C%20%7B%20%24%3A%27text%27%2C%20units%3Anumber%5B%5D%20%7D%20%7C%20%7B%20%24%3A%27sourceText%27%2Cprofile%3Astring%2Ctext%3Astring%7D%0A%20%2A%20%7C%20%7B%20%24%3A%27symbol%27%2C%20identity%3Abigint%20%7D%0A%20%2A%20%7C%20%7B%20%24%3A%27object%27%2C%20identity%3Abigint%2C%20callable%3Aboolean%20%7D%7D%20JavaScriptSemanticValue%0A%20%2A%2F%0A%0A%2F%2A%2A%20%40typedef%20%7B%7B%24%3A%27primitiveValue%27%2Cvalue%3AJavaScriptSemanticValue%7D%20%7C%0A%20%2A%20%7B%24%3A%27primitiveInvalid%27%2Creason%3Astring%7D%20%7C%20%7B%24%3A%27primitiveError%27%2CerrorClass%3Astring%2Creason%3Astring%7D%20%7C%0A%20%2A%20%7B%24%3A%27primitiveResourceLimit%27%2Creason%3Astring%7D%7D%20JavaScriptCallPrimitiveResult%20%2A%2F%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptSemanticValue%7D%20value%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptSemanticValueError%28value%29%20%7B%0A%20%20switch%20%28value.%24%29%20%7B%0A%20%20%20%20case%20%27undefined%27%3A%20return%20%27%27%3B%0A%