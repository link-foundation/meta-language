(84: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadRequiredBooleanFact%2CreadRequiredTextFact%7D%20from%20%27.%2Ffact-column-rules.js%27%3B%0A%2F%2A%2A%20Actual%20syntax%20roles%20only%3B%20a%20wildcard%20consumes%20a%20value%20without%20a%20binding.%0A%20%2A%20%40param%20%7Bstring%7D%20role%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureParameterForm%28role%29%7Breturn%20role%3D%3D%3D%27_%27%3F%27wildcard%27%3Arole%3D%3D%3D%27binding%27%3F%27binding%27%3A%27unsupported%27%3B%7D%0A%2F%2A%2A%20A%20distinct%20ordinary%20immutable%20source%20profile%2C%20with%20no%20inferred%20ownership.%0A%20%2A%20%40param%20%7Bboolean%7D%20ordinary%20%40param%20%7Bstring%5B%5D%7D%20names%20%40param%20%7Bboolean%5B%5D%7D%20copies%0A%20%2A%20%40param%20%7Bboolean%7D%20resultWritten%20%40param%20%7Bboolean%7D%20resultCopy%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureHeaderError%28ordinary%2Cnames%2Ccopies%2CresultWritten%2CresultCopy%29%7B%0A%20const%20error%3DreadRustCopyClosureParameterHeaderError%28ordinary%2Cnames%2Ccopies%29%3Bif%28error%29return%20error%3B%0A%20if%28%21resultWritten%29return%20%27the%20closure%20result%20requires%20its%20actual%20explicit%20type%27%3B%0A%20return%20resultCopy%3F%27%27%3A%27the%20closure%20result%20requires%20a%20direct%20immutable%20Copy%20source%20type%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bboolean%7D%20collecting%20%40param%20%7Bboolean%5B%5D%7D%20copies%20%40param%20%7Bnumber%7D%20assigned%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureCaptureError%28collecting%2Ccopies%2Cassigned%29%7B%0A%20if%28assigned%21%3D%3D0%29return%20%27mutable%20closure%20captures%20require%20their%20shared%20ownership%20interpretation%27%3B%0A%20if%28%21collecting%29for%28let%20index%3D0%3Bindex%3Ccopies.length%3Bindex%2B%3D1%29if%28%21readRequiredBooleanFact%28copies%2Cindex%29%29return%20%27closure%20captures%20require%20proven%20direct%20immutable%20Copy%20source%20values%27%3B%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustCopyClosureInvocation%28kind%29%7Breturn%20kind%3D%3D%3D%27function%27%3B%7D%0A%2F%2A%2A%20Anonymous%20closure%20identity%20never%20follows%20from%20equal%20callable%20signatures.%0A%20%2A%20%40param%20%7Bboolean%7D%20first%20%40param%20%7Bboolean%7D%20second%20%40param%20%7Bboolean%7D%20same%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureJoinError%28first%2Csecond%2Csame%29%7Breturn%20%28first%7C%7Csecond%29%26%26%21same%3F%27distinct%20anonymous%20closure%20types%20require%20an%20actual%20source%20coercion%27%3A%27%27%3B%7D%0A%0A%2F%2A%2A%20Header%20checks%20do%20not%20assert%20that%20an%20unresolved%20result%20type%20is%20known.%0A%20%2A%20%40param%20%7Bboolean%7D%20ordinary%20%40param%20%7Bstring%5B%5D%7D%20names%20%40param%20%7Bboolean%5B%5D%7D%20copies%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureParameterHeaderError%28ordinary%2Cnames%2Ccopies%29%7B%0A%20if%28%21ordinary%29return%20%27closure%20ownership%20requires%20its%20separate%20active%20source%20profile%27%3B%0A%20if%28names.length%21%3D%3Dcopies.length%7C%7Cnames.length%3E1024%29return%20%27the%20complete%20typed%20closure%20header%20exceeds%20its%20source%20budget%27%3B%0A%20for%28let%20index%3D0%3Bindex%3Cnames.length%3Bindex%2B%3D1%29%7Bif%28%21readRequiredBooleanFact%28copies%2Cindex%29%29return%20%27closure%20parameters%20require%20direct%20immutable%20Copy%20source%20types%27%3Bfor%28let%20before%3D0%3Bbefore%3Cindex%3Bbefore%2B%3D1%29if%28readRequiredTextFact%28names%2Cbefore%29%3D%3D%3DreadRequiredTextFact%28names%2Cindex%29%29return%20%27closure%20parameters%20require%20distinct%20actual%20bindings%27%3B%7D%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bboolean%7D%20requested%20%40param%20%7Bboolean%7D%20written%20%40param%20%7Bboolean%7D%20known%0A%20%2A%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testRustCopyClosureDeferredResult%28requested%2Cwritten%2Cknown%29%7Breturn%20requested%26%26%21written%26%26%21known%3B%7D%0A%2F%2A%2A%20Admission%20is%20for%20actual%20partial%20source%20syntax%2C%20never%20a%20complete%20value%20type.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bnumber%7D%20parameters%20%40param%20%7Bnumber%7D%20layers%0A%20%2A%20%40param%20%7Bboolean%7D%20identity%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureDeferredSourceError%28kind%2Cparameters%2Clayers%2Cidentity%29%7Breturn%20kind%3D%3D%3D%27lambda%27%26%26parameters%3D%3D%3D0%26%26layers%3D%3D%3D0%26%26identity%3F%27%27%3A%27a%20deferred%20fallback%20needs%20its%20actual%20zero-argument%20closure%20source%20and%20identity%27%3B%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20pending%20%40param%20%7Bboolean%7D%20known%0A%20%2A%20%40param%20%7Bboolean%7D%20copy%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureDeferredResultError%28kind%2Cpending%2Cknown%2Ccopy%29%7Breturn%20kind%3D%3D%3D%27lambda%27%26%26pending%26%26known%26%26copy%3F%27%27%3A%27a%20deferred%20closure%20needs%20its%20actual%20complete%20immutable%20Copy%20result%20context%27%3B%7D%0A%0A%2F%2A%2A%20Only%20source%20positions%20that%20inherit%20the%20result%27s%20type%20are%20traversed.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bstring%7D%20operation%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureResultContextRole%28kind%2Coperation%29%7Breturn%20kind%3D%3D%3D%27let%27%3F%27binding%27%3Akind%3D%3D%3D%27name%27%3F%27name%27%3Akind%3D%3D%3D%27if%27%3F%27branches%27%3Akind%3D%3D%3D%27match%27%3F%27rows%27%3Akind%3D%3D%3D%27unary%27%26%26operation%3D%3D%3D%27neg%27%3F%27operand%27%3Akind%3D%3D%3D%27binary%27%26%26%5B%27add%27%2C%27sub%27%2C%27mul%27%2C%27div%27%2C%27rem%27%5D.includes%28operation%29%3F%27operands%27%3A%27leaf%27%3B%7D%0A%2F%2A%2A%20Unsuffixed%20integer%20syntax%20cannot%20silently%20acquire%20a%20float%20or%20Boolean%20type.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20negative%20%40param%20%7Bboolean%7D%20typed%0A%20%2A%20%40param%20%7Bstring%7D%20result%20%40param%20%7Bboolean%7D%20signed%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureLiteralResultError%28kind%2Cnegative%2Ctyped%2Cresult%2Csigned%29%7Bif%28negative%26%26result%3D%3D%3D%27fixed%27%26%26%21signed%29return%20%27an%20unsigned%20Rust%20result%20cannot%20use%20unary%20negation%27%3Breturn%20kind%3D%3D%3D%27num%27%26%26%21typed%26%26result%21%3D%3D%27fixed%27%3F%27an%20unsuffixed%20Rust%20integer%20literal%20needs%20an%20actual%20integer%20result%20context%27%3A%27%27%3B%7D%0A%0A%2F%2A%2A%20Lexical%20scope%20frames%20supply%20actual%20binder%20identity%3B%20spelling%20alone%20is%20not%20global%20identity.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20path%20%40param%20%7Bstring%7D%20name%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testRustCopyClosureResultBinding%28path%2Cname%29%7Breturn%20path.length%3D%3D%3D1%26%26path%5B0%5D%3D%3D%3Dname%3B%7D%0A%0A%2F%2A%2A%20Reference-pattern%20tokens%20retain%20their%20actual%20immutable%20layer%20count.%0A%20%2A%20%40param%20%7Bstring%7D%20token%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureReferencePatternDepth%28token%29%7Breturn%20token%3D%3D%3D%27%26%27%3F1%3Atoken%3D%3D%3D%27%26%26%27%3F2%3A0%3B%7D%0A%2F%2A%2A%20Copy%20scalar%20destructuring%20retains%20the%20callable%20parameter%27s%20full%20signature.%0A%20%2A%20%40param%20%7Bnumber%7D%20depth%20%40param%20%7Bnumber%7D%20layers%20%40param%20%7Bboolean%7D%20references%0A%20%2A%20%40param%20%7Bboolean%7D%20parameter%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureReferencePatternError%28depth%2Clayers%2Creferences%2Cparameter%29%7B%0A%20if%28depth%3D%3D%3D0%29return%20%27%27%3B%0A%20return%20Number.isInteger%28depth%29%26%26depth%3E%3D1%26%26depth%3C%3D256%26%26Number.isInteger%28layers%29%26%26layers%3E%3Ddepth%26%26layers%3C%3D256%26%26references%26%26parameter%3F%27%27%3A%27a%20closure%20reference%20pattern%20needs%20its%20actual%20immutable%20Copy%20scalar%20reference%20layers%27%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
