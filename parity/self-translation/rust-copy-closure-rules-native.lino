Aexport%20function%20readRustCopyClosureResultContextRole%28kind%2Coperation%29%7Breturn%20kind%3D%3D%3D%27let%27%3F%27binding%27%3Akind%3D%3D%3D%27name%27%3F%27name%27%3Akind%3D%3D%3D%27if%27%3F%27branches%27%3Akind%3D%3D%3D%27match%27%3F%27rows%27%3Akind%3D%3D%3D%27unary%27%26%26operation%3D%3D%3D%27neg%27%3F%27operand%27%3Akind%3D%3D%3D%27binary%27%26%26%5B%27add%27%2C%27sub%27%2C%27mul%27%2C%27div%27%2C%27rem%27%5D.includes%28operation%29%3F%27operands%27%3A%27leaf%27%3B%7D%0A%2F%2A%2A%20Unsuffixed%20integer%20syntax%20cannot%20silently%20acquire%20a%20float%20or%20Boolean%20type.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20negative%20%40param%20%7Bboolean%7D%20typed%0A%20%2A%20%40param%20%7Bstring%7D%20result%20%40param%20%7Bboolean%7D%20signed%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureLiteralResultError%28kind%2Cnegative%2Ctyped%2Cresult%2Csigned%29%7Bif%28negative%26%26result%3D%3D%3D%27fixed%27%26%26%21signed%29return%20%27an%20unsigned%20Rust%20result%20cannot%20use%20unary%20negation%27%3Breturn%20kind%3D%3D%3D%27num%27%26%26%21typed%26%26result%21%3D%3D%27fixed%27%3F%27an%20unsuffixed%20Rust%20integer%20literal%20needs%20an%20actual%20integer%20result%20context%27%3A%27%27%3B%7D%0A%0A%2F%2A%2A%20Lexical%20scope%20frames%20supply%20actual%20binder%20identity%3B%20spelling%20alone%20is%20not%20global%20identity.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20path%20%40param%20%7Bstring%7D%20name%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20testRustCopyClosureResultBinding%28path%2Cname%29%7Breturn%20path.length%3D%3D%3D1%26%26path%5B0%5D%3D%3D%3Dname%3B%7D%0A%0A%2F%2A%2A%20Reference-pattern%20tokens%20retain%20their%20actual%20immutable%20layer%20count.%0A%20%2A%20%40param%20%7Bstring%7D%20token%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureReferencePatternDepth%28token%29%7Breturn%20token%3D%3D%3D%27%26%27%3F1%3Atoken%3D%3D%3D%27%26%26%27%3F2%3A0%3B%7D