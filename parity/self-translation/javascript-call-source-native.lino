%20const%20first%3Dleft%3D%3D%3D%27int%27%7C%7Cleft%3D%3D%3D%27nat%27%2Csecond%3Dright%3D%3D%3D%27int%27%7C%7Cright%3D%3D%3D%27nat%27%3B%0A%20if%28first%26%26right%3D%3D%3D%27float%27%7C%7Cleft%3D%3D%3D%27float%27%26%26second%29return%20%27mixed%27%3B%0A%20return%20first%26%26second%26%26operation%3D%3D%3D%27shiftJavaScriptNumberBitsRightUnsigned%27%3F%27unsigned%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20V8%20messages%20use%20the%20fixture%27s%20explicit%20Node%20version%20profile.%0A%20%2A%20%40param%20%7Bstring%7D%20failure%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptNumericOperationMessage%28failure%29%7B%0A%20if%28failure%3D%3D%3D%27mixed%27%29return%20%27Cannot%20mix%20BigInt%20and%20other%20types%2C%20use%20explicit%20conversions%27%3B%0A%20return%20failure%3D%3D%3D%27unsigned%27%3F%27BigInts%20have%20no%20unsigned%20right%20shift%2C%20use%20%3E%3E%20instead%27%3A%27%27%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
