n%7D%20output%20%40param%20%7Bstring%5B%5D%7D%20names%20%40param%20%7Bstring%5B%5D%7D%20kinds%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptSourceExceptionPayloadFields%28output%2Cnames%2Ckinds%29%7B%0A%20return%20output%26%26names.length%3D%3D%3D4%26%26kinds.length%3D%3D%3D4%26%26names%5B0%5D%3D%3D%3D%27output%27%26%26kinds%5B0%5D%3D%3D%3D%27output%27%0A%20%20%26%26names%5B1%5D%3D%3D%3D%27message%27%26%26kinds%5B1%5D%3D%3D%3D%27string%27%26%26names%5B2%5D%3D%3D%3D%27className%27%26%26kinds%5B2%5D%3D%3D%3D%27string%27%0A%20%20%26%26names%5B3%5D%3D%3D%3D%27messagePresent%27%26%26kinds%5B3%5D%3D%3D%3D%27bool%27%3B%0A%7D%0A%2F%2A%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readSourceExceptionObservationStatement%28%29%7B%0A%20return%20%27ml_source_exception_observation%20retains%20the%20source%20exception%20constructor%20class%2C%20exact%20UTF-16%20message%20and%20own-message%20property%20presence%3B%20main%20projects%20the%20display%20message%20at%20its%20ordinary%20process%20boundary%27%3B%0A%7D%0A%2F%2A%2A%20Generic%20output%20append%20preserves%20every%20exception%20component.%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readSourceExceptionRocqOutputPrelude%28%29%7B%0A%20return%20%27Definition%20ml_emit_source_exception%20%7BE%20%3A%20Type%7D%20%28lines%20%3A%20list%20string%29%20%28next%20%3A%20list%20string%20%2A%20option%20E%29%20%3A%20list%20string%20%2A%20option%20E%20%3A%3D%20%28List.app%20lines%20%28fst%20next%29%2C%20snd%20next%29.%27%3B%0A%7D%0A%0A%2F%2A%2A%20Operands%20already%20passed%20ToNumeric%3B%20this%20does%20not%20conflate%20String%20addition%0A%20%2A%20with%20numeric%20addition.%20A%20failing%20operation%20has%20no%20resulting%20value%20domain.%0A%20%2A%20%40param%20%7Bstring%7D%20operation%20%40param%20%7Bstring%7D%20left%20%40param%20%7Bstring%7D%20right%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptNumericOperationFailure%28operation%2Cleft%2Cright%29%7B%0A%20const%20first%3Dleft%3D%3D%3D%27int%27%7C%7Cleft%3D%3D%3D%27nat%27%2Csecond%3Dright%3D%3D%3D%27int%27%7C%7Cright%3D%3D%3D%27nat%27%3B%0A%20if%28first%26%26right%3D%3D%3D%27float%27%7C%7Cleft%3D%3D%3D%27float%27%26%26second%29return%20%27mixed%27%3B%0A%20return%20first%26%26second%26%26operation%3D%3D%3D%27shiftJavaScriptNumberBitsRightUnsigned%27%3F%27unsigned%27%3A%27%27%3B%0A%7D%0A%2F%2A%2A%20V8%20messages%20use%20the%20fixture%27s%20explicit%20Node%20version%20profile.%0A%20%2A%20%40param%20%7Bstring%7D%20failure%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptNumericOperationMessage%28failure%29%7B%0A%20if%28failure%3D%3D%3D%27mixed%27%29return%20%27Cannot%20mix%20BigInt%20and%20other%20types%2C%20use%20explicit%20conversions%27%3B%0A%20return%20failure%3D%3D%3D%27unsigned%27%3F%27BigInts%20have%20no%20unsigned%20right%20shift%2C%20use%20%3E%3E%20instead%27%3A%27%27%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
