(13403: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Legacy%20conservation%20checks%20inspect%20an%20authenticated%20inverse%20of%20only%20the%0A%2F%2F%20approved%20queue%20correction.%20Actual%20current%20groups%20must%20match%20first%2C%20including%0A%2F%2F%20every%20matrix%20coordinate%20and%20the%20unchanged%20release-write%20cancellation%20policy.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7B%20createHash%20%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7B%20readFileSync%20%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7B%20readStructuredDataLino%20%7D%20from%20%27..%2F..%2Fsrc%2Fstructured-data-links.js%27%3B%0A%0Aconst%20bytes%20%3D%20readFileSync%28new%20URL%28%27..%2F..%2F..%2Fparity%2Ffixtures%2Fverification-concurrency-history.lino%27%2C%20import.meta.url%29%29%3B%0Aassert.equal%28createHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%2C%0A%20%20%274a6d40babe12f205ee90c2295fd189d55e81e39781a2c1df4c6e38789503a261%27%29%3B%0Aconst%20history%20%3D%20readStructuredDataLino%28bytes.toString%28%27utf8%27%29%29%3B%0Afor%20%28const%20file%20of%20history.files%29%20%7B%0A%20%20for%20%28const%20capture%20of%20%5Bfile.before%2C%20file.after%5D%29%20%7B%0A%20%20%20%20assert.equal%28Buffer.byteLength%28capture.source%29%2C%20capture.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28capture.source%29.digest%28%27hex%27%29%2C%20capture.sha256%29%3B%0A%20%20%7D%0A%20%20let%20original%20%3D%20file.after.source%3B%0A%20%20for%20%28const%20change%20of%20file.changes%29%20%7B%0A%20%20%20%20assert.equal%28original.split%28change.after%29.length%20-%201%2C%20change.occurrences%29%3B%0A%20%20%20%20original%20%3D%20original.replaceAll%28change.after%2C%20change.before%29%3B%0A%20%20%7D%0A%20%20assert.equal%28original%2C%20file.before.source%2C%20%27complete%20original%20workflow%20source%20inverse%27%29%3B%0A%7D%0A%0Aexport%20function%20restoreVerificationConcurrencyHistory%28source%2C%20name%29%20%7B%0A%20%20assert.equal%28typeof%20source%2C%20%27string%27%29%3B%0A%20%20const%20file%20%3D%20history.files.find%28file%20%3D%3E%20file.name%20%3D%3D%3D%20name%29%3B%0A%20%20assert.ok%28file%2C%20%27only%20the%20three%20authenticated%20verification%20workflows%20have%20a%20historical%20inverse%27%29%3B%0A%20%20const%20groups%20%3D%20%5B...source.matchAll%28%2F%5E%28%5Cs%2Agroup%3A%20.%2B%29%5Cn%28%5Cs%2Acancel-in-progress%3A%20%28%3F%3Atrue%7Cfalse%29%29%24%2Fgmu%29%5D.map%28%28%5Bsource%5D%29%20%3D%3E%20source%29%3B%0A%20%20assert.deepEqual%28groups.sort%28%29%2C%20%5B...file.groups%5D.sort%28%29%2C%20%27current%20queue%20identities%2C%20matrix%20dimensions%20and%20cancellation%20policies%20must%20match%20before%20historical%20comparison%27%29%3B%0A%20%20let%20original%20%3D%20source%3B%0A%20%20for%20%28const%20change%20of%20file.changes%29%20%7B%0A%20%20%20%20assert.equal%28original.split%28change.after%29.length%20-%201%2C%20change.occurrences%2C%20%27every%20approved%20queue%20or%20comment%20correction%20must%20be%20present%20exactly%27%29%3B%0A%20%20%20%20original%20%3D%20original.replaceAll%28change.after%2C%20change.before%29%3B%0A%20%20%7D%0A%20%20return%20original%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
