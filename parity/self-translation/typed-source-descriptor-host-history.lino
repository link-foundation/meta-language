0assert.equal%28ownStatus%28%7B...node%2Cpinned%3A%2724%27%2Ccompare%3A%27major%27%2Ccurrent%3A%2724.23.0%27%7D%29%2C%27current%27%29%3B%0A%20%20assert.equal%28ownStatus%28%7B...node%2Cpinned%3A%2724.22%27%2Ccompare%3A%27minor%27%2Ccurrent%3A%2724.22.1%27%7D%29%2C%27current%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27one-source%20Node%20reconciliation%20retains%20every%20unrelated%20audit%20fact%20and%20exact%20original%20collector%20bytes%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DreadProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fnaming%2Fci-node-dependency-source-history.lino%27%2Cimport.meta.url%29%29%3B%0A%20%20for%28const%20source%20of%20history.sources%29%7B%0A%20%20%20%20assert.equal%28Buffer.byteLength%28source.sourceText%29%2Csource.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28source.sourceText%29.digest%28%27hex%27%29%2Csource.sha256%29%3B%0A%20%20%7D%0A%20%20const%20collector%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3D%27js%2Fscripts%2Fdependency-inventory.mjs%27%29%3B%0A%20%20const%20actual%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bcollector.file%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20assert.equal%28actual%2Ccollector.sourceText.replace%28history.before%2Chistory.after%29%2Bhistory.insertion%29%3B%0A%20%20assert.equal%28actual.replace%28history.insertion%2C%27%27%29.replace%28history.after%2Chistory.before%29%2Ccollector.sourceText%29%3B%0A%20%20const%20original%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3D%27parity%2Fdependency-inventory.lino%27%29%3B%0A%20%20const%20before%3DreadStructuredDataLino%28original.sourceText%29%3B%0A%20%20const%20current%3DreadNodeDependencyInventoryOriginalView%28%29%3B%0A%20%20const%20generator%3DreadNodeDependencyGeneratorRegistrationHistory%28%29.generator%3B%0A%20%20assert.deepEqual%28current.items.filter%28row%3D%3Erow.id%3D%3D%3Dgenerator.id%29%2C%5Bgenerator%5D%29%3B%0A%20%20current.items%3Dcurrent.items.filter%28row%3D%3Erow.id%21%3D%3Dgenerator.id%29%3B%0