(2070: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Types%20of%20JavaScript%20functions%20written%20without%20JSDoc.%20A%20parameter%20or%20result%0A%2F%2F%20without%20a%20declared%20type%20gets%20a%20type%20variable%3B%20the%20bodies%2C%20the%20calls%20and%20the%0A%2F%2F%20top-level%20statements%20constrain%20the%20variables%20by%20unification%2C%20and%20each%0A%2F%2F%20variable%20takes%20the%20one%20type%20every%20use%20agrees%20on.%20A%20BigInt%20literal%20is%20a%0A%2F%2F%20%60bigint%60%20of%20any%20integer%20type%2C%20%60%2B%60%20of%20a%20string%20is%20concatenation%2C%20and%20a%20type%0A%2F%2F%20nothing%20constrains%20is%20a%20Number.%20Two%20uses%20that%20need%20different%20types%20are%20a%0A%2F%2F%20type%20error%3A%20the%20function%20would%20need%20a%20declared%20type%20for%20each%20use.%0A%0Aimport%20%7B%20typeError%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20inferCollectionConstruction%20%7D%20from%20%27.%2Fcollection-construction.js%27%3B%0Aimport%20%7B%20readArrayFromCallbackConstraints%2C%20readArrayFromInferenceInputs%2C%20readArrayFromIterableType%20%7D%20from%20%27.%2Farray-from.js%27%3B%0Aimport%20%7B%20readJavaScriptArrayDefaultConstraints%20%7D%20from%20%27.%2Farray-binding-inference.js%27%3B%0Aimport%20%7B%20checkJavaScriptArrayBindingWrapper%20%7D%20from%20%27.%2Farray-binding-validation.js%27%3B%0Aimport%20%7B%20readInferenceTermIdentity%2C%20readOptionalAdditionalAbsence%2C%20readOptionalCoalescingConstraints%2C%20readOptionalFieldInference%2C%20readOptionalJoinConstraints%2C%20readOptionalTypeConstraints%20%7D%20from%20%27.%2Foptional-inference.js%27%3B%0Aimport%20%7B%20mergeOptionalAbsence%20%7D%20from%20%27.%2Fstructured-type-rules.js%27%3B%0Aimport%20%7B%20readOptionalBigIntConstraint%2C%20readOptionalCallBinding%2C%20readOptionalJoinBinding%2C%20readOptionalNumericTerm%2C%20requireInferenceJoinAlias%2C%20requireOptionalResultBinding%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20readRecordFieldInsertionOrder%2C%20readRecordFieldPosition%2C%20readRecordSpreadRole%2C%20readRecordTypeConstraintError%2C%20readRecordTypeConstraintStep%2C%20readRecordFieldInferenceStep%20%7D%20from%20%27.%2Frecord-value-rules.js%27%3B%0Aimport%20%7B%20containsRecordTypeOwner%20%7D%20from%20%27.%2Frecord-type-facts.js%27%3B%0Aimport%20%7B%20constructCallableFunctionType%2C%20readCallableApplicationConstraints%2C%20readCallableCellOptionBinding%2C%20readCallableCellReadInference%2C%20readCallableFunctionConstraints%2C%20readCallableLambdaInference%2C%20readCallableTypeChildren%20%7D%20from%20%27.%2Fcallable-source.js%27%3B%0Aimport%20%7B%20acceptCallableApplicationInferenceResult%2C%20requireCallableNamedInference%2C%20requireCallableStructuralInference%20%7D%20from%20%27.%2Fcallable-source-rules.js%27%3B%0Aimport%20%7B%20acceptArgumentCount%2C%20acceptJavaScriptOptionalTupleContext%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0Aimport%20%7B%20readParameterDefaultArgumentInference%20%7D%20from%20%27.%2Fparameter-default-rules.js%27%3B%0Aimport%20%7B%20BOOL%2C%20FLOAT%2C%20INT%2C%20STRING%2C%20UNIT%2C%20option%20%7D%20from%20%27.%2Ftypes.js%27%3B%0Aimport%20%7B%20markSharedReferenceTypes%20%7D%20from%20%27.%2Fjavascript-cells.js%27%3B%0Aimport%20%7B%20readJavaScriptProductIndex%2C%20requiresJavaScriptProductProof%20%7D%20from%20%27.%2Fjavascript-products.js%27%3B%0Aimport%20%7B%20acceptJavaScriptArrayTupleContext%20%7D%20from%20%27.%2Fproduct-source-rules.js%27%3B%0Aimport%20%7B%20readJavaScriptMethodReceiverKind%2C%20readJavaScriptMethodArgumentKind%2C%0A%20%20readJavaScriptStringMethodResultForm%2C%20readJavaScriptIncludesReceiverForm%2C%0A%20%20readJavaScriptEqualityInferenceStep%20%7D%20from%20%27.%2Fjavascript-surface-rules.js%27%3B%0Aimport%20%7BreadPrimitiveMethodMinimumArguments%2CreadPrimitiveMethodArgumentCount%2C%0A%20%20readPrimitiveMethodCheckedArgumentKind%2CreadPrimitiveMethodCheckedResultForm%7D%20from%20%27.%2Fprimitive-method-rules.js%27%3B%0A%0Acon