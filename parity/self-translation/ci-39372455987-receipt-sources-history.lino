(8018: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Exact%20source%20inverses%20keep%20historical%20assertions%20pinned%20to%20their%20own%20inputs.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BreadProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0A%0Aconst%20historyFile%20%3D%20new%20URL%28%27..%2F..%2Fparity%2Fself-translation%2Ftranslation-source-history.lino%27%2C%20import.meta.url%29%3B%0Aconst%20historyHash%20%3D%20%2798b15162cdde0048ec44ee864f3ac5ace3cdd00cb4d5efd8a82335a4ef759a9d%27%3B%0Aconst%20digest%20%3D%20value%20%3D%3E%20createHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0Alet%20history%3B%0A%0Aexport%20function%20restoreTranslationSourceHistory%28source%2C%20file%2C%20revision%29%20%7B%0A%20%20assert.equal%28typeof%20source%2C%20%27string%27%2C%20%27a%20complete%20source%20string%20is%20required%27%29%3B%0A%20%20assert.ok%28Buffer.byteLength%28source%29%20%3C%3D%201024%20%2A%201024%2C%20%27bounded%20complete%20source%20required%27%29%3B%0A%20%20if%20%28%21history%29%20%7B%0A%20%20%20%20const%20bytes%20%3D%20readFileSync%28historyFile%29%3B%0A%20%20%20%20assert.equal%28digest%28bytes%29%2C%20historyHash%2C%20%27the%20whole%20reviewed%20inverse%20policy%20remains%20exact%27%29%3B%0A%20%20%20%20history%20%3D%20readProjectData%28historyFile%29%3B%0A%20%20%20%20assert.equal%28history.schemaVersion%2C%201%29%3B%0A%20%20%20%20assert.equal%28history.sources.length%2C%206%29%3B%0A%20%20%7D%0A%20%20const%20entries%20%3D%20history.sources.filter%28row%20%3D%3E%20row.file%20%3D%3D%3D%20file%20%26%26%20row.revision%20%3D%3D%3D%20revision%29%3B%0A%20%20assert.equal%28entries.length%2C%201%2C%20%27one%20exact%20recorded%20source%20and%20predecessor%20revision%20are%20required%27%29%3B%0A%20%20const%20entry%20%3D%20entries%5B0%5D%3B%0A%20%20let%20bytes%20%3D%20Buffer.from%28source%29%3B%0A%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2C%20source%2C%20%27complete%20source%20retains%20valid%20UTF8%27%29%3B%0A%20%20source%20%3D%20restoreArrayRelativeElementSource%28source%2C%20file%2C%20true%29%3B%0A%20%20bytes%20%3D%20Buffer.from%28source%29%3B%0A%20%20const%20successor%20%3D%20history.relativeCharacterSourceSuccessors%3F.find%28row%20%3D%3E%20row.file%20%3D%3D%3D%20file%20%26%26%20digest%28bytes%29%20%3D%3D%3D%20row.current.sha256%29%3B%0A%20%20if%20%28successor%29%20%7B%0A%20%20%20%20assert.equal%28successor.revision%2C%20%279ac3038132953e6a220bba6f06a3e6147d39836f%27%29%3B%0A%20%20%20%20assert.equal%28bytes.length%2C%20successor.current.bytes%29%3B%0A%20%20%20%20let%20limit%20%3D%20bytes.length%3B%0A%20%20%20%20for%20%28const%20edit%20of%20successor.edits.toReversed%28%29%29%20%7B%0A%20%20%20%20%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%20%26%26%20Number.isSafeInteger%28edit.end%29%0A%20%20%20%20%20%20%20%20%26%26%20edit.start%20%3E%3D%200%20%26%26%20edit.end%20%3E%3D%20edit.start%20%26%26%20edit.end%20%3C%3D%20limit%29%3B%0A%20%20%20%20%20%20assert.equal%28bytes.subarray%28edit.start%2C%20edit.end%29.toString%28%27utf8%27%29%2C%20edit.currentText%29%3B%0A%20%20%20%20%20%20bytes%20%3D%20Buffer.concat%28%5Bbytes.subarray%280%2C%20edit.start%29%2C%20Buffer.from%28edit.previousText%29%2C%20bytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20%20%20limit%20%3D%20edit.start%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28bytes.length%2C%20successor.previous.bytes%29%3B%0A%20%20%20%20assert.equal%28digest%28bytes%29%2C%20successor.previous.sha256%29%3B%0A%20%20%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2C%20successor.previous.sourceText%29%3B%0A%20%20%20%20source%20%3D%20bytes.toString%28%27utf8%27%29%3B%0A%20%20%7D%0A%20%20if%20%28digest%28bytes%29%20%3D%3D%3D%20entry.previous.sha256%29%20%7B%0A%20%20%20%20assert.equal%28bytes.length%2C%20entry.previous.bytes%29%3B%0A%20%20%20%20assert.equal%28source%2C%20entry.previous.sourceText%29%3B%0A%20%20%20%20return%20source%3B%0A%20%20%7D%0A%20%20assert.equal%28bytes.length%2C%20entry.current.bytes%2C%20%27unreviewed%20current%20source%20changes%20refuse%27%29%3B%0A%20%20assert.equal%28digest%28bytes%29%2C%20entry.current.sha256%2C%20%27the%20complete%20current%20source%20must%20match%20its%20reviewed%20input%27%29%3B%0A%20%20let%20limit%20%3D%20bytes.length%3B%0A%20%20for%20%28const%20edit%20of%20entry.edits.toReversed%28%29%29%20%7B%0A%20%20%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%20%26%26%20Number.isSafeInteger%28edit.end%29%0A%20%20%20%20%20%20%26%26%20edit.start%20%3E%3D%200%20%26%26%20edit.end%20%3E%3D%20edit.start%20%26%26%20edit.end%20%3C%3D%20limit%2C%20%27ordered%20disjoint%20source%20intervals%20required%27%29%3B%0A%20%20%20%20assert.equal%28bytes.subarray%28edit.start%2C%20edit.end%29.toString%28%27utf8%27%29%2C%20edit.currentText%29%3B%0A%20%20%20%20bytes%20%3D%20Buffer.concat%28%5Bbytes.subarray%280%2C%20edit.start%29%2C%20Buffer.from%28edit.previousText%29%2C%20bytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20limit%20%3D%20edit.start%3B%0A%20%20%7D%0A%20%20assert.equal%28bytes.length%2C%20entry.previous.bytes%2C%20%27the%20complete%20original%20source%20byte%20count%20is%20restored%27%29%3B%0A%20%20assert.equal%28digest%28bytes%29%2C%20entry.previous.sha256%2C%20%27every%20original%20source%20byte%20and%20context%20is%20restored%27%29%3B%0A%20%20assert.equal%28bytes.toString%28%27utf8%27%29%2C%20entry.previous.sourceText%29%3B%0A%20%20return%20bytes.toString%28%27utf8%27%29%3B%0A%7D%0A%0Aimport%20%7BrestoreArrayRelativeElementSource%7D%20from%20%27.%2Farray-relative-element-history.mjs%27%3B%0A) (lang: meta-language%20structured%20data)))
