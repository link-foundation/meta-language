%26%20token.value%20%3D%3D%3D%20%27clone%27%0A%20%20%20%20%26%26%20tokens%5Bindex%20-%201%5D%3F.value%20%3D%3D%3D%20%27.%27%20%26%26%20tokens%5Bindex%20%2B%201%5D%3F.value%20%3D%3D%3D%20%27%28%27%20%26%26%20tokens%5Bindex%20%2B%202%5D%3F.value%20%3D%3D%3D%20%27%29%27%29.length%3B%0A%7D%3B%0A%0A%2F%2A%2A%20Keep%20every%20checked%20owner%20and%20recover%20the%20entire%20predecessor%20from%20actual%20styles.%20%2A%2F%0Aexport%20function%20prepareOriginalLinkRawBorrowedEmission%28predecessor%2C%20%7Bread%20%3D%20readFileSync%2C%20check%20%3D%20true%7D%20%3D%20%7B%7D%29%20%7B%0A%20%20const%20storedBytes%20%3D%20read%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%29%3B%0A%20%20const%20stored%20%3D%20readProjectData%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%29%3B%0A%20%20assert.equal%28predecessor.profile%2C%20%27consuming%27%29%3B%0A%20%20assert.equal%28predecessor.proof.artifactSha256%2C%20digest%28storedBytes%29%2C%27the%20complete%20consuming%20predecessor%20bytes%20changed%27%29%3B%0A%20%20assert.equal%28stored.sourceSha256%2C%20predecessor.sourceSha256%29%3B%0A%20%20const%20source%20%3D%20stored.completeRust%3B%0A%20%20assert.deepEqual%28descriptor%28source%29%2C%20%7Bbytes%3A%20predecessor.sourceBytes%2C%20sha256%3A%20predecessor.sourceSha256%7D%29%3B%0A%20%20const%20options%20%3D%20%7BownedParameters%3A%20%7Bcheck_original_link_raw_shape%3A%20%5B%27columns%27%5D%7D%7D%3B%0A%20%20const%20styled%20%3D%20readPortableSourceParameterStyles%28source%2C%20options%29%3B%0A%20%20const%20names%20%3D%20text%20%3D%3E%20%5B...text.matchAll%28%2F%5Epub%20fn%20%28%5Cw%2B%29%5C%28%2Fgmu%29%5D.map%28match%20%3D%3E%20match%5B1%5D%29%3B%0A%20%20const%20header%20%3D%20text%20%3D%3E%20text.split%28%27%5Cn%27%29.find%28line%20%3D%3E%20line.startsWith%28%27pub%20fn%20check_original_link_raw_shape%28%27%29%29%3B%0A%20%20assert.equal%28names%28source%29.length%2C%2062%29%3B%0A%20%20assert.equal%28stored.owners.length%2C%20106%29%3B%0A%20%20assert.deepEqual%28names%28styled.source%29%2C%20names%28source%29%29%3B%0A%20%20assert.equal%28header%28styled.source%29%2C%20header%28source%29%2C%20%27the%20full%20public%20consumer%20interface%20stays%20exact%27%29%3B%0A%20%20let%20inverse%20%3D%20styled.source%3B%0A%20%20for%20%28const%20action%20of%20%5B...styled.actions%5D.reverse%28%29%29%20%7B%0A%20%20%20%20assert.equal%28action.op%2C%20%27replace%27%29%3B%20assert.equal%28action.field%2C%20%27source%27%29%3B%0A%20%20%20%20assert.equal%28inverse.split%28action.to%29.length%2C%202%2C%20%27a%20whole%20styled%20function%20has%20exactly%20one%20inverse%27%29%3B%0A%20%20%20%20inverse%20%3D%20inverse.replace%28action.to%2C%20%28%29%20%3D%3E%20action.from%29%3B%0A%20%20%7D%0A%20%20assert.equal%28inverse%2C%20source%2C%20%27every%20complete%20predecessor%20byte%20is%20recovered%27%29%3B%0A%20%20const%20receipt%20%3D%20%7Bversion%3A%201%2C%20profile%3A%20%27borrowed%20consuming%27%2C%20options%2C%0A%20%20%20%20predecessor%3A%20%7B...descriptor%28storedBytes%29%2C%20source%3A%20descriptor%28source%29%7D%2C%0A%20%20%20%20source%3A%20descriptor%28styled.source%29%2C%20definitionCount%3A%20106%2C%0A%20%20%20%20declarationNames%3A%20stored.declarationNames%2C%20publicEntryHeader%3A%20header%28source%29%2C%0A%20%20%20%20decisions%3A%20decisions.map%28file%20%3D%3E%20%28%7Bfile%2C%20...descriptor%28read%28new%20URL%28file%2C%20root%29%29%29%7D%29%29%2C%0A%20%20%20%20styles%3A%20styled.actions.map%28action%20%3D%3E%20%28%7Bname%3A%20names%28action.from%29%5B0%5D%2C%0A%20%20%20%20%20%20before%3A%20descriptor%28action.from%29%2C%20after%3A%20descriptor%28action.to%29%7D%29%29%2C%0A%20%20%20%20cloneCalls%3A%20%7Bbefore%3A%20cloneCalls%28source%29%2C%20after%3A%20cloneCalls%28styled.source%29%7D%2C%0A%20%20%20%20nativeCompilation%3A%20false%2C%20nativeExecution%3A%20false%2C%0A%20%20%20%20boundary%3A%20%27Exact%20mechanical%20parameter%20styles%20and%20whole%20predecessor%20inverse%3B%20no%20native%20timing%20or%20execution%20claim.%27%7D%3B%0A%20%20assert.ok%28receipt.cloneCalls.after%2