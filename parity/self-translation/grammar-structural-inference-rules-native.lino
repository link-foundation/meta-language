5Bindex%5D%20%3F%3F%20refuseRequiredTextFact%28%29%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bboolean%5B%5D%7D%20values%20%40param%20%7Bnumber%7D%20index%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20readRequiredBooleanFact%28values%2C%20index%29%20%7B%0A%20%20if%20%28index%20%3C%200%20%7C%7C%20index%20%25%201%20%21%3D%3D%200%20%7C%7C%20index%20%3E%3D%20values.length%29%20%7B%0A%20%20%20%20throw%20new%20RangeError%28%27invalid%20required%20Boolean%20fact%20column%20position%27%29%3B%0A%20%20%7D%0A%20%20return%20values%5Bindex%5D%20%3F%3F%20refuseRequiredBooleanFact%28%29%3B%0A%7D%0A%0A%0A%0A%0A%2F%2A%2A%0A%20%2A%20Split%20a%20token%20sequence%20into%20observed%20productions.%20Group%20zero%20owns%20the%0A%20%2A%20whole%20sequence.%20Within%20a%20production%2C%20nonnegative%20entries%20are%20terminal%0A%20%2A%20token%20indexes%20and%20negative%20entries%20reference%20their%20delimiter%20group.%0A%20%2A%20Open%20and%20close%20tokens%20each%20belong%20to%20at%20most%20one%20positive%20group.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20tokens%20%40param%20%7Bnumber%5B%5D%7D%20openingGroups%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20closingGroups%20%40param%20%7Bnumber%7D%20depthLimit%0A%20%2A%20%40returns%20%7Bnumber%5B%5D%5B%5D%7D%0A%20%2A%2F%0Aexport%20function%20readGrammarStructuralProductions%28tokens%2C%20openingGroups%2C%20closingGroups%2C%20depthLimit%29%20%7B%0A%20%20%2F%2A%2A%20%40type%20%7Bnumber%5B%5D%5B%5D%7D%20%2A%2F%0A%20%20const%20rows%20%3D%20%5B%5D%3B%0A%20%20const%20groups%20%3D%20%5B0%5D%3B%0A%20%20const%20starts%20%3D%20%5B0%5D%3B%0A%20%20let%20symbols%20%3D%20%5B0%5D%3B%0A%20%20for%20%28const%20token%20of%20tokens%29%20%7B%0A%20%20%20%20const%20depth%20%3D%20groups.length%20-%201%3B%0A%20%20%20%20if%20%28token%20%3C%200%20%7C%7C%20token%20%3E%3D%20openingGroups.length%20%7C%7C%20token%20%3E%3D%20closingGroups.length%29%20return%20%5B%5B-1%5D%5D%3B%0A%20%20%20%20const%20opening%20%3D%20readRequiredNumberFact%28openingGroups%2C%20token%29%3B%0A%20%20%20%20const%20closing%20%3D%20readRequiredNumberFact%28closingGroups%2C%20token%29%3B%0A%20%20%20%20if%20%28closing%20%3E%200%29%20%7B%0A%20%20%20%20%20%20if%20%28closing%20%21%3D%3D%20readRequiredNumberFact%28groups%2C%20depth%29%29%20return%20%5B%5B-1%5D%5D%3B%0A%20%20%20%20%20%20const%20start%20%3D%20readRequiredNumberFact%28starts%2C%20depth%29%3B%0A%20%20%20%20%20%20rows.push%28symbols.slice%28start%29%29%3B%0A%20%20%20%20%20%20symbols%20%3D%20symbols.slice%280%2C%20start%29%3B%0A%20%20%20%20%20%20groups.pop%28%29%3B%0A%20%20%20%20%20%20starts.pop%28%29%3B%0A%20%20%20%20%7D%20else%20if%20%28opening%20%3E%200%29%20%7B%0A%20%20%20%20%20%20if%20%28depth%20%3E%3D%20depthLimit%29%20return%20%5B%5B-2%5D%5D%3B%0A%20%20%20%20%20%20symbols.push%28-opening%29%3B%0A%20%20%20%20%20%20starts.push%28symbols.length%29%3B%0A%20%20%20%20%20%20groups.push%28opening%29%3B%0A%20%20%20%20%20%20symbols.push%28opening%29%3B%0A%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20symbols.push%28token%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20if%20%28groups.length%20%21%3D%3D%201%29%20return%20%5B%5B-1%5D%5D%3B%0A%20%20rows.push%28symbols%29%3B%0A%20%20return%20rows%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Compare%20production%20keys%20without%20coercing%20tokens%20to%20text%20or%20losing%20order.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20left%20%40param%20%7Bnumber%5B%5D%7D%20right%20%40returns%20%7Bboolean%7D%0A%20%2A%2F%0Aexport%20function%20testSameGrammarStructuralProduction%28left%2C%20right%29%20%7B%0A%20%20if%20%28left.length%20%21%3D%3D%20right.length%29%20return%20false%3B%0A%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20left.length%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20if%20%28readRequiredNumberFact%28left%2C%20index%29%20%21%3D%3D%20readRequiredNumberFact%28right%2C%20index%29%29%20return%20false%3B%0A%20%20%7D%0A%20%20return%20true%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Infer%20mutually%20recursive%20alternatives%20by%20retaining%20the%20first%20completed%2