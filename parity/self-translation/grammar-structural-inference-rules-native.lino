2A%20%40param%20%7Bnumber%7D%20depthLimit%20%40param%20%7Bnumber%7D%20productionLimit%0A%20%2A%20%40returns%20%7Bnumber%5B%5D%5B%5D%7D%0A%20%2A%2F%0Aexport%20function%20inferGrammarStructuralProductions%28positives%2C%20negatives%2C%20openingGroups%2C%20closingGroups%2C%20depthLimit%2C%20productionLimit%29%20%7B%0A%20%20%2F%2A%2A%20%40type%20%7Bnumber%5B%5D%5B%5D%7D%20%2A%2F%0A%20%20let%20productions%20%3D%20%5B%5D%3B%0A%20%20for%20%28const%20tokens%20of%20positives%29%20%7B%0A%20%20%20%20const%20rows%20%3D%20readGrammarStructuralProductions%28tokens%2C%20openingGroups%2C%20closingGroups%2C%20depthLimit%29%3B%0A%20%20%20%20for%20%28const%20row%20of%20rows%29%20%7B%0A%20%20%20%20%20%20const%20group%20%3D%20readRequiredNumberFact%28row%2C%200%29%3B%0A%20%20%20%20%20%20if%20%28group%20%3C%200%29%20return%20%5Brow%5D%3B%0A%20%20%20%20%20%20if%20%28%21productions.some%28previous%20%3D%3E%20testSameGrammarStructuralProduction%28previous%2C%20row%29%29%29%20%7B%0A%20%20%20%20%20%20%20%20if%20%28productions.length%20%3E%3D%20productionLimit%29%20return%20%5B%5B-3%5D%5D%3B%0A%20%20%20%20%20%20%20%20productions%20%3D%20productions.concat%28%5Brow%5D%29%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20for%20%28const%20tokens%20of%20negatives%29%20%7B%0A%20%20%20%20const%20rows%20%3D%20readGrammarStructuralProductions%28tokens%2C%20openingGroups%2C%20closingGroups%2C%20depthLimit%29%3B%0A%20%20%20%20let%20accepted%20%3D%20true%3B%0A%20%20%20%20for%20%28const%20row%20of%20rows%29%20%7B%0A%20%20%20%20%20%20const%20group%20%3D%20readRequiredNumberFact%28row%2C%200%29%3B%0A%20%20%20%20%20%20if%20%28group%20%3D%3D%3D%20-2%29%20return%20%5Brow%5D%3B%0A%20%20%20%20%20%20if%20%28group%20%3C%200%20%7C%7C%20%21productions.some%28previous%20%3D%3E%20testSameGrammarStructuralProduction%28previous%2C%20row%29%29%29%20accepted%20%3D%20false%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28accepted%29%20return%20%5B%5B-4%5D%5D%3B%0A%20%20%7D%0A%20%20return%20productions%3B%0A%7D%0A)