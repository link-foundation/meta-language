%40param%20%7Bboolean%7D%20rightReturns%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20mergeRustOwnedBindingStates%28left%2Cright%2CleftReturns%2CrightReturns%29%7B%0A%20if%28%21leftReturns%26%26%21rightReturns%29return%20%27unreachable%27%3B%0A%20if%28%21leftReturns%7C%7Cleft%3D%3D%3D%27absent%27%29return%20right%3B%0A%20if%28%21rightReturns%7C%7Cright%3D%3D%3D%27absent%27%29return%20left%3B%0A%20if%28left%3D%3D%3Dright%29return%20left%3B%0A%20return%20%27possibly%20moved%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%5B%5D%7D%20before%20%40param%20%7Bstring%5B%5D%7D%20after%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustOwnedBindingGuard%28before%2Cafter%29%7Bif%28before.length%21%3D%3Dafter.length%29return%20false%3Bfor%28let%20index%3D0%3Bindex%3Cbefore.length%3Bindex%2B%3D1%29if%28before%5Bindex%5D%21%3D%3Dafter%5Bindex%5D%29return%20false%3Breturn%20true%3B%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20state%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20expireRustOwnedBindingState%28state%29%7Breturn%20state%3D%3D%3D%27available%27%7C%7Cstate%3D%3D%3D%27possibly%20moved%27%3F%27dropped%27%3Astate%3B%7D%0A%0A%2F%2A%2A%20A%20result%20must%20be%20a%20tracked%20available%20owner%20or%20a%20constructed%2Fpreviously%0A%20%2A%20transferred%20temporary.%20%40param%20%7Bboolean%7D%20binding%20%40param%20%7Bboolean%7D%20available%0A%20%2A%20%40param%20%7Bboolean%7D%20transferred%20%40param%20%7Bboolean%7D%20fresh%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustOwnedResultTransfer%28binding%2Cavailable%2Ctransferred%2Cfresh%29%7Breturn%20binding%3Favailable%3Atransferred%7C%7Cfresh%3B%7D%0A%0A%2F%2A%2A%20Legacy%20boundary%20when%20no%20explicit%20loan-union%20provenance%20is%20supplied.%0A%20%2A%20%40param%20%7Bboolean%7D%20tracked%20%40param%20%7Bboolean%7D%20borrowed%20%40param%20%7Bboolean%7D%20named%0A%20%2A%20%40param%20%7Bboolean%7D%20same%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%