at%20host-field%20sequence.%0A%20%2A%20A%20negative%20comma-delimited%20result%20is%20an%20error%20code%20and%20its%20input%20offset.%0A%20%2A%20Output%20framing%20is%20transient%20ASCII%3A%20encoded%20bytes%20are%20hex%3B%20decoded%20fields%0A%20%2A%20are%20decimal%20words.%20No%20source%20buffer%20or%20token%20envelope%20is%20stored.%0A%20%2A%20Decode%20preserves%20the%20legacy%20version%3B%20v1%20has%20no%20exact%20cache%2Fallocator%20sections.%0A%20%2A%20%40param%20%7Bnumber%5B%5D%7D%20input%20%40param%20%7Bboolean%7D%20binary%20%40param%20%7Bnumber%7D%20recordLimit%20%40param%20%7Bnumber%7D%20byteLimit%20%40returns%20%7Bstring%7D%0A%20%2A%2F%0Aexport%20function%20transcodeLinkNetworkBinary%28input%2C%20binary%2C%20recordLimit%2C%20byteLimit%29%20%7B%0A%20%20const%20output%20%3D%20%5B%5D%3B%0A%20%20let%20outputLength%20%3D%200%3B%0A%20%20if%20%28%21acceptLinkNetworkBinaryInteger%28recordLimit%29%20%7C%7C%20recordLimit%20%3C%201%20%7C%7C%20%21acceptLinkNetworkBinaryInteger%28byteLimit%29%20%7C%7C%20byteLimit%20%3C%2016%29%20return%20%27-1%2C%27%20%2B%200%20%2B%20%27%2C%27%3B%0A%20%20if%20%28input.length%20%3E%20byteLimit%29%20return%20%27-2%2C%27%20%2B%200%20%2B%20%27%2C%27%3B%0A%20%20let%20cursor%20%3D%200%3B%0A%20%20let%20version%20%3D%200%3B%0A%20%20const%20header%20%3D%20%5B77%2C%2076%2C%2068%2C%2083%2C%2078%2C%2080%2C%2048%5D%3B%0A%20%20if%20%28binary%29%20%7B%0A%20%20%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%207%3B%20index%20%2B%3D%201%29%20if%20%28linkNetworkBinaryUnit%28input%2C%20index%29%20%21%3D%3D%20linkNetworkBinaryUnit%28header%2C%20index%29%29%20return%20%27-3%2C%27%20%2B%20index%20%2B%20%27%2C%27%3B%0A%20%20%20%20version%20%3D%20linkNetworkBinaryUnit%28input%2C%207%29%20-%2048%3B%0A%20%20%20%20cursor%20%3D%208%3B%0A%20%20%7D%20else%20%7B%0A%20%20%20%20version%20%3D%20linkNetworkBinaryUnit%28input%2C%20cursor%29%3B%0A%20%20%20%20cursor%20%2B%3D%201%3B%0A%20%20%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%207%3B%20index%20%2B%3D%