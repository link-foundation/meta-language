dge%5D%3BObject.assign%28loan.predecessor%2Cpin%28artifactText%29%29%3B%0A%20%20const%20descriptorValues%3Dnew%20Map%28%5B%5BartifactFile%2Cartifact%5D%2C%5BpolicyFile%2Cpolicy%5D%2C%5BregisterFile%2Cregister%5D%2C%5BloanFile%2Cloan%5D%5D%29%3B%0A%20%20for%28const%20%5Bfile%2Cvalue%5Dof%20descriptorValues%29%7Bif%28check%29checkProjectData%28new%20URL%28file%2Croot%29%2Cvalue%29%3Belse%20writeProjectData%28new%20URL%28file%2Croot%29%2Cvalue%29%3B%7D%0A%20%20const%20helperFile%3Dnew%20URL%28%27js%2Fscripts%2Fcurrent-translation-source-descriptors.mjs%27%2Croot%29%2Chelper%3DreadFileSync%28helperFile%2C%27utf8%27%29%3B%0A%20%20const%20expected%3Dhelper.replace%28%2Fconst%20policyHash%3D%27%5Ba-f0-9%5D%7B64%7D%27%3B%2Fu%2C%22const%20policyHash%3D%27%22%2Bdigest%28readFileSync%28new%20URL%28policyFile%2Croot%29%29%29%2B%22%27%3B%22%29%3B%0A%20%20if%28check%29assert.equal%28helper%2Cexpected%29%3Belse%20writeFileSync%28helperFile%2Cexpected%29%3B%0A%20%20const%20sources%3DsourceFiles.map%28file%3D%3E%7B%0A%20%20%20%20const%20%7Bsource%3AsourceText%2Ccertificate%7D%3Doriginals.get%28file%29%2Ccurrent%3DreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20%20%20let%20start%3D0%2Cend%3DsourceText.length%2Cfinish%3Dcurrent.length%3B%0A%20%20%20%20while%28start%3Cend%26%26start%3Cfinish%26%26sourceText%5Bstart%5D%3D%3D%3Dcurrent%5Bstart%5D%29start%2B%2B%3B%0A%20%20%20%20while%28end%3Estart%26%26finish%3Estart%26%26sourceText%5Bend-1%5D%3D%3D%3Dcurrent%5Bfinish-1%5D%29%7Bend--%3Bfinish--%3B%7D%0A%20%20%20%20const%20edit%3D%7Bstart%3ABuffer.byteLength%28current.slice%280%2Cstart%29%29%2Cend%3ABuffer.byteLength%28current.slice%280%2Cfinish%29%29%2CcurrentText%3Acurrent.slice%28start%2Cfinish%29%2CpreviousText%3AsourceText.slice%28start%2Cend%29%7D%3B%0A%20%20%20%20const%20bytes%3DBuffer.from%28current%29%2Crestored%3DBuffer.concat%28%5Bbytes.subarray%280%2Cedit.start%29%2CBuffer.from%28edit.previousText%29%2Cbytes.subarray%28edit.end%29%5D%29%3B%0A%20%20%20%20assert.equal%28restored.toString%28%29%2CsourceText%29%3Bassert.deepEqual%28pin%28restored%29%2Cpin%28sourceText%29%29%3B%0A%20%20%20%20return%7Bfile%2Ccommit%3Arevision%2C...pin%28sourceText%29%2CsourceText%2Ccertificate%2Ccurrent%3Apin%28current%29%2Cedit%2Crole%3Adescriptors.includes%28file%29%3F%27historical%20descriptor%27%3A%27historical%20source%27%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3A1%2Crevision%2Csources%2CdescriptorChanges%3Achanges%2C%0A%20%20%20%20assertionCorrection%3A%7Bfile%3A%27js%2Ftests%2Ftranslation-string-relative-character.test.js%27%2Cinput%3A%27%2F%2A%2A%20%40param%20%7Bnumber%5B%5D%7D%20values%20%40returns%20%7Bnumber%7Cundefined%7D%20%2A%2Ffunction%20last%28values%29%7Breturn%20values.at%28-1%29%3B%7D%27%2C%0A%20%20%20%20%20%20authority%3A%27https%3A%2F%2Ftc39.es%2Fecma262%2Fmultipage%2Findexed-collections.html%23sec-array.prototype.at%27%2ClanguageVersions%3A%7Bminimum%3A%272022%27%2CmaximumExclusive%3A%272027%27%7D%2C%0A%20%20%20%20%20%20reason%3A%27The%20complete%20relative%20array%20lambda%20now%20executes%20the%20original%20standard%20operation.%20Keep%20the%20original%20input%20and%20predecessor%20source%3B%20require%20its%20independently%20observed%20present%20and%20absent%20results.%27%7D%2C%0A%20%20%20%20boundary%3A%27Whole%20predecessor%20sources%20and%20descriptors%20only.%20Every%20recorded%20native%20definition%20ABI%20owner%20replay%20archive%20and%20original%20assertion%20remains.%20Current%20execution%20and%20descriptor%20gates%20read%20current%20data%3B%20historical%20views%20invert%20only%20complete%20authenticated%20inputs.%20No%20native%20execution%20or%20global%20equivalence%20claim.%27%7D%3B%0A%20%20const%20file%3Dnew%20URL%28%27parity%2Fself-translation%2Farray-relative-element-history.lino%27%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28file%2Chistory%29%3Belse%20writeProjectData%28file%2Chistory%29%3B%0A%20%20const%20adapter%3Dnew%20URL%28%27js%2Fscripts%2Farray-relative-element-