%28current.includes%28%27sourceText%3AreadNativeSourceByteRange%28sinkBytes%2Citem.start%2Citem.end%29%27%29%29%3B%0A%20%20assert.ok%28current.includes%28%27sourceText%3AreadNativeSourceByteRange%28parentBytes%2Cfound%5B0%5D.start%2Cfound%5B0%5D.end%29%27%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28original.certificate%2CBuffer.from%28original.sourceText%2B%27%5Cn%27%29%2C%7Brevision%3Ahistory.revision%2Cpath%3Aoriginal.file%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28original.certificate%2CBuffer.from%28original.sourceText%29%2C%7Brevision%3Ahistory.revision%2Cpath%3A%27other.mjs%27%7D%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27all%20preceding%20native%20operations%20fixture%20bytes%20and%20complete%20Links%20receipt%20survive%20without%20weaker%20assertions%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DreadProjectData%28new%20URL%28%27parity%2Fself-translation%2Foriginal-number-source-range-history.lino%27%2Croot%29%29%3B%0A%20%20assert.equal%28history.unchanged.length%2C4%29%3B%0A%20%20for%28const%20row%20of%20history.unchanged%29assert.deepEqual%28pin%28readFileSync%28new%20URL%28row.file%2Croot%29%29%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20const%20before%3Dhistory.previousReceipt%2Cbytes%3DBuffer.from%28before.sourceText%29%3B%0A%20%20verifyGitArtifactCertificate%28before.certificate%2Cbytes%2C%7Brevision%3Ahistory.revision%2Cpath%3Abefore.file%7D%29%3B%0A%20%20assert.deepEqual%28pin%28bytes%29%2C%7Bbytes%3Abefore.bytes%2Csha256%3Abefore.sha256%7D%29%3B%0A%20%20const%20previous%3DreadStructuredDataLino%28before.sourceText%29%2Ccurrent%3DreadProjectData%28new%20URL%28before.file%2Croot%29%29%3B%0A%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28before.file%2Croot%29%29%29%2Chistory.currentReceipt%29%3B%0A%20%20assert.equal%28current.byteRangeReader.file%2C%27js%2Fscripts%2Fnative-source-byte-ranges.mjs%27%29%3B%0A%20%20assert.deepEqual%28pin%28readFileSync%28new%20URL%28current.byteRangeReader.file%2Croot%29%29%29%2C%7Bbytes%3Acurrent.byteRangeReader.bytes%2Csha256%3Acurrent.byteRangeReader.sha256%7D%29%3B%0A%20%20const%20inverse%3DstructuredClone%28current%29%3Binverse.author%3Dprevious.author%3Bdelete%20inverse.byteRangeReader%3B%0A%20%20assert.deepEqual%28inverse%2Cprevious%29%3Bassert.equal%28serializeProjectData%28inverse%2Cbefore.file%29%2Cbefore.sourceText%29%3B%0A%20%20for%28const%20key%20of%20%5B%27inputs%27%2C%27sourceInventory%27%2C%27wirePlan%27%2C%27originalVisitors%27%2C%27trait%27%2C%27jsonVisitor%27%2C%27observationDeclaration%27%2C%27observationMethod%27%2C%27storage%27%2C%27inherent%27%2C%27implementation%27%2C%27relocation%27%2C%27rawModel%27%2C%27outputs%27%2C%27limits%27%2C%27counterBoundary%27%5D%29%0A%20%20%20%20assert.deepEqual%28current%5Bkey%5D%2Cprevious%5Bkey%5D%2Ckey%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
