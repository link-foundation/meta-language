(10215: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Engine%20behind%20scripts%2Fclean-caches.mjs%3A%20discovers%20the%20cache%20classes%20of%0A%2F%2F%20cache-classes.mjs%2C%20keeps%20only%20candidates%20that%20are%20provably%20regenerable%2C%20and%0A%2F%2F%20removes%20them%20within%20the%20disk%20budget.%20See%20docs%2Fcache-cleanup.md.%0A%2F%2F%0A%2F%2F%20A%20candidate%20is%20removed%20only%20when%20every%20check%20passes%3A%0A%2F%2F%20-%20it%20is%20not%20a%20symlink%20and%20its%20real%20path%20is%20its%20own%20path%2C%20so%20nothing%20escapes%0A%2F%2F%20%20%20through%20a%20link%3B%0A%2F%2F%20-%20it%20lies%20inside%20this%20worktree%2C%20inside%20a%20Cargo%20target%20directory%20the%20caller%0A%2F%2F%20%20%20named%20explicitly%20%28recognized%20by%20CACHEDIR.TAG%29%2C%20or%20is%20a%20temporary%20directory%0A%2F%2F%20%20%20this%20repository%20marked%20as%20scratch%20and%20whose%20creator%20has%20exited%3B%0A%2F%2F%20-%20git%20reports%20it%20ignored%2C%20and%20no%20tracked%20file%20lies%20under%20it%2C%20so%20source%2C%0A%2F%2F%20%20%20vendored%20grammars%2C%20fixtures%2C%20proofs%2C%20corpora%20and%20uncommitted%20work%20stay%3B%0A%2F%2F%20-%20it%20is%20not%20evidence%20%28results%20other%20than%20their%20%60work%60%20scratch%2C%20artifacts%2C%0A%2F%2F%20%20%20logs%29%20and%20holds%20no%20other%20worktree%3B%0A%2F%2F%20-%20no%20build%20is%20active%20on%20it%3A%20no%20live%20lease%2C%20and%20no%20Cargo%20lock%20held.%0Aimport%20%7B%20execFileSync%2C%20spawnSync%20%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7B%20randomUUID%20%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7B%0A%20%20existsSync%2C%0A%20%20linkSync%2C%0A%20%20lstatSync%2C%0A%20%20mkdirSync%2C%0A%20%20readdirSync%2C%0A%20%20readFileSync%2C%0A%20%20readlinkSync%2C%0A%20%20realpathSync%2C%0A%20%20renameSync%2C%0A%20%20rmSync%2C%0A%20%20statSync%2C%0A%20%20statfsSync%2C%0A%20%20writeFileSync%2C%0A%7D%20from%20%27node%3Afs%27%3B%0Aimport%20os%20from%20%27node%3Aos%27%3B%0Aimport%20path%20from%20%27node%3Apath%27%3B%0Aimport%20%7B%20processIdentity%2C%20processIdentityAlive%2C%20sameProcess%20%7D%20from%20%27.%2Fprocess-identity.mjs%27%3B%0Aimport%20%7B%20readBootstrapStructuredDataRecords%2C%20structuredDataRecordToLino%2C%20structuredDataToLino%20%7D%20from%20%27.%2Fstructured-data-bootstrap.mjs%27%3B%0A%0Aimport%20%7B%0A%20%20BUILDKIT_BUILDER%2C%0A%20%20CACHE_CLASSES%2C%0A%20%20CONTAINER_LABEL%2C%0A%20%20isCargoTargetDirectory%2C%0A%7D%20from%20%27.%2Fcache-classes.mjs%27%3B%0A%0Aexport%20const%20DEFAULT_BUDGET_MB%20%3D%204096%3B%0Aexport%20const%20DEFAULT_MIN_FREE_MB%20%3D%202048%3B%0Aconst%20MB%20%3D%201024%20%2A%201024%3B%0Aconst%20HISTORY_LIMIT%20%3D%20200%3B%0Aconst%20DEFAULT_RESULTS_DIRECTORIES%20%3D%20%5B%27issue-195-results%27%5D%3B%0Aconst%20PROTECTED_DIRECTORIES%20%3D%20%5B%27issue-195-artifacts%27%2C%20%27ci-logs%27%2C%20%27logs%27%2C%20%27dev%2Flog%27%2C%20%27docs%27%2C%20%27parity%27%2C%20%27.git%27%5D%3B%0Aconst%20CARGO_LOCK_BUSY%20%3D%2075%3B%0A%0A%2F%2A%2A%20Runs%20git%20and%20returns%20stdout%2C%20or%20null%20when%20git%20is%20missing%20or%20fails.%20%2A%2F%0Afunction%20git%28cwd%2C%20args%29%20%7B%0A%20%20try%20%7B%0A%20%20%20%20return%20execFileSync%28%27git%27%2C%20args%2C%20%7B%20cwd%2C%20encoding%3A%20%27utf8%27%2C%20stdio%3A%20%5B%27ignore%27%2C%20%27pipe%27%2C%20%27ignore%27%5D%20%7D%29%3B%0A%20%20%7D%20catch%20%7B%0A%20%20%20%20return%20null%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20Real%20path%2C%20or%20the%20resolved%20path%20when%20it%20does%20not%20exist.%20%2A%2F%0Afunction%20real%28candidate%29%20%7B%0A%20%20try%20%7B%0A%20%20%20%20return%20realpathSync%28candidate%29%3B%0A%20%20%7D%20catch%20%7B%0A%20%20%20%20return%20path.resolve%28candidate%29%3B%0A%20%20%7D%0A%7D%0A%0Aconst%20inside%20%3D%20%28child%2C%20parent%29%20%3D%3E%20child%20%3D%3D%3D%20parent%20%7C%7C%20child.startsWith%28parent.endsWith%28path.sep%29%20%3F%20parent%20%3A%20parent%20%2B%20path.sep%29%3B%0Aconst%20strictlyInside%20%3D%20%28child%2C%20parent%29%20%3D%3E%20child%20%21%3D%3D%20parent%20%26%26%20inside%28child%2C%20parent%29%3B%0Aconst%20toPosix%20%3D%20%28relative%29%20%3D%3E%20relative.split%28path.sep%29.join%28%27%2F%27%29%3B%0A%0A%2F%2A%2A%20Whether%20a%20process%20id%20belongs%20to%20a%20live%20process.%20%2A%2F%0Aexport%20function%20processAlive%28pid%29%20%7B%0A%20%20return%20processIdentityAlive%28%7B%20pid%20%7D%29%3B%0A%7D%0A%0A%2F%2A%2A%20The%20worktree%20root%20and%20its%20git%20directories%2C%20or%20null%20outside%20a%20git%20worktree.%20%2A%2F%0Aexport%20function%20resolveRepository%28cwd%29%20%7B%0A%20%20const%20top%20%3D%20git%28cwd%2C%20%5B%27rev-parse%27%2C%20%27--show-toplevel%27%5D%29%3B%0A%20%20const%20gitDirectory%20%3D%20git%28cwd%2C%20%5B%27rev-parse%27%2C%20%27--absolute-git-dir%27%5D%29%3B%0A%20%20if%20%28%21top%20%7C%7C%20%21gitDirectory%29%20return%20null%3B%0A%20%20const%20root%20%3D%20real%28top.trim%28%29%29%3B%0A%20%20const%20gitDir%20%3D%20real%28gitDirectory.trim%28%29%29%3B%0A%20%20return%20%7B%20root%2C%20gitDir%2C%20stateDir%3A%20path.join%28gitDir%2C%20%27meta-language-cache%27%29%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Rejects%20user-supplied%20paths%20that%20climb%20with%20%60..%60%2C%20before%20anything%20resolves%20them.%20%2A%2F%0Aexport%20function%20assertNoTraversal%28value%2C%20flag%29%20%7B%0A%20%20if%20%28value.split%28%2F%5B%5C%5C%2F%5D%2B%2Fu%29.includes%28%27..%27%29%29%20%7B%0A%20%20%20%20throw%20new%20UsageError%28%60%24%7Bflag%7D%20must%20not%20contain%20%27..%27%20path%20segments%3A%20%24%7Bvalue%7D%60%29%3B%0A%20%20%7D%0A%20%20return%20value%3B%0A%7D%0A%0Aexport%20class%20UsageError%20extends%20Error%20%7B%7D%0A%0A%2F%2F%20Leases%20mark%20active%20builds%2C%20tests%20and%20acceptance%20runs%20of%20this%20worktree.%0A%2F%2F%20Their%20JSON%20identity%20is%20a%20coordination%20protocol%3A%20older%20active%20cleanup%0A%2F%2F%20processes%20must%20recognize%20these%20leases%20and%20the%20cleanup.lock%20owner%20below.%0A%0Aconst%20leaseDirectory%20%3D%20%28stateDir%29%20%3D%3E%20path.join%28stateDir%2C%20%27leases%27%29%3B%0A%0A%2F%2A%2A%20Records%20that%20%60pid%60%20is%20building%20in%20this%20worktree%20until%20the%20lease%20is%20released.%20%2A%2F%0Aexport%20function%20acquireLease%28%7B%20cwd%20%3D%20process.cwd%28%29%2C%20label%20%3D%20%27build%27%2C%20pid%20%3D%20process.pid%20%7D%20%3D%20%7B%7D%29%20%7B%0A%20%20const%20repository%20%3D%20resolveRepository%28cwd%29%3B%0A%20%20if%20%28%21repository%29%20return%20%7B%20file%3A%20null%2C%20release%28%29%20%7B%7D%20%7D%3B%0A%20%20const%20directory%20%3D%20leaseDirectory%28repository.stateDir%29%3B%0A%20%20mkdirSync%28directory%2C%20%7B%20recursive%3A%20true%20%7D%29%3B%0A%20%20const%20file%20%3D%20path.join%28directory%2C%20%60%24%7Bpid%7D-%24%7BDate.now%28%29.toString%2836%29%7D-%24%7BMath.random%28%29.toString%2836%29.slice%282%2C%208%29%7D.json%60%29%3B%0A%20%20writeFileSync%28file%2C%20%60%24%7BJSON.stringify%28%7B%20...processIdentity%28pid%29%2C%20label%2C%20root%3A%20repository.root%2C%20createdAt%3A%20new%20Date%28%29.toISOString%28%29%20%7D%29%7D%5Cn%60%29%3B%0A%20%20return%20%7B%0A%20%20%20%20file%2C%0A%20%20%20%20release%28%29%20%7B%0A%20%20%20%20%20%20rmSync%28file%2C%20%7B%20force%3A%20true%20%7D%29%3B%0A%20%20%20%20%7D%2C%0A%20%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%20Live%20leases%20of%20other%20processes%3B%20stale%20leases%20are%20removed.%20%2A%2F%0Aexport%20function%20liveLeases%28stateDir%29%20%7B%0A%20%20const%20directory%20%3D%20leaseDirectory%28stateDir%29%3B%0A%20%20const%20leases%20%3D%20%5B%5D%3B%0A%20%20let%20entries%20%3D%20%5B%5D%3B%0A%20%20try%20%7B%0A%20%20%20%20entries%20%3D%20readdirSync%28directory%29%3B%0A%20%20%7D%20catch%20%7B%0A%20%20%20%20return%20leases%3B%0A%20%20%7D%0A%20%20for%20%28const%20name%20of%20entries%29%20%7B%0A%20%20%20%20const%20file%20%3D%20path.join%28directory%2C%20name%29%3B%0A%20%20%20%20let%20lease%3B%0A%20%20%20%20try%20%7B%0A%20%20%20%20%20%20lease%20%3D%20JSON.parse%28readFileSync%28file%2C%20%27utf8%27%29%29%3B%0A%20%20%20%20%7D%20catch%20%7B%0A%20%20%20%20%20%20continue%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28sameProcess%28lease%2C%20processIdentity%28%29%29%29%20continue%3B%0A%20%20%20%20if%20%28processIdentityAlive%28lease%29%29%20leases.push%28lease%29%3B%0A%20%20%20%20else%20rmSync%28file%2C%20%7B%20force%3A%20true%20%7D%29%3B%0A%20%20%7D%0A%20%20return%20leases%3B%0A%7D%0A%0A%2F%2F%20The%20cleanup%20lock%20serializes%20concurrent%20cleanups%20of%20one%20worktree.%20The%20lock%0A%2F%2F%20file%20appears%20with%20its%20holder%27s%20pid%20already%20in%20it%20%28a%20hard%20link%20of%20a%20written%0A%2F%2F%20temporary%20file%29%2C%20so%20a%20contender%20never%20reads%20a%20half-written%20lock%2C%20and%20only%0A%2F%2F%20the%20contender%20holding%20the%20%60.break%60%20guard%20may%20remove%20a%20stale%20lock.%0A%0Aconst%20STALE_GUARD_MS%20%3D%2060_000%3B%0A%0A%2F%2A%2A%20Creates%20%60file%60%20holding%20this%20pid%2C%20or%20returns%20false%20when%20it%20already%20exists.%20%2A%2F%0Afunction%20createLockFile%28file%29%20%7B%0A%20%20const%20owner%20%3D%20processIdentity%28%29%3B%0A%20%20const%20temporary%20%3D%20%60%24%7Bfile%7D.%24%7Bowner.pid%7D-%24%7BrandomUUID%28%29%7D.tmp%60%3B%0A%20%20const%20identity%20%3D%20%60%24%7BJSON.stringify%28owner%29%7D%5Cn%60%3B%0A%20%20writeFileSync%28temporary%2C%20identity%29%3B%0A%20%20try%20%7B%0A%20%20%20%20linkSync%28temporary%2C%20file%29%3B%0A%20%20%20%20return%20true%3B%0A%20%20%7D%20catch%20%28error%29%20%7B%0A%20%20%20%20if%20%28error.code%20%3D%3D%3D%20%27EEXIST%27%29%20return%20false%3B%0A%20%20%20%20if%20%28%21%5B%27EPERM%27%2C%20%27ENOTSUP%27%2C%20%27EOPNOTSUPP%27%2C%20%27ENOSYS%27%5D.includes%28error.code%29%29%20throw%20error%3B%0A%20%20%20%20%2F%2F%20File%20systems%20without%20hard%20links%20fall%20back%20to%20an%20exclusive%20create.%0A%20%20%20%20try%20%7B%0A%20%20%20%20%20%20writeFileSync%28file%2C%20identity%2C%20%7B%20flag%3A%20%27wx%27%20%7D%29%3B%0A%20%20%20%20%20%20return%20true%3B%0A%20%20%20%20%7D%20catch%2