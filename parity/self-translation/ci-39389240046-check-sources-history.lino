dNativeSourceByteRange%28sinkBytes%2Citem.start%2Citem.end%29%27%29%29%3B%0A%20%20assert.ok%28current.includes%28%27sourceText%3AreadNativeSourceByteRange%28parentBytes%2Cfound%5B0%5D.start%2Cfound%5B0%5D.end%29%27%29%29%3B%0A%20%20const%20receiptFile%3D%27parity%2Fself-translation%2Foriginal-native-number-observations.lino%27%3B%0A%20%20const%20before%3DcaptureGitArtifactCertificate%28revision%2CreceiptFile%29%2Cprevious%3DreadStructuredDataLino%28before.blob.toString%28%27utf8%27%29%29%3B%0A%20%20verifyGitArtifactCertificate%28before.certificate%2Cbefore.blob%2C%7Brevision%2Cpath%3AreceiptFile%7D%29%3B%0A%20%20const%20after%3DreadProjectData%28new%20URL%28receiptFile%2Croot%29%29%2Cinverse%3DstructuredClone%28after%29%3B%0A%20%20assert.ok%28inverse.byteRangeReader%29%3Binverse.author%3Dprevious.author%3Bdelete%20inverse.byteRangeReader%3B%0A%20%20assert.deepEqual%28inverse%2Cprevious%2C%27all%20original%20source%20inputs%20numeric%20validation%20and%20native%20output%20metadata%20remain%20exact%27%29%3B%0A%20%20assert.ok%28Buffer.from%28serializeProjectData%28inverse%2CreceiptFile%29%29.equals%28before.blob%29%2C%27the%20complete%20original%20Links%20receipt%20survives%20its%20exact%20byte%20inverse%27%29%3B%0A%20%20const%20unchangedFiles%3D%5B%27rust%2Ftests%2Funit%2Fnative_json_number_observation_model.rs%27%2C%27rust%2Ftests%2Funit%2Fnative_json_number_observation_visitors.rs%27%2C%0A%20%20%20%20%27parity%2Ffixtures%2Foriginal-native-number-observations.lino%27%2C%27parity%2Fself-translation%2Foriginal-native-number-observation-decorators.lino%27%5D%3B%0A%20%20const%20unchanged%3DunchangedFiles.map%28file%3D%3E%7B%0A%20%20%20%20const%20previous%3DcaptureGitArtifactCertificate%28revision%2Cfile%29%2Ccurrent%3DreadFileSync%28new%20URL%28file%2Croot%29%29%3B%0A%20%20%20%20assert.ok%28current.equals%28previous.blob%29%2C%27every%20complete%20native%20operation%20and%20original%20fixture%20byte%20remains%20unchanged%3A%20%27%2Bfile%29%3B%0A%20%20%20%20return%7Bfile%