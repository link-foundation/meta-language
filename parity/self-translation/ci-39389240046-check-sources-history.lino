0Vec%3CVec%3Cf64%3E%3E%29%20-%3E%20Vec%3Cf64%3E%20%7B%27%29%3B%0A%20%20assert.equal%28source.split%28receipt.publicEntryHeader%29.length%2C2%29%3B%0A%20%20assert.equal%28receipt.nativeCompilation%2Cfalse%29%3Bassert.equal%28receipt.nativeExecution%2Cfalse%29%3B%0A%20%20assert.deepEqual%28readOriginalLinkRawBorrowedProfile%28stored.predecessor%29%2Cprofile%29%3B%0A%20%20assert.deepEqual%28readFileSync%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%29%2Cbefore%29%3B%0A%20%20%2F%2F%20Regeneration%20may%20refresh%20the%20containing%20artifact%20descriptor%20only.%20Keep%0A%20%20%2F%2F%20the%20complete%20earlier%20loan%20receipt%2C%20every%20style%20and%20emitted%20byte%20exact.%0A%20%20const%20file%3D%27experiments%2Foriginal-link-complete-table-projection%2Fdata%2Fraw-borrowed-parameter-receipt.lino%27%3B%0A%20%20const%20previousBytes%3DverifyGitArtifactCertificate%28%0A%20%20%20%20readProjectData%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fhistorical%2Fgit-raw-borrowed-18a8e0a0-proof.lino%27%2Cimport.meta.url%29%29%2C%0A%20%20%20%20readFileSync%28new%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fhistorical%2Fgit-raw-borrowed-18a8e0a0.lino%27%2Cimport.meta.url%29%29%2C%0A%20%20%20%20%7Brevision%3A%2718a8e0a04bab43f6572be311ceb75c6596fdc147%27%2Cpath%3Afile%7D%29%3B%0A%20%20const%20previous%3DreadStructuredDataLino%28previousBytes.toString%28%27utf8%27%29%29%3B%0A%20%20assert.deepEqual%28receipt.predecessor%2C%7B...previous.predecessor%2Cbytes%3Abefore.length%2C%0A%20%20%20%20sha256%3AcreateHash%28%27sha256%27%29.update%28before%29.digest%28%27hex%27%29%7D%29%3B%0A%20%20const%20inverse%3D%7B...receipt%2Cpredecessor%3Aprevious.predecessor%7D%3B%0A%20%20assert.deepEqual%28inverse%2Cprevious%29%3B%0A%20%20assert.deepEqual%28Buffer.from%28structuredDataToLino%28inverse%29%29%2CpreviousBytes%29%3B%0A%7D%29%3B%0A%0Atest%28%27raw%20immutable%20parameter%20loans%20reject%20changed%20predecessor%20bytes%20and%20actual%20mechanical%20decision%20sources%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20stored%3DreadProjectData%28ORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%29%3B%0A%20%20const%20predecessor%3DreadOriginalLinkRawConsumingProfile%28stored.predecessor%29%3B%0A%20%20for%28const%20file%20of%20%5BORIGINAL_LINK_RAW_CONSUMING_ARTIFACT%2Cnew%20URL%28%27..%2F..%2Fjs%2Fscripts%2Fportable-source-library-style.mjs%27%2Cimport.meta.url%29%5D%29%20%7B%0A%20%20%20%20assert.throws%28%28%29%3D%3EprepareOriginalLinkRawBorrowedEmission%28predecessor%2C%7Bread%3Apath%3D%3E%7B%0A%20%20%20%20%20%20const%20bytes%3DreadFileSync%28path%29%3Breturn%20String%28path%29%3D%3D%3DString%28file%29%3FBuffer.concat%28%5Bbytes%2CBuffer.from%28%27%5Cn%27%29%5D%29%3Abytes%3B%0A%20%20%20%20%7D%7D%29%2C%2Fcomplete%20consuming%20predecessor%20bytes%20changed%7Cproject%20data%20is%20stale%2Fu%29%3B%0A%20%20%7D%0A%20%20const%20changed%3DstructuredClone%28predecessor%29%3Bchanged.sourceSha256%3D%270%27.repeat%2864%29%3B%0A%20%20assert.throws%28%28%29%3D%3EprepareOriginalLinkRawBorrowedEmission%28changed%29%2Cassert.AssertionError%29%3B%0A%7D%29%3B%0A%0Atest%28%27raw%20loan%20native%20planning%20remains%20CI-only%20and%20cannot%20launch%20a%20detached%20checked%20plan%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20await%20assert.rejects%28planOriginalLinkRawBorrowedNative%28%7B%7D%2C%7B%7D%29%2C%2FCI%2Fu%29%3B%0A%20%20await%20assert.rejects%28planOriginalLinkRawBorrowedNative%28%7B%7D%2C%7BCI%3A%27true%27%2CORIGINAL_LINK_RAW_NATIVE%3A%271%27%7D%29%2C%2Fexact%20checked%20consuming%20plan%2Fu%29%3B%0A%7D%29%3B%0A%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27..%2F..%2Fjs%2Fscripts%2Fgit-object-certificate.mjs%27%3B%0A) (lang: meta-language%20structured%20data)))
