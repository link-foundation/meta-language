m%20%7Bstring%7D%20binding%20%40param%20%7Bstring%7D%20expression%20%40param%20%7Bstring%7D%20receiver%0A%20%2A%20%40param%20%7Bnumber%7D%20pathLength%20%40param%20%7Bstring%7D%20following%0A%20%2A%20%40param%20%7Bboolean%7D%20parserOwned%20%40param%20%7Bboolean%7D%20fresh%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptOwnedArrayIterationBorrowShape%28block%2C%20inline%2C%20statements%2C%20binding%2C%20expression%2C%20receiver%2C%20pathLength%2C%20following%2C%20parserOwned%2C%20fresh%29%20%7B%0A%20%20return%20block%20%3D%3D%3D%20%27block%27%20%26%26%20%21inline%20%26%26%20statements%20%3D%3D%3D%202%20%26%26%20binding%20%3D%3D%3D%20%27const%27%0A%20%20%20%20%26%26%20expression%20%3D%3D%3D%20%27forOfIterable%27%20%26%26%20receiver%20%3D%3D%3D%20%27name%27%20%26%26%20pathLength%20%3D%3D%3D%201%0A%20%20%20%20%26%26%20following%20%3D%3D%3D%20%27for%27%20%26%26%20parserOwned%20%26%26%20fresh%3B%0A%7D%0A%0A%2F%2A%2A%20Scoped%20borrows%20end%20only%20when%20their%20actual%20closed%20source%20block%20leaves.%0A%20%2A%20Every%20unknown%20alias%2Fcapture%2Fcall%20remains%20a%20permanent%20ordinary%20escape.%0A%20%2A%20%40param%20%7Bnumber%7D%20position%20%40param%20%7Bnumber%5B%5D%7D%20starts%20%40param%20%7Bnumber%5B%5D%7D%20ends%0A%20%2A%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptOwnedArrayBorrowedAppend%28position%2C%20starts%2C%20ends%29%20%7B%0A%20%20if%20%28%21%28position%20%3E%3D%200%20%26%26%20position%20%25%201%20%3D%3D%3D%200%29%20%7C%7C%20starts.length%20%21%3D%3D%20ends.length%29%20return%20false%3B%0A%20%20for%20%28let%20at%20%3D%200%3B%20at%20%3C%20starts.length%3B%20at%20%2B%3D%201%29%20%7B%0A%20%20%20%20const%20start%20%3D%20readRequiredNumberFact%28starts%2C%20at%29%2C%20end%20%3D%20readRequiredNumberFact%28ends%2C%20at%29%3B%0A%20%20%20%20if%20%28%21%28start%20%3E%3D%200%20%26%26%20start%20%25%201%20%3D%3D%3D%200%20%26%26%20end%20%3E%20start%20%26%26%20end%20%25%201%20%3D%3D%3D%200%29%29%20return%20false%3B%0A%20%20%20%20if%20%28start%20%3C%3D%20position%20%26%26%20position%20%3C%20end%29%20return%20false%3B%0A%20%20%7D%0A%20%20return%20true%3B%0A%7D%0A%0A%0A%2F%2F%20Complete%20typed%20domain%20selection%20supplements%20the%20unchanged%20scalar%20contract.%0A%0A%2F%2A%2A%20Distinct%20primitive%20domains%20cannot%20contain%20a%20shared%20input%20array%20identity.%0A%20%2A%20Integer%20refinements%20stay%20in%20the%20same%20domain.%20Optional%2Fcompound%2Funknown%0A%20%2A%20elements%20retain%20their%20alias%20obligations.%20%40param%20%7Bstring%7D%20kind%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readOwnedArrayReaderElementDomain%28kind%29%7B%0A%20if%28kind%3D%3D%3D%27float%27%29return%20%27Number%27%3B%0A%20if%28kind%3D%3D%3D%27int%27%7C%7Ckind%3D%3D%3D%27nat%27%7C%7Ckind%3D%3D%3D%27fixed%27%29return%20%27integer%27%3B%0A%20if%28kind%3D%3D%3D%27string%27%7C%7Ckind%3D%3D%3D%27bool%27%29return%20kind%3B%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20Source%20bodies%20must%20still%20pass%20every%20original%20occurrence%2Fescape%20check%20and%0A%20%2A%20their%20complete%20declared%20types%20must%20subsequently%20check.%20This%20selection%20does%0A%20%2A%20not%20admit%20arbitrary%20readers%20by%20name%2C%20return%20shape%20or%20observed%20examples.%0A%20%2A%20%40param%20%7Bstring%7D%20result%20%40param%20%7Bstring%7D%20resultElement%20%40param%20%7Bstring%7D%20parameter%0A%20%2A%20%40param%20%7Bstring%7D%20parameterElement%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptOwnedArrayReaderDomain%28result%2CresultElement%2Cparameter%2CparameterElement%29%7B%0A%20if%28acceptOwnedArrayReaderResult%28result%29%29return%20true%3B%0A%20if%28result%21%3D%3D%27array%27%7C%7Cparameter%21%3D%3D%27array%27%29return%20false%3B%0A%20const%20left%3DreadOwnedArrayReaderElementDomain%28resultElement%29%2Cright%3DreadOwnedArrayReaderElementDomain%28parameterElement%29%3B%0A%20return%20left%21%3D%3D%27%27%26%26right%21%3D%3D%27%27%26%26left%21%3D%3Dright%3B%0A%7D%0A) (lang: 