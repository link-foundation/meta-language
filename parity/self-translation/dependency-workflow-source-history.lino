e%2Cafter%3AobservedStorage%7D%2Cinherent%3ArenamedInherent%2Cimplementation%3A%7B...renamedImplementation%2Cafter%3AobservedImplementation%7D%2C%0A%20%20%20%20relocation%2CrawModel%3Araw%2Coutputs%3Aoutputs.map%28%28%7Bfile%2Csource%7D%29%3D%3E%28%7Bfile%2C...pin%28source%29%7D%29%29%2C%0A%20%20%20%20limits%3A%7BnodeLimit%3A100000%2CbyteLimit%3A16%2A1024%2A1024%2CdepthLimit%3A256%7D%2C%0A%20%20%20%20counterBoundary%3A%27The%20complete%20original%20allocation-free%20preflight%20precedes%20observation%20construction.%20Primitive%20usize%20and%20i64%20conversion%20calls%20retain%20json_number%3B%20only%20original%20serde_json%3A%3AValue%3A%3ANumber%20uses%20native_json_number.%20Raw%20predicate%20and%20payload%20accessors%20execute%20before%20the%20unchanged%20projection%20validator.%27%7D%7D%3B%0A%7D%0A%0Aimport%20%7BrestoreCurrentCiRepairSource%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fcurrent-ci-repair-source-history.mjs%27%3B%0A%0Aexport%20function%20generateOriginalNativeNumberObservations%28%7Bcheck%3Dfalse%7D%3D%7B%7D%29%20%7B%0A%20%20const%20lockSource%3DreadFileSync%28new%20URL%28%27rust%2FCargo.lock%27%2Croot%29%2C%27utf8%27%29%2Cpackages%3DparseCargoLock%28lockSource%29.filter%28row%3D%3Erow.name%3D%3D%3D%27serde_json%27%29%3B%0A%20%20assert.equal%28packages.length%2C1%29%3Bassert.equal%28packages%5B0%5D.version%2C%271.0.151%27%2C%27uncovered%20native%20number%20expectation%20dependency%20version%27%29%3B%0A%20%20const%20result%3DbuildOriginalNativeNumberObservations%28%29%3B%0A%20%20const%20styleFile%3Dnew%20URL%28%27..%2F..%2F..%2F..%2Fparity%2Fself-translation%2Foriginal-native-number-observation-decorators.lino%27%2Cimport.meta.url%29%3B%0A%20%20if%28check%29assert.equal%28readFileSync%28styleFile%2C%27utf8%27%29%2Cresult.decorators.toLino%28%29%29%3Belse%20writeFileSync%28styleFile%2Cresult.decorators.toLino%28%29%29%3B%0A%20%20for%28const%20row%20of%20result.outputs%29%7Bconst%20file%3Dnew%20URL%28row.file%2Croot%29%3Bif%28check%29assert.equal%28readFileSync%28file%2C%27utf8%27%29%2Crow.source%29%3Belse%20writeFileSync%28file%2Crow.source%29%3B%7D%0A%20%20const%20values%3D%5B0%2C-1%2C2%2A%2A60%2C-0%2C1.5%2CNumber.MIN_VALUE%5D%3B%0A%20%20const%20native%3D%7Bok%3Atrue%2Ctree%3A%7B%24variant%3A%27Token%27%2Ckind%3A%27word%27%2Ctrivia%3Afalse%2Cstart%3A0n%2Cend%3A1n%2Clexical%3Avalues%2Ctext%3A%7B%24variant%3A%27Text%27%2Cpayload%3A%27a%27%7D%7D%2Cambiguities%3A%5B%5D%7D%3B%0A%20%20let%20ordinal%3D0%2ClexicalDepth%3Dnull%2CawaitLexical%3Dfalse%3Bconst%20occurrences%3D%5B%5D%3B%0A%20%20for%28const%20event%20of%20outcomeWireEvents%28result.receipt.wirePlan%2Cnative%29%29%7B%0A%20%20%20%20if%28%5B%27endArray%27%2C%27endObject%27%2C%27endPair%27%5D.includes%28event.kind%29%29%7B%0A%20%20%20%20%20%20if%28event.kind%3D%3D%3D%27endArray%27%26%26event.depth%3D%3D%3DlexicalDepth%29lexicalDepth%3Dnull%3B%0A%20%20%20%20%20%20continue%3B%0A%20%20%20%20%7D%0A%20%20%20%20ordinal%2B%2B%3B%0A%20%20%20%20if%28event.kind%3D%3D%3D%27string%27%26%26event.key%26%26event.value%3D%3D%3D%27lexical%27%29awaitLexical%3Dtrue%3B%0A%20%20%20%20else%20if%28awaitLexical%29%7Bassert.equal%28event.kind%2C%27array%27%29%3BlexicalDepth%3Devent.depth%3BawaitLexical%3Dfalse%3B%7D%0A%20%20%20%20else%20if%28event.kind%3D%3D%3D%27number%27%26%26lexicalDepth%21%3D%3Dnull%29occurrences.push%28ordinal%29%3B%0A%20%20%7D%0A%20%20assert.equal%28occurrences.length%2C6%29%3B%0A%20%20const%20observations%3Dvalues.map%28%28value%2Cindex%29%3D%3E%7B%0A%20%20%20%20const%20buffer%3DBuffer.alloc%288%29%3Bbuffer.writeDoubleBE%28value%29%3B%0A%20%20%20%20return%7BwireOccurrence%3Aoccurrences%5Bindex%5D%2Csigned%3Aindex%3C3%2Cunsigned%3Aindex%3D%3D%3D0%7C%7Cindex%3D%3D%3D2%2Cfloating%3Aindex%3E%3D3%2C%0A%20%20%20%20%20%20signedDecimal%3Aindex%3C3%3FBigInt%28value%29.toString%28%29%3Anull%2CunsignedDecimal%3Aindex%3D%3D%3D0%7C%7Cindex%3D%3D%3D2%3FBigInt%28value%29.toString%28%29%3Anull%2CfloatingBits%3Abuffer.toString%28%27hex%27%29%7D%3B%0A%20%20%7D%29%3B%0A%20%20