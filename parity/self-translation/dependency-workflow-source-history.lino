%28grammarFile%28grammar%2C%20name%29%29%3B%0A%20%20%20%20const%20wasm%20%3D%20gunzipSync%28await%20readFile%28file%28%60%24%7Bid%7D.wasm.gz%60%29%29%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28wasm%29.digest%28%27hex%27%29%2C%20grammar.wasmSha256%2C%20id%29%3B%0A%20%20%20%20const%20license%20%3D%20readGrammarLicense%28grammarFile%28grammar%2C%20%60%24%7Bid%7D.LICENSE%60%29%29.toString%28%27utf8%27%29%3B%0A%20%20%20%20assert.ok%28license.trim%28%29.length%20%3E%200%2C%20%60%24%7Bid%7D%20carries%20its%20license%60%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27the%20tree-sitter%20oracles%20of%20the%20native%20languages%20are%20development%20files%20only%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20const%20packageJson%20%3D%20await%20readJson%28new%20URL%28%27..%2Fpackage.json%27%2C%20import.meta.url%29%29%3B%0A%20%20const%20lock%20%3D%20await%20readJson%28new%20URL%28%27..%2Fsrc%2Fvendor%2Fgrammars%2Fgrammar-lock.json%27%2C%20import.meta.url%29%29%3B%0A%20%20const%20manifest%20%3D%20await%20readFile%28new%20URL%28%27..%2F..%2Frust%2FCargo.toml%27%2C%20import.meta.url%29%2C%20%27utf8%27%29%3B%0A%20%20const%20build%20%3D%20await%20readFile%28new%20URL%28%27..%2F..%2Frust%2Fbuild.rs%27%2C%20import.meta.url%29%2C%20%27utf8%27%29%3B%0A%20%20const%20%7B%20dependencies%20%7D%20%3D%20parseCargoManifest%28manifest%29%3B%0A%20%20const%20include%20%3D%20manifest.match%28%2F%5Einclude%20%3D%20%5C%5B%28%5B%5E%5C%5D%5D%2A%29%5C%5D%2Fmu%29%5B1%5D%3B%0A%20%20const%20oracles%20%3D%20Object.values%28lock.grammars%29.filter%28%28grammar%29%20%3D%3E%20grammar.oracle%29%3B%0A%20%20assert.deepEqual%28%0A%20%20%20%20oracles.map%28%28%7B%20id%20%7D%29%20%3D%3E%20id%29%2C%0A%20%20%20%20%5B%27agda%27%2C%20%27c%27%2C%20%27cmake%27%2C%20%27cpp%27%2C%20%27css%27%2C%20%27csv%27%2C%20%27dart%27%2C%20%27diff%27%2C%20%27dtd%27%2C%20%27erlang%27%2C%20%27go%27%2C%20%27graphql%27%2C%20%27groovy%27%2C%20%27hcl%27%2C%20%27html%27%2C%20%27ini%27%2C%20%27java%27%2C%20%27javascript%27%2C%20%27json%27%2C%20%27json5%27%2C%20%27lean%27%2C%20%27lua%27%2C%20%27make%27%2C%20%27nix%27%2C%20%27odin%27%2C%20%27pascal%27%2C%20%27powershell%27%2C%20%27proto%27%2C%20%27python%27%2C%20%27r%27%2C%20%27racket%27%2C%20%27regex%27%2C%20%27rocq%27%2C%20%27rust%27%2C%20%27scheme%27%2C%20%27solidity%27%2C%20%27sql%27%2C%20%27toml%27%2C%20%27tsx%27%2C%20%27typescript%27%2C%20%27vb%27%2C%20%27xml%27%2C%20%27zig%27%5D%2C%0A%20%20%29%3B%0A%20%20assert.ok%28packageJson.files.every%28%28entry%29%20%3D%3E%20%21entry.startsWith%28%27oracles%27%29%29%29%3B%0A%20%20for%20%28const%20grammar%20of%20oracles%29%20%7B%0A%20%20%20%20assert.ok%28grammarFile%28grammar%2C%20%27%27%29.startsWith%28%27js%2Foracles%2F%27%29%2C%20grammar.id%29%3B%0A%20%20%20%20await%20assert.rejects%28%0A%20%20%20%20%20%20readFile%28new%20URL%28%60..%2Fsrc%2Fvendor%2Fgrammars%2F%24%7Bgrammar.id%7D.wasm.gz%60%2C%20import.meta.url%29%29%2C%0A%20%20%20%20%20%20grammar.id%2C%0A%20%20%20%20%29%3B%0A%20%20%20%20if%20%28grammar.crate%29%20%7B%0A%20%20%20%20%20%20%2F%2F%20The%20Rust%20suites%20still%20load%20the%20oracle%20crate%2C%20as%20a%20development%20dependency.%0A%20%20%20%20%20%20const%20declared%20%3D%20dependencies.filter%28%28%7B%20name%20%7D%29%20%3D%3E%20name%20%3D%3D%3D%20grammar.crate%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28declared.map%28%28%7B%20kind%20%7D%29%20%3D%3E%20kind%29%2C%20%5B%27development%27%5D%2C%20grammar.crate%29%3B%0A%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20%2F%2F%20A%20vendored%20oracle%20parser%20is%20neither%20compiled%20by%20production%20nor%20published.%0A%20%20%20%20%20%20assert.ok%28%21include.includes%28grammar.vendored.replace%28%2F%5Erust%5C%2F%2Fu%2C%20%27%27%29%29%2C%20grammar.vendored%29%3B%0A%20%20%20%20%20%20assert.ok%28%21build.includes%28%60%22%24%7Bgrammar.id%7D%22%60%29%2C%20grammar.id%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27npm%20lockfile%20carries%20no%20native%20or%20network-downloaded%20grammar%20packages%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20const%20packageLock%20%3D%20await%20readJson%28new%20URL%28%27..%2Fpackage-lock.json%27%2C%20import.meta.url%29%29%3B%0A%0A%20%20for%20%28const%20packagePath%20of%20Object.keys%28packageLock.packages%29%29%20%7B%0A%20%20%20%20assert.equal%28packagePath.includes%28%27tree-sitter-language-pack%27%29%2C%20false%2C%20packagePath%29%3B%0A%20%20%20%20assert.notEqual%28packagePath%2C%20%27node_modules%2Ftree-sitter%27%2C%20packagePath%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27Rust%20delivery%20closes%20each%20decompressed%20vendored%20parser%20before%20compiling%20it%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20const%20buildScript%20%3D%20await%20readFile%28new%20URL%28%27..%2F..%2Frust%2Foracles%2Fnative-source-oracles%2Fbuild.rs%27%2C%20import.meta.url%29%2C%20%27utf8%27%29%3B%0A%0A%20%20assert.match%28buildScript%2C%20%2Ffn%20decompress_parser%5C%28%5B%5E%5D%2A%3F%5Cn%7D%2F%29%3B%0A%20%20assert.match%28%0A%20%20%20%20buildScript%2C%0A%20%20%20%20%2Fdecompress_parser%5C%28%26compressed%2C%20%26parser%5C%29%3B%5Cs%2Blet%20mut%20compiler%20%3D%20cc%3A%3ABuild%3A%3Anew%5C%28%5C%29%2F%2C%0A%20%20%29%3B%0A%7D%29%3B%0A%0Atest%28%27JavaScript%20workflow%20publishes%20to%20npm%20with%20trusted%20publishing%20provenance%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20const%20workflow%20%3D%20await%20readFile%28%0A%20%20%20%20new%20URL%28%27..%2F..%2F.github%2Fworkflows%2Fjs.yml%27%2C%20import.meta.url%29%2C%0A%20%20%20%20%27utf8%27%2C%0A%20%20%29%3B%0A%0A%20%20assert.match%28workflow%2C%20%2Frelease%3A%5Cs%2A%5Cn%5Cs%2Btypes%3A%5Cs%2B%5C%5Bpublished%5C%5D%2F%29%3B%0A%20%20assert.match%28workflow%2C%20%2Fid-token%3A%5Cs%2Bwrite%2F%29%3B%0A%20%20assert.match%28workflow%2C%20%2Fregistry-url%3A%5Cs%2B%5B%27%22%5Dhttps%3A%5C%2F%5C%2Fregistry%5C.npmjs%5C.org%5B%27%22%5D%2F%29%3B%0A%20%20assert.match%28workflow%2C%20%2Fworking-directory%3A%5Cs%2Bjs%2F%29%3B%0A%20%20assert.match%28workflow%2C%20%2Fnpm%20publish%20--provenance%2F%29%3B%0A%20%20assert.m