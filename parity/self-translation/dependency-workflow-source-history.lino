(39903: (meta: (t: semantic) (n: 1) (term: string%20value) (def: assert.ok%28match%26%26Number%28match%5B2%5D%29%3E%3D90%26%26Number%28match%5B2%5D%29%3C100%2C%27uncovered%20%27%2B%28tool%3D%3D%3D%27cargo%27%3F%27Cargo%27%3A%27Rust%20compiler%27%29%2B%27%20version%3B%20supported%20stable%20range%20is%20%3E%3D1.90.0%20%3C1.100.0%27%29%3B%0A%20%20return%20match%5B1%5D%2B%27.%27%2Bmatch%5B2%5D%2B%27.%27%2Bmatch%5B3%5D%3B%0A%7D%0A%0A%2F%2A%2A%20Select%20the%20linked%20dependency%20by%20its%20actual%20rustc%20--extern%20path%2C%20never%20a%20union.%20%2A%2F%0Aexport%20function%20readOutcomeCompilerProfile%28%7BcargoVersion%2CrustcVersion%2Cstdout%2Cstderr%2ClockSource%2CprobeName%3AselectedName%2CmanifestPath%2Cexecutable%2CusizeBits%7D%29%20%7B%0A%20%20const%20version%3DreadOutcomeToolVersion%28cargoVersion%2C%27cargo%27%29%2CcompilerVersion%3DreadOutcomeToolVersion%28rustcVersion%2C%27rustc%27%29%3B%0A%20%20assert.match%28selectedName%2C%2F%5E%5Ba-z%5D%5Ba-z0-9_%5D%7B0%2C127%7D%24%2Fu%29%3B%0A%20%20for%28const%20path%20of%20%5BmanifestPath%2Cexecutable%5D%29assert.ok%28typeof%20path%3D%3D%3D%27string%27%26%26path.startsWith%28%27%2F%27%29%26%26%21path.includes%28%27%5C0%27%29%26%26posix.normalize%28path%29%3D%3D%3Dpath%2C%27canonical%20absolute%20Linux%20artifact%20path%20required%27%29%3B%0A%20%20for%28const%20value%20of%20%5Bstdout%2Cstderr%2ClockSource%5D%29assert.ok%28typeof%20value%3D%3D%3D%27string%27%26%26value.isWellFormed%28%29%26%26Buffer.byteLength%28value%29%3C%3D8%2A1024%2A1024%2C%27bounded%20complete%20compiler%20text%20required%27%29%3B%0A%20%20assert.ok%28%5B32%2C64%5D.includes%28usizeBits%29%2C%27uncovered%20observed%20native%20pointer%20width%27%29%3B%0A%20%20const%20packages%3DparseCargoLock%28lockSource%29.filter%28row%3D%3Erow.name%3D%3D%3D%27serde_json%27%29%3Bassert.equal%28packages.length%2C1%2C%27one%20exact%20locked%20JSON%20package%27%29%3B%0A%20%20const%20locked%3Dpackages%5B0%5D%3Bassert.equal%28locked.version%2C%271.0.151%27%2C%27uncovered%20JSON%20dependency%20version%3B%20supported%20range%20is%20%3E%3D1.0.151%20%3C1.0.152%27%29%3B%0A%20%20const%20records%3D%5B%5D%3B%0A%20%20for%28let%20start%3D0%3Bstart%3Cstdout.length%3B%29%7B%0A%20%20%20%20let%20end%3Dstdout.indexOf%28%27%5Cn%27%2Cstart%29%3Bif%28end%3C0%29end%3Dstdout.length%3B%0A%20%20%20%20const%20line%3Dstdout.slice%28start%2Cend%29.replace%28%2F%5Cr%24%2Fu%2C%27%27%29%3Bstart%3Dend%2B1%3B%0A%20%20%20%20if%28%21line%29continue%3Bassert.ok%28records.length%3C10000%2C%27compiler%20record%20reservation%20exceeds%20the%20profile%20limit%27%29%3B%0A%20%20%20%20records.push%28JSON.parse%28line%29%29%3B%0A%20%20%7D%0A%20%20assert.ok%28records.length%3E0%29%3Bassert.deepEqual%28records.at%28-1%29%2C%7Breason%3A%27build-finished%27%2Csuccess%3Atrue%7D%2C%27the%20exact%20compiler%20build%20finished%20successfully%27%29%3B%0A%20%20const%20probes%3Drecords.filter%28row%3D%3Erow.reason%3D%3D%3D%27compiler-artifact%27%26%26row.target%3F.name%3D%3D%3DselectedName%26%26Array.isArray%28row.target.kind%29%26%26row.target.kind.length%3D%3D%3D1%26%26row.target.kind%5B0%5D%3D%3D%3D%27test%27%29%3B%0A%20%20assert.equal%28probes.length%2C1%2C%27one%20actual%20selected%20test%20artifact%27%29%3Bconst%20probe%3Dprobes%5B0%5D%3B%0A%20%20assert.equal%28probe.manifest_path%2CmanifestPath%29%3Bassert.equal%28probe.executable%2Cexecutable%29%3Bassert.ok%28Array.isArray%28probe.filenames%29%26%26probe.filenames.includes%28executable%29%29%3B%0A%20%20assert.equal%28probe.profile.test%2Ctrue%29%3B%0A%20%20assert.equal%28probe.target.src_path%2Cposix.join%28posix.dirname%28manifestPath%29%2C%27tests%27%2CselectedName%2B%27.rs%27%29%29%3B%0A%20%20const%20invocation%3DreadOutcomeCompilerInvocation%28stderr%2CselectedName%2Cprobe.target.src_path%29%2Cidentity%3Dlocked.source%2B%27%23serde_json%40%27%2Blocked.version%3B%0A%20%20const%20dependencies%3Drecords.filter%28row%3D%3Erow.reason%3D%3D%3D%27compiler-artifact%27%26%26row.package_id%3D%3D%3Didentity%26%26row.target%3F.name%