(38281: (meta: (t: semantic) (n: 1) (term: string%20value) (def: writeFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7Btmpdir%7D%20from%20%27node%3Aos%27%3B%0Aimport%20%7Bjoin%7D%20from%20%27node%3Apath%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BrequireNativeCI%2CrunOverlay%2CrunBounded%7D%20from%20%27.%2Frun.mjs%27%3B%0Aimport%20%7BcreateOverlayPlan%2CfrozenSourceBytes%2Csha256%7D%20from%20%27.%2Fplan.mjs%27%3B%0Aimport%20%7BpublicationEdit%2CreplayPublication%7D%20from%20%27.%2Fgenerate-publication.mjs%27%3B%0Aimport%20%7BoverlayPolicy%7D%20from%20%27.%2Fpolicy.mjs%27%3B%0A%0Atest%28%27native%20authorization%20refuses%20before%20even%20an%20injected%20compiler%20process%20or%20scratch%20creation%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20repository%3DrealpathSync%28mkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-b95-runner-contract-%27%29%29%29%3B%0A%20%20const%20plan%3D%7Brepository%7D%3Blet%20calls%3D0%3B%0A%20%20const%20base%3D%7BCI%3A%27true%27%2CGITHUB_ACTIONS%3A%27true%27%2CMETA_LANGUAGE_B95_NATIVE_OUTCOME%3A%271%27%2CGITHUB_WORKSPACE%3Arepository%2CRUNNER_TEMP%3Atmpdir%28%29%7D%3B%0A%20%20for%28const%20field%20of%20%5B%27CI%27%2C%27GITHUB_ACTIONS%27%2C%27META_LANGUAGE_B95_NATIVE_OUTCOME%27%5D%29%20%7B%0A%20%20%20%20const%20environment%3D%7B...base%2C%5Bfield%5D%3Aundefined%7D%3B%0A%20%20%20%20await%20assert.rejects%28%28%29%3D%3ErunOverlay%28plan%2C%7Benvironment%2CspawnProcess%3A%28%29%3D%3E%7Bcalls%2B%2B%3Bthrow%20new%20Error%28%27forbidden%27%29%3B%7D%7D%29%29%3B%0A%20%20%7D%0A%20%20assert.equal%28calls%2C0%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErequireNativeCI%28plan%2Cbase%2C%27win32%27%29%2C%2FLinux%20only%2F%29%3B%0A%20%20assert.equal%28requireNativeCI%28plan%2Cbase%2C%27linux%27%29%2CrealpathSync%28tmpdir%28%29%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27injected%20process%20transport%20retains%20exact%20diagnostics%20and%20explicitly%20identifies%20contracts%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20directory%3DmkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-b95-process-contract-%27%29%29%3B%0A%20%20const%20logs%3Djoin%28directory%2C%27logs%27%29%3BmkdirSync%28logs%29%3B%0A%20%20let%20invocation%3B%0A%20%20const%20fake%3D%28command%2Cargs%2Coptions%29%3D%3E%7B%0A%20%20%20%20invocation%3D%7Bcommand%2Cargs%2Coptions%7D%3B%0A%20%20%20%20const%20child%3Dnew%20EventEmitter%28%29%3Bchild.stdout%3Dnew%20EventEmitter%28%29%3Bchild.stderr%3Dnew%20EventEmitter%28%29%3B%0A%20%20%20%20queueMicrotask%28%28%29%3D%3E%7Bchild.stdout.emit%28%27data%27%2CBuffer.from%28%27oracle-data%5Cn%27%29%29%3Bchild.stderr.emit%28%27data%27%2CBuffer.from%28%27retained%20warning%5Cn%27%29%29%3Bchild.emit%28%27close%27%2C0%2Cnull%29%3B%7D%29%3B%0A%20%20%20%20return%20child%3B%0A%20%20%7D%3B%0A%20%20const%20process%3Dawait%20runBounded%28%27contract-command%27%2C%5B%27--source-only%27%5D%2C%7Bcwd%3Adirectory%2Cenvironment%3A%7B%7D%2Ctimeout%3A1000%2Clogs%2Clabel%3A%27contract%27%2CspawnProcess%3Afake%7D%29%3B%0A%20%20assert.equal%28process.result.processMode%2C%27injected%20process%20contract%27%29%3B%0A%20%20assert.equal%28process.stdout.toString%28%29%2C%27oracle-data%5Cn%27%29%3Bassert.equal%28process.stderr.toString%28%29%2C%27retained%20warning%5Cn%27%29%3B%0A%20%20assert.equal%28readFileSync%28join%28logs%2C%27contract.stderr.log%27%29%2C%27utf8%27%29%2C%27retained%20warning%5Cn%27%29%3B%0A%20%20assert.equal%28invocation.options.shell%2Cfalse%29%3Bassert.equal%28invocation.options.detached%2Ctrue%29%3B%0A%20%20assert.equal%28process.result.status%2C0%29%3Bassert.equal%28process.result.signal%2Cnull%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20default%20CLI%20has%20no%20native%20branch%20and%20the%20explicit%20branch%20selects%20only%20the%20isolated%20probe%27%2C%28%29%3D%3E%7B%0A%20%20const%20source%3DreadFileSync%28new%20URL%28%27.%2Frun.mjs%27%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20assert.ok%28source.includes%28%27let%20native%3Dfalse%27%29%29%3B%0A%20%20assert.ok%28source.includes%28%27if%28native%29%20await%20runOverlay%28plan%29%3B%27%29%29%3B%0A%20%20assert.ok%28source.includes%28%22%27--test%27%2Cpolicy.testName%2C%27--no-fail-fast%27%2C%27--no-run%27%22%29%29%3B%0A%20%20assert.ok%28source.includes%28%22%27--locked%27%2C%27--offline%27%22%29%29%3B%0A%20%20assert.ok%28source.includes%28%22%5B%27--test-threads%3D1%27%2C%27--nocapture%27%5D%22%29%29%3B%0A%20%20assert.ok%28%21source.includes%28%27recordIssue195Observations%27%29%26%26%21source.includes%28%27cargo%20fetch%27%29%26%26%21source.includes%28%27npm%20install%27%29%29%3B%0A%20%20assert.ok%28source.includes%28%22name.startsWith%28%27ISSUE_195_%27%29%22%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20compiled%20snapshot%20uses%20exact%20frozen%20blobs%20while%20separately%20retaining%20current%20publication%20metadata%27%2C%28%29%3D%3E%7B%0A%20%20const%20original%3DBuffer.from%28%27retained%20frozen%20source%5Cn%27%29%2Ccurrent%3DBuffer.from%28%27later%20source%20registration%5Cn%27%29%3B%0A%20%20const%20gitObject%3DcreateHash%28%27sha1%27%29.update%28%27blob%20%27%2Boriginal.length%2B%27%5C0%27%29.update%28original%29.digest%28%27hex%27%29%3B%0A%20%20const%20file%3D%7Bpath%3A%27rust%2Fsrc%2Fdata%2Fconcept-records.lino%27%2CgitObject%2Csha256%3Asha256%28original%29%7D%3B%0A%20%20const%20packet%3DfrozenSourceBytes%28%27%2Funused%27%2Cfile%2C%7BreadWorking%3A%28%29%3D%3Ecurrent%2CreadBlob%3A%28%29%3D%3Eoriginal%7D%29%3B%0A%20%20assert.deepEqual%28packet.bytes%2Coriginal%29%3Bassert.equal%28packet.workingSha256%2Csha256%28current%29%29%3Bassert.equal%28packet.workingBytes%2Ccurrent.length%29%3B%0A%20%20assert.throws%28%28%29%3D%3EfrozenSourceBytes%28%27%2Funused%27%2Cfile%2C%7BreadWorking%3A%28%29%3D%3Ecurrent%2CreadBlob%3A%28%29%3D%3EBuffer.from%28%27corrupt%27%29%7D%29%2C%2Ffrozen%20Git%20blob%20identity%2Fu%29%3B%0A%20%20assert.throws%28%28%29%3D%3EfrozenSourceBytes%28%27%2Funused%27%2C%7B...file%2CworkingSha256%3Asha256%28original%29%7D%2C%7BreadWorking%3A%28%29%3D%3Ecurrent%2CreadBlob%3A%28%29%3D%3Eoriginal%7D%29%2C%2Fproduction%20input%20changed%20after%20planning%2Fu%29%3B%0A%20%20let%20loads%3D0%3Bconst%20retained%3DfrozenSourceBytes%28%27%2Funused%27%2Cfile%2C%7BreadWorking%3A%28%29%3D%3Eoriginal%2CreadBlob%3A%28%29%3D%3E%7Bloads%2B%2B%3Breturn%20original%3B%7D%7D%29%3B%0A%20%20assert.deepEqual%28retained.bytes%2Coriginal%29%3Bassert.equal%28loads%2C0%29%3B%0A%7D%29%3B%0A%0Atest%28%27publication%20edits%20retain%20the%20complete%20original%20and%20refuse%20a%20changed%20original%20interval%27%2C%28%29%3D%3E%7B%0A%20%20const%20original%3D%27before%5Cnreviewed%20source%5Cnafter%5Cn%27%2Cpublished%3D%27before%5Cnportable%20reviewed%20source%5Cnafter%5Cn%27%3B%0A%20%20const%20edit%3DpublicationEdit%28original%2Cpublished%29%3B%0A%20%20assert.equal%28replayPublication%28original%2Cedit%29%2Cpublished%29%3B%0A%20%20assert.throws%28%28%29%3D%3EreplayPublication%28original%2C%7B...edit%2Cremoved%3A%27unrelated%27%7D%29%2C%2Fexact%20publication%20source%20interval%2Fu%29%3B%0A%20%20assert.throws%28%28%29%3D%3EreplayPublication%28original%2C%7B...edit%2Cend%3Aoriginal.length%2B1%7D%29%29%3B%0A%20%20assert.equal%28replayPublication%28original%2CpublicationEdit%28original%2Coriginal%29%29%2Coriginal) (lang: meta-language%20structured%20data)))
