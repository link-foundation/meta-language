ual%28Buffer.byteLength%28source.sourceText%29%2Csource.bytes%29%3B%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28source.sourceText%29.digest%28%27hex%27%29%2Csource.sha256%29%3B%0A%20%20%7D%0A%20%20const%20collector%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3D%27js%2Fscripts%2Fdependency-inventory.mjs%27%29%3B%0A%20%20const%20actual%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bcollector.file%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20assert.equal%28actual%2Ccollector.sourceText.replace%28history.before%2Chistory.after%29%2Bhistory.insertion%29%3B%0A%20%20assert.equal%28actual.replace%28history.insertion%2C%27%27%29.replace%28history.after%2Chistory.before%29%2Ccollector.sourceText%29%3B%0A%20%20const%20original%3Dhistory.sources.find%28row%3D%3Erow.file%3D%3D%3D%27parity%2Fdependency-inventory.lino%27%29%3B%0A%20%20const%20before%3DreadStructuredDataLino%28original.sourceText%29%3B%0A%20%20const%20current%3DreadNodeDependencyInventoryOriginalView%28%29%3B%0A%20%20const%20generator%3DreadNodeDependencyGeneratorRegistrationHistory%28%29.generator%3B%0A%20%20assert.deepEqual%28current.items.filter%28row%3D%3Erow.id%3D%3D%3Dgenerator.id%29%2C%5Bgenerator%5D%29%3B%0A%20%20current.items%3Dcurrent.items.filter%28row%3D%3Erow.id%21%3D%3Dgenerator.id%29%3B%0A%20%20assert.equal%28current.items.length%2Cbefore.items.length%29%3Bassert.equal%28current.items.length%2C744%29%3B%0A%20%20assert.equal%28current.auditDate%2Cbefore.auditDate%29%3B%0A%20%20const%20node%3Dcurrent.items.find%28row%3D%3Erow.id%3D%3D%3Dhistory.updatedNodeId%29%3Bassert.ok%28node%29%3B%0A%20%20assert.equal%28node.compare%2C%27version%27%29%3Bassert.equal%28node.current%2Chistory.runtime.nodeVersion%29%3B%0A%20%20assert.equal%28node.auditDate%2Chistory.observationDate%29%3Bassert.ok%28node.evidence.includes%28%27observed%20%27%2Bhistory.observationDate%29%29%3B%0A%20%20const%20restored%3DstructuredClone%28current%29%3B%0A%20%20restored.items%3Drestored.items.map%28row%3D%