(38254: (meta: (t: semantic) (n: 1) (term: string%20value) (def: function%20copySnapshot%28plan%2Coverlay%29%20%7B%0A%20%20for%28const%20file%20of%20plan.inventory.files%29%20%7B%0A%20%20%20%20const%20destination%3Djoin%28overlay%2Cfile.path%29%3B%0A%20%20%20%20const%20%7Bbytes%7D%3DfrozenSourceBytes%28plan.repository%2Cfile%29%3B%0A%20%20%20%20mkdirSync%28dirname%28destination%29%2C%7Brecursive%3Atrue%7D%29%3BwriteFileSync%28destination%2Cbytes%2C%7Bflag%3A%27wx%27%7D%29%3B%0A%20%20%20%20chmodSync%28destination%2Cfile.mode%3D%3D%3D%27100755%27%3F0o755%3A0o644%29%3B%0A%20%20%20%20assert.equal%28sha256%28bytesAt%28overlay%2Cfile.path%29%29%2Cfile.sha256%2C%27exact%20independent%20scratch%20file%27%29%3B%0A%20%20%7D%0A%20%20%2F%2F%20The%20Agda%20dev-oracle%20build%20invokes%20its%20existing%20JS%20queue%20helper.%20Its%20small%0A%20%20%2F%2F%20SOURCE%20closure%20is%20copied%20above%3B%20only%20the%20already%20installed%20dependency%0A%20%20%2F%2F%20directory%20is%20shared.%20No%20npm%2Finstall%20script%20is%20invoked.%0A%20%20const%20modules%3DrealpathSync%28join%28plan.repository%2C%27js%2Fnode_modules%27%29%29%3B%0A%20%20assert.ok%28lstatSync%28modules%29.isDirectory%28%29%2C%27existing%20CI%20dependency%20installation%27%29%3B%0A%20%20symlinkSync%28modules%2Cjoin%28overlay%2C%27js%2Fnode_modules%27%29%2C%27dir%27%29%3B%0A%20%20writeFileSync%28join%28overlay%2Cpolicy.parent%29%2Cplan.parent%29%3B%0A%20%20mkdirSync%28dirname%28join%28overlay%2Cpolicy.child%29%29%2C%7Brecursive%3Atrue%7D%29%3B%0A%20%20writeFileSync%28join%28overlay%2Cpolicy.child%29%2Cplan.child%2C%7Bflag%3A%27wx%27%7D%29%3B%0A%20%20writeFileSync%28join%28overlay%2C%27rust%2Ftests%27%2Cpolicy.testName%2B%27.rs%27%29%2Cplan.probe%2C%7Bflag%3A%27wx%27%7D%29%3B%0A%20%20const%20producerPath%3D%27rust%2Fsrc%2Fgrammar%2Ffeature_runtime%2Fgrammar_selection.rs%27%3B%0A%20%20assert.equal%28readFileSync%28join%28overlay%2CproducerPath%29%2C%27utf8%27%29%2Cplan.producerCorrection.original%2C%27actual%20frozen%20producer%20matches%20the%20explicit%20adapter%20input%27%29%3B%0A%20%20writeFileSync%28join%28overlay%2CproducerPath%29%2Cplan.producerCorrection.source%29%3B%0A%7D%0A%0A%2F%2A%2A%20No%20ledger%20writes.%20Native%20report%20is%20only%20the%20probe%27s%20own%20post-assertions%0A%20%2A%20artifact%3B%20this%20runner%20does%20not%20interpret%20it%20as%20public%20API%2Fgrammar%20evidence.%0A%20%2A%2F%0Aexport%20async%20function%20runOverlay%28plan%2C%7Benvironment%3Dprocess.env%2CspawnProcess%3Dspawn%7D%3D%7B%7D%29%20%7B%0A%20%20const%20temporary%3DrequireNativeCI%28plan%2Cenvironment%29%3B%0A%20%20const%20artifactParent%3Djoin%28plan.repository%2C%27issue-195-artifacts%27%2C%27bulk95-outcome-overlay%27%29%3B%0A%20%20mkdirSync%28artifactParent%2C%7Brecursive%3Atrue%7D%29%3Bassert.ok%28%21lstatSync%28artifactParent%29.isSymbolicLink%28%29%29%3B%0A%20%20assert.ok%28within%28plan.repository%2CrealpathSync%28artifactParent%29%29%2C%27artifact%20owner%20cannot%20escape%20through%20an%20ancestor%20symlink%27%29%3B%0A%20%20const%20artifacts%3DmkdtempSync%28join%28artifactParent%2C%27run-%27%29%29%3B%0A%20%20const%20work%3DmkdtempSync%28join%28temporary%2C%27meta-language-bulk95-outcome-%27%29%29%3B%0A%20%20const%20overlay%3Djoin%28work%2C%27overlay%27%29%3BmkdirSync%28overlay%29%3B%0A%20%20const%20%7BwriteProjectData%2CreadProjectData%7D%3Dawait%20import%28pathToFileURL%28join%28plan.repository%2C%27js%2Fscripts%2Fproject-data.mjs%27%29%29%29%3B%0A%20%20writeProjectData%28join%28work%2C%27.meta-language-bulk95-owned.lino%27%29%2C%7Brepository%3Aplan.repository%2CexecutionCommit%3Aplan.executionCommit%2Cartifacts%7D%29%3B%0A%20%20const%20receipt%3D%7BschemaVersion%3A1%2Cscope%3Apolicy.profile%2CbaseCommit%3Apolicy.baseCommit%2CexecutionCommit%3Aplan.executionCommit%2C%0A%20%20%20%20processMode%3AspawnProcess%3D%3D%3Dspawn%3F%27actual%20subprocess%27%3A%27injected%20process%20contract%27%2C%0A%20%20%20%20work%2Cartifacts%2CsourceManifest%3Aplan.inventory.files%2CsourceBytes%3Aplan.inventory.bytes%2C%0A%20%20%20%20originalCandidatePins%3Apolicy.candidatePins%2CoriginalProbePins%3Apolicy.probePins%2C%0A%20%20%20%20publication%3Aplan.publication%2CrunnerPublication%3Aplan.runnerPublication.publication%2C%0A%20%20%20%20runnerAdapterSources%3Aplan.runnerPublication.newSources%2C%0A%20%20%20%20bridgeReceipt%3Aplan.receipt%2CproducerCorrection%3Aplan.producerCorrection.receipt%2CnativeOraclePolicy%3Aplan.nativeOraclePolicy%2C%0A%20%20%20%20probeTargetObservation%3Aplan.probeTargetObservation%2Cprocesses%3A%5B%5D%7D%3B%0A%20%20let%20failure%3Dnull%3B%0A%20%20const%20execute%3Dasync%28command%2Cargs%2Ctimeout%2Clabel%2Cenv%3DenvironmentFor%28work%2Cenvironment%29%29%3D%3E%7B%0A%20%20%20%20requireNativeCI%28plan%2Cenvironment%29%3B%20%2F%2F%20Also%20guards%20injected%20contract%20processes.%0A%20%20%20%20const%20process%3Dawait%20runBounded%28command%2Cargs%2C%7Bcwd%3Ajoin%28overlay%2C%27rust%27%29%2Cenvironment%3Aenv%2Ctimeout%2Clogs%3Aartifacts%2Clabel%2CspawnProcess%7D%29%3B%0A%20%20%20%20receipt.processes.push%28process.result%29%3B%0A%20%20%20%20if%28process.result.error%7C%7Cprocess.result.status%21%3D%3D0%7C%7Cprocess.result.signal%29%20throw%20new%20Error%28label%2B%27%20failed%3B%20exact%20logs%20in%20%27%2Bartifacts%29%3B%0A%20%20%20%20return%20process.stdout.toString%28%27utf8%27%29%3B%0A%20%20%7D%3B%0A%20%20try%20%7B%0A%20%20%20%20copySnapshot%28plan%2Coverlay) (lang: meta-language%20structured%20data)))
