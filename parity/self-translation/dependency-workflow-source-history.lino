(39272: (meta: (t: semantic) (n: 1) (term: string%20value) (def: grammarFile%2C%20readGrammarLicense%20%7D%20from%20%27..%2Fscripts%2Fgrammar-files.mjs%27%3B%0Aimport%20%7B%20externalGrammarPath%20%7D%20from%20%27..%2Fscripts%2Fexternal-grammar-cache.mjs%27%3B%0Aimport%20%7B%20readProjectData%20%7D%20from%20%27..%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7B%20releaseIdentity%2C%20releaseRegistryState%2C%20verifyPublishedRelease%20%7D%20from%20%27..%2Fscripts%2Frelease-publication.mjs%27%3B%0A%0Aasync%20function%20readJson%28url%29%20%7B%0A%20%20return%20readProjectData%28url%29%3B%0A%7D%0A%0Atest%28%27npm%20package%20metadata%20uses%20the%20public%20unscoped%20package%20name%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20const%20packageJson%20%3D%20await%20readJson%28new%20URL%28%27..%2Fpackage.json%27%2C%20import.meta.url%29%29%3B%0A%20%20const%20packageLock%20%3D%20await%20readJson%28new%20URL%28%27..%2Fpackage-lock.json%27%2C%20import.meta.url%29%29%3B%0A%20%20const%20rootReadme%20%3D%20await%20readFile%28new%20URL%28%27..%2F..%2FREADME.md%27%2C%20import.meta.url%29%2C%20%27utf8%27%29%3B%0A%20%20const%20jsReadme%20%3D%20await%20readFile%28new%20URL%28%27..%2FREADME.md%27%2C%20import.meta.url%29%2C%20%27utf8%27%29%3B%0A%20%20const%20rustReadme%20%3D%20await%20readFile%28new%20URL%28%27..%2F..%2Frust%2FREADME.md%27%2C%20import.meta.url%29%2C%20%27utf8%27%29%3B%0A%20%20const%20issue163CaseStudy%20%3D%20await%20readFile%28%0A%20%20%20%20new%20URL%28%27..%2F..%2Fdocs%2Fcase-studies%2Fissue-163%2FREADME.md%27%2C%20import.meta.url%29%2C%0A%20%20%20%20%27utf8%27%2C%0A%20%20%29%3B%0A%0A%20%20assert.equal%28packageJson.name%2C%20%27meta-language%27%29%3B%0A%20%20assert.equal%28packageLock.name%2C%20%27meta-language%27%29%3B%0A%20%20assert.equal%28packageLock.packages%5B%27%27%5D.name%2C%20%27meta-language%27%29%3B%0A%20%20assert.equal%28%0A%20%20%20%20packageJson.repository.url%2C%0A%20%20%20%20%27git%2Bhttps%3A%2F%2Fgithub.com%2Flink-foundation%2Fmeta-language.git%27%