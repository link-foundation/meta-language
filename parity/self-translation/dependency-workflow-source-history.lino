Fdependency-refresh.log%0A%20%20%20%20%20%20%20%20%20%20%20%20parity%2Fdependency-inventory.lino%0A%20%20%20%20%20%20%20%20%20%20%20%20docs%2Fdependency-audit.md%0A%20%20%20%20%20%20%20%20%20%20if-no-files-found%3A%20error%0A%0A%20%20%20%20%20%20-%20name%3A%20Report%20the%20live%20audit%20outcome%0A%20%20%20%20%20%20%20%20if%3A%20%24%7B%7B%20%21cancelled%28%29%20%7D%7D%0A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20AUDIT_OUTCOME%3A%20%24%7B%7B%20steps.audit.outcome%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20%7C%0A%20%20%20%20%20%20%20%20%20%20printf%20%27Live%20dependency%20audit%20outcome%3A%20%2A%2A%25s%2A%2A.%20See%20the%20retained%20report%20and%20refresh%20PR%20for%20repairs.%20Required%20PR%20dependency%20checks%20remain%20unchanged.%5Cn%27%20%22%24AUDIT_OUTCOME%22%20%3E%3E%20%22%24GITHUB_STEP_SUMMARY%22%0A%20%20%20%20%20%20%20%20%20%20if%20%5B%20%22%24AUDIT_OUTCOME%22%20%21%3D%20success%20%5D%3B%20then%0A%20%20%20%20%20%20%20%20%20%20%20%20echo%20%27%3A%3Awarning%3A%3AThe%20live%20dependency%20audit%20reported%20failures.%20Its%20retained%20findings%20require%20repair%3B%20no%20PR%20or%20delivery%20gate%20is%20waived.%27%0A%20%20%20%20%20%20%20%20%20%20fi%0A%0A%20%20%20%20%20%20-%20name%3A%20Open%20or%20update%20the%20refresh%20pull%20request%0A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20GH_TOKEN%3A%20%24%7B%7B%20github.token%20%7D%7D%0A%20%20%20%20%20%20%20%20%20%20BRANCH%3A%20automation%2Fdependency-refresh%0A%20%20%20%20%20%20%20%20%20%20AUDIT_OUTCOME%3A%20%24%7B%7B%20steps.audit.outcome%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20%7C%0A%20%20%20%20%20%20%20%20%20%20if%20git%20diff%20--quiet%3B%20then%0A%20%20%20%20%20%20%20%20%20%20%20%20if%20%5B%20%22%24AUDIT_OUTCOME%22%20%3D%20success%20%5D%3B%20then%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20echo%20%22dependencies%20and%20the%20audit%20are%20current%22%0A%20%20%20%20%20%20%20%20%20%20%20%20else%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20echo%20%22no%20tracked%20u