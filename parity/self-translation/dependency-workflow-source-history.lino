subarray%28title.start%2Ctitle.end%29.toString%28%29%2Ctokens%3Dtokenize%28literal%2C%27JavaScript%27%29.tokens%3B%0A%20%20%20%20const%20name%3Dtokens%5B0%5D.value%3Bassert.equal%28typeof%20name%2C%27string%27%29%3B%0A%20%20%20%20const%20partition%3Dnode.start%3CBuffer.byteLength%28source.slice%280%2Cgate%29%29%3F%27schema%27%0A%20%20%20%20%20%20%3Aname%3D%3D%3D%27CI%20executes%20the%20selected%20complete%20raw%20emission%20profile%20and%20persists%20only%20real%20observations%27%3F%27native%27%3A%27plan%27%3B%0A%20%20%20%20tests.push%28%7Bname%2Cpartition%2Cstart%3Anode.start%2Cend%3Anode.end%2C%0A%20%20%20%20%20%20sha256%3AcreateHash%28%27sha256%27%29.update%28bytes.subarray%28node.start%2Cnode.end%29%29.digest%28%27hex%27%29%7D%29%3B%0A%20%20%7D%0A%20%20tests.sort%28%28first%2Csecond%29%3D%3Efirst.start-second.start%29%3B%0A%20%20assert.equal%28tests.filter%28row%3D%3Erow.partition%3D%3D%3D%27schema%27%29.length%2C11%29%3B%0A%20%20assert.equal%28tests.filter%28row%3D%3Erow.partition%3D%3D%3D%27plan%27%29.length%2C7%29%3B%0A%20%20assert.equal%28tests.filter%28row%3D%3Erow.partition%3D%3D%3D%27native%27%29.length%2C1%29%3B%0A%20%20assert.equal%28new%20Set%28tests.map%28row%3D%3Erow.name%29%29.size%2C19%29%3B%0A%20%20const%20testsEdits%3D%5B%0A%20%20%20%20%7Bbefore%3A%22import%20test%20from%20%27node%3Atest%27%3B%22%2Cafter%3A%22import%20registerRawContract%20from%20%27node%3Atest%27%3B%5Cnimport%20%7BcreateOriginalLinkRawContractPartition%7D%20from%20%27.%2Fraw-contract-partitions.mjs%27%3B%5Cnconst%20rawContracts%3DcreateOriginalLinkRawContractPartition%28registerRawContract%29%3B%5Cnconst%20test%3D%28...argumentsList%29%3D%3ErawContracts.test%28...argumentsList%29%3B%22%7D%2C%0A%20%20%20%20%7Bbefore%3A%22if%20%28process.env.CI%20%3D%3D%3D%20%27true%27%29%20%7B%22%2Cafter%3A%22if%20%28process.env.CI%20%3D%3D%3D%20%27true%27%20%26%26%20rawContracts.runPlan%29%20%7B%22%7D%2C%0A%20%20%20%20%7Bbefore%3A%27%5Cn%7D%5Cn%27%2Cafter%3A%27%5Cn%7D%5CnrawContracts.finish%28%2