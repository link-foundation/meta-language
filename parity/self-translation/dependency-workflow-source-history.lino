(38910: (meta: (t: semantic) (n: 1) (term: string%20value) (def: file%3D%3ErestoreCiRepairSourceHistory%28file%2CrestoreSchedulingSourceHistory%28file%2CreadFileSync%28new%20URL%28file%2Croot%29%2C%27utf8%27%29%29%29%3B%0A%0Atest%28%27four%20required%20tooling%20cells%20retain%20every%20current%20file%20exactly%20once%20and%20every%20original%20command%20and%20deadline%27%2C%28%29%3D%3E%7B%0A%20%20generateToolingPartitionHistory%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20source%3Dread%28history.workflow.path%29%3Bassert.equal%28source.split%28history.change.after%29.length%2C2%29%3B%0A%20%20const%20previous%3DrestoreToolingPartitionHistory%28source%29%3Bassert.equal%28previous%2Chistory.workflow.source%29%3B%0A%20%20verifyGitArtifactCertificate%28history.workflow.certificate%2CBuffer.from%28previous%29%2C%7Brevision%3Ahistory.revision%2Cpath%3Ahistory.workflow.path%7D%29%3B%0A%20%20const%20before%3DparseWorkflow%28previous%29%2Cafter%3DparseWorkflow%28source%29%3B%0A%20%20assert.equal%28after.length%2Cbefore.length%29%3B%0A%20%20for%28const%20old%20of%20before%29%7B%0A%20%20%20%20const%20current%3Dafter.find%28row%3D%3Erow.id%3D%3D%3Dold.id%29%3Bassert.ok%28current%29%3Bassert.deepEqual%28current.steps%2Cold.steps%29%3B%0A%20%20%20%20assert.equal%28current.header%2Cold.id%3D%3D%3D%27tests%27%3Fold.header.replace%28history.change.before%2Chistory.change.after%29%3Aold.header%29%3B%0A%20%20%7D%0A%20%20const%20header%3Dafter.find%28row%3D%3Erow.id%3D%3D%3D%27tests%27%29.header%3B%0A%20%20assert.match%28header%2C%2F%5E%20%7B4%7Dtimeout-minutes%3A%2015%24%2Fmu%29%3Bassert.match%28header%2C%2Ffail-fast%3A%20false%2Fu%29%3B%0A%20%20assert.deepEqual%28%5B...header.matchAll%28%2F%5C%7Bgroup%3A%20tooling%2C%20partition%3A%20%28%5Cd%2B%29%2C%20shards%3A%20%28%5Cd%2B%29%5C%7D%2Fgu%29%5D%0A%20%20%20%20.map%28%28%5B%2Cpart%2Ccount%5D%29%3D%3E%5BNumber%28part%29%2CNumber%28count%29%5D%29%2C%5B%5B1%2C4%5D%2C%5B2%2C4%5D%2C%5B3%2C4%5D%2C%5B4%2C4%5D%5D%29%3B%0A%20%20const%20partition%3DpartitionTests%28testFiles%28%29%29%3Bassert.deepEqual%28partition.unassigned%2C%5B%5D%29%3Bassert.deepEqual%28partition.ambiguous%2C%5B%5D%29%3B%0A%20%20const%20files%3Dpartition.groups.tooling%3B%0A%20%20const%20cells%3DArray.from%28%7Blength%3Ahistory.shards%7D%2C%28_%2Cindex%29%3D%3EpartitionGroupFiles%28files%2C%60%24%7Bindex%2B1%7D%2F%24%7Bhistory.shards%7D%60%29%29%3B%0A%20%20assert.ok%28cells.every%28cell%3D%3Ecell.length%3E0%29%29%3Bassert.equal%28cells.flat%28%29.length%2Cfiles.length%29%3B%0A%20%20assert.equal%28new%20Set%28cells.flat%28%29%29.size%2Cfiles.length%29%3Bassert.deepEqual%28cells.flat%28%29.sort%28%29%2Cfiles%29%3B%0A%20%20assert.ok%28cells.flat%28%29.includes%28%27issue-195-evidence-tooling-partitions.test.js%27%29%29%3B%0A%20%20assert.ok%28cells.flat%28%29.includes%28%27issue-195-evidence-link-foundation.test.js%27%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27partial%20duplicate%20mixed%20and%20unsupported%20tooling%20cells%20refuse%20without%20hiding%20unrelated%20gate%20edits%27%2C%28%29%3D%3E%7B%0A%20%20const%20source%3Dread%28history.workflow.path%29%2C%7Bbefore%2Cafter%7D%3Dhistory.change%3B%0A%20%20for%28const%20replacement%20of%20%5Bafter%2Bafter%2Cafter.replace%28%27partition%3A%203%27%2C%27partition%3A%202%27%29%2C%0A%20%20%20%20after.replace%28%27shards%3A%204%27%2C%27shards%3A%205%27%29%2Cafter.replace%28%27%20%20%20%20%20%20%20%20%20%20-%20%7Bgroup%3A%20tooling%2C%20partition%3A%204%2C%20shards%3A%204%7D%5Cn%27%2C%27%27%29%5D%29%7B%0A%20%20%20%20assert.throws%28%28%29%3D%3ErestoreToolingPartitionHistory%28source.replace%28after%2Creplacement%29%29%2Cassert.AssertionError%29%3B%0A%20%20%7D%0A%20%20assert.equal%28restoreToolingPartitionHistory%28source.replace%28after%2Cbefore%29%29%2Chistory.workflow.source%29%3B%0A%20%20for%28const%20%5Bold%2Cnext%5Dof%20%5B%5B%27timeout-minutes%3A%2015%27%2C%27timeout-minutes%3A%2016%27%5D%2C%5B%27fail-fast%3A%20false%27%2C%27fail-fast%3A%20true%27%5D%5D%29%7B%0A%20%20%20%20const%20changed%3Dsource.replace%28old%2Cnext%29%3Bassert.notEqual%28changed%2Csource%29%3B%0A%20%20%20%20assert.equal%28restoreToolingPartitionHistory%28changed%29%2Chistory.workflow.source.replace%28old%2Cnext%29%29%3B%0A%20%20%7D%0A%20%20assert.equal%28restoreToolingPartitionHistory%28source%2B%27%5Cn%23%20unrelated%5Cn%27%29%2Chistory.workflow.source%2B%27%5Cn%23%20unrelated%5Cn%27%29%3B%0A%20%20assert.equal%28restoreToolingPartitionHistory%28%27name%3A%20Other%5Cn%27%29%2C%27name%3A%20Other%5Cn%27%29%3B%0A%20%20assert.throws%28%28%29%3D%3ErestoreToolingPartitionHistory%28null%29%2Cassert.AssertionError%29%3B%0A%7D%29%3B%0A%0Atest%28%27tooling%20partition%20adapters%20reconstruct%20both%20complete%20preceding%20raw%20guards%20and%20every%20retained%20assertion%27%2C%28%29%3D%3E%7B%0A%20%20const%20previous%3Dfile%3D%3EexecFileSync%28%27git%27%2C%5B%27show%27%2Chistory.revision%2B%27%3A%27%2Bfile%5D%2C%7Bcwd%3Aroot%2Cencoding%3A%27utf8%27%2CmaxBuffer%3A128%2A1024%7D%29%3B%0A%20%20for%28const%20%5Bfile%2Cbefore%2Cafter%2Cinsertion%5Dof%20%5B%0A%20%20%20%20%5B%27js%2Ftests%2Fsupport%2Fraw-contract-partition-history.js%27%2C%22%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%22%2C%0A%20%20%20%20%20%20%22%20%20assert.equal%28typeof%20source%2C%27string%27%29%3B%5Cn%20%20source%3DrestoreToolingPartitionHistory%28source%29%3B%22%2C%0A%20%20%20%20%20%20%22%5Cnimport%20%7BrestoreToolingPartitionHistory%7D%20from%20%27.%2Ftooling-partition-history.js%27%3B%5Cn%22%5D%2C%0A%20%20%20%20%5B%27js%2Ftests%2Fissue-195-evidence-raw-contract-partitions.test.js%27%2C%22%20%20const%20workflow%3Dread%28%27.github%2Fworkflows%2Fjs.yml%27%29%3B%22%2C%0A%20%20%20%20%20%20%22%20%20const%20workflow%3DrestoreToolingPartitionHistory%28read%28%27.github%2Fworkflows%2Fjs.yml%27%29%29%3B%22%2C%0A%20%20%20%20%20%20%22%5Cnimport%20%7BrestoreToolingPartitionHistory%7D%20from%20%27.%2Fsupport%2Ftooling-partition-history.js%27%3B%5Cn%22%5D%2C%0A%20%20%20%20%5B%27js%2Ftests%2Ftest-groups.test.js%27%2C%22%20%20const%20