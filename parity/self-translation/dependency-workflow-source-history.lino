(38858: (meta: (t: semantic) (n: 1) (term: string%20value) (def: RawOracleContractPartitionHistory%7D%20from%20%27..%2Fscripts%2Fraw-oracle-contract-partition-history.mjs%27%3B%0Aimport%20%7BcreateOriginalLinkRawContractPartition%7D%20from%20%27..%2F..%2Fexperiments%2Foriginal-link-complete-table-projection%2Fraw-contract-partitions.mjs%27%3B%0Aimport%20%7BparseNative%7D%20from%20%27..%2Fsrc%2Fnative-grammar-parser.js%27%3B%0Aimport%20%7Btokenize%7D%20from%20%27..%2Fsrc%2Ftranslation%2Flexer.js%27%3B%0A%0Aconst%20environment%3Dprofile%3D%3E%28%7BCI%3A%27true%27%2CORIGINAL_LINK_RAW_NATIVE%3A%270%27%2C%0A%20%20ORIGINAL_LINK_RAW_SEPARATE_SUITES%3A%271%27%2CORIGINAL_LINK_RAW_CONTRACT_PARTITION%3Aprofile%7D%29%3B%0A%0Atest%28%27both%20required%20raw%20partitions%20register%20every%20original%20callback%20exactly%20once%20without%20executing%20another%20partition%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bfixture%7D%3DgenerateRawOracleContractPartitions%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20rows%3Dfixture.tests.filter%28row%3D%3Erow.partition%21%3D%3D%27native%27%29%2Cexecuted%3D%5B%5D%3B%0A%20%20for%28const%20profile%20of%20%5B%27schema%27%2C%27plan%27%5D%29%7B%0A%20%20%20%20const%20registered%3D%5B%5D%2Crunner%3DcreateOriginalLinkRawContractPartition%28%28name%2Ccallback%29%3D%3E%7B%0A%20%20%20%20%20%20registered.push%28name%29%3Bcallback%28%29%3Breturn%20name%3B%0A%20%20%20%20%7D%2Cenvironment%28profile%29%29%3B%0A%20%20%20%20assert.equal%28runner.runPlan%2Cprofile%3D%3D%3D%27plan%27%29%3B%0A%20%20%20%20const%20encountered%3Dprofile%3D%3D%3D%27schema%27%3Frows.filter%28row%3D%3Erow.partition%3D%3D%3D%27schema%27%29%3Arows%3B%0A%20%20%20%20for%28const%20row%20of%20encountered%29%7B%0A%20%20%20%20%20%20runner.test%28row.name%2C%28%29%3D%3Eexecuted.push%28row.name%29%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20runner.finish%28%29%3Bassert.deepEqual%28registered%2Crows.filter%28row%3D%3Erow.partition%3D%3D%3Dprofile%29.map%28row%3D%3Erow.name%29%29%3B%0A%20%20%7D%0A%20%20assert.equal%28executed.length%2C18%29%3Bassert.equal%28new%20Set%28executed%29.size%2C18%29%3B%0A%20%20assert.deepEqual%28executed%2Crows.map%28row%3D%3Erow.name%29%29%3B%0A%20%20const%20register%3D%28%29%3D%3E1%2Call%3DcreateOriginalLinkRawContractPartition%28register%2C%7B%7D%29%3B%0A%20%20assert.equal%28all.test%2Cregister%29%3Bassert.equal%28all.runPlan%2Ctrue%29%3Ball.finish%28%29%3B%0A%7D%29%3B%0A%0Atest%28%27unknown%20profiles%20missing%20registrations%20duplicates%20and%20native%20admission%20in%20injected%20partitions%20refuse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bfixture%7D%3DgenerateRawOracleContractPartitions%28%7Bcheck%3Atrue%7D%29%3B%0A%20%20const%20name%3Dfixture.tests%5B0%5D.name%3B%0A%20%20for%28const%20value%20of%20%5Benvironment%28%27unknown%27%29%2C%7B...environment%28%27plan%27%29%2CCI%3A%27false%27%7D%2C%0A%20%20%20%20%7B...environment%28%27plan%27%29%2CORIGINAL_LINK_RAW_NATIVE%3A%271%27%7D%2C%0A%20%20%20%20%7B...environment%28%27plan%27%29%2CORIGINAL_LINK_RAW_SEPARATE_SUITES%3A%270%27%7D%5D%29%7B%0A%20%20%20%20assert.throws%28%28%29%3D%3EcreateOriginalLinkRawContractPartition%28%28%29%3D%3E%7B%7D%2Cvalue%29%29%3B%0A%20%20%7D%0A%20%20const%20runner%3DcreateOriginalLinkRawContractPartition%28%28%29%3D%3E%7B%7D%2Cenvironment%28%27schema%27%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3Erunner.finish%28%29%29%3Bassert.throws%28%28%29%3D%3Erunner.test%28%27unknown%27%2C%28%29%3D%3E%7B%7D%29%29%3B%0A%20%20runner.test%28name%2C%28%29%3D%3E%7B%7D%29%3Bassert.throws%28%28%29%3D%3Erunner.test%28name%2C%28%29%3D%3E%7B%7D%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3Erunner.test%28fixture.tests.find%28row%3D%3Erow.partition%3D%3D%3D%27native%27%29.name%2C%28%29%3D%3E%7B%7D%29%29%3B%0A%7D%29%3B%0A%0Atest%28%27the%20entire%20current%20test%20source%20retains%20every%20original%20call%20body%20hash%20and%20a%20complete%20certified%20inverse%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bfixture%2Chistory%7D%3DgenerateRawOracleContractPartitions%28%7Bcheck%3Atrue%7D%29%3