0A%20%20%20%20%20%20%20%20%20%20%20%20echo%20%27%3A%3Awarning%3A%3AThe%20live%20dependency%20audit%20reported%20failures.%20Its%20retained%20findings%20require%20repair%3B%20no%20PR%20or%20delivery%20gate%20is%20waived.%27%0A%20%20%20%20%20%20%20%20%20%20fi%0A%0A%20%20%20%20%20%20-%20name%3A%20Open%20or%20update%20the%20refresh%20pull%20request%0A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20GH_TOKEN%3A%20%24%7B%7B%20github.token%20%7D%7D%0A%20%20%20%20%20%20%20%20%20%20BRANCH%3A%20automation%2Fdependency-refresh%0A%20%20%20%20%20%20%20%20%20%20AUDIT_OUTCOME%3A%20%24%7B%7B%20steps.audit.outcome%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20%7C%0A%20%20%20%20%20%20%20%20%20%20if%20git%20diff%20--quiet%3B%20then%0A%20%20%20%20%20%20%20%20%20%20%20%20if%20%5B%20%22%24AUDIT_OUTCOME%22%20%3D%20success%20%5D%3B%20then%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20echo%20%22dependencies%20and%20the%20audit%20are%20current%22%0A%20%20%20%20%20%20%20%20%20%20%20%20else%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20echo%20%22no%20tracked%20updates%3B%20live%20audit%20findings%20remain%20in%20the%20retained%20report%22%0A%20%20%20%20%20%20%20%20%20%20%20%20fi%0A%20%20%20%20%20%20%20%20%20%20%20%20exit%200%0A%20%20%20%20%20%20%20%20%20%20fi%0A%20%20%20%20%20%20%20%20%20%20git%20config%20user.name%20%27github-actions%5Bbot%5D%27%0A%20%20%20%20%20%20%20%20%20%20git%20config%20user.email%20%2741898282%2Bgithub-actions%5Bbot%5D%40users.noreply.github.com%27%0A%20%20%20%20%20%20%20%20%20%20git%20switch%20--create%20%22%24BRANCH%22%0A%20%20%20%20%20%20%20%20%20%20git%20commit%20--all%20--message%20%22chore%28deps%29%3A%20scheduled%20dependency%20refresh%20%28%24%28date%20-u%20%2B%25F%29%29%22%0A%20%20%20%20%20%20%20%20%20%20git%20push%20--force%20origin%20%22%24BRANCH%22%0A%20%20%20%20%20%20%20%20%20%20body%3D%22%24RUNNER_TEMP%2Fdependency-refresh-pr.md%22%0A%20%20%20%20%20%20%20%20%20%20cat%20%3E%20%22%24body%22%20%3C%3CEOF%0A%20%20%20%20%20%20%20%20%20%20Lockfile%20updat