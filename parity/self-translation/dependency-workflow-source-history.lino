(37585: (meta: (t: semantic) (n: 1) (term: string%20value) (def: tokenize%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fsrc%2Ftranslation%2Flexer.js%27%3B%0Aimport%20%7BDecoratorSet%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fsrc%2Fdecorators.js%27%3B%0Aimport%20%7BcheckProjectData%2CwriteProjectData%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BbuildOutcomePacket%7D%20from%20%27..%2Fwire%2Fgenerate.mjs%27%3B%0Aimport%20%7BoutcomeWireEvents%7D%20from%20%27..%2Fwire%2Fevents.mjs%27%3B%0Aimport%20%7BproposeParent%7D%20from%20%27..%2Fbridge%2Fgenerate.mjs%27%3B%0Aimport%20%7BprojectHistoricalOutcomeInventory%7D%20from%20%27..%2F..%2F..%2Fgrammar-context-source-metadata%2Fhistorical-inventory.mjs%27%3B%0A%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F..%2F..%2F%27%2Cimport.meta.url%29%3B%0Aconst%20pin%3Dsource%3D%3E%28%7Bbytes%3ABuffer.byteLength%28source%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%7D%29%3B%0A%0Afunction%20replaceObservationSourceTokens%28source%2Creplacements%29%20%7B%0A%20%20const%20%7Btokens%7D%3Dtokenize%28source%2C%27Rust%27%29%2Cedits%3D%5B%5D%3B%0A%20%20for%28let%20index%3D0%3Bindex%3Ctokens.length%3Bindex%2B%2B%29%7B%0A%20%20%20%20const%20token%3Dtokens%5Bindex%5D%3B%0A%20%20%20%20if%28token.kind%21%3D%3D%27identifier%27%7C%7C%21Object.hasOwn%28replacements%2Ctoken.value%29%29continue%3B%0A%20%20%20%20const%20replacement%3Dreplacements%5Btoken.value%5D%3B%0A%20%20%20%20if%28typeof%20replacement%3D%3D%3D%27string%27%29edits.push%28%7Bstart%3Atoken.start%2Cend%3Atoken.end%2Cfrom%3Atoken.value%2Cto%3Areplacement%7D%29%3B%0A%20%20%20%20else%20%7B%0A%20%20%20%20%20%20assert.equal%28tokens%5Bindex%2B1%5D%3F.value%2C%27%3A%3A%27%29%3Bassert.ok%28replacement.names.includes%28tokens%5Bindex%2B2%5D%3F.value%29%2C%27only%20an%20actual%20source-owned%20crate-root%20type%20is%20relocated%27%29%3B%0A%20%20%20%20%20%20edits.push%28%7Bstart%3Atoken.start%2Cend%3Atokens%5Bindex%2B1%5D.end%2Cfrom%