20changed%5Cn%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27two%20required%20raw%20contract%20cells%20preserve%20complete%20commands%20limits%20and%20the%20preceding%20whole%20workflow%27%2C%28%29%3D%3E%7B%0A%20%20const%20%7Bhistory%7D%3DgenerateRawOracleContractPartitions%28%7Bcheck%3Atrue%7D%29%2Cpath%3D%27.github%2Fworkflows%2Fjs.yml%27%3B%0A%20%20const%20currentSource%3DreadFileSync%28new%20URL%28%27..%2F..%2F%27%2Bpath%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20const%20previousSource%3Dhistory.sources.find%28row%3D%3Erow.path%3D%3D%3Dpath%29.source%3B%0A%20%20assert.equal%28restoreRawOracleContractPartitionHistory%28currentSource%2Cpath%29%2CpreviousSource%29%3B%0A%20%20const%20previous%3DparseWorkflow%28previousSource%29%2Ccurrent%3DparseWorkflow%28currentSource%29%3B%0A%20%20assert.equal%28current.length%2Cprevious.length%29%3B%0A%20%20const%20before%3Dprevious.find%28row%3D%3Erow.id%3D%3D%3D%27package-checks%27%29%2Cafter%3Dcurrent.find%28row%3D%3Erow.id%3D%3D%3D%27package-checks%27%29%3B%0A%20%20assert.equal%28after.steps.length%2Cbefore.steps.length%2B1%29%3B%0A%20%20const%20old%3Dbefore.steps.find%28row%3D%3Erow.name%3D%3D%3D%27Run%20complete%20original%20link%20raw%20native%20oracle%20contracts%27%29%3B%0A%20%20const%20plan%3Dafter.steps.find%28row%3D%3Erow.name%3D%3D%3Dold.name%29%3B%0A%20%20const%20schema%3Dafter.steps.find%28row%3D%3Erow.name%3D%3D%3D%27Run%20complete%20original%20link%20raw%20schema%20and%20consumer%20contracts%27%29%3B%0A%20%20assert.equal%28plan.text.replace%28%22%5Cn%20%20%20%20%20%20%20%20%20%20ORIGINAL_LINK_RAW_CONTRACT_PARTITION%3A%20%27plan%27%22%2C%27%27%29%2Cold.text%29%3B%0A%20%20assert.equal%28schema.text.replace%28%22%5Cn%20%20%20%20%20%20%20%20%20%20ORIGINAL_LINK_RAW_CONTRACT_PARTITION%3A%20%27schema%27%22%2C%27%27%29%0A%20%20%20%20.replace%28%27Run%20complete%20original%20link%20raw%20schema%20and%20consumer%20contracts%27%2Cold.name%29%0A%20%20%20%20.replace%28%22matrix.group%20%3D%3D%20%27source-model-raw-schema%27%22%2C%2