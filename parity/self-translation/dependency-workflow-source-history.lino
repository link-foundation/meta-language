mplete%20parser%20and%20boundary%20expectations%20remain%20exact%27%29%3B%0A%20%20%20%20assert.equal%28current.cases.length%2C14%29%3B%0A%20%20%20%20for%28const%20%5Bindex%2Crow%5Dof%20inverse.inputs.entries%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28row.path%2Cprevious.inputs%5Bindex%5D.path%29%3B%0A%20%20%20%20%20%20if%28row.path%21%3D%3D%27js%2Fsrc%2Fgrammar-runtime%2Fgrammar-selection.js%27%29continue%3B%0A%20%20%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28row.path%2Croot%29%2C%27utf8%27%29%3Bassert.deepEqual%28pin%28source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20%20%20const%20restored%3DrestoreGlobalGrammarContextSource%28row.path%2Csource%29%3Bassert.equal%28restored.changed%2Ctrue%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28restored.predecessor%29%2C%7Bbytes%3Aprevious.inputs%5Bindex%5D.bytes%2Csha256%3Aprevious.inputs%5Bindex%5D.sha256%7D%29%3B%0A%20%20%20%20%20%20Object.assign%28row%2Cprevious.inputs%5Bindex%5D%29%3B%0A%20%20%20%20%7D%0A%20%20%7Delse%7B%0A%20%20%20%20for%28const%20%5Bindex%2Crow%5Dof%20inverse.inputs.entries%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28row.file%2Cprevious.inputs%5Bindex%5D.file%29%3B%0A%20%20%20%20%20%20if%28row.file%21%3D%3D%27rust%2Fsrc%2Fgrammar%2Ffeature_runtime%2Fgrammar_selection.rs%27%29continue%3B%0A%20%20%20%20%20%20const%20source%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%3Bassert.deepEqual%28pin%28source%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%20%20%20%20%20%20const%20restored%3DrestoreGlobalGrammarContextSource%28row.file%2Csource%29%3Bassert.equal%28restored.changed%2Ctrue%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28pin%28restored.predecessor%29%2C%7Bbytes%3Aprevious.inputs%5Bindex%5D.bytes%2Csha256%3Aprevious.inputs%5Bindex%5D.sha256%7D%29%3B%0A%20%20%20%20%20%20Object.assign%28row%2Cprevious.inputs%5Bindex%5D%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20assert.deepEqual%28inverse%2Cprevious%2C%27all%20other%20compl