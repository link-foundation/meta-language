ries%3D%5B300%2C290%2C10%2C10%5D.map%28%28milliseconds%2Cindex%29%3D%3E%7Bconst%20%5Bfile%2Csource%5D%3D%5B...sources%5D%5Bindex%5D%3Breturn%7Bfile%2Cbytes%3ABuffer.byteLength%28source%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%2Cmilliseconds%7D%3B%7D%29%3B%0A%20%20const%20costs%3D%7BschemaVersion%3A1%2Cmodel%3A%27observed%20CI%20workload%20scheduling%20costs%201%27%2Crun%3A39615628279%2Crevision%3A%278bc0ef9725388c7927acf1854870bf46f5e365be%27%2Centries%7D%3B%0A%20%20const%20files%3D%5B...sources.keys%28%29%5D%2Coptions%3D%7Bcosts%2CreadSource%3Afile%3D%3Esources.get%28file%29%7D%3B%0A%20%20const%20shards%3DpartitionMeasuredWorkloads%28files%2C2%2Coptions%29%3B%0A%20%20assert.deepEqual%28shards.flat%28%29.sort%28%29%2Cfiles.sort%28%29%29%3B%0A%20%20assert.notEqual%28shards.findIndex%28shard%3D%3Eshard.includes%28%27slow-a.js%27%29%29%2Cshards.findIndex%28shard%3D%3Eshard.includes%28%27slow-b.js%27%29%29%29%3B%0A%20%20const%20load%3Dshard%3D%3Eshard.reduce%28%28sum%2Cfile%29%3D%3Esum%2Bentries.find%28row%3D%3Erow.file%3D%3D%3Dfile%29.milliseconds%2C0%29%3B%0A%20%20assert.ok%28Math.abs%28load%28shards%5B0%5D%29-load%28shards%5B1%5D%29%29%3C%3D10%29%3B%0A%20%20assert.deepEqual%28partitionMeasuredWorkloads%28%5B...files%5D.reverse%28%29%2C2%2Coptions%29%2Cshards%2C%27source%20traversal%20order%20cannot%20change%20owners%27%29%3B%0A%20%20for%28const%20count%20of%5B0%2C1.5%2C5%5D%29assert.throws%28%28%29%3D%3EpartitionMeasuredWorkloads%28files%2Ccount%2Coptions%29%29%3B%0A%20%20assert.throws%28%28%29%3D%3EpartitionMeasuredWorkloads%28%5B...files%2Cfiles%5B0%5D%5D%2C2%2Coptions%29%29%3B%0A%20%20for%28const%20change%20of%5Bvalue%3D%3E%7Bvalue.entries%5B0%5D.milliseconds%3D-1%3B%7D%2Cvalue%3D%3E%7Bvalue.entries.push%28value.entries%5B0%5D%29%3B%7D%2Cvalue%3D%3E%7Bvalue.revision%3D%270%27.repeat%2840%29%3B%7D%5D%29%7B%0A%20%20%20%20const%20changed%3DstructuredClone%28costs%29%3Bchange%28changed%29%3Bassert.throws%28%28%29%3D%3Epartiti