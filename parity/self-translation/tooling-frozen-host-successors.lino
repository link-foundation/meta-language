st%20result%20%3D%20invoke%28resolved%29%3B%0A%20%20%20%20assert.match%28result.error%3F.message%20%3F%3F%20%27%27%2C%20%2FWindows%20%28%3F%3Alinker%20lookup%20failed%7Cnative%20child%20resolves%29%2Fu%29%3B%0A%20%20%20%20assert.equal%28result.calls.length%2C%201%29%3B%0A%20%20%20%20assert.deepEqual%28result.output%2C%20%5B%5D%2C%20%27failed%20resolution%20cannot%20produce%20a%20successful%20native%20observation%27%29%3B%0A%20%20%7D%0A%20%20for%20%28const%20selected%20of%20%5B%27%27%2C%20%27relative%2Flink.exe%27%5D%29%20%7B%0A%20%20%20%20const%20result%20%3D%20invoke%28success%2C%20selected%29%3B%0A%20%20%20%20assert.match%28result.error%3F.message%20%3F%3F%20%27%27%2C%20%2Fvalidated%20absolute%20MSVC%20linker%20path%2Fu%29%3B%0A%20%20%20%20assert.deepEqual%28result.calls%2C%20%5B%5D%2C%20%27an%20unvalidated%20linker%20never%20starts%20a%20process%27%29%3B%0A%20%20%20%20assert.deepEqual%28result.output%2C%20%5B%5D%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27release%20queue%20assertion%20correction%20retains%20the%20complete%20failed%20input%20and%20every%20publication%20safeguard%27%2C%20%28%29%20%3D%3E%20%7B%0A%20%20const%20evidence%20%3D%20readProjectData%28path.join%28root%2C%20%27parity%2Ffixtures%2Fpackage-release-concurrency-correction.lino%27%29%29%3B%0A%20%20const%20digest%20%3D%20value%20%3D%3E%20createHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0A%20%20assert.equal%28evidence.run%2C%2039274710187%29%3Bassert.equal%28evidence.job%2C%20118135888518%29%3B%0A%20%20assert.equal%28evidence.testedCommit%2C%20%27a6d2ffa00713fa20ba23fd90c586a2ea6b6fa584%27%29%3B%0A%20%20assert.equal%28Buffer.byteLength%28evidence.log.source%29%2C%20evidence.log.bytes%29%3B%0A%20%20assert.equal%28evidence.log.sha256%2C%20%2789e4a982bd81b95a33093af8987a83d5a60b468ecdd57853f32f2c274ad8425f%27%29%3B%0A%20%20assert.equal%28digest%28evidence.log.source%29%2C%20evidence.log.sha256%29%3B%0A%20%20assert.ok%28evidence.log.source.includes%28%27not%20ok%2078%20-%20JavaS