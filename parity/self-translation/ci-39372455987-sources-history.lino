(34257: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20test%20from%20%27node%3Atest%27%3B%0Aimport%20%7BgenerateRootTypeOptionHistory%7D%20from%20%27..%2Fscripts%2Fgenerate-root-type-option-history.mjs%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27..%2Fscripts%2Fgit-object-certificate.mjs%27%3B%0A%0Aconst%20root%3Dnew%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%3B%0Atest%28%27the%20native%20root-type%20compiler%20correction%20preserves%20every%20whole%20original%20source%20assertion%20and%20graph%20fixture%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DgenerateRootTypeOptionHistory%28%7Bcheck%3Atrue%7D%29%2Csource%3Dhistory.sources%5B0%5D%3B%0A%20%20verifyGitArtifactCertificate%28source.certificate%2CBuffer.from%28source.sourceText%29%2C%7Brevision%3Ahistory.revision%2Cpath%3Asource.file%7D%29%3B%0A%20%20let%20current%3DreadFileSync%28new%20URL%28source.file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20for%28const%20action%20of%20%5B...history.actions%5D.reverse%28%29%29%7B%0A%20%20%20%20assert.equal%28current.split%28action.to%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28action.to%2Caction.from%29%3B%0A%20%20%7D%0A%20%20assert.equal%28current%2Csource.sourceText%29%3B%0A%20%20assert.equal%28history.actions.length%2C5%29%3Bassert.equal%28history.observedCompilerDiagnostics.error%2C%27E0308%27%29%3B%0A%20%20assert.equal%28history.observedCompilerDiagnostics.expected%2C%27Option%3CLinkType%3E%27%29%3B%0A%20%20assert.equal%28history.observedCompilerDiagnostics.actual%2C%27LinkType%27%29%3B%0A%20%20assert.ok%28history.accessor.declaration.includes%28%27-%3E%20Option%3CLinkType%3E%27%29%29%3B%0A%20%20assert.equal%28history.observedLintDiagnostics.correctedBinding%2C%27type_designations%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27neither%20unrelated%20source%20edits%20nor%20loss%20of%20a%20root-type%20assertion%20can%20satisfy%20the%20exact%20retained%20correction%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DgenerateRootTypeOptionHistory%28%7Bcheck%3Atrue%7D%29%2Csource%3Dhistory.sources%5B0%5D%3B%0A%20%20assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28source.certificate%2CBuffer.from%28source.sourceText.replace%28%27assert_eq%21%27%2C%27assert_ne%21%27%29%29%2C%7Brevision%3Ahistory.revision%2Cpath%3Asource.file%7D%29%29%3B%0A%20%20const%20corrected%3DreadFileSync%28new%20URL%28source.file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20assert.ok%28corrected.includes%28%27Some%28root_type_kind%28declaration%5B%22type%22%5D.as_str%28%29.unwrap%28%29%29%29%27%29%29%3B%0A%20%20assert.ok%28corrected.includes%28%27link.metadata%28%29.link_type%28%29%20%3D%3D%20Some%28LinkType%3A%3AType%29%27%29%29%3B%0A%20%20assert.ok%28corrected.includes%28%27.with_link_type%28root_type_kind%28%27%29%2C%27the%20constructor%20still%20takes%20the%20original%20nonoptional%20type%27%29%3B%0A%20%20assert.equal%28%28corrected.match%28%2F%5Cbassert%28%3F%3A_eq%7C_ne%29%3F%21%2Fgu%29%3F%3F%5B%5D%29.length%2C%28source.sourceText.match%28%2F%5Cbassert%28%3F%3A_eq%7C_ne%29%3F%21%2Fgu%29%3F%3F%5B%5D%29.length%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
