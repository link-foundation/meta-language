(19471: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20CI-only%20acquisition%20into%20stopped-task%20scratch%2C%20using%20the%20exact%20frozen%20registry%0A%2F%2F%20and%20unchanged%20existing%20checksum-verifying%20downloader.%20Never%20store%20sources%20here.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BexistsSync%2ClstatSync%2CreadFileSync%2CrealpathSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7Bjoin%2Cresolve%7D%20from%20%27node%3Apath%27%3B%0Aimport%20%7BpathToFileURL%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BreadProjectData%2CwriteProjectData%7D%20from%20%27..%2F..%2F..%2F..%2Fjs%2Fscripts%2Fproject-data.mjs%27%3B%0Aimport%20%7BrequireNativeCI%7D%20from%20%27.%2Frun.mjs%27%3B%0Aimport%20%7BbytesAt%2Csha256%2Cwithin%7D%20from%20%27.%2Fplan.mjs%27%3B%0A%0Aexport%20function%20requireOwnedAssetScratch%28%7Brepository%2Cwork%2Coverlay%2Crequest%2Creceipt%7D%2Cenvironment%3Dprocess.env%29%20%7B%0A%20%20const%20temporary%3DrequireNativeCI%28%7Brepository%7D%2Cenvironment%29%3B%0A%20%20work%3DrealpathSync%28work%29%3Boverlay%3DrealpathSync%28overlay%29%3B%0A%20%20assert.ok%28within%28temporary%2Cwork%29%26%26within%28work%2Coverlay%29%2C%27external%20owned%20scratch%20only%27%29%3B%0A%20%20assert.ok%28within%28work%2Crequest%29%26%26within%28repository%2Creceipt%29%2C%27request%20and%20retained%20receipt%20owners%27%29%3B%0A%20%20assert.equal%28readProjectData%28join%28work%2C%27.meta-language-bulk95-owned.lino%27%29%29.repository%2Crepository%29%3B%0A%20%20assert.ok%28lstatSync%28overlay%29.isDirectory%28%29%26%26%21lstatSync%28overlay%29.isSymbolicLink%28%29%29%3B%0A%20%20assert.ok%28%21existsSync%28join%28overlay%2C%27.git%27%29%29%2C%27scratch%20asset%20root%20must%20not%20be%20a%20checkout%27%29%3B%0A%20%20return%7Bwork%2Coverlay%7D%3B%0A%7D%0A%0Aasync%20function%20main%28%29%20%7B%0A%20%20const%20args%3Dprocess.argv.slice%282%29%3B%0A%20%20assert.equal%28args.length%2C12%29%3B%0A%20%20const%20options%3D%7B%7D%3B%0A%20%20for%28let%20index%3D0%3Bindex%3Cargs.length%3Bindex%2B%3D2%29%20%7B%0A%20%20%20%20assert.ok%28%5B%27--repository%27%2C%27--work%27%2C%27--overlay%27%2C%27--request%27%2C%27--request-sha256%27%2C%27--receipt%27%5D.includes%28args%5Bindex%5D%29%29%3B%0A%20%20%20%20const%20name%3Dargs%5Bindex%5D.slice%282%29%3Bassert.ok%28%21options%5Bname%5D%29%3Boptions%5Bname%5D%3Dargs%5Bindex%2B1%5D%3B%0A%20%20%7D%0A%20%20const%20repository%3DrealpathSync%28options.repository%29%2Cwork%3DrealpathSync%28options.work%29%2Coverlay%3DrealpathSync%28options.overlay%29%3B%0A%20%20const%20request%3Dresolve%28options.request%29%2Creceipt%3Dresolve%28options.receipt%29%3B%0A%20%20requireOwnedAssetScratch%28%7Brepository%2Cwork%2Coverlay%2Crequest%2Creceipt%7D%29%3B%0A%20%20assert.equal%28sha256%28readFileSync%28request%29%29%2Coptions%5B%27request-sha256%27%5D%2C%27exact%20parent-authored%20frozen%20asset%20request%27%29%3B%0A%20%20const%20policy%3DreadProjectData%28request%29%3B%0A%20%20assert.equal%28policy.schemaVersion%2C1%29%3Bassert.equal%28policy.group%2C%27native-oracles%27%29%3B%0A%20%20assert.equal%28sha256%28bytesAt%28repository%2Cpolicy.provisioner.file%29%29%2Cpolicy.provisioner.sha256%2C%27unchanged%20frozen%20asset%20downloader%27%29%3B%0A%20%20const%20%7BdownloadExternalGrammarAssets%2CexternalGrammarPath%7D%3Dawait%20import%28pathToFileURL%28join%28repository%2Cpolicy.provisioner.file%29%29%29%3B%0A%20%20const%20manifest%3D%7BschemaVersion%3A1%2Cassets%3AObject.fromEntries%28policy.assets.map%28%28%7Bpath%2C...asset%7D%29%3D%3E%7B%0A%20%20%20%20assert.ok%28%2F%5Erust%5C%2Fvendor%5C%2Ftree-sitter-%5Ba-z-%5D%2B%5C%2Fsrc%5C%2F%2Fu.test%28path%29%2C%27only%20native%20oracle%20source%20assets%27%29%3B%0A%20%20%20%20assert.equal%28asset.group%2Cpolicy.group%29%3Breturn%5Bpath%2Casset%5D%3B%0A%20%20%7D%29%29%7D%3B%0A%20%20const%20context%3D%7Broot%3Aoverlay%2CcacheRoot%3Ajoin%28work%2C%27external-grammar-assets%27%29%2Cmanifest%7D%3B%0A%20%20const%20captured%3D%7BschemaVersion%3A1%2Cscope%3A%27Authenticated%20temporary%20native%20oracle%20build%20inputs%3B%20no%20grammar%20capability%20evidence.%27%2C%0A%20%20%20%20manifest%3Apolicy.manifest%2Cprovisioner%3Apolicy.provisioner%2CclosureInputs%3Apolicy.closureInputs%2Cfiles%3A%5B%5D%7D%3B%0A%20%20let%20failure%3B%0A%20%20try%20%7B%0A%20%20%20%20await%20downloadExternalGrammarAssets%28%7B...context%2Cassets%3Apolicy.assets.map%28asset%3D%3Easset.path%29%2Cmaterialize%3Atrue%2C%0A%20%20%20%20%20%20jobs%3Apolicy.jobs%2CtimeoutMs%3Apolicy.requestTimeoutMs%7D%29%3B%0A%20%20%7D%20catch%28error%29%20%7Bfailure%3Derror%3Bcaptured.error%3D%7Bname%3Aerror.name%2Cmessage%3Aerror.message%7D%3B%7D%0A%20%20finally%20%7B%0A%20%20%20%20for%28const%20asset%20of%20policy.assets%29%20%7B%0A%20%20%20%20%20%20if%28%21existsSync%28join%28overlay%2Casset.path%29%29%29continue%3B%0A%20%20%20%20%20%20const%20actual%3DexternalGrammarPath%28asset.path%2Ccontext%29%3Bassert.ok%28within%28overlay%2CrealpathSync%28actual%29%29%2C%27asset%20is%20materialized%20in%20owned%20overlay%27%29%3B%0A%20%20%20%20%20%20const%20bytes%3DreadFileSync%28actual%29%3B%0A%20%20%20%20%20%20captured.files.push%28%7Bpath%3Aasset.path%2Cbytes%3Abytes.length%2Csha256%3Asha256%28bytes%29%2C%0A%20%20%20%20%20%20%20%20...%28asset.encoding%3D%3D%3D%27gzip%27%3F%7BdecodedBytes%3Aasset.decodedBytes%2CdecodedSha256%3Aasset.decodedSha256%7D%3A%7B%7D%29%7D%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20writeProjectData%28receipt%2Ccaptured%29%3B%0A%20%20%7D%0A%20%20if%28failure%29throw%20failure%3B%0A%20%20assert.equal%28captured.files.length%2Cpolicy.assets.length%2C%27every%20registered%20build%20input%20was%20authenticated%27%29%3B%0A%20%20console.log%28%27Authenticated%20%27%2Bcaptured.files.length%2B%27%20temporary%20native%20oracle%20source%20assets.%27%29%3B%0A%7D%0Aif%28process.argv%5B1%5D%26%26pathToFileURL%28resolve%28process.argv%5B1%5D%29%29.href%3D%3D%3Dimport.meta.url%29await%20main%28%29%3B%0A) (lang: meta-language%20structured%20data)))
