data%28%29.link_type%28%29%20%3D%3D%20LinkType%3A%3AType%27%2Cto%3A%27link.metadata%28%29.link_type%28%29%20%3D%3D%20Some%28LinkType%3A%3AType%29%27%7D%2C%0A%20%20%20%20%7Bfrom%3A%27let%20types%20%3D%20network%27%2Cto%3A%27let%20type_designations%20%3D%20network%27%7D%2C%0A%20%20%20%20%7Bfrom%3A%27types.len%28%29%27%2Cto%3A%27type_designations.len%28%29%27%7D%2C%0A%20%20%20%20%7Bfrom%3A%27types%5B0%5D%27%2Cto%3A%27type_designations%5B0%5D%27%7D%2C%0A%20%20%5D%3B%0A%20%20let%20corrected%3DsourceText%3B%0A%20%20for%28const%20action%20of%20actions%29%7Bassert.equal%28corrected.split%28action.from%29.length%2C2%29%3Bcorrected%3Dcorrected.replace%28action.from%2Caction.to%29%3B%7D%0A%20%20assert.equal%28corrected%2Ccurrent%2C%27only%20the%20two%20Option%20corrections%20and%20recorded%20local%20binding%20rename%20are%20admitted%27%29%3B%0A%20%20let%20inverse%3Dcurrent%3Bfor%28const%20action%20of%20%5B...actions%5D.reverse%28%29%29%7Bassert.equal%28inverse.split%28action.to%29.length%2C2%29%3Binverse%3Dinverse.replace%28action.to%2Caction.from%29%3B%7D%0A%20%20assert.equal%28inverse%2CsourceText%2C%27every%20original%20source%20byte%20assertion%20and%20input%20survives%20exact%20inverse%27%29%3B%0A%20%20const%20accessorFile%3D%27rust%2Fsrc%2Flink_network.rs%27%2CaccessorSource%3DreadFileSync%28new%20URL%28accessorFile%2Croot%29%2C%27utf8%27%29%3B%0A%20%20const%20accessor%3DreadSourceTextRustBlock%28accessorSource%2C%27fn%27%2C%27link_type%27%29%3B%0A%20%20assert.ok%28accessor.startsWith%28%27fn%20link_type%28%26self%29%20-%3E%20Option%3CLinkType%3E%27%29%29%3B%0A%20%20assert.ok%28accessor.includes%28%27self.link_type%27%29%29%3B%0A%20%20const%20fixtureFile%3D%27parity%2Ffixtures%2Froot-type-behavior.lino%27%2Cfixture%3DreadFileSync%28new%20URL%28fixtureFile%2Croot%29%29%3B%0A%20%20const%20priorFixture%3DcaptureGitArtifactCertificate%28revision%2CfixtureFile%29%3Bassert.ok%28fixture.equals%28priorFixture.blob%29%29%3B%0A%20%20const%20history%3D%7BschemaVersion%3A1%2Crevision%2Csources%3A%5B%7Bfile%2Ccommit%3Arevision%2C...pin%28original.blob%29%2CsourceText%2Ccertificate%3Aoriginal.certificate%2Ccurrent%3Apin%28current%29%7D%5D%2Cactions%2C%0A%20%20%20%20accessor%3A%7Bfile%3AaccessorFile%2C...pin%28accessorSource%29%2Cdeclaration%3Aaccessor%7D%2Cfixture%3A%7Bfile%3AfixtureFile%2C...pin%28fixture%29%7D%2C%0A%20%20%20%20observedCompilerDiagnostics%3A%7Brun%3A39359700443%2Cjob%3A118431586516%2ClogBytes%3A54994%2ClogSha256%3A%2715040dab1c7f25252bfab6dc4b636a40f66e270b15e87891cf41a6168cffbd8b%27%2C%0A%20%20%20%20%20%20error%3A%27E0308%27%2Cexpected%3A%27Option%3CLinkType%3E%27%2Cactual%3A%27LinkType%27%2Clines%3A%5B96%2C108%5D%7D%2C%0A%20%20%20%20observedLintDiagnostics%3A%7Brun%3A39359700443%2Cjob%3A118431586371%2ClogBytes%3A200564%2ClogSha256%3A%278d6f8c7e9b9c62c2f138704db97e9c63b9a71943c84681390efcaf0f1c729feb%27%2C%0A%20%20%20%20%20%20lint%3A%27similar_names%27%2CoriginalBinding%3A%27types%27%2CcorrectedBinding%3A%27type_designations%27%7D%2C%0A%20%20%20%20boundary%3A%27The%20current%20actual%20accessor%20returns%20an%20optional%20metadata%20type.%20Both%20present-type%20expectations%20select%20Some%20and%20one%20local%20binding%20has%20an%20unambiguous%20name%2C%20without%20changing%20any%20original%20fixture%2C%20assertion%2C%20graph%20role%20or%20refusal.%20Historical%20source%20membership%20and%20exact%20source%20inverse%20supply%20no%20corrected%20native%20execution%20evidence.%27%7D%3B%0A%20%20const%20output%3Dnew%20URL%28%27..%2F..%2Fparity%2Fself-translation%2Froot-type-option-source-history.lino%27%2Cimport.meta.url%29%3B%0A%20%20if%28check%29checkProjectData%28output%2Chistory%29%3Belse%20writeProjectData%28output%2Chistory%29%3B%0A%20%20return%20history%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateRootTypeOptionHistory%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%