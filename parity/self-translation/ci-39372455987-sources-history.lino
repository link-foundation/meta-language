nst%20current%3DreadFileSync%28new%20URL%28row.file%2Croot%29%2C%27utf8%27%29%3Bassert.deepEqual%28pin%28current%29%2Crow.current%29%3B%0A%20%20%20%20let%20previous%3Dcurrent%3B%0A%20%20%20%20for%28const%20action%20of%20%5B...row.actions%5D.reverse%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28previous.split%28action.to%29.length%2C2%29%3Bprevious%3Dprevious.replace%28action.to%2Caction.from%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28previous%2Crow.sourceText%29%3B%0A%20%20%20%20assert.throws%28%28%29%3D%3EverifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.sourceText%2B%27%5Cn%27%29%2C%7Brevision%3Ahistory.revision%2Cpath%3Arow.file%7D%29%29%3B%0A%20%20%7D%0A%20%20for%28const%20row%20of%20history.unchanged%29assert.deepEqual%28pin%28readFileSync%28new%20URL%28row.file%2Croot%29%29%29%2C%7Bbytes%3Arow.bytes%2Csha256%3Arow.sha256%7D%29%3B%0A%7D%29%3B%0A%0Atest%28%27every%20complete%20static-borrow%20test%20input%20and%20assertion%20remains%20exact%20modulo%20value%20preserving%20separators%27%2C%28%29%3D%3E%7B%0A%20%20const%20history%3DgenerateStaticBorrowModuleHistory%28%7Bcheck%3Atrue%7D%29%2Cprevious%3Dhistory.sources.find%28row%3D%3Erow.file.endsWith%28%27grammar_outcome_static_borrows.rs%27%29%29%3B%0A%20%20const%20current%3DreadFileSync%28new%20URL%28previous.file%2Croot%29%2C%27utf8%27%29%3B%0A%20%20for%28const%20name%20of%20%5B%27generated_static_reference_selection_preserves_all_independent_cases_and_resource_boundaries%27%2C%0A%20%20%20%20%27native_storage_returns_the_actual_existing_static_reference_without_allocating_a_new_lifetime%27%5D%29%7B%0A%20%20%20%20assert.equal%28normalizeNativeLiteralSeparators%28readSourceTextRustBlock%28current%2C%27fn%27%2Cname%29%29%2C%0A%20%20%20%20%20%20readSourceTextRustBlock%28previous.sourceText%2C%27fn%27%2Cname%29%2C%27complete%20bodies%20retain%20every%20original%20assertion%20and%20source%20input%27%29%3B%0A%20%20%7D%0A%20%20assert.ok%28current.includes%28%27use%20storage%3A%3Arules%3B%27%29%29%3B%0A%20%20assert.ok%28%21current.includes%28%27mod%20rules%3B%27%29%29%3B%0A%20%20assert.ok%28readFileSync%28new%20URL%28history.sources%5B0%5D.file%2Croot%29%2C%27utf8%27%29.includes%28%27pub%28super%29%20mod%20rules%3B%27%29%29%3B%0A%20%20for%28const%20%5Boriginal%2Ccurrent%5Dof%20%5B%5B%271048576.0%27%2C%271_048_576.0%27%5D%2C%5B%271048577.0%27%2C%271_048_577.0%27%5D%2C%5B%271048577%27%2C%271_048_577%27%5D%5D%29%0A%20%20%20%20assert.equal%28Number%28original%29%2CNumber%28current.replaceAll%28%27_%27%2C%27%27%29%29%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
