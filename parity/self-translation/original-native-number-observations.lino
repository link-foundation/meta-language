(401: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20The%20public%20concrete%20syntax%20tree%20of%20the%20native%20grammar%20executor%20and%20its%0A%2F%2F%21%20compact%2C%20stable%20text%20rendering%20%28docs%2Fgrammar%2Ffeature-union.md%23syntax-tree%29%2C%0A%2F%2F%21%20as%20%60js%2Fsrc%2Fgrammar-runtime%2Fsyntax-tree.js%60.%20Every%20node%20keeps%20its%20byte%20span%2C%0A%2F%2F%21%20every%20token%20its%20exact%20text%2C%20and%20trivia%2C%20ERROR%2C%20MISSING%20and%0A%2F%2F%21%20embedded-language%20nodes%20stay%20in%20the%20tree%2C%20so%20the%20tree%20reproduces%20the%20input%0A%2F%2F%21%20byte%20for%20byte.%0A%0Ause%20std%3A%3Afmt%3A%3AWrite%20as%20_%3B%0A%0Ause%20indexmap%3A%3AIndexMap%3B%0A%0Ause%20super%3A%3Aoperations%3A%3AOperationValue%3B%0Ause%20super%3A%3Aprogram%3A%3ACompiled%3B%0Ause%20super%3A%3Aresults%3A%3A%7BTree%2C%20TreeType%7D%3B%0Ause%20super%3A%3Atext%3A%3A%7Bhex_of%2C%20quote_text%2C%20text_of%7D%3B%0A%0A%2F%2F%2F%20The%20attributes%20semantic%20actions%20set%20on%20a%20node%20or%20token%2C%20by%20name.%0Apub%20type%20SyntaxAttributes%20%3D%20IndexMap%3CString%2C%20OperationValue%3E%3B%0A%0A%2F%2F%2F%20The%20text%20of%20a%20leaf%3A%20the%20exact%20UTF-8%20text%2C%20or%20the%20hexadecimal%20spelling%20of%0A%2F%2F%2F%20bytes%20that%20are%20not%20well-formed%20UTF-8.%0A%23%5Bderive%28Clone%2C%20Debug%2C%20PartialEq%2C%20Eq%29%5D%0Apub%20enum%20LeafText%20%7B%0A%20%20%20%20%2F%2F%2F%20Well-formed%20UTF-8%20text.%0A%20%20%20%20Text%28String%29%2C%0A%20%20%20%20%2F%2F%2F%20The%20lower-case%20hexadecimal%20spelling%20of%20the%20bytes.%0A%20%20%20%20Hex%28String%29%2C%0A%7D%0A%0Aimpl%20LeafText%20%7B%0A%20%20%20%20fn%20of%28bytes%3A%20%26%5Bu8%5D%2C%20start%3A%20usize%2C%20end%3A%20usize%29%20-%3E%20Self%20%7B%0A%20%20%20%20%20%20%20%20text_of%28bytes%2C%20start%2C%20end%29.map_or_else%28%7C%7C%20Self%3A%3AHex%28hex_of%28bytes%2C%20start%2C%20end%29%29%2C%20Self%3A%3AText%29%0A%20%20%20%20%7D%0A%0A%20%20%20%20fn%20render%28%26self