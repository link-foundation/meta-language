dit.start%3C%3Dgenerated.length%29%3B%0A%20%20%20%20%20%20assert.equal%28generated.slice%28edit.start%2Cedit.start%2Bedit.removed.length%29%2Cedit.removed%29%3B%0A%20%20%20%20%20%20generated%3Dgenerated.slice%280%2Cedit.start%29%2Bedit.inserted%2Bgenerated.slice%28edit.start%2Bedit.removed.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28createHash%28%27sha256%27%29.update%28generated%29.digest%28%27hex%27%29%2Crow.currentSha256%2Crow.path%29%3B%0A%20%20%20%20let%20inverse%3Dgenerated%3B%0A%20%20%20%20for%28const%20edit%20of%20%5B...row.edits%5D.reverse%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2Crow.source%29%3B%0A%20%20%20%20const%20file%3Dnew%20URL%28row.path%2Croot%29%2Ccurrent%3DreadFileSync%28file%2C%27utf8%27%29%3B%0A%20%20%20%20if%28check%29assert.equal%28current%2Cgenerated%2Crow.path%29%3B%0A%20%20%20%20else%20%7Bassert.ok%28current%3D%3D%3Drow.source%7C%7Ccurrent%3D%3D%3Dgenerated%2C%27unknown%20current%20source%20%27%2Brow.path%29%3BwriteFileSync%28file%2Cgenerated%29%3B%7D%0A%20%20%7D%0A%20%20return%20archive%3B%0A%7D%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateTypeScriptReceiverParameters%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
