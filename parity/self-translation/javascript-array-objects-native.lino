(126: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadJavaScriptSemanticValueError%2CtestJavaScriptSemanticSameValue%2CtestJavaScriptSemanticAccessor%7D%20from%20%27.%2Fjavascript-semantic-values.js%27%3B%0A%0A%2F%2A%2A%20A%20normalized%20Property%20Descriptor%20keeps%20field%20presence%20independent%20of%20value.%0A%20%2A%20Its%20values%20belong%20to%20one%20checked%20semantic-value%2Fglobal-identity%20context.%0A%20%2A%20%40typedef%20%7B%7B%20configurablePresent%3Aboolean%2C%20configurable%3Aboolean%2C%0A%20%2A%20enumerablePresent%3Aboolean%2C%20enumerable%3Aboolean%2C%20valuePresent%3Aboolean%2C%0A%20%2A%20value%3AJavaScriptSemanticValue%2C%20writablePresent%3Aboolean%2C%20writable%3Aboolean%2C%0A%20%2A%20getterPresent%3Aboolean%2C%20getter%3AJavaScriptSemanticValue%2C%0A%20%2A%20setterPresent%3Aboolean%2C%20setter%3AJavaScriptSemanticValue%20%7D%7D%20JavaScriptPropertyDescriptor%0A%20%2A%2F%0A%0A%2F%2A%2A%20An%20ordered%20property%20list%20preserves%20creation%20order%20independently%20of%20lookup.%0A%20%2A%20Keys%20are%20actual%20UTF16%20text%20or%20globally%20identified%20Symbols%2C%20never%20coerced%20here.%0A%20%2A%20%40typedef%20%7B%7B%24%3A%27ordinaryProperty%27%2Ckey%3AJavaScriptSemanticValue%2Cdescriptor%3AJavaScriptPropertyDescriptor%7D%7D%20JavaScriptOrdinaryProperty%0A%20%2A%2F%0A%0A%2F%2A%2A%20%40param%20%7BJavaScriptPropertyDescriptor%7D%20descriptor%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readJavaScriptPropertyDescriptorKind%28descriptor%29%20%7B%0A%20%20const%20data%20%3D%20descriptor.valuePresent%20%7C%7C%20descriptor.writablePresent%3B%0A%20%20const%20accessor%20%3D%20descriptor.getterPresent%20%7C%7C%20descriptor.setterPresent%3B%0A%20%20return%20data%20%26%26%20accessor%20%3F%20%27invalid%27%20%3A%20data%20%3F%20%27data%27%20%3A%20accessor%20%3F%20%27accessor%27%20%3A%20%27generic%27%3B%0A%7D%0A%0A%2F%2A%2A%20Internal%20partial%20descriptors%20compare%20only%20present%20fields%2C%20using%20SameValue%