ss%20requires%20an%20actual%20direct%20Unit.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20collecting%20%40param%20%7Bboolean%7D%20proven%0A%20%2A%20%40param%20%7Bstring%7D%20type%20%40param%20%7Bboolean%7D%20indirected%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustUnitStatementDisposition%28kind%2Ccollecting%2Cproven%2Ctype%2Cindirected%29%7B%0A%20if%28kind%3D%3D%3D%27abort%27%29return%20%27abort%27%3B%0A%20if%28proven%26%26type%3D%3D%3D%27unit%27%26%26%21indirected%29return%20%27bind%27%3B%0A%20return%20collecting%26%26kind%3D%3D%3D%27app%27%3F%27bind%27%3A%27refuse%27%3B%0A%7D%0A%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20name%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustFunctionMacroDisposition%28name%29%7Breturn%20name%3D%3D%3D%27println%27%3F%27print%27%3A%27%27%3B%7D%0A%0A%2F%2A%2A%20The%20host%20has%20identified%20an%20actual%20return%20keyword%20at%20start.%20Only%20punctuation%0A%20%2A%20appears%20in%20values%3B%20literal%20text%20cannot%20supply%20a%20delimiter.%20A%20terminal%20return%0A%20%2A%20has%20no%20continuation%20before%20the%20owning%20function%20block%20closes.%0A%20%2A%20-1%20refuses%20a%20continuation%3B%20-2%20requests%20more%20actual%20source%20tokens.%0A%20%2A%20%40param%20%7Bstring%5B%5D%7D%20values%20%40param%20%7Bnumber%7D%20start%20%40returns%20%7Bnumber%7D%20%2A%2F%0Aexport%20function%20findRustTerminalReturnBoundary%28values%2Cstart%29%7B%0A%20if%28%21Number.isSafeInteger%28start%29%7C%7Cstart%3C0%7C%7Cstart%3E%3Dvalues.length%29return%20-1%3B%0A%20const%20stack%3D%5B%5D%3B%0A%20for%28let%20at%3Dstart%2B1%3Bat%3Cvalues.length%3Bat%2B%3D1%29%7B%0A%20%20const%20value%3Dvalues%5Bat%5D%3F%3F%27%27%3B%0A%20%20if%28value%3D%3D%3D%27%28%27%7C%7Cvalue%3D%3D%3D%27%5B%27%7C%7Cvalue%3D%3D%3D%27%7B%27%29%7Bstack.push%28value%29%3Bcontinue%3B%7D%0A%20%20if%28stack.length%3D%3D%3D0%26%26%28value%3D%3D%3D%27%3B%27%7C%7Cvalue%3D%3D%3D%27%7D%27%29%29%7B%0A%20%20%20let%20end%3Dat%3Bwhile