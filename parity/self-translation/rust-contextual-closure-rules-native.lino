able%20Copy%20source%20values%27%3B%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bstring%7D%20kind%20%40returns%20%7Bboolean%7D%20%2A%2F%0Aexport%20function%20acceptRustCopyClosureInvocation%28kind%29%7Breturn%20kind%3D%3D%3D%27function%27%3B%7D%0A%2F%2A%2A%20Anonymous%20closure%20identity%20never%20follows%20from%20equal%20callable%20signatures.%0A%20%2A%20%40param%20%7Bboolean%7D%20first%20%40param%20%7Bboolean%7D%20second%20%40param%20%7Bboolean%7D%20same%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureJoinError%28first%2Csecond%2Csame%29%7Breturn%20%28first%7C%7Csecond%29%26%26%21same%3F%27distinct%20anonymous%20closure%20types%20require%20an%20actual%20source%20coercion%27%3A%27%27%3B%7D%0A%0A%2F%2A%2A%20Header%20checks%20do%20not%20assert%20that%20an%20unresolved%20result%20type%20is%20known.%0A%20%2A%20%40param%20%7Bboolean%7D%20ordinary%20%40param%20%7Bstring%5B%5D%7D%20names%20%40param%20%7Bboolean%5B%5D%7D%20copies%0A%20%2A%20%40returns%20%7Bstring%7D%20%2A%2F%0Aexport%20function%20readRustCopyClosureParameterHeaderError%28ordinary%2Cnames%2Ccopies%29%7B%0A%20if%28%21ordinary%29return%20%27closure%20ownership%20requires%20its%20separate%20active%20source%20profile%27%3B%0A%20if%28names.length%21%3D%3Dcopies.length%7C%7Cnames.length%3E1024%29return%20%27the%20complete%20typed%20closure%20header%20exceeds%20its%20source%20budget%27%3B%0A%20for%28let%20index%3D0%3Bindex%3Cnames.length%3Bindex%2B%3D1%29%7Bif%28%21readRequiredBooleanFact%28copies%2Cindex%29%29return%20%27closure%20parameters%20require%20direct%20immutable%20Copy%20source%20types%27%3Bfor%28let%20before%3D0%3Bbefore%3Cindex%3Bbefore%2B%3D1%29if%28readRequiredTextFact%28names%2Cbefore%29%3D%3D%3DreadRequiredTextFact%28names%2Cindex%29%29return%20%27closure%20parameters%20require%20distinct%20actual%20bindings%27%3B%7D%0A%20return%20%27%27%3B%0A%7D%0A%2F%2A%2A%20%40param%20%7Bboolean%7D%20requested%20%40param%20%7Bboolean%7D%20written%20%40param%2