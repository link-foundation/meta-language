(13728: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20The%20link-assistant%2Fformal-ai%20workloads%20run%20against%20the%20clean%20installed%0A%2F%2F%20meta-language%20artifacts%20%28requirement%20I195-DOWNSTREAM-FORMAL-AI-WORKLOADS%29.%0A%2F%2F%20js%2Fscripts%2Frun-formal-ai-workloads.mjs%20checks%20out%20the%20pinned%20revision%20of%0A%2F%2F%20parity%2Ffixtures%2Fformal-ai-workloads.json%20and%20verifies%20every%20inventoried%20blob.%0A%2F%2F%20The%20Rust%20side%20patches%20formal-ai%27s%20rust%2F%20to%20the%20unpacked%20crate%20and%20runs%0A%2F%2F%20formal-ai%27s%20own%20meta-language%20test%20groups%20plus%20the%20probe%20of%0A%2F%2F%20js%2Fscripts%2Fissue-195-formal-ai-rust-probe.mjs.%20formal-ai%27s%20npm%20package%20has%20no%0A%2F%2F%20meta-language%20dependency%2C%20so%20the%20JavaScript%20side%20installs%20the%20npm%20tarball%0A%2F%2F%20into%20a%20clean%20consumer%20and%20runs%20formal-ai%27s%20LiNo%20data%20through%20the%20public%20API%0A%2F%2F%20%28js%2Fscripts%2Fissue-195-formal-ai-workload-probes.mjs%29.%20Both%20runtimes%20write%20the%0A%2F%2F%20same%20outputs%2C%20and%20sharedConceptsReused%20holds%20only%20when%20they%20agree.%0A%2F%2F%20%60validateFormalAiWorkloadReport%60%20is%20the%20pure%20check%20of%20the%20runner%27s%20report%20for%0A%2F%2F%20one%20runtime%2C%20shared%20by%20the%20runner%20and%20the%20tests%3B%20the%20Rust%20suite%20ports%20it.%0Aimport%20path%20from%20%27node%3Apath%27%3B%0Aimport%20%7B%20fileURLToPath%20%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7B%20readProjectData%20%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0A%0Aexport%20const%20FORMAL_AI_WORKLOAD_REQUIREMENT%20%3D%20%27I195-DOWNSTREAM-FORMAL-AI-WORKLOADS%27%3B%0Aexport%20const%20FORMAL_AI_WORKLOAD_FIXTURE_ID%20%3D%20%27planned%3Arepository-directive%3Ai195-downstream-formal-ai-workloads%27%3B%0Aexport%20const%20FORMAL_AI_WORKLOAD_FIXTURE%20%3D%20%27parity%2Ffixtures%2Fformal-ai-workloads.json%27%3B%0Aexport%20const%20FORMAL_AI_WORKLOAD_REPORT_VARIABLE%20%3D%20%27ISSUE_195_FORMAL_AI_WORKLOAD_REPORT%27%3B%0Aexport%20const%20FORMAL_AI_WORKLOAD_SCHEMA_VERSION%20%3D%201%3B%0Aexport%20const%20FORMAL_AI_WORKLOAD_ASSERTIONS%20%3D%20Object.freeze%28%5B%0A%20%20%27workloadsRunOnInstalledArtifacts%27%2C%0A%20%20%27sharedConceptsReused%27%2C%0A%20%20%27distinctionsPreserved%27%2C%0A%5D%29%3B%0A%2F%2F%20The%20consumer-probe%20assertions%3B%20%60workloadsRunOnInstalledArtifacts%60%20is%20read%20from%20the%20report%20itself.%0Aexport%20const%20FORMAL_AI_PROBE_ASSERTIONS%20%3D%20Object.freeze%28FORMAL_AI_WORKLOAD_ASSERTIONS.slice%281%29%29%3B%0A%2F%2F%20The%20report%20part%20of%20each%20runtime%2C%20and%20the%20inventoried%20workload%20kind%20and%20directory%20it%20runs%3A%0A%2F%2F%20the%20Rust%20side%20runs%20formal-ai%27s%20test%20files%2C%20the%20JavaScript%20side%20formal-ai%27s%20data%20files.%0Aexport%20const%20FORMAL_AI_WORKLOAD_RUNTIMES%20%3D%20Object.freeze%28%7B%0A%20%20javascript%3A%20Object.freeze%28%7B%20part%3A%20%27npm%27%2C%20kind%3A%20%27data%27%2C%20directory%3A%20%27data%2F%27%20%7D%29%2C%0A%20%20rust%3A%20Object.freeze%28%7B%20part%3A%20%27crate%27%2C%20kind%3A%20%27test%27%2C%20directory%3A%20%27rust%2F%27%20%7D%29%2C%0A%7D%29%3B%0A%0Aconst%20root%20%3D%20path.resolve%28path.dirname%28fileURLToPath%28import.meta.url%29%29%2C%20%27..%27%2C%20%27..%27%29%3B%0A%0A%2F%2A%2A%20The%20pinned%20formal-ai%20fixture.%20%2A%2F%0Aexport%20function%20loadFormalAiWorkloadFixture%28directory%20%3D%20root%29%20%7B%0A%20%20return%20readProjectData%28path.join%28directory%2C%20FORMAL_AI_WORKLOAD_FIXTURE%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20The%20inventoried%20workload%20files%20%60runtime%60%20runs%2C%20as%20formal-ai%20repository%20paths.%20%2A%2F%0Aexport%20function%20workloadFiles%28fixture%2C%20runtime%29%20%7B%0A%20%20const%20%7B%20kind%2C%20directory%20%7D%20%3D%20FORMAL_AI_WORKLOAD_RUNTIMES%5Bruntime%5D%3B%0A%20%20return%20fixture.workloads%0A%20%20%20%20.filter%28%28entry%29%20%3D%3E%20entry.kind%20%3D%3D%3D%20kind%20%26%26%20entry.file.startsWith%28directory%29%29%0A%20%20%20%20.map%28%28%7B%20file%20%7D%29%20%3D%3E%20file%29%3B%0A%7D%0A%0A%2F%2A%2A%20Counts%20of%20test%20outcomes%2C%20as%20the%20runner%20writes%20them.%20%2A%2F%0Aexport%20function%20countOutcomes%28tests%29%20%7B%0A%20%20const%20count%20%3D%20%28outcome%29%20%3D%3E%20tests.filter%28%28entry%29%20%3D%3E%20entry.outcome%20%3D%3D%3D%20outcome%29.length%3B%0A%20%20return%20%7B%20passed%3A%20count%28%27passed%27%29%2C%20failed%3A%20count%28%27failed%27%29%2C%20skipped%3A%20count%28%27skipped%27%29%2C%20total%3A%20tests.length%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%20formal-ai%27s%20committed%20census%20of%20its%20own%20sources%20as%20meta-language%20parses%20them.%20%2A%2F%0Aexport%20const%20SELF_AST_CENSUS_DIRECTORY%20%3D%20%27data%2Fmeta%2Fself-ast%27%3B%0A%2F%2A%2A%20formal-ai%27s%20example%20that%20rewrites%20the%20census%20documents%20whose%20rendering%20changed.%20%2A%2F%0Aexport%20const%20SELF_AST_CENSUS_EXAMPLE%20%3D%20%27regenerate_self_ast_census%27%3B%0A%2F%2F%20The%20census%20line%20that%20counts%20every%20link%20of%20the%20lossless%20network.%20It%20is%20the%0A%2F%2F%20only%20census%20field%20outside%20the%20abstract-syntax%20projection%2C%20the%20symbol%20scan%0A%2F%2F%20and%20the%20source%20itself.%0Aconst%20LINK_TOTAL_LINE%20%3D%20%2F%5E%20%7B4%7Dtotal_link_count%20%28%5Cd%2B%29%24%2Fu%3B%0A%0A%2F%2A%2A%0A%20%2A%20Compares%20formal-ai%27s%20census%20documents%20before%20and%20after%20its%20own%20regeneration%0A%20%2A%20with%20a%20candidate%20meta-language%20%28two%20maps%20of%20relative%20path%20to%20document%20text%29.%0A%20%2A%0A%20%2A%20A%20candidate%20that%20adds%20links%20to%20the%20lossless%20network%2C%20such%20as%20a%20grammar%0A%20%2A%20provenance%20link%20or%20hidden-text%20tokens%2C%20changes%20%60total_link_count%60%20and%20nothing%0A%20%2A%20else.%20%60linkTotals%60%20lists%20those%20changes%3B%20%60otherChanges%60%20lists%20every%20other%0A%20%2A%20changed%20line%20and%20every%20added%20or%20removed%20document%2C%20so%20a%20candidate%20that%0A%20%2A%20changes%20a%20named%20node%2C%20a%20node%20kind%2C%20the%20text%20preservation%20or%20the%20clean%0A%20%2A%20verification%20of%20any%20formal-ai%20source%20is%20reported.%0A%20%2A%2F%0Aexport%20function%20compareSelfAstCensus%28before%2C%20after%29%20%7B%0A%20%20const%20linkTotals%20%3D%20%5B%5D%3B%0A%20%20const%20otherChanges%20%3D%20%5B%5D%3B%0A%20%20for%20%28const%20file%20of%20%5B...new%20Set%28%5B...before.keys%28%29%2C%20...after.keys%28%29%5D%29%5D.sort%28%29%29%20%7B%0A%20%20%20%20if%20%28%21before.has%28file%29%20%7C%7C%20%21after.has%28file%29%29%20%7B%0A%20%20%20%20%20%20otherChanges.push%28%7B%20file%2C%20line%3A%20null%2C%20before%3A%20before.has%28file%29%20%3F%20%27present%27%20%3A%20%27absent%27%2C%20after%3A%20after.has%28file%29%20%3F%20%27present%27%20%3A%20%27absent%27%20%7D%29%3B%0A%20%20%20%20%20%20continue%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20previous%20%3D%20before.get%28file%29.split%28%27%5Cn%27%29%3B%0A%20%20%20%20const%20current%20%3D%20after.get%28file%29.split%28%27%5Cn%27%29%3B%0A%20%20%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20Math.max%28previous.length%2C%20current.length%29%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20%20%20if%20%28previous%5Bindex%5D%20%3D%3D%3D%20current%5Bindex%5D%29%20continue%3B%0A%20%20%20%20%20%20const%20previousTotal%20%3D%20LINK_TOTAL_LINE.exec%28previous%5Bindex%5D%20%3F%3F%20%27%27%29%3B%0A%20%20%20%20%20%20const%20currentTotal%20%3D%20LINK_TOTAL_LINE.exec%28current%5Bindex%5D%20%3F%3F%20%27%27%29%3B%0A%20%20%20%20%20%20if%20%28previousTotal%20%26%26%20currentTotal%29%20%7B%0A%20%20%20%20%20%20%20%20linkTotals.push%28%7B%20file%2C%20before%3A%20Number%28previousTotal%5B1%5D%29%2C%20after%3A%20Number%28currentTotal%5B1%5D%29%20%7D%29%3B%0A%20%20%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20%20%20otherChanges.push%28%7B%20file%2C%20line%3A%20index%20%2B%201%2C%20before%3A%20previous%5Bindex%5D%20%3F%3F%20null%2C%20after%3A%20cur