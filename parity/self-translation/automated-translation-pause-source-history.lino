A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20NODE_AUTH_TOKEN%3A%20%24%7B%7B%20secrets.NPM_TOKEN%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20npm%20publish%20--provenance%0A%20%20%20%20%20%20%20%20working-directory%3A%20js%0A%0A%20%20%20%20%20%20-%20name%3A%20Explain%20npm%20publish%20failure%0A%20%20%20%20%20%20%20%20if%3A%20failure%28%29%20%26%26%20steps.npm.outputs.already_published%20%21%3D%20%27true%27%0A%20%20%20%20%20%20%20%20env%3A%0A%20%20%20%20%20%20%20%20%20%20AUTH_MODE%3A%20%24%7B%7B%20steps.npm_auth.outputs.auth_mode%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20%7C%0A%20%20%20%20%20%20%20%20%20%20echo%20%22%3A%3Aerror%3A%3Anpm%20publish%20failed%20with%20auth%20mode%20%27%24AUTH_MODE%27.%22%0A%20%20%20%20%20%20%20%20%20%20if%20%5B%20%22%24AUTH_MODE%22%20%3D%20%22oidc%22%20%5D%3B%20then%0A%20%20%20%20%20%20%20%20%20%20%20%20echo%20%22An%20E404%20on%20PUT%20or%20an%20ENEEDAUTH%20means%20the%20registry%20treated%20the%20request%20as%22%0A%20%20%20%20%20%20%20%20%20%20%20%20echo%20%22anonymous.%20The%20trusted%20publisher%20of%20meta-language%20on%20npmjs.com%20must%20name%22%0A%20%20%20%20%20%20%20%20%20%20%20%20echo%20%22%24%7B%7B%20github.repository%20%7D%7D%20and%20the%20workflow%20filename%20js.yml%20with%20no%20environment%3B%22%0A%20%20%20%20%20%20%20%20%20%20%20%20echo%20%22see%20docs%2Fci-cd%2Fnpm-trusted-publishing.md.%20An%20NPM_TOKEN%20secret%20bootstraps%20the%20publish.%22%0A%20%20%20%20%20%20%20%20%20%20fi%0A%0A%20%20%20%20%20%20-%20name%3A%20Verify%20published%20package%0A%20%20%20%20%20%20%20%20run%3A%20node%20scripts%2Frelease-publication.mjs%20--published%0A%20%20%20%20%20%20%20%20working-directory%3A%20js%0A%0A%20%20%20%20%20%20-%20name%3A%20Remove%20the%20temporary%20external%20grammar%20inputs%0A%20%20%20%20%20%20%20%20if%3A%20%24%7B%7B%20%21cancelled%28%29%20%7D%7D%0A%20%20%20%20%20%20%20%20working-directory%3A%20%24%7B%7B%20github.workspace%20%7D%7D%0A%20%20%20%20%20%20%20%20run%3A%20node%20js%2Fscripts%2Fexternal-gra