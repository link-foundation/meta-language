children.find%28row%3D%3Erow.field%3D%3D%3D%27function%27%29%3F.node%3B%0A%20%20%20%20if%28%21fn%7C%7Cbytes.subarray%28fn.start%2Cfn.end%29.toString%28%29%21%3D%3D%27test%27%29continue%3B%0A%20%20%20%20const%20args%3Dnode.children.find%28row%3D%3Erow.field%3D%3D%3D%27arguments%27%29%3F.node%3B%0A%20%20%20%20const%20title%3Dargs%3F.children.find%28row%3D%3Erow.node.term%3D%3D%3D%27string%27%29%3F.node%3Bassert.ok%28title%29%3B%0A%20%20%20%20const%20literal%3Dbytes.subarray%28title.start%2Ctitle.end%29.toString%28%29%2Ctokens%3Dtokenize%28literal%2C%27JavaScript%27%29.tokens%3B%0A%20%20%20%20const%20name%3Dtokens%5B0%5D.value%3Bassert.equal%28typeof%20name%2C%27string%27%29%3B%0A%20%20%20%20const%20partition%3Dnode.start%3CBuffer.byteLength%28source.slice%280%2Cgate%29%29%3F%27schema%27%0A%20%20%20%20%20%20%3Aname%3D%3D%3D%27CI%20executes%20the%20selected%20complete%20raw%20emission%20profile%20and%20persists%20only%20real%20observations%27%3F%27native%27%3A%27plan%27%3B%0A%20%20%20%20tests.push%28%7Bname%2Cpartition%2Cstart%3Anode.start%2Cend%3Anode.end%2C%0A%20%20%20%20%20%20sha256%3AcreateHash%28%27sha256%27%29.update%28bytes.subarray%28node.start%2Cnode.end%29%29.digest%28%27hex%27%29%7D%29%3B%0A%20%20%7D%0A%20%20tests.sort%28%28first%2Csecond%29%3D%3Efirst.start-second.start%29%3B%0A%20%20assert.equal%28tests.filter%28row%3D%3Erow.partition%3D%3D%3D%27schema%27%29.length%2C11%29%3B%0A%20%20assert.equal%28tests.filter%28row%3D%3Erow.partition%3D%3D%3D%27plan%27%29.length%2C7%29%3B%0A%20%20assert.equal%28tests.filter%28row%3D%3Erow.partition%3D%3D%3D%27native%27%29.length%2C1%29%3B%0A%20%20assert.equal%28new%20Set%28tests.map%28row%3D%3Erow.name%29%29.size%2C19%29%3B%0A%20%20const%20testsEdits%3D%5B%0A%20%20%20%20%7Bbefore%3A%22import%20test%20from%20%27node%3Atest%27%3B%22%2Cafter%3A%22import%20registerRawContract%20from%20%27node%3Atest%27%3B%5Cnimport%20%7BcreateOriginalLinkRawContractPartition%7D%20from%20%27.%2Fraw-contract-partitions.mjs%27%3B%5Cnconst%20rawContracts%3DcreateOriginalLinkRawContractPartition%28registerRawContract%29%3B%5Cnconst%20test%3D%28...argumentsList%29%3D%3ErawContracts.test%28...argumentsList%29%3B%22%7D%2C%0A%20%20%20%20%7Bbefore%3A%22if%20%28process.env.CI%20%3D%3D%3D%20%27true%27%29%20%7B%22%2Cafter%3A%22if%20%28process.env.CI%20%3D%3D%3D%20%27true%27%20%26%26%20rawContracts.runPlan%29%20%7B%22%7D%2C%0A%20%20%20%20%7Bbefore%3A%27%5Cn%7D%5Cn%27%2Cafter%3A%27%5Cn%7D%5CnrawContracts.finish%28%29%3B%5Cn%27%2Clast%3Atrue%7D%2C%0A%20%20%5D%3B%0A%20%20const%20apply%3D%28text%2Cedits%29%3D%3E%7B%0A%20%20%20%20for%28const%20edit%20of%20edits%29%7B%0A%20%20%20%20%20%20if%28edit.last%29%7Bassert.ok%28text.endsWith%28edit.before%29%29%3Btext%3Dtext.slice%280%2C-edit.before.length%29%2Bedit.after%3B%7D%0A%20%20%20%20%20%20else%20%7Bassert.equal%28text.split%28edit.before%29.length%2C2%29%3Btext%3Dtext.replace%28edit.before%2C%28%29%3D%3Eedit.after%29%3B%7D%0A%20%20%20%20%7Dreturn%20text%3B%0A%20%20%7D%3B%0A%20%20const%20currentTest%3Dapply%28source%2CtestsEdits%29%3B%0A%20%20const%20workflowPath%3D%27.github%2Fworkflows%2Fjs.yml%27%2Cworkflow%3DcaptureGitArtifactCertificate%28revision%2CworkflowPath%29%3B%0A%20%20const%20previousWorkflow%3Dworkflow.blob.toString%28%27utf8%27%29%3B%0A%20%20const%20name%3D%27%20%20%20%20%20%20-%20name%3A%20Run%20complete%20original%20link%20raw%20native%20oracle%20contracts%5Cn%27%3B%0A%20%20const%20start%3DpreviousWorkflow.indexOf%28name%29%2Cend%3DpreviousWorkflow.indexOf%28%27%5Cn%20%20%20%20%20%20-%20name%3A%27%2Cstart%2B1%29%3Bassert.ok%28start%3E0%26%26end%3Estart%29%3B%0A%20%20const%20step%3DpreviousWorkflow.slice%28start%2Cend%29%3B%0A%20%20const%20flag%3D%22%20%20%20%20%20%20%20%20%20%20ORIGINAL_LINK_RAW_SEPARATE_SUITES%3A%20%271%27%22%3Bassert.equal%28step.split%28flag%29.length%2C2%29%3B%0A%20%20const%20plan%3Dstep.replace%28flag%2Cflag%2B%22%5Cn%20%20%20%20%20%20%20%20%20%20ORIGINAL_LINK_RAW_CONTRACT_PARTITION%3A%20%27plan%27%22%29%3B%0A%20%20const%20schema%3Dstep.replace%28name%2C%27%20%20%20%20%20%20-%20name%3A%20Run%20complete%20original%20link%20raw%20schema%20and%20consumer%20contracts%5Cn%27%29%0A%20%20%20%20.replace%28%22matrix.group%20%3D%3D%20%27source-model-raw%27%22%2C%22matrix.group%20%3D%3D%20%27source-model-raw-schema%27%22%29%0A%20%20%20%20.replace%28flag%2Cflag%2B%22%5Cn%20%20%20%20%20%20%20%20%20%20ORIGINAL_LINK_RAW_CONTRACT_PARTITION%3A%20%27schema%27%22%29%3B%0A%20%20const%20cell%3D%27%20%20%20%20%20%20%20%20%20%20-%20group%3A%20source-model-raw%5Cn%20%20%20%20%20%20%20%20%20%20%20%20generated_slice%3A%20first%5Cn%27%3B%0A%20%20const%20workflowEdits%3D%5B%7Bbefore%3Acell%2Cafter%3Acell%2B%27%20%20%20%20%20%20%20%20%20%20-%20group%3A%20source-model-raw-schema%5Cn%20%20%20%20%20%20%20%20%20%20%20%20generated_slice%3A%20first%5Cn%27%7D%2C%0A%20%20%20%20%7Bbefore%3Astep%2Cafter%3Aschema%2B%27%5Cn%27%2Bplan%7D%5D%3B%0A%20%20const%20currentWorkflow%3Dapply%28previousWorkflow%2CworkflowEdits%29%3B%0A%20%20const%20sources%3D%5B%0A%20%20%20%20%7Bpath%3AtestPath%2Csource%2Ccertificate%3Aoriginal.certificate%2Cedits%3AtestsEdits%2CcurrentSource%3AcurrentTest%7D%2C%0A%20%20%20%20%7Bpath%3AworkflowPath%2Csource%3ApreviousWorkflow%2Ccertificate%3Aworkflow.certificate%2Cedits%3AworkflowEdits%2CcurrentSource%3AcurrentWorkflow%7D%2C%0A%20%20%5D.map%28%28%7BcurrentSource%2C...row%7D%29%3D%3E%7B%0A%20%20%20%20const%20file%3Dnew%20URL%28row.path%2Croot%29%2Cactual%3DreadFileSync%28file%2C%27utf8%27%29%3B%0A%20%20%20%20if%28check%29assert.equal%28actual%2CcurrentSource%2Crow.path%29%3B%0A%20%20%20%20else%20%7Bassert.ok%28actual%3D%3D%3Drow.source%7C%7Cactual%3D%3D%3DcurrentSource%2C%27unknown%20current%20source%20%27%2Brow.path%29%3BwriteFileSync%28file%2CcurrentSource%29%3B%7D%0A%20%20%20%20return%7B...row%2Ccurrent%3A%7Bbytes%3ABuffer.byteLength%28currentSource%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28currentSource%29.digest%28%27hex%27%29%7D%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20fixture%3D%7BschemaVersion%3A1%