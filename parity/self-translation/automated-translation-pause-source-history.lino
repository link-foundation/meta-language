%28source%2Cindex%29%3D%3E%28%7Bid%3Aids%5Bindex%5D%2Csource%7D%29%29%2C%0A%20%20%20%20coverage%3Aoriginal.units.map%28%28source%2Cindex%29%3D%3E%28%7BoriginalIndex%3Aindex%2Csource%2CcoveredBy%3Amapping%5Bindex%5D.map%28index%3D%3Eids%5Bindex%5D%29%2C%0A%20%20%20%20%20%20...%28index%3D%3D%3D3%3F%7BauthorizedCorrection%3Adigest%28requestSource%29%7D%3A%7B%7D%29%7D%29%29%2C%0A%20%20%20%20additions%3A%5B%7Bunit%3Aids%5B5%5D%2Cauthority%3Adigest%28versionSource%29%7D%5D%2C%0A%20%20%20%20boundary%3A%27This%20is%20a%20Root-reviewed%20exhaustive%20correspondence%20of%20all%2025%20original%20bullets%20and%20three%20surrounding%20instruction%20paragraphs%20to%20the%20shortened%20shared%20contract%2C%20with%20the%20explicitly%20authorized%20assertion%20correction%20and%20added%20version%20bounds.%20The%20original%20sources%20and%20every%20heading%2Fcontext%20are%20independently%20authenticated.%20Checks%20enforce%20retained%20wording%2C%20source%20coverage%20and%20measured%20concision%3B%20they%20do%20not%20prove%20arbitrary%20English%20equivalence%20or%20a%20globally%20optimal%20word%20count.%20CLAUDE.md%20was%20absent%20at%20the%20preceding%20Git%20revision%3B%20its%20new%20single%20reference%20does%20not%20claim%20a%20reduction%20against%20an%20unavailable%20earlier%20file.%20AGENTS.md%20and%20the%20vision%20remain%20authoritative.%27%7D%3B%0A%20%20const%20file%3Dnew%20URL%28CONTRIBUTOR_INSTRUCTION_COVERAGE_FILE%2Croot%29%3B%0A%20%20if%28check%29checkProjectData%28file%2Cpolicy%29%3Belse%20writeProjectData%28file%2Cpolicy%29%3B%0A%20%20return%20policy%3B%0A%7D%0A%0Aif%28process.argv%5B1%5D%3D%3D%3DfileURLToPath%28import.meta.url%29%29%7B%0A%20%20assert.ok%28process.argv.slice%282%29.every%28value%3D%3Evalue%3D%3D%3D%27--check%27%29%29%3B%0A%20%20generateContributorInstructionCoverage%28%7Bcheck%3Aprocess.argv.includes%28%27--check%27%29%7D%29%3B%0A%20%20console.log%28%27Contributor%20coverage%3A%2028%20complete%20original%20units%20and%2020%20reviewed%20current%20units%20captured%20automatically.%27%29%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
