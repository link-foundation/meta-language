utcome%20%3D%3D%20%27failure%27%20%7D%7D%22%2C%22if%3A%20%24%7B%7B%20%21cancelled%28%29%20%7D%7D%22%29%0A%20%20%20%20.replace%28%27%20%20%20%20%20%20%20%20%20%20overwrite%3A%20true%5Cn%27%2C%27%27%29%3B%0A%20%20const%20first%3Dexpected.replace%28%27%20%20%20%20%20%20%20%20if%3A%27%2C%27%20%20%20%20%20%20%20%20id%3A%20native-partition-upload%5Cn%20%20%20%20%20%20%20%20continue-on-error%3A%20true%5Cn%20%20%20%20%20%20%20%20if%3A%27%29%3B%0A%20%20assert.equal%28source.split%28first%2Bretry%29.length%2C2%29%3B%0A%20%20return%20source.replace%28first%2Bretry%2Cexpected%29%3B%0A%7D%0A%0Atest%28%27native%20partition%20artifact%20recovery%20retries%20the%20identical%20complete%20payload%20and%20fails%20if%20the%20final%20upload%20fails%27%2C%28%29%3D%3E%7B%0A%20%20const%20source%3DreadFileSync%28file%2C%27utf8%27%29%2Cjob%3DparseWorkflow%28source%29.find%28row%3D%3Erow.id%3D%3D%3D%27test%27%29%3Bassert.ok%28job%29%3B%0A%20%20const%20first%3Djob.steps.find%28row%3D%3Erow.name%3D%3D%3D%27Retain%20authenticated%20native%20partition%27%29%3B%0A%20%20const%20retry%3Djob.steps.find%28row%3D%3Erow.name%3D%3D%3D%27Retry%20authenticated%20native%20partition%20upload%27%29%3Bassert.ok%28first%26%26retry%29%3B%0A%20%20assert.match%28first.text%2C%2Fid%3A%20native-partition-upload%5Cn%5Cs%2Bcontinue-on-error%3A%20true%2Fu%29%3B%0A%20%20assert.ok%28retry.text.includes%28%22if%3A%20%24%7B%7B%20%21cancelled%28%29%20%26%26%20steps.native-partition-upload.outcome%20%3D%3D%20%27failure%27%20%7D%7D%22%29%29%3B%0A%20%20assert.doesNotMatch%28retry.text%2C%2Fcontinue-on-error%2Fu%29%3Bassert.match%28retry.text%2C%2Foverwrite%3A%20true%2Fu%29%3B%0A%20%20assert.equal%28job.steps.indexOf%28retry%29%2Cjob.steps.indexOf%28first%29%2B1%29%3B%0A%20%20const%20artifact%3Dstep%3D%3Estep.text.split%28%27%20%20%20%20%20%20%20%20with%3A%5Cn%27%29%5B1%5D.replace%28%27%20%20%20%20%20%20%20%20%20%20overwrite%3A%20true%5Cn%27%2C%27%27%29%3B%0A%20%20assert.equal%28artifact%28first%29%2Cartifact%28retry%29%29%3B%0