p.replace%28name%2C%27%20%20%20%20%20%20-%20name%3A%20Run%20complete%20original%20link%20raw%20schema%20and%20consumer%20contracts%5Cn%27%29%0A%20%20%20%20.replace%28%22matrix.group%20%3D%3D%20%27source-model-raw%27%22%2C%22matrix.group%20%3D%3D%20%27source-model-raw-schema%27%22%29%0A%20%20%20%20.replace%28flag%2Cflag%2B%22%5Cn%20%20%20%20%20%20%20%20%20%20ORIGINAL_LINK_RAW_CONTRACT_PARTITION%3A%20%27schema%27%22%29%3B%0A%20%20const%20cell%3D%27%20%20%20%20%20%20%20%20%20%20-%20group%3A%20source-model-raw%5Cn%20%20%20%20%20%20%20%20%20%20%20%20generated_slice%3A%20first%5Cn%27%3B%0A%20%20const%20workflowEdits%3D%5B%7Bbefore%3Acell%2Cafter%3Acell%2B%27%20%20%20%20%20%20%20%20%20%20-%20group%3A%20source-model-raw-schema%5Cn%20%20%20%20%20%20%20%20%20%20%20%20generated_slice%3A%20first%5Cn%27%7D%2C%0A%20%20%20%20%7Bbefore%3Astep%2Cafter%3Aschema%2B%27%5Cn%27%2Bplan%7D%5D%3B%0A%20%20const%20currentWorkflow%3Dapply%28previousWorkflow%2CworkflowEdits%29%3B%0A%20%20const%20sources%3D%5B%0A%20%20%20%20%7Bpath%3AtestPath%2Csource%2Ccertificate%3Aoriginal.certificate%2Cedits%3AtestsEdits%2CcurrentSource%3AcurrentTest%7D%2C%0A%20%20%20%20%7Bpath%3AworkflowPath%2Csource%3ApreviousWorkflow%2Ccertificate%3Aworkflow.certificate%2Cedits%3AworkflowEdits%2CcurrentSource%3AcurrentWorkflow%7D%2C%0A%20%20%5D.map%28%28%7BcurrentSource%2C...row%7D%29%3D%3E%7B%0A%20%20%20%20const%20file%3Dnew%20URL%28row.path%2Croot%29%2Cactual%3DreadFileSync%28file%2C%27utf8%27%29%3B%0A%20%20%20%20if%28check%29assert.equal%28actual%2CcurrentSource%2Crow.path%29%3B%0A%20%20%20%20else%20%7Bassert.ok%28actual%3D%3D%3Drow.source%7C%7Cactual%3D%3D%3DcurrentSource%2C%27unknown%20current%20source%20%27%2Brow.path%29%3BwriteFileSync%28file%2CcurrentSource%29%3B%7D%0A%20%20%20%20return%7B...row%2Ccurrent%3A%7Bbytes%3ABuffer.byteLength%28currentSource%29%2Csha256%3AcreateHash%28%27sha256%27%29.update%28currentSource%29.digest%28%27hex%27%29%7D%7D%3B%0A%20%20%7D%29%3B%0A%20%20const%20fixture%3D%7BschemaVersion%3A1%