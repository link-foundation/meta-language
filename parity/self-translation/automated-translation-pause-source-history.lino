A%20%20%20%20sourcePin%28row.source%2Cexpected.predecessorBytes%2Cexpected.predecessorSha256%29%3B%0A%20%20%20%20verifyGitArtifactCertificate%28row.certificate%2CBuffer.from%28row.source%29%2C%7Brevision%2Cpath%3Arow.path%7D%29%3B%0A%20%20%20%20assert.equal%28row.currentBytes%2Cexpected.currentBytes%29%3Bassert.equal%28row.currentSha256%2Cexpected.currentSha256%29%3B%0A%20%20%20%20assert.ok%28Array.isArray%28row.edits%29%26%26row.edits.length%3E0%29%3B%0A%20%20%20%20let%20current%3Drow.source%3B%0A%20%20%20%20for%28const%20edit%20of%20row.edits%29%7B%0A%20%20%20%20%20%20assert.ok%28Number.isSafeInteger%28edit.start%29%26%26edit.start%3E%3D0%26%26edit.start%3C%3Dcurrent.length%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20edit.removed%2C%27string%27%29%3Bassert.equal%28typeof%20edit.inserted%2C%27string%27%29%3B%0A%20%20%20%20%20%20assert.notEqual%28edit.removed%2Cedit.inserted%29%3B%0A%20%20%20%20%20%20assert.equal%28current.slice%28edit.start%2Cedit.start%2Bedit.removed.length%29%2Cedit.removed%29%3B%0A%20%20%20%20%20%20current%3Dcurrent.slice%280%2Cedit.start%29%2Bedit.inserted%2Bcurrent.slice%28edit.start%2Bedit.removed.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20sourcePin%28current%2Cexpected.currentBytes%2Cexpected.currentSha256%29%3B%0A%20%20%20%20let%20inverse%3Dcurrent%3B%0A%20%20%20%20for%28const%20edit%20of%20archive.hosts%5Bindex%5D.edits.toReversed%28%29%29%7B%0A%20%20%20%20%20%20assert.equal%28inverse.slice%28edit.start%2Cedit.start%2Bedit.inserted.length%29%2Cedit.inserted%29%3B%0A%20%20%20%20%20%20inverse%3Dinverse.slice%280%2Cedit.start%29%2Bedit.removed%2Binverse.slice%28edit.start%2Bedit.inserted.length%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20assert.equal%28inverse%2Crow.source%2C%27every%20original%20source%20byte%20and%20old%20wrapper%20branch%20remains%20recoverable%27%29%3B%0A%20%20%20%20files.push%28%7Bpath%3Arow.path%2Csource%3Acurrent%2Cpredecessor%3Arow.source%7D%29%3B%0A%20%20%7D%0A%20%20return%20files%3B%0A%7D%0A%0A%2F%2A%2A%20Rebuild%