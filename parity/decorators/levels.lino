(decorator absent-leaf (level recovery) (order 0) (when (type missing)) (set kind absent))
(decorator bare-await (level translation-rule) (order 0) (replace text await%20 %20))
(decorator document-root (level grammar-rule) (order 0) (when (name root)) (set name document))
(decorator glyph-kind (level executor) (order 0) (when (kind letter)) (set kind glyph))
(decorator numeral-term (level cst-to-ast) (order 0) (when (term number)) (set term numeral))
(decorator rename-item (level importer) (order 0) (when (format gbnf) (name item)) (set name letter))
(decorator reviewed-merge (level merge-decision) (order 0) (when (kind merged)) (set basis reviewed))
(decorator settle-pair (level concept-mapping) (order 0) (when (rule pair)) (set rules property))
(decorator spaced-definition (level emitter) (order 0) (replace line %3A%3A%3D %3A%3A%3D%20))
(decorator title-case (level transformation) (order 0) (replace new Name Title))
