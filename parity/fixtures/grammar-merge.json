{
  "description": "Multi-source grammar merge and rename cases both runtimes must decide identically (requirements I195-MERGE-DETERMINISM, I195-MERGE-MEANING-AWARE-DEDUPLICATION, I195-MERGE-BINDING-AWARE-RENAME and I195-MERGE-UNCERTAINTY-PRESERVED). Two upstreams of the 2024 edition spell the same expression grammar under different names, define a homonym `identifier` with different meanings, and offer lookalike rules that only names or samples relate; a 2025 edition must stay separate. The rename case covers mutual and self recursion, qualified references, a capture label that shadows the renamed rule, collisions and a reload.",
  "sources": [
    {
      "id": "upstream-a",
      "language": "arithmetic",
      "edition": "2024",
      "precedence": 0,
      "format": "pest",
      "text": "expression = { term ~ (\"+\" ~ term)* }\nterm = { number | \"(\" ~ expression ~ \")\" }\nnumber = @{ ASCII_DIGIT+ }\nidentifier = @{ ASCII_ALPHA+ }\nstring_literal = @{ \"\\\"\" ~ (!\"\\\"\" ~ ANY)* ~ \"\\\"\" }\nsign = { \"+\" | \"-\" }\n"
    },
    {
      "id": "upstream-b",
      "language": "arithmetic",
      "edition": "2024",
      "precedence": 1,
      "format": "pest",
      "text": "statement = { sum ~ \";\" }\nsum = { operand ~ (\"+\" ~ operand)* }\noperand = { integer | \"(\" ~ sum ~ \")\" }\ninteger = @{ ASCII_DIGIT ~ ASCII_DIGIT* }\nidentifier = @{ ASCII_ALPHA ~ ASCII_ALPHANUMERIC* }\nstringLiteral = @{ \"'\" ~ (!\"'\" ~ ANY)* ~ \"'\" }\noperator = { \"+\" | \"-\" | \"*\" }\n"
    },
    {
      "id": "upstream-c",
      "language": "arithmetic",
      "edition": "2025",
      "precedence": 0,
      "format": "pest",
      "text": "expression = { term ~ ((\"+\" | \"-\") ~ term)* }\nterm = { number | \"(\" ~ expression ~ \")\" }\nnumber = @{ ASCII_DIGIT+ ~ (\"_\" ~ ASCII_DIGIT+)* }\n"
    }
  ],
  "samples": {
