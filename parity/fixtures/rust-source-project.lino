(1647: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %23%21%2Fusr%2Fbin%2Fenv%20node%0A%2F%2F%20The%20%60meta-language%60%20command-line%20tool.%20%60meta-language%20grammar%20...%60%20imports%2C%0A%2F%2F%20validates%2C%20converts%2C%20merges%2C%20renames%2C%20exports%20and%20round-trips%20grammars%3B%20see%0A%2F%2F%20runGrammarCommand%20in%20grammar-interchange.js%2C%20which%20the%20Rust%20binary%20mirrors.%0A%2F%2F%20%60meta-language%20translate%60%20translates%20meta-language%27s%20own%20modules%20between%0A%2F%2F%20JavaScript%2C%20TypeScript%20and%20Rust%3B%20see%20self-translation.js.%0Aimport%20%7B%20readFileSync%20%7D%20from%20%27node%3Afs%27%3B%0Aimport%20process%20from%20%27node%3Aprocess%27%3B%0Aimport%20%7B%20fileURLToPath%20%7D%20from%20%27node%3Aurl%27%3B%0A%0Aimport%20%7B%20runGrammarCommand%20%7D%20from%20%27.%2Fgrammar-interchange.js%27%3B%0Aimport%20%7B%20SelfTranslationError%2C%20selfTranslate%2C%20selfTranslationLanguage%20%7D%20from%20%27.%2Fself-translation.js%27%3B%0Aimport%20%7B%20runMetaLanguageArchiveCommand%20%7D%20from%20%27.%2Fmeta-language-archive-cli.js%27%3B%0Aimport%20%7B%20runDynamicLanguageCommand%20%7D%20from%20%27.%2Fdynamic-language-cli.js%27%3B%0Aimport%20%7BrunSourceDefinitionCommand%7D%20from%20%27.%2Fsource-definition-cli.js%27%3B%0A%0Aconst%20USAGE%20%3D%20%27usage%3A%20meta-language%20grammar%20%3Ccommand%3E%20%5Boptions%5D%3B%20run%20meta-language%20grammar%20help%5Cn%27%0A%20%20%2B%20%27%20%20%20%20%20%20%20meta-language%20archive%20%3Ccommand%3E%20%5Boptions%5D%3B%20run%20meta-language%20archive%20help%5Cn%27%0A%20%20%2B%20%27%20%20%20%20%20%20%20meta-language%20language%20%3Ccommand%3E%20%5Boptions%5D%3B%20run%20meta-language%20language%20help%5Cn%27%0A%20%20%2B%20%27%20%20%20%20%20%20%20meta-language%20definition%20%3Ccommand%3E%20%5Boptions%5D%3B%20run%20meta-language%20definition%20help%5Cn%27%0A%20%20%2B%20%27%20%20%20%20%20%20%20meta-language%20translate%20--to%20%3Clanguage%3E%20%5B--from%20%3Clanguage%3E%5D%20%5B--items%5D%20%3Cfile%3E%5Cn%27%3B%0Aconst%20TRANSLATE_USAGE%20%3D%20%27usage%3A%20meta-language%20translate%20--to%20%3Clanguage%3E%20%5B--from%20%3Clanguage%3E%5D%20%5B--items%5D%20%5B--semantic%5D%20%3Cfile%3E%5Cn%27%0A%20%20%2B%20%27Translates%20a%20module%20between%20JavaScript%2C%20TypeScript%20and%20Rust%3B%20--from%20defaults%20to%20the%20file%5C%27s%20extension%5Cn%27%0A%20%20%2B%20%27and%20--items%20prints%20each%20top-level%20item%5C%27s%20status%20instead%20of%20the%20translation.%5Cn%27%3B%0A%0A%2F%2A%2A%20Runs%20%60meta-language%20translate%60%20over%20%60args%60.%20%2A%2F%0Afunction%20runTranslateCommand%28args%2C%20%7B%20readFile%20%7D%29%20%7B%0A%20%20const%20options%20%3D%20%7B%20from%3A%20null%2C%20to%3A%20null%2C%20items%3A%20false%2C%20semantic%3A%20false%2C%20file%3A%20null%20%7D%3B%0A%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20args.length%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20const%20arg%20%3D%20args%5Bindex%5D%3B%0A%20%20%20%20if%20%28arg%20%3D%3D%3D%20%27--help%27%20%7C%7C%20arg%20%3D%3D%3D%20%27-h%27%29%20return%20%7B%20exitCode%3A%200%2C%20stdout%3A%20TRANSLATE_USAGE%2C%20stderr%3A%20%27%27%20%7D%3B%0A%20%20%20%20if%20%28arg%20%3D%3D%3D%20%27--items%27%29%20options.items%20%3D%20true%3B%0A%20%20%20%20else%20if%20%28arg%20%3D%3D%3D%20%27--semantic%27%29%20options.semantic%20%3D%20true%3B%0A%20%20%20%20else%20if%20%28%28arg%20%3D%3D%3D%20%27--from%27%20%7C%7C%20arg%20%3D%3D%3D%20%27--to%27%29%20%26%26%20index%20%2B%201%20%3C%20args.length%29%20options%5Barg.slice%282%29%5D%20%3D%20args%5B%2B%2Bindex%5D%3B%0A%20%20%20%20else%20if%20%28%21arg.startsWith%28%27--%27%29%20%26%26%20options.file%20%3D%3D%3D%20null%29%20options.file%20%3D%20arg%3B%0A%20%20%20%20else%20return%20%7B%20exitCode%3A%202%2C%20stdout%3A%20%27%27%2C%20stderr%3A%20%60error%3A%20unexpected%20argument%20%24%7Barg%7D%5Cn%24%7BTRANSLATE_USAGE%7D%60%20%7D%3B%0A%20%20%7D%0A%20%20if%20%28options.file%20%3D%3D%3D%20null%20%7C%7C%20options.to%20%3D%3D%3D%20null%29%20return%20%7B%20exitCode%3A%202%2C%20stdout%3A%20%27%27%2C%20stderr%3A%20TRANSLATE_USAGE%20%7D%3B%0A%20%20const%20from%20%3D%20options.from%20%3F%3F%20selfTranslationLanguage%28options.file.split%28%27.%27%29.pop%28%29%29%3B%0A%20%20if%20%28from%20%3D%3D%3D%20null%29%20return%20%7B%20exitCode%3A%202%2C%20stdout%3A%20%27%27%2C%20stderr%3A%20%60error%3A%20pass%20--from%3B%20the%20extension%20of%20%24%7Boptions.file%7D%20names%20no%20language%5Cn%60%20%7D%3B%0A%20%20try%20%7B%0A%20%20%20%20const%20result%20%3D%20selfTranslate%28readFile%28options.file%29%2C%20from%2C%20options.to%2C%20%7B%20semanticTranslation%3A%20options.semantic%20%7D%29%3B%0A%20%20%20%20const%20stdout%20%3D%20options.items%0A%20%20%20%20%20%20%3F%20result.items.map%28%28%7B%20term%2C%20start%2C%20end%2C%20status%2C%20reason%20%7D%29%20%3D%3E%20%60%24%7Bstart%7D..%24%7Bend%7D%20%24%7Bterm%7D%20%24%7Bstatus%7D%24%7Breason%20%3F%20%60%20%28%24%7Breason%7D%29%60%20%3A%20%27%27%7D%5Cn%60%29.join%28%27%27%29%0A%20%20%20%20%20%20%3A%20result.code%3B%0A%20%20%20%20return%20%7B%20exitCode%3A%200%2C%20stdout%2C%20stderr%3A%20%27%27%20%7D%3B%0A%20%20%7D%20catch%20%28error%29%20%7B%0A%20%20%20%20if%20%28%21%28error%20instanceof%20SelfTranslationError%29%29%20throw%20error%3B%0A%20%20%20%20return%20%7B%20exitCode%3A%201%2C%20stdout%3A%20%27%27%2C%20stderr%3A%20%60error%3A%20%24%7Berror.message%7D%5Cn%60%20%7D%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20Runs%20the%20tool%20over%20%60args%60%20and%20returns%20%60%7B%20exitCode%2C%20stdout%2C%20stderr%20%7D%60.%20%2A%2F%0Aexport%20function%20runCommandLine%28args%2C%20%7B%20readFile%20%3D%20%28file%29%20%3D%3E%20readFileSync%28file%2C%20%27utf8%27%29%2C%20readBytes%20%3D%20%28file%29%20%3D%3E%20readFileSync%28file%29%20%7D%20%3D%20%7B%7D%29%20%7B%0A%20%20const%20%5Bgroup%2C%20...rest%5D%20%3D%20args%3B%0A%20%20if%20%28group%20%3D%3D%3D%20%27grammar%27%29%20return%20runGrammarCommand%28rest%2C%20%7B%20readFile%20%7D%29%3B%0A%20%20if%20%28group%20%3D%3D%3D%20