(GRAMMAR_DIAGNOSTIC_KINDS (input) (expected duplicate-rule undefined-non-terminal left-recursion unreachable-rule nullable-repetition unused-capture))
(displayGrammarExpression (input 'greeting = "hi" , name ; name = "a" | "b" ;' greeting) (expected '"hi" name'))
(displayGrammarExpression (input 'greeting = "hi" , name ; name = "a" | "b" ;' name) (expected '"a" | "b"'))
(sequence (input 'greeting = "hi" , name ; name = "a" | "b" ;') (expected '"hi" name "a" | "b"'))
(choice (input 'greeting = "hi" , name ; name = "a" | "b" ;' true) (expected '"hi" name / "a" | "b"'))
(choice (input 'greeting = "hi" , name ; name = "a" | "b" ;' false) (expected '"hi" name | "a" | "b"'))
(canonicalRepeat (input 'greeting = "hi" , name ; name = "a" | "b" ;' name 2 4) (expected '("a" | "b"){2,4}'))
(canonicalRepeat (input 'greeting = "hi" , name ; name = "a" | "b" ;' name 0 1) (expected '("a" | "b")?'))
(canonicalRepeat (input 'greeting = "hi" , name ; name = "a" | "b" ;' name 1 none) (expected '("a" | "b")+'))
(canonicalRepeat (input 'greeting = "hi" , name ; name = "a" | "b" ;' name 3 2) (expected 'error: invalid repetition bounds 3..2'))
(canonicalRuleDefinition (input 'greeting = "hi" , name ; name = "a" | "b" ;' greeting) (expected 'normal:seq(lit("hi"),ref("name"))'))
(canonicalRuleDefinition (input 'greeting = "hi" , name ; name = "a" | "b" ;' name) (expected 'normal:alt(lit("a"),lit("b"))'))
(acceptsText (input 'greeting = "hi" , name ; name = "a" | "b" ;' hia) (expected true))
(acceptsText (input 'greeting = "hi" , name ; name = "a" | "b" ;' hic) (expected false))
(parseWithGrammar (input 'greeting = "hi" , name ; name = "a" | "b" ;' hib) (expected '(greeting "hi" (name "b"))'))
(parseWithGrammar (input 'greeting = "hi" , name ; name = "a" | "b" ;' hic) (expected error))
(compileGrammar (input 'greeting = "hi" , name ; name = "a" | "b" ;' hia) (expected '(greeting "hi" (name "a"))'))
(createGrammarParser (input 'greeting = "hi" , name ; name = "a" | "b" ;' hia) (expected '(greeting "hi" (name "a"))'))
(renderSyntaxTree (input 'greeting = "hi" , name ; name = "a" | "b" ;' hia) (expected '(greeting "hi" (name "a"))'))
(validateGrammar (input 'a = "x" ; c = "y" ;') (expected unreachable-rule))
(validateGrammar (input 'greeting = "hi" , name ; name = "a" | "b" ;') (expected))
(carryRuleDocs (input 'greeting = "hi" , name ; name = "a" | "b" ;' name 'one letter') (expected 'one letter'))
