on%20nor%20published.%0A%20%20%20%20%20%20assert.ok%28%21include.includes%28grammar.vendored.replace%28%2F%5Erust%5C%2F%2Fu%2C%20%27%27%29%29%2C%20grammar.vendored%29%3B%0A%20%20%20%20%20%20assert.ok%28%21build.includes%28%60%22%24%7Bgrammar.id%7D%22%60%29%2C%20grammar.id%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27npm%20lockfile%20carries%20no%20native%20or%20network-downloaded%20grammar%20packages%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20const%20packageLock%20%3D%20await%20readJson%28new%20URL%28%27..%2Fpackage-lock.json%27%2C%20import.meta.url%29%29%3B%0A%0A%20%20for%20%28const%20packagePath%20of%20Object.keys%28packageLock.packages%29%29%20%7B%0A%20%20%20%20assert.equal%28packagePath.includes%28%27tree-sitter-language-pack%27%29%2C%20false%2C%20packagePath%29%3B%0A%20%20%20%20assert.notEqual%28packagePath%2C%20%27node_modules%2Ftree-sitter%27%2C%20packagePath%29%3B%0A%20%20%7D%0A%7D%29%3B%0A%0Atest%28%27Rust%20delivery%20closes%20each%20decompressed%20vendored%20parser%20before%20compiling%20it%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20const%20buildScript%20%3D%20await%20readFile%28new%20URL%28%27..%2F..%2Frust%2Foracles%2Fnative-source-oracles%2Fbuild.rs%27%2C%20import.meta.url%29%2C%20%27utf8%27%29%3B%0A%0A%20%20assert.match%28buildScript%2C%20%2Ffn%20decompress_parser%5C%28%5B%5E%5D%2A%3F%5Cn%7D%2F%29%3B%0A%20%20assert.match%28%0A%20%20%20%20buildScript%2C%0A%20%20%20%20%2Fdecompress_parser%5C%28%26compressed%2C%20%26parser%5C%29%3B%5Cs%2Blet%20mut%20compiler%20%3D%20cc%3A%3ABuild%3A%3Anew%5C%28%5C%29%2F%2C%0A%20%20%29%3B%0A%7D%29%3B%0A%0Atest%28%27JavaScript%20workflow%20publishes%20to%20npm%20with%20trusted%20publishing%20provenance%27%2C%20async%20%28%29%20%3D%3E%20%7B%0A%20%20const%20workflow%20%3D%20await%20readFile%28%0A%20%20%20%20new%20URL%28%27..%2F..%2F.github%2Fworkflows%2Fjs.yml%27%2C%20import.meta.url%29%2C%0A%20%20%20%20%27utf8%27%2C%0A%20%20%29%3B%0A%0A%20%20assert.match%28workflow%2C%20%2Frelease%3A%5Cs%2A%5Cn%5Cs%2