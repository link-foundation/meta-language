tput%20%40returns%20%7Bstring%7D%0A%20%2A%2F%0Aexport%20function%20readGrammarTreeEqualityFields%28kind%2C%20output%29%20%7B%0A%20%20if%20%28output%20%26%26%20kind%20%3D%3D%3D%20%27missing%27%29%20return%20%27type%7Ckind%7CprojectionName%7CprojectionAnonymous%7Cstart%7Cend%7Ctrivia%7Cfield%7Clanguage%7Cattributes%7Clexical%7Cliteral%27%3B%0A%20%20if%20%28output%29%20return%20%27type%7Ckind%7CprojectionName%7CprojectionAnonymous%7Cstart%7Cend%7Ctrivia%7Cfield%7Clanguage%7Cattributes%7Clexical%27%3B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27node%27%29%20return%20%27type%7Ckind%7CprojectionName%7CprojectionAnonymous%27%3B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27embed%27%29%20return%20%27type%7Ckind%7CprojectionName%7CprojectionAnonymous%7Cstart%7Cend%7Clanguage%27%3B%0A%20%20return%20%27type%7Ckind%7CprojectionName%7CprojectionAnonymous%7Cstart%7Cend%27%3B%0A%7D%0A%0A%2F%2A%2A%20Embedding%20always%20compares%20the%20complete%20nested%20CST%20and%20every%20witness%2C%0A%20%2A%20even%20inside%20a%20structural%20comparison%20that%20ignores%20enclosing%20node%20trivia.%0A%20%2A%20%40param%20%7Bstring%7D%20kind%20%40param%20%7Bboolean%7D%20output%20%40returns%20%7Bstring%7D%0A%20%2A%2F%0Aexport%20function%20readGrammarTreeRecursionPlan%28kind%2C%20output%29%20%7B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27embed%27%29%20return%20%27full-embedding%27%3B%0A%20%20if%20%28kind%20%3D%3D%3D%20%27node%27%29%20return%20output%20%3F%20%27full-children%27%20%3A%20%27meaningful-children%27%3B%0A%20%20return%20%27leaf%27%3B%0A%7D%0A%0A%2F%2A%2A%20Roots%20use%20the%20recursive%20tree%20plan%3B%20program%20pointers%20are%20private%20transport%2C%0A%20%2A%20and%20never%20stand%20in%20for%20concrete%20tree%20or%20source-provenance%20equality.%0A%20%2A%20%40param%20%7Bboolean%7D%20alternative%20%40returns%20%7Bstring%7D%0A%20%2A%2F%0Aexport%20function%20readGrammarSelectionEqualityFields%28alternative%29%20%7B%0A%20%20return%20alternative%20%3F%20%27language%7Cprovenance%27%20%3A%20%27mode%7Cmapping%7C