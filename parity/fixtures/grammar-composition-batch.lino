(4544: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20The%20grammar%20and%20syntax%20tree%20levels%20of%20%5B%60DecoratorSet%60%5D.%0A%0Ause%20super%3A%3Afeature_runtime%3A%3A%7BLeafText%2C%20SyntaxTree%7D%3B%0Ause%20super%3A%3Amerge%3A%3Arename_grammar_rule%3B%0Ause%20super%3A%3A%7BGrammar%2C%20GrammarFormat%2C%20RuleKind%7D%3B%0Ause%20crate%3A%3Adecorators%3A%3A%7B%0A%20%20%20%20DecoratorAction%2C%20DecoratorError%2C%20DecoratorLevel%2C%20DecoratorRecord%2C%20DecoratorSet%2C%0A%20%20%20%20decorator_record%2C%20record_field%2C%0A%7D%3B%0A%0Amod%20composition%3B%0A%0A%2F%2F%2F%20The%20grammar%20the%20%60importer%60%20or%20%60grammar-rule%60%20decorators%20of%20%60decorators%60%0A%2F%2F%2F%20make%20of%20%60grammar%60.%0A%2F%2F%2F%0A%2F%2F%2F%20Each%20rule%20is%20shown%20as%20%60%7B%20name%2C%20kind%2C%20concept%2C%20composition%20%7D%60%2C%20with%0A%2F%2F%2F%20%60format%60%20%28the%20grammar%27s%20source%20format%29%20added%20at%20the%20%60importer%60%20level.%0A%2F%2F%2F%20Setting%20%60name%60%20renames%20the%20rule%20and%20every%20reference%20to%20it%2C%20setting%20%60kind%60%0A%2F%2F%2F%20or%20%60concept%60%20changes%20the%20rule%2C%20and%20%60drop%60%20removes%20it.%20A%20nonempty%20composition%0A%2F%2F%2F%20is%20one%20closed%20any%2Fall%20Links%20template%20with%20an%20empty%20insertion%20slot%20for%20the%0A%2F%2F%2F%20original%20expression.%20The%20rules%20are%0A%2F%2F%2F%20decorated%20in%20grammar%20order%3B%20a%20grammar%20without%20decorators%20of%20the%20level%20is%0A%2F%2F%2F%20returned%20unchanged.%0A%2F%2F%2F%0A%2F%2F%2F%20%23%20Errors%0A%2F%2F%2F%0A%2F%2F%2F%20A%20%5B%60DecoratorError%60%5D%20for%20an%20unknown%20rule%20kind%20or%20a%20rename%20the%20grammar%0A%2F%2F%2F%20refuses.%0Apub%20fn%20decorate_grammar%28%0A%20%20%20%20grammar%3A%20%26Grammar%2C%0A%20%20%20%20decorators%3A%20%26DecoratorSet%2C%0A%20%20%20%20level%3A%20DecoratorLevel%2C%0A%29%20-%3E%20Result%3CGrammar%2C%20DecoratorError%3E%20%7B%0A%20%20%20%20if%20%21decora