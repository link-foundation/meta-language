d%2C%20readOptionalLogicalOperation%2C%20readOptionalComparisonOperation%2C%20readOptionalBooleanOperation%2C%20readOptionalCoercionOperation%2C%20readOptionalFieldOperation%2C%20readOptionalNumberOperation%2C%20requireOptionalCoalescing%2C%20requireOptionalFlattening%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20readRecordValueOrder%2C%20readRecordProjectionError%2C%20readRecordFieldPosition%2C%20readRecordFieldOrder%2C%20readRecordMethodError%20%7D%20from%20%27.%2Frecord-value-rules.js%27%3B%0Aimport%20%7B%20readPrimitiveCopySliceForm%2C%20readPrimitiveMethodMinimumArguments%2C%20readPrimitiveMethodMaximumArguments%2C%0A%20%20readPrimitiveMethodArgumentCount%2C%20readPrimitiveMethodCheckedArgumentKind%2C%20readPrimitiveMethodDefaultForm%2C%0A%20%20readPrimitiveMethodDefaultValue%2C%20readPrimitiveMethodCheckedResultForm%2C%20readPrimitiveMethodArgumentObligation%2C%0A%20%20readPrimitiveMethodLoweringForm%2C%20readPrimitiveMethodArgumentObligationFeature%20%7D%20from%20%27.%2Fprimitive-method-rules.js%27%3B%0Aimport%20%7B%20acceptProgramTupleProductModel%2C%20acceptProgramExpressionOperation%20%7D%20from%20%27..%2Ftyped-program-link-rules.js%27%3B%0Aimport%20%7BreadStringOrderOperation%7D%20from%20%27.%2Fstring-order-rules.js%27%3B%0Aimport%20%7BreadNumberPredicateArgumentForm%7D%20from%20%27.%2Fnumber-predicate-rules.js%27%3B%0Aimport%20%7B%0A%20%20BOOL%2C%20FLOAT%2C%20INT%2C%20NAT%2C%20STRING%2C%20UNIT%2C%20array%2C%20data%2C%20fixedBounds%2C%20immutableProductType%2C%20isFloat%2C%20isNatural%2C%20isNumeric%2C%20sameType%2C%20tuple%2C%20typeKey%2C%0A%7D%20from%20%27.%2Ftypes.js%27%3B%0A%0Aconst%20COMPARISONS%20%3D%20new%20Set%28%5B%27eq%27%2C%20%27ne%27%2C%20%27lt%27%2C%20%27le%27%2C%20%27gt%27%2C%20%27ge%27%5D%29%3B%0Aconst%20ARITHMETIC%20%3D%20new%20Set%28%5B%27add%27%2C%20%27sub%27%2C%20%27mul%27%2C%20%27div%27%2C%20%27rem%27%5D%29%3B%0A%2F%2F%20The%20styles%20of%20the%20values%20console.log%20shows%3A%20its%20argument%2C%20or%20those%20util.format%20reads.%0Aconst%20CONSOLE_STYLES%20%3D%20new%20Set%28%5B%27js-console%27%2C%20%27js-format-first%27%2C%20%27js-format-number%27%2C%20%27js-format-integer%27%5D%29%3B%0A%2F%2F%20Environment%20entry%20recording%2C%20for%20a%20local%2C%20the%20constructor%20it%20is%20known%20to%0A%2F%2F%20have%20matched%20and%20the%20locals%20naming%20its%20fields.%0Aconst%20KNOWN%20%3D%20Symbol%28%27known%20constructors%27%29%3B%0Aconst%20PRODUCT_VALUES%20%3D%20Symbol%28%27known%20immutable%20product%20values%27%29%3B%0A%2F%2A%2A%20Natural%20numeral%20patterns%20above%20this%20unfold%20to%20equality%20tests%20rather%20than%20successor%20chains.%20%2A%2F%0Aconst%20NAT_PATTERN_UNFOLD%20%3D%2016n%3B%0A%0A%2F%2F%20Conservative%20structural%20bottom%20classification.%20Unknown%20forms%20use%20the%0A%2F%2F%20existing%20checker%20order%3B%20this%20predicate%20never%20invents%20an%20operand%20type.%0Afunction%20needsBranchResultContext%28node%2C%20depth%20%3D%200%29%20%7B%0A%20%20if%20%28%21node%20%7C%7C%20depth%20%3E%20256%29%20return%20false%3B%0A%20%20if%20%28node.k%20%3D%3D%3D%20%27abort%27%29%20return%20true%3B%0A%20%20if%20%28node.k%20%3D%3D%3D%20%27let%27%20%7C%7C%20node.k%20%3D%3D%3D%20%27print%27%20%7C%7C%20node.k%20%3D%3D%3D%20%27cellWrite%27%29%20return%20needsBranchResultContext%28node.body%2C%20depth%20%2B%201%29%3B%0A%20%20if%20%28node.k%20%3D%3D%3D%20%27if%27%29%20return%20needsBranchResultContext%28node.then%2C%20depth%20%2B%201%29%20%26%26%20needsBranchResultContext%28node.else%2C%20depth%20%2B%201%29%3B%0A%20%20return%20false%3B%0A%7D%0A%0A%2F%2F%20The%20Math%20and%20Number%20functions%20whose%20value%20is%20a%20boolean.%0Aconst%20PREDICATES%20%3D%20new%20Set%28%5B%27isInteger%27%2C%20%27isSafeInteger%27%2C%20%27isFinite%27%2C%20%27isNaN%27%5D%29%3B%0A%0A%2F%2A%2A%20Binds%20a%20local%2C%20forgetting%20constructor%20facts%20the%20new%20binding%20shadows.%20%2A%2F%0Aexport%20function%20bindLocal%28env%2C%20name%2C%20type%2C%20immutableProduct%20%3D%20false%29%20%7