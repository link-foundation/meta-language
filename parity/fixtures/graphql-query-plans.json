      "source": "query ActiveUsers {\n  users(\n    where: {and: [{status: {eq: ACTIVE}}, {or: [{age: {gte: 18}}, {age: {isNull: true}}]}]}\n    orderBy: [{field: NAME, direction: ASC}]\n    first: 10\n    skip: 5\n    groupBy: [STATUS]\n  ) {\n    id\n    name\n    total: count(field: ID)\n  }\n}\n",
      "canonicalPlan": {
        "version": 1,
        "operation": "select",
        "resource": "user",
        "projection": ["user.id", "user.name"],
        "filter": {
          "and": [
            {"compare": {"field": "user.status", "operator": "eq", "value": "ACTIVE"}},
            {"or": [
              {"compare": {"field": "user.age", "operator": "gte", "value": 18}},
              {"compare": {"field": "user.age", "operator": "is-null", "value": true}}
            ]}
          ]
        },
        "order": [{"field": "user.name", "direction": "asc"}],
        "limit": 10,
        "offset": 5,
        "groupBy": ["user.status"],
        "aggregates": [{"function": "count", "field": "user.id", "alias": "total"}],
        "mutation": {}
      },
      "equivalentSql": "SELECT id, name, COUNT(id) AS total FROM users WHERE status = 'ACTIVE' AND (age >= 18 OR age IS NULL) GROUP BY status ORDER BY name ASC LIMIT 10 OFFSET 5"
