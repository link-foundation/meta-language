ort%20%7BcheckRustPrimitiveOwnerProof%7D%20from%20%27.%2Ftranslation%2Frust-primitive-owners.js%27%3B%0Aimport%20%7BcheckRustOwnedLocalStateProof%2CcheckRustOwnedLocalStateRecordShapes%7D%20from%20%27.%2Ftranslation%2Frust-owned-local-state.js%27%3B%0Aimport%20%7BacceptProgramStringRepresentationFlag%7D%20from%20%27.%2Ftranslation%2Fprogram-string-representation-rules.js%27%3B%0A%2F%2F%20Validate%20the%20source-free%20checked%20IR%20boundary%20before%20any%20target%20emission.%0Aimport%20%7B%20fixedBounds%2C%20sameType%20%7D%20from%20%27.%2Ftranslation%2Ftypes.js%27%3B%0Aimport%20%7BreadReferenceIdentityComparisonError%7D%20from%20%27.%2Ftranslation%2Freference-identity-rules.js%27%3B%0Aimport%20%7B%20readCallableOwnedParameters%20%7D%20from%20%27.%2Ftranslation%2Fcallable-source.js%27%3B%0Aimport%20%7B%20checkLinkedMatchCoverage%20%7D%20from%20%27.%2Ftranslation%2Fcheck.js%27%3B%0Aimport%20%7B%20acceptLinkedTextConversionKind%2C%20readNumberDisplayRefusal%2C%20readTuplePosition%20%7D%20from%20%27.%2Ftranslation%2Fprimitive-value-rules.js%27%3B%0Aimport%20%7B%20readLinkedPatternBindingScope%20%7D%20from%20%27.%2Ftyped-program-pattern-bindings.js%27%3B%0Aimport%20%7B%20acceptUnionTypeCount%2C%20acceptUnionTypeField%20%7D%20from%20%27.%2Ftranslation%2Ftype-syntax-rules.js%27%3B%0Aimport%20%7BcheckProgramDeclarationOwners%7D%20from%20%27.%2Ftyped-program-declaration-owners.js%27%3B%0Aimport%20%7B%20acceptProgramDivisionRounding%2C%20acceptProgramExpressionField%2C%20acceptProgramExpressionOperation%2C%20acceptProgramOptionalAbsence%2C%20acceptProgramTupleProductModel%2C%20readProgramReferenceRole%20%7D%20from%20%27.%2Ftyped-program-link-rules.js%27%3B%0A%0Aconst%20primitives%20%3D%20new%20Set%28%5B%27nat%27%2C%20%27int%27%2C%20%27bool%27%2C%20%27string%27%2C%20%27unit%27%2C%20%27float%27%2C%20%27output%27%5D%29%3B%0Aconst%20operationKinds%20%3D%20new%20Set%28%5B%27math%27%2C%20%27stringMap%27%2C%20%27stringTest%27%2C%20%27method%27%2C%20%27collectionRead%27%2C%20%27collectionItems%27%2C%20%27optionalPredicate%27%5D%29%3B%0A%0Aexport%20function%20validateLinkedTypedProgram%28program%2C%20references%20%3D%20new%20WeakMap%28%29%2C%20%7B%20graphPatterns%20%3D%20false%2C%20patternScopes%20%3D%20new%20WeakMap%28%29%20%7D%20%3D%20%7B%7D%29%20%7B%0A%20%20checkRustDataTypeFieldSignatureProgramContainers%28program%29%3B%0A%20%20checkRustConstFunctionContainers%28program%29%3B%0A%20%20checkRustRuntimeShell%28program%29%3B%0A%20%20checkRustTypeNamespaceRecordShapes%28program%29%3B%0A%20%20%2F%2F%20The%20independently%20selected%20Unit%20profile%20owns%20plain%20data%20throughout%20its%0A%20%20%2F%2F%20graph.%20Check%20descriptors%20before%20reading%20even%20the%20initial%20role%20fields.%0A%20%20if%20%28program%20%26%26%20typeof%20program%20%3D%3D%3D%20%27object%27%20%26%26%20Object.hasOwn%28program%2C%20%27sourcePureUnitCalls%27%29%29%20checkRustPureUnitCalls%28program%29%3B%0A%20%20checkRustOwnedLocalStateRecordShapes%28program%29%3B%0A%20%20validateSourceSpans%28program%29%3B%0A%20%20if%20%28%21program%20%7C%7C%20program.schemaVersion%20%21%3D%3D%201%20%7C%7C%20%21%5B%27JavaScript%27%2C%20%27Rust%27%2C%20%27Lean%27%2C%20%27Rocq%27%5D.includes%28program.sourceLanguage%29%0A%20%20%20%20%7C%7C%20%21%28program.declarations%20instanceof%20Map%29%20%7C%7C%20%21Array.isArray%28program.items%29%29%20throw%20new%20TypeError%28%27the%20linked%20value%20is%20not%20a%20checked%20typed%20program%27%29%3B%0A%20%20if%20%28program.main%20%21%3D%20null%20%26%26%20%28typeof%20program.main%20%21%3D%3D%20%27object%27%20%7C%7C%20Array.isArray%28program.main%29%0A%20%20%20%20%7C%7C%20program.main.k%20%21%3D%3D%20undefined%20%7C%7C%20program.main.p%20%21%3D%3D%20undefined%20%7C%7C%20%21Array.isArray%28program.main.effects%29%29%29%20throw%20new%20TypeError%28%27a%20linked%20main%20has%20an%20invalid%20effect-container%20role%27%29%3B%0A%20%20if%20%28%21acceptProgramStringRepresentationFlag%28typeof%20program.utf16Strings%2C%20Object.hasOwn%28program%2C%20%27utf16Strings%27%29%29%29%20throw%20new%20TypeError%28%27a%20program%20string%20representation%20flag%20must%20be%20an%20explicit%20boolean%27%29%3B%0A%20%20const%20active%20%3D%20new%20Set%28%29%3B%0A%20%20const%20visited%20%3D%20new%20Set%28%29%3B%0A%20%20function%20targetOf%28node%2C%20role%29%20%7B%0A%20%20%20%20for%20%28const%20%5Blabel%2C%20target%5D%20of%20references.get%28node%29%20%3F%3F%20%5B%5D%29%20if%20%28readProgramReferenceRole%28label%29%20%3D%3D%3D%20role%29%20return%20target%3B%0A%20%20%20%20return%20undefined%3B%0A%20%20%7D%0A%20%20function%20bounded%28value%2C%20depth%20%3D%200%29%20%7B%0A%20%20%20%20if%20%28%21value%20%7C%7C%20typeof%20value%20%21%3D%3D%20%27object%27%29%20%7B%0A%20%20%20%20%20%20if%20%28typeof%20value%20%3D%3D%3D%20%27function%27%20%7C%7C%20typeof%20value%20%3D%3D%3D%20%27symbol%27%29%20throw%20new%20TypeError%28%27typed%20programs%20contain%20data%2C%20not%20host%20callbacks%27%29%3B%0A%20%20%20%20%20%20return%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28active.has%28value%29%29%20throw%20new%20TypeError%28%27the%20checked%20program%20contains%20a%20structural%20cycle%27%29%3B%0A%20%20%20%20if%20%28visited.has%28value%29%29%20return%3B%0A%20%20%20%20if%20%28depth%20%3E%20256%20%7C%7C%20visited.size%20%3E%3D%20100_000%29%20throw%20new%20TypeError%28%27the%20checked%20program%20exceeds%20its%20structural%20resource%20limit%27%29%3B%0A%20%20%20%20visited.add%28value%29%3B%20active.add%28value%29%3B%0A%20%20%20%20const%20values%20%3D%20value%20instanceof%20Map%20%3F%20%5B...value%5D.flat%28%29%20%3A%20Object.values%28value%29%3B%0A%20%20%20%20for%20%28const%20child%20of%20values%29%20bounded%28child%2C%20depth%20%2B%201%29%3B%0A%20%20%20%20active.delete%28value%29%3B%0A%20%20%7D%0A%20%20checkRustPureUnitCalls%28program%29%3B%0A%20%20bounded%28program%29%3B%0A%20%20checkRustUnitCloneDerivations%28program%29%3B%0A%20%20checkRustPrimitiveOwnerProof%28program%29%3B%0A%20%20checkRustConstFunctionProof%28program%29%3B%0A%20%20checkRustEmptyOptionProof%28program%29%3B%0A%20%20checkRustOwnedLocalStateProof%28program%29%3B%0A%20%20%2F%2F%20Shared%20records%20can%20describe%20exponentially%20many%20expression%20paths.%20Bound%0A%20%20%2F%2F%20the%20semantic%20walk%20as%20well%20as%20the%20number%20of%20unique%20structural%20records.%0A%20%20let%20semanticVisits%20%3D%200%3B%0A%20%20function%20visit%28%29%20%7B%0A%20%20%20%20if%20%28%2B%2BsemanticVisits%20%3E%20100_000%29%20throw%20new%20TypeError%28%27the%20linked%20program%20exceeds%20its%20semantic%20resource%20limit%27%29%3B%0A%20%20%7D%0A%20%20function%20type%28value%29%20%7B%0A%20%20%20%20visit%28%29%3B%0A%20%20%20%20if%20%28%21value%20%7C%7C%20typeof%20value%20%21%3D%3D%20%27object%27%20%7C%7C%20typeof%20value.kind%20%21%3D%3D%20%27string%27%29%20throw%20new%20TypeError%28%27the%20linked%20program%20contains%20a%20malformed%20type%27%29%3B%0A%20%20%20%20if%20%28primitives.has%28value.kind%29%29%20return%3B%0A%20%20%20%20if%20%28value.kind%20%3D%3D%3D%20%27fixed%27%29%20%7B%0A%20%20%20%20%20%20if%20%28%21acceptProgramIntegralMetadata%28value.kind%2C%20%27bits%27%2C%20value.bits%2C%20Object.is%28value.bits%2C%20-0%29%29%20%7C%7C%20typeof%20value.signed%20%21%3D%3D%20%27boolean%27%29%20throw%20new%20TypeError%28%27the%20linked%20program%20contains%20an%20invalid%20machine%20integer%20type%27%29%3B%0A%20%20%20%20%7D%20else%20if%20%28value.kind%20%3D%3D%3D%20%27data%27%29%20%7B%0A%20%20%20%20%20%20if%20%28typeof%20value.name%20%21%3D%3D%20%27string%27%20%7C%7C%20%21value.name%29%20throw%20new%20TypeError%28%27a%20linked%20data%20type%20has%20no%20name%27%29%3B%0A%20%20%20%20%20%20const%20declaration%20%3D%20declarations.get%28value.name%29%3B%0A%20%20%20%20%20%20if%20%28declaration%3F.k%20%21%3D%3D%20%27data%27%29%20throw%20new%20TypeError%28%27a%20linked%20data%20type%20does%20not%20target%20a%20datatype%20declaration%27%29%3B%0A%20%20%20%20%20%20const%20target%20%3D%20targetOf%28value%2C%20%27datatype%27%29%3B%0A%20%20%20%20%20%20if%20%28target%20%26%26%