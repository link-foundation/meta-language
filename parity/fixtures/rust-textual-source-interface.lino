(607: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BacceptLinkedStringArrayCopySort%7D%20from%20%27.%2Ftranslation%2Fstring-array-sort-rules.js%27%3B%0Aimport%20%7B%20acceptOptionalLiteralAbsence%20%7D%20from%20%27.%2Ftranslation%2Foptional-value-rules.js%27%3B%0Aimport%20%7BacceptLinkedNumberBitwiseOperation%2CreadJavaScriptNumberBitwiseArity%7D%20from%20%27.%2Ftranslation%2Fnumber-bitwise-rules.js%27%3B%0Aimport%20%7B%20acceptLinkedReferenceMethodOperation%20%7D%20from%20%27.%2Ftranslation%2Freference-method-rules.js%27%3B%0Aimport%20%7B%20acceptLinkedRecordFieldWrite%20%7D%20from%20%27.%2Ftranslation%2Frecord-write-rules.js%27%3B%0Aimport%20%7BreadJavaScriptRecordOrderKernelArity%2CreadJavaScriptRecordOrderKernelParameter%2CreadJavaScriptRecordOrderKernelResult%2CacceptLinkedOrderedRecordOrderRead%2CreadJavaScriptObjectEntryPairingOperation%7D%20from%20%27.%2Ftranslation%2Fjavascript-enumeration-rules.js%27%3B%0Aimport%20%7BreadRecordOrderRoleType%7D%20from%20%27.%2Ftranslation%2Frecord-order-operations.js%27%3B%0Aimport%20%7B%20acceptLinkedBigIntegerBitwiseOperation%2C%20readBigIntegerBitwiseArity%20%7D%20from%20%27.%2Ftranslation%2Fbig-integer-bitwise-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptNumberConversion%7D%20from%20%27.%2Ftranslation%2Fstring-number-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptSourceException%7D%20from%20%27.%2Ftranslation%2Fsource-exception-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptBigIntegerResult%2CreadJavaScriptBigIntegerIntrinsicOperandKinds%2CreadJavaScriptBigIntegerIntrinsicResultKind%7D%20from%20%27.%2Ftranslation%2Fbig-integer-conversion-rules.js%27%3B%0Aimport%20%7BacceptJavaScriptNumberConversionType%7D%20from%20%27.%2Ftranslation%2Fjavascript-number-conversion.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptStringUnitConstruction%2CacceptJavaScriptStringUnits%7D%20from%20%27.%2Ftranslation%2Fjavascript-string-unit-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptStringConstruction%