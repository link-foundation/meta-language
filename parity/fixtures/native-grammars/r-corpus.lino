(253: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %0A%23%20Invalid%20at%20top%20level%20due%20to%20newline%20before%20%60else%60%2C%20so%20not%20a%20real%20if%20statement%0Aif%20%28TRUE%29%20%7B%0A%20%201%0A%7D%0Aelse%20%7B%0A%20%202%0A%7D%0A%0A%23%20Invalid%20for%20same%20reason%20as%20above%0Aif%20%28TRUE%29%0A%20%201%0Aelse%0A%20%202%0A%0A%23%20Valid%20inside%20%60%7B%60%20only%20due%20to%20special%20%60else%60%20handling%20with%20newlines%0A%7B%0A%20%20if%20%28TRUE%29%20%7B%0A%20%20%20%201%0A%20%20%7D%0A%20%20else%20%7B%0A%20%20%20%202%0A%20%20%7D%0A%7D%0A%0A%23%20Valid%20with%20comments%20in%20special%20newline%20territory%0A%7B%0A%20%20if%20%28TRUE%29%20%7B%0A%20%20%20%201%0A%20%20%7D%0A%20%20%23%20hi%20there%0A%0A%20%20%23%20another%20one%21%0A%0A%20%20else%20%7B%0A%20%20%20%202%0A%20%20%7D%0A%7D%0A%0A%23%20Valid.%20This%20test%20ensures%20we%20handle%20the%20newline%20after%20%601%20%2B%201%60%20correctly%20%28%23125%29.%0A%7B%0A%20%20if%20%28TRUE%29%0A%0A%20%20%20%201%20%2B%201%0A%7D%0A%0A%23%20Valid.%20Newlines%20are%20allowed%20between%20the%20%60else%60%20and%20the%20%60alternative%60%2C%20even%20at%20top%20level%20%28%23141%29.%0Aif%20%28TRUE%29%20%7B%0A%20%201%0A%7D%20else%0A%7B%0A%20%202%0A%7D%0A%0A%23%20Valid.%20Same%20as%20above%20but%20in%20%60%7B%20%7D%60%20so%20it%20is%20valid%20no%20matter%20where%20the%20newlines%20are.%0A%7B%0A%20%20if%20%28TRUE%29%20%7B%0A%20%20%20%201%0A%20%20%7D%20else%0A%20%20%7B%0A%20%20%20%202%0A%20%20%7D%0A%7D%0A%0A%23%20Valid.%20Newlines%20and%20comments%20are%20allowed%20between%20the%20%60else%60%20and%20the%20%60alternative%60%2C%20even%20at%20top%20level.%0Aif%20%28TRUE%29%20%7B%0A%20%201%0A%7D%20else%0A%0A%23%20do%20this%20alternative%0A%7B%0A%20%202%0A%7D%0A%0A%23%20Valid.%20Newlines%20are%20allowed%20between%20the%20%60else%60%20and%20the%20%60alternative%60%2C%20even%20at%20top%20level.%0Aif%20%28TRUE%29%201%20else%0A%20%202%0A) (lang: meta-language%20structured%20data)))
