{
  "schemaVersion": 1,
  "language": "Elixir",
  "grammar": "parity/grammars/native/elixir.lino",
  "source": "tree-sitter-elixir",
  "hidden": [
    "unary_operator_boundary",
    "unary_operator_padding"
  ],
  "anonymous": [
    "unnamed_token",
    "whitespace"
  ],
  "extras": [
    "comment"
  ],
  "matches": [
    "",
    "x = 1",
    "x = 1 + 2",
    "x = \"leaf\"",
    "x = \"leaf #{seed}\"",
    "x = \"#{seed}\"",
    "x = \"leaf\\nseed\"",
    "x = 'leaf #{seed}'",
    "x = ~r/leaf/",
    "x = ~r/leaf #{seed}/i",
    "x = ~S\"leaf #{seed}\"",
    "x = ~s(leaf #{seed})",
    "x = ~s{leaf #{seed}}",
    "x = ~s[leaf #{seed}]",
    "x = ~s<leaf #{seed}>",
    "x = ~s|leaf #{seed}|",
    "x = \"\"\"\nleaf\n\"\"\"",
    "x = \"\"\"\nleaf #{seed}\n  \"\"\"",
    "x = \"leaf #{\"seed #{root}\"}\"",
    "x = :leaf",
    "x = :\"leaf #{seed}\"",
    "x = [leaf: 1, seed: 2]",
    "x = %{leaf: 1}",
    "x = {1, 2}",
    "x = fn seed -> seed end",
    "x = 1\n|> f()",
    "x = 1\n# leaf\n|> f()",
    "f seed do\n  seed\nend",
    "f seed\ndo\n  seed\nend",
    "x = seed not in leaves",
    "f +seed",
    "f -seed",
    "defmodule Grove do\n  def identity(seed), do: seed\nend",
    "#{ordinary comment}\nx = 1\n",
    "x = \"café 🌱 #{leaf}\"",
    "f + seed",
    "f - seed",
    "x = \"\"\"\nleaf \"\"\" stem\n\"\"\"",
    "x = ~S\"leaf \\\"seed\"",
    "x = 1\n== 2",
    "x = 1\n# stem\n+ 2",
    "x+y",
    "foo -1",
    "1 + Mod.inner_fun 1",
    "Mod.outer_fun mid_fun inner_fun.(a)",
    "fn() -> 1 end",
    "fn (x) when x > 0 -> x end",
    "&1+2",
    "&Mod.fun/1",
    "outer_fun inner_fun arg do\n a\nend",
    "fun x\n# comment\ndo\n x\nend",
    "a\nnot in\n[b]",
    "a\n^^^\nb",
    "foo do end..bar do end//baz do end",
    "fn a ->x\n\n b ->y end",
    "@spec fun(Keyword.t()) :: String.t()",
    "a.and",
    "a.andé",
    "@-mod.foo",
    "@foo[1]",
    "def fun x do x end",
    "<<foo::binary-size(4)>>",
    "a.and\n",
    "a.or\n",
    "a.foo\n",
    "a.+\n",
    "a.and?\n",
    "a.andé\n",
    "a.\"quoted\"\n",
    "a.'quoted'\n",
    "fun x\n# comment\ndo\n x\nend\n",
    "fun x\n# one\n\n# two\n  do\n x\nend\n"
  ],
  "rejections": [
    "x = \"leaf",
    "x = \"leaf #{seed\"",
    "x = ~r/leaf",
    "x = \"\"\"\nleaf\n",
    "x = fn seed ->",
    "x = %{",
    "x = 1 |>",
    "x = (",
    "a.\n",
    "a.and(",
    "@spec fun(value) ::",
    "outer inner value do\n value"
  ]
}
