  "decisions": [
    {
      "family": "context-rule-variants",
      "rules": [
        "parameter_list",
        "parameter",
        "_parameter_type_with_modifiers",
        "type"
      ],
      "insertInto": [
        "_lambda_parameters"
      ],
      "prefix": "_lambda_context_",
      "opaqueRules": [
        "parameter_list"
      ],
      "reason": "Isolate lambda parameter type preferences from method and delegate declarations, retaining original parameter alternatives in the cloned list."
    },
    {
      "family": "symbol-dynamic-precedence",
      "rules": [
        "_lambda_context_type"
      ],
      "symbol": "ref_type",
      "value": 1,
      "reason": "Preserve the pinned plain-reference lambda type tree while the existing two modifier preferences still select ref readonly aliases."
    },
    {
      "family": "rule-prefix-exclusion",
      "rule": "_lambda_context_parameter",
      "pattern": "scoped",
      "continuationPattern": "[A-Za-z0-9_]",
      "reason": "Retain the original scoped-modifier parameter alternative; a longer scoped-prefixed identifier remains eligible for the lambda type preference."
    },
    {
      "family": "rule-prefix-exclusion",
      "rule": "_lambda_context_parameter",
      "pattern": "\\[",
      "reason": "Retain the original attributed lambda parameter production and its modifier aliases, including trivia inside attribute arguments."
    },
    {
      "family": "symbol-complete-context",
      "rules": [
        "_lambda_context_parameter_list"
      ],
      "symbol": "parameter",
      "preferredSymbol": "_lambda_context_parameter",
      "alias": "parameter",
      "boundaries": [
        ",",
        ")"
      ],
      "count": 2,
      "reason": "Select a complete lambda parameter at its comma or closing parenthesis, preserving the original alternative for each parameter independently."
    }
  ],
