(307: (meta: (t: semantic) (n: 1) (term: string%20value) (def: import%20%7BreadJavaScriptOptionalChainOperation%2CreadJavaScriptOptionalChainInferenceForm%7D%20from%20%27.%2Fjavascript-optional-chain-rules.js%27%3B%0Aimport%20%7BreadJavaScriptEnumerationForm%2CacceptJavaScriptEnumerationValueDomain%7D%20from%20%27.%2Fjavascript-enumeration-rules.js%27%3B%0Aimport%20%7BreadJavaScriptNullishFieldForm%7D%20from%20%27.%2Fjavascript-nullish-field-rules.js%27%3B%0Aimport%20%7BreadJavaScriptLiteralPropertyIndex%2CreadJavaScriptLiteralPropertyForm%7D%20from%20%27.%2Fjavascript-literal-property-rules.js%27%3B%0Aimport%20%7BreadJavaScriptOptionalCallOperation%7D%20from%20%27.%2Fjavascript-optional-call-rules.js%27%3B%0Aimport%20%7BreadJavaScriptStringUnitCallResultForm%7D%20from%20%27.%2Fjavascript-property-call-rules.js%27%3B%0A%2F%2F%20Types%20of%20JavaScript%20functions%20written%20without%20JSDoc.%20A%20parameter%20or%20result%0A%2F%2F%20without%20a%20declared%20type%20gets%20a%20type%20variable%3B%20the%20bodies%2C%20the%20calls%20and%20the%0A%2F%2F%20top-level%20statements%20constrain%20the%20variables%20by%20unification%2C%20and%20each%0A%2F%2F%20variable%20takes%20the%20one%20type%20every%20use%20agrees%20on.%20A%20BigInt%20literal%20is%20a%0A%2F%2F%20%60bigint%60%20of%20any%20integer%20type%2C%20%60%2B%60%20of%20a%20string%20is%20concatenation%2C%20and%20a%20type%0A%2F%2F%20nothing%20constrains%20is%20a%20Number.%20Two%20uses%20that%20need%20different%20types%20are%20a%0A%2F%2F%20type%20error%3A%20the%20function%20would%20need%20a%20declared%20type%20for%20each%20use.%0A%0Aimport%20%7B%20typeError%2Cunsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptSourceException%2CreadJavaScriptExceptionConstructorClass%7D%20from%20%27.%2Fsource-exception-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptBigIntegerResult%2CreadJavaScriptBigIntegerIntrinsicOperandKinds%2CreadJavaScriptBigIntegerIntrinsicResultKind%7D%20from%20%27.%2Fbig-inte