values%5Bif%20true%7B1%7Delse%7B0%7D%5D%27%29%3B%0Aadd%28%27all%20nested%20conditional%20alternatives%20have%20usize%20context%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Bvalues%5Bif%20false%7B0%7Delse%7Bif%20true%7B1%7Delse%7B0%7D%7D%5D%27%29%3B%0Aadd%28%27a%20match%20retains%20its%20actual%20scalar%20result%20alternatives%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Bvalues%5Bmatch%20true%7Btrue%3D%3E1%2Cfalse%3D%3E0%7D%5D%27%29%3B%0Aadd%28%27a%20diverging%20alternative%20does%20not%20supply%20an%20invalid%20index%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Bvalues%5Bif%20true%7B1%7Delse%7Bpanic%21%28%22unselected%22%29%7D%5D%27%29%3B%0Aadd%28%27a%20direct%20source%20alias%20retains%20its%20actual%20usize%20owner%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Blet%20index%3AIndex%3D1%3Bvalues%5Bindex%5D%27%2C%27type%20Index%3Dusize%3B%27%29%3B%0Aadd%28%27nested%20transparent%20aliases%20retain%20the%20original%20primitive%20meaning%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Blet%20index%3APosition%3D1%3Bvalues%5Bindex%5D%27%2C%27type%20Index%3Dusize%3Btype%20Position%3DIndex%3B%27%29%3B%0Aadd%28%27later%20aliases%20retain%20a%20declared%20parameter%20owner%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Bread%28%26values%2C1%29%27%2C%27fn%20read%28values%3A%26%5Bi64%5D%2Cindex%3AIndex%29-%3Ei64%7Bvalues%5Bindex%5D%7Dtype%20Index%3Dusize%3B%27%29%3B%0Aadd%28%27a%20module%20alias%20retains%20its%20original%20source%20namespace%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Blet%20index%3Aindices%3A%3APosition%3D1%3Bvalues%5Bindex%5D%27%2C%27mod%20indices%7Bpub%20type%20Position%3Dusize%3B%7D%27%29%3B%0Aadd%28%27an%20imported%20alias%20retains%20its%20fully%20checked%20target%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Blet%20index%3APosition%3D1%3Bvalues%5Bindex%5D%27%2C%27mod%20indices%7Bpub%20type%20Position%3Dusize%3B%7Duse%20self%3A%3Aindices%3A%3APosition%3B%27%29%3B%0Aadd%28%27an%20actual%20cast%20to%20an%20alias%20retains%20its%20checked%20target%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Bvalues%5B1u32%20as%20Index%5D%27%2C%27type%20Index%3Dusize%3B%27%29%3B%0Aadd%28%27a%20declared%20alias%20result%20retains%20the%20actual%20source%20owner%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Bvalues%5Bposition%28%29%5D%27%2C%27type%20Index%3Dusize%3Bfn%20position%28%29-%3EIndex%7B1%7D%27%29%3B%0Aadd%28%27arithmetic%20keeps%20a%20source%20alias%20atom%20and%20its%20literal%20context%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Blet%20index%3AIndex%3D0%3Bvalues%5Bindex%2B1%5D%27%2C%27type%20Index%3Dusize%3B%27%29%3B%0Aconst%20oldInput%3D%27fn%20bad%28values%3A%26%5Bi64%5D%29-%3Ei64%7Bvalues%5B0%2B0%5D%7Dfn%20main%28%29%7B%7D%27%3B%0Aadd%28%27the%20exact%20original%20arithmetic%20refusal%20retains%20its%20complete%20source%27%2C%27bad%28%26vec%21%5B7i64%5D%29%27%2ColdInput%29%3B%0Aconst%20reason%3D%27Rust%20scalar%20array%20index%3A%20the%20index%20needs%20an%20unsuffixed%20integer%20literal%20or%20a%20proven%20direct%20usize%20source%20owner%27%2Crefusals%3D%5B%5D%3B%0Afor%28const%20%5Bname%2Cindex%2Cprefix%5Dof%20%5B%5B%27equal-width%20unsigned%20arithmetic%20is%20not%20usize%27%2C%270u64%2B0u64%27%2C%27%27%5D%2C%5B%27an%20alias%20of%20u64%20retains%20a%20distinct%20owner%27%2C%27index%27%2C%27type%20Index%3Du64%3B%27%5D%2C%5B%27mixed%20arithmetic%20retains%20the%20actual%20unsigned%20owner%27%2C%270usize%2B0u64%27%2C%27%27%5D%2C%5B%27floating%20arithmetic%20cannot%20gain%20integer%20context%27%2C%270.0%2B0.0%27%2C%27%27%5D%2C%5B%27one%20conditional%20result%20has%20the%20wrong%20primitive%20owner%27%2C%27if%20true%7B0%7Delse%7B0u64%7D%27%2C%27%27%5D%2C%5B%27one%20match%20result%20has%20the%20wrong%20primitive%20owner%27%2C%27match%20true%7Btrue%3D%3E0%2Cfalse%3D%3E0u64%7D%27%2C%27%27%5D%5D%29refusals.push%28%7Bname%2Csource%3Aprefix%2B%27fn%20bad%28values%3A%26%5Bi64%5D%27%2B%28prefix%3F%27%2Cindex%3AIndex%27%3A%27%27%29%2B%27%29-%3Ei64%7Bvalues%5B%27%2Bindex%2B%27%5D%7Dfn%20main%28%29%7B%7D%2