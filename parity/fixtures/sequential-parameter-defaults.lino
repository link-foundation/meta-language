e%28program.items%2C%20requiresJavaScriptProductProof%28program%29%29%3B%0A%20%20inference.run%28functions%2C%20program.main%2C%20program.externals%20%3F%3F%20%5B%5D%29%3B%0A%20%20if%20%28inference.recordExpressionTypes%29%20Object.defineProperty%28program%2C%20%27inferredExpressionTypes%27%2C%20%7B%20value%3A%20inference.expressionTypes%20%7D%29%3B%0A%20%20return%20markSharedReferenceTypes%28program%29%3B%0A%7D%0A%0Afunction%20collectFunctions%28items%2C%20path%2C%20into%29%20%7B%0A%20%20for%20%28const%20item%20of%20items%29%20%7B%0A%20%20%20%20if%20%28item.k%20%3D%3D%3D%20%27fn%27%29%20into.push%28%7B%20path%3A%20%5B...path%2C%20item.name%5D%2C%20fn%3A%20item%20%7D%29%3B%0A%20%20%20%20else%20if%20%28item.k%20%3D%3D%3D%20%27module%27%29%20collectFunctions%28item.items%2C%20%5B...path%2C%20item.name%5D%2C%20into%29%3B%0A%20%20%7D%0A%7D%0A%0Afunction%20hasStructuralInference%28node%29%20%7B%0A%20%20if%20%28%21node%20%7C%7C%20typeof%20node%20%21%3D%3D%20%27object%27%29%20return%20false%3B%0A%20%20if%20%28Array.isArray%28node%29%29%20return%20node.some%28hasStructuralInference%29%3B%0A%20%20if%20%28node.k%20%3D%3D%3D%20%27arrayBindingRest%27%20%7C%7C%20node.k%20%3D%3D%3D%20%27arrayBindingDefault%27%29%20return%20true%3B%0A%20%20if%28node.k%3D%3D%3D%27math%27%26%26%28node.op%3D%3D%3DreadJavaScriptOptionalChainOperation%28%29%7C%7Cnode.op%3D%3D%3DreadJavaScriptOptionalCallOperation%28%29%29%29return%20true%3B%0A%20%20if%20%28requireCallableStructuralInference%28node.k%20%3F%3F%20%27%27%2C%20node.kind%20%3F%3F%20%27%27%2C%20node.op%20%3F%3F%20%27%27%29%29%20return%20true%3B%0A%20%20return%20Object.entries%28node%29.some%28%28%5Bkey%2C%20value%5D%29%20%3D%3E%20key%20%21%3D%3D%20%27span%27%20%26%26%20hasStructuralInference%28value%29%29%3B%0A%7D%0A%0Aclass%20Inference%20%7B%0A%20%20constructor%28items%2C%20recordExpressionTypes%20%3D%20false%29%20%7B%0A%20%20%20%20%2F%2F%20Constructors%20of%20every%20data%20type%2C%20by%20tag.%0A%20%20%20%20this.data%20%3D%20new%20Map%28%29