21%5B3i64%2C7i64%5D%3Bvalues%5B1usize%5D%27%29%3B%0Aadd%28%27a%20typed%20usize%20local%20is%20actual%20index-owner%20evidence%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Blet%20index%3Ausize%3D1%3Bvalues%5Bindex%5D%27%29%3B%0Aadd%28%27a%20usize%20parameter%20is%20distinct%20from%20an%20equal-width%20u64%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Bread%28%26values%2C1%29%27%2C%277%27%2C%27i64%27%2C%27fn%20read%28values%3A%26%5Bi64%5D%2Cindex%3Ausize%29-%3Ei64%7Bvalues%5Bindex%5D%7D%27%29%3B%0Aadd%28%27an%20actual%20usize%20cast%20retains%20its%20target%20source%20owner%27%2C%27let%20values%3Dvec%21%5B7i64%5D%3Bvalues%5B0u32%20as%20usize%5D%27%29%3B%0Aadd%28%27an%20untyped%20literal%20is%20checked%20directly%20in%20the%20usize%20domain%27%2C%27let%20values%3Dvec%21%5B7i64%5D%3Bvalues%5B0%20as%20usize%5D%27%29%3B%0Aadd%28%27an%20immutable%20vector%20reference%20retains%20its%20element%20facts%27%2C%27let%20values%3Dvec%21%5B7i64%5D%3Bread%28%26values%29%27%2C%277%27%2C%27i64%27%2C%27fn%20read%28values%3A%26Vec%3Ci64%3E%29-%3Ei64%7Bvalues%5B0%5D%7D%27%29%3B%0Aadd%28%27an%20immutable%20slice%20retains%20its%20actual%20standard%20owner%27%2C%27let%20values%3Dvec%21%5B7i64%5D%3Bread%28%26values%29%27%2C%277%27%2C%27i64%27%2C%27fn%20read%28values%3A%26%5Bi64%5D%29-%3Ei64%7Bvalues%5B0%5D%7D%27%29%3B%0Aadd%28%27nested%20immutable%20vector%20references%20are%20read%20by%20automatic%20dereference%27%2C%27let%20values%3Dvec%21%5B7i64%5D%3Bread%28%26%26values%29%27%2C%277%27%2C%27i64%27%2C%27fn%20read%28values%3A%26%26Vec%3Ci64%3E%29-%3Ei64%7Bvalues%5B0%5D%7D%27%29%3B%0Aadd%28%27a%20standard%20Box%20vector%20is%20read%20without%20moving%20the%20vector%27%2C%27let%20values%3DBox%3A%3Anew%28vec%21%5B7i64%5D%29%3Bvalues%5B0%5D%27%29%3B%0Aadd%28%27a%20boxed%20slice%20reference%20keeps%20its%20immutable%20layers%27%2C%27let%20values%3Dvec%21%5B7i64%5D%3Bread%28Box%3A%3Anew%28%26values%29%29%27%2C%277%27%2C%27i64%27%2C%27fn%20read%28values%3ABox%3C%26Vec%3Ci64%3E%3E%29-%3Ei64%7Bvalues%5B0%5D%7D%27%29%3B%0Aadd%28%27a%20scalar%20element%20copy%20leaves%20the%20actual%20vector%20available%27%2C%27let%20values%3Dvec%21%5B3i64%2C4i64%5D%3Blet%20first%3Dvalues%5B0%5D%3Bfirst%2Bvalues%5B1%5D%27%29%3B%0Aadd%28%27an%20index%20read%20copies%20a%20borrowed%20scalar%20into%20an%20ordinary%20fresh%20result%27%2C%27let%20input%3Dvec%21%5B7i64%5D%3Blet%20output%3Dcopy%28%26input%29%3Boutput%5B0%5D%27%2C%277%27%2C%27i64%27%2C%27fn%20copy%28values%3A%26%5Bi64%5D%29-%3EVec%3Ci64%3E%7Bvec%21%5Bvalues%5B0%5D%5D%7D%27%29%3B%0Aadd%28%27a%20temporary%20returned%20vector%20retains%20its%20checked%20result%20owner%27%2C%27values%28%29%5B0%5D%27%2C%277%27%2C%27i64%27%2C%27fn%20values%28%29-%3EVec%3Ci64%3E%7Bvec%21%5B7%5D%7D%27%29%3B%0Aadd%28%27a%20source%20function%20supplies%20its%20actual%20usize%20result%27%2C%27let%20values%3Dvec%21%5B3i64%2C7i64%5D%3Bvalues%5Bposition%28%29%5D%27%2C%277%27%2C%27i64%27%2C%27fn%20position%28%29-%3Eusize%7B1%7D%27%29%3B%0Aadd%28%27an%20index%20source%20is%20evaluated%20once%20before%20the%20checked%20read%27%2C%27let%20values%3Dvec%21%5B7i64%5D%3Bvalues%5Bposition%28%29%5D%27%2C%277%27%2C%27i64%27%2C%27fn%20position%28%29-%3Eusize%7B0%7D%27%29%3B%0Aconst%20receiverReason%3D%27Rust%20scalar%20array%20index%3A%20the%20receiver%20needs%20a%20proven%20standard%20vector%20or%20slice%20of%20direct%20scalar%20Copy%20elements%27%3B%0Aconst%20operandReason%3D%27Rust%20scalar%20array%20index%3A%20the%20index%20needs%20an%20unsuffixed%20integer%20literal%20or%20a%20proven%20direct%20usize%20source%20owner%27%3B%0Aconst%20refusals%3D%5B%5D%3B%0Afor%28const%20%5Bname%2Cindex%5Dof%20%5B%5B%27u64%20is%20not%20a%20usize%20owner%27%2C%270u64%27%5D%2C%5B%27u32%20is%20not%20a%20usize%20owner%27%2C%270u32%27%5D%2C%5B%27signed%20indices%20retain%20their%20source%20refusal%27%2C%270i64%27%5D%2C%5B%27binary64%20indices%20retain%20their%20source%20refusal%27%2C%270f64%27%5D%2C%5B%27Boolean%20indices%20retain%20their%20source%20refusal%27%2C%27false%27%5D%2C%5B%27a%20borrowed%20index%20requires%20explicit%20dereference%27%2C%27%260usize%27%5D%2C%5B%27unproved%20arithmetic%20needs%20its%20source%20width%27%2C%270%2B0%27%5D%5D%29refusals.push%28%7Bname%2Csource%3A%27fn%20bad%28values%3A%26%5Bi64%5D%29-%3Ei64%7Bvalues%5B%27%2Bindex%2B%27%5D%7Dfn%20main%28%29%7B%7D%27%2Ckind%3A%27unsupported%27%2Creason%3AoperandReason%7D%29%3B%0Arefusals.push%28%7Bname%3A%27a%20String%20element%20cannot%20be%20moved%20out%20of%20an%20indexed%20slice%27%2Csource%3A%27fn%20bad%28values%3A%26%5BString%5D%29-%3EString%7Bvalues%5B0%5D%7Dfn%20main%28%29%7B%7D%27%2Ckind%3A%27unsupported%27%2Creason%3AreceiverReason%7D%29%3B%0Aconst%20receivers%3D%5B%5D%3B%0Afor%28const%20%5Bkind%2Celement%2Cmodel%2Cproven%2Clayers%2CinferredCopy%2Caccepted%5Dof%20%5B%0A%20%5B%27array%27%2C%27fixed%27%2C%27owned%20vector%27%2Ctrue%2Ctrue%2Cfalse%2Ctrue%5D%2C%5B%27array%27%2C%27float%27%2C%27immutable%20slice%27%2Ctrue%2Ctrue%2Cfalse%2Ctrue%5D%2C%5B%27array%27%2C%27bool%27%2C%27owned%20vector%27%2Ctrue%2Ctrue%2Cfalse%2Ctrue%5D%2C%5B%27array%27%2C%27unit%27%2C%27immutable%20slice%27%2Ctrue%2Ctrue%2Cfalse%2Ctrue%5D%2C%5B%27%27%2C%27%27%2C%20%27owned%20vector%27%2Ctrue%2Ctrue%2Ctrue%2Ctrue%5D%2C%0A%20%5B%27array%27%2C%27string%27%2C%27owned%20vector%27%2Ctrue%2Ctrue%2Cfalse%2Cfalse%5D%2C%5B%27array%27%2C%27named%27%2C%27immutable%20slice%27%2Ctrue%2Ctrue%2Ctrue%2Cfalse%5D%2C%5B%27array%27%2C%27fixed%27%2C%27unproved%20array%27%2Ctrue%2Ctrue%2Ctrue%2Cfalse%5D%2C%5B%27array%27%2C%27fixed%27%2C%27owned%20vector%27%2Cfalse%2Ctrue%2Ctrue%2Cfalse%5D%2C%5B%27array%27%2C%27fixed%27%2C%27owned%20vector%27%2Ctrue%2Cfalse%2Ctrue%2Cfalse%5D%2C%5B%27%27%2C%27%27%2C%27owned%20vector%27%2Ctrue%2Ctrue%2Cfalse%2Cfalse%5D%2C%5B%27string%27%2C%27%27%2C%27owned%20vector%27%2Ctrue%2Ctrue%2Ctrue%2Cfalse%5D%2C%0A%5D%29receivers.push%28%7Bkind%2Celement%2Cmodel%2Cproven%2Clayers%2CinferredCopy%2Cexpected%3Aaccepted%3F%27%27%3AreceiverReason.slice%28%27Rust%20scalar%20array%20index%3A%