{
  "schemaVersion": 1,
  "description": "Malformed inputs whose error recovery differed between the JavaScript runtime and the native runtime before the JavaScript runtime parsed UTF-8. `expected` is the tree the native tree-sitter 0.27.0 CLI prints for the pinned grammar (fields kept, spans dropped); `utf16Tree` is the tree the stock web-tree-sitter runtime, which parses UTF-16, produced instead (reproducible with `tree-sitter parse --encoding utf16-le`). Both runtimes must produce `expected`.",
  "oracle": "tree-sitter CLI 0.27.0 `tree-sitter parse` over the grammar revisions pinned in parity/language-grammar-inventory.json",
  "cases": [
    {
      "id": "lean-import-without-module",
      "language": "Lean",
      "source": "\nimport",
      "expected": "(module (ERROR))",
      "utf16Tree": "(module (import module: (MISSING identifier)))"
    },
    {
      "id": "lean-prelude-import-without-module",
      "language": "Lean",
      "source": "\nprelude\nimport",
      "expected": "(module (prelude) (ERROR))",
      "utf16Tree": "(module (prelude) (import module: (MISSING identifier)))"
    },
    {
      "id": "rocq-unterminated-comment",
      "language": "Rocq",
      "source": "(* This",
      "expected": "(source_file (ERROR))",
      "utf16Tree": "(source_file (comment (MISSING \"*)\")))"
    },
    {
      "id": "rocq-unterminated-nested-comment",
      "language": "Rocq",
      "source": "(* Outer (* Inner *)",
      "expected": "(source_file (ERROR) (comment))",
      "utf16Tree": "(source_file (comment (comment) (MISSING \"*)\")))"
    },
    {
      "id": "rust-bare-extern",
      "language": "Rust",
      "source": "\nextern",
      "expected": "(source_file (ERROR))",
      "utf16Tree": "(source_file (foreign_mod_item (extern_modifier) (MISSING \";\")))"
    },
    {
      "id": "rust-extern-abi-without-item",
      "language": "Rust",
      "source": "\nextern \"C\"",
      "expected": "(source_file (ERROR (extern_modifier (string_literal (string_content)))))",
      "utf16Tree": "(source_file (foreign_mod_item (extern_modifier (string_literal (string_content))) (MISSING \";\")))"
    },
    {
      "id": "javascript-if-object-without-paren",
      "language": "JavaScript",
      "source": "\nif ({a: 'b'} {c:",
      "expected": "(program (ERROR (ERROR (object (pair key: (property_identifier) value: (string (string_fragment))))) (property_identifier)))",
      "utf16Tree": "(ERROR (parenthesized_expression (object (pair key: (property_identifier) value: (string (string_fragment)))) (MISSING \")\")) (identifier))"
    }
  ]
}
