60f64%60%2C%0A%2F%2F%20printed%20by%20%60ml_number%3A%3Ajs_number%60%20exactly%20as%20JavaScript%20prints%20it.%20Data%20types%20are%20enums%20whose%0A%2F%2F%20data-typed%20fields%20are%20boxed.%20Every%20value%20is%20owned%3A%20a%20variable%20is%20cloned%0A%2F%2F%20where%20it%20is%20consumed.%20Theorems%20cannot%20be%20proved%20in%20Rust%3A%20each%20becomes%20an%0A%2F%2F%20executable%20property%2C%20checked%20over%20a%20bounded%20domain%20by%0A%2F%2F%20%60--ml-check-theorems%60%2C%20while%20the%20proof%20stays%20discharged%20by%20the%20source%20kernel.%0A%0Aimport%20%7B%20castMessage%2C%20overflowMessage%2C%20zeroDivisorMessage%20%7D%20from%20%27.%2Faborts.js%27%3B%0Aimport%20%7BreadJavaScriptNumberBitwiseOperationCode%2CreadJavaScriptNumberBitwiseArity%7D%20from%20%27.%2Fnumber-bitwise-rules.js%27%3B%0Aimport%20%7BNUMBER_BITWISE_PRELUDE%7D%20from%20%27.%2Fnumber-bitwise-runtime.js%27%3B%0Aimport%20%7B%20BIG_INTEGER_BITWISE_PRELUDE%20%7D%20from%20%27.%2Fbig-integer-bitwise-runtime.js%27%3B%0Aimport%20%7BSTRING_NUMBER_PRELUDE%7D%20from%20%27.%2Fstring-number-runtime.js%27%3B%0Aimport%20%7BSOURCE_EXCEPTION_PRELUDE%7D%20from%20%27.%2Fsource-exception-runtime.js%27%3B%0Aimport%20%7BBIG_INTEGER_CONVERSION_PRELUDE%7D%20from%20%27.%2Fbig-integer-conversion-runtime.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptBigIntegerResult%2CreadJavaScriptBigIntegerResultOperation%2CrenderJavaScriptBigIntegerResultExpression%2CrenderJavaScriptBigIntegerDivision%2CrenderJavaScriptBigIntegerPower%2CrenderJavaScriptNumberPower%2CrenderJavaScriptBigIntegerComparison%7D%20from%20%27.%2Fbig-integer-conversion-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptSourceException%2CrenderJavaScriptSourceExceptionExpression%7D%20from%20%27.%2Fsource-exception-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptStringUnitConstruction%2CrenderJavaScriptStringUnitConstruction%7D%20from%20%27.%2Fjavascript-string-unit-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptNumberConversion%2CrequireJavaScrip