20readBigIntegerBitwiseArity%2C%20renderBigIntegerBitwiseExpression%20%7D%20from%20%27.%2Fbig-integer-bitwise-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptNumberConversion%2CrenderJavaScriptNumberScalarConversion%7D%20from%20%27.%2Fstring-number-rules.js%27%3B%0Aimport%20%7BSTRING_NUMBER_LEAN_PRELUDE%7D%20from%20%27.%2Fstring-number-formal-runtime.js%27%3B%0Aimport%20%7BBIG_INTEGER_CONVERSION_LEAN_PRELUDE%7D%20from%20%27.%2Fbig-integer-conversion-formal-runtime.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptBigIntegerResult%2CreadJavaScriptBigIntegerResultOperation%2CrenderJavaScriptBigIntegerResultExpression%2CrenderJavaScriptBigIntegerDivision%2CrenderJavaScriptBigIntegerPower%2CrenderJavaScriptNumberPower%2CrenderJavaScriptBigIntegerComparison%7D%20from%20%27.%2Fbig-integer-conversion-rules.js%27%3B%0Aimport%20%7B%20readRustPrimitiveBitwiseArity%20%7D%20from%20%27.%2Frust-primitive-bitwise-rules.js%27%3B%0Aimport%20%7B%20emitRustPrimitiveBitwise%20%7D%20from%20%27.%2Frust-primitive-bitwise.js%27%3B%0Aimport%20%7B%20acceptLinkedRustCheckedShift%20%7D%20from%20%27.%2Frust-shift-rules.js%27%3B%0Aimport%20%7B%20emitRustCheckedShift%20%7D%20from%20%27.%2Frust-shifts.js%27%3B%0Aimport%20%7B%20renderWrappingFixedIntegerCast%2C%20readFixedIntegerCastStatement%20%7D%20from%20%27.%2Ffixed-integer-cast-rules.js%27%3B%0Aimport%20%7B%20renderCollectionSizeExpression%2C%20renderCollectionReadExpression%20%7D%20from%20%27.%2Fcollection-access-rules.js%27%3B%0A%2F%2F%20Lean%204%20emitter.%20Naturals%20are%20%60Nat%60%2C%20integers%20%60Int%60%3B%20machine%20integers%20are%0A%2F%2F%20represented%20by%20%60Nat%60%2F%60Int%60%20with%20explicit%20range%20checks%20that%20%60panic%21%60%20where%0A%2F%2F%20Rust%20would%20panic.%20Recursion%20is%20structural%20and%20annotated%20as%20such%2C%20so%20the%0A%2F%2F%20Lean%20kernel%20checks%20termination.%20Theorems%20are%20reconstructed%20from%20portable%0A%2F%2F%20proof%20plans%20with%20Lean%20tactics%20and%20re-checked%20by%20the%20Lean%20kernel.%20A%0A%2F%2F%20JavaScript%20Number%20is%20a%20%60Float%60%3B%20the%20kernel%20cannot%20compute%20with%20%60Float%60%2C%0A%2F%2F%20so%20an%20assertion%20about%20Numbers%20is%20checked%20when%20%60main%60%20runs%2C%20as%20in%20the%20source.%0A%0Aimport%20%7B%20typeError%2C%20unsupported%20%7D%20from%20%27.%2Fdiagnostics.js%27%3B%0Aimport%20%7B%20renderCollectionConstruction%2C%20renderCollectionConstructionType%20%7D%20from%20%27.%2Fcollection-construction-rules.js%27%3B%0Aimport%20%7B%20renderOptionalAbsentValue%2C%20renderOptionalCoalescing%2C%20renderOptionalConsoleText%2C%20renderOptionalFlattening%2C%20renderOptionalMatch%2C%20renderOptionalNumericPresent%2C%20renderOptionalPresentValue%2C%20renderOptionalPrimitiveTruth%2C%20renderOptionalProjection%2C%20renderOptionalStrictEquality%2C%20renderOptionalTypeQueryPresent%2C%20renderOptionalUnwrapping%2C%20requireOptionalNumericPredicate%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20renderCollectionIteration%2C%20renderOptionalArrayRead%2C%20renderStringPointIteration%20%7D%20from%20%27.%2Farray-value-rules.js%27%3B%0Aimport%20%7B%20renderArrayFromMapping%20%7D%20from%20%27.%2Farray-from-rules.js%27%3B%0Aimport%20%7B%20readPrimitiveMethodRenderingRefusal%20%7D%20from%20%27.%2Fprimitive-method-rules.js%27%3B%0Aimport%20%7B%20renderRecordProductField%2C%20renderRecordType%2C%20renderRecordValue%20%7D%20from%20%27.%2Frecord-emission-rules.js%27%3B%0Aimport%20%7B%20readUnionTargetRefusal%20%7D%20from%20%27.%2Ftype-syntax-rules.js%27%3B%0Aimport%20%7B%20renderCallableApplication%2C%20renderCallableFunctionReference%2C%20renderCallableFunctionType%2C%20renderCallableLambda%20%7D%20from%20%27.%2Fcallable-source-rules.js%27%3B%0Aimport%20%7B%20acceptProgramTupleProductModel%20%7D%20from%20%27..%2Ftyped-program-link-rules.js%27%3B%0Aimport%20%7B%20propFunctions%20%7D%20from%20%27.%2Fproof.js%27%3B%0Aimport%20%7B%20renameFunction%2C%20renameMain%2C%20renameTheorem%20%7D%20from%20%27.%2Fir.js%