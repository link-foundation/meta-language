eldWriteStatement%2C%20readRecordFieldWriteSuffix%20%7D%20from%20%27.%2Frecord-write-rules.js%27%3B%0Aimport%20%7B%20readReferenceMethodResult%2C%20readReferenceMethodIdentity%2C%20readReferenceMethodStatement%2C%20renderReferenceMethodExpression%20%7D%20from%20%27.%2Freference-method-rules.js%27%3B%0Aimport%20%7B%20acceptSnapshotCallbackParameters%20%7D%20from%20%27.%2Freference-method-rules.js%27%3B%0Aimport%20%7B%20acceptReadOnlyReferenceCallback%20%7D%20from%20%27.%2Freference-callbacks.js%27%3B%0Aimport%20%7B%20readArrayCallbackResultForm%20%7D%20from%20%27.%2Farray-callback-rules.js%27%3B%0Aimport%20%7B%20acceptLinkedArrayStateMethod%2C%20readArrayStateMethodArgumentProfile%2C%20readArrayStateMethodSuffix%2C%0A%20%20renderArrayStateMethodExpression%2C%20readArrayStateMethodIdentity%2C%20readArrayStateMethodStatement%20%7D%20from%20%27.%2Farray-state-method-rules.js%27%3B%0Aimport%20%7BcheckRustRuntimeShell%2CemitRustRuntimeShell%2CrefuseRustRuntimeShellComposition%7D%20from%20%27.%2Frust-runtime-shell.js%27%3B%0Aimport%20%7B%20renderStringLengthExpression%2C%20renderStringMapExpression%2C%20renderStringTestExpression%20%7D%20from%20%27.%2Ffrontend-rules.js%27%3B%0Aimport%20%7BrequireStringOrderUnits%2CrenderStringOrderExpression%7D%20from%20%27.%2Fstring-order-rules.js%27%3B%0A%2F%2F%20Rust%20emitter.%20Naturals%20and%20integers%20are%20%60ml%3A%3ABig%60%2C%20an%20unbounded%20integer%0A%2F%2F%20the%20translation%20carries%20in%20its%20own%20prelude%2C%20so%20no%20value%20is%20ever%20narrowed%3B%0A%2F%2F%20machine%20integers%20stay%20Rust%20machine%20integers%20with%20checked%20arithmetic%2C%20which%0A%2F%2F%20panics%20exactly%20where%20the%20source%20aborts%3B%20a%20JavaScript%20Number%20is%20an%20%60f64%60%2C%0A%2F%2F%20printed%20by%20%60ml_number%3A%3Ajs_number%60%20exactly%20as%20JavaScript%20prints%20it.%20Data%20types%20are%20enums%20whose%0A%2F%2F%20data-typed%20fields%20are%20boxed.%20Every%20value%20is%20owned%3A%20a%20variable%20is%20cloned%0A%2F%2F%20where%20it%20is%20consumed.%20Theorems%20cannot%20be%20proved%20in%20Rust%3A%20each%20becomes%20an%0A%2F%2F%20executable%20property%2C%20checked%20over%20a%20bounded%20domain%20by%0A%2F%2F%20%60--ml-check-theorems%60%2C%20while%20the%20proof%20stays%20discharged%20by%20the%20source%20kernel.%0A%0Aimport%20%7B%20castMessage%2C%20overflowMessage%2C%20zeroDivisorMessage%20%7D%20from%20%27.%2Faborts.js%27%3B%0Aimport%20%7BreadJavaScriptNumberBitwiseOperationCode%2CreadJavaScriptNumberBitwiseArity%7D%20from%20%27.%2Fnumber-bitwise-rules.js%27%3B%0Aimport%20%7BNUMBER_BITWISE_PRELUDE%7D%20from%20%27.%2Fnumber-bitwise-runtime.js%27%3B%0Aimport%20%7B%20BIG_INTEGER_BITWISE_PRELUDE%20%7D%20from%20%27.%2Fbig-integer-bitwise-runtime.js%27%3B%0Aimport%20%7BSTRING_NUMBER_PRELUDE%7D%20from%20%27.%2Fstring-number-runtime.js%27%3B%0Aimport%20%7BSOURCE_EXCEPTION_PRELUDE%7D%20from%20%27.%2Fsource-exception-runtime.js%27%3B%0Aimport%20%7BBIG_INTEGER_CONVERSION_PRELUDE%7D%20from%20%27.%2Fbig-integer-conversion-runtime.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptBigIntegerResult%2CreadJavaScriptBigIntegerResultOperation%2CrenderJavaScriptBigIntegerResultExpression%2CrenderJavaScriptBigIntegerDivision%2CrenderJavaScriptBigIntegerPower%2CrenderJavaScriptNumberPower%2CrenderJavaScriptBigIntegerComparison%7D%20from%20%27.%2Fbig-integer-conversion-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptSourceException%2CrenderJavaScriptSourceExceptionExpression%7D%20from%20%27.%2Fsource-exception-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptStringUnitConstruction%2CrenderJavaScriptStringUnitConstruction%7D%20from%20%27.%2Fjavascript-string-unit-rules.js%27%3B%0Aimport%20%7BacceptLinkedJavaScriptNumberConversion%2CrequireJavaScriptNumberConversionUnits%7D%20from%20%27.%2Fstring-number-rules.js%27%3B%0Aimport%20%7BemitRustJavaScriptNumberConversion%7D%20from%20%27.%2Fjavascript-number-conversion.js%27%3B%0Aimport%20%7B%20readRustPrimitiveBitwiseArity%20%7D%20from%20%27.%2Frust-primitive-bitwi