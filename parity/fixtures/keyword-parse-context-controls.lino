(28: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20The%20public%20face%20of%20the%20native%20grammar%20executor%3A%20compile%20a%20grammar%20once%2C%0A%2F%2F%20then%20parse%20sources%20into%20lossless%20concrete%20syntax%20trees.%20Loading%0A%2F%2F%20%28grammar-runtime%2Fload.js%29%20resolves%20imports%2C%20macros%20and%20parameterized%20rules%0A%2F%2F%20and%20checks%20every%20scanner%2C%20action%20and%20predicate%3B%20the%20executor%0A%2F%2F%20%28grammar-runtime%2Fexecutor.js%29%20runs%20it%20within%20explicit%20resource%20limits%3B%20the%0A%2F%2F%20tree%20module%20%28grammar-runtime%2Fsyntax-tree.js%29%20copies%20and%20renders%20the%20result.%0A%2F%2F%20docs%2Fgrammar%2Ffeature-union.md%20is%20the%20specification%20the%20Rust%20port%20follows.%0Aimport%20%7B%20Executor%2C%20Expectations%2C%20KeywordLexing%2C%20MemoryBudgetReached%2C%20memoryBudget%2C%20NestingTooDeep%2C%20StepLimitReached%2C%20stepBudget%20%7D%20from%20%27.%2Fgrammar-runtime%2Fexecutor.js%27%3B%0Aimport%20%7B%20GrammarRuntimeError%2C%20loadProgram%20%7D%20from%20%27.%2Fgrammar-runtime%2Fload.js%27%3B%0Aimport%20%7B%20decorateGrammar%2C%20decorateSyntaxTree%20%7D%20from%20%27.%2Fgrammar-decorators.js%27%3B%0Aimport%20%7B%20collectAmbiguities%2C%20firstRecovery%2C%20publicTree%2C%20renderSyntaxTree%20%7D%20from%20%27.%2Fgrammar-runtime%2Fsyntax-tree.js%27%3B%0Aimport%20%7B%20inputBytes%2C%20lineAndColumn%20%7D%20from%20%27.%2Fgrammar-runtime%2Ftext.js%27%3B%0A%0Aexport%20%7B%20GrammarRuntimeError%2C%20renderSyntaxTree%20%7D%3B%0A%0A%2F%2A%2A%20A%20source%20the%20grammar%20rejects%3B%20%60rejection%60%20holds%20the%20reason%20and%20position.%20%2A%2F%0Aexport%20class%20GrammarParseError%20extends%20Error%20%7B%0A%20%20constructor%28rejection%29%20%7B%0A%20%20%20%20super%28describeRejection%28rejection%29%29%3B%0A%20%20%20%20this.name%20%3D%20%27GrammarParseError%27%3B%0A%20%20%20%20this.rejection%20%3D%20rejection%3B%0A%20%20%20%20this.reason%20%3D%20rejection.reason%3B%0A%20%20%20%20this.offset%20%3D%20rejection.offset%20%3F%3F%20null%3B%0A%20%20%20%20this.line%20%3D%20rejection.line%20%3F%3F%20null%3B%0A%20%20%20%20this.column%20%3D%20rejection.column%20%3F%3F%20null%3B%0A%20%20%20%20this.expected%20%3D%20rejection.expected%20%3F%3F%20%5B%5D%3B%0A%20%20%7D%0A%7D%0A%0Afunction%20describeRejection%28rejection%29%20%7B%0A%20%20const%20where%20%3D%20rejection.line%20%3F%20%60%20at%20line%20%24%7Brejection.line%7D%20column%20%24%7Brejection.column%7D%60%20%3A%20%27%27%3B%0A%20%20switch%20%28rejection.reason%29%20%7B%0A%20%20%20%20case%20%27syntax%27%3A%20return%20%60syntax%20error%24%7Bwhere%7D%3A%20expected%20%24%7Brejection.expected.join%28%27%2C%20%27%29%20%7C%7C%20%27nothing%20more%27%7D%60%3B%0A%20%20%20%20case%20%27nestingDepth%27%3A%20return%20%60the%20input%20nests%20deeper%20than%20%24%7Brejection.limit%7D%20rules%60%3B%0A%20%20%20%20case%20%27stepLimit%27%3A%20return%20%60the%20parse%20needed%20more%20than%20%24%7Brejection.limit%7D%20steps%60%3B%0A%20%20%20%20case%20%27memoryBudget%27%3A%20return%20%60the%20parse%20needed%20more%20than%20%24%7Brejection.limit%7D%20memo%20cells%60%3B%0A%20%20%20%20case%20%27recovered%27%3A%20return%20%60the%20input%20needed%20error%20recovery%24%7Bwhere%7D%60%3B%0A%20%20%20%20case%20%27ambiguity%27%3A%20return%20%60the%20input%20is%20ambiguous%24%7Bwhere%7D%60%3B%0A%20%20%20%20default%3A%20return%20%60the%20input%20is%20rejected%20%28%24%7Brejection.reason%7D%29%60%3B%0A%20%20%7D%0A%7D%0A%0Afunction%20positioned%28reason%2C%20bytes%2C%20offset%2C%20extra%20%3D%20%7B%7D%29%20%7B%0A%20%20return%20%7B%20reason%2C%20offset%2C%20...lineAndColumn%28bytes%2C%20offset%29%2C%20...extra%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Parses%20the%20whole%20input%20with%20a%20fresh%20executor%20that%20%60prepare%60%20sets%20up.%20While%0A%20%2A%20a%20scanner%27s%20%60expected%60%20was%20answered%20before%20the%20parse%20made%20the%20request%20it%0A%20%2A%20asks%20about%2C%20the%20parse%20runs%20again%20with%20the%20requests%20so%20far%20%28see%0A%20%2A%20%60Expectations%60%20in%20grammar-runtime%2Fexecutor.js%29.%20Each%20run%20has%20its%20own%20step%0A%20%2A%20budget%3B%20all%20runs%20share%20the%20parse%27s%20%60memory%60%20budget.%0A%20%2A%2F%0Afunction%20runParse%28program%2C%20bytes%2C%20startRule%2C%20options%2C%20maxDepth%2C%20expectations%2C%20memory%2C%20prepare%29%20%7B%0A%20%20for%20%28%3B%3B%29%20%7B%0A%20%20%20%20const%20executor%20%3D%20new%20Executor%28program%2C%20bytes%2C%200%2C%20bytes.length%2C%20options%2C%20stepBudget%28options%2C%20bytes.length%2C%20memory%29%2C%20maxDepth%29%3B%0A%20%20%20%20executor.expectations%20%3D%20expectations.restart%28%29%3B%0A%20%20%20%20prepare%28executor%29%3B%0A%20%20%20%20const%20outcome%20%3D%20executor.run%28startRule%29%3B%0A%20%20%20%20if%20%28%21expectations.stale%29%20return%20outcome%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Automatic%20error%20recovery%20after%20a%20failed%20parse%3A%20each%20round%20reparses%20with%0A%20%2A%20one%20more%20repair%20point%2C%20the%20farthest%20offset%20where%20an%20element%20failed%20without%0A%20%2A%20a%20repair%2C%20until%20a%20parse%20completes.%20After%20%60maxRepairs%60%20rounds%20%28default%2032%29%2C%0A%20%2A%20or%20when%20no%20new%20point%20appears%2C%20the%20last%20round%27s%20partial%20tree%20stands%2C%20the%0A%20%2A%20rest%20of%20the%20input%20an%20ERROR%20leaf.%20Each%20round%20has%20its%20own%20step%20budget%3B%20a%0A%20%2A%20round%20that%20runs%20out%20of%20steps%20ends%20the%20rounds%20as%20well.%0A%20%2A%2F%0Afunction%20repairParse%28program%2C%20bytes%2C%20startRule%2C%20options%2C%20maxDepth%2C%20failed%2C%20keywords%2C%20expectations%2C%20memory%29%20%7B%0A%20%20const%20points%20%3D%20new%20Set%28%29%3B%0A%20%20const%20maxRepairs%20%3D%20options.maxRepairs%20%3F%3F%2032%3B%0A%20%20let%20outcome%20%3D%20failed%3B%0A%20%20while%20%28points.size%20%3C%20maxRepairs%29%20%7B%0A%20%20%20%20const%20point%20%3D%20outcome.elementFarthest%20%3E%3D%200%20%3F%20outcome.elementFarthest%20%3A%20outcome.farthest%3B%0A%20%20%20%20if%20%28points.has%28point%29%29%20break%3B%0A%20%20%20%20points.add%28point%29%3B%0A%20%20%20%20try%20%7B%0A%20%20%20%20%20%20outcome%20%3D%20runParse%28program%2C%20bytes%2C%20startRule%2C%20options%2C%20maxDepth%2C%20expectations%2C%20memory%2C%20%28executor%29%20%3D%3E%20%7B%0A%20%20%20%20%20%20%20%20executor.repairPoints%20%3D%20points%3B%0A%20%20%20%20%20%20%20%20executor.keywords%20%3D%20keywords%3B%0A%20%20%20%20%20%20%7D%29%3B%0A%20%20%20%20%7D%20catch%20%28error%29%20%7B%0A%20%20%20%20%20%20if%20%28%21%28error%20instanceof%20StepLimitReached%29%29%20throw%20error%3B%0A%20%20%20%20%20%20break%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28outcome.ok%29%20return%20outcome%3B%0A%20%20%7D%0A%20%20return%20%7B%20ok%3A%20true%2C%20root%3A%20outcome.partial%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Parses%20%60source%60%20%28a%20string%20or%20UTF-8%20bytes%29%20with%20a%20loaded%20program.%20Returns%0A%20%2A%20%60%7B%20ok%2C%20tree%2C%20ambiguities%2C%20rejection%20%7D%60%3A%20%60ok%60%20is%20true%20only%20without%20a%0A%20%2A%20rejection%3B%20the%20tree%20is%20kept%20whenever%20one%20was%20built.%0A%20%2A%2F%0Afunction%20parseProgram%28program%2C%20source%2C%20options%29%20%7B%0A%20%20const%20bytes%20%3D%20inputBytes%28source%29%3B%0A%20%20const%20startRule%20%3D%20options.startRule%20%3F%3F%20program.start%3B%0A%20%20if%20%28%21program.rules.has%28startRule%29%29%20throw%20new%20GrammarRuntimeError%28%60undefined%20start%20rule%20%24%7BstartRule%7D%60%2C%20%27reference%27%29%3B%0A%20%20const%20memory%20%3D%20memoryBudget%28options%29%3B%0A%20%20const%20budget%20%3D%20stepBudget%28options%2C%20bytes.length%2C%20memory%29%3B%0A%20%20const%20maxDepth%20%3D%20options.maxDepth%20%3F%3F%201000%3B%0A%20%20let%20outcome%3B%0A%20%20%2F%2F%20Under%20%60%28matching%20longest%29%60%20the%20input%20is%20parsed%20again%20while%20the%20tree%20takes%0A%20%20%2F%2F%20a%20token%20rule%27s%20leaf%20where%20a%20keyword%20a%20lexer%20prefers%20matched.%0A%20%20const%20keywords%20%3D%20program.tokenRanks%20%26%26%20program.settling%3F.tokens%20%21%3D%3D%20false%20%3F%20new%20KeywordLexing%28%7B%20...program.tokenRanks%2C%20bytes%20%7D%2C%20program%29%20%3A%20null%3B%0A%20%20const%20expectations%20%3D%20new%20Expectations%28%29%3B%0A%20%20try%20%7B%0A%20%20%20%20do%20%7B%0A%20%20%20%20%20%20outcome%20%3D%20runParse%28program%2C%20bytes%2C%20startRule%2C%20options%2C%20maxDepth%2C%20expectations%2C%20memory%2C%20%28executor%29%20%3D%3E%20%7B%0A%20%20%20%20%20%20%20%20executor.keywords%20%3D%20keywords%3B%0A%20%20%20%20%20%20%20%20%2F%2F%20With%20no%20repair%20point%20yet%2C%20recovery%20only%20notes%20where%20elements%20fail.%0A%20%20%20%20%20%20%20%20if%20%28options.errorRecovery%29%20executor.repairPoints%20%3D%20new%20Set%28%29%3B%0A%20%20%20%20%20%20%7D%29%3B%0A%20%20%20%20%20%20if%20%28%21outcome.ok%20%26%26%20options.errorRecovery%29%20outcome%20%3D%20repairParse%28program%2C%20bytes%2C%20startRule%2C%20options%2C%20maxDepth%2C%20outcome%2C%20keywords%2C%20expectations%2C%20memory%29%3B%0A%20%20%20%20%7D%20while%20%28keywords%20%26%26%20outcome.ok%20%26%26%20keywords.conflicts%28outcome.root%29%29%3B%0A%20%20%7D%20catch%20%28error%29%20%7B%0A%20%20%20%20if%20%28error%20instanceof%20StepLimitReached%29%20%7B%0A%20%20%20%20%20%20return%20%7B%20ok%3A%20false%2C%20tree%3A%20null%2C%20ambiguities%3A%20%5B%5D%2C%20rejection%3A%20%7B%20reason%3A%20%27stepLimit%27%2C%20limit%3A%20budget.limit%20%7D%20%7D%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28error%20instanceof%20MemoryBudgetReached%29%20%7B%0A%20%20%20%20%20%20return%20%7B%20ok%3A%20false%2C%20tree%3A%20null%2C%20ambiguities%3A%20%5B%5D%2C%20rejection%3A%20%7B%20reason%3A%20%27memoryBudget%27%2C%20limit%3A%20memory.limit%20%7D%20%7D%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%20%28error%20instanceof%20NestingTooDeep%20%7C%7C%20%28error%20instanceof%20RangeError%20%26%26%20%2Fcall%20stack%2Fu.test%28error.message%29%29%29%20%7B%0A%20%20%20%20%20%20const%20tree%20%3D%20publicTree%28%7B%20type%3A%20%27error%27%2C%20start%3A%200%2C%20end%3A%20bytes.length%2C%20reason%3A%20%27nestingDepth%27%20%7D%2C%20bytes%29%3B%0A%20%20%20%20%20%20return%20%7B%20ok%3A%20false%2C%20tree%2C%20ambiguities%3A%20%5B%5D%2C%20rejection%3A%20%7B%20reason%3A%20%27nestingDepth%27%2C%20limit%3A%20maxDepth%20%7D%20%7D%3B%0A%20%20%20%20%7D%0A%20%20%20%20throw%20error%3B%0A%20%20%7D%0A%20%20if%20%28%21outcome.ok%29%20%7B%0A%20%20%20%20return%20%7B%20ok%3A%20false%2C%20tree%3A%20null%2C%20ambiguities%3A%20%5B%5D%2C%20rejection%3A%20positioned%28%27syntax%27%2C%20bytes%2C%20outcome.farthest%2C%20%7B%20expected%3A%20outcome.expected%20%7D%29%20%7D%3B%0A%20%20%7D%0A%20%20const%20tree%20%3D%20decorateSyntaxTree%28publicTree%28outcome.root%2C%20bytes%29%2C%20options.decorators%29%3B%0A%20%20const%20ambiguities%20%3D%20collectAmbiguities%28outcome.root%2C%20program%29%3B%0A%20%20let%20rejection%20%3D%20null%3B%0A%20%20const%20recovery%20%3D%20firstRecovery%28tree%29%3B%0A%20%20if%20%28recovery%20%26%26%20options.recovery%20%21%3D%3D%20%27accept%27%29%20rejection%20%3D%20positioned%28%27recovered%27%2C%20bytes%2C%20recovery.start%29%3B%0A%20%20else%20if%20%28ambiguities.length%20%3E%200%20%26%26%20options.ambiguity%20%3D%3D%3D%20%27reject%27%29%20rejection%20%3D%20positioned%28%27ambiguity%27%2C%20bytes%2C%20ambiguities%5B0%5D.start%29%3B%0A%20%20return%20%7B%20ok%3A%20rejection%20%3D%3D%3D%20null%2C%20tree%2C%20ambiguities%2C%20rejection%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%0A%20%2A%20Compiles%20%60grammar%60%20%28a%20Grammar%20or%20its%20normalized%20document%29%20for%20the%20native%0A%20%2A%20executor.%20%60options.resolveGrammar%28name%29%60%20returns%20the%20grammar%20an%20import%20or%0A%20%2A%20an%20embedded%20language%20names%3B%20%60maxDepth%60%2C%20%60stepLimit%60%2C%20%60memoLimit%60%20and%0A%20%2A%20%60memoryLimit%60%20%28the%20memo%20cells%20a%20parse%20keeps%29%20bound%20a%20parse%3B%0A%20%2A%20%60ambiguity%3A%20%27reject%27%60%20turns%20a%20reported%20ambiguity%20into%20a%20rejection%20and%0A%20%2A%20%60recovery%3A%20%27accept%27%60%20accepts%20a%20tree%20with%20ERROR%20or%20MISSING%20nodes%3B%0A%20%2A%20%60errorRecovery%3A%20true%60%20repairs%20a%20failed%20parse%20into%20such%20a%20tree%20%28at%20most%0A%20%2A%20%60maxRepairs%60%20repair%20points%29%20instead%20of%20rejecting%20it%20without%20one.%0A%20%2A%20Each%20parse%20may%20override%20the%20options%20and%20choose%20a%20%60startRule%60.%0A%20%2A%20%60options.decorators%60%20%28a%20DecoratorSet%29%20decorates%20the%20grammar%27s%20rules%20at%20the%0A%20%2A%20%60grammar-rule%60%20level%20before%20it%20is%20loaded%20and%20every%20tree%20at%20the%20%60executor%60%0A%20%2A%20and%20%60recovery%60%20levels%20%28see%20%60decorateSyntaxTree%60%29.%0A%20%2A%2F%0Aexport%20function%20createGrammarParser%28grammar%2C%20options%20%3D%20%7B%7D%29%20%7B%0A%20%20const%20decorated%20%3D%20grammar%3F.rules%20instanceof%20Map%20%3F%20decorateGrammar%28grammar%2C%20options.decorators%29%20%3A%20grammar%3B%0A%20%20const%20program%20%3D%20loadProgram%28decorated%2C%20options%29%3B%0A%20%20const%20parseTree%20%3D%20%28source%2C%20parseOptions%20%3D%20%7B%7D%29%20%3D%3E%20parseProgram%28program%2C%20source%2C%20%7B%20...options%2C%20...parseOptions%20%7D%29%3B%0A%20%20return%20%7B%0A%20%20%20%20parseTree%2C%0A%20%20%20%20parse%28source%2C%20parseOptions%20%3D%20%7B%7D%29%20%7B%0A%20%20%20%20%20%20const%20outcome%20%3D%20parseTree%28source%2C%20parseOptions%29%3B%0A%20%20%20%20%20%20if%20%28%21outcome.ok%29%20throw%20new%20GrammarParseError%28outcome.rejection%29%3B%0A%20%20%20%20%20%20return%20outcome.tree%3B%0A%20%20%20%20%7D%2C%0A%20%20%7D%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
