d%3A%20%60function%20ml_fixed%28value%2C%20min%2C%20max%2C%20message%29%20%7B%0A%20%20if%20%28value%20%3C%20min%20%7C%7C%20value%20%3E%20max%29%20throw%20new%20RangeError%28message%29%3B%0A%20%20return%20value%3B%0A%7D%60%2C%0A%20%20divide%3A%20%60%2F%2F%20Integer%20division%20with%20the%20source%27s%20rounding%3B%20by%20zero%20it%20aborts%20with%20the%20message%20%5C%60zero%5C%60%0A%2F%2F%20or%2C%20when%20that%20is%20null%2C%20is%20total%20%28x%20%2F%200%20%3D%200%2C%20x%20%25%200%20%3D%20x%29%3B%20a%20machine-integer%20quotient%0A%2F%2F%20out%20of%20%5Bmin%2C%20max%5D%20aborts%20with%20%5C%60overflow%5C%60%2C%20the%20remainder%20too.%0Afunction%20ml_divide%28a%2C%20b%2C%20rounding%2C%20zero%2C%20remainder%2C%20bounds%29%20%7B%0A%20%20if%20%28b%20%3D%3D%3D%200n%29%20%7B%0A%20%20%20%20if%20%28zero%20%21%3D%3D%20null%29%20throw%20new%20RangeError%28zero%29%3B%0A%20%20%20%20return%20remainder%20%3F%20a%20%3A%200n%3B%0A%20%20%7D%0A%20%20let%20q%20%3D%20a%20%2F%20b%3B%0A%20%20const%20r%20%3D%20a%20-%20q%20%2A%20b%3B%0A%20%20if%20%28r%20%21%3D%3D%200n%29%20%7B%0A%20%20%20%20if%20%28rounding%20%3D%3D%3D%20%27floor%27%20%26%26%20%28r%20%3C%200n%29%20%21%3D%3D%20%28b%20%3C%200n%29%29%20q%20-%3D%201n%3B%0A%20%20%20%20if%20%28rounding%20%3D%3D%3D%20%27euclid%27%20%26%26%20r%20%3C%200n%29%20q%20%3D%20b%20%3E%200n%20%3F%20q%20-%201n%20%3A%20q%20%2B%201n%3B%0A%20%20%7D%0A%20%20if%20%28bounds%20%26%26%20%28q%20%3C%20bounds%5B0%5D%20%7C%7C%20q%20%3E%20bounds%5B1%5D%29%29%20throw%20new%20RangeError%28bounds%5B2%5D%29%3B%0A%20%20return%20remainder%20%3F%20a%20-%20q%20%2A%20b%20%3A%20q%3B%0A%7D%60%2C%0A%20%20toNatChecked%3A%20%60function%20ml_toNatChecked%28value%2C%20message%29%20%7B%0A%20%20if%20%28value%20%3C%200n%29%20throw%20new%20RangeError%28message%29%3B%0A%20%20return%20value%3B%0A%7D%60%2C%0A%20%20abort%3A%20%60function%20ml_abort%28message%29%20%7B%0A%20%20throw%20new%20Error%28message%29%3B%0A%7D%60%2C%0A%20%20assert%3A%20%60function%20ml_assert%28holds%2C%20statement%29%