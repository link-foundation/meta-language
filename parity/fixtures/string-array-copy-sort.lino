er%20stays%20a%20Number.%20Data%20values%20are%20plain%20objects%20whose%20%60%24%60%20property%20names%0A%2F%2F%20the%20constructor.%20Modules%20become%20object%20literals%20referenced%20by%20qualified%0A%2F%2F%20names.%20Theorems%20cannot%20be%20proved%20in%20JavaScript%3A%20each%20becomes%20an%20executable%0A%2F%2F%20property%2C%20checked%20over%20a%20bounded%20domain%20by%20%60--ml-check-theorems%60%2C%20while%20the%0A%2F%2F%20proof%20obligation%20stays%20discharged%20by%20the%20source%20language%27s%20kernel.%0A%0Aimport%20%7B%20castMessage%2C%20overflowMessage%2C%20zeroDivisorMessage%20%7D%20from%20%27.%2Faborts.js%27%3B%0Aimport%20%7B%20renderCollectionConstruction%20%7D%20from%20%27.%2Fcollection-construction-rules.js%27%3B%0Aimport%20%7B%20renderSurfaceReferenceOperation%20%7D%20from%20%27.%2Fsurface-reference-analysis-rules.js%27%3B%0Aimport%20%7B%20renderCollectionIteration%2C%20renderOptionalArrayRead%2C%20renderStringPointIteration%20%7D%20from%20%27.%2Farray-value-rules.js%27%3B%0Aimport%20%7B%20renderArrayFromMapping%20%7D%20from%20%27.%2Farray-from-rules.js%27%3B%0Aimport%20%7B%20renderPrimitiveMethodArgument%2C%20renderPrimitiveMethodExpression%20%7D%20from%20%27.%2Fprimitive-method-rules.js%27%3B%0Aimport%20%7B%20renderRecordField%2C%20renderRecordValue%20%7D%20from%20%27.%2Frecord-emission-rules.js%27%3B%0Aimport%20%7B%20readOptionalJavaScriptTextPrelude%2C%20renderOptionalAbsentValue%2C%20renderOptionalCoalescing%2C%20renderOptionalFlattening%2C%20renderOptionalJavaScriptOperation%2C%20renderOptionalPresentValue%2C%20renderOptionalPrimitiveTruth%2C%20renderOptionalProjection%2C%20renderOptionalStrictEquality%2C%20renderOptionalUnwrapping%20%7D%20from%20%27.%2Foptional-value-rules.js%27%3B%0Aimport%20%7B%20renderCallableApplication%2C%20renderCallableCellOperation%2C%20renderCallableFunctionReference%2C%20renderCallableLambda%20%7D%20from%20%27.%2Fcallable-source-rules.js%27%3B%0Aimport%20%7B%20requireDataObjectFreeze%20%7D%20from%20%27.%2Fprimiti