{
  "description": "The foundations meta-language knows as data: integer, overflow, universe, effect, proof and logic models, the models each language uses, and the explicit correspondences between distinct models. No model is built in as the universal logic; a consumer brings its own foundations and proof authority and relates them to these models. js/scripts/build-foundation-models.mjs copies this file into both runtimes and checks it.",
  "families": [
    {
      "id": "integer-model",
      "definition": "What an integer value is: the set of values a numeric type ranges over and how its arithmetic is defined."
    },
    {
      "id": "overflow-model",
      "definition": "What happens when an arithmetic result leaves the range of its type."
    },
    {
      "id": "universe-model",
      "definition": "How types are themselves classified: whether types are terms, which sorts exist and how they nest."
    },
    {
      "id": "effect-model",
      "definition": "Which observable effects an evaluation may have besides returning a value, and how they are expressed."
    },
    {
      "id": "proof-system",
      "definition": "What checks a proof, if anything, and which axioms that checker accepts."
    },
    {
      "id": "logic-model",
      "definition": "The truth values propositions or conditions take and how the connectives combine them."
    }
  ],
