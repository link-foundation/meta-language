  "correspondences": [
    {
      "from": "integer-model.fixed-width-integer",
      "to": "integer-model.unbounded-integer",
      "kind": "conditional",
      "condition": "The values agree while every intermediate result stays within the bounds of the width; a translation guards each operation and follows the source's overflow model outside them.",
      "translationEncodings": [
        "machine-integer",
        "numbers"
      ]
    },
    {
      "from": "integer-model.natural-number",
      "to": "integer-model.unbounded-integer",
      "kind": "embedding",
      "condition": "Every natural number is an integer, and addition and multiplication agree; subtraction agrees only when the result is not negative, since natural subtraction truncates at zero.",
      "translationEncodings": [
        "numbers"
      ]
    },
    {
      "from": "integer-model.binary64-number",
      "to": "integer-model.unbounded-integer",
      "kind": "conditional",
      "condition": "An integral binary64 value of magnitude at most 2^53 denotes the same integer, and an operation agrees while its exact result is such a value."
    },
    {
      "from": "overflow-model.abort",
      "to": "overflow-model.wrapping",
      "kind": "conditional",
      "condition": "The two agree on executions that do not overflow; where the source overflows, one stops and the other produces a value."
    },
    {
      "from": "overflow-model.abort",
      "to": "effect-model.abort",
      "kind": "encoding",
      "condition": "An overflow that aborts is the abort effect raised by the arithmetic operation, so a target without overflow checks encodes it as an explicit bounds check followed by that target's abort.",
      "translationEncodings": [
        "numbers"
      ]
    },
    {
      "from": "overflow-model.abort",
      "to": "overflow-model.no-overflow",
      "kind": "conditional",
      "condition": "An unbounded target computes the exact result where the source aborts, so the two agree only on executions that do not abort unless the translation adds the bounds checks.",
      "translationEncodings": [
        "machine-integer",
        "non-aborting-executions"
      ]
    },
    {
      "from": "effect-model.thrown-exceptions",
      "to": "effect-model.error-values",
      "kind": "encoding",
      "condition": "A thrown value becomes an error value that every caller propagates explicitly, and a handler becomes a match on it."
    },
    {
      "from": "effect-model.abort",
      "to": "effect-model.panic-with-default-value",
      "kind": "conditional",
      "condition": "The two agree on executions that do not abort; where the source aborts, Lean's panic reports the message and continues with a default value.",
      "translationEncodings": [
        "non-aborting-executions"
      ]
    },
    {
      "from": "effect-model.abort",
      "to": "effect-model.thrown-exceptions",
      "kind": "encoding",
      "condition": "An abort becomes a thrown error that no handler of the translated program catches, so the program stops where the source stops.",
      "translationEncodings": [
        "numbers"
      ]
    },
    {
      "from": "effect-model.abort",
      "to": "effect-model.pure-total-functions",
      "kind": "conditional",
      "condition": "A total target has no abort, so the two agree only on executions that do not abort; the translation records that assumption for every operation that can abort.",
      "translationEncodings": [
        "non-aborting-executions"
      ]
    },
    {
      "from": "effect-model.unrestricted-side-effects",
      "to": "effect-model.monadic-input-output",
      "kind": "encoding",
      "condition": "Each effectful statement runs inside the monad, and the effects the source performs implicitly become explicit binds in source order."
    },
    {
      "from": "effect-model.possible-nontermination",
      "to": "effect-model.pure-total-functions",
      "kind": "conditional",
      "condition": "A definition corresponds only when its termination is shown, by structural recursion or a decreasing measure; otherwise it has no total counterpart."
    },
    {
      "from": "universe-model.no-universes",
      "to": "universe-model.non-cumulative-sort-hierarchy",
      "kind": "embedding",
      "condition": "Every source type becomes a type in Type, the lowest universe of data, and no source type quantifies over types of a higher universe."
    },
    {
      "from": "universe-model.no-universes",
      "to": "universe-model.cumulative-type-hierarchy",
      "kind": "embedding",
      "condition": "Every source type becomes a type in Set or Type, and no source type quantifies over types of a higher universe."
    },
    {
      "from": "universe-model.non-cumulative-sort-hierarchy",
      "to": "universe-model.cumulative-type-hierarchy",
      "kind": "conditional",
      "condition": "Type u corresponds to Type@{u} and Prop to Prop for universe-monomorphic definitions; Rocq's cumulativity has no Lean counterpart and becomes an explicit lift such as ULift."
    },
    {
      "from": "proof-system.lean-kernel",
      "to": "proof-system.rocq-kernel",
      "kind": "restatement",
      "condition": "A theorem is restated as a proof obligation and checked by the target's own kernel; a proof that relies on Lean's classical or quotient axioms needs those axioms declared in the Rocq development, and no proof term is trusted across kernels."
    },
    {
      "from": "logic-model.two-valued-boolean",
      "to": "logic-model.strong-kleene-three-valued",
      "kind": "embedding",
      "condition": "True and false embed as true and false, and the connectives agree on them; unknown has no two-valued counterpart."
    },
    {
      "from": "logic-model.strong-kleene-three-valued",
      "to": "logic-model.belnap-four-valued",
      "kind": "embedding",
      "condition": "True, false and unknown embed as true, false and unknown, and the connectives agree on them; both has no three-valued counterpart."
    },
    {
      "from": "logic-model.two-valued-boolean",
      "to": "logic-model.probabilistic-truth",
      "kind": "embedding",
      "condition": "True and false embed as probabilities 1 and 0, and negation agrees; conjunction and disjunction agree only under the independence the probabilistic model assumes."
    },
    {
      "from": "logic-model.two-valued-boolean",
      "to": "logic-model.classical-propositions",
      "kind": "embedding",
      "condition": "A boolean b corresponds to the decidable proposition b = true, and the connectives agree through the Decidable instances."
    },
    {
      "from": "logic-model.constructive-propositions",
      "to": "logic-model.classical-propositions",
      "kind": "embedding",
      "condition": "Every constructive proof remains a classical proof; the converse holds only for proofs that do not use excluded middle or choice."
    }
  ],
  "distinctions": [
    {
      "models": [
        "proof-system.bounded-property-check",
