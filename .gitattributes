# Keep vendored benchmark fixture byte counts stable across platforms.
rust/benches/corpora/** text eol=lf

# Preserve downloaded CI logs verbatim; they can contain trailing spaces from GitHub Actions output.
docs/case-studies/issue-177/ci-logs/*.log -whitespace

# Built-in grammar specifications are hashed into grammar provenance, and the translation
# corpus into the translation stage fixtures; keep their bytes identical on every platform.
parity/grammars/** text eol=lf
# The pinned grammar sources the native grammars import are gzipped bytes.
parity/grammars/sources/*.gz binary
parity/fixtures/translation-corpus/** text eol=lf
# The issue #195 evidence corpus is hashed into every platform consumer report and must
# hash identically on Windows checkouts, or the supported-platform join rejects them.
parity/fixtures/issue-195-evidence.json text eol=lf
# The issue #195 conformance and generative fixtures pin the SHA-256 of their corpus files,
# sources and seeds, and slice byte offsets out of them; Windows checkouts must not add CRs.
parity/fixtures/issue-195-conformance/** text eol=lf
parity/fixtures/issue-195-generative/** text eol=lf
# docs/vision.md is the fixture of every repository-directive row and Rust tests slice its
# sections at blank lines; Windows checkouts must not add CRs.
docs/vision.md text eol=lf
# Self-translation round-trips meta-language's own modules byte for byte, and the
# self-translation and decorator corpora are compared byte for byte; Windows checkouts
# must not add CRs. The vendored grammars keep their upstream bytes.
rust/src/** text=auto eol=lf
js/src/** text=auto eol=lf
js/src/vendor/** -text
parity/self-translation/** text=auto eol=lf
parity/decorators/** text=auto eol=lf
