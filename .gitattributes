# Keep vendored benchmark fixture byte counts stable across platforms.
rust/benches/corpora/** text eol=lf

# Canonical Links data participates in byte-exact reloads and provenance hashes.
*.lino text eol=lf

# Preserve downloaded CI logs verbatim; they can contain trailing spaces from GitHub Actions output.
docs/case-studies/issue-177/ci-logs/*.log -whitespace

# Built-in grammar specifications are hashed into grammar provenance, and the translation
# corpus into the translation stage fixtures; keep their bytes identical on every platform.
parity/grammars/** text eol=lf
# The pinned grammar sources the native grammars import are gzipped bytes.
parity/grammars/**/*.gz binary
parity/fixtures/translation-corpus/** text eol=lf
# The issue #195 evidence corpus is hashed into every platform consumer report and must
# hash identically on Windows checkouts, or the supported-platform join rejects them.
parity/fixtures/issue-195-evidence.json text eol=lf
# The issue #195 conformance and generative fixtures pin the SHA-256 of their corpus files,
# sources and seeds, and slice byte offsets out of them; Windows checkouts must not add CRs.
parity/fixtures/issue-195-conformance/** text eol=lf
parity/fixtures/issue-195-generative/** text eol=lf
# docs/vision.md is the fixture of every repository-directive row and Rust tests slice its
# sections at blank lines; Windows checkouts must not add CRs.
docs/vision.md text eol=lf
# Self-translation round-trips meta-language's own modules byte for byte, and the
# self-translation and decorator corpora are compared byte for byte; Windows checkouts
# must not add CRs. The vendored grammars keep their upstream bytes.
rust/src/** text=auto eol=lf
rust/tests/unit/** text=auto eol=lf
js/src/** text=auto eol=lf
js/src/vendor/** -text
parity/self-translation/** text=auto eol=lf
parity/decorators/** text=auto eol=lf
# The mapped-selection fixture pins these authored source files by exact bytes
# and SHA-256. Keep their checkout bytes fixed without normalizing raw fixtures.
js/tests/grammar-selection-json-string.test.js text eol=lf
js/tests/support/grammar-selection-mapping-cases.js text eol=lf
js/scripts/generate-grammar-selection-mapping-fixtures.mjs text eol=lf
rust/tests/unit/grammar_recursive_selection.rs text eol=lf
rust/tests/unit/grammar_recursive_selection_mapping.rs text eol=lf
# The lexer-complement control matches its complete original source snapshot.
rust/tests/fixtures/grammar/antlr/set-complement.g4 text eol=lf
# The original token-negation snapshot and queue patch authenticate exact bytes.
rust/tests/fixtures/grammar/antlr/covering.g4 text eol=lf
rust/vendor/tree-sitter-agda-layout/layout-state.patch text eol=lf
# Rust embeds a copy of the foundation register and compares it to this file byte for byte.
parity/foundation-models.json text eol=lf
# The retained array contract and both authored source profiles are hashed before
# execution. Preserve their exact bytes when Windows enables automatic CRLF.
parity/sources/modern-javascript-parity-expectations-2026-10-16.txt text eol=lf
js/tests/translation-arrays.test.js text eol=lf
rust/tests/unit/translation_arrays.rs text eol=lf
# Native diagnostic assertions select the exact hashed dependency source profile.
rust/Cargo.lock text eol=lf
rust/Cargo.toml text eol=lf
# Version-qualified translation fixtures authenticate the complete npm manifest.
js/package.json text eol=lf
