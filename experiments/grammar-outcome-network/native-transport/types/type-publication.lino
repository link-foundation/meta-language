(12: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Draft%20controls%20only.%20The%20author%20has%20not%20executed%20this%20file.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20test%20from%20%27node%3Atest%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BcaptureNativeOutcomeTypeInventory%2CreadPreErasureType%7D%20from%20%27.%2Finventory.mjs%27%3B%0A%0Aconst%20digest%3Dsource%3D%3EcreateHash%28%27sha256%27%29.update%28source%29.digest%28%27hex%27%29%3B%0Alet%20captured%3B%0Aconst%20current%3D%28%29%3D%3Ecaptured%3F%3F%3DcaptureNativeOutcomeTypeInventory%28%29%3B%0Aconst%20declaration%3D%28model%2Cname%29%3D%3Emodel.nodes.find%28node%3D%3Enode.name%3D%3D%3Dname%26%26model.roots.includes%28node.identity%29%29%3B%0Aconst%20referenced%3D%28model%2Crecord%29%3D%3Emodel.nodes.find%28node%3D%3Enode.identity%3D%3D%3Drecord.typeReference%29%3B%0Aconst%20allRecords%3Downer%3D%3E%5B...%28owner.fields%3F%3F%5B%5D%29%2C...%28owner.variants%3F%3F%5B%5D%29.flatMap%28variant%3D%3E%5B...%28variant.fields%3F%3F%5B%5D%29%2C...%28variant.tuple%3F%3F%5B%5D%29%5D%29%5D%3B%0A%0Atest%28%27complete%20actual%20nine-owner%20declarations%20fields%20variants%20and%20source%20evidence%20survive%20derivation%27%2C%28%29%3D%3E%7B%0A%20%20const%20capture%3Dcurrent%28%29%2Cmodel%3Dcapture.derive%28%29%3B%0A%20%20assert.equal%28model.roots.length%2C9%29%3Bassert.equal%28model.inputProofs.length%2C4%29%3B%0A%20%20assert.deepEqual%28model.sourceInventory%2Ccapture.sourceInventory%2C%27whole%20original%20inventory%20remains%20byte%2Ftext%2Fdata%20exact%27%29%3B%0A%20%20for%28const%20original%20of%20capture.sourceInventory.declarations%29%20%7B%0A%20%20%20%20const%20projected%3Ddeclaration%28model%2Coriginal.name%29%3Bassert.ok%28projected%29%3B%0A%20%20%20%20assert.equal%28projected.source%2Coriginal.source%29%3Bassert.deepEqual%28projected.span%2Coriginal.span%29%3Bassert.equal%28projected.sha256%2Coriginal.sha256%29%3B%0A%20%20%20%20assert.equal%28digest%28projected.source%29%2Coriginal.sha256%29%3B%0A%20%20%20%20assert.deepEqual%28allRecords%28projected%29.map%28record%3D%3E%5Brecord.name%2Crecord.type%2Crecord.source%2Crecord.span%5D%29%2CallRecords%28original%29.map%28record%3D%3E%5Brecord.name%2Crecord.type%2Crecord.source%2Crecord.span%5D%29%29%3B%0A%20%20%20%20for%28const%20variant%20of%20original.variants%3F%3F%5B%5D%29%20%7B%0A%20%20%20%20%20%20const%20retained%3Dprojected.variants.find%28value%3D%3Evalue.name%3D%3D%3Dvariant.name%29%3B%0A%20%20%20%20%20%20assert.equal%28retained.source%2Cvariant.source%29%3Bassert.deepEqual%28retained.span%2Cvariant.span%29%3Bassert.equal%28retained.sourceSha256%2Cdigest%28variant.source%29%29%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20input%3Dmodel.sourceInventory.inputs.find%28value%3D%3Evalue.file%3D%3D%3Doriginal.file%29%2Cbytes%3DBuffer.from%28input.source%29%3B%0A%20%20%20%20for%28const%20record%20of%20%5B...allRecords%28projected%29%2C...%28projected.sourceType%3F%5Bprojected%5D%3A%5B%5D%29%5D%29%20%7B%0A%20%20%20%20%20%20const%20evidence%3Drecord.sourceType%3Bassert.ok%28evidence%2C%27every%20actual%20field%2Ftuple%2Falias%20retains%20a%20complete%20type%20CST%27%29%3B%0A%20%20%20%20%20%20assert.equal%28bytes.subarray%28evidence.span.start%2Cevidence.span.end%29.toString%28%29%2Cevidence.source%29%3B%0A%20%20%20%20%20%20assert.equal%28evidence.sha256%2Cdigest%28evidence.source%29%29%3B%0A%20%20%20%20%20%20assert.deepEqual%28%7Bstart%3Aevidence.cst.start%2Cend%3Aevidence.cst.end%7D%2Cevidence.span%29%3B%0A%20%20%20%20%20%20assert.equal%28typeof%20evidence.cst.term%2C%27string%27%29%3B%0A%20%20%20%20%7D%0A%20%20%7D%0A%20%20assert.deepEqual%28declaration%28model%2C%27SyntaxTree%27%29.variants.map%28value%3D%3Evalue.name%29%2C%5B%27Node%27%2C%27Token%27%2C%27Error%27%2C%27Missing%27%2C%27Embed%27%5D%29%3B%0A%20%20assert.equal%28declaration%28model%2C%27SyntaxAttributes%27%29.alias%2C%27IndexMap%3CString%2COperationValue%3E%27%29%3B%0A%20%20asser