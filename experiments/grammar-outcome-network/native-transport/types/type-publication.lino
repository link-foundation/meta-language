nst%20reference%20of%20node.references%29assert.ok%28identities.has%28reference%29%29%3B%0A%20%20const%20tree%3Ddeclaration%28model%2C%27SyntaxTree%27%29%2Cnode%3Dtree.variants.find%28value%3D%3Evalue.name%3D%3D%3D%27Node%27%29%3B%0A%20%20const%20vector%3Dreferenced%28model%2Cnode.fields.find%28value%3D%3Evalue.name%3D%3D%3D%27children%27%29%29%3Bassert.equal%28vector.kind%2C%27Vec%27%29%3B%0A%20%20const%20self%3Dmodel.nodes.find%28value%3D%3Evalue.identity%3D%3D%3Dvector.arguments%5B0%5D%29%3Bassert.equal%28self.kind%2C%27named%27%29%3Bassert.deepEqual%28self.references%2C%5Btree.identity%5D%29%3B%0A%20%20const%20embed%3Dtree.variants.find%28value%3D%3Evalue.name%3D%3D%3D%27Embed%27%29%2Coption%3Dreferenced%28model%2Cembed.fields.find%28value%3D%3Evalue.name%3D%3D%3D%27selection%27%29%29%3B%0A%20%20assert.equal%28option.kind%2C%27Option%27%29%3Bconst%20box%3Dmodel.nodes.find%28value%3D%3Evalue.identity%3D%3D%3Doption.arguments%5B0%5D%29%3Bassert.equal%28box.kind%2C%27Box%27%29%3B%0A%20%20const%20qualified%3Dmodel.nodes.find%28value%3D%3Evalue.identity%3D%3D%3Dbox.arguments%5B0%5D%29%3Bassert.deepEqual%28qualified.references%2C%5Bdeclaration%28model%2C%27GrammarSelection%27%29.identity%5D%29%3B%0A%20%20assert.equal%28qualified.source%2C%27super%3A%3Agrammar_selection%3A%3AGrammarSelection%27%29%3B%0A%20%20const%20alias%3Ddeclaration%28model%2C%27SyntaxAttributes%27%29%2Cmap%3Dmodel.nodes.find%28value%3D%3Evalue.identity%3D%3D%3Dalias.aliasTypeReference%29%3B%0A%20%20assert.equal%28map.kind%2C%27IndexMap%27%29%3Bassert.equal%28map.arguments.length%2C2%29%3B%0A%20%20assert.equal%28map.binding.qualified%2C%27indexmap%3A%3AIndexMap%27%29%3Bassert.match%28map.binding.source%2C%2Fuse%20indexmap%3A%3AIndexMap%3B%2Fu%29%3B%0A%20%20const%20usize%3Dreferenced%28model%2Cnode.fields.find%28value%3D%3Evalue.name%3D%3D%3D%27start%27%29%29%3Bassert.deepEqual%28usize.integer%2C%7Bsigned%3Afalse%2Cbits%3Anull%7D%29%3Bassert.ok%28usize.obligations%5B0%5D.includes%28%27pointer%20width%27%29%29%3B%0A%20%20const%20selection%3Ddeclaration%28model%2C%27GrammarSelection%27%29%2Cjson%3Dreferenced%28model%2Cselection.fields.find%28value%3D%3Evalue.name%3D%3D%3D%27provenance%27%29%29%3B%0A%20%20assert.equal%28json.kind%2C%27json%27%29%3Bassert.equal%28json.binding.qualified%2C%27serde_json%3A%3AValue%27%29%3Bassert.ok%28json.obligations.some%28value%3D%3Evalue.includes%28%27effective%20feature%27%29%29%29%3B%0A%20%20const%20integer%3Dreferenced%28model%2Cdeclaration%28model%2C%27OperationValue%27%29.variants.find%28value%3D%3Evalue.name%3D%3D%3D%27Integer%27%29.tuple%5B0%5D%29%3Bassert.deepEqual%28integer.integer%2C%7Bsigned%3Atrue%2Cbits%3A64%7D%29%3B%0A%20%20assert.ok%28model.nodes.length%3C256%2C%27syntax%20references%20are%20finite%20rather%20than%20recursive%20type%20expansion%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27unknown%20unsupported%20shadowed%20and%20ambiguous%20type%20forms%20refuse%20without%20guessing%20owners%27%2C%28%29%3D%3E%7B%0A%20%20const%20scope%3Dcurrent%28%29.scopes.find%28value%3D%3Evalue.qualifiedOwner.endsWith%28%27%3A%3ASyntaxTree%27%29%29%3B%0A%20%20for%28const%20source%20of%20%5B%27Unknown%27%2C%27foreign%3A%3ASyntaxTree%27%2C%27Result%3CString%2CString%3E%27%2C%27Vec%3CString%2CString%3E%27%2C%27Option%3C%3E%27%2C%27Vec%27%2C%27%5BString%3B3%5D%27%2C%27%2Aconst%20str%27%2C%22%26%27a%20str%22%2C%22%26%27static%20mut%20str%22%2C%27%26str%27%2C%27String%20String%27%2C%27Vec%3CVec%3CString%3E%3E%20garbage%27%5D%29%0A%20%20%20%20assert.throws%28%28%29%3D%3EreadPreErasureType%28source%2Cscope%29%2Cundefined%2Csource%29%3B%0A%20%20const%20shadowed%3DstructuredClone%28scope%29%3Bshadowed.bindings.find%28value%3D%3Evalue.name%3D%3D%3D%27String%27%29.identity%3D%27unadmitted%3Aforeign%3A%3AString%27%3B%0A%20%20assert.throws%28%28%29%3D%3EreadPreErasureType%28%27String%27%2Cshadowed%29%2C%2Fadmitted%20source-qualified%20owner%2Fu%29%3B%0A%20%20const%20ambiguous%3DstructuredClone%28scope%29%3Bambiguous.bindings.push%28%7B...ambiguous.bindi