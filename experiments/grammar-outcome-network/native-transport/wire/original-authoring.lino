er%29%20%3D%3E%20StructuredDataValue%3A%3ANumber%28exact_json_number%28number%29%3F%29%2C%27%3B%0Aconst%20unique%3D%28source%2Cneedle%29%3D%3E%7B%0A%20%20const%20index%3Dsource.indexOf%28needle%29%3Bassert.ok%28index%3E%3D0%26%26source.indexOf%28needle%2Cindex%2B1%29%3D%3D%3D-1%2C%27one%20exact%20qualified%20source%20occurrence%27%29%3Breturn%20index%3B%0A%7D%3B%0A%0A%2F%2A%2A%20Extract%20the%20actual%20original%20Number%20arm%20from%20the%20actual%20CST-owned%20from_json.%0A%20%2A%20Its%20body%2C%20comments%2C%20integer%20comparison%20and%20existing%20scoped%20allow%20move%20intact.%0A%20%2A%2F%0Aexport%20function%20proposeParent%28source%29%20%7B%0A%20%20assert.equal%28digest%28source%29%2CoutcomeWirePolicy.pins%5BparentPath%5D%2C%27original%20parent%20remains%20authenticated%27%29%3B%0A%20%20const%20parsed%3DreadRustSourceItems%28Buffer.from%28source%29%29%3B%0A%20%20assert.ok%28%21parsed.items.some%28item%3D%3Eitem.name%3D%3D%3D%27exact_json_number%27%7C%7Citem.name%3D%3D%3D%27grammar_outcome%27%29%2C%27no%20hidden%20new%20owner%20collision%27%29%3B%0A%20%20const%20functions%3Dparsed.items.filter%28item%3D%3Eitem.kind%3D%3D%3D%27function_item%27%26%26item.name%3D%3D%3D%27from_json%27%29%3B%0A%20%20assert.equal%28functions.length%2C1%29%3B%0A%20%20const%20originalFunction%3Dparsed.text%28functions%5B0%5D.node%29%3B%0A%20%20const%20start%3Dunique%28originalFunction%2CarmPrefix%29%3B%0A%20%20const%20end%3DoriginalFunction.indexOf%28%27%5Cn%20%20%20%20%20%20%20%20Value%3A%3AString%28text%29%20%3D%3E%27%2Cstart%29%3B%0A%20%20assert.ok%28end%3Estart%29%3B%0A%20%20const%20originalArm%3DoriginalFunction.slice%28start%2Cend%29%3B%0A%20%20assert.ok%28originalArm.endsWith%28armSuffix%29%29%3B%0A%20%20const%20indented%3DoriginalArm.slice%28armPrefix.length%2C-armSuffix.length%29.split%28%27%5Cn%27%29%3B%0A%20%20assert.ok%28indented.every%28line%3D%3Eline%3D%3D%3D%27%27%7C%7Cline.startsWith%28%27%20%20%20%20%20%20%20%20%20%20%20%20%27%29%29%2C%27only%20source%20indentation%20is%20removed%27%29%3B%0A%20%20const%20body%3Dindented.map%28line%3D%3Eline.slice%2812%29%29.join%28%27%5Cn%27%29%3B%0A%20%20const%20returnLine%3D%27StructuredDataValue%3A%3ANumber%28value%29%27%3B%0A%20%20assert.ok%28body.endsWith%28returnLine%29%29%3Bunique%28body%2CreturnLine%29%3B%0A%20%20const%20borrowedBody%3Dbody.slice%280%2C-returnLine.length%29%2B%27Ok%28value%29%27%3B%0A%20%20const%20helper%3D%27fn%20exact_json_number%28number%3A%20%26Number%29%20-%3E%20Result%3Cf64%2C%20String%3E%20%7B%5Cn%27%0A%20%20%20%20%2BborrowedBody.split%28%27%5Cn%27%29.map%28line%3D%3E%27%20%20%20%20%27%2Bline%29.join%28%27%5Cn%27%29%2B%27%5Cn%7D%5Cn%5Cn%27%3B%0A%20%20const%20fromJsonReplacement%3DoriginalFunction.replace%28originalArm%2CcallArm%29%3B%0A%20%20unique%28source%2CoriginalFunction%29%3Bunique%28source%2CmoduleAnchor%29%3Bunique%28source%2CfunctionAnchor%29%3B%0A%20%20const%20proposed%3Dsource.replace%28originalFunction%2CfromJsonReplacement%29%0A%20%20%20%20.replace%28functionAnchor%2Chelper%2BfunctionAnchor%29.replace%28moduleAnchor%2CmoduleAddition%2BmoduleAnchor%29%3B%0A%20%20const%20inverse%3Dcandidate%3D%3E%7B%0A%20%20%20%20unique%28candidate%2CmoduleAddition%29%3Bunique%28candidate%2Chelper%29%3Bunique%28candidate%2CcallArm%29%3B%0A%20%20%20%20return%20candidate.replace%28moduleAddition%2C%27%27%29.replace%28helper%2C%27%27%29.replace%28callArm%2CoriginalArm%29%3B%0A%20%20%7D%3B%0A%20%20assert.equal%28inverse%28proposed%29%2Csource%2C%27whole%20original%20parent%20is%20exactly%20reconstructible%27%29%3B%0A%20%20return%20%7Bsource%3Aproposed%2Cinverse%2Chelper%2CoriginalArm%2CcallArm%2C%0A%20%20%20%20evidence%3A%7Bpath%3AparentPath%2CoriginalBytes%3ABuffer.byteLength%28source%29%2CoriginalSha256%3Adigest%28source%29%2C%0A%20%20%20%20%20%20proposedBytes%3ABuffer.byteLength%28proposed%29%2CproposedSha256%3Adigest%28proposed%29%2C%0A%20%20%20%20%20%20originalNumberArmSha256%3Adigest%28originalArm%29%2ChelperSha256%3Adigest%28helper%29%2C%0A%20%20%20%20%20%20sourceFunction%3A%7Bstart%3Afunctions%5B0%5D.node.start%2Cend%3Afunctions%5B0%5D.node.end%2Csha256%3Adigest%28originalFunction%29%7D%2C%0A%20%20%20%20%20%20permittedChanges%3A%5B%27private%20child%20module%20and%20public%20use%27%2C%27exact%20Number%20arm%20extraction%20and%20scalar%20call%27%5D%7D%7D%3B%0A%7D%0A%0Aexport%20function%20buildIntegration%28root%3Drepository%29%20%7B%0A%20%20%2F%2F%20This%20reauthenticates%20all%20B94%20source%20pins%2C%20aliases%2C%20imports%2C%20root%20paths%20and%0A%20%20%2F%2F%20every%20one%20of%20the%20nine%20declarations%20before%20emitting%20any%20private%20output.%0A%20%20const%20packet%3DbuildOutcomePacket%28root%29%3B%0A%20%20const%20original%3DreadFileSync%28resolve%28root%2CparentPath%29%2C%27utf8%27%29%3B%0A%20%20const%20parent%3DproposeParent%28original%29%3B%0A%20%20const%20template%3DreadFileSync%28new%20URL%28%27.%2Fsinks.rs%27%2Cimport.meta.url%29%2C%27utf8%27%29%3B%0A%20%20const%20oldNotice%3D%27%2F%2F%20PRIVATE%20GENERATED%20PROPOSAL%3B%20no%20concrete%20sink%20or%20native%20execution.%5Cn%27%0A%20%20%20%20%2B%27%2F%2F%20One%20ordered%20borrowed%20visitor%20drives%20CountSink%28Node%3D%28%29%29%20and%20DirectSink%28Node%3DLinkId%29.%5Cn%27%0A%20%20%20%20%2B%27%2F%2F%20Recursive%20control%20flow%20below%20is%20NOT%20an%20arbitrary-depth%20resource%20proof.%5Cn%27%3B%0A%20%20assert.ok%28packet.source.startsWith%28oldNotice%29%2C%27exact%20unchanged%20generated%20visitor%20notice%27%29%3B%0A%20%20const%20notice%3D%27%2F%2F%20Generated%20exact%20borrowed%20declaration%20transport.%20Native%20execution%20remains%20unverified.%5Cn%27%0A%20%20%20%20%2B%27%2F%2F%20Recursive%20visitor%20admission%20is%20explicitly%20bounded%20to%20depth%20limits%20at%20most%20256.%5Cn%27%3B%0A%20%20const%20child%3Dtemplate%2B%27%5Cn%27%2Bnotice%2Bpacket.source.slice%28oldNotice.length%29%3B%0A%20%20assert.ok%28%21child.includes%28%27.clone%28%27%29%26%26%21child.includes%28%27to_value%27%29%26%26%21child.includes%28%27from_json%28%27%29%29%3B%0A%20%20assert.ok%28%21child.includes%28%27StructuredDataValue%27%29%26%26%21child.includes%28%27%20as%20f64%27%29%29%3B%0A%20%20assert.ok%28child.split%28%27%5Cn%27%29.length%3C1000%2C%27bounded%20source%20owner%27%29%3B%0A%20%20return%20%7Boriginal%2Cparent%2Cchild%2Cplan%3Apacket.plan%2Creceipt%3A%7BschemaVersion%3A1%2C%0A%20%20%20%20boundary%3A%27Private%20mechanically%20generated%20transport%3B%20no%20native%20compilation%2C%20execution%2C%20public%20API%20parity%20or%20default%20CST%20integration%20claim.%27%2C%0A%20%20%20%20parent%3Aparent.evidence%2Cchild%3A%7Bpath%3A%27rust%2Fsrc%2Fstructured_data_links%2Fgrammar_outcome.rs%27%2Cbytes%3ABuffer.byteLength%28child%29%2Csha256%3Adigest%28child%29%7D%2C%0A%20%20%20%20predecessor%3A%7BpolicySha256%3Adigest%28readFileSync%28new%20URL%28%27..%2Fmeta-language-bulk95-native-outcome%2Fwire-policy.mjs%27%2Cimport.meta.url%29%29%29%2C%0A%20%20%20%20%20%20originalParentPin%3AoutcomeWirePolicy.pins%5BparentPath%5D%2Cpins%3Apacket.receipt.inputs%7D%2C%0A%20%20%20%20sourcePolicyChanges%3A%5B%5D%2C%20%2F%2F%20Parent%20successor%20is%20recorded%20separately%20above%3B%20no%20old%20pin%20is%20overwritten.%0A%20%20%20%20generatorSha256%3Adigest%28readFileSync%28fileURLToPath%28import.meta.url%29%29%29%2CtemplateSha256%3Adigest%28template%29%2C%0A%20%20%20%20profile%3A%7BmaximumDepthLimit%3A256%2Climits%3A%27positive%3B%20expanded%20occurrences%2Fscalar%20bytes%3B%20new%20API%20only%27%2CrootCountOrder%3A%27last%27%7D%2C%0A%20%20%20%20pending%3A%5B%27native%20compilation%20and%20execution%27%2C%27matching%20JavaScript%20API%20or%20experiment-only%20placement%27%2C%27CI%20all-nine-type%20parity%20and%20budget%20controls%27%2C%27arbitrary-depth%20explicit%20native%20frames%27%5D%7D%7D%3B%0A%7D%0A%0Aif%28process.argv%5B1%5D%26%26resolve%28process.argv%5B1%5D%29%3D%3D%3DfileURLToPath%28import.meta.url%29%29%20%7B%0A%20%20const%20result%3DbuildIntegration%28%29%2Cdirectory%3Ddirname%28fileURLToPath%28import.meta.url%29%29%3B%0A%20%20writeF