(668: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20PRIVATE%20executable%20plan%20controls.%20Native%20fixtures%20are%20plain%20tagged%20data%20here%3B%0A%2F%2F%20this%20does%20not%20execute%20native%20visitors%20or%20replace%20any%20production%20codec.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BwellFormedString%7D%20from%20%27%2FUsers%2Fkonard%2FCode%2FArchive%2Flink-foundation%2Fmeta-language%2Fjs%2Fsrc%2Fstructured-data-model.js%27%3B%0A%0Aconst%20owned%20%3D%20name%20%3D%3E%20%28%7Bkind%3A%27owned%27%2Cname%7D%29%3B%0Aconst%20json%20%3D%20%7Bkind%3A%27json%27%7D%3B%0Aconst%20string%20%3D%20%7Bkind%3A%27string%27%7D%3B%0Aconst%20has%20%3D%20%28object%2Ckey%29%20%3D%3E%20Object.hasOwn%28object%2Ckey%29%3B%0Aconst%20text%20%3D%20value%20%3D%3E%20%7Bassert.equal%28typeof%20value%2C%27string%27%29%3Bassert.ok%28wellFormedString%28value%29%2C%27native%20UTF-8%20string%20cannot%20contain%20an%20unpaired%20code%20unit%27%29%3Breturn%20value%3B%7D%3B%0Aconst%20fields%20%3D%20%28value%2Cnames%2Cvariant%3Dfalse%29%20%3D%3E%20%7B%0A%20%20assert.ok%28value%26%26Object.getPrototypeOf%28value%29%3D%3D%3DObject.prototype%2C%27native%20record%20control%20must%20be%20plain%20tagged%20data%27%29%3B%0A%20%20assert.ok%28Reflect.ownKeys%28value%29.every%28key%3D%3Etypeof%20key%3D%3D%3D%27string%27%26%26%28names.includes%28key%29%7C%7C%28variant%26%26key%3D%3D%3D%27%24variant%27%29%29%29%2C%27unknown%20native%20control%20field%27%29%3B%0A%7D%3B%0A%0Afunction%2A%20orderedEntries%28plan%2Crows%2CsourceFields%2Cvalue%2Cvariant%3Dfalse%29%20%7B%0A%20%20fields%28value%2CsourceFields%2Cvariant%29%3B%0A%20%20for%28const%20row%20of%20rows%29%20%7B%0A%20%20%20%20if%28row.literal%29%20%7Byield%20%7Bkey%3Arow.key%2Ctype%3Atypeof%20row.value%3D%3D%3D%27string%27%3Fstring%3A%7Bkind%3A%27null%27%7D%2Cvalue%3Arow.value%7D%3Bcontinue%3B%7D%0A%20%20%20%20if%28row.flatten%29%20%7B%0A%20%20%20%20%20%20const%20leaf%3Dvalue%5Brow.native%5D%2Cshape%3Dplan.shapes.find%28shape%3D%3Eshape.native%3D%3D%3D%27LeafText%27%29%3B%0A%20%20%20%20%20%20fields%28leaf%2C%5B%27payload%27%5D%2Ctrue%29%3B%0A%20%20%20%20%20%20const%20selected%3Dshape.variants.find%28variant%3D%3Evariant.name%3D%3D%3Dleaf.%24variant%29%3B%0A%20%20%20%20%20%20assert.ok%28selected%2C%27unknown%20LeafText%20variant%27%29%3Btext%28leaf.payload%29%3B%0A%20%20%20%20%20%20for%28const%20entry%20of%20selected.flatten%29%20yield%20%7Bkey%3Aentry.key%2Ctype%3Aentry.literal%3F%7Bkind%3A%27null%27%7D%3Astring%2Cvalue%3Aentry.literal%3Fentry.value%3Aleaf.payload%7D%3B%0A%20%20%20%20%20%20continue%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20present%3Dhas%28value%2Crow.native%29%3B%0A%20%20%20%20if%28row.presence%3D%3D%3D%27some%27%26%26%21present%29%20continue%3B%0A%20%20%20%20if%28row.presence%3D%3D%3D%27nullable%27%26%26%21present%29%20%7Byield%20%7Bkey%3Arow.key%2Ctype%3A%7Bkind%3A%27null%27%7D%2Cvalue%3Anull%7D%3Bcontinue%3B%7D%0A%20%20%20%20assert.ok%28present%2C%27native%20control%20lacks%20required%20%27%2Brow.native%29%3B%0A%20%20%20%20if%28row.presence%3D%3D%3D%27true%27%29%20%7Bassert.equal%28typeof%20value%5Brow.native%5D%2C%27boolean%27%29%3Bif%28%21value%5Brow.native%5D%29%20continue%3B%7D%0A%20%20%20%20yield%20%7Bkey%3Arow.key%2Ctype%3A%5B%27some%27%2C%27nullable%27%5D.includes%28row.presence%29%3Frow.type.item%3Arow.type%2Cvalue%3Avalue%5Brow.native%5D%7D%3B%0A%20%20%7D%0A%7D%0A%0Afunction%20classify%28plan%2Ctype%2Cvalue%29%20%7B%0A%20%20if%28type.kind%3D%3D%3D%27Box%27%29%20return%20classify%28plan%2Ctype.item%2Cvalue%29%3B%0A%20%20if%28type.kind%3D%3D%3D%27Vec%27%29%20%7Bassert.ok%28Array.isArray%28value%29%29%3Breturn%20%7Bkind%3A%27array%27%2Cidentity%3Avalue%2Cvalues%3Avalue%2Citem%3Atype.item%7D%3B%7D%0A%20%20if%28type.kind%3D%3D%3D%27owned%27%29%20%7B%0A%20%20%20%20if%28type.name%3D%3D%3D%27SyntaxAttributes%27%29%20%7B%0A%20%20%20%20%20%20assert.ok%28value%20instanceof%20Map%2C%27IndexMap%20control%20uses%20ordered%20entries%2C%20not%20a%20JS%20object%20that%20reorders%20numeric%20keys%27%29%3B%0A%20%20%20%20%20%20return%20%7Bkind%3A%27object%27%2Cidentity%3Avalue%2Centries%3A%28function%2A%28%29%7Bfor%28const%20%5Bkey%2Citem%5D%20of%20value%29%20yield%20%7Bkey%3Atext%28key%29%2Ctype%3Aowned%28%27OperationValue%27%29%2Cvalue%3Aitem%7D%3B%7D%29%28%29%7D%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20shape%3Dplan.shapes.find%28shape%3D%3Eshape.native%3D%3D%3Dtype.name%29%3Bassert.ok%28shape%2C%27unknown%20owned%20declaration%27%29%3B%0A%20%20%20%20if%28shape.entries%29%20return%20%7Bkind%3A%27object%27%2Cidentity%3Avalue%2Centries%3AorderedEntries%28plan%2Cshape.entries%2Cshape.sourceFields%2Cvalue%29%7D%3B%0A%20%20%20%20const%20variant%3Dshape.variants.find%28variant%3D%3Evariant.name%3D%3D%3Dvalue%3F.%24variant%29%3Bassert.ok%28variant%2C%27unknown%20native%20variant%27%29%3B%0A%20%20%20%20if%28variant.entries%29%20return%20%7Bkind%3A%27object%27%2Cidentity%3Avalue%2Centries%3AorderedEntries%28plan%2Cvariant.entries%2Cvariant.sourceFields%2Cvalue%2Ctrue%29%7D%3B%0A%20%20%20%20assert.equal%28variant.transparent%2C0%2C%27LeafText%20is%20flattened%20only%20inside%20its%20owning%20object%27%29%3B%0A%20%20%20%20fields%28value%2C%5B%27payload%27%5D%2Ctrue%29%3Bassert.ok%28has%28value%2C%27payload%27%29%29%3B%0A%20%20%20%20return%20classify%28plan%2Cvariant.payloadType%2Cvalue.payload%29%3B%0A%20%20%7D%0A%20%20if%28type.kind%3D%3D%3D%27json%27%29%20%7B%0A%20%20%20%20if%28value%3D%3D%3Dnull%29%20return%20%7Bkind%3A%27null%27%7D%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27boolean%27%29%20return%20%7Bkind%3A%27boolean%27%2Cvalue%7D%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27number%27%29%20return%20%7Bkind%3A%27number%27%2Cvalue%7D%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27string%27%29%20return%20%7Bkind%3A%27string%27%2Cvalue%3Atext%28value%29%7D%3B%0A%20%20%20%20if%28Array.isArray%28value%29%29%20return%20%7Bkind%3A%27array%27%2Cidentity%3Avalue%2Cvalues%3Avalue%2Citem%3Ajson%7D%3B%0A%20%20%20%20assert.ok%28value%26%26Object.getPrototypeOf%28value%29%3D%3D%3DObject.prototype%2C%27native%20JSON%20control%20must%20be%20representable%20plain%20data%27%29%3B%0A%20%20%20%20return%20%7Bkind%3A%27object%27%2Cidentity%3Avalue%2Centries%3A%28function%2A%28%29%7Bfor%28const%20key%20of%20Object.keys%28value%29%29%20yield%20%7Bkey%3Atext%28key%29%2Ctype%3Ajson%2Cvalue%3Avalue%5Bkey%5D%7D%3B%7D%29%28%29%7D%3B%0A%20%20%7D%0A%20%20if%28type.kind%3D%3D%3D%27null%27%29%20%7Bassert.equal%28value%2Cnull%29%3Breturn%20%7Bkind%3A%27null%27%7D%3B%7D%0A%20%20if%28type.kind%3D%3D%3D%27string%27%29%20return%20%7Bkind%3A%27string%27%2Cvalue%3Atext%28value%29%7D%3B%0A%20%20if%28type.kind%3D%3D%3D%27bool%27%29%20%7Bassert.equal%28typeof%20value%2C%27boolean%27%29%3Breturn%20%7Bkind%3A%27boolean%27%2Cvalue%7D%3B%7D%0A%20%20if%28type.kind%3D%3D%3D%27usize%27%7C%7Ctype.kind%3D%3D%3D%27i64%27%29%20%7B%0A%20%20%20%20assert.ok%28typeof%20value%3D%3D%3D%27bigint%27%7C%7Ctypeof%20value%3D%3D%3D%27number%27%2C%27integer%20fixture%20must%20retain%20its%20original%20integer%27%29%3B%0A%20%20%20%20if%28typeof%20value%3D%3D%3D%27number%27%29%20assert.ok%28Number.isSafeInteger%28value%29%2C%27use%20BigInt%20for%20large%20native%20integer%20controls%27%29%3B%0A%20%20%20%20const%20integer%3DBigInt%28value%29%3B%0A%20%20%20%20if%28type.kind%3D%3D%3D%27i64%27%29%20assert.ok%28integer%3E%3D-%281n%3C%3C63n%29%26%26integer%3C%281n%3C%3C63n%29%29%3B%0A%20%20%20%20else%20assert.ok%28integer%3E%3D0n%2C%27usize%20cannot%20be%20negative%27%29%3B%0A%20%20%20%20const%20represented%3DNumber%28integer%29%3B%0A%20%20%20%20assert.ok%28Number.isFinite%28represented%29%26%26BigInt%28represented%29%3D%3D%3Dinteger%2C%27native%20integer%20is%20not%20exactly%20representable%20as%20binary64%27%29%3B%0A%20%20%20%20return%20%7Bkind%3A%27number%27%2Cvalue%3Arepresented%7D%3B%0A%20%20%7D%0A%20%20throw%20new%20TypeError%28%27unsupported%20control%20type%20%27%2Btype.kind%29%3B%0A%7D%0A%0A%2F%2A%2A%20Iterate%20ordered%20graph%20events%20without%20constructing%20a%20projected%20value%20tree.%0A%20%2A%20Explicit%20JS%20control%20stack%3B%20the%20generated%20native%20draft%20remains%20recursive.%0A%20%2A%2F%0Aexport%20function%2A%20outcomeWireEvents%28plan%2Cvalue%2Ctype%3Downed%28%27ParseOutcome%27%29%2Coptions%3D%7B%7D%29%20%7B%0A%20%20const%20maximumFrames%3Doptions.maximumFrames%3F%3F1_000_000%3B%0A%20%20assert.ok%28Number.isSafeInteger%28maximumFrames%29%26%26maximumFrames%3E0%29%3B%0A%20%20const%20stack%3D%5B%5D%2Cactive%3Dnew%20Set%28%29%3B%0A%20%20const%20push%3Dframe%3D%3E%7Bassert.ok%28stack.length%3CmaximumFrames%2C%27control%20frame%20reservation%20exceeds%20resource%20limit%27%29%3Bstack.push%28frame%29%3B%7D%3B%0A%20%20push%28%7Bkind%3A%27value%27%2Ctype%2Cvalue%2Cdepth%3A1%7D%29%3B%0A%20%20while%28stack.length%29%20%7B%0A%20%20%20%20const%20frame%3Dstack.pop%28%29%2Cdepth%3Dframe.depth%3B%0A%20%20%20%20if%28frame.kind%3D%3D%3D%27end%27%29%20%7Bactive.delete%28frame.identity%29%3Byield%20%7Bkind%3Aframe.array%3F%27endArray%27%3A%27endObject%27%2Cdepth%7D%3Bcontinue%3B%7D%0A%20%20%20%20if%28frame.kind%3D%3D%3D%27fields%27%29%20%7B%0A%20%20%20%20%20%20const%20next%3Dframe.entries.next%28%29%3B%0A%20%20%20%20%20%20if%28next.done%29%20continue%3B%0A%20%20%20%20%20%20push%28frame%29%3B%0A%20%20%20%20%20%20yield%20%7Bkind%3A%27pair%27%2Cdepth%3Adepth%2B1%7D%3B%0A%20%20%20%20%20%20yield%20%7Bkind%3A%27string%27%2Cvalue%3Atext%28next.value.key%29%2Cdepth%3Adepth%2B2%2Ckey%3Atrue%7D%3B%0A%20%20%20%20%20%20push%28%7Bkind%3A%27endPair%27%2Cdepth%3Adepth%2B1%7D%29%3B%0A%20%20%20%20%20%20push%28%7Bkind%3A%27value%27%2Ctype%3Anext.value.type%2Cvalue%3Anext.value.value%2Cdepth%3Adepth%2B2%7D%29%3B%0A%20%20%20%20%20%20continue%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%28frame.kind%3D%3D%3D%27items%27%29%20%7B%0A%20%20%20%20%20%20if%28frame.index%3D%3D%3Dframe.values.length%29%20continue%3B%0A%20%20%20%20%20%20assert.ok%28has%28frame.values%2Cframe.index%29%2C%27sparse%20native%20vector%20control%27%29%3B%0A%20%20%20%20%20%20const%20value%3Dframe.values%5Bframe.index%2B%2B%5D%3Bpush%28frame%29%3B%0A%20%20%20%20%20%20push%28%7Bkind%3A%27value%27%2Ctype%3Aframe.item%2Cvalue%2Cdepth%3Adepth%2B1%7D%29%3Bcontinue%3B%0A%20%20%20%20%7D%0A%20%20%20%20if%28frame.kind%3D%3D%3D%27endPair%27%29%20%7Byield%20%7Bkind%3A%27endPair%27%2Cdepth%7D%3Bcontinue%3B%7D%0A%20%20%20%20const%20result%3Dclassify%28plan%2Cframe.type%2Cframe.value%29%3B%0A%20%20%20%20if%28result.kind%21%3D%3D%27object%27%26%26result.kind%21%3D%3D%27array%27%29%20%7Byield%20%7B...result%2Cdepth%7D%3Bcontinue%3B%7D%0A%20%20%20%20assert.ok%28%21active.has%28result.identity%29%2C%27cyclic%20native%20control%20fixture%27%29%3B%0A%20%20%20%20yield%20%7Bkind%3Aresult.kind%2Cdepth%7D%3B%20%2F%2F%20Budget%20sink%20sees%20this%20BEFORE%20child%20frames.%0A%20%20%20%20active.add%28result.identity%29%3B%0A%20%20%20%20push%28%7Bkind%3A%27end%27%2Cidentity%3Aresult.identity%2Carray%3Aresult.kind%3D%3D%3D%27array%27%2Cdepth%7D%29%3B%0A%20%20%20%20if%28result.kind%3D%3D%3D%27array%27%29%20push%28%7Bkind%3A%27items%27%2Cvalues%3Aresult.values%2Citem%3Aresult.item%2Cindex%3A0%2Cdepth%7D%29%3B%0A%20%20%20%20else%20push%28%7Bkind%3A%27fields%27%2Centries%3Aresult.entries%2Cdepth%7D%29%3B%0A%20%20%7D%0A%20%20yield%20%7Bkind%3A%27root%27%2Cdepth%3A0%7D%3B%20%2F%2F%20Existing%20Encoder%20inserts%20schema%20root%20last.%0A%7D%0A%0A%2F%2A%2A%20Count%20EXPANDED%20graph%20occurrences%20and%20scalar%20bytes%3B%20no%20scalar%20interner%2Fgraph.%0A%20%2A%20This%20contract%20applies%20only%20to%20the%20proposed%20NEW%20API%2C%20not%20existing%20encoders.%0A%20%2A%2F%0Aexport%20function%20preflightOutcome%28plan%2Cvalue%2Climits%2Ctype%3Downed%28%27ParseOutcome%27%29%29%20%7B%0A%20%20for%28const%20key%20of%20%5B%27nodeLimit%27%2C%27depthLimit%27%2C%27byteLimit%27%5D%29%20assert.ok%28Number.isSafeInteger%28limits%5Bkey%5D%29%26%26limits%5Bkey%5D%3E0%2C%27positive%20explicit%20limits%20required%27%29%3B%0A%20%20let%20occurrences%3D0%2CscalarBytes%3D0%2CmaximumDepth%3D0%2Creferences%3D0%3B%0A%20%20const%20add%3D%28left%2Cright%29%3D%3E%7Bassert.ok%28right%3C%3DNumber.MAX_SAFE_INTEGER-left%2C%27resource%20counter%20overflow%27%29%3Breturn%20left%2Bright%3B%7D%3B%0A%20%20for%28const%20event%20of%20outcomeWireEvents%28plan%2Cvalue%2Ctype%2C%7BmaximumFrames%3Alimits.nodeLimit%7D%29%29%20%7B%0A%20%20%20%20if%28%5B%27endArray%27%2C%27endObject%27%2C%27endPair%27%5D.includes%28event.kind%29%29%20continue%3B%0A%20%20%20%20occurrences%3Dadd%28occurrences%2C1%29%3Bassert.ok%28occurrences%3C%3Dlimits.nodeLimit%2C%27expanded%20occurrence%20resource%20limit%27%29%3B%0A%20%20%20%20maximumDepth%3DMath.max%28maximumDepth%2Cevent.depth%29%3Bassert.ok%28event.depth%3C%3Dlimits.depthLimit%2C%27graph%20depth%20resource%20limit%27%29%3B%0A%20%20%20%20let%20bytes%3D0%3B%0A%20%20%20%20if%28event.kind%3D%3D%3D%27string%27%29%20bytes%3DBuffer.byteLength%28event.value%2C%27utf8%27%29%3B%0A%20%20%20%20else%20if%28event.kind%3D%3D%3D%27boolean%27%29%20bytes%3Devent.value%3F4%3A5%3B%0A%20%20%20%20else%20if%28event.kind%3D%3D%3D%27number%27%29%20%7B%0A%20%20%20%20%20%20assert.ok%28Number.isFinite%28event.value%29%2C%27finite%20binary64%20required%27%29%3B%0A%20%20%20%20%20%20%2F%2F%20JS%20itself%20supplies%20its%20Number%20spelling%20for%20this%20private%20control.%20Native%0A%20%20%20%20%20%20%2F%2F%20MUST%20call%20the%20existing%20formatter%2C%20with%20its%20bounded%20scratch%20reservation.%0A%20%20%20%20%20%20bytes%3DBuffer.byteLength%28Object.is%28event.value%2C-0%29%3F%27-0%27%3AString%28event.value%29%29%3B%0A%20%20%20%20%7D%20else%20if%28event.kind%3D%3D%3D%27root%27%29%20bytes%3D1%3B%0A%20%20%20%20scalarBytes%3Dadd%28scalarBytes%2Cbytes%29%3Bassert.ok%28scalarBytes%3C%3Dlimits.byteLimit%2C%27expanded%20scalar%20byte%20resource%20limit%27%29%3B%0A%20%20%20%20references%3Dadd%28references%2Cevent.kind%3D%3D%3D%27pair%27%3F2%3Aevent.kind%3D%3D%3D%27root%27%3F1%3A0%29%3B%0A%20%20%20%20%2F%2F%20Array%20edges%3A%20count%20each%20child%