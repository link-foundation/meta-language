eFunction%3B%0A%20%20assert.ok%28Number.isSafeInteger%28start%29%26%26Number.isSafeInteger%28end%29%26%26start%3E%3D0%26%26end%3Estart%26%26end%3C%3Doriginal.length%29%3B%0A%20%20const%20sourceFunction%3Doriginal.subarray%28start%2Cend%29.toString%28%27utf8%27%29%3Bassert.equal%28sha256%28sourceFunction%29%2Cexpected%29%3B%0A%20%20const%20prefix%3D%27%20%20%20%20%20%20%20%20Value%3A%3ANumber%28number%29%20%3D%3E%20%7B%5Cn%27%2Csuffix%3D%27%5Cn%20%20%20%20%20%20%20%20%7D%27%3B%0A%20%20const%20begin%3DsourceFunction.indexOf%28prefix%29%2Cfinish%3DsourceFunction.indexOf%28%27%5Cn%20%20%20%20%20%20%20%20Value%3A%3AString%28text%29%20%3D%3E%27%2Cbegin%29%3B%0A%20%20assert.ok%28begin%3E%3D0%26%26finish%3Ebegin%26%26sourceFunction.indexOf%28prefix%2Cbegin%2B1%29%3D%3D%3D-1%29%3B%0A%20%20const%20arm%3DsourceFunction.slice%28begin%2Cfinish%29%3Bassert.ok%28arm.endsWith%28suffix%29%29%3B%0A%20%20assert.equal%28sha256%28arm%29%2Creceipt.parent.originalNumberArmSha256%29%3B%0A%20%20const%20lines%3Darm.slice%28prefix.length%2C-suffix.length%29.split%28%27%5Cn%27%29%3B%0A%20%20assert.ok%28lines.every%28line%3D%3Eline%3D%3D%3D%27%27%7C%7Cline.startsWith%28%27%20%20%20%20%20%20%20%20%20%20%20%20%27%29%29%29%3B%0A%20%20const%20body%3Dlines.map%28line%3D%3Eline.slice%2812%29%29.join%28%27%5Cn%27%29%3B%0A%20%20const%20tail%3D%27StructuredDataValue%3A%3ANumber%28value%29%27%3Bassert.ok%28body.endsWith%28tail%29%29%3B%0A%20%20const%20helper%3D%27fn%20exact_json_number%28number%3A%20%26Number%29%20-%3E%20Result%3Cf64%2C%20String%3E%20%7B%5Cn%27%0A%20%20%20%20%2B%28body.slice%280%2C-tail.length%29%2B%27Ok%28value%29%27%29.split%28%27%5Cn%27%29.map%28line%3D%3E%27%20%20%20%20%27%2Bline%29.join%28%27%5Cn%27%29%2B%27%5Cn%7D%5Cn%5Cn%27%3B%0A%20%20assert.equal%28sha256%28helper%29%2Creceipt.parent.helperSha256%29%3B%0A%20%20const%20module%3D%27mod%20grammar_outcome%3B%5Cnpub%20use%20grammar_outcome%3A%3Aencode_grammar_parse_outcome_links%3B%5Cn%5Cn%27%3B%0A%20%20const%20call%3D%27%20%20%20%20%