iliarySources.includes%28path%29%2C%27exact%20build-helper%20source%20closure%27%29%3B%0A%20%20%20%20const%20blob%3DcreateHash%28%27sha1%27%29.update%28%27blob%20%27%2Bbytes.length%2B%27%5C0%27%29.update%28bytes%29.digest%28%27hex%27%29%3Bassert.equal%28blob%2Coid%2C%27unchanged%20pinned%20crate%3A%20%27%2Bpath%29%3B%0A%20%20%20%20assert.ok%28total%3C%3Dpolicy.maximumCrateBytes-bytes.length%2C%27bounded%20total%20crate%20copy%27%29%3Btotal%2B%3Dbytes.length%3B%0A%20%20%20%20return%20%7Bpath%2Cmode%2CgitObject%3Aoid%2Cbytes%3Abytes.length%2Csha256%3Asha256%28bytes%29%2CworkingSha256%2CworkingBytes%7D%3B%0A%20%20%7D%29%3B%0A%20%20assert.ok%28files.some%28file%3D%3Efile.path%3D%3D%3D%27rust%2FCargo.toml%27%29%26%26files.some%28file%3D%3Efile.path%3D%3D%3D%27rust%2FCargo.lock%27%29%29%3B%0A%20%20assert.ok%28policy.auxiliarySources.every%28path%3D%3Efiles.some%28file%3D%3Efile.path%3D%3D%3Dpath%29%29%2C%27every%20declared%20JS%20build-helper%20source%20remains%20tracked%27%29%3B%0A%20%20assert.ok%28%21files.some%28file%3D%3Efile.path%3D%3D%3Dpolicy.child%7C%7Cfile.path%3D%3D%3D%27rust%2Ftests%2F%27%2Bpolicy.testName%2B%27.rs%27%29%2C%27overlay%20additions%20must%20be%20absent%20in%20the%20base%27%29%3B%0A%20%20return%20%7Bfiles%2Cbytes%3Atotal%7D%3B%0A%7D%0A%0Aexport%20async%20function%20createOverlayPlan%28%7Brepository%2CcandidateDirectory%2CprobeDirectory%7D%29%20%7B%0A%20%20repository%3DrealpathSync%28repository%29%3BcandidateDirectory%3DrealpathSync%28candidateDirectory%29%3BprobeDirectory%3DrealpathSync%28probeDirectory%29%3B%0A%20%20assert.equal%28git%28repository%2C%5B%27rev-parse%27%2Cpolicy.baseCommit%2B%27%5E%7Bcommit%7D%27%5D%29.trim%28%29%2Cpolicy.baseCommit%29%3B%0A%20%20%2F%2F%20Future%20commits%20may%20publish%20experiment%20files.%20Core%20source%2Fdependency%20drift%0A%20%20%2F%2F%20is%20authenticated%20by%20predecessor%20pins%3B%20the%20compiled%20full%20crate%20stays%20frozen.%0A%20%20%2F%2F%20Current%20source%20pins%20are%20retained%20separately%20an