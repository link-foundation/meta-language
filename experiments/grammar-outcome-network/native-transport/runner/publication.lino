(185: (meta: (t: semantic) (n: 1) (term: string%20value) (def: PRIVATE%20source-only%20planner.%20No%20Cargo%2Foracle%20invocation%20and%20no%20writes.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BexecFileSync%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7BlstatSync%2CreadFileSync%2CrealpathSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7Bresolve%2Crelative%2Csep%7D%20from%20%27node%3Apath%27%3B%0Aimport%20%7BpathToFileURL%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BoverlayPolicy%20as%20policy%7D%20from%20%27.%2Fpolicy.mjs%27%3B%0A%0Aexport%20const%20sha256%3Dbytes%3D%3EcreateHash%28%27sha256%27%29.update%28bytes%29.digest%28%27hex%27%29%3B%0Aexport%20const%20within%3D%28root%2Cfile%29%3D%3E%7Bconst%20path%3Drelative%28root%2Cfile%29%3Breturn%20path%21%3D%3D%27%27%26%26%21path.startsWith%28%27..%27%2Bsep%29%26%26path%21%3D%3D%27..%27%26%26%21path.startsWith%28sep%29%3B%7D%3B%0Aexport%20function%20git%28repository%2Cargs%29%20%7B%0A%20%20return%20execFileSync%28%27git%27%2C%5B%27-C%27%2Crepository%2C...args%5D%2C%7Bshell%3Afalse%2Cencoding%3A%27utf8%27%2Ctimeout%3A15000%2CmaxBuffer%3A8%2A1024%2A1024%7D%29%3B%0A%7D%0Aexport%20function%20bytesAt%28directory%2Cfile%2Cmaximum%3Dpolicy.maximumFileBytes%29%20%7B%0A%20%20const%20path%3Dresolve%28directory%2Cfile%29%3Bassert.ok%28within%28directory%2Cpath%29%2C%27owned%20input%20path%27%29%3B%0A%20%20const%20stat%3DlstatSync%28path%29%3Bassert.ok%28stat.isFile%28%29%26%26%21stat.isSymbolicLink%28%29%26%26stat.size%3C%3Dmaximum%2C%27bounded%20regular%20input%3A%20%27%2Bfile%29%3B%0A%20%20assert.ok%28within%28directory%2CrealpathSync%28path%29%29%2C%27input%20cannot%20escape%20its%20owner%27%29%3B%0A%20%20return%20readFileSync%28path%29%3B%0A%7D%0A%0A%2F%2A%2A%20Compile%20the%20named%20frozen%20Git%20snapshot%2C%20retaining%20separate%20current-input%0A%20%2A%20pins%20so%20publication%20metadata%20cannot%20silently%20replace%20a