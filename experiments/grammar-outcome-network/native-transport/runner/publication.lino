entEmitter%28%29%3B%0A%20%20%20%20queueMicrotask%28%28%29%3D%3E%7Bchild.stderr.emit%28%27data%27%2CBuffer.alloc%28overlayPolicy.maximumOutputBytes%2B1%2C120%29%29%3Bchild.emit%28%27close%27%2C0%2Cnull%29%3B%7D%29%3B%0A%20%20%20%20return%20child%3B%0A%20%20%7D%3B%0A%20%20const%20result%3Dawait%20runBounded%28%27contract-command%27%2C%5B%5D%2C%7Bcwd%3Adirectory%2Cenvironment%3A%7B%7D%2Ctimeout%3A1000%2Clogs%3Adirectory%2Clabel%3A%27overflow%27%2CspawnProcess%3Afake%7D%29%3B%0A%20%20assert.equal%28result.result.error%2C%27stderr%20output%20limit%27%29%3B%0A%20%20assert.equal%28result.result.stderrBytes%2CoverlayPolicy.maximumOutputBytes%2B1%29%3B%0A%20%20assert.equal%28result.stderr.length%2CoverlayPolicy.maximumOutputBytes%29%3B%0A%20%20assert.equal%28result.result.streams.stderr.truncated%2Ctrue%29%3B%0A%20%20assert.equal%28result.result.processMode%2C%27injected%20process%20contract%27%29%3B%0A%7D%29%3B%0A%0Atest%28%27an%20alternate%20probe%20directory%20cannot%20substitute%20an%20unqualified%20oracle%20or%20native%20source%27%2Casync%28%29%3D%3E%7B%0A%20%20const%20directory%3DmkdtempSync%28join%28tmpdir%28%29%2C%27meta-language-b95-probe-source-contract-%27%29%29%3B%0A%20%20const%20files%3D%5B%27oracle.mjs%27%2C%27native-outcome-probe.rs%27%5D%3B%0A%20%20for%28const%20file%20of%20files%29copyFileSync%28new%20URL%28%27..%2Fprobe%2F%27%2Bfile%2Cimport.meta.url%29%2Cjoin%28directory%2Cfile%29%29%3B%0A%20%20for%28const%20file%20of%20files%29%20%7B%0A%20%20%20%20const%20path%3Djoin%28directory%2Cfile%29%2Cbytes%3DreadFileSync%28path%29%3B%0A%20%20%20%20writeFileSync%28path%2CBuffer.concat%28%5Bbytes%2CBuffer.from%28%27%5Cn%27%29%5D%29%29%3B%0A%20%20%20%20await%20assert.rejects%28%28%29%3D%3EcreateOverlayPlan%28%7BprobeDirectory%3Adirectory%7D%29%2C%2Fselected%20actual%20probe%20source%2Fu%29%3B%0A%20%20%20%20writeFileSync%28path%2Cbytes%29%3B%0A%20%20%7D) (lang: meta-language%20structured%20data)))
