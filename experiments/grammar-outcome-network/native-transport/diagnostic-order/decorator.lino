(56: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Generic%20grammar%20selection%20over%20an%20explicitly%20matched%20byte%20region.%20The%0A%2F%2F%20existing%20executor%20still%20owns%20grammar%20matching%2C%20recovery%20and%20all%20budgets.%0Aimport%20%7B%20acceptGrammarSelectionCount%2C%20acceptGrammarSelectionMapping%2C%0A%20%20acceptGrammarSelectionMode%2C%20reportGrammarSelectionAmbiguity%2C%0A%20%20readGrammarSourceDefaultMatching%20%7D%20from%20%27..%2Ftranslation%2Fgrammar-selection-rules.js%27%3B%0Aimport%20%7B%20DEFAULT_SETTLING%2C%20checkGrammarSelectionIncludedRangeForm%20%7D%20from%20%27..%2Fgrammar-feature-forms.js%27%3B%0Aimport%20%7B%20readGrammarSelectionMappingContext%20%7D%20from%20%27..%2Ftranslation%2Fgrammar-selection-mapping-rules.js%27%3B%0Aimport%20%7B%20acceptGrammarSelectionIncludedRangeCandidate%2C%0A%20%20acceptGrammarSelectionIncludedRangeAgreement%2C%20readGrammarSelectionIncludedRangeContext%20%7D%20from%20%27..%2Ftranslation%2Fgrammar-selection-included-range-rules.js%27%3B%0Aimport%20%7B%20acceptGrammarSelectionFieldRangeCandidate%2C%0A%20%20readGrammarSelectionFieldRangeContext%20%7D%20from%20%27..%2Ftranslation%2Fgrammar-selection-field-range-rules.js%27%3B%0Aimport%20%7B%20mapGrammarSelectionSource%2C%20mapGrammarSelectionIncludedRangeSource%2C%20mapGrammarSelectionFieldRangeSource%2C%20projectGrammarSelectionSpan%2C%0A%20%20projectGrammarSelectionDiagnostic%2C%20rememberGrammarSelectionMappingFailure%20%7D%20from%20%27.%2Fselection-source-mapping.js%27%3B%0Aimport%20%7B%20KeywordLexing%20%7D%20from%20%27.%2Fexecutor.js%27%3B%0A%0A%2F%2A%2A%20Validate%20the%20inspectable%20candidates%20without%20resolving%20unknown%20grammars.%20%2A%2F%0Aexport%20function%20checkGrammarSelection%28expression%2C%20fail%29%20%7B%0A%20%20if%20%28%21acceptGrammarSelectionMode%28expression.kind%29%29%20return%3B%0A%20%20if%20%28%21Array.isArray%28expression.items%29%20%7C%7C%20expression.items.length%20%3D%3D%3D%200%29%20fail%28%27a%20grammar%20selection%20needs%20at%20least%20one%20candidate%27%29%3B%0A%20%20const%20names%20%3D%20new%20Set%28%29%3B%0A%20%20for%20%28const%20candidate%20of%20expression.items%29%20%7B%0A%20%20%20%20const%20ranged%20%3D%20checkGrammarSelectionIncludedRangeForm%28candidate%2C%20fail%29%3B%0A%20%20%20%20if%20%28candidate%3F.kind%20%21%3D%3D%20%27grammar-candidate%27%20%26%26%20%21ranged%20%7C%7C%20typeof%20candidate.name%20%21%3D%3D%20%27string%27%20%7C%7C%20candidate.name%20%3D%3D%3D%20%27%27%20%7C%7C%20typeof%20candidate.mapping%20%21%3D%3D%20%27string%27%29%20fail%28%27a%20grammar%20selection%20needs%20named%20grammar-candidate%20definitions%20and%20an%20explicit%20mapping%27%29%3B%0A%20%20%20%20if%20%28names.has%28candidate.name%29%29%20fail%28%60duplicate%20selected%20grammar%20%24%7Bcandidate.name%7D%60%29%3B%0A%20%20%20%20names.add%28candidate.name%29%3B%0A%20%20%7D%0A%7D%0A%0Afunction%20reportSelectionDiagnostic%28executor%2C%20diagnostic%29%20%7B%0A%20%20diagnostic%20%3D%20projectGrammarSelectionDiagnostic%28executor%2C%20diagnostic%29%3B%0A%20%20const%20diagnostics%20%3D%20executor.budget.memory.selectionDiagnostics%20%3F%3F%3D%20%5B%5D%3B%0A%20%20if%20%28%21diagnostics.some%28item%20%3D%3E%20item.reason%20%3D%3D%3D%20diagnostic.reason%20%26%26%20item.language%20%3D%3D%3D%20diagnostic.language%20%26%26%20item.start%20%3D%3D%3D%20diagnostic.start%20%26%26%20item.end%20%3D%3D%3D%20diagnostic.end%20%26%26%20item.source%20%3D%3D%3D%20diagnostic.source%29%29%20%7B%0A%20%20%20%20executor.retain%281%29%3B%0A%20%20%20%20diagnostics.push%28diagnostic%29%3B%0A%20%20%7D%0A%7D%0A%0A%2F%2A%2A%20Run%20an%20existing%20program%20with%20shared%20budgets%20and%20a%20same-region%20cycle%20guard.%20%2A%2F%0Aexport%20function%20runEmbeddedGrammar%28executor%2C%20program%2C%20start%2C%20end%2C%20language%2C%20Executor%2C%20bytes%20%3D%20executor.bytes%29%20%7B%0A%20%20const%20active%20%3D%20executor.budget.activeEmbeddedGrammars%20%3F%3F%3D%20new%20Map%28%29%3B%0A%20%20const