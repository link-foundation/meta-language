26%20entry.file.startsWith%28directory%29%29%0A%20%20%20%20.map%28%28%7B%20file%20%7D%29%20%3D%3E%20file%29%3B%0A%7D%0A%0A%2F%2A%2A%20Counts%20of%20test%20outcomes%2C%20as%20the%20runner%20writes%20them.%20%2A%2F%0Aexport%20function%20countOutcomes%28tests%29%20%7B%0A%20%20const%20count%20%3D%20%28outcome%29%20%3D%3E%20tests.filter%28%28entry%29%20%3D%3E%20entry.outcome%20%3D%3D%3D%20outcome%29.length%3B%0A%20%20return%20%7B%20passed%3A%20count%28%27passed%27%29%2C%20failed%3A%20count%28%27failed%27%29%2C%20skipped%3A%20count%28%27skipped%27%29%2C%20total%3A%20tests.length%20%7D%3B%0A%7D%0A%0A%2F%2A%2A%20formal-ai%27s%20committed%20census%20of%20its%20own%20sources%20as%20meta-language%20parses%20them.%20%2A%2F%0Aexport%20const%20SELF_AST_CENSUS_DIRECTORY%20%3D%20%27data%2Fmeta%2Fself-ast%27%3B%0A%2F%2A%2A%20formal-ai%27s%20example%20that%20rewrites%20the%20census%20documents%20whose%20rendering%20changed.%20%2A%2F%0Aexport%20const%20SELF_AST_CENSUS_EXAMPLE%20%3D%20%27regenerate_self_ast_census%27%3B%0A%2F%2F%20The%20census%20line%20that%20counts%20every%20link%20of%20the%20lossless%20network.%20It%20is%20the%0A%2F%2F%20only%20census%20field%20outside%20the%20abstract-syntax%20projection%2C%20the%20symbol%20scan%0A%2F%2F%20and%20the%20source%20itself.%0Aconst%20LINK_TOTAL_LINE%20%3D%20%2F%5E%20%7B4%7Dtotal_link_count%20%28%5Cd%2B%29%24%2Fu%3B%0A%0A%2F%2A%2A%0A%20%2A%20Compares%20formal-ai%27s%20census%20documents%20before%20and%20after%20its%20own%20regeneration%0A%20%2A%20with%20a%20candidate%20meta-language%20%28two%20maps%20of%20relative%20path%20to%20document%20text%29.%0A%20%2A%0A%20%2A%20A%20candidate%20that%20adds%20links%20to%20the%20lossless%20network%2C%20such%20as%20a%20grammar%0A%20%2A%20provenance%20link%20or%20hidden-text%20tokens%2C%20changes%20%60total_link_count%60%20and%20nothing%0A%20%2A%20else.%20%60linkTotals%60%20lists%20those%20changes%3B%20%60otherChanges%60%20lists%20every%20other%0A%20%2A%20changed%20line%20and%20every%20added%20or%20removed%20document%2C%20so%20a%20candidate%20that%0A%20%2A%20changes%20a%20named%20node%2C%20a%20node%20kind%2C%20the%20text%20preservation%20or%20the%20clean%0A%20%2A%20verification%20of%20any%20formal-ai%20source%20is%20reported.%0A%20%2A%2F%0Aexport%20function%20compareSelfAstCensus%28before%2C%20after%29%20%7B%0A%20%20const%20linkTotals%20%3D%20%5B%5D%3B%0A%20%20const%20otherChanges%20%3D%20%5B%5D%3B%0A%20%20for%20%28const%20file%20of%20%5B...new%20Set%28%5B...before.keys%28%29%2C%20...after.keys%28%29%5D%29%5D.sort%28%29%29%20%7B%0A%20%20%20%20if%20%28%21before.has%28file%29%20%7C%7C%20%21after.has%28file%29%29%20%7B%0A%20%20%20%20%20%20otherChanges.push%28%7B%20file%2C%20line%3A%20null%2C%20before%3A%20before.has%28file%29%20%3F%20%27present%27%20%3A%20%27absent%27%2C%20after%3A%20after.has%28file%29%20%3F%20%27present%27%20%3A%20%27absent%27%20%7D%29%3B%0A%20%20%20%20%20%20continue%3B%0A%20%20%20%20%7D%0A%20%20%20%20const%20previous%20%3D%20before.get%28file%29.split%28%27%5Cn%27%29%3B%0A%20%20%20%20const%20current%20%3D%20after.get%28file%29.split%28%27%5Cn%27%29%3B%0A%20%20%20%20for%20%28let%20index%20%3D%200%3B%20index%20%3C%20Math.max%28previous.length%2C%20current.length%29%3B%20index%20%2B%3D%201%29%20%7B%0A%20%20%20%20%20%20if%20%28previous%5Bindex%5D%20%3D%3D%3D%20current%5Bindex%5D%29%20continue%3B%0A%20%20%20%20%20%20const%20previousTotal%20%3D%20LINK_TOTAL_LINE.exec%28previous%5Bindex%5D%20%3F%3F%20%27%27%29%3B%0A%20%20%20%20%20%20const%20currentTotal%20%3D%20LINK_TOTAL_LINE.exec%28current%5Bindex%5D%20%3F%3F%20%27%27%29%3B%0A%20%20%20%20%20%20if%20%28previousTotal%20%26%26%20currentTotal%29%20%7B%0A%20%20%20%20%20%20%20%20linkTotals.push%28%7B%20file%2C%20before%3A%20Number%28previousTotal%5B1%5D%29%2C%20after%3A%20Number%28currentTotal%5B1%5D%29%20%7D%29%3B%0A%20%20%20%20%20%20%7D%20else%20%7B%0A%20%20%20%20%20%20%20%20otherChanges.push%28%7B%20file%2C%20line%3A%20index%20%2B%201%2C%20before%3A%20previous%5Bindex%5D%20%3F%3F%20null%2C%20after%3A%20curr