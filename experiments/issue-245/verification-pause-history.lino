(9733: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Historical%20assertions%20retain%20their%20complete%20original%20inventory%3B%20current%0A%2F%2F%20declarations%20are%20checked%20independently%20before%20selecting%20that%20source%20view.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BreadFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7BfileURLToPath%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7BreadProjectData%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7BstructuredDataToLino%2CreadStructuredDataLino%7D%20from%20%27..%2Fsrc%2Fstructured-data-links.js%27%3B%0Aimport%20%7BverifyGitArtifactCertificate%7D%20from%20%27.%2Fgit-object-certificate.mjs%27%3B%0Aimport%20%7BcheckInventory%2CcollectDependencies%7D%20from%20%27.%2Fdependency-inventory.mjs%27%3B%0Aimport%20%7BrestoreDependencyDeclaration%7D%20from%20%27.%2Fdependency-inventory-order.mjs%27%3B%0Aimport%20%7BrestoreOwnCodebaseTestRegistrationTestSource%7D%20from%20%27.%2Fown-codebase-test-registration-history.mjs%27%3B%0A%0Aconst%20file%3Dnew%20URL%28%27..%2F..%2Fparity%2Ffixtures%2Fdependency-inventory-append-history.lino%27%2Cimport.meta.url%29%3B%0Aconst%20inventoryRevision%3D%279ac3038132953e6a220bba6f06a3e6147d39836f%27%3B%0Aconst%20testRevision%3D%27e4d60c822135ac3e4dc55d9141dabd30faf1e94a%27%3B%0Aconst%20digest%3Dvalue%3D%3EcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0Aconst%20policyHash%3D%27ae8dbb57e3f2d2df38c2e97765bf01ca58e358c0a1aab65681b2f82c5d3a23dc%27%3B%0A%0Aexport%20function%20readDependencyInventoryAppendHistory%28%29%20%7B%0A%20%20const%20bytes%3DreadFileSync%28file%29%3Bassert.equal%28digest%28bytes%29%2CpolicyHash%29%3B%0A%20%20return%20readProjectData%28file%29%3B%0A%7D%0A%0Aexport%20function%20restoreNodeDependencyInventoryTestSource%28source%29%20%7B%0A%20%20const%20history%3DreadDependencyInventoryAppendHistory%28%29%3B%0A%20%20const%20original%3Dhistory.test.source%3B%0A%20%20let%20current%3Doriginal%3B%0A%20%20for%28const%20edit%20of%20history.edits%29%7Bassert.equal%28current.split%28edit.before%29.length%2C2%29%3Bcurrent%3Dcurrent.replace%28edit.before%2C%28%29%3D%3Eedit.after%29%3B%7D%0A%20%20if%28source%21%3D%3Doriginal%26%26source%21%3D%3Dcurrent%29source%3DrestoreOwnCodebaseTestRegistrationTestSource%28source%29%3B%0A%20%20assert.ok%28source%3D%3D%3Doriginal%7C%7Csource%3D%3D%3Dcurrent%2C%27only%20the%20complete%20original%20or%20reviewed%20inventory%20test%20source%20is%20admitted%27%29%3B%0A%20%20return%20original%3B%0A%7D%0A%0A%2F%2A%2A%20Check%20every%20current%20declaration%20and%20every%20old%20byte%20before%20removing%20appends.%20%2A%2F%0Aexport%20function%20verifyDependencyInventoryAppends%28inventory%2Cdeclarations%2Chistory%29%20%7B%0A%20%20%2F%2F%20Impossible%20current%20inventories%20cannot%20select%20a%20historical%20view.%20Reject%0A%20%20%2F%2F%20them%20before%20decoding%20its%20complete%20certificate%2Fsource%20packet%3B%20successful%0A%20%20%2F%2F%20inputs%20still%20run%20every%20original%20historical%20authentication%20below.%0A%20%20assert.deepEqual%28checkInventory%28inventory%2Cdeclarations%29%2C%5B%5D%2C%27the%20actual%20complete%20current%20declaration%20corpus%20stays%20checked%27%29%3B%0A%20%20if%28history%3D%3D%3Dundefined%29history%3DreadDependencyInventoryAppendHistory%28%29%3B%0A%20%20assert.equal%28digest%28structuredDataToLino%28history%29%29%2CpolicyHash%29%3B%0A%20%20for%28const%20%5Bcapture%2Crevision%2Cpath%5Dof%20%5B%5Bhistory.inventory%2CinventoryRevision%2C%27parity%2Fdependency-inventory.lino%27%5D%2C%0A%20%20%20%20%5Bhistory.test%2CtestRevision%2C%27js%2Ftests%2Fissue-195-evidence-node-dependency.test.js%27%5D%5D%29%7B%0A%20%20%20%20verifyGitArtifactCertificate%28capture.certificate%2CBuffer.from%28capture.source%29%2C%7Brevision%2Cpath%7D%29%3B%0A%20%20%7D%0A%20%20const%20before%3DreadStructuredDataLino%28history.inventory.source%29%3B%0A%20%20assert.equal%28before.items.length%2C745%29%3B%0A%20%20assert.ok%28inventory.items.length%3E%3Dbefore.items.length%29%3B%0A%20%20const%20prefix%3D%7B...inventory%2Citems%3Ainventory.items.slice%280%2Cbefore.items.length%29.map%28%28row%2Cindex%29%3D%3ErestoreDependencyDeclaration%28row%2Cbefore.items%5Bindex%5D%29%29%7D%3B%0A%20%20assert.equal%28structuredDataToLino%28prefix%29%2Chistory.inventory.source%2C%27every%20complete%20original%20item%2C%20audit%20fact%2C%20order%20and%20alias%20stays%20exact%27%29%3B%0A%20%20const%20ids%3Dnew%20Set%28prefix.items.map%28row%3D%3Erow.id%29%29%3B%0A%20%20for%28const%20entry%20of%20inventory.items.slice%28before.items.length%29%29%7B%0A%20%20%20%20assert.equal%28ids.has%28entry.id%29%2Cfalse%2C%27appends%20cannot%20replace%20or%20repeat%20an%20original%20identity%27%29%3Bids.add%28entry.id%29%3B%0A%20%20%20%20assert.ok%28declarations.some%28row%3D%3Erow.id%3D%3D%3Dentry.id%29%2C%27each%20appended%20entry%20has%20an%20actual%20current%20declaration%27%29%3B%0A%20%20%7D%0A%20%20return%20prefix%3B%0A%7D%0A%0Aexport%20function%20readNodeDependencyInventoryOriginalView%28%29%20%7B%0A%20%20const%20root%3DfileURLToPath%28new%20URL%28%27..%2F..%2F%27%2Cimport.meta.url%29%29%3B%0A%20%20return%20verifyDependencyInventoryAppends%28readProjectData%28new%20URL%28%27..%2F..%2Fparity%2Fdependency-inventory.lino%27%2Cimport.meta.url%29%29%2CcollectDependencies%28root%29%29%3B%0A%7D%0A%0A%2F%2A%2A%20Keep%20the%20old%20source-placement%20meaning%20while%20current%20definitions%20stay%20separate.%20%2A%2F%0Aexport%20function%20restoreNodeDependencyInventoryNamingEntry%28entry%29%20%7B%0A%20%20const%20path%3D%27js%2Ftests%2Fissue-195-evidence-node-dependency.test.js%27%3B%0A%20%20if%28entry.inventory%21%3D%3D%27B70%20physical%20field%20source%20view%20names%20for%20js%2Ftests%2Fdependency-inventory-node-runtime.test.js%27%0A%20%20%20%20%7C%7Centry.files.length%21%3D%3D1%7C%7Centry.files%5B0%5D%21%3D%3Dpath%29return%20entry%3B%0A%20%20return%7B...entry%2Cextract%3A%28source%2Cfile%29%3D%3Eentry.extract%28restoreNodeDependencyInventoryTestSource%28source%29%2Cfile%29%7D%3B%0A%7D%0A) (lang: meta-language%20structured%20data)))
