(9777: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20The%20link-assistant%2Fformal-ai%20workloads%20run%20against%20the%20clean%20installed%0A%2F%2F%20meta-language%20artifacts%20%28requirement%20I195-DOWNSTREAM-FORMAL-AI-WORKLOADS%29.%0A%2F%2F%20js%2Fscripts%2Frun-formal-ai-workloads.mjs%20checks%20out%20the%20pinned%20revision%20of%0A%2F%2F%20parity%2Ffixtures%2Fformal-ai-workloads.json%20and%20verifies%20every%20inventoried%20blob.%0A%2F%2F%20The%20Rust%20side%20patches%20formal-ai%27s%20rust%2F%20to%20the%20unpacked%20crate%20and%20runs%0A%2F%2F%20formal-ai%27s%20own%20meta-language%20test%20groups%20plus%20the%20probe%20of%0A%2F%2F%20js%2Fscripts%2Fissue-195-formal-ai-rust-probe.mjs.%20formal-ai%27s%20npm%20package%20has%20no%0A%2F%2F%20meta-language%20dependency%2C%20so%20the%20JavaScript%20side%20installs%20the%20npm%20tarball%0A%2F%2F%20into%20a%20clean%20consumer%20and%20runs%20formal-ai%27s%20LiNo%20data%20through%20the%20public%20API%0A%2F%2F%20%28js%2Fscripts%2Fissue-195-formal-ai-workload-probes.mjs%29.%20Both%20runtimes%20write%20the%0A%2F%2F%20same%20outputs%2C%20and%20sharedConceptsReused%20holds%20only%20when%20they%20agree.%0A%2F%2F%20%60validateFormalAiWorkloadReport%60%20is%20the%20pure%20check%20of%20the%20runner%27s%20report%20for%0A%2F%2F%20one%20runtime%2C%20shared%20by%20the%20runner%20and%20the%20tests%3B%20the%20Rust%20suite%20ports%20it.%0Aimport%20path%20from%20%27node%3Apath%27%3B%0Aimport%20%7B%20fileURLToPath%20%7D%20from%20%27node%3Aurl%27%3B%0Aimport%20%7B%20readProjectData%20%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0A%0Aexport%20const%20FORMAL_AI_WORKLOAD_REQUIREMENT%20%3D%20%27I195-DOWNSTREAM-FORMAL-AI-WORKLOADS%27%3B%0Aexport%20const%20FORMAL_AI_WORKLOAD_FIXTURE_ID%20%3D%20%27planned%3Arepository-directive%3Ai195-downstream-formal-ai-workloads%27%3B%0Aexport%20const%20FORMAL_AI_WORKLOAD_FIXTURE%20%3D%20%27parity%2Ffixtures%2Fformal-ai-workloads.json%27%3B%0Aexport%20const%20FORMAL_AI_WORKLOAD_REPORT_VARIABLE