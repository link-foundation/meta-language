ContributorInstructionUnits%28agents%29%3B%0A%20%20assert.equal%28original.units.length%2C28%29%3Bassert.equal%28reviewed.units.length%2C20%29%3B%0A%20%20assert.equal%28policy.coverage.length%2Coriginal.units.length%29%3B%0A%20%20assert.equal%28policy.currentUnits.length%2Creviewed.units.length%29%3B%0A%20%20assert.deepEqual%28actual.headings%2Creviewed.headings%2C%27the%20reviewed%20contract%20and%20local-resource%20contexts%20remain%20authoritative%27%29%3B%0A%20%20assert.equal%28actual.units.length%2Creviewed.units.length%2C%27no%20competing%20instruction%20block%20is%20added%20or%20omitted%27%29%3B%0A%20%20const%20currentIds%3Dnew%20Set%28%29%2Ccovered%3Dnew%20Set%28%29%3B%0A%20%20for%28const%20%5Bindex%2Cunit%5Dof%20policy.currentUnits.entries%28%29%29%7B%0A%20%20%20%20assert.equal%28currentIds.has%28unit.id%29%2Cfalse%29%3BcurrentIds.add%28unit.id%29%3B%0A%20%20%20%20assert.deepEqual%28unit.source%2Creviewed.units%5Bindex%5D%29%3B%0A%20%20%20%20assert.equal%28actual.units.filter%28value%3D%3Evalue.kind%3D%3D%3Dunit.source.kind%26%26value.section%3D%3D%3Dunit.source.section%0A%20%20%20%20%20%20%26%26normalize%28value.text%29%3D%3D%3Dnormalize%28unit.source.text%29%29.length%2C1%2C%27every%20complete%20reviewed%20instruction%20remains%3A%20%27%2Bunit.id%29%3B%0A%20%20%7D%0A%20%20for%28const%20%5Bindex%2Crow%5Dof%20policy.coverage.entries%28%29%29%7B%0A%20%20%20%20assert.equal%28row.originalIndex%2Cindex%29%3Bassert.deepEqual%28row.source%2Coriginal.units%5Bindex%5D%29%3B%0A%20%20%20%20assert.ok%28row.coveredBy.length%3E0%29%3B%0A%20%20%20%20for%28const%20id%20of%20row.coveredBy%29%7Bassert.ok%28currentIds.has%28id%29%29%3Bcovered.add%28id%29%3B%7D%0A%20%20%20%20if%28row.authorizedCorrection%21%3D%3Dundefined%29assert.equal%28row.authorizedCorrection%2CrequestHash%29%3B%0A%20%20%7D%0A%20%20for%28const%20addition%20of%20policy.additions%29%7Bassert.ok%28currentIds.has%28addition.unit%29%29%3Bassert.equal%28addition.authority%2Cpolicy.versionRequest.sha256%29%3Bcovered.add%28addition.unit%29%3B%7D%0A%20%20assert.deepEqual%28%5B...covered%5D.sort%28%29%2C%5B...currentIds%5D.sort%28%29%2C%27every%20current%20rule%20has%20an%20explicit%20original%20or%20newly%20requested%20source%27%29%3B%0A%20%20assert.equal%28normalize%28claude%29%2Cnormalize%28policy.sources.sharedReference.text%29%2C%27the%20single%20reference%20preserves%20one%20authoritative%20contributor%20contract%27%29%3B%0A%20%20assert.equal%28normalize%28claude%29%2C%27Follow%20%5BAGENTS.md%5D%28AGENTS.md%29%20for%20all%20repository%20instructions.%27%29%3B%0A%20%20const%20words%3D%7Boriginal%3AcountContributorInstructionWords%28policy.sources.originalAgents.text%29%2C%0A%20%20%20%20agents%3AcountContributorInstructionWords%28agents%29%2Cclaude%3AcountContributorInstructionWords%28claude%29%7D%3B%0A%20%20assert.ok%28words.agents%3C%3DcountContributorInstructionWords%28policy.sources.compactAgents.text%29%29%3B%0A%20%20assert.ok%28words.claude%3C%3DcountContributorInstructionWords%28policy.sources.sharedReference.text%29%29%3B%0A%20%20assert.ok%28words.agents%2Bwords.claude%3Cwords.original%2C%27the%20whole%20combined%20contract%20is%20shorter%20than%20the%20actual%20preceding%20single%20file%27%29%3B%0A%20%20return%7Bwords%2CoriginalUnits%3Aoriginal.units.length%2CreviewedUnits%3Areviewed.units.length%2CcoveredOriginalUnits%3Apolicy.coverage.length%2CreferenceTarget%3A%27AGENTS.md%27%7D%3B%0A%7D%0A%0Aexport%20function%20checkContributorInstructionCoverage%28%29%20%7B%0A%20%20return%20verifyContributorInstructionCoverage%28%7Bagents%3AreadFileSync%28new%20URL%28%27AGENTS.md%27%2Croot%29%2C%27utf8%27%29%2C%0A%20%20%20%20claude%3AreadFileSync%28new%20URL%28%27CLAUDE.md%27%2Croot%29%2C%27utf8%27%29%2C%0A%20%20%20%20request%3AreadFileSync%28new%20URL%28%27parity%2Fsources%2Fcompact-contributor-instructions-and-assertion-corrections-2026-10-16.txt%27%2Croot%29%2C%27utf8%27%29%2C%0A%20%20%20%20versionRequest%3AreadFileSync%28new%20URL%28%27parity%2Fsources%2Fversion-bounded-