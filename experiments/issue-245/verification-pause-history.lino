%3D%3Estep.text.split%28%27%20%20%20%20%20%20%20%20with%3A%5Cn%27%29%5B1%5D.replace%28%27%20%20%20%20%20%20%20%20%20%20overwrite%3A%20true%5Cn%27%2C%27%27%29%3B%0A%20%20assert.equal%28artifact%28first%29%2Cartifact%28retry%29%29%3B%0A%20%20for%28const%20step%20of%20%5Bfirst%2Cretry%5D%29assert.match%28step.text%2C%2Fif-no-files-found%3A%20error%2Fu%29%3B%0A%20%20assert.notEqual%28removePartitionUploadRetry%28source%29%2Csource%29%3B%0A%7D%29%3B%0A) (lang: meta-language%20structured%20data)))
