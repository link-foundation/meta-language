(9755: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20The%20dependency%20inventory%20of%20docs%2Fvision.md%23dependencies%3A%20every%20retained%0A%2F%2F%20runtime%2C%20development%2C%20build%20and%20optional%20dependency%2C%20lockfile%20resolution%2C%0A%2F%2F%20downloaded%20grammar%20asset%2C%20generator%2C%20toolchain%2C%20workflow%20action%2C%20build%20image%0A%2F%2F%20and%20published%20artifact%20entry%2C%20each%20with%20its%20current%20stable%20release%20on%20the%0A%2F%2F%20recorded%20audit%20date%20%28requirement%20I195-DEPENDENCY-INVENTORY%29.%0A%2F%2F%0A%2F%2F%20collectDependencies%28%29%20reads%20the%20pins%20from%20the%20repository%20offline.%0A%2F%2F%20parity%2Fdependency-inventory.json%20stores%20them%20with%20the%20current%20stable%20release%0A%2F%2F%20and%2C%20for%20an%20item%20that%20is%20behind%20it%2C%20the%20recorded%20compatibility%20reason%3B%0A%2F%2F%20refreshInventory%28%29%20queries%20the%20registries%20to%20rewrite%20it%2C%20and%0A%2F%2F%20checkInventory%28%29%20fails%20when%20the%20stored%20inventory%20no%20longer%20matches%20the%0A%2F%2F%20repository%20or%20when%20a%20retained%20item%20is%20behind%20without%20a%20reason.%0A%2F%2F%20docs%2Fdependency-audit.md%20is%20rendered%20from%20the%20inventory.%0Aimport%20%7B%20existsSync%2C%20readdirSync%2C%20readFileSync%20%7D%20from%20%27node%3Afs%27%3B%0Aimport%20path%20from%20%27node%3Apath%27%3B%0A%0Aimport%20%7B%20compareVersions%2C%20isPrerelease%2C%20newestStable%2C%20satisfies%2C%20versionParts%20%7D%20from%20%27.%2Fsemver-range.mjs%27%3B%0Aimport%20%7B%20grammarFile%20%7D%20from%20%27.%2Fgrammar-files.mjs%27%3B%0Aimport%20%7B%20readProjectData%2C%20resolveProjectDataPath%20%7D%20from%20%27.%2Fproject-data.mjs%27%3B%0Aimport%20%7B%20collectGrammarAssetDependencies%2C%20relocatedGrammarDependency%20%7D%20from%20%27.%2Fdependency-grammar-assets.mjs%27%3B%0A%0Aexport%20const%20INVENTORY_FILE%20%3D%20%27parity%2Fdependency-inventory.json%27%3B%0Aexport%20const%20AUDIT_DOCUMENT%2