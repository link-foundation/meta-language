(38431: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20Linked%20operational%20definitions%20and%20closed%20equivalence%20certificates.%0A%2F%2F%21%20Primitive%20declarations%20are%20shared%20data.%20Equality%20decisions%20reuse%20the%0A%2F%2F%21%20verifier%20automatically%20translated%20from%20JavaScript%3B%20this%20adapter%20preserves%0A%2F%2F%21%20network%20identities%2C%20ordered%20references%20and%20labeled%20relations.%0A%0Ause%20std%3A%3Acollections%3A%3ABTreeSet%3B%0Ause%20std%3A%3Async%3A%3AOnceLock%3B%0A%0Ause%20serde_json%3A%3A%7BValue%2C%20json%7D%3B%0A%0Ause%20crate%3A%3Alink_network%3A%3A%7BLinkId%2C%20LinkMetadata%2C%20LinkNetwork%2C%20LinkType%7D%3B%0Ause%20crate%3A%3Ashared_numeric_function_model%3A%3A%7B%0A%20%20%20%20BOOLEAN_FUNCTION_DECLARATION_VALUE_MODEL%2C%20SHARED_BOOLEAN_FUNCTION_MODEL%2C%0A%20%20%20%20SHARED_NUMERIC_FUNCTION_MODEL%2C%20create_shared_numeric_function_meaning%2C%0A%20%20%20%20read_boolean_function_declaration_value_model%2C%20read_shared_boolean_function_model%2C%0A%20%20%20%20read_shared_numeric_function_model%2C%0A%7D%3B%0Ause%20crate%3A%3Atranslation%3A%3Aboolean_declaration_value_rules%3A%3Aaccept_boolean_declaration_value_selector%3B%0Ause%20crate%3A%3Atranslation%3A%3Air%3A%3AProgram%3B%0Ause%20crate%3A%3Atyped_program_links%3A%3A%7B%0A%20%20%20%20emit_typed_program_links%2C%20encode_typed_program_links_with_provenance%2C%0A%20%20%20%20read_typed_program_binding_identities%2C%0A%7D%3B%0A%0Amod%20graph%3B%0Amod%20relation_rules%3B%0Ause%20graph%3A%3A%7B%0A%20%20%20%20Graph%2C%20correspondence%2C%20data%2C%20exclude_binding_names%2C%20fields%2C%20graph%2C%20snapshot%2C%20verify_pairs%2C%0A%7D%3B%0A%0Aconst%20LANGUAGE%3A%20%26str%20%3D%20%22meta-language%20formal%20definition%22%3B%0Aconst%20SCHEMA%3A%20%26str%20%3D%20%221%22%3B%0Aconst%20ROOT%3A%20%26str%20%3D%20%22formal%20concept%20definition%22%3B%0Aconst%20CERTIFICATE%3A%20%26str%20%3D%20%22formal%20equivalence%20certificate%22%3B%0Aconst%20PAIRS%