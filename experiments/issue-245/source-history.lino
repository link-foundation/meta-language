(10046: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%21%20Lark%20grammar%20emitter.%0A%0Ause%20std%3A%3Acollections%3A%3ABTreeSet%3B%0Ause%20std%3A%3Afmt%3A%3AWrite%20as%20_%3B%0A%0Ause%20super%3A%3Astructural%3A%3A%7B%0A%20%20%20%20NamePlan%2C%20Precedence%2C%20Rendered%2C%20check_repeat_bounds%2C%20collect_references%2C%20doc_lines%2C%0A%20%20%20%20join_choice%2C%20join_sequence%2C%20negated_lookahead_set%2C%20snake_case%2C%20wrap%2C%0A%7D%3B%0Ause%20super%3A%3A%7BEmitReport%2C%20GrammarEmitError%2C%20finish_lines%2C%20unsupported_error%7D%3B%0Ause%20crate%3A%3Agrammar%3A%3A%7B%0A%20%20%20%20CharClassItem%2C%20Grammar%2C%20GrammarExpr%2C%20GrammarFormat%2C%20GrammarRule%2C%20RuleKind%2C%20import_lark%2C%0A%7D%3B%0A%0Aconst%20FORMAT%3A%20GrammarFormat%20%3D%20GrammarFormat%3A%3ALark%3B%0Aconst%20LABEL%3A%20%26str%20%3D%20%22Lark%22%3B%0A%0A%2F%2F%2F%20Documentation%20%60import_lark%60%20attaches%20to%20rules%20created%20from%20%60%25ignore%60.%0Aconst%20IGNORE_DOC%3A%20%26str%20%3D%20%22%25ignore%22%3B%0A%0A%2F%2F%2F%20Emits%20a%20Lark%20grammar.%0A%2F%2F%2F%0A%2F%2F%2F%20Normal%20rules%20become%20lower-case%20Lark%20rules%2C%20silent%20rules%20become%20inlined%0A%2F%2F%2F%20%60%3Frule%60s%2C%20and%20token%20and%20atomic%20rules%20become%20upper-case%20terminals.%20Rule%0A%2F%2F%2F%20names%20are%20adjusted%20deterministically%20to%20Lark%27s%20case%20conventions%3B%20every%0A%2F%2F%2F%20rename%20is%20recorded%20in%20%5B%60EmitReport%3A%3Alossy%60%5D%20as%0A%2F%2F%2F%20%60Lark%20renamed%20rule%20%22a%22%20to%20%22b%22%60.%20Silent%20rules%20documented%20exactly%20as%0A%2F%2F%2F%20%60%25ignore%60%2C%20which%20is%20how%20%60import_lark%60%20represents%20%60%25ignore%60%20directives%2C%20are%0A%2F%2F%2F%20written%20back%20as%20%60%25ignore%60%20directives%3B%20no%20other%20%60%25ignore%60%20is%20emitted.%0A%2F%2F%2F%0A%2F%2F%2F%20Character%20classes%2C%20ranges%20and%20any-character%20are%20written%20as%20regex%0A%2F%2F%2F%20terminals%2C%20case-insensitive%20literals%20as%20%60%28%3Fi%3A...%29%60%20regexes%2C%20counted%0A%2F%2F%2F%20repetition%20as%20%60%7E%20n..m%60%2C%20and%20captures%20labelled%20%60regex%60%20over%20a%20literal%20as%0A%2F%2F%2F%20the%20regex%20they%20were%20imported%20from.%20Ordered%20choice%20is%20written%20as%20Lark%0A%2F%2F%2F%20alternation%3B%20lookahead%20and%20other%20captures%20have%20no%20Lark%20form%20and%20are%0A%2F%2F%2F%20dropped%2C%20except%20that%20a%20negative%20lookahead%20over%20a%20character%20set%20followed%20by%0A%2F%2F%2F%20any%20character%20becomes%20a%20complemented%20character%20class.%20Every%20lowering%20and%0A%2F%2F%2F%20drop%20is%20recorded%20in%20the%20report%2C%20so%20%60import_lark%60%20of%20the%20output%20reproduces%0A%2F%2F%2F%20the%20grammar%20modulo%20the%20recorded%20notes%2C%20and%20emitting%20the%20re-imported%0A%2F%2F%2F%20grammar%20reproduces%20the%20same%20text.%0A%2F%2F%2F%0A%2F%2F%2F%20Rule%20documentation%20is%20written%20as%20%60%2F%2F%60%20comments%20above%20each%20rule%3B%20trailing%0A%2F%2F%2F%20%60inline%60%20and%20%60priority%20N%60%20documentation%20parts%2C%20as%20produced%20by%0A%2F%2F%2F%20%60import_lark%60%2C%20are%20written%20back%20as%20the%20%60%3F%60%20prefix%20and%20%60.N%60%20priority.%0A%2F%2F%2F%0A%2F%2F%2F%20%23%20Errors%0A%2F%2F%2F%0A%2F%2F%2F%20Returns%20%5B%60GrammarEmitError%3A%3AUnsupported%60%5D%20for%20empty%20non-negated%20character%0A%2F%2F%2F%20classes%2C%20descending%20character%20ranges%2C%20repetitions%20whose%20maximum%20is%20below%0A%2F%2F%2F%20their%20minimum%2C%20and%20regexes%20that%20Lark%20cannot%20delimit.%0Apub%20fn%20emit_lark%28grammar%3A%20%26Grammar%29%20-%3E%20Result%3C%28String%2C%20EmitReport%29%2C%20GrammarEmitError%3E%20%7B%0A%20%20%20%20LarkEmitter%3A%3Anew%28grammar%29.emit%28%29%0A%7D%0A%0A%23%5Bderive%28Debug%29%5D%0Astruct%20LarkEmitter%3C%27grammar%3E%20%7B%0A%20%20%20%20grammar%3A%20%26%27grammar%20Grammar%2C%0A%20%20%20%20names%3A%20NamePlan%2C%0A%20%20%20%20ignored%3A%20BTreeSet%3Cusize%