(183: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %2F%2F%20Shared%20process%20mechanics%20only%3B%20each%20experiment%20supplies%20its%20checked-plan%20and%20CI%20authorization.%0Aimport%20assert%20from%20%27node%3Aassert%2Fstrict%27%3B%0Aimport%20%7BspawnSync%7D%20from%20%27node%3Achild_process%27%3B%0Aimport%20%7BcreateHash%7D%20from%20%27node%3Acrypto%27%3B%0Aimport%20%7BexistsSync%2ClstatSync%2CmkdirSync%2CmkdtempSync%2CreadFileSync%2CrmSync%2CwriteFileSync%7D%20from%20%27node%3Afs%27%3B%0Aimport%20%7Btmpdir%7D%20from%20%27node%3Aos%27%3B%0Aimport%20%7Bdirname%2Cjoin%7D%20from%20%27node%3Apath%27%3B%0Aconst%20sha256%3Dvalue%3D%3EcreateHash%28%27sha256%27%29.update%28value%29.digest%28%27hex%27%29%3B%0A%2F%2A%2A%20Configure%20the%20existing%20whole-library%20byte-receipt%2Fprocess%20protocol%2C%20with%20no%20process%20at%20import.%20%2A%2F%0Aexport%20function%20createSourceNativeObservationRunner%28%7BnativeMode%2CcheckedPlan%2CtextBytes%2CparseObservations%2CentryReceipt%2CtemporaryPrefix%2CfailureLabel%7D%29%7B%0Afunction%20prepareBundle%28entry%29%7B%0A%20const%20descriptor%3DObject.getOwnPropertyDescriptor%28entry%2C%27additionalSources%27%29%3Bif%28%21descriptor%29return%20null%3B%0A%20assert.ok%28Object.hasOwn%28descriptor%2C%27value%27%29%26%26descriptor.enumerable%2C%27additionalSources%20must%20be%20an%20owned%20data%20field%27%29%3B%0A%20const%20sources%3Ddescriptor.value%3Bassert.ok%28Array.isArray%28sources%29%26%26Object.getPrototypeOf%28sources%29%3D%3D%3DArray.prototype%2C%27additionalSources%20must%20be%20an%20ordinary%20dense%20array%27%29%3B%0A%20const%20keys%3DReflect.ownKeys%28sources%29%3Bassert.equal%28keys.length%2Csources.length%2B1%2C%27additionalSources%20cannot%20have%20extra%20fields%20or%20holes%27%29%3B%0A%20const%20paths%3D%5B%27original.rs%27%2C%27consumer.rs%27%2C%27liboracle_source.rlib%27%2C%27consumer%27%2C%27consumer.exe%27%5D%3B%0A%20const%20bundle%3D%5B%5D%3B%0A%20for%28let%20index%3D0%3Bindex%3Csources.length%3Bindex%2B%2B%29%7B%0A%20%20const%20item%3DObject.getOwnPropertyDescriptor%28sources%2CString%28index%29%29%3Bassert.ok%28item%26%26Object.hasOwn%28item%2C%27value%27%29%26%26item.enumerable%2C%27additionalSources%20cannot%20have%20accessors%20or%20holes%27%29%3B%0A%20%20const%20source%3Ditem.value%3Bassert.ok%28source%26%26Object.getPrototypeOf%28source%29%3D%3D%3DObject.prototype%2C%27additional%20source%20must%20be%20a%20plain%20data%20record%27%29%3B%0A%20%20assert.deepEqual%28Reflect.ownKeys%28source%29.sort%28%29%2C%5B%27relativePath%27%2C%27source%27%2C%27sourceBytes%27%2C%27sourceSha256%27%5D%2C%27additional%20source%20fields%20must%20be%20exact%27%29%3B%0A%20%20const%20fields%3DObject.getOwnPropertyDescriptors%28source%29%3Bfor%28const%20field%20of%20Object.values%28fields%29%29assert.ok%28Object.hasOwn%28field%2C%27value%27%29%26%26field.enumerable%2C%27additional%20source%20cannot%20contain%20accessors%27%29%3B%0A%20%20const%20%7BrelativePath%2Csource%3Acontent%2CsourceBytes%2CsourceSha256%7D%3Dsource%3B%0A%20%20assert.ok%28typeof%20relativePath%3D%3D%3D%27string%27%26%26relativePath.split%28%27%2F%27%29.every%28part%3D%3E%2F%5E%5BA-Za-z0-9_-%5D%2B%28%3F%3A%5C.%5BA-Za-z0-9_-%5D%2B%29%2A%24%2Fu.test%28part%29%26%26%21%2F%5E%28%3F%3Acon%7Cprn%7Caux%7Cnul%7Ccom%5B1-9%5D%7Clpt%5B1-9%5D%29%28%3F%3A%5C.%7C%24%29%2Fiu.test%28part%29%29%2C%27additional%20source%20requires%20a%20safe%20relative%20path%27%29%3B%0A%20%20const%20canonical%3DrelativePath.toLowerCase%28%29%3Bassert.ok%28paths.every%28path%3D%3Epath%21%3D%3Dcanonical%26%26%21path.startsWith%28canonical%2B%27%2F%27%29%26%26%21canonical.startsWith%28path%2B%27%2F%27%29%29%2C%27additional%20source%20path%20collides%20with%20another%20source%20or%20artifact%27%29%3Bpaths.push%28canonical%29%3B%0A%20%20const%20bytes%3DtextBytes%28content%29%3Bassert.equal%28bytes.length%2CsourceBytes%2C%27additional%20source%20byte%20count%20differs%27%29%3Bassert.equal%28sha256%28bytes%29%2CsourceSha256%2C%27additional%20source%20hash%20differs%27%29%3B%0A%20%20bundle.push%28%7BrelativePath%2CsourceBytes%2CsourceSha256%2Cbytes%7D%29%3B%0A%20%7D%0A%20%2F%2F%20Preflight%20every%20source%20before%20the%20first%20directory%2Fsource%20write%20or%20process.%0A%20assert.equal%28textBytes%28entry.source%29.length%2Centry.sourceBytes%29%3Bassert.equal%28sha256%28textBytes%28entry.source%29%29%2Centry.sourceSha256%29%3Bassert.equal%28sha256%28textBytes%28entry.consumerSource%29%29%2Centry.consumerSha256%29%3B%0A%20return%20bundle%3B%0A%7D%0Afunction%20regularPath%28directory%2CrelativePath%29%7B%0A%20assert.ok%28lstatSync%28directory%29.isDirectory%28%29%26%26%21lstatSync%28directory%29.isSymbolicLink%28%29%2C%27private%20source%20root%20must%20be%20an%20actual%20directory%27%29%3B%0A%20const%20components%3DrelativePath.split%28%27%2F%27%29%3Blet%20current%3Ddirectory%3B%0A%20for%28const%5Bindex%2Ccomponent%5Dof%20components.entries%28%29%29%7B%0A%20%20current%3Djoin%28current%2Ccomponent%29%3Bconst%20status%3DlstatSync%28current%29%3Bassert.ok%28%21status.isSymbolicLink%28%29%2C%27source%20bundle%20paths%20cannot%20be%20symbolic%20links%27%29%3B%0A%20%20assert.ok%28index%3D%3D%3Dcomponents.length-1%3Fstatus.isFile%28%29%3Astatus.isDirectory%28%29%2C%27source%20bundle%20path%20has%20the%20wrong%20file%2Fdirectory%20role%27%29%3B%0A%20%7D%0A%20return%20current%3B%0A%7D%0Afunction%20checkFiles%28entry%2Cfiles%29%7B%0A%20if%28files.additionalSources%29%7B%0A%20%20regularPath%28files.directory%2C%27original.rs%27%29%3BregularPath%28files.directory%2C%27consumer.rs%27%29%3B%0A%20%20for%28const%20name%20of%5B%27liboracle_source.rlib%27%2C%27consumer%27%5D%29%7B%0A%20%20%20try%7BlstatSync%28join%28files.directory%2Cname%29%29%3B%7Dcatch%28error%29%7Bif%28error.code%3D%3D%3D%27ENOENT%27%29continue%3Bthrow%20error%3B%7D%0A%20%20%20regularPath%28files.directory%2Cname%29%3B%0A%20%20%7D%0A%20%20for%28const%20source%20of%20files.additionalSources%29%7Bconst%20path%3DregularPath%28files.directory%2Csource.relativePath%29%3Bassert.deepEqual%28readFileSync%28path%29%2Csource.bytes%2Centry.id%2B%27%20additional%20source%20bytes%20changed%3A%20%27%2Bsource.relativePath%29%3Bassert.equal%28sha256%28readFileSync%28path%29%29%2Csource.sourceSha256%2Centry.id%2B%27%20additional%20source%20hash%20changed%27%29%3B%7D%0A%20%7D%0A%0A%20assert.deepEqual%28readFileSync%28files.source%29%2CtextBytes%28entry.source%29%2Centry.id%2B%27%20original%20module%20bytes%20changed%27%29%3B%0A%20assert.equal%28sha256%28readFileSync%28files.source%29%29%2Centry.sourceSha256%2Centry.id%2B%27%20source%20receipt%20changed%27%29%3B%0A%20assert.equal%28sha256%28readFileSync%28files.consumer%29%29%2Centry.consumerSha256%2Centry.id%2B%27%20generated%20external%20consumer%20changed%27%29%3B%0A%7D%0Afunction%20runProcess%28spawn%2Ccommand%2Cargs%2Coptions%2Clabel%29%7B%0A%20const%20result%3Dspawn%28command%2Cargs%2C%7B...options%2Cshell%3Afalse%2Cencoding%3A%27utf8%27%2CmaxBuffer%3A1024%2A1024%7D%29%3B%0A%20if%28result.error%29throw%20new%20Error%28label%2B%27%3A%20%27%2B%28result.error.code%3D%3D%3D%27ETIMEDOUT%27%3F%27timed%20out%20after%20%27%2Boptions.timeout%2B%27ms%27%3Aresult.error.message%29%2C%7Bcause%3Aresult.error%7D%29%3B%0A%20if%28result.signal%29throw%20new%20Error%28label%2B%27%3A%20terminated%20by%20%27%2Bresult.signal%29%3B%0A%20if%28result.status%21%3D%3D0%29throw%20new%20Error%28label%2B%27%3A%20exit%20%27%2Bresult.status%2B%27%3B%20%27%2BString%28result.stderr%3F%3F%27%27%29.slice%280%2C4096%29%29%3B%0A%20if%28typeof%20result.stdout%21%3D%3D%27string%27%29throw%20new%20TypeError%28label%2B%27%3A%20stdout%20must%20be%20actual%20UTF-8%20text%27%29%3B%0A%20return%20result.stdout%3B%0A%7D%0Afunction%20runCheckedProcess%28entry%2Cfiles%2Cspawn%2Ccommand%2Cargs%2Coptions%2Clabel%29%7B%0A%20if%28%21files.additionalSources%29return%20runProcess%28spawn%2Ccommand%2Cargs%2Coptions%2Clabel%29%3B%0A%20checkFiles%28entry%2Cfiles%29%3Btry%7Breturn%20runProcess%28spawn%2Ccommand%2Cargs%2Coptions%2Cl