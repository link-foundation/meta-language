-recommend secretlint --secretlintignore [REDACTED] \"**/*\"\n\n  publish:\n    name: Publish npm Package\n    needs: test\n    if: |\n      !cancelled() && needs.test.result == 'success' && (\n        github.event_name == 'workflow_dispatch' ||\n        (github.event_name == 'release' && github.event.action == 'published')\n      )\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    concurrency:\n      group: release-${{ github.repository }}-main-write\n      cancel-in-progress: false\n    permissions:\n      contents: read\n      id-token: [REDACTED]    steps:\n      - uses: actions/checkout@v6\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: 24\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Update npm for trusted publishing\n        run: |\n          npm install -g npm@11\n          npm --version\n\n      - name: Read package metadata\n        id: package\n        working-directory: js\n        run: |\n          name=\"$(node -p \"require('./package.json').name\")\"\n          version=\"$(node -p \"require('./package.json').version\")\"\n\n          if [ \"$name\" != \"meta-language\" ]; then\n            echo \"::error::Expected package name meta-language, got $name\"\n            exit 1\n          fi\n\n          echo \"name=$name\" >> \"$GITHUB_OUTPUT\"\n          echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n          echo \"Package: $name@$version\"\n\n      - name: Verify requested release version\n        env:\n          PACKAGE_VERSION: ${{ steps.package.outputs.version }}\n          RELEASE_TAG: ${{ github.event.release.tag_name }}\n          REQUESTED_VERSION: ${{ github.event.inputs.release_version }}\n        run: |\n          if [ -n \"$RELEASE_TAG\" ]; then\n            normalized_tag=\"${RELEASE_TAG#v}\"\n            if [ \"$normalized_tag\" != \"$PACKAGE_VERSION\" ]; then\n              echo \"::error::Release tag $RELEASE_TAG does not match js/package.json