[2026-08-02T17:01:43.170Z] [INFO]     "originalFile": "name: JavaScript\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - 'js/**'\n      - 'parity/**'\n      - '.secretlintrc.json'\n      - '.github/workflows/js.yml'\n  pull_request:\n    types: [opened, synchronize, reopened]\n    paths:\n      - 'js/**'\n      - 'parity/**'\n      - '.secretlintrc.json'\n      - '.github/workflows/js.yml'\n  release:\n    types: [published]\n  workflow_dispatch:\n    inputs:\n      release_version:\n        description: 'Expected package version (optional safety check)'\n        required: false\n        type: string\n\npermissions:\n  contents: read\n\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  test:\n    name: JavaScript Package\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-javascript-test\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Simulate fresh merge with base branch\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash js/scripts/simulate-fresh-merge.sh\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: 20\n          cache: npm\n          cache-dependency-path: js/package-lock.json\n\n      - name: Install dependencies\n        run: npm ci\n        working-directory: js\n\n      - name: Run tests\n        run: npm test\n        working-directory: js\n\n      - name: Check Rust/JavaScript parity manifest\n        run: npm run check:parity\n        working-directory: js\n\n      - name: Verify npm package contents\n        run: npm pack --dry-run\n        working-directory: js\n\n      - name: Scan repository for secrets\n        run: npx --yes -p secretlint -p @secretlint/secretlint-rule-preset-recommend secretlint --secretlintignore [REDACTED] \"**/*\"\n\n  publish:\n    name: Publish npm Package\n    needs: test\n    if: |\n      !cancelled() && needs.test.result == 'success' && (\n        github.event_name == 'workflow_dispatch' ||\n        (github.event_name == 'release' && github.event.action == 'published')\n      )\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    concurrency:\n      group: release-${{ github.repository }}-main-write\n      cancel-in-progress: false\n    permissions:\n      contents: read\n      id-token: [REDACTED]    steps:\n      - uses: actions/checkout@v6\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: 24\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Update npm for trusted publishing\n        run: |\n          npm install -g npm@11\n          npm --version\n\n      # actions/setup-node writes `_authToken=${N…KEN}` and exports the\n      # placeholder `XXXXX-XXXXX-XXXXX-XXXXX` whenever no token is supplied. npm\n      # then skips the OIDC exchange and the registry rejects the anonymous PUT\n      # with a misleading `E404`. Strip that placeholder so trusted publishing is\n      # actually attempted; keep it when a real NPM_TOKEN bootstrap secret exists.\n      # See actions/setup-node#1551 and issue #191.\n      - name: Prepare npm authentication\n        id: npm_auth\n        env:\n          NPM_TOKEN: [REDACTED] secrets.NPM_TOKEN }}\n          PACKAGE_NAME: meta-language\n          PUBLISH_WORKFLOW_FILE: .github/workflows/js.yml\n          # Set to '1' (or add --verbose) to trace npm credential resolution.\n          NPM_AUTH_DEBUG: ${{ vars.NPM_AUTH_DEBUG }}\n        run: node scripts/prepare-npm-auth.mjs\n        working-directory: js\n\n      - name: Read package metadata\n        id: package\n        working-directory: js\n        run: |\n          name=\"$(node -p \"require('./package.json').name\")\"\n          version=\"$(node -p \"require('./package.json').version\")\"\n\n          if [ \"$name\" != \"meta-language\" ]; then\n            echo \"::error::Expected package name meta-language, got $name\"\n            exit 1\n          fi\n\n          echo \"name=$name\" >> \"$GITHUB_OUTPUT\"\n          echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n          echo \"Package: $name@$version\"\n\n      - name: Verify requested release version\n        env:\n          PACKAGE_VERSION: ${{ steps.package.outputs.version }}\n          RELEASE_TAG: ${{ github.event.release.tag_name }}\n          REQUESTED_VERSION: ${{ github.event.inputs.release_version }}\n        run: |\n          if [ -n \"$RELEASE_TAG\" ]; then\n            normalized_tag=\"${RELEASE_TAG#v}\"\n            if [ \"$normalized_tag\" != \"$PACKAGE_VERSION\" ]; then\n              echo \"::error::Release tag $RELEASE_TAG does not match js/package.json version $PACKAGE_VERSION\"\n              exit 1\n            fi\n          fi\n\n          if [ -n \"$REQUESTED_VERSION\" ] && [ \"$REQUESTED_VERSION\" != \"$PACKAGE_VERSION\" ]; then\n            echo \"::error::Requested version $REQUESTED_VERSION does not match js/package.json version $PACKAGE_VERSION\"\n            exit 1\n          fi\n\n      - name: Check npm registry\n        id: npm\n        env:\n          PACKAGE_VERSION: ${{ steps.package.outputs.version }}\n        working-directory: js\n        run: |\n          if npm view \"meta-language@$PACKAGE_VERSION\" version >/dev/null 2>&1; then\n            echo \"already_published=true\" >> \"$GITHUB_OUTPUT\"\n          else\n            echo \"already_published=false\" >> \"$GITHUB_OUTPUT\"\n          fi\n\n      - name: Publish to npm\n        if: steps.npm.outputs.already_published != 'true'\n        run: npm publish --provenance\n        working-directory: js\n\n      - name: Verify published package\n        if: steps.npm.outputs.already_published != 'true'\n        env:\n          PACKAGE_VERSION: ${{ steps.package.outputs.version }}\n        run: npm view \"meta-language@$PACKAGE_VERSION\" version\n",
