(18: (meta: (t: semantic) (n: 1) (term: string%20value) (def: %23%23%20Problem%0A%0AThe%20Rust%20CI%2FCD%20template%27s%20%60deploy-docs%60%20job%20depends%20on%20release%20publication%20jobs%3A%0A%0A%60%60%60yaml%0Adeploy-docs%3A%0A%20%20needs%3A%20%5Bauto-release%2C%20manual-release%5D%0A%60%60%60%0A%0Aand%20only%20runs%20when%20%60auto-release%60%20or%20%60manual-release%60%20succeeds.%20This%20couples%20GitHub%20Pages%20documentation%20deployment%20to%20package%2FGitHub%20release%20publication.%0A%0A%23%23%20Reproducible%20Example%0A%0A1.%20Use%20the%20current%20%60release.yml%60%20from%20%60link-foundation%2Frust-ai-driven-development-pipeline-template%60.%0A2.%20Run%20the%20workflow%20on%20%60main%60%20with%20a%20package%20build%20that%20succeeds.%0A3.%20Make%20the%20release%20publication%20path%20fail%2C%20for%20example%20by%20missing%2Finvalid%20crates.io%20credentials%2C%20a%20crates.io%20publish%20failure%2C%20or%20a%20release%20script%20failure.%0A4.%20Observe%20that%20%60Deploy%20Rust%20Documentation%60%20is%20skipped%20because%20it%20needs%20the%20failed%20release%20job.%0A%0AThe%20same%20pattern%20reproduced%20in%20%60link-foundation%2Fmeta-ontology%60%3A%0A%0A-%20%60Build%20Package%60%20succeeded.%0A-%20%60Auto%20Release%60%20failed.%0A-%20%60Deploy%20Rust%20Documentation%60%20was%20skipped.%0A%0ASee%20downstream%20issue%3A%20https%3A%2F%2Fgithub.com%2Flink-foundation%2Fmeta-ontology%2Fissues%2F3%0A%0A%23%23%20Workaround%0A%0AAfter%20a%20release%20failure%2C%20manually%20rerun%20a%20documentation%20deployment%20job%20or%20manually%20build%20and%20publish%20%60target%2Fdoc%60%20to%20GitHub%20Pages.%0A%0A%23%23%20Suggested%20Fix%0A%0AMake%20documentation%20deployment%20depend%20on%20the%20successful%20validation%2Fbuild%20job%20instead%20of%20release%20publication%20jobs.%20For%20example%3A%0A%0A%60%60%60yaml%0Adeploy-docs%3A%0A%20%20needs%3A%20%5Bbuild%5D%0A%20%20if%3A%20%7C%0A%20%20%20%20%21cancelled%28%29%20%26%26%0A%20%20%20%20needs.build.result%20%3D%3D%20%27success%27%20%26%26%20%28%0A%20%20%20%20%20%20%28github.event_name%20%3D%3D%20%27push%27%20%26%26%20github.ref%20%3D%3D%20%27refs%2Fheads%2Fmain%27%29%20%7C%7C%0A%20%20%20%20%20%20%28github.event_name%20%3D%3D%20%27workflow_dispatch%27%20%26%26%20github.event.inputs.release_mode%20%3D%3D%20%27instant%27%29%0A%20%20%20%20%29%0A%60%60%60%0A%0AThis%20keeps%20the%20website%20release%20tied%20to%20a%20successful%20build%20while%20allowing%20it%20to%20proceed%20when%20package%20publication%20or%20GitHub%20release%20creation%20fails.%0A) (lang: meta-language%20structured%20data)))
